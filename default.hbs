<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    {{> "head"}}
</head>

<body class="{{body_class}}">
    <div class="has-background-light" style="min-height: 100vh; display: flex; flex-direction: column;">
        {{!-- Header partial using Bulma navbar markup --}}
        {{> "header"}}

        {{!-- Main content --}}
        <main style="flex-grow: 1;">
            {{{body}}}
        </main>
        {{!-- Footer partial using Bulma footer/content markup --}}
            {{> "footer"}}
    </div>

    {{#is "post, page"}}
        {{> "lightbox"}}
    {{/is}}

    {{!-- Keep jQuery only if you still rely on fitVids from casper.js --}}
    <script
        src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
        crossorigin="anonymous">
    </script>
    <script src="{{asset "built/casper.js"}}"></script>

    {{ghost_foot}}
</body>
</html>