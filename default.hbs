<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="has-background-black-bis has-text-light"{{else match @custom.color_scheme "Auto"}} class="auto-color"{{/match}}>
{{> "head"}}

<body class="{{body_class}}">
    <div class="has-background-light">
        {{!-- Header partial should use Bulma navbar markup --}}
        
            {{> "header"}}


        {{!-- Main content --}}
        <main class="section">
            <div class="container is-max-desktop">
                {{{body}}}
            </div>
        </main>

        {{!-- Footer partial should use Bulma footer/content markup --}}
        <div class="section pt-0">
            {{> "footer"}}
        </div>

    </div>

    {{#is "post, page"}}
        {{> "lightbox"}}
    {{/is}}

    {{!-- Keep jQuery only if you still rely on fitVids from casper.js --}}
    <script
        src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
        crossorigin="anonymous">
    </script>
    <script src="{{asset "built/casper.js"}}"></script>


    {{ghost_foot}}
</body>
</html>