<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    {{!-- Apply the stored theme before first paint — no flash.
    States: absent = follow system, "light"/"dark" = explicit. --}}
    <script>
        try {
            var t = localStorage.getItem('ns-theme');
            if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) { /* storage unavailable — follow the system */ }
    </script>

    {{!-- Figtree — the NS Design System typeface, self-hosted
    (assets/fonts/, declared in 0-abstracts/_fonts.css) --}}
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/figtree-normal-latin.woff2"}}" crossorigin />

    <link rel="preload" as="style" href="{{asset "built/screen.css"}}" />
    <link rel="stylesheet" href="{{asset "built/screen.css"}}" />

    {{!-- Structured data: WebSite, Organization and the primary
    navigation as SiteNavigationElement. Ghost adds the
    Article/author graph itself via ghost_head. --}}
    {{> "json-ld"}}

    {{!-- Slot for template-level head additions ({{#contentFor "head"}}) --}}
    {{{block "head"}}}

    {{ghost_head}}

</head>
<body class="{{body_class}}">

<a class="skip-link" href="#site-main">{{t "Skip to content"}}</a>

{{!-- The mobile drawer is CSS-only: this checkbox drives it and
must stay a SIBLING of .site-head for the ~ selectors to reach. --}}
<input type="checkbox" id="nav-open" class="nav-toggle-box" aria-hidden="true" tabindex="-1" />

{{> "header"}}

<div class="viewport">
    <div class="site-content">
        {{{body}}}
    </div>

    {{> "footer"}}
</div>

<script src="{{asset "built/main.js"}}" defer></script>

{{{block "foot"}}}

{{ghost_foot}}

</body>
</html>
