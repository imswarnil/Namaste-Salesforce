<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="dark-mode"{{else match @custom.color_scheme "Auto"}} class="auto-color"{{/match}}>
<head>
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" as="style"  href="{{asset "built/screen.css"}}" />
    <link rel="preload" as="script" href="{{asset "built/casper.js"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />

    {{!-- Anti-flash dark mode: runs sync before first paint --}}
    <script>
    (function () {
        var saved = localStorage.getItem('sfdc-color-scheme');
        var html  = document.documentElement;
        if (saved === 'dark') {
            html.classList.add('dark-mode');
            html.classList.remove('auto-color');
        } else if (saved === 'light') {
            html.classList.remove('dark-mode');
            html.classList.remove('auto-color');
        }
    })();
    </script>

    {{ghost_head}}
</head>
<body class="{{body_class}}{{#if @custom.show_publication_cover}} has-cover{{/if}}">
<div class="viewport">

    {{> "header"}}

    <div class="site-content">
        {{{body}}}
    </div>

    {{> "footer"}}


</div>

{{#is "post, page"}}{{> "lightbox"}}{{/is}}

<script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous" defer></script>
<script src="{{asset "built/casper.js"}}" defer></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    var html    = document.documentElement;
    var burger  = document.querySelector('.gh-burger');
    var mobile  = document.getElementById('gh-head-mobile');
    var backdrop = document.querySelector('.gh-head-backdrop');

    /* ---- Dark mode helpers ---- */
    function isDark() {
        return html.classList.contains('dark-mode') ||
               (html.classList.contains('auto-color') &&
                window.matchMedia('(prefers-color-scheme: dark)').matches);
    }

    function syncPill() {
        var pill = document.getElementById('gh-dark-pill');
        if (!pill) return;
        var dark = isDark();
        pill.setAttribute('aria-checked', dark ? 'true' : 'false');
        /* CSS handles visual state via html.dark-mode .gh-dark-pill */
    }

    function setDark(on) {
        if (on) {
            html.classList.add('dark-mode');
            html.classList.remove('auto-color');
            localStorage.setItem('sfdc-color-scheme', 'dark');
        } else {
            html.classList.remove('dark-mode');
            html.classList.remove('auto-color');
            localStorage.setItem('sfdc-color-scheme', 'light');
        }
        syncPill();
        updateToggleLabel();
    }

    function updateToggleLabel() {
        var dark  = isDark();
        var label = dark ? 'Switch to light mode' : 'Switch to dark mode';
        document.querySelectorAll('.gh-dark-toggle, .gh-dark-pill').forEach(function (el) {
            el.setAttribute('aria-label', label);
        });
    }

    /* ---- Register toggle buttons ---- */
    document.querySelectorAll('.gh-dark-toggle, .gh-dark-pill').forEach(function (btn) {
        btn.addEventListener('click', function () { setDark(!isDark()); });
    });

    /* Initial sync */
    syncPill();
    updateToggleLabel();

    /* ---- Mobile menu ---- */
    function openMenu() {
        document.body.classList.add('gh-head-open');
        if (burger) { burger.setAttribute('aria-expanded', 'true'); burger.setAttribute('aria-label', 'Close main menu'); }
        if (mobile) { mobile.setAttribute('aria-hidden', 'false'); }
    }

    function closeMenu() {
        document.body.classList.remove('gh-head-open');
        if (burger) { burger.setAttribute('aria-expanded', 'false'); burger.setAttribute('aria-label', 'Open main menu'); }
        if (mobile) { mobile.setAttribute('aria-hidden', 'true'); }
    }

    if (burger)   burger.addEventListener('click', function () { document.body.classList.contains('gh-head-open') ? closeMenu() : openMenu(); });
    if (backdrop) backdrop.addEventListener('click', closeMenu);

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && document.body.classList.contains('gh-head-open')) {
            closeMenu();
            if (burger) burger.focus();
        }
    });

    window.addEventListener('resize', function () {
        if (window.innerWidth > 767 && document.body.classList.contains('gh-head-open')) closeMenu();
    });

    /* ---- FitVids ---- */
    if (typeof $.fn !== 'undefined' && typeof $.fn.fitVids === 'function') {
        $(".gh-content").fitVids();
    }

});
</script>

{{ghost_foot}}
</body>
</html>
