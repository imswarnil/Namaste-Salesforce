<!DOCTYPE html>
<html lang="{{@site.locale}}" data-color-scheme="light">

    {{> "head"}}

<body class="{{body_class}}">
    <div class="site-shell">
        {{> "header"}}
        <main id="site-main" class="site-main" role="main">
            {{{body}}}
        </main>
        {{> "footer"}}
    </div>

    {{#is "post, page"}}
        {{> "lightbox"}}
    {{/is}}
    {{ghost_foot}}
</body>
</html>
