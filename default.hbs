<!DOCTYPE html>
<html
  lang="{{@site.locale}}"
  data-color-scheme="light"
>
{{!-- head.hbs: charset, viewport, theme-detection, preloads, CSS, icons, JSON-LD, ghost_head --}}
{{> "head"}}

<body
  class="{{body_class}}
    {{!-- Ghost's body_class gives: home-template / post-template / page-template / tag-template / author-template --}}
    {{!-- We add semantic intent classes for Bulma/SCSS hooks --}}
    {{#is "home, index"}}is-collection is-home{{/is}}
    {{#is "post"}}is-post{{#post}}
      {{#has tag="#blog"}} is-blog{{/has}}
      {{#has tag="#course"}} is-course{{/has}}
      {{#has tag="#lesson"}} is-lesson{{/has}}
      {{#has tag="#training-content"}} is-training{{/has}}
      {{#has tag="#training"}} is-training-section{{/has}}
      {{#has tag="#videos"}} is-video{{/has}}
      {{#has tag="documentation"}} is-docs{{/has}}
    {{/post}}{{/is}}
    {{#is "page"}}is-page{{/is}}
    {{#is "tag"}}is-tag{{/is}}
    {{#is "author"}}is-author{{/is}}"
>

{{!-- ── Accessibility: skip to main content ──────────────────────────────── --}}
<a
  class="skip-link button is-sr-only is-focusable"
  href="#site-main"
  style="position:absolute;top:-40px;left:0;z-index:9999;transition:top 200ms ease"
  onfocus="this.style.top='0'"
  onblur="this.style.top='-40px'"
>Skip to main content</a>

{{!-- ════════════════════════════════════════════════════════════════════════
  SITE SHELL
  Flex column → site-main takes flex:1 → footer always pins to bottom.
  All CSS for .site-shell lives in main.scss (already set up).
════════════════════════════════════════════════════════════════════════════ --}}
<div class="site-shell">
  {{!-- ── Global navigation ───────────────────────────────────────────────── --}}
  {{> "header"}}
  {{!-- ════════════════════════════════════════════════════════════════════
    MAIN LANDMARK
    Class list drives CSS targeting — no structural HTML branching here.
    Bulma utility classes added via Ghost {{#is}} / {{#has}} helpers.

    Class anatomy:
      site-main          → base class (always present)
      main-[type]        → content-type hook for SCSS (main-blog, main-course …)
      is-collection      → post-list pages (home, tag, author, blog index …)
      is-single          → single post / page
  ════════════════════════════════════════════════════════════════════════ --}}
  <main
    id="site-main"
    class="site-main
      {{!-- Collection / archive pages --}}
      {{#is "home, index"}}main-home is-collection{{/is}}
      {{#is "tag"}}main-tag is-collection{{/is}}
      {{#is "author"}}main-author is-collection{{/is}}
      {{!-- Single content pages --}}
      {{#is "post"}}is-single{{#post}}
        {{#has tag="#blog"}} main-blog{{/has}}
        {{#has tag="#course"}} main-course{{/has}}
        {{#has tag="#lesson"}} main-lesson{{/has}}
        {{#has tag="#training-content"}} main-training{{/has}}
        {{#has tag="#training"}} main-training-section{{/has}}
        {{#has tag="#videos"}} main-video{{/has}}
        {{#has tag="documentation"}} main-docs{{/has}}
      {{/post}}{{/is}}
      {{#is "page"}}is-single main-page{{/is}}"
    role="main"
    aria-label="{{!--
      Screen-reader label changes per context:
        - home   → Latest content
        - post   → [post title]
        - page   → [page title]
        - tag    → Posts tagged [tag]
        - author → Posts by [author]
    --}}
    {{#is "home, index"}}Latest content{{/is}}
    {{#is "post"}}{{#post}}{{title}}{{/post}}{{/is}}
    {{#is "page"}}{{#post}}{{title}}{{/post}}{{/is}}
    {{#is "tag"}}{{#tag}}Posts tagged {{name}}{{/tag}}{{/is}}
    {{#is "author"}}{{#author}}Posts by {{name}}{{/author}}{{/is}}"
  >
    {{!-- ── Ghost injects the current template body here ──────────────── --}}
    {{{body}}}

  </main>

  {{!-- ── Global footer ────────────────────────────────────────────────── --}}
  {{> "footer"}}

</div>
{{!-- /site-shell --}}

{{!-- ════════════════════════════════════════════════════════════════════════
  LIGHTBOX (PhotoSwipe)
  Rendered only on post and page contexts where image content may appear.
  The pswp element must exist in the DOM before PhotoSwipe initialises.
════════════════════════════════════════════════════════════════════════════ --}}
<script
  src="https://code.jquery.com/jquery-3.7.1.min.js"
  integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
  crossorigin="anonymous"
  defer
></script>
<script src="{{asset "built/main.js"}}" defer></script>
{{ghost_foot}}

</body>
</html>
