<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>

    {{!-- MUST be first: sets data-theme before first paint. See abstract/07. --}}
    {{> "nsds/theme-init"}}

    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{asset "fonts/switzer-var-latin.woff2"}}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{asset "fonts/roboto-mono-var-latin.woff2"}}">
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}">

    {{ghost_head}}
  </head>

  <body class="{{body_class}}">
    {{!-- Chrome goes here. See abstract/02 — default.hbs dispatches on the same
         tags post.hbs does, so a reading post gets a reading bar. --}}

    <main id="main">{{{body}}}</main>

    {{ghost_foot}}
    <script defer src="{{asset "js/nsds/nav.js"}}"></script>
  </body>
</html>
