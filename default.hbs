<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="HandheldFriendly" content="True">
    <title>{{meta_title}}</title>

    {{!-- ── Pre-paint theme ───────────────────────────────────────────────
      Applies the saved theme to <html> BEFORE first paint to prevent a flash
      of the wrong colours. Falls back to the OS preference on first visit.
      This is the only inline script in <head>; toggling lives in theme-toggle.js
    ─────────────────────────────────────────────────────────────────────── --}}
    <script>
      (function () {
        try {
          var t = localStorage.getItem('ns-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    {{!-- ── Fonts & icons: ALL self-hosted ────────────────────────────────
      Everything below used to come from two third-party origins — Google Fonts
      and unpkg — as four render-blocking stylesheets:

        Google Fonts CSS      round-trip before font URLs were even known
        Phosphor regular CSS   78 KB  ┐ two full icon fonts (~1,500 glyphs)
        Phosphor fill CSS      86 KB  │ to draw the ~123 icons this theme uses
        Phosphor woff2 ×2     279 KB  ┘

      Now: one local stylesheet, and both the N&M cuts and the Phosphor subset
      shipped by the design system (yarn design:sync). The only fonts preloaded
      are the three on the critical path — N&M Text, which sets every paragraph,
      N&M Display, which sets the heading above the fold, and the regular icon
      weight used in the header. N&M Mono and the icon fill weight are fetched
      on demand: browsers only download a webfont when rendered text actually
      matches it, and neither appears before the first screen on most pages.
    ───────────────────────────────────────────────────────────────────── --}}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{asset "fonts/nmtext-var-latin.woff2"}}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{asset "fonts/nmdisplay-var-latin.woff2"}}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{asset "fonts/phosphor-subset.woff2"}}">

    {{!-- Theme stylesheet (Tailwind build) — carries the @font-face rules --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}">

    {{!-- Google AdSense loader — only when ads are enabled + a publisher ID is set
         (Ghost Admin → Design). Individual slots are placed via the ads/adsense partial. --}}
    {{#if @custom.enable_ads}}{{#if @custom.adsense_publisher_id}}
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{@custom.adsense_publisher_id}}" crossorigin="anonymous"></script>
    {{/if}}{{/if}}

    {{!-- PWA: icons, manifest, theme colour (icon kit in assets/logo/) --}}
    <link rel="icon" type="image/svg+xml" href="{{asset "logo/favicon.svg"}}">
    <link rel="icon" href="{{asset "logo/favicon.ico"}}" sizes="48x48">
    <link rel="apple-touch-icon" href="{{asset "logo/apple-touch-icon.png"}}">
    <link rel="manifest" href="{{asset "logo/manifest.webmanifest"}}">
    <meta name="theme-color" content="#0176d3">

    {{!-- Ghost-injected SEO tags, structured data, code injection, search, etc. --}}
    {{ghost_head}}
  </head>

  <body class="{{body_class}} flex min-h-screen flex-col bg-surface text-ink">
    {{!-- Accessibility: jump straight to the main content with the keyboard --}}
    <a href="#main"
       class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-btn focus:bg-brand-500 focus:px-4 focus:py-2 focus:font-medium focus:text-white">
      Skip to content
    </a>

    {{!-- Site header. Course/lesson/training posts get the distraction-free
         "course player" header (logo · progress · ✕ back-to-course); everything
         else gets the standard navigation bar. --}}
    {{#is "post"}}{{#post}}{{#has tag="#lesson, #training, #training-content, #training-section"}}{{> "components/course-player-header"}}{{else}}{{> header}}{{/has}}{{/post}}{{else}}{{> header}}{{/is}}

    {{!-- Custom @graph JSON-LD (navbar + site nodes). Placed after the header
         (before the footer's secondary-nav render) so {{#foreach navigation}}
         resolves to the PRIMARY menu. Valid for crawlers anywhere in the doc;
         additive to Ghost's own structured data. --}}
    {{> "jsonld/graph"}}

    {{!-- Page body — each template's content renders here --}}
    <main id="main" class="flex-1">
      {{{body}}}
    </main>

    {{!-- Site footer. Lesson/module posts get a minimal, distraction-free
         footer; every other page gets the full footer. --}}
    {{#is "post"}}{{#post}}{{#has tag="#lesson, #training-content, #training-section"}}{{> "footer-lesson"}}{{else}}{{> footer}}{{/has}}{{/post}}{{else}}{{> footer}}{{/is}}

    {{!-- PWA install prompt (shown by pwa.js when installable) --}}
    {{> "components/pwa-install"}}

    {{!-- Ghost-injected scripts: Portal (members), search, comments, etc. --}}
    {{ghost_foot}}

    {{!-- Expose current Ghost member data for PostHog user identification.
         UUID is a non-PII identifier; email/name are set as person properties
         (not event properties) inside posthog-init.js. --}}
    <script>
      window.__phMember = {{#if @member}}{
        id: '{{@member.uuid}}',
        email: '{{@member.email}}',
        name: '{{@member.name}}',
        subscribed: {{@member.paid}}
      }{{else}}null{{/if}};
    </script>

    {{!-- Alpine.js (self-hosted) — powers the mobile menu, dropdowns and toggles.
         `defer` keeps it non-blocking and lets it auto-start after DOM parse. --}}
    <script defer src="{{asset "js/vendor/alpine.js"}}"></script>

    {{!-- Theme toggle + small vanilla helpers (concatenated, minified build) --}}
    <script defer src="{{asset "built/casper.js"}}"></script>

  </body>
</html>
