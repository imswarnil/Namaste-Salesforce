{{!< default}}
{{!-- A Ghost page.

     `@page.show_title_and_feature_image` is the editor's per-page switch in
     Admin, and gscan requires a theme to honour it. A landing page built out
     of Koenig cards usually supplies its own headline in the content, and
     repeating the page title above it prints the same words twice —
     respecting the flag is what lets an author build that page without
     touching the theme. --}}
{{#page}}
  <article class="{{post_class}}">

    {{#if @page.show_title_and_feature_image}}
      <header class="ns-band ns-band--tight">
        <div class="ns-band__inner ns-page--prose">
          <h1 class="ns-band__title">{{title}}</h1>
          {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
        </div>
      </header>

      {{#if feature_image}}
        <figure class="ns-page ns-page--wide">
          <img srcset="{{img_url feature_image size="m"}} 600w,
                       {{img_url feature_image size="l"}} 1000w,
                       {{img_url feature_image size="xl"}} 2000w"
               sizes="(min-width: 88rem) 1408px, 100vw"
               src="{{img_url feature_image size="l"}}"
               alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
          {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
      {{/if}}
    {{/if}}

    <div class="gh-content ns-prose ns-page">
      {{content}}
    </div>

  </article>
{{/page}}
