{{!< default}}
{{!-- A static page. Same reading surface as a post, without the dateline: a
     page is not news, and "published 3 years ago" under an About page only
     makes it look neglected.

     `@page.show_title_and_feature_image` is the editor's per-page switch and
     Ghost requires a theme to honour it — a landing page built out of Koenig
     cards usually supplies its own headline, and repeating the title above it
     prints the same words twice. --}}
{{#page}}
<article class="{{post_class}}">

    {{#if @page.show_title_and_feature_image}}
        <header class="ns-posthead">
            <div class="ns-posthead__inner">
                <h1 class="ns-posthead__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-posthead__standfirst">{{custom_excerpt}}</p>{{/if}}
                {{#if feature_image}}
                    <span class="ns-posthead__cover">
                        {{> "media" src=feature_image eager=true
                                    sizes="(min-width: 88rem) 1408px, 100vw"
                                    alt=(concat "" feature_image_alt)}}
                    </span>
                {{/if}}
            </div>
        </header>
    {{/if}}

    <div class="ns-post ns-post--wide">
        <article class="ns-post__body">
            <div class="gh-content ns-prose" id="post-body">{{content}}</div>
        </article>
    </div>

</article>
{{/page}}
