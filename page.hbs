{{!< default}}
{{#page}}
<article class="ns-page ns-page--narrow">
  <div class="ns-page__inner">
    {{!-- Ghost's per-page switch. gscan requires this to be honoured. --}}
    {{#if @page.show_title_and_feature_image}}
      <h1 class="ns-page__title">{{title}}</h1>
      {{#if feature_image}}
        <img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}" loading="lazy" decoding="async">
      {{/if}}
    {{/if}}
    <div class="ns-prose gh-content">{{content}}</div>
  </div>
</article>
{{/page}}
