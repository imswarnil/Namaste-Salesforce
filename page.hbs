{{!< default}}
{{#post}}

<main id="site-main" class="site-main site-main--page">
<article class="article page-article {{post_class}}">

    {{!-- ── Header ────────────────────────────────────── --}}
    {{#match @page.show_title_and_feature_image}}
        <header class="page-header gh-canvas">

            {{!-- Breadcrumb placeholder --}}
            {{!-- {{> "partials/breadcrumb"}} --}}

            {{#primary_tag}}
                <a class="page-tag" href="{{url}}">{{name}}</a>
            {{/primary_tag}}

            <h1 class="page-title article-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="page-excerpt lead">{{custom_excerpt}}</p>
            {{/if}}

            {{#if feature_image}}
                <figure class="page-feature-image article-image">
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w,
                                {{img_url feature_image size="xl"}} 2000w"
                        sizes="(min-width: 1400px) 1400px, 92vw"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        loading="eager"
                    />
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}

        </header>
    {{/match}}


    <div class="page-body">

       
    

        <section class="gh-content gh-canvas page-content">
            {{content}}
        </section>

    </div>


    {{#if comments}}
        <section class="article-comments gh-canvas">
            {{comments}}
        </section>
    {{/if}}


</article>
</main>

{{/post}}
