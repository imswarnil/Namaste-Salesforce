{{!< default}}
{{!-- page.hbs — generic Ghost page (centred, prose content) --}}

{{#page}}
<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">

  {{#if @page.show_title_and_feature_image}}
    <header class="mb-8 text-center">
      <h1 class="font-heading text-4xl font-extrabold tracking-tight sm:text-5xl">{{title}}</h1>
      {{#if custom_excerpt}}
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">{{custom_excerpt}}</p>
      {{/if}}
    </header>

    {{#if feature_image}}
      <img src="{{img_url feature_image size='l'}}" alt="{{title}}"
           class="mb-10 w-full rounded-card object-cover shadow-card">
    {{/if}}
  {{/if}}

  <div class="prose prose-lg max-w-none gh-content">
    {{content}}
  </div>

</article>
{{/page}}
