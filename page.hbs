{{!< default}}
{{!-- A Ghost page. `show_title_and_feature_image` is the editor's per-page
     switch in Admin; gscan requires a theme to honour it. --}}
{{#page}}
  <article>
    {{#if @page.show_title_and_feature_image}}
      <h1>{{title}}</h1>
      {{#if feature_image}}
        <img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">
      {{/if}}
    {{/if}}
    <div class="gh-content">{{content}}</div>
  </article>
{{/page}}
