{{!< default}}
{{!-- The blog collection. A Ghost PAGE with the slug `blog` supplies the
     heading and lede when one exists; otherwise the template's own words do.
     That fork is the pattern every content-less route uses, and it is what
     lets a publisher retitle the section without touching the theme. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <p class="ns-kicker">{{t "Writing"}}</p>
            {{#page}}
                <h1 class="ns-band__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
            {{else}}
                <h1 class="ns-band__title">{{t "Blog"}}</h1>
            {{/page}}
        </div>
    </div>
</section>
{{> "collection" card="blog" rail=true}}
