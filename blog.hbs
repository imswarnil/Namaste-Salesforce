{{!< default}}

{{!-- /blog — split hero (copy + subscribe card), topic strip,
then a proper two-column page: the feed beside a sidebar of
widgets (sponsor, newsletter, topics). Newest post goes
full-width above the grid on page one. --}}

<section class="blog-hero outer relative">
    <div class="bg-dots" aria-hidden="true"></div>
    <div class="blog-hero-inner inner">

        <div>
            <span class="kicker">{{> "icons/pen"}} {{t "Blog"}}</span>
            {{#page}}
                <h1>{{title}}</h1>
                <p class="blog-hero-desc">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{@site.description}}{{/if}}</p>
            {{else}}
                <h1>{{t "Notes from the ecosystem"}}</h1>
                <p class="blog-hero-desc">{{@site.description}}</p>
            {{/page}}

            {{!-- Topic cloud lives in the hero now --}}
            {{#get "tags" filter="visibility:public" order="count.posts desc" include="count.posts" limit="8" as |topics|}}
                {{#if topics}}
                    <ul class="tag-cloud blog-hero-topics">
                        {{#foreach topics}}<li><a href="{{url}}">{{name}}</a></li>{{/foreach}}
                    </ul>
                {{/if}}
            {{/get}}
        </div>

        {{#if @site.members_enabled}}
            <aside class="blog-hero-cta">
                <h3>{{> "icons/mail"}} {{#if @custom.newsletter_heading}}{{@custom.newsletter_heading}}{{else}}{{t "The weekly namaste"}}{{/if}}</h3>
                <p>{{#if @custom.newsletter_text}}{{@custom.newsletter_text}}{{else}}{{t "New articles, lessons and release notes that matter — in your inbox, free."}}{{/if}}</p>
                {{#unless @member}}
                    <div class="subscribe-row">
                        <span class="fake-input" data-portal="signup">{{t "you@example.com"}}</span>
                        <a class="btn" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                    </div>
                    <p class="members-note">{{t "No spam. Unsubscribe anytime."}}</p>
                {{else}}
                    <p class="members-note">{{> "icons/check-circle"}} {{t "You're subscribed — thank you!"}}</p>
                {{/unless}}
            </aside>
        {{/if}}

    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner">
        <div class="listing-grid">

            <div class="listing-main">
                <div class="card-grid">
                    {{#foreach posts}}
                        {{#if @first}}
                            {{#match pagination.page 1}}
                                {{> "post-card" feature=true}}
                            {{else}}
                                {{> "post-card"}}
                            {{/match}}
                        {{else}}
                            {{> "post-card"}}
                        {{/if}}
                    {{/foreach}}
                </div>
                {{pagination}}
            </div>

            <aside class="listing-aside">
                {{> "widgets/sponsor"}}
                {{#if @site.members_enabled}}
                    {{^if @member}}
                        {{> "widgets/newsletter"}}
                    {{/if}}
                {{/if}}
                {{#get "posts" filter="tag:hash-video-col" limit="1" as |v|}}
                    {{#if v}}
                        <div class="widget">
                            <h4 class="widget-title">{{> "icons/video"}} {{t "Latest video"}}</h4>
                            <a class="widget-video" href="{{v.[0].url}}">
                                {{#if v.[0].feature_image}}
                                    <img src="{{img_url v.[0].feature_image size="m"}}" alt="{{v.[0].title}}" loading="lazy" />
                                {{/if}}
                                <span class="widget-post-title">{{v.[0].title}}</span>
                            </a>
                        </div>
                    {{/if}}
                {{/get}}
            </aside>

        </div>
    </div>
</main>
