{{!< default}}
{{!-- blog.hbs — blog listing (custom template / routed collection).
     First post is featured large; the rest flow into the standard card grid. --}}

{{> "components/page-header" eyebrow="Namaste Salesforce" title="The Developer Blog" subtitle="Insights, updates and deep-dives from the Salesforce ecosystem."}}

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">

  {{#foreach posts limit="1"}}
    {{> "blog/featured-post"}}
  {{/foreach}}

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#foreach posts from="2"}}
      <div class="motion-safe:animate-fade-up">{{> post-card}}</div>
    {{/foreach}}
  </div>

  {{pagination}}
</section>
