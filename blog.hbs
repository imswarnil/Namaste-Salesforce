{{!< default}}
{{!-- blog.hbs — blog listing (custom template / routed collection).
     Featured post + in-feed author CTA + card grid, with a sticky sidebar. --}}

{{> "components/page-header" eyebrow="Namaste Salesforce" title="The Developer Blog" subtitle="Insights, updates and deep-dives from the Salesforce ecosystem."}}

{{!-- The tag shelf: the system's own way into a collection, and the fastest
     triage a reader gets on a blog index. --}}
<section class="ns-band ns-band--tight ns-band--sunken">
  <div class="ns-band__inner">
    <div class="ns-strip">
      {{#get "tags" filter="visibility:public" limit="10" include="count.posts" order="count.posts desc"}}
        {{#foreach tags}}
          <a class="ns-tag" href="{{url}}">{{name}}<span class="ns-tag__count">{{count.posts}}</span></a>
        {{/foreach}}
      {{/get}}
    </div>
  </div>
</section>

{{!-- .ns-blog-listing is the system's feed layout — the same rail-plus-grid
     shape as the course listing, so a reader who has used one has used both. --}}
<section class="ns-container ns-section">
  <div class="ns-blog-listing">

    {{!-- Main feed --}}
    <div class="min-w-0">
      {{#foreach posts limit="1"}}
        {{> "blog/featured-post"}}
      {{/foreach}}

      {{!-- In-feed: write for us --}}
      <div class="my-8 flex flex-col items-center justify-between gap-4 rounded-card border border-dashed border-border bg-surface-sunken p-6 text-center sm:flex-row sm:text-left">
        <div>
          <h2 class="ns-card__title">{{t "Have something to share?"}}</h2>
          <p class="ns-card__text">{{t "Write a guest post and reach thousands of Salesforce learners."}}</p>
        </div>
        <a href="/contact/" class="ns-btn ns-btn--primary shrink-0">{{> icons name="user-plus" class="h-4 w-4"}}{{t "Become an author"}}</a>
      </div>

      <div class="ns-blog-grid">
        {{#foreach posts from="2"}}
          <div class="motion-safe:animate-fade-up">{{> post-card}}</div>
        {{/foreach}}
      </div>

      {{!-- In-feed ad --}}
      <div class="mt-8">{{> "ads/slot" format="horizontal"}}</div>

      {{pagination}}
    </div>

    {{!-- Sidebar --}}
    <aside class="ns-blog-listing__rail">{{> "blog/sidebar"}}</aside>
  </div>
</section>
