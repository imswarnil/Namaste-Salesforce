{{!< default}}

{{!-- 1. BLOG HERO SECTION --}}
<section class="hero is-medium has-background-white-ter mb-6">
  <div class="hero-body">
    <div class="container has-text-centered">
      {{!-- Uses your site logo or icon if available, otherwise just text --}}
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}" style="max-height: 60px;" class="mb-4">
      {{/if}}
      <h1 class="title is-1 has-text-weight-bold has-text-dark">The Developer Blog</h1>
      <h2 class="subtitle is-4 has-text-grey mt-3">
        Insights, updates, and deep-dives from the Salesforce ecosystem.
      </h2>
    </div>
  </div>
</section>

{{!-- 2. POSTS FEED --}}
<section class="section pt-0">
  <div class="container">
    
    <div class="columns is-centered">
      <div class="column is-10-widescreen">
        
        <div class="columns is-multiline">
          {{#foreach posts}}
            
            {{!-- HERO/FEATURED POST: If it's the very first post on the page, make it huge --}}
            {{#if @first}}
              <div class="column is-12 mb-6">
                <article class="columns is-marginless is-vcentered shadow-box" style="border: 1px solid #f5f5f5; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
                  
                  <div class="column is-7 p-0">
                    <a href="{{url}}">
                      {{#if feature_image}}
                        <figure class="image is-5by3" style="height: 100%;">
                          <img src="{{img_url feature_image size="l"}}" alt="{{title}}" style="object-fit: cover; height: 100%; width: 100%;">
                        </figure>
                      {{else}}
                        <div class="has-background-light is-flex is-align-items-center is-justify-content-center" style="min-height: 350px; height: 100%;">
                          <span class="icon is-large has-text-grey-light"><i class="fas fa-image fa-3x"></i></span>
                        </div>
                      {{/if}}
                    </a>
                  </div>
                  
                  <div class="column is-5 is-flex is-flex-direction-column is-justify-content-center p-6">
                    {{#if primary_tag}}
                      <p class="heading has-text-primary has-text-weight-bold mb-3 is-size-7">{{primary_tag.name}}</p>
                    {{/if}}
                    
                    <h2 class="title is-2 mb-4" style="line-height: 1.2;">
                      <a href="{{url}}" class="has-text-dark">{{title}}</a>
                    </h2>
                    
                    <p class="is-size-6 has-text-grey mb-5">{{excerpt words="35"}}&hellip;</p>
                    
                    <div>
                      <a href="{{url}}" class="button is-primary is-rounded has-text-weight-bold">Read Article</a>
                    </div>
                  </div>
                  
                </article>
              </div>

              <div class="column is-12">
                <hr class="has-background-grey-lighter mt-2 mb-4">
              </div>

            {{!-- STANDARD GRID POSTS: For post #2 and onward --}}
            {{else}}
              <div class="column is-12-mobile is-6-tablet is-4-desktop">
                {{!-- Using the post-card partial we perfected earlier! --}}
                {{> "post-card"}}
              </div>
            {{/if}}

          {{/foreach}}
        </div>

        {{!-- 3. PAGINATION --}}
        <div class="mt-6 pt-4 is-flex is-justify-content-center">
          {{pagination}}
        </div>

      </div>
    </div>
    
  </div>
</section>