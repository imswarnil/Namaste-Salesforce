{{!< default}}
{{!-- blog.hbs — blog listing (custom template / routed collection).
     Featured post + in-feed author CTA + card grid, with a sticky sidebar. --}}

{{> "components/page-header" eyebrow="Namaste Salesforce" title="The Developer Blog" subtitle="Insights, updates and deep-dives from the Salesforce ecosystem."}}

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">

    {{!-- Main feed --}}
    <div class="min-w-0">
      {{#foreach posts limit="1"}}
        {{> "blog/featured-post"}}
      {{/foreach}}

      {{!-- In-feed: write for us --}}
      <div class="my-8 flex flex-col items-center justify-between gap-4 rounded-card border border-dashed border-border bg-surface-sunken p-6 text-center sm:flex-row sm:text-left">
        <div>
          <h2 class="font-heading text-lg font-bold">{{t "Have something to share?"}}</h2>
          <p class="mt-1 text-sm text-muted">{{t "Write a guest post and reach thousands of Salesforce learners."}}</p>
        </div>
        <a href="/contact/" class="ns-btn ns-btn--primary shrink-0">{{> icons name="user-plus" class="h-4 w-4"}}{{t "Become an author"}}</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {{#foreach posts from="2"}}
          <div class="motion-safe:animate-fade-up">{{> post-card}}</div>
        {{/foreach}}
      </div>

      {{!-- In-feed ad --}}
      <div class="mt-8">{{> "ads/slot" format="horizontal"}}</div>

      {{pagination}}
    </div>

    {{!-- Sidebar --}}
    <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">{{> "blog/sidebar"}}</aside>
  </div>
</section>
