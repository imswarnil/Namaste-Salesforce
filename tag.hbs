{{!< default}}
{{!-- tag.hbs — tag archive.

     Three different things live at /tag/{slug}/, so this template forks:

     1. A TRAINING SECTION tag redirects to /training/{slug}/, its real home.
        Detected by the #training-section POST whose primary tag it is — the
        section's backing post, so even a brand-new empty section redirects.
     2. A COURSE tag redirects to the course. A course post shares its primary
        tag with all its lessons, so the archive would be a duplicate, worse
        version of the course page.
     3. Anything else is a normal tag archive: header + post grid.

     The `../` depths inside the archive branch are load-bearing — Ghost 500s if
     a helper is called across `../`, so that branch is left exactly as it was. --}}

{{!-- A TRAINING SECTION tag: the section's real home is /training/{slug}/ (a
     post whose slug == this tag's slug). Detect by that section POST existing —
     more robust than looking for lessons, so a brand-new empty section still
     redirects. Never serve a duplicate archive here. --}}
{{#get "posts" filter="primary_tag:{{tag.slug}}+tag:hash-training-section" limit="1" as |section|}}
  {{#if section}}{{#foreach section}}
    {{!-- Redirect to the section post's OWN url (the collection permalink,
         /training/{slug}/). {{tag.slug}} is NOT readable here — {{#get}} swaps
         the context to its result, so reaching for the tag would emit
         /training// (empty slug). {{url}} is on the post and always resolves. --}}
    <script>window.location.replace("{{url}}");</script>
    <noscript><meta http-equiv="refresh" content="0; url={{url}}"></noscript>
    <link rel="canonical" href="{{url}}">
    <p class="ns-container ns-section text-center">{{t "Redirecting to the section…"}} <a href="{{url}}" class="ns-underline">{{title}}</a></p>
  {{/foreach}}{{else}}

  {{#tag}}
    {{#get "posts" filter="primary_tag:{{slug}}+tag:hash-course" limit="1" as |hub|}}
      {{#if hub}}{{#foreach hub}}
        <script>window.location.replace("{{url}}");</script>
        <noscript><meta http-equiv="refresh" content="0; url={{url}}"></noscript>
        <link rel="canonical" href="{{url absolute="true"}}">
        <p class="ns-container ns-section text-center">{{t "Redirecting…"}} <a href="{{url}}" class="ns-underline">{{title}}</a></p>
      {{/foreach}}{{else}}
    <header class="ns-coverhead border-b border-border bg-brand-900 text-white">
      {{#if feature_image}}
        {{!-- Decorative: the topic name is the heading below. --}}
        <img class="ns-coverhead__img" src="{{img_url feature_image size='xl'}}" alt=""
             aria-hidden="true" loading="lazy" decoding="async">
      {{/if}}
      <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:py-20">
        <p class="ns-kicker ns-kicker--light ns-kicker--center">{{t "Topic"}}</p>
        <h1 class="mt-2 font-heading text-4xl font-extrabold sm:text-5xl">{{name}}</h1>
        {{#if description}}
          <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">{{description}}</p>
        {{/if}}
        <p class="mt-6">
          <span class="ns-badge ns-badge--glass">
            {{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}
          </span>
        </p>
      </div>
    </header>
      {{/if}}
    {{/get}}
  {{/tag}}

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <div class="ns-blog-grid ns-defer">
      {{#foreach posts}}{{> post-card}}{{/foreach}}
    </div>
    {{pagination}}
  </section>

  {{/if}}
{{/get}}
