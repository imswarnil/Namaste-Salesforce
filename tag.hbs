{{!< default}}
{{!-- A tag archive, on NSDS's .ns-taghead.

     Its own template because Ghost exposes the tag as a BLOCK context only
     here — `{{tag.name}}` parses fine and renders nothing, which is why gscan
     rejects it rather than leaving it to be found on a live archive. --}}
{{#tag}}
    <header class="ns-taghead">
        {{!-- The # is drawn in CSS, not written in the DOM: a literal hash is
              read aloud as "number sign" before every tag name on the page. --}}
        <h1 class="ns-taghead__title">
            {{name}}
            <span class="ns-taghead__count">{{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}</span>
        </h1>
        {{#if description}}<p class="ns-taghead__desc">{{description}}</p>{{/if}}
        <div class="ns-taghead__actions">
            <a class="ns-btn ns-btn--outline ns-btn--sm" href="{{@site.url}}/rss/">
                {{> "icons/site/rss"}} {{t "Subscribe"}}
            </a>
        </div>
    </header>
{{/tag}}

{{> "collection" card="blog" rail=true}}
