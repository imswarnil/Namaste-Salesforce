{{!< default}}

{{!-- POST AS DISPATCHER. This template renders nothing itself:
it reads the post's internal collection tag out of post_class
and hands the whole post to the partial that owns that reading
experience. One tag decides the URL (routes.yaml), the layout
(here) and the queries that find the post — nothing else in the
theme knows the difference.

    #course-col   / #courses-col  → post-course   (course landing)
    #lesson-col   / #lessons-col  → post-lesson   (course player)
    #training-col / #docs-col     → post-training (module reader)
    #video-col                    → post-video    (the embed is the page)
    #newsletter-col               → post-issue    (issue + sent-date rail)
    #changelog-col / #feed-col    → post-simple   (narrow entry)
    anything else                 → post-blog     (the article)
--}}

{{#post}}
    {{#match (post_class) "~" "tag-hash-course-col"}}
        {{> "post-course"}}
    {{else match (post_class) "~" "tag-hash-courses-col"}}
        {{> "post-course"}}
    {{else match (post_class) "~" "tag-hash-lesson-col"}}
        {{> "post-lesson"}}
    {{else match (post_class) "~" "tag-hash-lessons-col"}}
        {{> "post-lesson"}}
    {{else match (post_class) "~" "tag-hash-training-col"}}
        {{> "post-training"}}
    {{else match (post_class) "~" "tag-hash-docs-col"}}
        {{> "post-training"}}
    {{else match (post_class) "~" "tag-hash-video-col"}}
        {{> "post-video"}}
    {{else match (post_class) "~" "tag-hash-newsletter-col"}}
        {{> "post-issue"}}
    {{else match (post_class) "~" "tag-hash-changelog-col"}}
        {{> "post-simple" sectionLabel="Changelog" sectionUrl="/changelog/" sectionIcon="history" withSidebar=true}}
    {{else match (post_class) "~" "tag-hash-feed-col"}}
        {{> "post-simple" sectionLabel="Changelog" sectionUrl="/changelog/" sectionIcon="history" withSidebar=true}}
    {{else match (post_class) "~" "tag-hash-resource-col"}}
        {{> "post-resource"}}
    {{else match (post_class) "~" "tag-hash-shop-col"}}
        {{> "post-product"}}
    {{else match (post_class) "~" "tag-hash-snippet-col"}}
        {{> "post-snippet"}}
    {{else match (post_class) "~" "tag-hash-prompt-col"}}
        {{> "post-prompt"}}
    {{else}}
        {{> "post-blog"}}
    {{/match}}
{{/post}}
