{{!< default}}
{{!-- post.hbs  Post type dispatcher
     Both #training and #training-content route to post-training partial.
     The partial uses has helper internally to switch layouts.
--}}
{{#post}}
  {{#has tag="documentation"}}
    {{> "post-documentation"}}
  {{else has tag="#training-content"}}
    {{> "post-training"}}
  {{else has tag="#training"}}
    {{> "post-training"}}
  {{else has tag="#module"}}
    {{> "post-lesson"}}
  {{else has tag="#course"}}
    {{> "post-course"}}
  {{else has tag="#lesson"}}
    {{> "post-lesson"}}
  {{else has tag="#blog"}}
    {{> "post-blog"}}
  {{else}}
    {{> "post-default"}}
  {{/has}}
{{/post}}
