{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  post.hbs — THE DISPATCHER.

  Ghost gives a theme exactly one post.hbs for every post on the site. This
  site has several kinds of post that are genuinely different PAGES, so this
  file will read tags and dispatch to a partial per kind:

      {{#has tag="#course"}}  {{> "post-course"}}
      {{else has tag="#lesson"}} {{> "post-lesson"}}
      …
      {{else}}                {{> "post-default"}}

  ⚠️ BRANCH ORDER IS LOAD-BEARING — #training-section must be tested BEFORE
  #training-content, or a section overview renders inside the lesson player.
  Read abstract/02 before adding a branch.

  There is only one kind of page so far, so there is nothing to dispatch on.
═══════════════════════════════════════════════════════════════════════════ --}}
{{#post}}
  <article>
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}

    <p>
      {{#primary_author}}<a href="{{url}}">{{name}}</a>{{/primary_author}}
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
      {{#if reading_time}}{{reading_time}}{{/if}}
    </p>

    {{#if feature_image}}
      <img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">
    {{/if}}

    <div class="gh-content">{{content}}</div>
  </article>
{{/post}}
