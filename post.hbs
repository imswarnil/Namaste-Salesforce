{{!< default}}

{{#post}}
    {{#has tag="#course"}}
        {{> "post-course"}}
    {{else has tag="#training-section"}}
        {{> "post-training"}}
    {{else has tag="#lesson"}}
        {{> "post-lesson"}}
    {{else has tag="#blog"}}
        {{> "post-blog"}}
    {{else has tag="#video"}}
        {{> "post-blog"}}
    {{else}}
        {{> "post-default"}}
    {{/has}}
{{/post}}