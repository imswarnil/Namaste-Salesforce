{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  THE DISPATCHER. Ghost gives one post.hbs for every kind of post on the site,
  and they are different PAGES. Read abstract/02 before adding a branch —
  BRANCH ORDER IS LOAD-BEARING (#training-section before #training-content).
═══════════════════════════════════════════════════════════════════════════ --}}
{{#post}}
  <article class="ns-post">
    <div class="ns-post__body">
      <h1 class="ns-posthead__title">{{title}}</h1>
      <div class="ns-prose gh-content">{{content}}</div>
    </div>
  </article>
{{/post}}
