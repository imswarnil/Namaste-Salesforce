  {{!< default}}

  {{#post}}
    {{#has tag="documentation"}}
      {{> "post-documentation"}}
    {{else has tag="#training-content"}}
      {{> "post-training"}}
    {{else has tag="#course"}}
      {{> "post-course"}}
    {{else has tag="#lesson"}}
      {{> "post-lesson"}}
    {{else has tag="#resource"}}
      {{> "post-resource"}}
    {{else has tag="#blog"}}
      {{> "post-blog"}}
    {{else}}
      {{> "post-default"}}
    {{/has}}
  {{/post}}
