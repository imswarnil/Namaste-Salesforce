{{!< default}}
{{!-- An author archive. Separate from index.hbs for the same reason tag.hbs
     is: Ghost exposes the author as a block context only here. --}}
{{#author}}
    <header class="ns-taghead">
        <div class="ns-page">
            <h1 class="ns-taghead__title">
                {{name}}
                <span class="ns-taghead__count">{{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}</span>
            </h1>
            {{#if bio}}<p class="ns-taghead__desc">{{bio}}</p>{{/if}}
            {{#if website}}
                <div class="ns-taghead__actions">
                    <a class="ns-btn ns-btn--outline ns-btn--sm" href="{{website}}" target="_blank" rel="noopener">
                        <i class="ph ph-link-simple" aria-hidden="true"></i> {{t "Website"}}
                    </a>
                </div>
            {{/if}}
        </div>
    </header>
{{/author}}
{{> "listing" rail=true}}
