{{!< default}}
{{!-- author.hbs — author archive: profile header + post grid --}}

{{#author}}
  <header class="ns-coverhead border-b border-border bg-brand-900 text-white">
    {{#if cover_image}}
      {{!-- Decorative: the author's name is the heading below, so the cover
            carries no information a screen reader needs. --}}
      {{> "components/img" src=cover_image alt="" class="ns-coverhead__img" sizes="100vw"}}
    {{/if}}
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:py-20">
      {{#if profile_image}}
        <span class="ns-avatar ns-avatar--xl mx-auto mb-5 block border-[3px] border-white/25 shadow-raised">
          <img loading="lazy" decoding="async" src="{{img_url profile_image size='s'}}" alt="">
        </span>
      {{/if}}
      <p class="ns-kicker ns-kicker--light ns-kicker--center">{{t "Author"}}</p>
      <h1 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl lg:text-5xl">{{name}}</h1>
      {{#if bio}}
        <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">{{bio}}</p>
      {{/if}}

      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm text-white/85">
        <span class="ns-badge ns-badge--glass">
          {{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}
        </span>
        {{#if location}}<span class="inline-flex items-center gap-1">{{> icons name="map-pin"}}{{location}}</span>{{/if}}
        {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-white">{{> icons name="globe"}}{{t "Website"}}</a>{{/if}}
        {{#if twitter}}<a href="https://twitter.com/{{twitter}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-white">{{> icons name="x-logo"}}Twitter</a>{{/if}}
      </div>
    </div>
  </header>
{{/author}}

<div class="ns-container ns-section">
  <div class="ns-blog-grid ns-defer">
    {{#foreach posts}}{{> post-card}}{{/foreach}}
  </div>
  {{pagination}}
</div>
