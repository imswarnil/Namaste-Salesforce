{{!< default}}
{{!-- An author archive. Separate from index.hbs for the same reason tag.hbs
     is: Ghost exposes the author as a block context only here. --}}

<section class="ns-band">
  <div class="ns-band__inner">

    {{#author}}
      <div class="ns-band__head">
        <p class="ns-kicker">{{t "Author"}}</p>
        <h1 class="ns-band__title">{{name}}</h1>
        {{#if bio}}<p class="ns-band__lede">{{bio}}</p>{{/if}}

        {{#if website}}
          <div class="ns-band__actions">
            <a class="ns-btn ns-btn--quiet ns-btn--sm" href="{{website}}" target="_blank" rel="noopener">
              <i class="ph ph-link-simple" aria-hidden="true"></i> {{t "Website"}}
            </a>
          </div>
        {{/if}}
      </div>
    {{/author}}

    {{#if posts}}
      <div class="ns-grid">
        {{#foreach posts}}{{> "post-card"}}{{/foreach}}
      </div>
    {{else}}
      <p class="ns-empty">{{t "No posts yet."}}</p>
    {{/if}}

    {{pagination}}

  </div>
</section>
