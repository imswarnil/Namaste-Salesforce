{{!< default}}

{{#author}}
<section class="archive-hero outer">
    <div class="archive-hero-inner inner">
        <div class="archive-hero-media">
            {{#if profile_image}}
                <img class="avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" />
            {{else}}
                <span class="avatar avatar-fallback">{{> "icons/avatar"}}</span>
            {{/if}}
        </div>
        <div>
            <span class="kicker">{{> "icons/pen"}} {{t "Author"}}</span>
            <h1>{{name}}</h1>
            {{#if bio}}<p class="archive-hero-desc">{{bio}}</p>{{/if}}
            <div class="archive-hero-meta">
                {{#if location}}<span>{{location}}</span>{{/if}}
                {{#if website}}<a href="{{website}}" target="_blank" rel="noopener">{{> "icons/external"}} {{t "Website"}}</a>{{/if}}
                {{#if twitter}}<a href="{{social_url type="twitter"}}" target="_blank" rel="noopener">{{> "icons/x"}} {{twitter}}</a>{{/if}}
            </div>
        </div>
    </div>
</section>
{{/author}}

<main id="site-main" class="archive-main outer">
    <div class="inner">
        <div class="card-grid">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</main>
