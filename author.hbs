{{!< default}}
{{!-- author.hbs — author archive: profile header + post grid --}}

{{#author}}
  <header class="ns-coverhead border-b border-border bg-brand-900 text-white">
    {{#if cover_image}}
      {{!-- Decorative: the author's name is the heading below, so the cover
            carries no information a screen reader needs. --}}
      <img class="ns-coverhead__img" src="{{img_url cover_image size='xl'}}" alt=""
           aria-hidden="true" loading="lazy" decoding="async">
    {{/if}}
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:py-20">
      {{#if profile_image}}
        <img loading="lazy" decoding="async" src="{{img_url profile_image size='s'}}" alt="{{name}}"
             class="mx-auto mb-5 h-28 w-28 rounded-full border-[3px] border-white/25 object-cover shadow-raised">
      {{/if}}
      <p class="ns-kicker ns-kicker--light ns-kicker--center">{{t "Author"}}</p>
      <h1 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl lg:text-5xl">{{name}}</h1>
      {{#if bio}}
        <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">{{bio}}</p>
      {{/if}}

      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm text-white/85">
        <span class="ns-badge ns-badge--glass">
          {{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}
        </span>
        {{#if location}}<span class="inline-flex items-center gap-1"><i class="ph ph-map-pin" aria-hidden="true"></i>{{location}}</span>{{/if}}
        {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-white"><i class="ph ph-globe" aria-hidden="true"></i>{{t "Website"}}</a>{{/if}}
        {{#if twitter}}<a href="https://twitter.com/{{twitter}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-white"><i class="ph-fill ph-twitter-logo" aria-hidden="true"></i>Twitter</a>{{/if}}
      </div>
    </div>
  </header>
{{/author}}

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#foreach posts}}
      <div class="motion-safe:animate-fade-up">{{> post-card}}</div>
    {{/foreach}}
  </div>
  {{pagination}}
</section>
