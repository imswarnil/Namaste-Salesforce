{{!< default}}
{{!-- error.hbs — the generic error page (Ghost supplies the {{@error}} context)
     Uses the .ns-404 COMPONENT — see 2-components/page.css and
     /styleguide/page-404.html. A dead end should offer the two or three places
     a lost visitor actually wanted. --}}
<section class="ns-page ns-page--narrow">
  <div class="ns-page__inner">
    <div class="ns-404">
      <div class="ns-404__code">{{error.statusCode}}</div>
      <h1 class="ns-404__title">{{error.message}}</h1>
      <p class="ns-404__body">{{t "Sorry, the page you were looking for doesn’t exist or has moved."}}</p>
      <div class="ns-404__actions">
        <a href="{{@site.url}}" class="ns-btn ns-btn--primary"><i class="ph ph-house" aria-hidden="true"></i>{{t "Back to home"}}</a>
        <a href="/courses/" class="ns-btn ns-btn--outline"><i class="ph ph-graduation-cap" aria-hidden="true"></i>{{t "Browse courses"}}</a>
        <a href="/docs/" class="ns-btn ns-btn--outline"><i class="ph ph-books" aria-hidden="true"></i>{{t "Search the docs"}}</a>
      </div>
    </div>
  </div>
</section>
