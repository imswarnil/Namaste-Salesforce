{{!< default}}
{{!-- Every non-404 error.

     {{error.statusCode}}, not {{error.statusCode}} — the bare forms are the legacy
     ones and gscan fails the theme on them. In production Ghost hides the
     stack, which is why there is nothing here to print one.

     role="alert" is NSDS's own on this component. --}}
<div class="ns-page ns-page--narrow">
    <div class="ns-empty ns-error-state" role="alert">
        <p class="ns-empty__code">{{error.statusCode}}</p>
        <p class="ns-empty__title">{{error.message}}</p>
        <p class="ns-empty__text">{{t "Something went wrong on our side."}}</p>
        <div class="ns-empty__action">
            <a class="ns-btn ns-btn--primary" href="{{@site.url}}">{{> "icons/home"}} {{t "Homepage"}}</a>
        </div>
    </div>
</div>
