{{!< default}}
{{!-- Every error Ghost does not have a more specific template for.

     It extends default.hbs on purpose, so a reader who hits an error still
     has the site's navigation and can leave without using the back button —
     which is the entire job of an error page. --}}
<section class="ns-band">
    <div class="ns-band__inner ns-page--prose">
        <p class="ns-kicker">{{statusCode}}</p>
        <h1 class="ns-band__title">{{message}}</h1>
        <div class="ns-band__actions">
            <a class="ns-btn ns-btn--primary" href="{{@site.url}}">{{t "Go to the front page"}}</a>
            {{#if @custom.show_search}}
                <button type="button" class="ns-btn ns-btn--outline" data-ghost-search>
                    {{> "icons/navbar/search"}} {{t "Search"}}
                </button>
            {{/if}}
        </div>
    </div>
</section>
