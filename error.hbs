{{!< default}}
{{!-- error.hbs — generic error page (Ghost provides the {{@error}} / error context) --}}

<section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 py-24 text-center">
  <p class="font-heading text-7xl font-extrabold tracking-tight text-brand-500 sm:text-8xl">{{error.statusCode}}</p>
  <h1 class="mt-4 text-2xl font-bold sm:text-3xl">{{error.message}}</h1>
  <p class="mt-3 max-w-md text-muted">{{t "Sorry, the page you were looking for doesn’t exist or has moved."}}</p>
  <a href="{{@site.url}}"
     class="mt-8 inline-flex items-center gap-2 rounded-pill bg-brand-500 px-5 py-2.5 font-semibold text-white shadow-brand transition hover:bg-brand-600">
    <i class="ph ph-house" aria-hidden="true"></i>{{t "Back to home"}}
  </a>
</section>
