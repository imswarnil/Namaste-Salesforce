{{!< default}}
{{!--
    home.hbs — Namaste Salesforce
    ============================================================
    Homepage template. Sections:
      1.  Hero (dark gradient, featured path card, stats)
      2.  Platform pillars (4 features)
      3.  Career paths (Admin / Developer / Architect)
      4.  Featured courses (Ghost {{#get}} tag:hash-course)
      5.  "Engineer Way" (features + YouTube video)
      6.  Why learn (2 columns)
      7.  About me (creator + timeline)
      8.  Blog + sidebar
      9.  Testimonials
      10. Final CTA banner

    USES: --sfdc-* CSS variables (no Bulma, no Bootstrap).
    ICONS: Phosphor Icons (ph ph-*). Ensure the Phosphor CDN
           script is loaded in default.hbs <head>.
    ============================================================
--}}

{{!-- ═══════════════════════════════════════════════════════════
     1. HERO
══════════════════════════════════════════════════════════════ --}}
<section class="home-hero  outer" aria-label="{{t "Site hero"}}">

    {{!-- Optional video background (or fallback gradient) --}}
    <div class="home-hero__bg" aria-hidden="true"></div>
    <div class="home-hero__overlay" aria-hidden="true"></div>

    <div class="home-hero__body inner">
        <div class="home-hero__grid">

            {{!-- Left column: headline + CTAs + logos --}}
            <div class="home-hero__content">

                <div class="home-hero__badge">
                    <i class="ph ph-lightning-fill" aria-hidden="true"></i>
                    <span>{{t "Hands-on Salesforce Learning Platform"}}</span>
                </div>

                <h1 class="home-hero__title">
                    {{t "Become a"}} <em class="home-hero__accent">{{t "Salesforce Application Engineer"}}</em>.
                </h1>

                <p class="home-hero__description">
                    {{#if @site.description}}
                        {{@site.description}}
                    {{else}}
                        {{t "Go beyond the basics. Master programmatic development, complex architecture, LWC, and integrations through a real-world, project-based curriculum."}}
                    {{/if}}
                </p>

                <div class="home-hero__actions btn-group-gap">
                    <a href="/courses/" class="btn btn-white btn-lg btn-pill">
                        <i class="ph ph-book-open btn-icon" aria-hidden="true"></i>
                        <span>{{t "Explore Curriculum"}}</span>
                    </a>
                    {{#if @site.members_enabled}}
                        {{#unless @member}}
                            <a href="#/portal/signup" data-portal="signup" class="btn btn-outline-white btn-lg btn-pill">
                                <i class="ph ph-sparkle btn-icon" aria-hidden="true"></i>
                                <span>{{t "Start for Free"}}</span>
                            </a>
                        {{else}}
                            <a href="/courses/" class="btn btn-outline-white btn-lg btn-pill">
                                <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
                                <span>{{t "Continue Learning"}}</span>
                            </a>
                        {{/unless}}
                    {{/if}}
                </div>

                {{!-- Hired by --}}
                <div class="home-hero__hired">
                    <p class="home-hero__hired-label">{{t "Application Engineers from our platform are hired by"}}</p>
                    <div class="home-hero__hired-logos">
                        <span>Salesforce</span>
                        <span>Deloitte</span>
                        <span>Accenture</span>
                        <span>IBM</span>
                        <span>Cognizant</span>
                    </div>
                </div>
            </div>

            {{!-- Right column: featured path card --}}
            <div class="home-hero__card-wrap">
                <div class="home-featured-card">
                    <div class="home-featured-card__header">
                        <div class="home-featured-card__icon" aria-hidden="true">
                            <i class="ph ph-code" style="font-size: 2rem;"></i>
                        </div>
                        <span class="home-featured-card__badge">{{t "Featured Path"}}</span>
                    </div>
                    <h3 class="home-featured-card__title">{{t "Salesforce Developer Path"}}</h3>
                    <p class="home-featured-card__desc">
                        {{t "Master programmatic development. Cover Apex fundamentals, Lightning Web Components, SOQL, and REST integrations through real builds."}}
                    </p>

                    <div class="home-featured-card__progress-block">
                        <div class="home-featured-card__progress-label">
                            <span>{{t "Curriculum Style"}}</span>
                            <strong>{{t "100% Practical"}}</strong>
                        </div>
                        <div class="home-featured-card__progress-bar" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                            <div class="home-featured-card__progress-fill" style="width: 100%"></div>
                        </div>
                    </div>

                    <ul class="home-featured-card__list">
                        <li>
                            <i class="ph ph-check-circle" aria-hidden="true"></i>
                            {{t "Zero to Advanced Progression"}}
                        </li>
                        <li>
                            <i class="ph ph-check-circle" aria-hidden="true"></i>
                            {{t "Build 5 Real-world Projects"}}
                        </li>
                        <li>
                            <i class="ph ph-check-circle" aria-hidden="true"></i>
                            {{t "Platform Developer I & II Aligned"}}
                        </li>
                    </ul>

                    <a href="/courses/" class="btn btn-secondary btn-block">
                        <span>{{t "View Curriculum Path"}}</span>
                        <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
                    </a>
                </div>
            </div>

        </div>

        {{!-- Stats row --}}
        <div class="home-stats">
            <div class="home-stat">
                <span class="home-stat__number">3+</span>
                <span class="home-stat__label">{{t "Learning Tracks"}}</span>
            </div>
            <div class="home-stat">
                <span class="home-stat__number">20+</span>
                <span class="home-stat__label">{{t "In-depth Courses"}}</span>
            </div>
            <div class="home-stat">
                <span class="home-stat__number">100+</span>
                <span class="home-stat__label">{{t "Step-by-step Guides"}}</span>
            </div>
            <div class="home-stat">
                <span class="home-stat__number">1k+</span>
                <span class="home-stat__label">{{t "Community Members"}}</span>
            </div>
        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     2. PLATFORM PILLARS
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-pillars" aria-label="{{t "Platform features"}}">
    <div class="inner">
        <div class="home-pillars__grid">
            <div class="home-pillar reveal">
                <div class="home-pillar__icon home-pillar__icon--blue">
                    <i class="ph ph-book-open-text" aria-hidden="true"></i>
                </div>
                <h3 class="home-pillar__title">{{t "Structured Curriculum"}}</h3>
                <p class="home-pillar__desc">{{t "Step-by-step learning paths built for progression, not just consumption."}}</p>
            </div>
            <div class="home-pillar reveal delay-1">
                <div class="home-pillar__icon home-pillar__icon--orange">
                    <i class="ph ph-code" aria-hidden="true"></i>
                </div>
                <h3 class="home-pillar__title">{{t "Hands-on Projects"}}</h3>
                <p class="home-pillar__desc">{{t "Build real Salesforce applications, not just follow along with screenshots."}}</p>
            </div>
            <div class="home-pillar reveal delay-2">
                <div class="home-pillar__icon home-pillar__icon--purple">
                    <i class="ph ph-exam" aria-hidden="true"></i>
                </div>
                <h3 class="home-pillar__title">{{t "Certification Prep"}}</h3>
                <p class="home-pillar__desc">{{t "Career-focused training aligned to Admin, PD1, PD2, and Architect certifications."}}</p>
            </div>
            <div class="home-pillar reveal delay-3">
                <div class="home-pillar__icon home-pillar__icon--green">
                    <i class="ph ph-users-three" aria-hidden="true"></i>
                </div>
                <h3 class="home-pillar__title">{{t "Community Support"}}</h3>
                <p class="home-pillar__desc">{{t "Learn alongside a growing ecosystem of Salesforce builders and future architects."}}</p>
            </div>
        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     3. CAREER PATHS
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-section--alt home-paths outer" aria-label="{{t "Career paths"}}">
    <div class="inner">
        <div class="home-section__header has-text-center reveal">
            <p class="home-section__overline">{{t "Choose your direction"}}</p>
            <h2 class="home-section__title">{{t "Choose your career path"}}</h2>
            <p class="home-section__subtitle">{{t "Pick the Salesforce route that matches your goal and ambition."}}</p>
        </div>

        <div class="home-paths__grid">
            <div class="home-path-card reveal delay-1">
                <div class="home-path-card__icon home-path-card__icon--gold" aria-hidden="true">
                    <i class="ph ph-gear-six"></i>
                </div>
                <h3 class="home-path-card__title">{{t "Salesforce Admin"}}</h3>
                <p class="home-path-card__desc">{{t "Security, flows, reports, automation, setup, and day-to-day platform ownership."}}</p>
                <ul class="home-path-card__skills">
                    <li>{{t "Automation & Flows"}}</li>
                    <li>{{t "Security Model"}}</li>
                    <li>{{t "Reports & Dashboards"}}</li>
                </ul>
                <a href="/courses/" class="btn btn-ghost-brand btn-sm btn-pill">
                    {{t "View Admin Path"}}
                    <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
                </a>
            </div>

            <div class="home-path-card home-path-card--featured reveal delay-2">
                <div class="home-path-card__popular-badge">{{t "Most Popular"}}</div>
                <div class="home-path-card__icon home-path-card__icon--blue" aria-hidden="true">
                    <i class="ph ph-code"></i>
                </div>
                <h3 class="home-path-card__title">{{t "Salesforce Developer"}}</h3>
                <p class="home-path-card__desc">{{t "Apex, LWC, APIs, triggers, testing, packaging, and scalable custom app builds."}}</p>
                <ul class="home-path-card__skills">
                    <li>{{t "Apex & LWC"}}</li>
                    <li>{{t "SOQL & Integrations"}}</li>
                    <li>{{t "DevOps & Testing"}}</li>
                </ul>
                <a href="/courses/" class="btn btn-primary btn-sm btn-pill">
                    {{t "View Developer Path"}}
                    <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
                </a>
            </div>

            <div class="home-path-card reveal delay-3">
                <div class="home-path-card__icon home-path-card__icon--purple" aria-hidden="true">
                    <i class="ph ph-tree-structure"></i>
                </div>
                <h3 class="home-path-card__title">{{t "Salesforce Architect"}}</h3>
                <p class="home-path-card__desc">{{t "Solution design, integrations, data strategy, governance, and enterprise scale thinking."}}</p>
                <ul class="home-path-card__skills">
                    <li>{{t "Solution Design"}}</li>
                    <li>{{t "Data Architecture"}}</li>
                    <li>{{t "Enterprise Governance"}}</li>
                </ul>
                <a href="/courses/" class="btn btn-ghost-brand btn-sm btn-pill">
                    {{t "View Architect Path"}}
                    <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     4. FEATURED COURSES
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-courses outer" aria-label="{{t "Featured courses"}}">
    <div class="inner">
        <div class="home-section__header-inline reveal">
            <div>
                <p class="home-section__overline">{{t "Learn by doing"}}</p>
                <h2 class="home-section__title">{{t "Featured Courses"}}</h2>
                <p class="home-section__subtitle">{{t "Practical courses built for real outcomes."}}</p>
            </div>
            <a href="/courses/" class="btn btn-neutral">
                {{t "View All Courses"}}
                <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
            </a>
        </div>

        {{#get "posts" filter="tag:hash-course" limit="4" include="tags,authors"}}
            {{#if posts}}
                <div class="home-courses__grid">
                    {{#foreach posts}}
    {{> "post-card"}}
                    {{/foreach}}
                </div>
            {{else}}
                <div class="home-empty-state">
                    <i class="ph ph-books" aria-hidden="true"></i>
                    <p>{{t "No courses yet — tag posts with"}} <code>#course</code> {{t "to show them here."}}</p>
                </div>
            {{/if}}
        {{/get}}

        <div class="home-courses__view-all-mobile">
            <a href="/courses/" class="btn btn-neutral btn-block">{{t "View All Courses"}}</a>
        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     5. THE ENGINEER WAY (features + YouTube)
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-section--alt home-engineer outer" aria-label="{{t "How we teach"}}">
    <div class="inner">
        <div class="home-section__header has-text-center reveal">
            <p class="home-section__overline">{{t "Our approach"}}</p>
            <h2 class="home-section__title">{{t "Learn the \"Engineer\" Way"}}</h2>
            <p class="home-section__subtitle">{{t "We don't just teach syntax — we teach problem-solving for enterprise scale."}}</p>
        </div>

        <div class="home-engineer__layout">

            {{!-- Left features --}}
            <div class="home-engineer__features">
                <div class="home-feature reveal delay-1">
                    <div class="home-feature__icon home-feature__icon--blue" aria-hidden="true">
                        <i class="ph ph-lightning-fill"></i>
                    </div>
                    <div class="home-feature__body">
                        <h4 class="home-feature__title">{{t "Instant Setup"}}</h4>
                        <p class="home-feature__desc">{{t "One-click scratch org deployments for every lesson. No config hell."}}</p>
                    </div>
                </div>
                <div class="home-feature reveal delay-2">
                    <div class="home-feature__icon home-feature__icon--purple" aria-hidden="true">
                        <i class="ph ph-users-three-fill"></i>
                    </div>
                    <div class="home-feature__body">
                        <h4 class="home-feature__title">{{t "Code Reviews"}}</h4>
                        <p class="home-feature__desc">{{t "Get feedback on your PRs from experienced Salesforce developers."}}</p>
                    </div>
                </div>
                <div class="home-feature reveal delay-3">
                    <div class="home-feature__icon home-feature__icon--green" aria-hidden="true">
                        <i class="ph ph-certificate-fill"></i>
                    </div>
                    <div class="home-feature__body">
                        <h4 class="home-feature__title">{{t "PDII & Beyond"}}</h4>
                        <p class="home-feature__desc">{{t "Curriculum aligned with Advanced Developer certifications."}}</p>
                    </div>
                </div>
                <div class="home-feature reveal delay-4">
                    <div class="home-feature__icon home-feature__icon--orange" aria-hidden="true">
                        <i class="ph ph-git-branch-fill"></i>
                    </div>
                    <div class="home-feature__body">
                        <h4 class="home-feature__title">{{t "DevOps Focus"}}</h4>
                        <p class="home-feature__desc">{{t "Learn Git, SFDX, and Automated Testing from Day 1."}}</p>
                    </div>
                </div>
            </div>

            {{!-- Center video --}}
            <div class="home-engineer__video reveal">
                <div class="home-video-phone">
                    <iframe
                        class="home-video-phone__frame"
                        src="https://www.youtube.com/embed/VlIu7K52Moo"
                        title="{{t "Salesforce Tips"}}"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        loading="lazy"
                    ></iframe>
                </div>
            </div>

        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     6. WHY LEARN
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-why outer" aria-label="{{t "Why learn with us"}}">
    <div class="inner">
        <div class="home-why__grid">

            <div class="home-why__left reveal">
                <p class="home-section__overline">{{t "Our promise"}}</p>
                <h2 class="home-section__title">{{t "Why learn with"}} {{@site.title}}?</h2>

                <div class="home-why__reason">
                    <div class="home-why__reason-icon" aria-hidden="true">
                        <i class="ph ph-chalkboard-teacher"></i>
                    </div>
                    <div class="home-why__reason-body">
                        <h4>{{t "Expert-led guidance"}}</h4>
                        <p>{{t "Learn from people who build in Salesforce, not just people who repeat docs with dramatic confidence."}}</p>
                    </div>
                </div>
                <div class="home-why__reason">
                    <div class="home-why__reason-icon" aria-hidden="true">
                        <i class="ph ph-laptop"></i>
                    </div>
                    <div class="home-why__reason-body">
                        <h4>{{t "100% practical learning"}}</h4>
                        <p>{{t "Every course is designed around implementation, exercises, and project-based outcomes."}}</p>
                    </div>
                </div>
                <div class="home-why__reason">
                    <div class="home-why__reason-icon" aria-hidden="true">
                        <i class="ph ph-users-three"></i>
                    </div>
                    <div class="home-why__reason-body">
                        <h4>{{t "Community and momentum"}}</h4>
                        <p>{{t "Stay consistent with a growing ecosystem of learners, builders, and future architects."}}</p>
                    </div>
                </div>
            </div>

            <div class="home-why__right reveal delay-2">
                <div class="home-why__feature-grid">
                    <div class="home-why__feature">
                        <i class="ph ph-video-camera" aria-hidden="true"></i>
                        <h5>{{t "Video Lessons"}}</h5>
                        <p>{{t "Clear walkthroughs and guided builds."}}</p>
                    </div>
                    <div class="home-why__feature">
                        <i class="ph ph-files" aria-hidden="true"></i>
                        <h5>{{t "Docs & Notes"}}</h5>
                        <p>{{t "Supporting references and written guides."}}</p>
                    </div>
                    <div class="home-why__feature">
                        <i class="ph ph-briefcase" aria-hidden="true"></i>
                        <h5>{{t "Career Ready"}}</h5>
                        <p>{{t "Skills with portfolio and job value."}}</p>
                    </div>
                    <div class="home-why__feature">
                        <i class="ph ph-lifebuoy" aria-hidden="true"></i>
                        <h5>{{t "Supportive"}}</h5>
                        <p>{{t "Less confusion, more clarity and direction."}}</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     7. ABOUT ME
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-section--alt home-about outer" aria-label="{{t "About"}}">
    <div class="inner">
        <div class="home-about__grid">

            <div class="home-about__left reveal">
                <p class="home-section__overline">{{t "The person behind this"}}</p>
                <h2 class="home-section__title">{{t "About me"}}</h2>

                <div class="home-about__creator">
                    {{#if @site.icon}}
                        <img class="home-about__avatar" src="{{@site.icon}}" alt="Swarnil" />
                    {{else}}
                        <div class="home-about__avatar-placeholder" aria-hidden="true">S</div>
                    {{/if}}
                    <div class="home-about__creator-meta">
                        <strong class="home-about__name">Swarnil</strong>
                        <span class="home-about__role">{{t "Salesforce Developer — Building in public"}}</span>
                        <div class="home-about__socials btn-group-gap">
                            <a href="https://twitter.com/imswarnil" target="_blank" rel="noopener noreferrer" class="btn btn-neutral btn-xs">
                                <i class="ph ph-twitter-logo btn-icon" aria-hidden="true"></i>
                                Twitter
                            </a>
                            <a href="https://github.com/imswarnil" target="_blank" rel="noopener noreferrer" class="btn btn-neutral btn-xs">
                                <i class="ph ph-github-logo btn-icon" aria-hidden="true"></i>
                                GitHub
                            </a>
                        </div>
                    </div>
                </div>

                <div class="home-about__bio">
                    <p>{{t "I'm on a mission to become a"}} <strong>{{t "Salesforce Application Engineer"}}</strong> {{t "at a top product company. This site is where I document that journey — and help others walk the same path."}}</p>
                    <p>{{t "No exam dumps, no recycled slides. Just practical builds and honest notes from the road."}}</p>
                </div>

                <a href="/contact/" class="btn btn-secondary btn-pill">
                    <i class="ph ph-chat-circle-dots btn-icon" aria-hidden="true"></i>
                    {{t "Get in touch"}}
                </a>
            </div>

            <div class="home-about__right reveal delay-2">
                <h3 class="home-about__timeline-heading">{{t "The journey so far"}}</h3>
                <ol class="home-timeline">
                    <li class="home-timeline__item">
                        <div class="home-timeline__dot" aria-hidden="true"></div>
                        <div class="home-timeline__body">
                            <h4 class="home-timeline__title">{{t "Started with Salesforce Admin"}}</h4>
                            <p class="home-timeline__sub">{{t "Learning the platform from the ground up — flows, automation, security model."}}</p>
                        </div>
                    </li>
                    <li class="home-timeline__item">
                        <div class="home-timeline__dot" aria-hidden="true"></div>
                        <div class="home-timeline__body">
                            <h4 class="home-timeline__title">{{t "Moved into Salesforce Development"}}</h4>
                            <p class="home-timeline__sub">{{t "Apex, LWC, SOQL, integrations — building real things, not just reading docs."}}</p>
                        </div>
                    </li>
                    <li class="home-timeline__item">
                        <div class="home-timeline__dot" aria-hidden="true"></div>
                        <div class="home-timeline__body">
                            <h4 class="home-timeline__title">{{t "Launched Namaste Salesforce"}}</h4>
                            <p class="home-timeline__sub">{{t "Open source learning portal — built in public, for the community."}}</p>
                        </div>
                    </li>
                    <li class="home-timeline__item home-timeline__item--current">
                        <div class="home-timeline__dot" aria-hidden="true"></div>
                        <div class="home-timeline__body">
                            <h4 class="home-timeline__title">{{t "Goal: Salesforce Application Engineer"}}</h4>
                            <p class="home-timeline__sub">{{t "Top product-based company — documenting the whole path here."}}</p>
                        </div>
                    </li>
                </ol>

                <div class="home-about__open-source">
                    <i class="ph ph-info" aria-hidden="true"></i>
                    <p>{{t "This site is fully open source. Theme, content structure, and build approach are all public on"}}
                        <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener noreferrer">GitHub</a>.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


{{!-- ═══════════════════════════════════════════════════════════
     8. BLOG + SIDEBAR
══════════════════════════════════════════════════════════════ --}}
<section class="home-section home-blog outer" aria-label="{{t "Latest from the blog"}}">
    <div class="inner">
        <div class="home-blog__layout">

            {{!-- Main: blog posts --}}
            <div class="home-blog__main">
                <div class="home-section__header-inline reveal">
                    <div>
                        <p class="home-section__overline">{{t "Fresh content"}}</p>
                        <h2 class="home-section__title">{{t "Latest from the blog"}}</h2>
                        <p class="home-section__subtitle">{{t "Tutorials, breakdowns, and explainers."}}</p>
                    </div>
                    <a href="/blog/" class="btn btn-neutral">{{t "Visit Blog"}}</a>
                </div>

                {{#get "posts" filter="tag:hash-blog" limit="3" include="tags,authors"}}
                    {{#if posts}}
                        <div class="home-blog__grid">
                            {{#foreach posts}}
                                 {{> "post-card"}}
                            {{/foreach}}
                        </div>
                    {{else}}
                        <div class="home-empty-state">
                            <i class="ph ph-pencil-line" aria-hidden="true"></i>
                            <p>{{t "No blog posts yet — tag posts with"}} <code>#blog</code> {{t "to show them here."}}</p>
                        </div>
                    {{/if}}
                {{/get}}

                <div class="home-blog__view-all-mobile">
                    <a href="/blog/" class="btn btn-neutral btn-block">{{t "Visit Blog"}}</a>
                </div>
            </div>

            {{!-- Sidebar --}}
