{{!< default}}

{{!-- THE HOMEPAGE. Mounted as a static route (routes.yaml) with
`data: page.home`, so {{#page}} is the Ghost page with slug
"home": its title/excerpt feed the hero, its meta feeds SEO, and
its code injection — which Ghost skips for route data sources —
is re-emitted into the head/foot blocks here.

Every number and card below is queried live; nothing on this
page goes stale when content changes. --}}

{{#page}}
    {{#if codeinjection_head}}{{#contentFor "head"}}{{{codeinjection_head}}}{{/contentFor}}{{/if}}
    {{#if codeinjection_foot}}{{#contentFor "foot"}}{{{codeinjection_foot}}}{{/contentFor}}{{/if}}
{{/page}}

{{!-- THE hero — subscribe-first creator hero with the product
itself (a live-data lesson-player window) as the visual. All of
it in partials/hero.hbs; stats in partials/hero-stats.hbs. --}}
{{> "hero"}}

{{!-- Recent activity — replaces the old "Pick a way in" bento.
Lives in partials/activity-feed.hbs. --}}
{{> "activity-feed"}}

{{!-- The journey. Lives in partials/journey.hbs so the About page
can tell the same story with the same markup. --}}
{{> "journey"}}

{{!-- Training path, live.

Two columns. The left one scrolls: one card per module, discovered
the same way as everywhere else (a module IS a public tag that has
#training posts). The right one STICKS — it is the path itself,
with a progress rail that fills and an active module that changes
as you scroll the left column past each card.

assets/js/pathlive.js drives it from an IntersectionObserver, so
the rail follows the reader rather than the scrollbar: on a short
viewport with tall cards those are not the same thing. --}}
{{#get "tags" filter="visibility:public" order="slug asc" limit="30" as |pathTags|}}
    <section class="section outer pathlive" data-pathlive>
        <div class="inner">
            <div class="section-head" data-animate>
                <div>
                    <span class="kicker">{{> "icons/layers"}} {{t "Training path"}}</span>
                    <h2>{{t "Follow the path, live"}}</h2>
                    <p>{{t "Modules in order, with what each one covers. Your place on the path follows you down the page."}}</p>
                </div>
                <a class="section-more" href="{{@site.url}}/training/">{{t "Open training"}} {{> "icons/arrow-right"}}</a>
            </div>

            <div class="pathlive-grid">
                <div class="pathlive-main">
                    {{#foreach pathTags}}
                        {{#> "with-this" mTag=. }}
                            {{#get "posts" filter="tag:{{mTag.slug}}+tag:hash-training" order="published_at asc" limit="100" as |mPosts|}}
                                {{#if mPosts.[0]}}
                                    <article class="pl-card" data-pl-card data-pl-slug="{{../mTag.slug}}">
                                        <span class="pl-card-icon" aria-hidden="true">{{> "icons/layers"}}</span>
                                        <div class="pl-card-body">
                                            <span class="pl-card-kicker">{{t "Module"}} · {{mPosts.length}} {{t "sections"}}</span>
                                            <h3><a href="{{@site.url}}/training/{{../mTag.slug}}/">{{../mTag.name}}</a></h3>
                                            {{#if ../mTag.description}}
                                                <p>{{../mTag.description}}</p>
                                            {{/if}}
                                            <ol class="pl-steps">
                                                {{#foreach mPosts}}
                                                    {{#if @index}}{{else}}{{/if}}
                                                    <li><a href="{{url}}">{{> "lesson-type-icon"}} {{title}}</a></li>
                                                {{/foreach}}
                                            </ol>
                                            <a class="btn btn-sm pl-card-start" href="{{@site.url}}/training/{{../mTag.slug}}/">
                                                {{> "icons/play-circle"}} {{t "Start module"}}
                                            </a>
                                        </div>
                                    </article>
                                {{/if}}
                            {{/get}}
                        {{/with-this}}
                    {{/foreach}}
                </div>

                {{!-- The rail. Sticky, one column, and the only thing on
                the page that reports where you are on the path. --}}
                <aside class="pathlive-rail" aria-hidden="true">
                    <div class="pl-rail-head">
                        <span class="pl-live"><i></i> {{t "Live"}}</span>
                        <strong>{{t "Your place on the path"}}</strong>
                    </div>

                    <div class="pl-progress">
                        <div class="pl-progress-bar"><i data-pl-fill></i></div>
                        <span class="pl-progress-num"><b data-pl-pct>0</b>%</span>
                    </div>

                    <ol class="pl-list" data-pl-list>
                        {{#foreach pathTags}}
                            {{#> "with-this" mTag=. }}
                                {{#get "posts" filter="tag:{{mTag.slug}}+tag:hash-training" order="published_at asc" limit="1" as |mp counts|}}
                                    {{#if mp.[0]}}
                                        <li class="pl-item" data-pl-item="{{../mTag.slug}}">
                                            <span class="pl-item-dot" aria-hidden="true">{{> "icons/layers"}}</span>
                                            <span class="pl-item-body">
                                                <span class="pl-item-name">{{../mTag.name}}</span>
                                                <span class="pl-item-meta">{{counts.total}} {{t "sections"}}</span>
                                            </span>
                                        </li>
                                    {{/if}}
                                {{/get}}
                            {{/with-this}}
                        {{/foreach}}
                    </ol>
                </aside>
            </div>
        </div>
    </section>
{{/get}}

{{!-- Courses --}}
{{#get "posts" filter="tag:hash-course" include="tags,authors" order="published_at asc" limit="3" as |courses|}}
    {{#if courses}}
        <section class="section outer">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/graduation-cap"}} {{t "Courses"}}</span>
                        <h2>{{t "Pick a path, ship a thing"}}</h2>
                        <p>{{t "Every course ends with something real running in your own Developer Edition org."}}</p>
                    </div>
                    <a class="section-more" href="{{@site.url}}/courses/">{{t "All courses"}} {{> "icons/arrow-right"}}</a>
                </div>
                <div class="card-grid" data-animate-stagger>
                    {{#foreach courses}}
                        {{> "card-course"}}
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Topics — every public tag, as a card grid: icon, name, its
own description (when the tag has one) and the post count. A
static grid, not a scrolling marquee — a horizontal auto-scroll
strip hijacked the page's own vertical scroll wheel the moment the
cursor crossed it, which read as the whole page getting stuck. --}}
{{#get "tags" filter="visibility:public" include="count.posts" order="count.posts desc" limit="8" as |topics|}}
    {{#if topics}}
        <section class="section outer home-topics">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/tag-icon"}} {{t "Topics"}}</span>
                        <h2>{{t "Find your corner of the platform"}}</h2>
                    </div>
                </div>
                <div class="topic-grid" data-animate-stagger>
                    {{#foreach topics}}
                        <a class="topic-card" href="{{url}}">
                            <span class="topic-card-icon" aria-hidden="true">
                                {{#if feature_image}}<img class="card-tag-icon" src="{{img_url feature_image size="xs"}}" alt="" loading="lazy" />{{else}}{{> "icons/tag-icon"}}{{/if}}
                            </span>
                            <span class="topic-card-body">
                                <strong class="topic-card-name">{{name}}</strong>
                                <span class="topic-card-desc">{{#if description}}{{description}}{{else}}{{count.posts}} {{t "posts"}}{{/if}}</span>
                            </span>
                        </a>
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Videos — the top-10 reel. Netflix grammar: giant ranked
numbers behind the thumbs — a horizontal strip a reader could
drag, which on a trackpad also meant a plain vertical scroll over
it could get read as a horizontal gesture. A plain grid has no
such ambiguity. Newest four videos, closing on a subscribe tile. --}}
{{#get "posts" filter="tag:hash-video" include="tags" order="published_at desc" limit="4" as |vids|}}
    {{#if vids}}
        <section class="section outer">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/video"}} {{t "Videos"}}</span>
                        <h2>{{t "Watch the videos"}}</h2>
                        <p>{{t "Standalone walkthroughs — screen and narration, mistakes left in."}}</p>
                    </div>
                    <div class="section-head-cta">
                        {{#if @custom.social_youtube}}
                            <a class="btn btn-youtube" href="{{@custom.social_youtube}}?sub_confirmation=1" target="_blank" rel="noopener">{{> "icons/youtube"}} {{t "Subscribe"}}</a>
                        {{/if}}
                        <a class="section-more" href="{{@site.url}}/videos/">{{t "All videos"}} {{> "icons/arrow-right"}}</a>
                    </div>
                </div>
                <div class="card-grid" data-animate-stagger>
                    {{#foreach vids}}
                        {{> "card-video"}}
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- The lab — snippets + prompts, framed as the editor they
live in. One clean VS Code window: real file names in the tree
(the latest snippet, the latest prompt, the /llms README), a
lo-fi syntax-coloured buffer, a status bar. Nothing crowded —
the window IS the section. --}}
{{#get "posts" filter="tag:hash-snippet" include="tags" limit="2" as |sn|}}
    {{#if sn}}
        <section class="section outer home-lab">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/code"}} {{t "The lab"}}</span>
                        <h2>{{t "Snippets, prompts, sharp tools"}}</h2>
                        <p>{{t "Small things I reuse every week — copy them straight out of the editor."}}</p>
                    </div>
                    <a class="section-more" href="{{@site.url}}/snippets/">{{t "Open the lab"}} {{> "icons/arrow-right"}}</a>
                </div>

                <div class="vsc" data-animate>
                    <div class="vsc-titlebar" aria-hidden="true">
                        <span class="hero-app-dots"><i></i><i></i><i></i></span>
                        <span class="vsc-title">namaste — lab</span>
                    </div>
                    <div class="vsc-body">
                        <aside class="vsc-tree">
                            <span class="vsc-dir">{{> "icons/code"}} snippets/</span>
                            {{#foreach sn}}
                                <a class="vsc-file{{#if @first}} is-active{{/if}}" href="{{url}}">{{slug}}.apex</a>
                            {{/foreach}}
                            {{#get "posts" filter="tag:hash-prompt" limit="2" as |pr|}}
                                {{#if pr}}
                                    <span class="vsc-dir">{{> "icons/sparkles"}} prompts/</span>
                                    {{#foreach pr}}
                                        <a class="vsc-file" href="{{url}}">{{slug}}.md</a>
                                    {{/foreach}}
                                {{/if}}
                            {{/get}}
                            <span class="vsc-dir">{{> "icons/file-text"}} docs/</span>
                            <a class="vsc-file" href="{{@site.url}}/llms/">README.md</a>
                        </aside>

                        <div class="vsc-editor" aria-hidden="true">
                            <span class="vsc-ln"><i>1</i><b class="vt-k" style="width: 16%;"></b><b style="width: 22%;"></b><b class="vt-f" style="width: 14%;"></b></span>
                            <span class="vsc-ln"><i>2</i><b class="vt-in" style="width: 8%;"></b><b class="vt-s" style="width: 30%;"></b></span>
                            <span class="vsc-ln"><i>3</i><b class="vt-in" style="width: 8%;"></b><b class="vt-k" style="width: 10%;"></b><b style="width: 24%;"></b></span>
                            <span class="vsc-ln"><i>4</i><b class="vt-in" style="width: 14%;"></b><b class="vt-f" style="width: 18%;"></b><b class="vt-s" style="width: 12%;"></b></span>
                            <span class="vsc-ln"><i>5</i></span>
                            <span class="vsc-ln"><i>6</i><b class="vt-c" style="width: 42%;"></b></span>
                            <span class="vsc-ln"><i>7</i><b class="vt-k" style="width: 12%;"></b><b class="vt-f" style="width: 20%;"></b><b style="width: 10%;"></b></span>
                            <span class="vsc-ln"><i>8</i><b class="vt-in" style="width: 8%;"></b><b style="width: 16%;"></b><b class="vt-s" style="width: 26%;"></b><span class="vsc-caret"></span></span>
                        </div>
                    </div>
                    <div class="vsc-status" aria-hidden="true">
                        <span>{{> "icons/github"}} main</span>
                        <span>{{t "Apex"}}</span>
                        <span>UTF-8</span>
                    </div>
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Projects — open source, GitHub grammar. Latest four repos
as cards; the strip drops out while no post carries #project. --}}
{{#get "posts" filter="tag:hash-project" include="tags" order="featured desc, published_at desc" limit="4" as |repos|}}
    {{#if repos}}
        <section class="section outer">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/github"}} {{t "Projects"}}</span>
                        <h2>{{t "Built in the open"}}</h2>
                        <p>{{t "Frameworks and tools from real projects — fork them, break them, ship them."}}</p>
                    </div>
                    <a class="section-more" href="{{@site.url}}/projects/">{{t "All projects"}} {{> "icons/arrow-right"}}</a>
                </div>
                <div class="proj-grid" data-animate-stagger>
                    {{#foreach repos}}
                        {{> "card-project"}}
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Latest writing --}}
{{#get "posts" filter="tag:hash-blog" include="tags,authors" limit="3" as |articles|}}
    {{#if articles}}
        <section class="section section-alt outer">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/pen"}} {{t "Blog"}}</span>
                        <h2>{{t "Latest from the blog"}}</h2>
                    </div>
                    <a class="section-more" href="{{@site.url}}/blog/">{{t "All articles"}} {{> "icons/arrow-right"}}</a>
                </div>
                <div class="card-grid" data-animate-stagger>
                    {{#foreach articles}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Stay current — the changelog timeline beside the latest
newsletter issue. Both live queries; either half quietly drops
out when its collection is empty. --}}
{{#get "posts" filter="tag:hash-changelog" include="tags" limit="3" as |updates|}}
    {{#if updates}}
        <section class="section outer">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/history"}} {{t "Stay current"}}</span>
                        <h2>{{t "The platform moves. Keep up."}}</h2>
                    </div>
                    <a class="section-more" href="{{@site.url}}/changelog/">{{t "Full changelog"}} {{> "icons/arrow-right"}}</a>
                </div>
                <div class="home-current" data-animate-stagger>

                    <div class="home-changelog">
                        <h3>{{> "icons/history"}} {{t "Recently on the changelog"}}</h3>
                        <ol>
                            {{#foreach updates}}
                                <li>
                                    <div class="home-changelog-meta">
                                        <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="D MMM YYYY"}}</time>
                                        {{> "changelog-badge"}}
                                    </div>
                                    <a href="{{url}}">{{title}}</a>
                                    {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
                                </li>
                            {{/foreach}}
                        </ol>
                    </div>

                    <div class="home-news">
                        <h3>{{> "icons/mail"}} {{t "The newsletter"}}</h3>
                        <p>{{t "Release notes that matter, new lessons and honest takes — straight to your inbox, at a humane pace."}}</p>
                        {{#get "posts" filter="tag:hash-newsletter" limit="1" as |issue|}}
                            {{#if issue}}
                                <a class="home-news-issue bob" href="{{issue.[0].url}}">
                                    <strong>{{t "Latest issue"}}</strong>
                                    <span>{{issue.[0].title}}</span>
                                </a>
                            {{/if}}
                        {{/get}}
                        {{#if @site.members_enabled}}
                            <a class="btn" href="{{@site.url}}/signup/">{{> "icons/mail"}} {{t "Subscribe free"}}</a>
                        {{else}}
                            <a class="btn" href="{{@site.url}}/newsletter/">{{t "Browse issues"}} {{> "icons/arrow-right"}}</a>
                        {{/if}}
                    </div>

                </div>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Products I use — a teaser band for /products-i-use/, fed
by that page's own title/excerpt so it never drifts. Drops out
if the page doesn't exist yet. --}}
{{#get "pages" filter="slug:products-i-use" limit="1" as |stackpage|}}
    {{#if stackpage}}
        <section class="section outer">
            <div class="inner">
                <a class="home-stack-band" href="{{stackpage.[0].url}}" data-animate>
                    <span class="home-stack-icon" aria-hidden="true">{{> "icons/zap"}}</span>
                    <span class="home-stack-copy">
                        <span class="kicker">{{t "The stack"}}</span>
                        <strong>{{stackpage.[0].title}}</strong>
                        <span>{{#if stackpage.[0].custom_excerpt}}{{stackpage.[0].custom_excerpt}}{{else}}{{t "Every product, tool and service I actually use to build, teach and ship."}}{{/if}}</span>
                    </span>
                    <span class="home-stack-chips" aria-hidden="true">
                        <span class="chip">{{> "icons/cloud"}} {{t "Salesforce tooling"}}</span>
                        <span class="chip">{{> "icons/code"}} {{t "Dev setup"}}</span>
                        <span class="chip">{{> "icons/video"}} {{t "Studio gear"}}</span>
                        <span class="chip">{{> "icons/sparkles"}} {{t "AI stack"}}</span>
                    </span>
                    {{> "icons/arrow-right"}}
                </a>
            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- About the author + the signup moment. Left: who makes this
and why — live author data, mission, goals. Right: the Weekly
Namaste signup card with Ghost's native members form (the form
element gets loading/success/error classes from Ghost itself). --}}
{{#get "authors" limit="1" as |host|}}
    {{#if host}}
        <section class="section section-alt outer home-about">
            <div class="bg-dots" aria-hidden="true"></div>
            <div class="inner home-about-grid relative">

                {{#foreach host}}
                    <div class="home-about-copy" data-animate="left">
                        <span class="kicker">{{> "icons/compass"}} {{t "The mission"}}</span>
                        <h2>{{t "Why this site exists"}}</h2>

                        <div class="home-about-host">
                            {{#if profile_image}}
                                <img class="home-about-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" loading="lazy" />
                            {{else}}
                                <span class="home-about-avatar avatar-fallback">{{> "icons/avatar"}}</span>
                            {{/if}}
                            <div>
                                <strong>{{name}}</strong>
                                <span>{{t "Builds and writes everything here"}}</span>
                            </div>
                        </div>

                        {{#if bio}}
                            <p class="home-about-bio">{{bio}}</p>
                        {{else}}
                            <p class="home-about-bio">{{t "Salesforce is learned by building, not by watching slides. Every course, module and video on this site was made inside a real org — clicks, code and mistakes included."}}</p>
                        {{/if}}

                        <ul class="hero-facts">
                            <li>{{> "icons/shield"}} {{t "7+ years in IT"}}</li>
                            <li>{{> "icons/zap"}} {{t "Build → then share"}}</li>
                            <li>{{> "icons/sparkles"}} {{t "Learning in public"}}</li>
                            <li>{{> "icons/rocket"}} {{t "Next: GTM Engineer, powered by the AI era"}}</li>
                        </ul>

                        <ul class="home-about-goals">
                            <li>{{> "icons/check-circle"}} {{t "Keep every course free, forever"}}</li>
                            <li>{{> "icons/check-circle"}} {{t "Teach the way real projects actually work"}}</li>
                            <li>{{> "icons/check-circle"}} {{t "Answer honestly — even when the answer is 'don't'"}}</li>
                        </ul>

                        <div class="home-about-links">
                            <a class="home-journey-link" href="{{url}}">{{t "More about me"}} {{> "icons/arrow-right"}}</a>
                            <a class="home-journey-link" href="{{@site.url}}/guestbook/">{{t "Say hi in the guestbook"}} {{> "icons/arrow-right"}}</a>
                        </div>
                    </div>
                {{/foreach}}

                <div class="home-signup" data-animate="right">
                    <span class="home-signup-badge">{{> "icons/gift"}} {{t "100% free"}}</span>
                    <h3>{{t "Get the Weekly Namaste"}}</h3>
                    <p>{{t "The one email that keeps you current on Salesforce — and it takes five seconds to join."}}</p>

                    <ul class="home-signup-why">
                        <li>{{> "icons/zap"}} {{t "Release notes decoded — only what actually affects you"}}</li>
                        <li>{{> "icons/graduation-cap"}} {{t "New lessons and videos before they hit the homepage"}}</li>
                        <li>{{> "icons/lock"}} {{t "Zero spam, zero selling your email, one-click unsubscribe"}}</li>
                    </ul>

                    {{#if @site.members_enabled}}
                        {{#unless @member}}
                            <form class="signup-form" data-members-form="signup">
                                <div class="signup-row">
                                    <input class="signup-input" data-members-email type="email" required
                                        placeholder="{{t "you@work-email.com"}}" aria-label="{{t "Your email"}}" />
                                    <button class="btn signup-btn" type="submit">
                                        {{> "icons/mail"}} {{t "Join free"}}
                                    </button>
                                </div>
                                <p class="signup-note">{{t "Join fellow admins and devs reading along — if it's not for you, one click ends it."}}</p>
                                <p class="signup-success">{{> "icons/check-circle"}} {{t "Almost in! Check your inbox and click the magic link."}}</p>
                                <p class="signup-error" data-members-error></p>
                            </form>
                        {{else}}
                            <p class="members-note">{{> "icons/check-circle"}} {{t "You're on the list — the next issue is coming to you."}}</p>
                        {{/unless}}
                    {{else}}
                        <a class="btn" href="{{@site.url}}/newsletter/">{{> "icons/mail"}} {{t "Browse the issues"}}</a>
                    {{/if}}
                </div>

            </div>
        </section>
    {{/if}}
{{/get}}

{{!-- Closing CTA — subscribe when members are on, otherwise
straight into the courses. Never a dead end. --}}
<section class="section outer">
    <div class="inner">
        <div class="home-cta is-split" data-animate="zoom">
            {{!-- The journey video, looping muted underneath a
            navy gradient — pure backdrop, never interactive. --}}
            <div class="home-cta-video" aria-hidden="true">
                <iframe src="https://www.youtube-nocookie.com/embed/RZMj7C41AuQ?autoplay=1&amp;mute=1&amp;loop=1&amp;playlist=RZMj7C41AuQ&amp;controls=0&amp;rel=0&amp;playsinline=1&amp;modestbranding=1&amp;iv_load_policy=3&amp;disablekb=1"
                    title="" loading="lazy" tabindex="-1"
                    allow="autoplay; encrypted-media"
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
            <div class="home-cta-shade" aria-hidden="true"></div>
            <div class="orb" style="width: 300px; height: 300px; top: -100px; right: 10%; animation-delay: -2s;" aria-hidden="true"></div>
            <div class="home-cta-copy">
                <h2>{{#if @custom.newsletter_heading}}{{@custom.newsletter_heading}}{{else}}{{t "Start your Salesforce journey today"}}{{/if}}</h2>
                <p>{{#if @custom.newsletter_text}}{{@custom.newsletter_text}}{{else}}{{t "Free courses, weekly notes, zero spam."}}{{/if}}</p>
            </div>

            {{!-- The ask sits BESIDE the copy on a wide screen and
            under it on a phone, which is what keeps the band short:
            it was a stacked heading + paragraph + button before. --}}
            <div class="home-cta-ask">
                {{#if @site.members_enabled}}
                    {{#unless @member}}
                        <form class="signup-form cta-signup" data-members-form="signup">
                            <div class="signup-row">
                                <input class="signup-input" data-members-email type="email" required
                                    placeholder="{{t "you@work-email.com"}}" aria-label="{{t "Your email"}}" />
                                <button class="btn signup-btn" type="submit">
                                    {{> "icons/mail"}} {{t "Subscribe free"}}
                                </button>
                            </div>
                            <p class="signup-note">{{t "Free forever · one email a week · unsubscribe in one click"}}</p>
                            <p class="signup-success">{{> "icons/check-circle"}} {{t "Almost in! Check your inbox and click the magic link."}}</p>
                            <p class="signup-error" data-members-error></p>
                        </form>
                    {{else}}
                        <a class="btn btn-lg btn-inverse" href="{{@site.url}}/courses/">{{t "Continue learning"}} {{> "icons/arrow-right"}}</a>
                    {{/unless}}
                {{else}}
                    <a class="btn btn-lg btn-inverse" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Start learning free"}}</a>
                {{/if}}
            </div>
        </div>
    </div>
</section>
