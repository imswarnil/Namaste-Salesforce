{{!< default}}

{{! ══════════════════════════════════════════════════════════════
    HERO — YouTube video background, Bulma-only
══════════════════════════════════════════════════════════════ }}
<section class="hero ">

  {{! ── Background layers (Bulma’s hero-video + overlay) ── }}
 

  {{! Mobile fallback: site cover image }}
  <div class="hero-background is-hidden-desktop" aria-hidden="true">
    {{#if @site.cover_image}}
      <div class="has-background-image" style="background-image:url('{{@site.cover_image}}'); background-size:cover; background-position:center;"></div>
    {{else}}
      <div class="has-background-dark"></div>
    {{/if}}
  </div>

  {{! Overlay }}
  <div class="overlay has-background-dark" style="opacity: 0.6;"></div>

  {{! ── Hero content ── }}
  <div class="hero-body">
    <div class="container" style="max-width:1200px;">
      <div class="columns is-vcentered is-variable is-8">

        {{! ── Left column: copy ── }}
        <div class="column is-12-mobile is-12-tablet is-7-desktop">

          <div class="tags mb-4">
            <span class="tag is-info is-rounded is-medium">
              <span class="icon is-small"><i class="ph ph-lightning-fill"></i></span>
              <span>Hands-on Salesforce LMS Platform</span>
            </span>
          </div>

          <h1 class="title is-1 is-size-2-mobile has-text-white mb-4">
            Become a<br>
            <span class="has-text-info">Salesforce</span><br>
            Application Engineer.
          </h1>

          <p class="subtitle is-5 has-text-grey-light mb-5" style="max-width:540px; line-height:1.7;">
            {{#if @site.description}}
              {{@site.description}}
            {{else}}
              Go beyond the basics. Master Apex, LWC, SOQL, and integrations through a real-world, project-based curriculum designed for engineers, not exam-passers.
            {{/if}}
          </p>

          <div class="buttons are-medium mb-6">
            <a href="/courses/" class="button is-info">
              <span class="icon is-small"><i class="ph ph-book-open"></i></span>
              <strong>Explore Curriculum</strong>
            </a>
            {{#if @site.members_enabled}}
              <a href="#/portal/signup" data-portal="signup" class="button is-light">
                <span class="icon is-small"><i class="ph ph-sparkle"></i></span>
                <span>Start for Free</span>
              </a>
            {{/if}}
          </div>

          <div>
            <p class="heading has-text-grey mb-3" style="letter-spacing:.08em;">
              Engineers hired at
            </p>
            <div class="is-flex is-flex-wrap-wrap has-text-weight-semibold" style="gap:0.75rem;">
              <span>Salesforce</span>
              <span aria-hidden="true">•</span>
              <span>Deloitte</span>
              <span aria-hidden="true">•</span>
              <span>Accenture</span>
              <span aria-hidden="true">•</span>
              <span>IBM</span>
            </div>
          </div>
        </div>

        {{! ── Right column: featured path card ── }}
        <div class="column is-12-mobile is-8-tablet is-5-desktop">
          <div class="card has-background-dark has-text-white">
            <div class="card-content">
              <div class="is-flex is-align-items-center is-justify-content-space-between mb-3">
                <span class="icon is-large has-text-info">
                  <i class="ph ph-code ph-2x"></i>
                </span>
                <span class="tag is-warning is-light is-rounded">Featured Path</span>
              </div>

              <h3 class="title is-4 has-text-white mb-2">Salesforce Developer Path</h3>
              <p class="has-text-grey-light is-size-6 mb-4">
                Apex fundamentals, Lightning Web Components, SOQL, and REST integrations — all project-based.
              </p>

              <div class="mb-4">
                <div class="is-flex is-justify-content-space-between mb-2">
                  <span class="heading has-text-grey mb-0">Curriculum Style</span>
                  <span class="heading has-text-info mb-0">100% Practical</span>
                </div>
                <progress class="progress is-info is-small mb-0" value="100" max="100">100%</progress>
              </div>

              <ul class="has-text-grey-light mb-5" style="list-style:none; padding-left:0;">
                <li class="mb-2">
                  <span class="icon has-text-info"><i class="ph ph-check-circle-fill"></i></span>
                  Zero-to-Advanced progression
                </li>
                <li class="mb-2">
                  <span class="icon has-text-info"><i class="ph ph-check-circle-fill"></i></span>
                  Build 5 real-world projects
                </li>
                <li class="mb-2">
                  <span class="icon has-text-info"><i class="ph ph-check-circle-fill"></i></span>
                  Platform Developer I &amp; II aligned
                </li>
                <li>
                  <span class="icon has-text-info"><i class="ph ph-check-circle-fill"></i></span>
                  DevOps, SFDX &amp; Git from Day 1
                </li>
              </ul>

              <a href="/courses/" class="button is-info is-outlined is-fullwidth">
                <span class="icon"><i class="ph ph-arrow-right"></i></span>
                <strong>View Curriculum Path</strong>
              </a>
            </div>
          </div>
        </div>

      </div>{{! /columns }}

      {{! ── Stats bar ── }}
      <div class="is-flex is-flex-wrap-wrap is-justify-content-space-between is-align-items-center mt-6 pt-2" style="gap:1rem;">
        <div class="has-text-centered">
          <span class="title is-3 has-text-white">3+</span><br>
          <span class="heading has-text-grey-light">Learning Tracks</span>
        </div>
        <div class="is-hidden-mobile">|</div>
        <div class="has-text-centered">
          <span class="title is-3 has-text-white">20+</span><br>
          <span class="heading has-text-grey-light">In-depth Courses</span>
        </div>
        <div class="is-hidden-mobile">|</div>
        <div class="has-text-centered">
          <span class="title is-3 has-text-white">100+</span><br>
          <span class="heading has-text-grey-light">Guides &amp; Docs</span>
        </div>
        <div class="is-hidden-mobile">|</div>
        <div class="has-text-centered">
          <span class="title is-3 has-text-white">1k+</span><br>
          <span class="heading has-text-grey-light">Community Members</span>
        </div>
      </div>

    </div>{{! /container }}
  </div>{{! /hero-body }}
</section>