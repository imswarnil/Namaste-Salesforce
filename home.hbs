        <div class="js-reveal relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card">
          <i class="ph-fill ph-newspaper pointer-events-none absolute -right-3 -top-3 text-7xl text-brand-500/[0.07]" aria-hidden="true"></i>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-newspaper" aria-hidden="true"></i></span>
          <div class="mt-3 bg-gradient-to-br from-brand-500 to-brand-800 bg-clip-text font-heading text-5xl font-extrabold tracking-tight text-transparent dark:from-brand-300 dark:to-brand-500"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Blog posts"}}</div>
        </div>
      {{/get}}
    </div>
  </div>
  </div>
</section>

{{!-- ── OPEN SOURCE (grid-line background) ───────────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0"
         style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 40px 40px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 60% 80% at 50% 50%, #000 20%, transparent 75%); mask-image: radial-gradient(ellipse 60% 80% at 50% 50%, #000 20%, transparent 75%);"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-600 dark:text-brand-300"><i class="ph ph-git-branch" aria-hidden="true"></i>{{t "Open source"}}</p>
      <h2 class="mt-2 font-heading text-2xl font-extrabold sm:text-3xl">{{t "Built in the open, on Ghost"}}</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">{{t "The whole platform — a custom Ghost theme, the courses, the docs — is an open-source project. Read the code, fix a typo, write a lesson or improve the help center: every contribution ships."}}</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-5 py-2.5 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">{{> "icons/github" class="h-4 w-4"}}{{t "Star on GitHub"}}</a>
        <a href="/docs/" class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-5 py-2.5 text-sm font-semibold transition hover:border-brand-500 hover:text-brand-600"><i class="ph ph-book-open-text" aria-hidden="true"></i>{{t "Docs & help center"}}</a>
        <a href="/become-author/" class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-5 py-2.5 text-sm font-semibold transition hover:border-brand-500 hover:text-brand-600">{{> "icons/user-plus" class="h-4 w-4"}}{{t "Contribute content"}}</a>
        <a href="/sponsor/" class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-pink-600 transition hover:border-pink-500"><i class="ph-fill ph-heart" aria-hidden="true"></i>{{t "Sponsor"}}</a>
      </div>
      <p class="mt-6 text-sm text-muted">{{t "Powered by"}} <a href="https://ghost.org" target="_blank" rel="noopener" class="font-semibold hover:text-brand-600">Ghost</a> · {{t "Styled with"}} <a href="https://tailwindcss.com" target="_blank" rel="noopener" class="font-semibold hover:text-brand-600">Tailwind CSS</a> · {{t "MIT-licensed theme"}}</p>
    </div>
  </div>
</section>

{{!-- ── NEWSLETTER: why join + how membership works (big grid canvas) ─────── --}}
<section class="relative overflow-hidden border-t border-border bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0"
       style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 52px 52px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, #000 25%, transparent 80%); mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, #000 25%, transparent 80%);"></div>

  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-600 dark:text-brand-300"><i class="ph-fill ph-envelope-simple" aria-hidden="true"></i>{{t "The newsletter"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{t "One email a week. Zero noise."}}</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">{{t "New lessons, a Salesforce tip you'll actually use, and what's shipping next on the platform — written by the people who build the courses."}}</p>
    </div>

    {{!-- why join --}}
    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      <div class="rounded-card border border-border bg-surface-raised p-6 text-center shadow-card">
        <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/10 text-xl text-brand-600 dark:text-brand-300"><i class="ph-fill ph-bell-ringing" aria-hidden="true"></i></span>
        <h3 class="mt-3 font-heading font-bold">{{t "Never miss a lesson"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "New courses, modules and docs land in your inbox the week they publish."}}</p>
      </div>
      <div class="rounded-card border border-border bg-surface-raised p-6 text-center shadow-card">
        <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/10 text-xl text-brand-600 dark:text-brand-300"><i class="ph-fill ph-lock-simple-open" aria-hidden="true"></i></span>
        <h3 class="mt-3 font-heading font-bold">{{t "Unlocks member lessons"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Your free account doubles as the key to all members-only lessons and docs."}}</p>
      </div>
      <div class="rounded-card border border-border bg-surface-raised p-6 text-center shadow-card">
        <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/10 text-xl text-brand-600 dark:text-brand-300"><i class="ph-fill ph-chart-line-up" aria-hidden="true"></i></span>
        <h3 class="mt-3 font-heading font-bold">{{t "Career signal, not spam"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Cert changes, release highlights and hiring trends — condensed to two minutes."}}</p>
      </div>
    </div>

    {{!-- how it works (Ghost membership flow) --}}
    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <div class="relative text-center">
        <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 font-heading font-extrabold text-white">1</span>
        <h4 class="mt-3 font-heading font-bold">{{t "Subscribe"}}</h4>
        <p class="mx-auto mt-1 max-w-xs text-sm text-muted">{{t "Drop your email below — no password, no credit card."}}</p>
        <i class="ph ph-arrow-right absolute -right-5 top-4 hidden text-xl text-muted md:block" aria-hidden="true"></i>
      </div>
      <div class="relative text-center">
        <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 font-heading font-extrabold text-white">2</span>
        <h4 class="mt-3 font-heading font-bold">{{t "Click the magic link"}}</h4>
        <p class="mx-auto mt-1 max-w-xs text-sm text-muted">{{t "Ghost emails you a sign-in link — clicking it confirms you and creates your free account."}}</p>
        <i class="ph ph-arrow-right absolute -right-5 top-4 hidden text-xl text-muted md:block" aria-hidden="true"></i>
      </div>
      <div class="text-center">
        <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 font-heading font-extrabold text-white">3</span>
        <h4 class="mt-3 font-heading font-bold">{{t "Learn as a member"}}</h4>
        <p class="mx-auto mt-1 max-w-xs text-sm text-muted">{{t "You're signed in on this device — member lessons unlock and the weekly email starts."}}</p>
      </div>
    </div>

    {{!-- signup --}}
    <form data-members-form="signup" class="mx-auto mt-12 max-w-md">
      <div class="flex overflow-hidden rounded-pill border border-border bg-surface-raised shadow-card focus-within:border-brand-500">
        <input data-members-email type="email" required placeholder="{{t "you@example.com"}}" aria-label="{{t "Email address"}}"
               class="w-full min-w-0 border-0 bg-transparent px-5 py-3.5 text-ink placeholder:text-muted focus:outline-none">
        <button type="submit" class="shrink-0 bg-brand-500 px-6 font-bold text-white transition hover:bg-brand-600">
          <span data-members-loading class="hidden"><i class="ph ph-circle-notch animate-spin" aria-hidden="true"></i></span>
          <span data-members-default>{{t "Join free"}}</span>
        </button>
      </div>
      <p data-members-success class="mt-3 hidden text-center text-sm font-semibold text-success">{{t "Check your inbox — your magic link is on its way!"}}</p>
      <p data-members-error class="mt-3 hidden text-center text-sm font-semibold text-error">{{t "Something went wrong — try again."}}</p>
      <p class="mt-3 text-center text-xs text-muted">{{t "Unsubscribe anytime with one click. We never share your email."}}</p>
    </form>
  </div>
</section>
