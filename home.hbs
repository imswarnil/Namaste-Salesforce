{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  home.hbs — the front page, on NS-Design-System's homepage.html.

  WHY THIS FILE EXISTS: routes.yaml maps `/` to it, and Ghost returns a 400
  "Missing template home.hbs" if it is absent. index.hbs does NOT cover it —
  `/` is a routed template, not the collection index. See decisions/0003.

  ── The page, in order, and the order is the argument ─────────────────────
    1. Hero      who this is for, and the one action
    2. Paths     the COURSES, as destinations
    3. Tracks    the TRAINING sections, as an ordered sequence
    4. Latest    the writing

  Paths and tracks are the same data in two shapes on purpose — see the two
  card partials for why.

  ── The copy comes from Ghost ────────────────────────────────────────────
  A page with the slug `home` supplies the headline and lede when one exists;
  otherwise the site title and description do. That fork is what lets the
  front page be edited in Admin rather than here, and it is why this file
  hard-codes no marketing words.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- --band--dark + --band--grid is NSDS's hero ground: the navy console
     surface with the hairline grid over it. --}}
<section class="ns-band ns-band--dark ns-band--grid ns-hero">
  <div class="ns-band__inner">
    {{#page}}
      <p class="ns-kicker ns-kicker--light">{{@site.title}}</p>
      <h1 class="ns-hero__title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="ns-hero__lede">{{custom_excerpt}}</p>
      {{else if @site.description}}<p class="ns-hero__lede">{{@site.description}}</p>{{/if}}
    {{else}}
      <p class="ns-kicker ns-kicker--light">{{t "Learn Salesforce"}}</p>
      <h1 class="ns-hero__title">{{@site.title}}</h1>
      {{#if @site.description}}<p class="ns-hero__lede">{{@site.description}}</p>{{/if}}
    {{/page}}

    <div class="ns-hero__actions">
      <a class="ns-btn ns-btn--white ns-btn--lg" href="{{@site.url}}/training/">
        <i class="ph ph-graduation-cap" aria-hidden="true"></i> {{t "Start training"}}
      </a>
      <a class="ns-btn ns-btn--ghost ns-btn--lg" href="{{@site.url}}/courses/">{{t "Browse courses"}}</a>
    </div>
  </div>
</section>

{{!-- Queries the course OVERVIEW POSTS, not tags. A tag query cannot say
     "tags that have a #course post under them", so courses and training
     sections would come back in one list and both bands would render the
     same thing. --}}
{{#get "posts" filter="tag:hash-course" limit="12" include="tags" order="published_at asc" as |courses|}}
  {{#if courses}}
    <section class="ns-band ns-band--sunken">
      <div class="ns-band__inner">
        <div class="ns-band__head ns-band__head--between">
          <div>
            <p class="ns-kicker">{{t "Courses"}}</p>
            <h2 class="ns-band__title">{{t "Pick a destination"}}</h2>
          </div>
          <div class="ns-band__actions">
            <a class="ns-btn ns-btn--quiet ns-btn--sm" href="{{@site.url}}/courses/">
              {{t "All courses"}} <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
        <div class="ns-path">{{#foreach courses}}{{> "cards/path-card"}}{{/foreach}}</div>
      </div>
    </section>
  {{/if}}
{{/get}}

{{#get "posts" filter="tag:hash-training-module" limit="12" include="tags" order="published_at asc" as |tracks|}}
  {{#if tracks}}
    <section class="ns-band">
      <div class="ns-band__inner">
        <div class="ns-band__head ns-band__head--between">
          <div>
            <p class="ns-kicker">{{t "Training"}}</p>
            <h2 class="ns-band__title">{{t "Or follow the order"}}</h2>
          </div>
          <div class="ns-band__actions">
            <a class="ns-btn ns-btn--quiet ns-btn--sm" href="{{@site.url}}/training/">
              {{t "All sections"}} <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
        <div class="ns-grid">{{#foreach tracks}}{{> "cards/track-card" index=@number}}{{/foreach}}</div>
      </div>
    </section>
  {{/if}}
{{/get}}

{{!-- ⚠ limit="all" IS NOT SUPPORTED by {{#get}} — Ghost returns 15 silently. --}}
{{#get "posts" limit="6" include="authors,tags" as |latest|}}
  <section class="ns-band ns-band--sunken">
    <div class="ns-band__inner">
      <div class="ns-band__head ns-band__head--between">
        <div>
          <p class="ns-kicker">{{t "Writing"}}</p>
          <h2 class="ns-band__title">{{t "Latest"}}</h2>
        </div>
        <div class="ns-band__actions">
          <a class="ns-btn ns-btn--quiet ns-btn--sm" href="{{@site.url}}/blog/">
            {{t "All posts"}} <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      {{#if latest}}
        <div class="ns-blog-grid">{{#foreach latest}}{{> "cards/bcard"}}{{/foreach}}</div>
      {{else}}
        <p class="ns-empty">{{t "No posts yet."}}</p>
      {{/if}}
    </div>
  </section>
{{/get}}
