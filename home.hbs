{{! ══════════════════════════════════════════════════════════════════════════
    FEATURED COURSES
══════════════════════════════════════════════════════════════════════════ }}
<section class="section">
    <div class="container is-fluid">
        <div class="level mb-6 reveal">
            <div class="level-left">
                <div class="level-item">
                    <div>
                        <h2 class="title is-2">Featured Courses</h2>
                        <p class="subtitle is-5">Practical courses built for real outcomes.</p>
                    </div>
                </div>
            </div>
            <div class="level-right is-hidden-mobile">
                <div class="level-item">
                    <a href="/courses/" class="button is-light">
                        <span>View All Courses</span>
                        <span class="icon"><i class="ph ph-arrow-right"></i></span>
                    </a>
                </div>
            </div>
        </div>

        {{#get "posts" filter="tag:hash-course" limit="4" include="tags,authors"}}
            <div class="columns is-multiline is-variable is-5">
                {{#foreach posts}}
                    <div class="column is-12-mobile is-6-tablet is-3-desktop reveal delay-{{@index}}">
                        <article class="card is-fullheight">
                            {{#if feature_image}}
                                <div class="card-image">
                                    <figure class="image is-16by9">
                                        <a href="{{url}}">
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                                        </a>
                                    </figure>
                                </div>
                            {{/if}}
                            <div class="card-content">
                                {{#if primary_tag}}
                                    <div class="mb-3">
                                        <a href="{{primary_tag.url}}" class="tag is-light">{{primary_tag.name}}</a>
                                    </div>
                                {{/if}}
                                <h3 class="title is-5">
                                    <a href="{{url}}">{{title}}</a>
                                </h3>
                                <p class="content">
                                    {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="18"}}{{/if}}
                                </p>
                                <p class="is-size-7 has-text-grey">
                                    {{#if primary_author}}{{primary_author.name}}{{else}}{{@site.title}}{{/if}} &bull; {{reading_time}}
                                </p>
                            </div>
                            <footer class="card-footer">
                                <a href="{{url}}" class="card-footer-item">View Course</a>
                            </footer>
                        </article>
                    </div>
                {{else}}
                    <div class="column is-12">
                        <div class="notification is-light">
                            No courses found yet. Tag posts with <strong>#course</strong> to show them here.
                        </div>
                    </div>
                {{/foreach}}
            </div>
        {{/get}}

        <div class="has-text-centered is-hidden-tablet mt-5">
            <a href="/courses/" class="button is-primary is-fullwidth">View All Courses</a>
        </div>
    </div>
</section>

