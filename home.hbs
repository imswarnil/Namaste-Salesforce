{{!-- Manifesto ink-in on scroll --}}
<script>
  (function () {
    var tick = false;
    var man = document.querySelector('.js-manifesto');
    if (!man) return;
    man.innerHTML = man.textContent.trim().split(/\s+/).map(function (w) { return '<span>' + w + '</span>'; }).join(' ');
    var spans = Array.prototype.slice.call(man.querySelectorAll('span'));
    function update() {
      tick = false;
      var r = man.getBoundingClientRect();
      var p = Math.max(0, Math.min(1, (window.innerHeight * 0.8 - r.top) / (r.height + window.innerHeight * 0.35)));
      var n = Math.round(p * spans.length);
      for (var i = 0; i < spans.length; i++) spans[i].classList.toggle('on', i < n);
    }
    function onScroll() { if (!tick) { tick = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>

