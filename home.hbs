{{!< default}}

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 1 · HERO — lead-capture first
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-hero">
  <div class="ns-hero-mesh" aria-hidden="true">
    <div class="ns-hero-mesh__blob ns-hero-mesh__blob--1"></div>
    <div class="ns-hero-mesh__blob ns-hero-mesh__blob--2"></div>
    <div class="ns-hero-mesh__blob ns-hero-mesh__blob--3"></div>
  </div>

  <div class="container ns-hero__content">

    <span class="ns-eyebrow ns-fade-in ns-stagger-1">
      <i class="ph-fill ph-lightning" aria-hidden="true"></i>
      Free Salesforce Learning · Spring 2026
    </span>

    <h1 class="ns-hero__title ns-fade-up ns-stagger-2">
      Master Salesforce.<br>
      <span class="ns-gradient-text">Land the Role.</span>
    </h1>

    <p class="ns-hero__subtitle ns-fade-up ns-stagger-3">
      Hands-on training, real-world projects, and a community that's been where you're going. From Admin basics to Architect blueprints — all free, forever.
    </p>

    <div class="ns-hero__actions ns-fade-up ns-stagger-4">

      {{!-- PRIMARY: Ghost members email signup --}}
      {{#if @site.members_enabled}}
      <form data-members-form class="ns-hero__signup">
        <div class="field has-addons is-justify-content-center">
          <div class="control is-expanded has-icons-left">
            <input
              data-members-email
              class="input is-large is-rounded"
              type="email"
              placeholder="you@email.com"
              required
              aria-label="Your email address">
            <span class="icon is-left"><i class="ph ph-envelope-simple" aria-hidden="true"></i></span>
          </div>
          <div class="control">
            <button
              class="button is-gradient is-large is-rounded ns-gradient-animated"
              type="submit"
              aria-label="Start learning free">
              Start Learning Free
            </button>
          </div>
        </div>
        <p class="message-success is-hidden has-text-white mt-2">
          <i class="ph-fill ph-check-circle" aria-hidden="true"></i>
          Check your inbox to confirm! 🎉
        </p>
        <p class="message-error is-hidden has-text-warning mt-2">
          <i class="ph-fill ph-warning" aria-hidden="true"></i>
          Please enter a valid email.
        </p>
      </form>
      {{else}}
      <a class="button is-gradient is-large is-rounded ns-gradient-animated"
         href="#/portal/signup"
         data-portal="signup">
        Start Learning Free
      </a>
      {{/if}}

      {{!-- SECONDARY: browse courses --}}
      <a class="button is-large is-rounded is-outlined is-white mt-3-mobile"
         href="/courses/"
         style="margin-left:1rem;">
        <span class="icon"><i class="ph ph-books" aria-hidden="true"></i></span>
        <span>Browse Courses</span>
      </a>

    </div>

    <p class="is-size-7 has-text-white ns-fade-in ns-stagger-5 mt-4" style="opacity:.75;">
      Free forever &nbsp;·&nbsp; No credit card &nbsp;·&nbsp; Join 10,000+ learners
    </p>

  </div>
</section>

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 2 · STATS / SOCIAL PROOF
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-section ns-section--tight">
  <div class="ns-container">
    <div class="columns is-mobile is-multiline is-centered has-text-centered">

      <div class="column is-6-mobile is-3-tablet ns-fade-up ns-stagger-1">
        <div class="ns-stat">
          <span class="ns-stat__number ns-glow-pulse">10K+</span>
          <span class="ns-stat__label">Active Learners</span>
        </div>
      </div>

      <div class="column is-6-mobile is-3-tablet ns-fade-up ns-stagger-2">
        <div class="ns-stat">
          <span class="ns-stat__number">50+</span>
          <span class="ns-stat__label">Courses &amp; Modules</span>
        </div>
      </div>

      <div class="column is-6-mobile is-3-tablet ns-fade-up ns-stagger-3">
        <div class="ns-stat">
          <span class="ns-stat__number">300+</span>
          <span class="ns-stat__label">Video Lessons</span>
        </div>
      </div>

      <div class="column is-6-mobile is-3-tablet ns-fade-up ns-stagger-4">
        <div class="ns-stat">
          <span class="ns-stat__number">4.9 <i class="ph-fill ph-star" style="font-size:.7em" aria-hidden="true"></i></span>
          <span class="ns-stat__label">Average Rating</span>
        </div>
      </div>

    </div>
  </div>
</section>

<div class="ns-divider"></div>

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 3 · LEARNING TRACKS / PATHS
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-section">
  <div class="ns-container">

    <div class="has-text-centered mb-6">
      <span class="ns-eyebrow">
        <i class="ph-fill ph-path" aria-hidden="true"></i>
        Structured Paths
      </span>
      <h2 class="title is-2 mt-3">
        <span class="ns-gradient-text">Pick Your Learning Track</span>
      </h2>
      <p class="ns-lead">
        Role-aligned paths that take you from zero to certified — at your own pace.
      </p>
    </div>

    <div class="ns-grid ns-grid--4">

      <a href="/tag/salesforce-admin/" class="ns-track-card ns-fade-up ns-stagger-1" aria-label="Salesforce Admin track">
        <div class="ns-track-card__icon">
          <i class="ph-fill ph-shield-check" aria-hidden="true"></i>
        </div>
        <div class="ns-track-card__content">
          <div class="ns-track-card__title">Salesforce Admin</div>
          <div class="ns-track-card__meta">12 modules · 8h · Beginner</div>
        </div>
      </a>

      <a href="/tag/salesforce-developer/" class="ns-track-card ns-fade-up ns-stagger-2" aria-label="Salesforce Developer track">
        <div class="ns-track-card__icon">
          <i class="ph-fill ph-code" aria-hidden="true"></i>
        </div>
        <div class="ns-track-card__content">
          <div class="ns-track-card__title">Salesforce Developer</div>
          <div class="ns-track-card__meta">16 modules · 14h · Intermediate</div>
        </div>
      </a>

      <a href="/tag/salesforce-architect/" class="ns-track-card ns-fade-up ns-stagger-3" aria-label="Salesforce Architect track">
        <div class="ns-track-card__icon">
          <i class="ph-fill ph-blueprint" aria-hidden="true"></i>
        </div>
        <div class="ns-track-card__content">
          <div class="ns-track-card__title">Salesforce Architect</div>
          <div class="ns-track-card__meta">10 modules · 12h · Advanced</div>
        </div>
      </a>

      <a href="/tag/salesforce-consultant/" class="ns-track-card ns-fade-up ns-stagger-4" aria-label="Salesforce Consultant track">
        <div class="ns-track-card__icon">
          <i class="ph-fill ph-briefcase" aria-hidden="true"></i>
        </div>
        <div class="ns-track-card__content">
          <div class="ns-track-card__title">Consultant &amp; BA</div>
          <div class="ns-track-card__meta">9 modules · 10h · All levels</div>
        </div>
      </a>

    </div>

  </div>
</section>

<div class="ns-divider"></div>

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 4 · WHY US / FEATURES
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-section ns-section--gradient">
  <div class="ns-container">

    <div class="has-text-centered mb-6">
      <span class="ns-eyebrow">
        <i class="ph-fill ph-sparkle" aria-hidden="true"></i>
        Why Namaste Salesforce
      </span>
      <h2 class="title is-2 mt-3">
        Learning that actually <span class="ns-gradient-text">works</span>
      </h2>
      <p class="ns-lead">
        Not another passive video course. We build real things, together.
      </p>
    </div>

    <div class="ns-grid ns-grid--3">

      <div class="ns-feature-card ns-fade-up ns-stagger-1">
        <div class="ns-feature-card__icon">
          <i class="ph-fill ph-flask" aria-hidden="true"></i>
        </div>
        <div class="ns-feature-card__title">Hands-on Labs</div>
        <div class="ns-feature-card__body">
          Every concept is reinforced with a real org exercise or Apex challenge — not just multiple-choice quizzes.
        </div>
      </div>

      <div class="ns-feature-card ns-fade-up ns-stagger-2">
        <div class="ns-feature-card__icon">
          <i class="ph-fill ph-git-branch" aria-hidden="true"></i>
        </div>
        <div class="ns-feature-card__title">Real Projects</div>
        <div class="ns-feature-card__body">
          Build portfolio-worthy projects you can show on LinkedIn. From trigger frameworks to full LWC apps.
        </div>
      </div>

      <div class="ns-feature-card ns-fade-up ns-stagger-3">
        <div class="ns-feature-card__icon">
          <i class="ph-fill ph-certificate" aria-hidden="true"></i>
        </div>
        <div class="ns-feature-card__title">Cert Prep Included</div>
        <div class="ns-feature-card__body">
          Flashcards, practice exams, and exam-strategy sessions for Admin, PD1, PD2, and App Builder.
        </div>
      </div>

      <div class="ns-feature-card ns-fade-up ns-stagger-4">
        <div class="ns-feature-card__icon">
          <i class="ph-fill ph-users-three" aria-hidden="true"></i>
        </div>
        <div class="ns-feature-card__title">Community-Driven</div>
        <div class="ns-feature-card__body">
          Ask questions, share solutions, and grow alongside 10,000 other Salesforce learners worldwide.
        </div>
      </div>

      <div class="ns-feature-card ns-fade-up ns-stagger-5">
        <div class="ns-feature-card__icon">
          <i class="ph-fill ph-chalkboard-teacher" aria-hidden="true"></i>
        </div>
        <div class="ns-feature-card__title">Expert Mentors</div>
        <div class="ns-feature-card__body">
          Content is created and reviewed by certified Salesforce professionals with 5–10 years in the field.
        </div>
      </div>

      <div class="ns-feature-card ns-fade-up ns-stagger-6">
        <div class="ns-feature-card__icon">
          <i class="ph-fill ph-open-source-logo" aria-hidden="true"></i>
        </div>
        <div class="ns-feature-card__title">Free &amp; Open Source</div>
        <div class="ns-feature-card__body">
          The platform, the curriculum, and the code are all open. No paywall. No dark patterns. Ever.
        </div>
      </div>

    </div>

  </div>
</section>

<div class="ns-divider"></div>

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 5 · FEATURED COURSES (real Ghost data)
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-section">
  <div class="ns-container">

    <div class="columns is-vcentered mb-6">
      <div class="column">
        <span class="ns-eyebrow">
          <i class="ph-fill ph-graduation-cap" aria-hidden="true"></i>
          Featured Courses
        </span>
        <h2 class="title is-2 mt-3">
          <span class="ns-gradient-text">Start with our best</span>
        </h2>
      </div>
      <div class="column is-narrow is-hidden-mobile">
        <a href="/courses/" class="button is-gradient is-rounded ns-gradient-animated">
          View All Courses
          <span class="icon ml-1"><i class="ph ph-arrow-right" aria-hidden="true"></i></span>
        </a>
      </div>
    </div>

    {{#get "posts" filter="tag:hash-course" limit="3" include="tags,authors"}}
      <div class="ns-grid ns-grid--3">
        {{#foreach posts}}
          <div class="ns-card is-hoverable ns-fade-up ns-stagger-{{@number}}">
            {{#if feature_image}}
              <a href="{{url}}" tabindex="-1" aria-hidden="true">
                <figure class="image is-16by9" style="overflow:hidden;border-radius:inherit;border-bottom-left-radius:0;border-bottom-right-radius:0;">
                  <img
                    class="has-ratio"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                    style="object-fit:cover;">
                </figure>
              </a>
            {{/if}}
            <div class="ns-card__body">
              {{#if primary_tag}}
                <span class="tag ns-badge--gradient mb-3">{{primary_tag.name}}</span>
              {{/if}}
              <h3 class="title is-5 mb-2">
                <a href="{{url}}" class="has-text-inherit">{{title}}</a>
              </h3>
              <p class="is-size-6 has-text-grey">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="20"}}{{/if}}
              </p>
            </div>
            <div class="ns-card__footer">
              <a href="{{url}}" class="button is-gradient is-rounded is-fullwidth ns-gradient-animated">
                <span class="icon"><i class="ph ph-play-circle" aria-hidden="true"></i></span>
                <span>Start Course</span>
              </a>
            </div>
          </div>
        {{/foreach}}
      </div>
    {{else}}
      <div class="ns-glass-card has-text-centered py-6">
        <span class="icon is-large has-text-grey mb-3"><i class="ph ph-graduation-cap" style="font-size:3rem;" aria-hidden="true"></i></span>
        <p class="title is-5 has-text-grey">Courses coming soon!</p>
        <p class="has-text-grey">Tag your posts with <strong>#course</strong> to feature them here.</p>
      </div>
    {{/get}}

    <div class="is-hidden-tablet has-text-centered mt-5">
      <a href="/courses/" class="button is-gradient is-rounded is-fullwidth ns-gradient-animated">View All Courses</a>
    </div>

  </div>
</section>

<div class="ns-divider"></div>

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 6 · LATEST FROM THE BLOG (real Ghost data)
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-section">
  <div class="ns-container">

    <div class="columns is-vcentered mb-6">
      <div class="column">
        <span class="ns-eyebrow">
          <i class="ph-fill ph-article" aria-hidden="true"></i>
          From the Blog
        </span>
        <h2 class="title is-2 mt-3">
          Dev notes, tips &amp; deep dives
        </h2>
      </div>
      <div class="column is-narrow is-hidden-mobile">
        <a href="/blog/" class="button is-outlined is-rounded">
          View All Posts
          <span class="icon ml-1"><i class="ph ph-arrow-right" aria-hidden="true"></i></span>
        </a>
      </div>
    </div>

    {{#get "posts" filter="tag:hash-blog" limit="3" include="tags"}}
      <div class="ns-grid ns-grid--3">
        {{#foreach posts}}
          <article class="ns-card is-hoverable ns-fade-up ns-stagger-{{@number}}">
            {{#if feature_image}}
              <a href="{{url}}" tabindex="-1" aria-hidden="true">
                <figure class="image is-16by9" style="overflow:hidden;border-radius:inherit;border-bottom-left-radius:0;border-bottom-right-radius:0;">
                  <img
                    class="has-ratio"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                    style="object-fit:cover;">
                </figure>
              </a>
            {{/if}}
            <div class="ns-card__body">
              <div class="is-flex is-align-items-center is-size-7 has-text-grey mb-3" style="gap:.5rem;">
                <span><i class="ph ph-calendar-blank" aria-hidden="true"></i></span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                {{#if reading_time}}
                  <span aria-hidden="true">·</span>
                  <span><i class="ph ph-clock" aria-hidden="true"></i></span>
                  <span>{{reading_time minute="1 min" minutes="% min"}}</span>
                {{/if}}
              </div>
              <h3 class="title is-5 mb-2">
                <a href="{{url}}" class="has-text-inherit">{{title}}</a>
              </h3>
              <p class="is-size-6 has-text-grey">
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="20"}}{{/if}}
              </p>
            </div>
            <div class="ns-card__footer">
              <a href="{{url}}" class="has-text-weight-semibold is-size-6">
                Read post
                <span class="icon"><i class="ph ph-arrow-right" aria-hidden="true"></i></span>
              </a>
            </div>
          </article>
        {{/foreach}}
      </div>
    {{else}}
      <div class="ns-glass-card has-text-centered py-6">
        <span class="icon is-large has-text-grey mb-3"><i class="ph ph-article" style="font-size:3rem;" aria-hidden="true"></i></span>
        <p class="title is-5 has-text-grey">Blog posts coming soon!</p>
        <p class="has-text-grey">Tag your posts with <strong>#blog</strong> to feature them here.</p>
      </div>
    {{/get}}

    <div class="is-hidden-tablet has-text-centered mt-5">
      <a href="/blog/" class="button is-outlined is-rounded is-fullwidth">View All Posts</a>
    </div>

  </div>
</section>

<div class="ns-divider"></div>

{{!-- ══════════════════════════════════════════════════════════════════════════
    SECTION 7 · BIG CTA BAND — final conversion push
══════════════════════════════════════════════════════════════════════════ --}}
<section class="ns-section ns-section--loose ns-section--gradient">
  <div class="ns-container">

    <div class="ns-glass-card has-text-centered" style="padding:4rem 2rem;max-width:780px;margin:0 auto;">

      <span class="ns-eyebrow ns-fade-in ns-stagger-1">
        <i class="ph-fill ph-rocket-launch" aria-hidden="true"></i>
        Begin Today — It's Free
      </span>

      <h2 class="title is-1 is-size-2-mobile mt-4 ns-fade-up ns-stagger-2">
        Your Salesforce career
        <span class="ns-gradient-text ns-display">starts today.</span>
      </h2>

      <p class="ns-lead ns-fade-up ns-stagger-3" style="max-width:560px;margin:1rem auto 2rem;">
        Thousands of learners have used this platform to pass certifications, land jobs, and build incredible Salesforce apps. You're next.
      </p>

      <div class="ns-fade-up ns-stagger-4">
        {{#if @site.members_enabled}}
        <form data-members-form class="mx-auto" style="max-width:520px;">
          <div class="field has-addons is-justify-content-center">
            <div class="control is-expanded has-icons-left">
              <input
                data-members-email
                class="input is-large is-rounded"
                type="email"
                placeholder="you@email.com"
                required
                aria-label="Your email address">
              <span class="icon is-left"><i class="ph ph-envelope-simple" aria-hidden="true"></i></span>
            </div>
            <div class="control">
              <button
                class="button is-gradient is-large is-rounded ns-gradient-animated"
                type="submit">
                Join for Free
              </button>
            </div>
          </div>
          <p class="message-success is-hidden has-text-white mt-3">
            <i class="ph-fill ph-check-circle" aria-hidden="true"></i>
            Check your inbox — one click to confirm!
          </p>
          <p class="message-error is-hidden has-text-warning mt-3">
            <i class="ph-fill ph-warning" aria-hidden="true"></i>
            Please enter a valid email address.
          </p>
        </form>
        {{else}}
        <div class="buttons is-centered">
          <a class="button is-gradient is-large is-rounded ns-gradient-animated"
             href="#/portal/signup"
             data-portal="signup">
            <span class="icon"><i class="ph-fill ph-rocket-launch" aria-hidden="true"></i></span>
            <span>Join for Free</span>
          </a>
          <a class="button is-large is-rounded is-outlined is-white"
             href="/courses/">
            <span class="icon"><i class="ph ph-books" aria-hidden="true"></i></span>
            <span>Browse Courses</span>
          </a>
        </div>
        {{/if}}
      </div>

      <p class="is-size-7 mt-4 ns-fade-in ns-stagger-5" style="opacity:.75;">
        Free forever &nbsp;·&nbsp; No credit card &nbsp;·&nbsp; Unsubscribe anytime
      </p>

    </div>

  </div>
</section>
