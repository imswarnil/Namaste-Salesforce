          </div>
 
          <!-- Course preview cards strip -->
          <div class="columns is-mobile is-multiline is-variable is-2">
 
            <div class="column is-4">
              <div class="card has-background-dark">
                <div class="card-content p-4">
                  <p class="is-size-4 mb-2">⚡</p>
                  <p class="has-text-white has-text-weight-semibold is-size-7">Salesforce Admin</p>
                  <p class="is-size-7 has-text-grey-light">24 lessons</p>
                </div>
              </div>
            </div>
 
            <div class="column is-4">
              <div class="card has-background-dark">
                <div class="card-content p-4">
                  <p class="is-size-4 mb-2">📊</p>
                  <p class="has-text-white has-text-weight-semibold is-size-7">CRMA Analytics</p>
                  <p class="is-size-7 has-text-grey-light">18 lessons</p>
                </div>
              </div>
            </div>
 
            <div class="column is-4">
              <div class="card has-background-dark">
                <div class="card-content p-4">
                  <p class="is-size-4 mb-2">🎨</p>
                  <p class="has-text-white has-text-weight-semibold is-size-7">UI / UX Design</p>
                  <p class="is-size-7 has-text-grey-light">31 lessons</p>
                </div>
              </div>
            </div>
 
          </div>
 
          <!-- Rating notification -->
          <div class="notification is-dark mt-2 py-3 px-4">
            <div class="level is-mobile">
              <div class="level-left">
                <div class="level-item">
                  <figure class="image is-32x32 mr-3">
                    <img class="is-rounded" src="https://i.pravatar.cc/64?img=21" alt="Student">
                  </figure>
                </div>
                <div class="level-item">
                  <div>
                    <p class="is-size-7 has-text-grey-light">Salesforce CRMA Basics</p>
                    <progress class="progress is-warning is-small mt-1" value="78" max="100" style="width:140px">78%</progress>
                  </div>
                </div>
              </div>
              <div class="level-right">
                <div class="level-item">
                  <span class="tag is-warning is-rounded has-text-weight-bold">78%</span>
                </div>
              </div>
            </div>
          </div>
 
        </div>
      </div>
    </div>
  </div>
</section>
 

{{!-- 
{{! ══════════════════════════════════════════════════════════════════════════
    1. HERO SECTION 
