{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  home.hbs — Landing page (custom template / routed home).
  Hero → skills marquee → stats → everything-in-one-place → tracks → how it
  works → why us → featured courses → mission timeline → testimonials → latest
  blog → open-source band → newsletter CTA. Reuses many home/* partials.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── 1. HERO (AI-era LMS) ─────────────────────────────────────────────── --}}
<section class="relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 text-white">
  {{> "components/hero-bg"}}

  <div class="relative mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:py-32">
    <span class="inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-sm font-semibold ring-1 ring-white/20">
      {{> "icons/sparkle" class="h-4 w-4 text-brand-200"}}{{t "Salesforce skills for the AI era"}}
    </span>

    <h1 class="mt-6 font-heading text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
      {{t "The open LMS for"}}<br>
      <span class="bg-gradient-to-r from-brand-200 via-white to-brand-200 bg-clip-text text-transparent">{{t "next-gen Salesforce careers"}}</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-white/80 sm:text-xl">
      {{t "Master Admin, Apex and LWC — then go further with Agentforce, Data Cloud and Einstein AI. Hands-on courses, roadmaps and projects, free and open source."}}
    </p>

    <div class="mx-auto mt-8 max-w-md">
      {{#if @site.members_enabled}}
        <form data-members-form="subscribe" class="flex flex-col gap-3 sm:flex-row">
          <input data-members-email type="email" required placeholder="you@email.com" aria-label="{{t "Your email address"}}"
                 class="w-full rounded-pill border-0 px-5 py-3 text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand-300">
          <button type="submit" class="shrink-0 rounded-pill bg-white px-6 py-3 font-bold text-brand-700 transition hover:bg-brand-50">{{t "Start free"}}</button>
        </form>
        <p data-members-success class="mt-3 hidden text-sm text-white/90">{{t "Check your inbox to confirm! 🎉"}}</p>
      {{else}}
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#/portal/signup" data-portal="signup" class="rounded-pill bg-white px-6 py-3 font-bold text-brand-700 transition hover:bg-brand-50">{{t "Start Learning Free"}}</a>
          <a href="/courses/" class="rounded-pill px-6 py-3 font-semibold text-white ring-1 ring-white/40 transition hover:bg-white/10">{{t "Browse Courses"}}</a>
        </div>
      {{/if}}
      <p class="mt-4 text-sm text-white/60">{{t "Free forever · No credit card · Join 10,000+ learners"}}</p>
    </div>
  </div>
</section>

{{!-- ── 2. SKILLS MARQUEE ────────────────────────────────────────────────── --}}
<div class="marquee overflow-hidden border-b border-border bg-surface-sunken py-6">
  <div class="marquee-track flex w-max items-center gap-3 animate-marquee">
    {{> "home/skills"}}{{> "home/skills"}}
  </div>
</div>

{{!-- ── 3. STATS ─────────────────────────────────────────────────────────── --}}
<section class="border-b border-border">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 px-4 py-10 text-center sm:px-6 lg:grid-cols-4">
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">10K+</div><div class="mt-1 text-sm font-medium text-muted">{{t "Active learners"}}</div></div>
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">50+</div><div class="mt-1 text-sm font-medium text-muted">{{t "Courses & modules"}}</div></div>
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">300+</div><div class="mt-1 text-sm font-medium text-muted">{{t "Video lessons"}}</div></div>
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">4.9★</div><div class="mt-1 text-sm font-medium text-muted">{{t "Average rating"}}</div></div>
  </div>
</section>

{{!-- ── 4. EVERYTHING IN ONE PLACE (collections) ─────────────────────────── --}}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Everything in one place"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "One platform, every resource"}}</h2>
    <p class="mt-3 text-muted">{{t "Structured courses, guided roadmaps, deep docs and a developer blog — all free and open."}}</p>
  </div>
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {{> "home/collection-card" href="/courses/" icon="ph-graduation-cap" title="Courses" body="Project-based courses from Admin fundamentals to advanced development." cta="Browse courses"}}
    {{> "home/collection-card" href="/training/" icon="ph-map-trifold" title="Roadmaps" body="Step-by-step learning tracks that take you role by role." cta="View roadmaps"}}
    {{> "home/collection-card" href="/docs/" icon="ph-book-open-text" title="Documentation" body="Concise references and how-tos for every Salesforce concept." cta="Read the docs"}}
    {{> "home/collection-card" href="/blog/" icon="ph-newspaper" title="Dev Blog" body="Tips, deep dives and updates from the Salesforce ecosystem." cta="Read the blog"}}
  </div>
</section>

{{!-- ── 5. LEARNING TRACKS ───────────────────────────────────────────────── --}}
<section class="border-y border-border bg-surface-sunken">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Structured paths"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Pick your learning track"}}</h2>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {{> "home/track-card" href="/tag/salesforce-admin/" icon="ph-shield-check" title="Salesforce Admin" meta="12 modules · 8h · Beginner"}}
      {{> "home/track-card" href="/tag/salesforce-developer/" icon="ph-code" title="Salesforce Developer" meta="16 modules · 14h · Intermediate"}}
      {{> "home/track-card" href="/tag/salesforce-architect/" icon="ph-blueprint" title="Salesforce Architect" meta="10 modules · 12h · Advanced"}}
      {{> "home/track-card" href="/tag/agentforce/" icon="ph-robot" title="Agentforce & AI" meta="8 modules · 9h · New"}}
    </div>
  </div>
</section>

{{!-- ── 6. HOW IT WORKS (steppers) ───────────────────────────────────────── --}}
<section class="relative overflow-hidden px-4 py-16 sm:px-6 lg:py-20">
  <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 text-ink/40"></div>
  <div class="relative mx-auto max-w-7xl">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "How it works"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "From zero to certified in four steps"}}</h2>
  </div>
  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {{> "home/step" num="1" icon="ph-path" title="Pick your path" body="Choose a role-based roadmap or jump straight into a course."}}
    {{> "home/step" num="2" icon="ph-flask" title="Learn by doing" body="Every lesson pairs theory with a hands-on org or Apex exercise."}}
    {{> "home/step" num="3" icon="ph-git-branch" title="Build projects" body="Ship portfolio-worthy projects you can show employers."}}
    {{> "home/step" num="4" icon="ph-certificate" title="Get certified" body="Prep with flashcards and practice exams, then pass with confidence."}}
  </div>
  </div>
</section>

{{!-- ── 7. WHY US (features) ─────────────────────────────────────────────── --}}
<section class="border-y border-border bg-surface-sunken">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Why Namaste Salesforce"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Learning that actually works"}}</h2>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {{> "home/feature-card" icon="ph-flask" title="Hands-on labs" body="Every concept is reinforced with a real org exercise or Apex challenge."}}
      {{> "home/feature-card" icon="ph-robot" title="AI-era curriculum" body="Go beyond the basics with Agentforce, Data Cloud and Einstein."}}
      {{> "home/feature-card" icon="ph-certificate" title="Cert prep included" body="Flashcards and practice exams for Admin, PD1, PD2 and App Builder."}}
      {{> "home/feature-card" icon="ph-users-three" title="Community-driven" body="Learn alongside 10,000 other Salesforce learners worldwide."}}
      {{> "home/feature-card" icon="ph-chalkboard-teacher" title="Expert mentors" body="Content created and reviewed by certified pros with real field experience."}}
      {{> "home/feature-card" icon="ph-open-source-logo" title="Free & open source" body="The platform, the curriculum and the code are all open. No paywall, ever."}}
    </div>
  </div>
</section>

{{!-- ── 8. FEATURED COURSES ──────────────────────────────────────────────── --}}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Featured courses"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Start with our best"}}</h2>
    </div>
    <a href="/courses/" class="inline-flex items-center gap-1 rounded-pill bg-brand-500 px-5 py-2.5 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">
      {{t "View all courses"}}{{> "icons/arrow-right" class="h-4 w-4"}}
    </a>
  </div>
  {{#get "posts" filter="tag:hash-course" limit="3" include="tags,authors"}}
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {{#foreach posts}}<div class="motion-safe:animate-fade-up">{{> post-card}}</div>{{/foreach}}
    </div>
  {{else}}
    <div class="rounded-card border border-dashed border-border py-16 text-center text-muted">
      <i class="ph ph-graduation-cap mb-3 text-4xl" aria-hidden="true"></i>
      <p class="text-lg font-semibold">{{t "Courses coming soon!"}}</p>
      <p class="text-sm">{{t "Tag posts with #course to feature them here."}}</p>
    </div>
  {{/get}}
</section>

{{!-- ── 9. MISSION TIMELINE ──────────────────────────────────────────────── --}}
<section class="border-y border-border bg-surface-sunken">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-20">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Our mission"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Free Salesforce education, built in the open"}}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{{t "We started with a simple belief: world-class Salesforce skills shouldn't sit behind a paywall. Here's where we've been — and where we're headed."}}</p>
      <a href="/about/" class="mt-6 inline-flex items-center gap-1 font-semibold text-brand-600 dark:text-brand-300">{{t "Read our story"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
    </div>
    <ol class="ns-timeline space-y-8">
      {{> "home/timeline-item" year="The why" title="Close the opportunity gap" body="Make hands-on Salesforce learning accessible to anyone, anywhere — for free."}}
      {{> "home/timeline-item" year="2024" title="Platform launched" body="The first open courses and roadmaps went live to a growing community."}}
      {{> "home/timeline-item" year="2025" title="10,000 learners" body="Crossed ten thousand learners and 300+ lessons across every role."}}
      {{> "home/timeline-item" year="2026" title="AI-era curriculum" body="Added Agentforce, Data Cloud and Einstein tracks for the next generation of skills."}}
    </ol>
  </div>
</section>

{{!-- ── 10. TESTIMONIALS ─────────────────────────────────────────────────── --}}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Loved by learners"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Careers changed, one lesson at a time"}}</h2>
  </div>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {{> "home/testimonial" quote="I went from zero to a certified Admin in three months. The hands-on labs made everything click." name="Priya S." role="Salesforce Administrator"}}
    {{> "home/testimonial" quote="The Apex and LWC projects gave me a portfolio that landed my first developer role." name="Daniel O." role="Junior Developer"}}
    {{> "home/testimonial" quote="Finally a resource that covers Agentforce and Data Cloud properly. Exactly what the AI era needs." name="Mei L." role="Solution Architect"}}
  </div>
</section>

{{!-- ── 11. LATEST BLOG ──────────────────────────────────────────────────── --}}
{{#get "posts" filter="tag:hash-blog" limit="3" include="tags"}}
  {{#if posts}}
    <section class="border-t border-border bg-surface-sunken">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "From the blog"}}</p>
            <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Dev notes, tips & deep dives"}}</h2>
          </div>
          <a href="/blog/" class="inline-flex items-center gap-1 rounded-pill border border-border px-5 py-2.5 text-sm font-medium transition hover:border-brand-500 hover:text-brand-600">
            {{t "View all posts"}}{{> "icons/arrow-right" class="h-4 w-4"}}
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {{#foreach posts}}<div class="motion-safe:animate-fade-up">{{> post-card}}</div>{{/foreach}}
        </div>
      </div>
    </section>
  {{/if}}
{{/get}}

{{!-- ── 12. OPEN-SOURCE BAND ─────────────────────────────────────────────── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="relative overflow-hidden rounded-card border border-border bg-surface-raised p-8 shadow-card sm:p-12">
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
      <div>
        <span class="inline-flex items-center gap-2 rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{> "icons/github" class="h-4 w-4"}}{{t "Open source"}}</span>
        <h2 class="mt-3 font-heading text-2xl font-extrabold sm:text-3xl">{{t "Built in the open — come build with us"}}</h2>
        <p class="mt-2 max-w-xl text-muted">{{t "The theme, the curriculum and the code are public. Star the repo, open an issue, or contribute a lesson."}}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-5 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{> "icons/github" class="h-5 w-5"}}{{t "Star on GitHub"}}</a>
        <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-pill px-5 py-3 font-semibold text-pink-600 ring-1 ring-pink-500/30 transition hover:bg-pink-500/10">{{> "icons/heart" class="h-5 w-5"}}{{t "Sponsor"}}</a>
      </div>
    </div>
  </div>
</section>

{{!-- ── 13. NEWSLETTER CTA ───────────────────────────────────────────────── --}}
{{> "components/cta"}}
