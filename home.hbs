{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  home.hbs — Landing page. Deliberately simple & plain-Tailwind: a light hero
  over a grid-line background pattern, a stats row, collection cards, featured
  courses, latest blog, and a CTA. No gradients/marquee/timeline.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── HERO (light, grid-line background) ───────────────────────────────── --}}
<section class="relative overflow-hidden border-b border-border bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0"
       style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 52px 52px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%); mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%);"></div>

  <div class="relative mx-auto grid max-w-[85rem] items-center gap-10 px-4 py-14 sm:px-6 lg:min-h-[calc(100vh-3.6rem)] lg:grid-cols-[1.05fr_0.95fr] lg:py-16">

    {{!-- ── Left: copy + CTAs + subscribe ── --}}
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-semibold text-brand-600 dark:text-brand-300 shadow-card">
        {{> "icons/sparkle" class="h-4 w-4"}}{{t "Salesforce skills for the AI era"}}
      </span>

      <h1 class="mt-5 font-heading text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl xl:text-5xl">
        {{t "The open LMS for"}}<br><span class="text-brand-600 dark:text-brand-400">{{t "next-gen Salesforce careers"}}</span>
      </h1>

      <p class="mx-auto mt-4 max-w-md text-muted sm:text-lg lg:mx-0">
        {{t "Master Admin, Apex and LWC — then go further with Agentforce, Data Cloud and Einstein AI. Hands-on courses, training and docs, free and open source."}}
      </p>

      {{!-- CTA + inline newsletter --}}
      <div class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:justify-start">
        <a href="#/portal/signup" data-portal="signup" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600"><i class="ph-fill ph-rocket-launch" aria-hidden="true"></i>{{t "Start learning free"}}</a>
        <a href="/courses/" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-pill border border-border bg-surface px-6 py-3 font-semibold text-ink transition hover:border-brand-500 hover:text-brand-600"><i class="ph-fill ph-graduation-cap" aria-hidden="true"></i>{{t "Browse courses"}}</a>
      </div>

      {{!-- reassurance --}}
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-semibold text-muted lg:justify-start">
        <span class="inline-flex items-center gap-1.5"><i class="ph-fill ph-check-circle text-success" aria-hidden="true"></i>{{t "Free forever"}}</span>
        <span class="inline-flex items-center gap-1.5"><i class="ph-fill ph-git-branch text-brand-500" aria-hidden="true"></i>{{t "Open source"}}</span>
        <span class="inline-flex items-center gap-1.5"><i class="ph-fill ph-seal-check text-brand-500" aria-hidden="true"></i>{{t "Certificates included"}}</span>
      </div>
    </div>

    {{!-- ── Right: publication cover — self-animated SVG of the platform
         (assets/img/publication-cover.svg: lesson player, HUD-pinned concept
         cards, dotted path flag → certificate). One cached vector, animations
         run inside the <img>, responsive by intrinsic ratio. ── --}}
    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      <div class="pointer-events-none absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
      <img src="{{asset "img/publication-cover.svg"}}" alt="{{t "Illustration of the Namaste Salesforce learning platform"}}"
           width="770" height="550" loading="eager" fetchpriority="high" decoding="async"
           class="relative h-auto w-full rounded-2xl border border-border shadow-raised">
    </div>
  </div>
</section>

{{!-- ── MANIFESTO: big fat typography that inks in as you scroll (dark) ── --}}
<section class="border-b border-border bg-[#032D60]">
  <div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:py-32">
    <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-200"><span aria-hidden="true">💙</span><i class="ph-fill ph-quotes" aria-hidden="true"></i>{{t "Why this exists"}}</p>
    <p class="js-manifesto mt-6 font-heading text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">{{t "World-class Salesforce education shouldn't cost a salary or live in a hundred scattered tabs. So I built one open place — courses, training, docs and a blog — free for every learner, forever."}}</p>
    <p class="mt-8 flex items-center gap-3 text-sm font-semibold text-white/60"><span class="h-px w-10 bg-brand-300"></span>{{t "Swarnil, creator of Namaste Salesforce"}}</p>
  </div>
</section>

{{!-- ── SCREEN MARQUEE: the product, as 3D-slanted screens drifting by
     (Aceternity-style) — white canvas, rows autoplay left/right forever ── --}}
<section class="relative overflow-hidden border-b border-border bg-white dark:bg-surface">
  <div class="relative z-10 mx-auto max-w-6xl px-4 pt-20 text-center sm:px-6">
    <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-600 dark:text-brand-300"><span aria-hidden="true">🎬</span><i class="ph-fill ph-film-strip" aria-hidden="true"></i>{{t "The project, frame by frame"}}</p>
    <h2 class="mx-auto mt-3 max-w-2xl font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{t "Everything in one place"}}</h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">{{t "Structured courses, guided training, deep docs and a developer blog — all free and open."}}</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm font-bold">
      <a href="/courses/" class="rounded-pill bg-brand-500/10 px-4 py-1.5 text-brand-600 transition hover:bg-brand-500 hover:text-white dark:text-brand-300 dark:hover:text-white">🎓 {{t "Courses"}}</a>
      <a href="/training/" class="rounded-pill bg-brand-500/10 px-4 py-1.5 text-brand-600 transition hover:bg-brand-500 hover:text-white dark:text-brand-300 dark:hover:text-white">🗺️ {{t "Training"}}</a>
      <a href="/docs/" class="rounded-pill bg-brand-500/10 px-4 py-1.5 text-brand-600 transition hover:bg-brand-500 hover:text-white dark:text-brand-300 dark:hover:text-white">📖 {{t "Docs"}}</a>
      <a href="/blog/" class="rounded-pill bg-brand-500/10 px-4 py-1.5 text-brand-600 transition hover:bg-brand-500 hover:text-white dark:text-brand-300 dark:hover:text-white">📰 {{t "Blog"}}</a>
      <a href="/resources/" class="rounded-pill bg-brand-500/10 px-4 py-1.5 text-brand-600 transition hover:bg-brand-500 hover:text-white dark:text-brand-300 dark:hover:text-white">🧰 {{t "Resources"}}</a>
    </div>
  </div>

