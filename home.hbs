                </div>
                <div class="column is-6-desktop is-hidden-touch">
                    <figure class="image is-4by3">
                        <!-- SLDS style: crisp borders, subtle shadow -->
                        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1000&q=80" alt="Namaste Salesforce Training" style="border-radius: var(--bulma-radius-large); box-shadow: var(--bulma-shadow); object-fit: cover; border: 1px solid var(--bulma-border-light);">
                    </figure>
                </div>
            </div>
        </div>
    </div>
</section>

{{! ══════════════════════════════════════════════════════════════════════════
    2. TRAINING PATHS (Trailhead-style List Layout)
══════════════════════════════════════════════════════════════════════════ }}
<section class="section has-background-white-bis py-6">
    <div class="container my-5">
        <div class="columns is-vcentered mb-6">
            <div class="column">
                <h2 class="title is-2 has-text-weight-bold mb-2">End-to-End Training</h2>
                <p class="subtitle is-5 has-text-grey">Sequential learning paths. From Admin to Architect.</p>
            </div>
            <div class="column is-narrow is-hidden-mobile">
                <a href="/training/" class="button is-primary is-outlined has-text-weight-bold">View All Training</a>
            </div>
        </div>

        <!-- Using Bulma Media Objects for a Curriculum List look -->
        <div class="columns is-multiline is-centered">
            <div class="column is-10-desktop is-12-mobile">
                {{#get "posts" filter="tag:hash-training" limit="3" order="published_at asc" include="tags"}}
                    {{#foreach posts}}
                        <div class="box p-5 mb-4 is-shadowless" style="border: 1px solid var(--bulma-border-light);">
                            <article class="media is-align-items-center">
                                <div class="media-left is-hidden-mobile">
                                    <span class="icon is-large has-background-warning-light has-text-warning-dark" style="border-radius: var(--bulma-radius-large); width: 4rem; height: 4rem;">
                                        <i class="ph-fill ph-map-pin-line is-size-3"></i>
                                    </span>
                                </div>
                                <div class="media-content">
                                    <div class="content">
                                        <p class="mb-1">
                                            <span class="tag is-warning is-light has-text-weight-bold mb-2">Module {{@number}}</span><br>
                                            <strong class="is-size-4"><a href="{{url}}" class="has-text-dark">{{title}}</a></strong>
                                            <br>
                                            <span class="has-text-grey is-size-6">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="20"}}{{/if}}</span>
                                        </p>
                                    </div>
                                </div>
                                <div class="media-right">
                                    <a href="{{url}}" class="button is-primary is-light has-text-weight-bold">
                                        Start
                                    </a>
                                </div>
                            </article>
                        </div>
                    {{/foreach}}
                {{else}}
                    <div class="notification is-light">No training modules published yet. Tag posts with <strong>#training</strong>.</div>
                {{/get}}
            </div>
        </div>

        <div class="is-hidden-tablet has-text-centered mt-4">
            <a href="/training/" class="button is-primary is-fullwidth has-text-weight-bold">View All Training</a>
        </div>
    </div>
</section>

{{! ══════════════════════════════════════════════════════════════════════════
    3. TARGETED COURSES (Pure Bulma Cards)
══════════════════════════════════════════════════════════════════════════ }}
<section class="section has-background-white py-6" style="border-top: 1px solid var(--bulma-border-light); border-bottom: 1px solid var(--bulma-border-light);">
    <div class="container my-5">
        <div class="columns is-vcentered mb-6">
            <div class="column">
                <h2 class="title is-2 has-text-weight-bold mb-2">Targeted Courses</h2>
                <p class="subtitle is-5 has-text-grey">Deep dives into specific enterprise topics.</p>
            </div>
            <div class="column is-narrow is-hidden-mobile">
                <a href="/courses/" class="button is-info is-outlined has-text-weight-bold">Browse Catalog</a>
            </div>
        </div>

        <div class="columns is-multiline">
            {{#get "posts" filter="tag:hash-course" limit="4" include="tags,authors"}}
                {{#foreach posts}}
                    <div class="column is-3-desktop is-6-tablet is-12-mobile is-flex">
                        <div class="card is-flex-grow-1 is-flex is-flex-direction-column is-shadowless" style="border: 1px solid var(--bulma-border-light);">
                            {{#if feature_image}}
                                <div class="card-image">
                                    <figure class="image is-16by9" style="border-bottom: 1px solid var(--bulma-border-light);">
                                        <a href="{{url}}"><img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" style="object-fit: cover;"></a>
                                    </figure>
                                </div>
                            {{/if}}
                            <div class="card-content is-flex-grow-1">
                                {{#if primary_tag}}
                                    <div class="tags mb-3">
                                        <a href="{{primary_tag.url}}" class="tag is-info is-light has-text-weight-medium">{{primary_tag.name}}</a>
                                    </div>
                                {{/if}}
                                <p class="title is-5 mb-3">
                                    <a href="{{url}}" class="has-text-dark">{{title}}</a>
                                </p>
                                <div class="content is-size-7 has-text-grey">
                                    {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="14"}}{{/if}}
                                </div>
                            </div>
                            <footer class="card-footer has-background-white-bis">
                                <a href="{{url}}" class="card-footer-item has-text-weight-bold has-text-dark">View Course</a>
                            </footer>
                        </div>
                    </div>
                {{/foreach}}
            {{else}}
                <div class="column is-12">
                    <div class="notification is-light">No courses published yet. Tag posts with <strong>#course</strong>.</div>
                </div>
            {{/get}}
        </div>

        <div class="is-hidden-tablet has-text-centered mt-4">
            <a href="/courses/" class="button is-info is-fullwidth has-text-weight-bold">Browse Catalog</a>
        </div>
    </div>
</section>

{{! ══════════════════════════════════════════════════════════════════════════
    4. PLATFORM DOCUMENTATION (Bulma Panel Menu)
══════════════════════════════════════════════════════════════════════════ }}
<section class="section has-background-white-bis py-6">
    <div class="container my-5">
        <div class="columns is-variable is-8">
            <div class="column is-5-desktop is-12-mobile">
                <span class="icon is-large has-text-dark mb-4">
                    <i class="ph-fill ph-book-bookmark is-size-1"></i>
                </span>
                <h2 class="title is-2 has-text-weight-bold mb-4">Platform Docs</h2>
                <p class="subtitle is-5 has-text-grey mb-6">
                    Need help navigating the site or want to contribute? Read our official open-source documentation and guidelines.
                </p>
                <a href="/documentation/" class="button is-dark is-medium has-text-weight-bold">
                    Read the Docs
                </a>
            </div>
            <div class="column is-7-desktop is-12-mobile">
                <!-- Switched to Bulma's highly structured Panel component -->
                <nav class="panel is-info has-background-white" style="border: 1px solid var(--bulma-border-light); box-shadow: var(--bulma-shadow-sm);">
                    <p class="panel-heading has-text-weight-bold is-size-6">
                        Essential Resources
                    </p>
                    {{#get "posts" filter="tag:documentation" limit="5"}}
                        {{#foreach posts}}
                            <a class="panel-block py-4" href="{{url}}">
                                <span class="panel-icon has-text-info">
                                    <i class="ph-bold ph-file-text" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <strong class="has-text-dark is-block">{{title}}</strong>
                                    <span class="is-size-7 has-text-grey">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="8"}}{{/if}}</span>
                                </div>
                            </a>
                        {{/foreach}}
                    {{else}}
                        <div class="panel-block p-5">
                            <div class="content has-text-grey">No documentation published yet. Tag posts with <strong>documentation</strong>.</div>
                        </div>
                    {{/get}}
                    <div class="panel-block p-3 has-background-white-bis">
                        <a href="/documentation/" class="button is-info is-outlined is-fullwidth has-text-weight-bold">
                            View All Documentation
                        </a>
                    </div>
                </nav>
            </div>
        </div>
    </div>
</section>

{{! ══════════════════════════════════════════════════════════════════════════
    5. LATEST BLOG POSTS (Clean Box Grid)
══════════════════════════════════════════════════════════════════════════ }}
<section class="section has-background-white py-6" style="border-top: 1px solid var(--bulma-border-light);">
    <div class="container my-5">
        <div class="columns is-vcentered mb-6">
            <div class="column">
                <h2 class="title is-2 has-text-weight-bold mb-2">Latest Dev Notes</h2>
                <p class="subtitle is-5 has-text-grey">Bug fixes, interview prep, and daily thoughts.</p>
            </div>
            <div class="column is-narrow is-hidden-mobile">
                <a href="/blog/" class="button is-dark is-outlined has-text-weight-bold">View Blog</a>
            </div>
        </div>

        <div class="columns is-multiline">
            {{#get "posts" filter="tag:hash-blog" limit="3" include="tags"}}
                {{#foreach posts}}
                    <div class="column is-4-desktop is-12-mobile is-flex">
                        <div class="box is-flex-grow-1 is-flex is-flex-direction-column has-background-white-bis is-shadowless" style="border: 1px solid var(--bulma-border-light);">
                            <div class="mb-4">
                                <span class="tag is-white has-text-grey-dark has-text-weight-semibold" style="border: 1px solid var(--bulma-border-light);">
