{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  home.hbs — Landing page. Deliberately simple & plain-Tailwind: a light hero
  over a grid-line background pattern, a stats row, collection cards, featured
  courses, latest blog, and a CTA. No gradients/marquee/timeline.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── HERO (light, grid-line background) ───────────────────────────────── --}}
<section class="relative overflow-hidden border-b border-border bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0"
       style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 52px 52px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%); mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%);"></div>

  <div class="relative mx-auto grid max-w-[85rem] items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:py-14">

    {{!-- ── Left: copy + CTAs + subscribe ── --}}
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-semibold text-brand-600 dark:text-brand-300 shadow-card">
        {{> "icons/sparkle" class="h-4 w-4"}}{{t "Salesforce skills for the AI era"}}
      </span>

      <h1 class="mt-5 font-heading text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl xl:text-5xl">
        {{t "The open LMS for"}}<br><span class="text-brand-600 dark:text-brand-400">{{t "next-gen Salesforce careers"}}</span>
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-muted sm:text-lg lg:mx-0">
        {{t "Master Admin, Apex and LWC — then go further with Agentforce, Data Cloud and Einstein AI. Hands-on courses, roadmaps and docs, free and open source."}}
      </p>

      {{!-- CTA + inline newsletter --}}
      <div class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:justify-start">
        <a href="#/portal/signup" data-portal="signup" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "Start learning free"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        <form data-members-form="signup" class="w-full max-w-sm">
          <div class="flex overflow-hidden rounded-pill border border-border bg-surface shadow-card focus-within:border-brand-500">
            <input data-members-email type="email" required placeholder="{{t "Your email — free lessons weekly"}}" aria-label="{{t "Email address"}}"
                   class="w-full min-w-0 border-0 bg-transparent px-5 py-3 text-sm text-ink placeholder:text-muted focus:outline-none">
            <button type="submit" class="shrink-0 bg-brand-500 px-5 text-sm font-bold text-white transition hover:bg-brand-600" aria-label="{{t "Subscribe"}}">
              <span data-members-loading class="hidden"><i class="ph ph-circle-notch animate-spin" aria-hidden="true"></i></span>
              <span data-members-default><i class="ph ph-paper-plane-right" aria-hidden="true"></i></span>
            </button>
          </div>
          <p data-members-success class="mt-2 hidden text-sm font-semibold text-success">{{t "Check your inbox to confirm — welcome aboard!"}}</p>
          <p data-members-error class="mt-2 hidden text-sm font-semibold text-error">{{t "Something went wrong — try again."}}</p>
        </form>
      </div>

    </div>

    {{!-- ── Right: publication cover — self-animated SVG of the platform
         (assets/img/publication-cover.svg: lesson player, HUD-pinned concept
         cards, dotted path flag → certificate). One cached vector, animations
         run inside the <img>, responsive by intrinsic ratio. ── --}}
    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      <div class="pointer-events-none absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
      <img src="{{asset "img/publication-cover.svg"}}" alt="{{t "Illustration of the Namaste Salesforce learning platform"}}"
           width="1200" height="630" loading="eager" decoding="async"
           class="relative h-auto w-full rounded-2xl border border-border shadow-raised">
    </div>
  </div>
</section>

{{!-- ── COLLECTIONS ──────────────────────────────────────────────────────── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="mb-10 max-w-2xl">
    <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Everything in one place"}}</h2>
    <p class="mt-2 text-muted">{{t "Structured courses, guided roadmaps, deep docs and a developer blog — all free and open."}}</p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{> "home/collection-card" href="/courses/" icon="ph-graduation-cap" title="Courses" body="Project-based courses from Admin fundamentals to advanced development." cta="Browse courses"}}
    {{> "home/collection-card" href="/training/" icon="ph-map-trifold" title="Roadmaps" body="Step-by-step learning tracks that take you role by role." cta="View roadmaps"}}
    {{> "home/collection-card" href="/docs/" icon="ph-book-open-text" title="Documentation" body="Concise references and how-tos for every Salesforce concept." cta="Read the docs"}}
    {{> "home/collection-card" href="/blog/" icon="ph-newspaper" title="Dev Blog" body="Tips, deep dives and updates from the Salesforce ecosystem." cta="Read the blog"}}
  </div>
</section>

{{!-- ── FEATURED COURSES ─────────────────────────────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Popular courses"}}</h2>
        <p class="mt-2 max-w-xl text-muted">{{t "Project-based and carefully produced — watch, build along, and check your understanding as you go."}}</p>
      </div>
      <a href="/courses/" class="inline-flex items-center gap-1 text-sm font-bold text-brand-600 hover:underline dark:text-brand-300">{{t "View all"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
    </div>
    {{#get "posts" filter="tag:hash-course" limit="3" include="tags,authors"}}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {{#foreach posts}}{{> "courses/course-card"}}{{/foreach}}
      </div>
    {{else}}
      <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Courses coming soon."}}</p>
    {{/get}}

    {{!-- How courses are made + access model + author CTA --}}
    <div class="mt-12 grid gap-4 border-t border-border pt-10 md:grid-cols-3">
      <div class="rounded-card border border-border bg-surface-raised p-6 shadow-card">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-video-camera" aria-hidden="true"></i></span>
        <h3 class="mt-3 font-heading font-bold">{{t "Produced, not recorded"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Every video goes through a real pipeline — outlined, scripted, recorded in a live org, then reviewed by working Salesforce pros before it ships."}}</p>
      </div>
      <div class="rounded-card border border-border bg-surface-raised p-6 shadow-card">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-lock-simple-open" aria-hidden="true"></i></span>
        <h3 class="mt-3 font-heading font-bold">{{t "Free first, Pro deeper"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Fundamentals are free for everyone. Member lessons need a free account, and a few advanced deep-dives support the platform as paid content."}}</p>
      </div>
      <div class="flex flex-col rounded-card border border-brand-500/40 bg-brand-500/5 p-6 shadow-card">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 text-white"><i class="ph-fill ph-pen-nib" aria-hidden="true"></i></span>
        <h3 class="mt-3 font-heading font-bold">{{t "Share your knowledge"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Worked with Salesforce for years? Turn what you know into a course — we help with structure, editing and publishing."}}</p>
        <a href="/become-author/" class="mt-4 inline-flex items-center gap-1.5 self-start text-sm font-bold text-brand-600 transition hover:gap-2.5 dark:text-brand-300">{{t "Become an author"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</section>

{{!-- ── TRAINING: scroll-drawn roadmap timeline ──────────────────────────────
     Left column stays pinned (sticky) while the timeline scrolls; the line
     fills and each stage lights up as it crosses the viewport centre. Stages
     come live from the actual #training tracks, start to finish. --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">

    {{!-- Left: pinned intro --}}
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-600 dark:text-brand-300">
        <i class="ph-fill ph-map-trifold" aria-hidden="true"></i>{{t "Guided training"}}
      </p>
      <h2 class="mt-2 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "Follow a roadmap, not a maze"}}</h2>
      <p class="mt-3 max-w-lg text-muted">{{t "Role-based tracks sequence the right courses, docs and projects in order — from your first org to job-ready. Scroll the path: it's the exact order we teach."}}</p>
      <ul class="mt-5 space-y-2.5 text-sm text-ink">
        <li class="flex items-start gap-2.5"><i class="ph-fill ph-check-circle mt-0.5 text-base text-brand-500" aria-hidden="true"></i>{{t "Every stage builds on the previous one"}}</li>
        <li class="flex items-start gap-2.5"><i class="ph-fill ph-check-circle mt-0.5 text-base text-brand-500" aria-hidden="true"></i>{{t "Milestones mapped to real certifications"}}</li>
        <li class="flex items-start gap-2.5"><i class="ph-fill ph-check-circle mt-0.5 text-base text-brand-500" aria-hidden="true"></i>{{t "Progress you can track lesson by lesson"}}</li>
      </ul>
      <a href="/training/" class="mt-7 inline-flex items-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">
        {{t "Start training"}}{{> "icons/arrow-right" class="h-4 w-4"}}
      </a>
    </div>

    {{!-- Right: node path — every track, in teaching order, on a curvy line --}}
    <div class="js-tl relative">
      {{!-- curved path (d is built by the script from the real node positions) --}}
      <svg class="js-tl-svg pointer-events-none absolute inset-0 h-full w-full" fill="none" aria-hidden="true" preserveAspectRatio="none">
        <path class="js-tl-path-base" d="" stroke="var(--color-border)" stroke-width="2" stroke-linecap="round"/>
        <path class="js-tl-path" d="" stroke="var(--color-brand-500)" stroke-width="2.5" stroke-linecap="round"/>
      </svg>

      {{#get "posts" filter="tag:hash-training" limit="12" order="published_at asc"}}
        {{#foreach posts}}
          <article class="js-tl-item relative pb-12 pl-16 last:pb-2">
            <span class="js-tl-dot absolute left-0 top-0 flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-border bg-surface text-lg text-muted transition-colors" aria-hidden="true">
              <i class="ph-fill {{#match primary_tag.slug "~" "admin"}}ph-shield-check{{else match primary_tag.slug "~" "developer"}}ph-code{{else match primary_tag.slug "~" "architect"}}ph-blueprint{{else}}ph-map-trifold{{/match}}" aria-hidden="true"></i>
            </span>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Stage"}} {{@number}}{{#if primary_tag}} · {{primary_tag.name}}{{/if}}</p>
            <h3 class="mt-1.5 font-heading text-lg font-bold leading-snug">
              <a href="{{url}}" class="transition hover:text-brand-600 dark:hover:text-brand-300">{{title}}</a>
            </h3>
            <p class="mt-1 line-clamp-2 text-sm text-muted">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="20"}}&hellip;{{/if}}</p>
            <div class="mt-2 flex items-center gap-4 text-xs text-muted">
              {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" limit="1"}}<span class="inline-flex items-center gap-1"><i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "modules"}}</span>{{/get}}
              <a href="{{url}}" class="inline-flex items-center gap-1 font-bold text-brand-600 transition hover:gap-2 dark:text-brand-300">{{t "Open track"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            </div>
          </article>
        {{else}}
          <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Roadmaps coming soon."}}</p>
        {{/foreach}}
      {{/get}}

      {{!-- end cap --}}
      <div class="js-tl-item relative pl-16">
        <span class="js-tl-dot absolute left-0 top-0 flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-border bg-surface text-lg text-muted transition-colors" aria-hidden="true"><i class="ph-fill ph-flag-checkered" aria-hidden="true"></i></span>
        <p class="pt-2 font-heading font-bold">{{t "Certified & job-ready"}}</p>
        <p class="mt-0.5 text-sm text-muted">{{t "That's the whole path — start at stage 1 and just keep going."}}</p>
      </div>
    </div>
  </div>
</section>

{{!-- Curvy path: built through the real node centres (alternating bulges),
     then revealed with the scroll — the stroke draws itself down the page and
     each stage lights up as the line reaches it. --}}
<script>
  (function () {
    var wrap = document.querySelector('.js-tl');
    if (!wrap) return;
    var svg = wrap.querySelector('.js-tl-svg');
    var pathA = wrap.querySelector('.js-tl-path');
    var pathB = wrap.querySelector('.js-tl-path-base');
    var items = Array.prototype.slice.call(wrap.querySelectorAll('.js-tl-item'));
    if (items.length < 2) return;
    var total = 0, ticking = false;

    function build() {
      var wr = wrap.getBoundingClientRect();
      svg.setAttribute('viewBox', '0 0 ' + wr.width + ' ' + wr.height);
      var pts = items.map(function (it) {
        var d = it.querySelector('.js-tl-dot').getBoundingClientRect();
        return { x: d.left - wr.left + d.width / 2, y: d.top - wr.top + d.height / 2 };
      });
      var d = 'M' + pts[0].x + ' ' + pts[0].y;
      for (var i = 1; i < pts.length; i++) {
        var a = pts[i - 1], b = pts[i];
        var bulge = i % 2 ? 110 : 45;   // alternate deep/shallow curves to the right
        d += ' C ' + (a.x + bulge) + ' ' + (a.y + (b.y - a.y) * 0.35) +
             ', ' + (b.x + bulge) + ' ' + (b.y - (b.y - a.y) * 0.35) +
             ', ' + b.x + ' ' + b.y;
      }
      pathA.setAttribute('d', d);
      pathB.setAttribute('d', d);
      total = pathA.getTotalLength();
      pathA.style.strokeDasharray = total;
      pathA.style.strokeDashoffset = total;
    }

    function update() {
      ticking = false;
      var rect = wrap.getBoundingClientRect();
      var p = Math.max(0, Math.min(1, (window.innerHeight * 0.55 - rect.top) / rect.height));
      pathA.style.strokeDashoffset = total * (1 - p);
      var lineY = p * rect.height;
      items.forEach(function (it) {
        it.classList.toggle('is-on', it.getBoundingClientRect().top - rect.top <= lineY + 4);
      });
    }

    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { build(); update(); });
    window.addEventListener('load', function () { build(); update(); });
    build(); update();
  })();
</script>

{{!-- ── LATEST BLOG ──────────────────────────────────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "From the blog"}}</h2>
        <p class="mt-2 text-muted">{{t "Tips, deep dives and updates from the Salesforce ecosystem."}}</p>
      </div>
      <a href="/blog/" class="inline-flex items-center gap-1 text-sm font-bold text-brand-600 hover:underline dark:text-brand-300">{{t "All posts"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
    </div>
    {{#get "posts" filter="tag:hash-blog" limit="6" include="tags,authors"}}
      {{#if posts}}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {{#foreach posts}}{{> post-card}}{{/foreach}}
        </div>
      {{else}}
        {{!-- No #blog-tagged posts yet → fall back to the latest articles that
             aren't course/training/docs content, so the section is never empty --}}
        {{#get "posts" filter="tag:-[hash-course,hash-lesson,hash-training,hash-training-content,documentation,hash-resource]" limit="6" include="tags,authors"}}
          {{#if posts}}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {{#foreach posts}}{{> post-card}}{{/foreach}}
            </div>
          {{else}}
            <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Blog posts coming soon."}}</p>
          {{/if}}
        {{/get}}
      {{/if}}
    {{/get}}
  </div>
</section>

