    <div class="ns-hero__yt-wrap">
      <iframe
        class="ns-hero__yt-iframe"
        src="https://www.youtube.com/embed/TUXh42V_ng4?autoplay=1&mute=1&loop=1"
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen
        title="Background reel"
        loading="lazy"
      ></iframe>
        </div>
    {{! Mobile & no-video fallback: site cover image }}
    {{#if @site.cover_image}}
      <div class="ns-hero__img-fallback" style="background-image:url('{{@site.cover_image}}');"></div>
    {{else}}
      <div class="ns-hero__img-fallback ns-hero__img-fallback--default"></div>
