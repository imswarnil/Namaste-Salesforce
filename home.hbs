{{!< default}}

<section class="hero is-medium" style="position: relative; overflow: hidden; min-height: 38rem;">
    <video
        autoplay
        muted
        loop
        playsinline
        poster="{{@site.cover_image}}"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
    >
        <source src="{{asset "images/hero-bg.mp4"}}" type="video/mp4">
    </video>

    <div
        style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(1, 118, 211, 0.88) 0%, rgba(3, 45, 96, 0.92) 60%, rgba(24, 24, 24, 0.75) 100%);"
    ></div>

    <div class="hero-body" style="position: relative; z-index: 1;">
        <div class="container is-fluid">
            <div class="columns is-vcentered is-variable is-8">
                <div class="column is-7-desktop is-8-widescreen">
                    <div class="tags mb-5">
                        <span class="tag is-warning is-light">
                            <span class="icon"><i class="ph ph-lightning"></i></span>
                            <span>Hands-on Salesforce learning platform</span>
                        </span>
                    </div>

                    <h1 class="title is-1 has-text-white mb-4" style="line-height: 1.1;">
                        {{@site.title}}
                    </h1>

                    <p class="subtitle is-4 has-text-white-bis mb-5" style="max-width: 46rem;">
                        {{#if @site.description}}
                            {{@site.description}}
                        {{else}}
                            Master Salesforce administration, development, analytics, and architecture with practical, real-world lessons.
                        {{/if}}
                    </p>

                    <div class="buttons are-medium mb-5" style="display: flex; gap: 0.75rem; flex-wrap: nowrap; overflow-x: auto;">
                        <a href="/courses/" class="button is-light">
                            <span class="icon"><i class="ph ph-book-open"></i></span>
                            <span>Explore Courses</span>
                        </a>


                        {{#if @site.members_enabled}}
                            <a href="#/portal/signup" data-portal="signup" class="button is-primary">
                                <span class="icon"><i class="ph ph-sparkle"></i></span>
                                <span>Join Now</span>
                            </a>
                        {{/if}}
                    </div>

                    <div class="level is-mobile" style="max-width: 40rem;">
                        <div class="level-item has-text-centered">
                            <div>
                                <p class="heading has-text-white-ter">Tracks</p>
                                <p class="title is-4 has-text-white">3+</p>
                            </div>
                        </div>
                        <div class="level-item has-text-centered">
                            <div>
                                <p class="heading has-text-white-ter">Courses</p>
                                <p class="title is-4 has-text-white">20+</p>
                            </div>
                        </div>
                        <div class="level-item has-text-centered">
                            <div>
                                <p class="heading has-text-white-ter">Guides</p>
                                <p class="title is-4 has-text-white">100+</p>
                            </div>
                        </div>
                        <div class="level-item has-text-centered">
                            <div>
                                <p class="heading has-text-white-ter">Community</p>
                                <p class="title is-4 has-text-white">Growing</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="column is-5-desktop is-4-widescreen">
                    <div class="box">
                        <article class="media">
                            <div class="media-left">
                                <span class="icon is-large has-text-warning">
                                    <i class="ph ph-certificate is-size-2"></i>
                                </span>
                            </div>
                            <div class="media-content">
                                <p class="heading">Featured learning path</p>
                                <p class="title is-5">Salesforce Developer Path</p>
                                <p class="subtitle is-6">LWC, Apex, SOQL, integrations, and real builds.</p>
                            </div>
                        </article>

                        <progress class="progress is-success mb-4" value="72" max="100">72%</progress>

                        <div class="content mb-4">
                            <ul>
                                <li>Beginner to advanced progression</li>
                                <li>Project-based lessons</li>
                                <li>Certification-oriented roadmap</li>
                            </ul>
                        </div>

                        <div class="buttons">
                            <a href="/courses/" class="button is-primary is-fullwidth">
                                <span class="icon"><i class="ph ph-arrow-right"></i></span>
                                <span>View Path</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container is-fluid">
        <div class="columns is-multiline is-variable is-4">
            <div class="column is-6-mobile is-3-desktop">
                <div class="box has-text-centered">
                    <span class="icon is-large has-text-link mb-3"><i class="ph ph-book-open-text is-size-3"></i></span>
                    <p class="heading">Structured Curriculum</p>
                    <p class="title is-5">Step-by-step learning</p>
                </div>
            </div>

            <div class="column is-6-mobile is-3-desktop">
                <div class="box has-text-centered">
                    <span class="icon is-large has-text-warning mb-3"><i class="ph ph-code is-size-3"></i></span>
                    <p class="heading">Hands-on Projects</p>
                    <p class="title is-5">Build while learning</p>
                </div>
            </div>

            <div class="column is-6-mobile is-3-desktop">
                <div class="box has-text-centered">
                    <span class="icon is-large has-text-primary mb-3"><i class="ph ph-exam is-size-3"></i></span>
                    <p class="heading">Certification Prep</p>
                    <p class="title is-5">Career-focused training</p>
                </div>
            </div>

            <div class="column is-6-mobile is-3-desktop">
                <div class="box has-text-centered">
                    <span class="icon is-large has-text-success mb-3"><i class="ph ph-users-three is-size-3"></i></span>
                    <p class="heading">Community Support</p>
                    <p class="title is-5">Learn together</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container is-fluid">
        <div class="has-text-centered mb-6">
            <h2 class="title is-2">Choose your career path</h2>
            <p class="subtitle is-5">Pick the Salesforce route that matches your goal.</p>
        </div>

        <div class="columns is-variable is-5">
            <div class="column is-4">
                <div class="card">
                    <div class="card-content has-text-centered">
                        <span class="icon is-large has-text-warning mb-4">
                            <i class="ph ph-gear-six is-size-1"></i>
                        </span>
                        <h3 class="title is-4">Salesforce Admin</h3>
                        <p class="content">Security, flows, reports, automation, setup, and day-to-day platform ownership.</p>
                    </div>
                    <footer class="card-footer">
                        <a href="/courses/" class="card-footer-item">View Admin Path</a>
                    </footer>
                </div>
            </div>

            <div class="column is-4">
                <div class="card">
                    <div class="card-content has-text-centered">
                        <span class="icon is-large has-text-link mb-4">
                            <i class="ph ph-code is-size-1"></i>
                        </span>
                        <h3 class="title is-4">Salesforce Developer</h3>
                        <p class="content">Apex, LWC, APIs, triggers, testing, packaging, and scalable custom app builds.</p>
                    </div>
                    <footer class="card-footer">
                        <a href="/courses/" class="card-footer-item">View Developer Path</a>
                    </footer>
                </div>
            </div>

            <div class="column is-4">
                <div class="card">
                    <div class="card-content has-text-centered">
                        <span class="icon is-large has-text-primary mb-4">
                            <i class="ph ph-tree-structure is-size-1"></i>
                        </span>
                        <h3 class="title is-4">Salesforce Architect</h3>
                        <p class="content">Solution design, integrations, data strategy, governance, and enterprise scale thinking.</p>
                    </div>
                    <footer class="card-footer">
                        <a href="/courses/" class="card-footer-item">View Architect Path</a>
                    </footer>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container is-fluid">
        <div class="level mb-6">
            <div class="level-left">
                <div class="level-item">
                    <div>
                        <h2 class="title is-2">Featured Courses</h2>
                        <p class="subtitle is-5">Practical courses built for real outcomes.</p>
                    </div>
                </div>
            </div>
            <div class="level-right is-hidden-mobile">
                <div class="level-item">
                    <a href="/courses/" class="button is-light">
                        <span>View All Courses</span>
                        <span class="icon"><i class="ph ph-arrow-right"></i></span>
                    </a>
                </div>
            </div>
        </div>

        {{#get "posts" filter="tag:hash-courses-col" limit="4" include="tags,authors"}}
            <div class="columns is-multiline is-variable is-5">
                {{#foreach posts}}
                    <div class="column is-12-mobile is-6-tablet is-3-desktop">
                        <article class="card is-fullheight">
                            {{#if feature_image}}
                                <div class="card-image">
                                    <figure class="image is-16by9">
                                        <a href="{{url}}">
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
                                        </a>
                                    </figure>
                                </div>
                            {{/if}}

                            <div class="card-content">
                                {{#if primary_tag}}
                                    <div class="mb-3">
                                        <a href="{{primary_tag.url}}" class="tag is-light">{{primary_tag.name}}</a>
                                    </div>
                                {{/if}}

                                <h3 class="title is-5">
                                    <a href="{{url}}">{{title}}</a>
                                </h3>

                                <p class="content">
                                    {{#if custom_excerpt}}
                                        {{custom_excerpt}}
                                    {{else}}
                                        {{excerpt words="18"}}
                                    {{/if}}
                                </p>

                                <p class="is-size-7 has-text-grey">
                                    {{#if primary_author}}{{primary_author.name}}{{else}}{{@site.title}}{{/if}} • {{reading_time}}
                                </p>
                            </div>

                            <footer class="card-footer">
                                <a href="{{url}}" class="card-footer-item">View Course</a>
                            </footer>
                        </article>
                    </div>
                {{else}}
                    <div class="column is-12">
                        <div class="notification is-light">
                            No courses found yet. Add posts tagged with <strong>#courses-col</strong>.
                        </div>
                    </div>
                {{/foreach}}
            </div>
        {{/get}}

        <div class="has-text-centered is-hidden-tablet mt-5">
            <a href="/courses/" class="button is-primary is-fullwidth">View All Courses</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container is-fluid">
        <div class="columns is-vcentered is-variable is-8">
            <div class="column is-6">
                <h2 class="title is-2 mb-5">Why learn with {{@site.title}}?</h2>

                <article class="media mb-5">
                    <div class="media-left">
                        <span class="icon is-large has-text-link">
                            <i class="ph ph-chalkboard-teacher is-size-3"></i>
                        </span>
                    </div>
                    <div class="media-content">
                        <h4 class="title is-5 mb-2">Expert-led guidance</h4>
                        <p>Learn from people who build in Salesforce, not just people who repeat docs with dramatic confidence.</p>
                    </div>
                </article>

                <article class="media mb-5">
                    <div class="media-left">
                        <span class="icon is-large has-text-warning">
                            <i class="ph ph-laptop is-size-3"></i>
                        </span>
                    </div>
                    <div class="media-content">
                        <h4 class="title is-5 mb-2">100% practical learning</h4>
                        <p>Every course is designed around implementation, exercises, and project-based outcomes.</p>
                    </div>
                </article>

                <article class="media">
                    <div class="media-left">
                        <span class="icon is-large has-text-primary">
                            <i class="ph ph-users-three is-size-3"></i>
                        </span>
                    </div>
                    <div class="media-content">
                        <h4 class="title is-5 mb-2">Community and momentum</h4>
                        <p>Stay consistent with a growing ecosystem of learners, builders, and future architects.</p>
                    </div>
                </article>
            </div>

            <div class="column is-6">
                <div class="columns is-multiline is-variable is-4">
                    <div class="column is-6">
                        <div class="box has-text-centered">
                            <span class="icon is-large has-text-link mb-3"><i class="ph ph-video-camera is-size-3"></i></span>
                            <p class="title is-5">Video Lessons</p>
                            <p class="is-size-7 has-text-grey">Clear walkthroughs and guided builds.</p>
                        </div>
                    </div>

                    <div class="column is-6">
                        <div class="box has-text-centered">
                            <span class="icon is-large has-text-success mb-3"><i class="ph ph-files is-size-3"></i></span>
                            <p class="title is-5">Docs & Notes</p>
                            <p class="is-size-7 has-text-grey">Supporting references and written guides.</p>
                        </div>
                    </div>

                    <div class="column is-6">
                        <div class="box has-text-centered">
                            <span class="icon is-large has-text-warning mb-3"><i class="ph ph-briefcase is-size-3"></i></span>
                            <p class="title is-5">Career Ready</p>
                            <p class="is-size-7 has-text-grey">Skills with portfolio and job value.</p>
                        </div>
                    </div>

                    <div class="column is-6">
                        <div class="box has-text-centered">
                            <span class="icon is-large has-text-primary mb-3"><i class="ph ph-lifebuoy is-size-3"></i></span>
                            <p class="title is-5">Supportive</p>
                            <p class="is-size-7 has-text-grey">Less confusion, more clarity.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container is-fluid">
        <div class="columns is-variable is-6">
            <div class="column is-8">
                <div class="level mb-5">
                    <div class="level-left">
                        <div class="level-item">
                            <div>
                                <h2 class="title is-2">Latest from the blog</h2>
                                <p class="subtitle is-5">Fresh tutorials, breakdowns, and explainers.</p>
                            </div>
                        </div>
                    </div>
                    <div class="level-right is-hidden-mobile">
                        <div class="level-item">
                            <a href="/blog/" class="button is-light">Visit Blog</a>
                        </div>
                    </div>
                </div>

                {{#get "posts" filter="tag:hash-blog-col" limit="3" include="tags,authors"}}
                    <div class="columns is-multiline is-variable is-5">
                        {{#foreach posts}}
                            <div class="column is-12-tablet is-4-desktop">
                                <article class="card is-fullheight">
                                    {{#if feature_image}}
                                        <div class="card-image">
                                            <figure class="image is-16by9">
                                                <a href="{{url}}">
                                                    <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
                                                </a>
                                            </figure>
                                        </div>
                                    {{/if}}

                                    <div class="card-content">
                                        {{#if primary_tag}}
                                            <div class="mb-3">
                                                <a href="{{primary_tag.url}}" class="tag is-light">{{primary_tag.name}}</a>
                                            </div>
                                        {{/if}}

                                        <h3 class="title is-5">
                                            <a href="{{url}}">{{title}}</a>
                                        </h3>

                                        <p class="content">
                                            {{#if custom_excerpt}}
                                                {{custom_excerpt}}
                                            {{else}}
                                                {{excerpt words="16"}}
                                            {{/if}}
                                        </p>

                                        <p class="is-size-7 has-text-grey">
                                            {{date format="DD MMM YYYY"}} • {{reading_time}}
                                        </p>
                                    </div>

                                    <footer class="card-footer">
                                        <a href="{{url}}" class="card-footer-item">Read Article</a>
                                    </footer>
                                </article>
                            </div>
                        {{else}}
                            <div class="column is-12">
                                <div class="notification is-light">No blog posts yet.</div>
                            </div>
                        {{/foreach}}
                    </div>
                {{/get}}

                <div class="has-text-centered is-hidden-tablet mt-5">
                    <a href="/blog/" class="button is-light is-fullwidth">Visit Blog</a>
                </div>
            </div>

            <div class="column is-4">
                <div class="box mb-5">
                    <h3 class="title is-4">Join the newsletter</h3>
                    <p class="content">Get Salesforce tips, updates, launches, and practical notes in your inbox.</p>

                    {{#if @site.members_enabled}}
                        <a href="#/portal/signup" data-portal="signup" class="button is-primary is-fullwidth mb-3">
                            <span class="icon"><i class="ph ph-envelope-simple"></i></span>
                            <span>Subscribe Free</span>
                        </a>

                        <a href="#/portal/signin" data-portal="signin" class="button is-light is-fullwidth">
                            Already a member? Sign in
                        </a>
                    {{else}}
                        <div class="notification is-light">
                            Enable Ghost Members to use newsletter signup here.
                        </div>
                    {{/if}}
                </div>

                <div class="box">
                    <h3 class="title is-5">Quick Links</h3>
                    <div class="content">
                        <ul>
                            <li><a href="/courses/">All Courses</a></li>
                            <li><a href="/docs/">Documentation</a></li>
                            <li><a href="/showcase/">Showcase</a></li>
                            <li><a href="/newsletter/">Newsletter</a></li>
                            <li><a href="/feed/">Updates Feed</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container is-fluid">
        <div class="has-text-centered mb-6">
            <h2 class="title is-2">What learners are here for</h2>
            <p class="subtitle is-5">Clear outcomes, practical execution, and less fluff.</p>
        </div>

        <div class="columns is-variable is-5">
            <div class="column is-4">
                <div class="box">
                    <article class="media">
                        <div class="media-left">
                            <span class="icon has-text-link"><i class="ph ph-target"></i></span>
                        </div>
                        <div class="media-content">
                            <p class="title is-5">Job-ready skills</p>
                            <p>Learn what helps in real implementations and interviews, not just keyword collecting.</p>
                        </div>
                    </article>
                </div>
            </div>

            <div class="column is-4">
                <div class="box">
                    <article class="media">
                        <div class="media-left">
                            <span class="icon has-text-warning"><i class="ph ph-stack"></i></span>
                        </div>
                        <div class="media-content">
                            <p class="title is-5">Layered progression</p>
                            <p>Move from beginner concepts to advanced builds with a path that actually makes sense.</p>
                        </div>
                    </article>
                </div>
            </div>

            <div class="column is-4">
                <div class="box">
                    <article class="media">
                        <div class="media-left">
                            <span class="icon has-text-primary"><i class="ph ph-rocket-launch"></i></span>
                        </div>
                        <div class="media-content">
                            <p class="title is-5">Momentum</p>
                            <p>Stay consistent with guided tracks, practical lessons, and meaningful next steps.</p>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="hero is-light">
    <div class="hero-body">
        <div class="container is-fluid">
            <div class="columns is-vcentered is-variable is-6">
                <div class="column is-8">
                    <h2 class="title is-2">Ready to build your Salesforce edge?</h2>
                    <p class="subtitle is-5">Start with courses, sharpen with docs, and stay current with the blog.</p>
                </div>

                <div class="column is-4">
                    <div class="buttons" style="display: flex; gap: 0.75rem; justify-content: flex-end; flex-wrap: wrap;">
                        <a href="/courses/" class="button is-primary">
                            <span class="icon"><i class="ph ph-book-open"></i></span>
                            <span>Start Learning</span>
                        </a>
                        <a href="/contact/" class="button is-light">
                            <span class="icon"><i class="ph ph-chat-circle-dots"></i></span>
                            <span>Contact</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>