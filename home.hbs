{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  home.hbs — Landing page.

  One design system across every section:
    · Backgrounds ALTERNATE surface ↔ surface-sunken so each block reads as its
      own band (never two of the same in a row).
    · Every section opens with the same eyebrow: an icon + uppercase brand label.
    · Section padding rhythm is uniform (py-16 sm:py-20 lg:py-24); the sponsor
      strip and hero are the only exceptions.
    · Headings: the Training flagship is text-3xl→4xl; every other section is
      text-2xl→3xl, so hierarchy is deliberate, not accidental.

  Order: Hero → Training (flagship) → Courses → Blog → Resources → Stats →
         Open source → Sponsor ad.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── HERO: copy + subscribe left · publication cover (with optional video) right ── --}}
<section class="relative overflow-hidden border-b border-border bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0"
       style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 52px 52px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%); mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%);"></div>

  <div class="relative mx-auto grid max-w-[85rem] items-center gap-10 px-4 py-14 sm:px-6 lg:min-h-[calc(100vh-3.6rem)] lg:grid-cols-[1.05fr_0.95fr] lg:py-16">

    {{!-- ── Left: copy + subscribe CTA ── --}}
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-semibold text-brand-600 dark:text-brand-300 shadow-card">
        {{> "icons/sparkle" class="h-4 w-4"}}{{t "Salesforce skills for the AI era"}}
      </span>

      <h1 class="mt-5 font-heading text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl xl:text-6xl">
        {{t "Become a"}} <span class="text-brand-600 dark:text-brand-400">{{t "Salesforce engineer"}}</span>
      </h1>

      <p class="mx-auto mt-5 max-w-md text-muted sm:text-lg lg:mx-0">
        {{t "Master Admin, Apex and LWC — then go further with Agentforce, Data Cloud and Einstein AI. Hands-on courses, training and docs, free and open source."}}
      </p>

      {{!-- CTA: one seamless pill — Ghost members subscribe form, portal fallback ── --}}
      <div class="mt-8">
        {{#if @site.members_enabled}}
          <form data-members-form="subscribe" class="mx-auto flex max-w-md overflow-hidden rounded-pill border border-border bg-surface-raised p-1 shadow-card transition focus-within:border-brand-500 focus-within:shadow-brand lg:mx-0">
            <input data-members-email type="email" required placeholder="{{t "you@email.com"}}" aria-label="{{t "Your email address"}}"
                   class="w-full min-w-0 border-0 bg-transparent px-4 py-2.5 text-ink placeholder:text-muted focus:outline-none">
            <button type="submit" class="shrink-0 inline-flex items-center justify-center gap-2 rounded-pill bg-brand-500 px-5 py-2.5 font-bold text-white transition hover:bg-brand-600">
              <i class="ph-fill ph-rocket-launch" aria-hidden="true"></i>{{t "Start free"}}
            </button>
          </form>
          <p data-members-success class="mt-3 text-sm font-semibold text-success hidden">{{t "Check your inbox to confirm! 🎉"}}</p>
          <p data-members-error class="mt-3 text-sm font-semibold text-error hidden">{{t "Please enter a valid email."}}</p>
        {{else}}
          <a href="#/portal/signup" data-portal="signup" class="inline-flex items-center justify-center gap-2 rounded-pill bg-brand-500 px-6 py-3.5 font-bold text-white shadow-brand transition hover:bg-brand-600"><i class="ph-fill ph-rocket-launch" aria-hidden="true"></i>{{t "Start learning free"}}</a>
        {{/if}}
        <p class="mt-3 text-xs text-muted">{{t "No credit card. One click to unsubscribe."}} <a href="/courses/" class="font-semibold text-brand-600 hover:underline dark:text-brand-300">{{t "or browse courses →"}}</a></p>
      </div>

      {{!-- reassurance --}}
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-semibold text-muted lg:justify-start">
        <span class="inline-flex items-center gap-1.5"><i class="ph-fill ph-check-circle text-success" aria-hidden="true"></i>{{t "Free forever"}}</span>
        <span class="inline-flex items-center gap-1.5"><i class="ph-fill ph-git-branch text-brand-500" aria-hidden="true"></i>{{t "Open source"}}</span>
        <span class="inline-flex items-center gap-1.5"><i class="ph-fill ph-seal-check text-brand-500" aria-hidden="true"></i>{{t "Certificates included"}}</span>
      </div>
    </div>

    {{!-- ── Right: the Ghost publication cover image (Admin → Settings →
         General → Publication identity), falling back to the logo/icon so the
         frame is never empty. A small play button opens @custom.hero_video_url
         in place, hiding the image. ── --}}
    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      <div class="pointer-events-none absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-border bg-surface-sunken shadow-raised"
           {{#if @custom.hero_video_url}}x-data="{ playing: false }"{{/if}}>
        {{!-- Branded fallback base layer — always present, so if the cover image
             is unset or its URL 404s the frame still reads as the publication. --}}
        <div class="absolute inset-0 flex items-center justify-center bg-surface-sunken p-12" {{#if @custom.hero_video_url}}x-show="!playing"{{/if}} aria-hidden="true">
          {{#if @site.logo}}
            <img src="{{img_url @site.logo size="l"}}" alt="" loading="eager" decoding="async" class="h-auto w-full max-w-[200px] object-contain opacity-90">
          {{else}}
            <img src="{{asset "logo/icon-512.png"}}" alt="" loading="eager" decoding="async" class="h-auto w-full max-w-[200px] object-contain opacity-90">
          {{/if}}
        </div>
        {{!-- The publication cover, laid over the fallback. onerror removes a
             broken image so the branded layer below shows through cleanly. --}}
        {{#if @site.cover_image}}
          <img src="{{img_url @site.cover_image size="xl"}}" alt="{{@site.title}}" onerror="this.remove()"
               {{#if @custom.hero_video_url}}x-show="!playing"{{/if}}
               loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover">
        {{/if}}
        {{#if @custom.hero_video_url}}
          <button type="button" @click="playing = true" x-show="!playing" aria-label="{{t "Play video"}}"
                  class="group absolute inset-0 flex items-center justify-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/95 shadow-brand transition group-hover:scale-110">
              <i class="ph-fill ph-play text-xl text-brand-600" aria-hidden="true"></i>
            </span>
          </button>
          <template x-if="playing">
            <iframe src="{{@custom.hero_video_url}}" title="{{@site.title}}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen loading="lazy" class="absolute inset-0 h-full w-full"></iframe>
          </template>
        {{/if}}
      </div>
    </div>
  </div>
</section>

{{!-- ── TRAINING OVERVIEW: pitch + stats + CTA left · a contained roadmap card
     right (view="overview"). Deliberately lighter than the full photo track on
     /training/. ── --}}
<section class="relative overflow-hidden border-b border-border bg-surface-sunken">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid text-brand-500/50"></div>

  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">

      {{!-- ── Left: the pitch ── --}}
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300"><i class="ph-fill ph-map-trifold" aria-hidden="true"></i>{{t "Guided training"}}</span>
        <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{{t "Follow a path, not a maze"}}</h2>
        <p class="mx-auto mt-4 max-w-md text-muted sm:text-lg lg:mx-0">{{t "One guided training, in order — from your first org to certified. Finish a section and the next unlocks."}}</p>

        <dl class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-4 lg:justify-start">
          {{#get "posts" filter="tag:hash-training-section" limit="1"}}
            <div class="text-center lg:text-left"><dd class="font-heading text-2xl font-extrabold text-brand-600 dark:text-brand-400">{{pagination.total}}</dd><dt class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-muted">{{t "sections"}}</dt></div>
          {{/get}}
          {{#get "posts" filter="tag:hash-training-content" limit="1"}}
            <div class="text-center lg:text-left"><dd class="font-heading text-2xl font-extrabold text-brand-600 dark:text-brand-400">{{pagination.total}}</dd><dt class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-muted">{{t "lessons"}}</dt></div>
          {{/get}}
          {{#get "posts" filter="tag:hash-training-content+visibility:public" limit="1"}}
            <div class="text-center lg:text-left"><dd class="font-heading text-2xl font-extrabold text-brand-600 dark:text-brand-400">{{pagination.total}}</dd><dt class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-muted">{{t "free to read"}}</dt></div>
          {{/get}}
        </dl>

        <div class="mt-8">
          <a href="/training/" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "See the full roadmap"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
        </div>
      </div>

      {{!-- ── Right: the roadmap card ── --}}
      <div class="rounded-card border border-border bg-surface-raised p-4 shadow-raised sm:p-5">
        <div class="mb-2 flex items-center justify-between px-1.5">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Your roadmap"}}</span>
          <span class="inline-flex items-center gap-1.5 rounded-pill bg-brand-500/10 px-2.5 py-1 text-[0.7rem] font-bold text-brand-600 dark:text-brand-300"><i class="ph-fill ph-seal-check" aria-hidden="true"></i>{{t "Cert-ready"}}</span>
        </div>
        <ol class="ns-plist">
          {{> "training/sections" view="overview"}}
        </ol>
      </div>

    </div>
  </div>
</section>

{{!-- ── FEATURED COURSES ─────────────────────────────────────────────────── --}}
<section class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300"><i class="ph-fill ph-graduation-cap" aria-hidden="true"></i>{{t "Courses"}}</span>
        <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "Featured courses"}}</h2>
        <p class="mt-2 text-muted">{{t "Hands-on, video-first, structured like a syllabus."}}</p>
      </div>
      <a href="/courses/" class="group inline-flex items-center gap-1.5 rounded-pill border border-border bg-surface px-4 py-2 text-sm font-bold text-brand-600 transition hover:border-brand-500 dark:text-brand-300">{{t "All courses"}}<i class="ph ph-arrow-right transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i></a>
    </div>
    {{#get "posts" filter="tag:hash-course" limit="3" include="tags,authors"}}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {{#foreach posts}}{{> "courses/course-card"}}{{/foreach}}
      </div>
    {{else}}
      <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Courses coming soon."}}</p>
    {{/get}}
  </div>
</section>

{{!-- ── LATEST BLOG ──────────────────────────────────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300"><i class="ph-fill ph-newspaper" aria-hidden="true"></i>{{t "Blog"}}</span>
        <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "From the blog"}}</h2>
        <p class="mt-2 text-muted">{{t "Tips, deep dives and updates from the Salesforce ecosystem."}}</p>
      </div>
      <a href="/blog/" class="group inline-flex items-center gap-1.5 rounded-pill border border-border bg-surface px-4 py-2 text-sm font-bold text-brand-600 transition hover:border-brand-500 dark:text-brand-300">{{t "All posts"}}<i class="ph ph-arrow-right transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i></a>
    </div>
    {{#get "posts" filter="tag:hash-blog" limit="6" include="tags,authors"}}
      {{#if posts}}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {{#foreach posts}}{{> post-card}}{{/foreach}}
        </div>
      {{else}}
        {{!-- No #blog-tagged posts yet → fall back to the latest articles that
             aren't course/training/docs content, so the section is never empty --}}
        {{#get "posts" filter="tag:-[hash-course,hash-lesson,hash-training,hash-training-content,documentation,hash-resource]" limit="6" include="tags,authors"}}
          {{#if posts}}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {{#foreach posts}}{{> post-card}}{{/foreach}}
            </div>
          {{else}}
            <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Blog posts coming soon."}}</p>
          {{/if}}
        {{/get}}
      {{/if}}
    {{/get}}
  </div>
</section>

{{!-- ── RESOURCES: pitch left · floating icon-card grid right ── --}}
<section class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">

      {{!-- ── Left: the pitch ── --}}
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300"><i class="ph-fill ph-toolbox" aria-hidden="true"></i>{{t "The toolbox"}}</span>
        <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "Books, tools and cheat sheets we actually use"}}</h2>
        <p class="mx-auto mt-4 max-w-md text-muted lg:mx-0">{{t "Hand-picked, not sponsored — every pick has earned its place in the library."}}</p>
        <div class="mt-7">
          <a href="/resources/" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "Browse the toolbox"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
        </div>
      </div>

      {{!-- ── Right: floating resource cards, icon-first, gently staggered ── --}}
      {{#get "posts" filter="tag:hash-resource" limit="4"}}
        {{#if posts}}
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5">
            {{#foreach posts}}
              <a href="{{url}}" class="group flex items-center gap-3.5 rounded-card border border-border bg-surface-raised p-4 shadow-card transition hover:-translate-y-1 hover:border-brand-500/40 hover:shadow-raised {{#match @number "2"}}sm:mt-8{{else match @number "4"}}sm:mt-8{{/match}}">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-2xl text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white dark:text-brand-300">
                  <i class="ph-fill {{#has tag="#resource-type-book"}}ph-book-bookmark{{else has tag="#resource-type-tool"}}ph-wrench{{else has tag="#resource-type-video"}}ph-video-camera{{else has tag="#resource-type-cheatsheet"}}ph-file-text{{else has tag="#resource-type-website"}}ph-globe{{else has tag="#resource-type-podcast"}}ph-microphone{{else has tag="#resource-type-repo"}}ph-git-fork{{else has tag="#resource-type-community"}}ph-users-three{{else}}ph-cube{{/has}}" aria-hidden="true"></i>
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-bold leading-snug transition group-hover:text-brand-600 dark:group-hover:text-brand-300">{{title}}</span>
                  <span class="mt-0.5 block text-[0.7rem] font-semibold uppercase tracking-wide text-muted">
                    {{#has tag="#resource-type-book"}}{{t "Book"}}{{else has tag="#resource-type-tool"}}{{t "Tool"}}{{else has tag="#resource-type-video"}}{{t "Video"}}{{else has tag="#resource-type-cheatsheet"}}{{t "Cheat sheet"}}{{else has tag="#resource-type-website"}}{{t "Website"}}{{else has tag="#resource-type-podcast"}}{{t "Podcast"}}{{else has tag="#resource-type-repo"}}{{t "Repo"}}{{else has tag="#resource-type-community"}}{{t "Community"}}{{else}}{{t "Resource"}}{{/has}}
                  </span>
                </span>
                <i class="ph ph-arrow-right ml-auto shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-brand-500" aria-hidden="true"></i>
              </a>
            {{/foreach}}
          </div>
        {{else}}
          <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Resources coming soon."}}</p>
        {{/if}}
      {{/get}}
    </div>
  </div>
</section>

{{!-- ── STATS: live counts of every collection ───────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mb-10 text-center">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-brand-600 dark:text-brand-300"><i class="ph-fill ph-chart-bar" aria-hidden="true"></i>{{t "The library"}}</span>
      <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "Everything we've published, counted live"}}</h2>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-6">
      {{#get "posts" filter="tag:hash-course" limit="1"}}
        <div class="js-reveal group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card transition hover:border-brand-500/40 hover:shadow-raised">
          <i class="ph-fill ph-graduation-cap pointer-events-none absolute -right-3 -top-3 text-5xl text-brand-500/[0.07] transition group-hover:text-brand-500/[0.12] sm:text-7xl" aria-hidden="true"></i>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-graduation-cap" aria-hidden="true"></i></span>
          <div class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-brand-600 dark:text-brand-400 sm:text-4xl lg:text-5xl"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Courses"}}</div>
        </div>
      {{/get}}
      {{#get "posts" filter="tag:hash-lesson" limit="1"}}
        <div class="js-reveal group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card transition hover:border-brand-500/40 hover:shadow-raised">
          <i class="ph-fill ph-play-circle pointer-events-none absolute -right-3 -top-3 text-5xl text-brand-500/[0.07] transition group-hover:text-brand-500/[0.12] sm:text-7xl" aria-hidden="true"></i>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-play-circle" aria-hidden="true"></i></span>
          <div class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-brand-600 dark:text-brand-400 sm:text-4xl lg:text-5xl"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Lessons"}}</div>
        </div>
      {{/get}}
      {{!-- Counts training LESSONS, not trainings: there is one training now,
           so "1" would be a pointless stat. --}}
      {{#get "posts" filter="tag:hash-training-content" limit="1"}}
        <div class="js-reveal group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card transition hover:border-brand-500/40 hover:shadow-raised">
          <i class="ph-fill ph-steps pointer-events-none absolute -right-3 -top-3 text-5xl text-brand-500/[0.07] transition group-hover:text-brand-500/[0.12] sm:text-7xl" aria-hidden="true"></i>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-steps" aria-hidden="true"></i></span>
          <div class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-brand-600 dark:text-brand-400 sm:text-4xl lg:text-5xl"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Training lessons"}}</div>
        </div>
      {{/get}}
      {{#get "posts" filter="tag:hash-training-section" limit="1"}}
        <div class="js-reveal group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card transition hover:border-brand-500/40 hover:shadow-raised">
          <i class="ph-fill ph-stack pointer-events-none absolute -right-3 -top-3 text-5xl text-brand-500/[0.07] transition group-hover:text-brand-500/[0.12] sm:text-7xl" aria-hidden="true"></i>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-stack" aria-hidden="true"></i></span>
          <div class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-brand-600 dark:text-brand-400 sm:text-4xl lg:text-5xl"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Sections"}}</div>
        </div>
      {{/get}}
      {{#get "posts" filter="tag:documentation" limit="1"}}
        <div class="js-reveal group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card transition hover:border-brand-500/40 hover:shadow-raised">
          <i class="ph-fill ph-book-open-text pointer-events-none absolute -right-3 -top-3 text-5xl text-brand-500/[0.07] transition group-hover:text-brand-500/[0.12] sm:text-7xl" aria-hidden="true"></i>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-book-open-text" aria-hidden="true"></i></span>
          <div class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-brand-600 dark:text-brand-400 sm:text-4xl lg:text-5xl"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Docs"}}</div>
        </div>
      {{/get}}
      {{#get "posts" filter="tag:hash-blog" limit="1"}}
        <div class="js-reveal group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 text-left shadow-card transition hover:border-brand-500/40 hover:shadow-raised">
          <i class="ph-fill ph-newspaper pointer-events-none absolute -right-3 -top-3 text-5xl text-brand-500/[0.07] transition group-hover:text-brand-500/[0.12] sm:text-7xl" aria-hidden="true"></i>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-300"><i class="ph-fill ph-newspaper" aria-hidden="true"></i></span>
          <div class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-brand-600 dark:text-brand-400 sm:text-4xl lg:text-5xl"><span class="js-count" data-to="{{pagination.total}}">0</span>+</div>
          <div class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-muted">{{t "Blog posts"}}</div>
        </div>
      {{/get}}
    </div>
  </div>
</section>

{{!-- ── OPEN SOURCE (grid-line background) ───────────────────────────────── --}}
<section class="relative overflow-hidden border-t border-border bg-surface">
