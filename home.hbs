{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  home.hbs — Landing page. Deliberately simple & plain-Tailwind: a light hero
  over a grid-line background pattern, a stats row, collection cards, featured
  courses, latest blog, and a CTA. No gradients/marquee/timeline.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── HERO (light, grid-line background) ───────────────────────────────── --}}
<section class="relative overflow-hidden border-b border-border bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0"
       style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 52px 52px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%); mask-image: radial-gradient(ellipse 70% 70% at 50% 30%, #000 30%, transparent 78%);"></div>

  <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:py-28">
    <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-semibold text-brand-600 dark:text-brand-300 shadow-card">
      {{> "icons/sparkle" class="h-4 w-4"}}{{t "Salesforce skills for the AI era"}}
    </span>

    <h1 class="mt-6 font-heading text-4xl font-extrabold leading-tight tracking-tight text-ink sm:text-6xl">
      {{t "The open LMS for"}}<br><span class="text-brand-600 dark:text-brand-400">{{t "next-gen Salesforce careers"}}</span>
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">
      {{t "Master Admin, Apex and LWC — then go further with Agentforce, Data Cloud and Einstein AI. Hands-on courses, roadmaps and docs, free and open source."}}
    </p>

    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="#/portal/signup" data-portal="signup" class="rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "Start learning free"}}</a>
      <a href="/courses/" class="rounded-pill border border-border bg-surface px-6 py-3 font-semibold text-ink transition hover:border-brand-500 hover:text-brand-600">{{t "Browse courses"}}</a>
    </div>

    {{!-- Stats --}}
    <div class="mx-auto mt-12 grid max-w-2xl grid-cols-2 gap-6 sm:grid-cols-4">
      {{#get "posts" filter="tag:hash-course" limit="1"}}<div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300">{{pagination.total}}+</div><div class="mt-1 text-sm text-muted">{{t "Courses"}}</div></div>{{/get}}
      {{#get "posts" filter="tag:hash-lesson" limit="1"}}<div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300">{{pagination.total}}+</div><div class="mt-1 text-sm text-muted">{{t "Lessons"}}</div></div>{{/get}}
      <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300">{{t "All"}}</div><div class="mt-1 text-sm text-muted">{{t "Levels"}}</div></div>
      <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300">{{t "Free"}}</div><div class="mt-1 text-sm text-muted">{{t "Forever"}}</div></div>
    </div>
  </div>
</section>

{{!-- ── COLLECTIONS ──────────────────────────────────────────────────────── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="mb-10 max-w-2xl">
    <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Everything in one place"}}</h2>
    <p class="mt-2 text-muted">{{t "Structured courses, guided roadmaps, deep docs and a developer blog — all free and open."}}</p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{> "home/collection-card" href="/courses/" icon="ph-graduation-cap" title="Courses" body="Project-based courses from Admin fundamentals to advanced development." cta="Browse courses"}}
    {{> "home/collection-card" href="/training/" icon="ph-map-trifold" title="Roadmaps" body="Step-by-step learning tracks that take you role by role." cta="View roadmaps"}}
    {{> "home/collection-card" href="/docs/" icon="ph-book-open-text" title="Documentation" body="Concise references and how-tos for every Salesforce concept." cta="Read the docs"}}
    {{> "home/collection-card" href="/blog/" icon="ph-newspaper" title="Dev Blog" body="Tips, deep dives and updates from the Salesforce ecosystem." cta="Read the blog"}}
  </div>
</section>

{{!-- ── FEATURED COURSES ─────────────────────────────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Popular courses"}}</h2>
      <a href="/courses/" class="inline-flex items-center gap-1 text-sm font-bold text-brand-600 hover:underline dark:text-brand-300">{{t "View all"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
    </div>
    {{#get "posts" filter="tag:hash-course" limit="3" include="tags,authors"}}
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {{#foreach posts}}{{> "courses/course-card"}}{{/foreach}}
      </div>
    {{else}}
      <p class="rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "Courses coming soon."}}</p>
    {{/get}}
  </div>
</section>

{{!-- ── LATEST BLOG ──────────────────────────────────────────────────────── --}}
{{#get "posts" filter="tag:hash-blog" limit="3" include="tags"}}
  {{#if posts}}
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "From the blog"}}</h2>
        <a href="/blog/" class="inline-flex items-center gap-1 text-sm font-bold text-brand-600 hover:underline dark:text-brand-300">{{t "All posts"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {{#foreach posts}}{{> post-card}}{{/foreach}}
      </div>
    </section>
  {{/if}}
{{/get}}

{{!-- ── CTA (grid-line background) ───────────────────────────────────────── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0"
         style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 40px 40px; opacity: .5; -webkit-mask-image: radial-gradient(ellipse 60% 80% at 50% 50%, #000 20%, transparent 75%); mask-image: radial-gradient(ellipse 60% 80% at 50% 50%, #000 20%, transparent 75%);"></div>
    <div class="relative mx-auto max-w-2xl px-4 py-16 text-center sm:px-6">
      <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Start your Salesforce journey today"}}</h2>
      <p class="mx-auto mt-3 max-w-lg text-muted">{{t "Free forever. No credit card. Join thousands of learners going from beginner to certified."}}</p>
      <a href="#/portal/signup" data-portal="signup" class="mt-6 inline-flex items-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "Create free account"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
    </div>
  </div>
</section>
