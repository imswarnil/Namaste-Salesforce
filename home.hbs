{{! ══════════════════════════════════════════════════════════════
    BLOG + SIDEBAR
══════════════════════════════════════════════════════════════ }}
<section class="section">
  <div class="container" style="max-width:1200px;">
    <div class="columns is-variable is-6 is-multiline">

      <div class="column is-12-mobile is-8-desktop">
        <div class="level mb-5">
          <div class="level-left">
            <div class="level-item">
              <div>
                <p class="ns-eyebrow">Blog</p>
                <h2 class="title is-2 mb-1">Latest from the blog.</h2>
                <p class="subtitle is-5">Tutorials, breakdowns, and explainers.</p>
              </div>
            </div>
          </div>
          <div class="level-right is-hidden-mobile">
            <div class="level-item">
              <a href="/blog/" class="button is-light">
                <span>Visit Blog</span>
                <span class="icon"><i class="ph ph-arrow-right"></i></span>
              </a>
            </div>
          </div>
        </div>

        {{#get "posts" filter="tag:hash-blog" limit="3" include="tags,authors"}}
          <div class="columns is-multiline is-variable is-5">
            {{#foreach posts}}
              <div class="column is-12-mobile is-6-tablet is-4-desktop">
                <article class="card is-fullheight ns-blog-card">
                  {{#if feature_image}}
                    <div class="card-image">
                      <figure class="image is-16by9">
                        <a href="{{url}}">
                          <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" width="600" height="338">
                        </a>
                      </figure>
                    </div>
                  {{/if}}
                  <div class="card-content">
                    {{#if primary_tag}}
                      <div class="mb-2">
                        <a href="{{primary_tag.url}}" class="tag is-light">{{primary_tag.name}}</a>
                      </div>
                    {{/if}}
                    <h3 class="title is-5 mb-2">
                      <a href="{{url}}" class="has-text-inherit">{{title}}</a>
                    </h3>
                    <p class="is-size-7 has-text-grey mb-2">
                      {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="14"}}{{/if}}
                    </p>
                    <p class="is-size-7 has-text-grey">
                      {{date format="DD MMM YYYY"}} &bull; {{reading_time}}
                    </p>
                  </div>
                  <footer class="card-footer">
                    <a href="{{url}}" class="card-footer-item">
                      Read Article <i class="ph ph-arrow-right"></i>
                    </a>
                  </footer>
                </article>
              </div>
            {{else}}
              <div class="column is-12">
                <div class="notification is-light">
                  No posts yet. Tag posts with <strong>#blog</strong> to show them here.
                </div>
              </div>
            {{/foreach}}
          </div>
        {{/get}}

        <div class="has-text-centered mt-5 is-hidden-tablet">
          <a href="/blog/" class="button is-light is-fullwidth">Visit Blog</a>
        </div>
      </div>

      <div class="column is-12-mobile is-4-desktop">
        <div class="ns-sidebar">

          {{#if @site.members_enabled}}
            <div class="ns-sidebar__box mb-4">
              <h3 class="title is-5 mb-2">
                <span class="icon is-small has-text-primary mr-1"><i class="ph ph-envelope-simple-fill"></i></span>
                Join the newsletter
              </h3>
              <p class="is-size-6 has-text-grey mb-4">
                Salesforce tips, course updates, and practical notes — in your inbox.
              </p>
              <a href="#/portal/signup" data-portal="signup" class="button is-primary is-fullwidth mb-2">
                <span class="icon"><i class="ph ph-sparkle"></i></span>
                <span>Subscribe Free</span>
              </a>
              <a href="#/portal/signin" data-portal="signin" class="button is-light is-fullwidth is-small">
                Already a member? Sign in
              </a>
            </div>
          {{/if}}

          <div class="ns-sidebar__box">
            <h3 class="title is-5 mb-3">
              <span class="icon is-small has-text-info mr-1"><i class="ph ph-compass-fill"></i></span>
              Explore
            </h3>
            <nav class="ns-quicklinks" aria-label="Quick navigation">
              <a href="/courses/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-graduation-cap"></i></span>
                <span>All Courses</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
              <a href="/training/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-chalkboard-teacher"></i></span>
                <span>Training</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
              <a href="/videos/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-video-camera"></i></span>
                <span>Videos</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
              <a href="/blog/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-newspaper"></i></span>
                <span>Blog</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
              <a href="/documentation/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-file-text"></i></span>
                <span>Documentation</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
              <a href="/tags/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-tag"></i></span>
                <span>Topics</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
              <a href="/contact/" class="ns-quicklinks__item">
                <span class="icon is-small"><i class="ph ph-chat-circle-dots"></i></span>
                <span>Contact</span>
                <span class="icon is-small ml-auto"><i class="ph ph-arrow-right"></i></span>
              </a>
            </nav>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

