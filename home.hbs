{{! ══════════════════════════════════════════════════════════════
    FEATURED COURSES
══════════════════════════════════════════════════════════════ }}
<section class="section">
  <div class="container" style="max-width:1200px;">

    <div class="level mb-6">
      <div class="level-left">
        <div class="level-item">
          <div>
            <p class="ns-eyebrow">Courses</p>
            <h2 class="title is-2 mb-1">Start building today.</h2>
            <p class="subtitle is-5">Practical courses designed for real outcomes.</p>
          </div>
        </div>
      </div>
      <div class="level-right is-hidden-mobile">
        <div class="level-item">
          <a href="/courses/" class="button is-light">
            <span>View All Courses</span>
            <span class="icon"><i class="ph ph-arrow-right"></i></span>
          </a>
        </div>
      </div>
    </div>

    {{#get "posts" filter="tag:hash-course" limit="4" include="tags,authors"}}
      <div class="columns is-multiline is-variable is-5">
        {{#foreach posts}}
          <div class="column is-12-mobile is-6-tablet is-3-desktop">
            <article class="card is-fullheight ns-course-card">
              {{#if feature_image}}
                <div class="card-image">
                  <figure class="image is-16by9">
                    <a href="{{url}}">
                      <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" width="600" height="338">
                    </a>
                  </figure>
                </div>
              {{/if}}
              <div class="card-content">
                {{#if primary_tag}}
                  <div class="mb-2">
                    <a href="{{primary_tag.url}}" class="tag is-info is-light">{{primary_tag.name}}</a>
                  </div>
                {{/if}}
                <h3 class="title is-5 mb-2">
                  <a href="{{url}}" class="has-text-inherit">{{title}}</a>
                </h3>
                <p class="is-size-7 has-text-grey">
                  {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="16"}}{{/if}}
                </p>
              </div>
              <div class="ns-course-card__footer">
                <span class="is-size-7 has-text-grey">
                  <span class="icon is-small"><i class="ph ph-clock"></i></span>
                  {{reading_time}}
                </span>
                <a href="{{url}}" class="ns-course-card__cta">
                  Open <i class="ph ph-arrow-right"></i>
                </a>
              </div>
            </article>
          </div>
        {{else}}
          <div class="column is-12">
            <div class="notification is-light">
              No courses yet. Tag posts with <strong>#course</strong> to display them here.
            </div>
          </div>
        {{/foreach}}
      </div>
    {{/get}}

    <div class="has-text-centered mt-5 is-hidden-tablet">
      <a href="/courses/" class="button is-info is-fullwidth">View All Courses</a>
    </div>

  </div>
</section>

