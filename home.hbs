                            <div class="mt-4">
                                <a href="{{url}}" class="has-text-dark has-text-weight-bold is-underlined">Read Post</a>
                            </div>
                        </div>
                    </div>
                {{/foreach}}
            {{else}}
                <div class="column is-12">
                    <div class="notification is-light">No blog posts found. Tag posts with <strong>#blog</strong>.</div>
                </div>
            {{/get}}
        </div>

        <div class="is-hidden-tablet has-text-centered mt-4">
            <a href="/blog/" class="button is-dark is-fullwidth has-text-weight-bold">View Blog</a>
        </div>
    </div>
</section>

