{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  training-section.hbs — the /training-sections/ COLLECTION INDEX.

  A section is a POST, and its page renders through post.hbs →
  partials/post-training-section.hbs. Ghost still requires the collection to
  have a path, and /training-sections/ is it — but the real entry point is
  /training/, so this shows the same path rather than 404ing or duplicating a
  listing nobody links to.
═══════════════════════════════════════════════════════════════════════════ --}}

<section class="ns-page">
  <div class="ns-page__inner">

    <nav class="ns-crumbs" aria-label="{{t "Breadcrumb"}}">
      <a class="ns-crumbs__link" href="/"><i class="ph ph-house" aria-hidden="true"></i><span>{{t "Home"}}</span></a>
      <i class="ns-crumbs__sep ph ph-caret-right" aria-hidden="true"></i>
      <a class="ns-crumbs__link" href="/training/"><i class="ph ph-flow-arrow" aria-hidden="true"></i>{{t "Training"}}</a>
      <i class="ns-crumbs__sep ph ph-caret-right" aria-hidden="true"></i>
      <span class="ns-crumbs__current"><span>{{t "All sections"}}</span></span>
    </nav>

    <div class="ns-page__head">
      <span class="ns-kicker">{{t "The path"}}</span>
      <h1 class="ns-page__title">{{t "Every section, in order"}}</h1>
      <p class="ns-page__lede">{{t "Each one assumes the last."}}</p>
    </div>

    <div class="ns-page__main">
      <div class="ns-track-list">
        {{> "training/sections" view="card"}}
      </div>
    </div>

  </div>
</section>
