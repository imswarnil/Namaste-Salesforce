{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  training-section.hbs — one training section at /training/{section}/.

  routes.yaml routes each section here with `data: tag.{slug}`, so {{#tag}} is
  the section tag: its name, description and feature_image are the section's.

  GOTCHA: {{#get}} repoints the context at its own result, so the tag's own
  fields ({{name}}, {{feature_image}}) must stay OUTSIDE any {{#get}} block —
  inside one they silently render empty. Each {{#get}} below is kept tight for
  that reason.
═══════════════════════════════════════════════════════════════════════════ --}}
{{#tag}}

  {{!-- ── Hero: copy left, the section's image right (when it has one) ── --}}
  <header class="relative overflow-hidden border-b border-border bg-surface">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid-corner text-brand-500/70"></div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12 lg:py-12">

      <div>
        <nav aria-label="{{t "Breadcrumb"}}" class="mb-4 flex flex-wrap items-center gap-1.5 text-sm text-muted">
          <a href="/" class="transition hover:text-brand-600 dark:hover:text-brand-300">{{t "Home"}}</a>
          <span aria-hidden="true">/</span>
          <a href="/training/" class="transition hover:text-brand-600 dark:hover:text-brand-300">{{t "Training"}}</a>
          <span aria-hidden="true">/</span>
          <span class="font-semibold text-ink">{{name}}</span>
        </nav>

        <p class="ns-kicker">{{t "Training section"}}</p>
        <h1 class="mt-2 font-heading text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{{name}}</h1>
        {{#if description}}
          <p class="mt-3 max-w-xl text-lg text-muted">{{description}}</p>
        {{/if}}

        {{!-- ── Overview stats ── --}}
        <dl class="mt-7 flex flex-wrap gap-x-10 gap-y-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{t "Lessons"}}</dt>
            <dd class="mt-0.5 font-heading text-2xl font-extrabold text-ink">
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}{{pagination.total}}{{/get}}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{t "Free to read"}}</dt>
            <dd class="mt-0.5 font-heading text-2xl font-extrabold text-ink">
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}{{pagination.total}}{{/get}}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{t "Start with"}}</dt>
            <dd class="mt-0.5">
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="1"}}
                {{#foreach posts}}
                  <a href="{{url}}" class="font-heading text-lg font-bold text-brand-600 transition hover:underline dark:text-brand-300">{{title}}</a>
                {{/foreach}}
              {{/get}}
            </dd>
          </div>
        </dl>
      </div>

      {{!-- the section's own image, when set --}}
      {{#if feature_image}}
        <div class="hidden lg:block">
          <img src="{{img_url feature_image size="m"}}" alt=""
               class="aspect-[4/3] w-full rounded-card border border-border object-cover shadow-card">
        </div>
      {{/if}}
    </div>
  </header>

  {{!-- ── Every lesson in this section, in order ── --}}
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-14">
    <h2 class="font-heading text-xl font-extrabold text-ink">{{t "What's in this section"}}</h2>

    {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50" as |lessons|}}
      <ol class="train-rail train-tl mt-6 space-y-2">
        {{#foreach lessons}}
          <li>
            <a href="{{url}}" class="group flex items-start gap-3 rounded-card border border-border bg-surface-raised p-4 transition hover:border-brand-300 hover:shadow-card">

              {{!-- the lesson's image when it has one, else its type glyph --}}
              {{#if feature_image}}
                <img src="{{img_url feature_image size="xs"}}" alt="" loading="lazy"
                     class="h-12 w-16 shrink-0 rounded-md border border-border object-cover">
              {{else}}
                <i class="mt-0.5 shrink-0 text-lg text-brand-500 {{#has tag="#training-type-video"}}ph-fill ph-video-camera{{else has tag="#training-type-exercise"}}ph-fill ph-barbell{{else has tag="#training-type-quiz"}}ph-fill ph-exam{{else}}ph-fill ph-file-text{{/has}}" aria-hidden="true"></i>
              {{/if}}

              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-2">
                  <span class="font-semibold text-ink transition group-hover:text-brand-600 dark:group-hover:text-brand-300">{{title}}</span>
                  {{^has visibility="public"}}
                    <i class="ph-fill ph-lock-simple shrink-0 text-sm text-muted" title="{{t "Members only"}}" aria-hidden="true"></i>
                  {{/has}}
                </span>
                {{#if custom_excerpt}}
                  <span class="mt-1 block text-sm text-muted">{{custom_excerpt}}</span>
                {{/if}}
                <span class="mt-1.5 block text-xs text-muted">{{reading_time}}</span>
              </span>

              <i class="ph ph-caret-right mt-1 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-brand-500" aria-hidden="true"></i>
            </a>
          </li>
        {{/foreach}}
      </ol>

      {{^lessons}}
        <p class="mt-6 rounded-card border border-dashed border-border py-12 text-center text-muted">{{t "No lessons in this section yet."}}</p>
      {{/lessons}}
    {{/get}}

    <p class="mt-8">
      <a href="/training/" class="ns-btn ns-btn--outline">
        <i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "All sections"}}
      </a>
    </p>
  </section>

{{/tag}}
