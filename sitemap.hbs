{{!< default}}

{{!-- /sitemap — the whole site as a TREE. The human twin of
/llms/ and /sitemap.xml: root node on top, one branch per
collection (its icon on the head), every entry a leaf on the
branch's rail. Connectors are pure CSS. Everything queried
live — nothing here is hand-maintained. --}}

<section class="changelog-hero outer">
    <div class="inner">
        <span class="kicker">{{> "icons/map-icon"}} {{t "Sitemap"}}</span>
        <h1>{{t "Everything on this site"}}</h1>
        <p>{{t "Built live from the content — if it exists, it hangs on this tree."}}</p>
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner">
        <div class="tree">

            <div class="tree-root" data-animate>
                <a class="tree-root-node" href="{{@site.url}}">
                    {{> "icons/home"}} {{@site.title}}
                </a>
            </div>

            <div class="tree-branches">

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <a href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Courses"}}</a>
                    </h2>
                    {{#get "posts" filter="tag:[hash-course-col,hash-courses-col]" order="published_at asc" limit="20" as |items|}}
                        <ul class="tree-leaves">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <a href="{{@site.url}}/training/">{{> "icons/layers"}} {{t "Training"}}</a>
                    </h2>
                    {{#get "posts" filter="tag:[hash-training-col,hash-docs-col]" order="published_at asc" limit="40" as |items|}}
                        <ul class="tree-leaves">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <a href="{{@site.url}}/videos/">{{> "icons/video"}} {{t "Videos"}}</a>
                    </h2>
                    {{#get "posts" filter="tag:hash-video-col" limit="20" as |items|}}
                        <ul class="tree-leaves is-video">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <a href="{{@site.url}}/blog/">{{> "icons/pen"}} {{t "Blog"}}</a>
                    </h2>
                    {{#get "posts" filter="tag:hash-blog-col" limit="20" as |items|}}
                        <ul class="tree-leaves">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <a href="{{@site.url}}/newsletter/">{{> "icons/newspaper"}} {{t "Newsletter"}}</a>
                    </h2>
                    {{#get "posts" filter="tag:hash-newsletter-col" limit="20" as |items|}}
                        <ul class="tree-leaves">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <a href="{{@site.url}}/changelog/">{{> "icons/history"}} {{t "Changelog"}}</a>
                    </h2>
                    {{#get "posts" filter="tag:[hash-changelog-col,hash-feed-col]" limit="20" as |items|}}
                        <ul class="tree-leaves">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <span>{{> "icons/file-text"}} {{t "Pages"}}</span>
                    </h2>
                    {{#get "pages" limit="24" order="title asc" as |items|}}
                        <ul class="tree-leaves">{{#foreach items}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}</ul>
                    {{/get}}
                </section>

                <section class="tree-branch">
                    <h2 class="tree-branch-head">
                        <span>{{> "icons/tag-icon"}} {{t "Topics"}}</span>
                    </h2>
                    {{#get "tags" filter="visibility:public" order="count.posts desc" include="count.posts" limit="24" as |topics|}}
                        <ul class="tree-leaves is-topics">
                            {{#foreach topics}}
                                <li>
                                    <a href="{{url}}">
                                        {{#if feature_image}}<img class="card-tag-icon" src="{{img_url feature_image size="xs"}}" alt="" loading="lazy" />{{/if}}
                                        {{name}} <small>{{count.posts}}</small>
                                    </a>
                                </li>
                            {{/foreach}}
                        </ul>
                    {{/get}}
                </section>

            </div>
        </div>
    </div>
</main>
