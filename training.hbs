{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  training.hbs — /training/ IS the single training.

  There is no #training post: routes.yaml routes /training/ straight here. If a
  Ghost PAGE with slug `training` exists, its title/excerpt win (the {{#page}}
  fork below) — otherwise the copy here is used.

  The page is: a two-column hero (copy + the stepwise artwork), then every
  section as a Netflix-style numbered card. Section ORDER lives in
  partials/training/sections.hbs — see that file for why.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── Hero: copy left, the climb right ── --}}
<header class="relative overflow-hidden border-b border-border bg-surface">
  {{!-- grid lines anchored to the art side, dissolving before they reach the
       reading column --}}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid-corner text-brand-500/70"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:gap-14 lg:py-16">

    <div class="text-center lg:text-left">
      <p class="ns-kicker justify-center lg:justify-start">{{t "Salesforce Training"}}</p>

      {{#page}}
        <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{{title}}</h1>
        <p class="mx-auto mt-3 max-w-md text-muted sm:text-lg lg:mx-0">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "One training, in order — from your first org to certified."}}{{/if}}</p>
      {{else}}
        <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{{t "Learn Salesforce, step by step."}}</h1>
        <p class="mx-auto mt-3 max-w-md text-muted sm:text-lg lg:mx-0">{{t "One training, in order. Start at absolute zero, finish job-ready — you always know what's next and how far in you are."}}</p>
      {{/page}}

      {{> "training/search"}}

      <dl class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 lg:justify-start">
        {{!-- Section count is literal because the section list is explicit
             (partials/training/sections.hbs) — there's no query that returns
             "training sections" now that their slugs are clean. Update both
             together. --}}
        <div>
          <dd class="font-heading text-2xl font-extrabold text-ink"><span class="js-count" data-to="5">0</span></dd>
          <dt class="text-sm text-muted">{{t "sections"}}</dt>
        </div>
        {{#get "posts" filter="tag:hash-training-content" limit="1"}}
          <div>
            <dd class="font-heading text-2xl font-extrabold text-ink"><span class="js-count" data-to="{{pagination.total}}">0</span></dd>
            <dt class="text-sm text-muted">{{t "lessons"}}</dt>
          </div>
        {{/get}}
        {{#get "posts" filter="tag:hash-training-content+visibility:public" limit="1"}}
          <div>
            <dd class="font-heading text-2xl font-extrabold text-ink"><span class="js-count" data-to="{{pagination.total}}">0</span></dd>
            <dt class="text-sm text-muted">{{t "free to read"}}</dt>
          </div>
        {{/get}}
      </dl>
    </div>

    <div class="flex justify-center lg:justify-end">
      {{> "training/hero-steps"}}
    </div>
  </div>
</header>

{{!-- ── Every section, in order ── --}}
<section id="sections" class="mx-auto max-w-[85rem] scroll-mt-20 px-4 py-14 sm:px-6 lg:py-16">
  <div class="mb-10 max-w-2xl">
    <h2 class="font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "The path"}}</h2>
    <p class="mt-2 text-muted">{{t "Five sections, in order. Each one assumes the last — start at the top and work down."}}</p>
  </div>

  {{!-- generous row-gap: the step numbers hang below each card --}}
  <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {{> "training/sections" view="card"}}
  </div>

  {{!-- Request a topic --}}
  <div class="mt-16 flex flex-col items-center justify-between gap-4 rounded-card border border-border bg-surface-sunken p-6 sm:flex-row sm:p-8">
    <div>
      <h2 class="font-heading text-xl font-bold text-ink">{{t "Looking for a specific topic?"}}</h2>
      <p class="mt-1 text-muted">{{t "New lessons are added every month. Tell us what to build next."}}</p>
    </div>
    <a href="/contact/" class="inline-flex shrink-0 items-center gap-2 rounded-pill bg-brand-500 px-5 py-2.5 font-bold text-white shadow-brand transition hover:bg-brand-600">{{> "icons/mail" class="h-5 w-5"}}{{t "Request a topic"}}</a>
  </div>
</section>
