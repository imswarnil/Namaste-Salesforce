{{!< default}}
{{!-- The index of training SECTIONS, on NSDS's training-index.html.

     ── Three levels of navigation across two levels of URL ────────────────
         /training/                  this page — every section
         /training/{section}/        the section, listing its posts
         /training/{section}/{post}/ a post

     abstract/18 is explicit that a Ghost permalink gets exactly one
     {primary_tag} placeholder, so there is no third URL level. This page is
     the third level of NAVIGATION without being one of URL — which is why it
     is a collection root rather than a tag.

     Section ORDER is published_at asc; backdate a section post to move it
     earlier. That is what makes the numerals on these cards mean something. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <p class="ns-kicker">{{t "Training"}}</p>
            {{#page}}
                <h1 class="ns-band__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
            {{else}}
                <h1 class="ns-band__title">{{t "Training"}}</h1>
                <p class="ns-band__lede">{{t "A guided path, in order. Each section builds on the one before it."}}</p>
            {{/page}}
        </div>
    </div>
</section>

<section class="ns-band">
    <div class="ns-band__inner">
        {{#if posts}}
            <div class="ns-grid">{{#foreach posts}}{{> "cards/track-card" index=@number}}{{/foreach}}</div>
        {{else}}
            <p class="ns-empty">{{t "No training sections yet."}}</p>
        {{/if}}
        {{pagination}}
    </div>
</section>
