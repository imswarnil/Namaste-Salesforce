{{!< default}}
{{!-- =========================================================================
  training.hbs  ·  /training/  (collection index)

  CONTEXT:
    data: page.training  → Ghost page slug "training" supplies hero copy
    {{posts}}            → paginated #training posts (published_at asc)
    {{pagination}}       → Ghost pagination object

  PURPOSE:
    Lists every training post as a card.
    Each training post is an overview page for one structured course.
    Individual training posts → post.hbs → post-training partial (hero + modules).
    Training content posts   → post.hbs → post-training-content partial (reader).
========================================================================== --}}

{{!-- ── HERO ──────────────────────────────────────────────────────────────── --}}
<section class="tr-index-hero">
  <div class="container">
    <div class="tr-index-hero__inner">
      <span class="tr-index-hero__eyebrow">
        <i class="ph ph-graduation-cap" aria-hidden="true"></i>
        Salesforce Training
      </span>
      <h1 class="tr-index-hero__title">
        {{#if title}}{{title}}{{else}}All Training Courses{{/if}}
      </h1>
      <p class="tr-index-hero__lead">
        {{#if custom_excerpt}}
          {{custom_excerpt}}
        {{else}}
          Structured, step-by-step training paths for every Salesforce role.
          Free to access — built by practitioners, not marketers.
        {{/if}}
      </p>
      <div class="tr-index-hero__ctas">
        <button class="button is-white is-medium tr-index-hero__search"
                type="button" data-ghost-search>
          <span class="icon is-small">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </span>
          <span>Search training…</span>
        </button>
        <a href="/courses/" class="button is-medium tr-index-hero__courses-link">
          <span class="icon is-small">
            <i class="ph ph-book-open" aria-hidden="true"></i>
          </span>
          <span>Browse courses instead</span>
        </a>
      </div>
    </div>
  </div>
</section>

{{!-- ── FILTER PILLS (static) ─────────────────────────────────────────────── --}}
<div class="tr-index-filters">
  <div class="container">
    <div class="tr-index-filters__inner">
      <span class="tr-index-filters__label">Filter:</span>
      <div class="tr-index-filters__tabs" role="tablist">
        <button class="tr-index-filters__tab is-active" role="tab"
                aria-selected="true" data-filter="all">All levels</button>
        <button class="tr-index-filters__tab" role="tab"
                data-filter="beginner">Beginner</button>
        <button class="tr-index-filters__tab" role="tab"
                data-filter="intermediate">Intermediate</button>
        <button class="tr-index-filters__tab" role="tab"
                data-filter="advanced">Advanced</button>
      </div>
    </div>
  </div>
</div>

{{!-- ── TRAINING CARDS ──────────────────────────────────────────────────────── --}}
<section class="tr-index-body">
  <div class="container">

    {{#if posts}}
      <div class="columns is-multiline tr-card-grid">
        {{#foreach posts}}
          <div class="column is-12-mobile is-6-tablet is-4-desktop">
            <a href="{{url}}" class="tr-card">

              {{!-- Cover / thumbnail --}}
              <div class="tr-card__cover">
                {{#if feature_image}}
                  <img src="{{img_url feature_image size="m"}}"
                       alt="{{title}}" loading="lazy">
                {{else}}
                  <div class="tr-card__cover-placeholder" aria-hidden="true">
                    <i class="ph ph-chalkboard-teacher"></i>
                  </div>
                {{/if}}
                {{!-- Level badge from internal tags --}}
                {{#foreach tags visibility="internal"}}
                  {{#match slug "~^" "hash-training-level-"}}
                    {{#if description}}
                      <span class="tr-card__level-badge">{{description}}</span>
                    {{/if}}
                  {{/match}}
                {{/foreach}}
              </div>

              {{!-- Card body --}}
              <div class="tr-card__body">

                {{!-- Category label --}}
                {{#if primary_tag}}
                  <span class="tr-card__category">{{primary_tag.name}}</span>
                {{/if}}

                <h2 class="tr-card__title">{{title}}</h2>

                {{#if custom_excerpt}}
                  <p class="tr-card__excerpt">{{custom_excerpt}}</p>
                {{else}}
                  <p class="tr-card__excerpt">{{excerpt words="18"}}…</p>
                {{/if}}

                {{!-- Meta row --}}
                <div class="tr-card__meta">
                  {{!-- Module count --}}
                  <span class="tr-card__meta-item">
                    <i class="ph ph-stack" aria-hidden="true"></i>
                    {{#get "posts"
                      filter="tag:hash-training-content+primary_tag:{{slug}}"
                      limit="1"
                    }}
                      <span id="tc-{{../slug}}">Modules</span>
                    {{/get}}
                  </span>

                  {{!-- Duration from internal tag --}}
                  {{#foreach tags visibility="internal"}}
                    {{#match slug "~^" "hash-training-duration-"}}
                      {{#if description}}
                        <span class="tr-card__meta-item">
                          <i class="ph ph-clock" aria-hidden="true"></i>
                          {{description}}
                        </span>
                      {{/if}}
                    {{/match}}
                  {{/foreach}}
                </div>

              </div>

              {{!-- Card footer --}}
              <div class="tr-card__footer">
                {{#primary_author}}
                  <div class="tr-card__author">
                    {{#if profile_image}}
                      <img src="{{img_url profile_image size="xxs"}}"
                           alt="{{name}}" loading="lazy"
                           class="tr-card__author-img">
                    {{else}}
                      <span class="tr-card__author-placeholder">
                        <i class="ph ph-user-circle" aria-hidden="true"></i>
                      </span>
                    {{/if}}
                    <span class="tr-card__author-name">{{name}}</span>
                  </div>
                {{/primary_author}}
                <span class="tr-card__cta">
                  Start
                  <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </span>
              </div>

            </a>
          </div>
        {{/foreach}}
      </div>

      {{!-- Pagination --}}
      {{#if pagination.pages}}
        {{pagination}}
      {{/if}}

    {{else}}
      <div class="tr-index-empty">
        <i class="ph ph-books tr-index-empty__icon" aria-hidden="true"></i>
        <p class="tr-index-empty__title">No training courses yet</p>
        <p class="tr-index-empty__body">
          Create a post with the <code>#training</code> internal tag to
          create a training course.
        </p>
      </div>
    {{/if}}

  </div>
</section>

{{!-- ── CONTRIBUTE BAND ─────────────────────────────────────────────────────── --}}
<section class="tr-contribute">
  <div class="container">
    <div class="tr-contribute__inner">
      <div class="tr-contribute__icon" aria-hidden="true">
        <i class="ph ph-chalkboard-teacher"></i>
      </div>
      <div class="tr-contribute__text">
        <h2 class="tr-contribute__title">
          Want to create a training course?
        </h2>
        <p class="tr-contribute__lead">
          If you have real Salesforce project experience, we'd love to
          feature your training on this platform. All contributors get
          credited and the course is free for the community.
        </p>
      </div>
      <div class="tr-contribute__actions">
        <a href="/contact/?ref=training-author"
           class="button is-primary is-medium">
          <span class="icon is-small">
            <i class="ph ph-pencil-line" aria-hidden="true"></i>
          </span>
          <span>Become an instructor</span>
        </a>
      </div>
    </div>
  </div>
</section>
