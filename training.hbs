{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  training.hbs — /training/ IS the single training.

  There is no #training post: routes.yaml routes /training/ straight here. If a
  Ghost PAGE with slug `training` exists, its title/excerpt win (the {{#page}}
  fork below) — otherwise the copy here is used.

  Built from components — see /styleguide/training-overview.html:

    .ns-hero--split      the pitch, live counts, and the trail artwork
    .ns-card             "where you are", with the resume action
    .ns-track-list       every section as a stop on ONE connected rail
    .ns-cta-band         the closing ask

  Why a rail and not a grid: a catalogue is a set of choices, so a grid is
  right there. A training is a SEQUENCE — the reader needs to see that section
  3 comes after section 2, and a grid actively hides that.

  Section ORDER lives in partials/training/sections.hbs (published_at asc).
═══════════════════════════════════════════════════════════════════════════ --}}

{{> "jsonld/training/index"}}

{{!-- ── Hero ─────────────────────────────────────────────────────────────────
     No overflow-hidden anywhere above the search: it would clip the results
     dropdown out of existence. The pattern layer is the --grid variant, which
     is inset and masked, so it cannot overflow either. --}}
<header class="ns-hero ns-hero--split ns-hero--plain ns-hero--grid ns-hero--sm">
  <div class="ns-hero__inner">

    <div>

      <span class="ns-kicker">{{t "Salesforce Training"}}</span>

      {{#page}}
        <h1 class="ns-hero__title">{{title}}</h1>
        <p class="ns-hero__sub">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "One training, in order — from your first org to certified."}}{{/if}}</p>
      {{else}}
        <h1 class="ns-hero__title">{{t "From zero to Salesforce Engineer."}}</h1>
        <p class="ns-hero__sub">{{t "One training, in order — no guessing what to learn next. Start with what Salesforce even is, finish able to build, automate and secure a real org."}}</p>
      {{/page}}

      {{!-- Two actions, no search. The rail on every section and lesson page
           carries a search of its own, so a second one in the hero was a
           control for something the reader has not started yet. --}}
      <div class="ns-hero__actions">
        <div class="ns-cluster">
          {{!-- "Start learning" = the first lesson of the first section. Both
               hops are derived, so no section slug is hardcoded — reordering or
               replacing the opening section just works. --}}
          {{#get "posts" filter="tag:hash-training-section" order="published_at asc" limit="1"}}
            {{#foreach posts}}
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="1"}}
                {{#foreach posts}}
                  <a href="{{url}}" class="ns-btn ns-btn--primary">
                    {{> icons name="play"}}{{t "Start learning"}}
                  </a>
                {{/foreach}}
              {{/get}}
            {{/foreach}}
          {{/get}}

          <a href="#sections" class="ns-btn ns-btn--outline">{{t "See the path"}}</a>
        </div>
      </div>

      {{!-- What you get, as a readout rather than a paragraph. --}}
      <div class="ns-hero__meta">
        {{#get "posts" filter="tag:hash-training-section" limit="1"}}
          <div class="ns-stat ns-stat--sm"><span class="ns-stat__value">{{pagination.total}}</span><span class="ns-stat__label">{{t "sections"}}</span></div>
        {{/get}}
        {{#get "posts" filter="tag:hash-training-content" limit="1"}}
          <div class="ns-stat ns-stat--sm"><span class="ns-stat__value">{{pagination.total}}</span><span class="ns-stat__label">{{t "lessons"}}</span></div>
        {{/get}}
        <div class="ns-stat ns-stat--sm"><span class="ns-stat__value">∞</span><span class="ns-stat__label">{{t "self-paced"}}</span></div>
      </div>
    </div>

    {{!-- The media slot shows the FIRST SECTION — what you actually start
         with, with its lessons. It replaced a decorative trail SVG that read
         as a faint dotted line and left this half of the hero empty; showing
         the real first step is both more useful and more honest. --}}
    {{#get "posts" filter="tag:hash-training-section" order="published_at asc" limit="1"}}
      {{#foreach posts}}
        <div class="ns-hero__media ns-brandmark-stack">
          <div class="ns-brandmark-stack__mark" aria-hidden="true">{{> "training/hero-mark"}}</div>
          <article class="ns-card ns-card--interactive ns-card--contour">
            <div class="ns-card__header">
              <div>
                <span class="ns-card__meta">{{t "Start here"}}</span>
                <h2 class="ns-card__title mt-1"><a href="{{url}}" class="ns-card__link">{{title}}</a></h2>
              </div>
              <span class="ns-chip ns-chip--sm">
                {{#if primary_tag.feature_image}}
                  <img src="{{img_url primary_tag.feature_image size="xs"}}" alt="" loading="lazy" class="h-full w-full rounded-[inherit] object-cover">
                {{else}}{{> icons name="stack"}}{{/if}}
              </span>
            </div>

            {{#if custom_excerpt}}
              <p class="ns-clamp-2 mt-2 text-sm text-muted">{{custom_excerpt}}</p>
            {{/if}}

            {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="3"}}
              {{#if posts}}
                <ul class="ns-list ns-list--num ns-list--sm ns-list--divided mt-3">
                  {{#foreach posts}}
                    <li class="ns-list__item">
                      <span class="ns-truncate">{{title}}</span>
                      <span class="ns-list__meta">{{reading_time minute="1m" minutes="%m"}}</span>
                    </li>
                  {{/foreach}}
                </ul>
              {{/if}}
            {{/get}}

            <div class="ns-card__footer">
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
                <span class="ns-card__meta">{{pagination.total}} {{t "lessons"}}</span>
              {{/get}}
              <span class="ns-btn ns-btn--outline ns-btn--xs">
                {{t "Open section"}}{{> icons name="arrow-right" class="ns-btn__icon"}}
              </span>
            </div>
          </article>
        </div>
      {{/foreach}}
    {{/get}}
  </div>
</header>

{{!-- ── The path — every section, in order ────────────────────────────────
     Two columns from lg: the path on the left, a sticky rail on the right
     carrying progress, a jump list and the asks. Before this the track sat in
     a narrow centred column with the whole right-hand side empty. --}}
<section id="sections" class="ns-band ns-band--sunken ns-anchor">
  <div class="ns-band__inner">

    <div class="ns-section-head">
      <div>
        <span class="ns-kicker">{{> icons name="map-trifold"}}{{t "The path"}}</span>
        <h2 class="ns-section-head__title">{{t "Every section, in order"}}</h2>
        <p class="ns-section-head__sub">{{t "Each one assumes the last — follow the rail from the top."}}</p>
      </div>
      {{#get "posts" filter="tag:hash-training-section" order="published_at asc" limit="1"}}
        {{#foreach posts}}
          <a href="{{url}}" class="ns-btn ns-btn--outline ns-btn--sm ns-section-head__action">
            {{t "Start at the top"}}{{> icons name="arrow-right" class="ns-btn__icon ns-btn__icon--nudge"}}
          </a>
        {{/foreach}}
      {{/get}}
    </div>

    <div class="ns-shell ns-shell--rail">

      {{!-- ── The path itself ── --}}
      <div class="ns-track-list">
        {{> "training/sections" view="card"}}
      </div>

      {{!-- ── The rail: where you are, where to jump, and the asks. Sticky from
           lg, so it stays with you as the path scrolls. ── --}}
      <aside class="ns-shell__aside">

        <div class="ns-widget ns-widget--stats">
          <div class="ns-widget__head"><span class="ns-widget__title">{{t "This training"}}</span></div>
          <div class="ns-widget__body">
            {{#get "posts" filter="tag:hash-training-section" limit="1"}}
              <div class="ns-widget__row"><span>{{t "Sections"}}</span><span class="ns-widget__num">{{pagination.total}}</span></div>
            {{/get}}
            {{#get "posts" filter="tag:hash-training-content" limit="1"}}
              <div class="ns-widget__row"><span>{{t "Lessons"}}</span><span class="ns-widget__num">{{pagination.total}}</span></div>
            {{/get}}
          </div>
        </div>

        {{!-- Jump straight to a section — the same rail language as the reader. --}}
        <div class="ns-widget ns-widget--toc">
          <div class="ns-widget__head"><span class="ns-widget__title">{{t "Jump to"}}</span></div>
          <div class="ns-widget__body">
            {{#get "posts" filter="tag:hash-training-section" order="published_at asc" limit="50"}}
              {{#foreach posts}}
                <a class="nav-link nav-link--block nav-link--sm" href="{{url}}">
                  <span class="ns-index text-label">{{@number}}</span>
                  <span class="ns-truncate">{{title}}</span>
                  {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
                    <span class="nav-link__meta">{{pagination.total}}</span>
                  {{/get}}
                </a>
              {{/foreach}}
            {{/get}}
          </div>
        </div>

        {{!-- The ask, at the end of the path. --}}
        <div class="ns-widget ns-widget--newsletter ns-widget--brand">
          <div class="ns-widget__head">
            <span class="ns-widget__title">{{> icons name="mail"}}{{t "New lessons"}}</span>
          </div>
          <div class="ns-widget__body">
            <p>{{t "Sections land regularly. Get the next one in your inbox."}}</p>
            {{> "members/subscribe" layout="stacked" cta=(t "Notify me")}}
          </div>
        </div>

        <div class="ns-widget ns-widget--cta ns-widget--sunken">
          <div class="ns-widget__head"><span class="ns-widget__title">{{t "Missing something?"}}</span></div>
          <div class="ns-widget__body">
            <p>{{t "Tell us what to build next."}}</p>
            <a href="/contact/" class="ns-btn ns-btn--outline ns-btn--sm">
              {{> icons name="mail" class="h-4 w-4"}}{{t "Request a topic"}}
            </a>
          </div>
        </div>

      </aside>
    </div>

  </div>
</section>
