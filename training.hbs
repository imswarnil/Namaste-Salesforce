{{!< default}}

<section class="section">
  <div class="container is-max-desktop">

    {{#page}}
      <div class="box mb-5">
        <div class="columns is-vcentered is-variable is-5">
          {{#if feature_image}}
            <div class="column is-12-mobile is-5-tablet">
              <figure class="image is-4by3">
                <img src="{{img_url feature_image size="l"}}" alt="{{title}}">
              </figure>
            </div>
          {{/if}}

          <div class="column">
            <span class="tag is-link is-light mb-3">Training</span>
            <h1 class="title is-3 mb-3">{{title}}</h1>

            <div class="content">
              {{content}}
            </div>
          </div>
        </div>
      </div>
    {{/page}}

    {{#if posts}}
      <div class="columns is-multiline is-variable is-5">
        {{#foreach posts}}
          <div class="column is-12-mobile is-6-tablet is-4-desktop">
            {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="100" order="published_at asc" as |module_lessons|}}
              <article class="card">
                {{#if feature_image}}
                  <div class="card-image">
                    <a href="{{url}}">
                      <figure class="image is-16by9">
                        <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
                      </figure>
                    </a>
                  </div>
                {{/if}}

                <div class="card-content">
                  <div class="mb-3">
                    <span class="tag is-light mr-2">Training Module</span>
                    <span class="tag is-success is-light">
                      {{module_lessons.length}} Lessons
                    </span>
                  </div>

                  <h2 class="title is-5 mb-2">
                    <a href="{{url}}">{{title}}</a>
                  </h2>

                  {{#if custom_excerpt}}
                    <p class="has-text-grey mb-4">{{custom_excerpt}}</p>
                  {{else}}
                    <p class="has-text-grey mb-4">{{excerpt words="22"}}</p>
                  {{/if}}

                  <div class="content mb-4">
                    {{#if module_lessons.[0]}}
                      <p class="is-size-7 has-text-grey mb-2">Starts with:</p>
                      {{#foreach module_lessons limit="1"}}
                        <p class="mb-0">
                          <span class="icon-text">
                            <span class="icon"><i class="ph ph-play-circle"></i></span>
                            <span>{{title}}</span>
                          </span>
                        </p>
                      {{/foreach}}
                    {{else}}
                      <p class="is-size-7 has-text-grey mb-0">No lessons published yet.</p>
                    {{/if}}
                  </div>

                  <div class="buttons">
                    <a href="{{url}}" class="button is-light is-fullwidth">
                      <span class="icon"><i class="ph ph-book-open"></i></span>
                      <span>Overview</span>
                    </a>

                    {{#if module_lessons.[0]}}
                      {{#foreach module_lessons limit="1"}}
                        <a href="{{url}}" class="button is-primary is-fullwidth">
                          <span class="icon"><i class="ph ph-play"></i></span>
                          <span>Start Learning</span>
                        </a>
                      {{/foreach}}
                    {{else}}
                      <span class="button is-static is-fullwidth">No Lessons Yet</span>
                    {{/if}}
                  </div>
                </div>
              </article>
            {{/get}}
          </div>
        {{/foreach}}
      </div>
    {{else}}
      <article class="message is-light">
        <div class="message-body">
          No training modules found yet.
        </div>
      </article>
    {{/if}}
  </div>
</section>