{{!< default}}

{{!-- ══════════════════════════════════════════════════
     PAGE HEADER
══════════════════════════════════════════════════ --}}
{{#page}}
<section class="hero is-dark is-medium">
  <div class="hero-body">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <p class="has-text-warning has-text-weight-bold is-size-7 mb-3" style="text-transform:uppercase; letter-spacing:0.15em;">
            <span class="icon is-small"><i class="fas fa-circle fa-xs"></i></span> Learning Hub
          </p>
          <h1 class="title is-1 has-text-white" style="line-height:1.1; letter-spacing:-0.02em;">{{title}}</h1>
          {{#if custom_excerpt}}
            <p class="subtitle is-5 has-text-grey-light mt-4" style="max-width:540px; font-weight:300; line-height:1.8;">{{custom_excerpt}}</p>
          {{/if}}
          <div class="tags mt-5">
            <span class="tag is-warning is-light is-rounded has-text-weight-semibold">
              <span class="icon is-small"><i class="fas fa-book-open"></i></span>&nbsp;Self-Paced
            </span>
            <span class="tag is-warning is-light is-rounded has-text-weight-semibold">
              <span class="icon is-small"><i class="fas fa-certificate"></i></span>&nbsp;Certificates
            </span>
            <span class="tag is-warning is-light is-rounded has-text-weight-semibold">
              <span class="icon is-small"><i class="fas fa-infinity"></i></span>&nbsp;Lifetime Access
            </span>
          </div>
        </div>
        <div class="column is-4 is-offset-1 is-hidden-touch">
          <div class="notification is-black" style="border-radius:16px; border:1px solid #333;">
            <p class="heading has-text-grey mb-4">What You Get</p>
            <div class="media mb-3">
              <div class="media-left"><span class="icon has-text-warning"><i class="fas fa-play-circle"></i></span></div>
              <div class="media-content"><p class="has-text-white is-size-6">Video + written lessons</p></div>
            </div>
            <div class="media mb-3">
              <div class="media-left"><span class="icon has-text-warning"><i class="fas fa-tasks"></i></span></div>
              <div class="media-content"><p class="has-text-white is-size-6">Hands-on exercises per module</p></div>
            </div>
            <div class="media mb-3">
              <div class="media-left"><span class="icon has-text-warning"><i class="fas fa-comments"></i></span></div>
              <div class="media-content"><p class="has-text-white is-size-6">Community Q&amp;A support</p></div>
            </div>
            <div class="media">
              <div class="media-left"><span class="icon has-text-warning"><i class="fas fa-chart-line"></i></span></div>
              <div class="media-content"><p class="has-text-white is-size-6">Progress tracking per track</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{{!-- Value bar --}}
<div class="has-background-warning py-3">
  <div class="container">
    <div class="columns is-mobile is-multiline is-centered is-vcentered has-text-centered">
      <div class="column is-narrow">
        <span class="has-text-weight-bold is-size-7" style="text-transform:uppercase; letter-spacing:0.1em;">
          <span class="icon is-small"><i class="fas fa-video"></i></span> Video Lessons
        </span>
      </div>
      <div class="column is-narrow is-hidden-mobile has-text-warning-dark">·</div>
      <div class="column is-narrow">
        <span class="has-text-weight-bold is-size-7" style="text-transform:uppercase; letter-spacing:0.1em;">
          <span class="icon is-small"><i class="fas fa-hammer"></i></span> Practical Exercises
        </span>
      </div>
      <div class="column is-narrow is-hidden-mobile has-text-warning-dark">·</div>
      <div class="column is-narrow">
        <span class="has-text-weight-bold is-size-7" style="text-transform:uppercase; letter-spacing:0.1em;">
          <span class="icon is-small"><i class="fas fa-clock"></i></span> Self-Paced
        </span>
      </div>
      <div class="column is-narrow is-hidden-mobile has-text-warning-dark">·</div>
      <div class="column is-narrow">
        <span class="has-text-weight-bold is-size-7" style="text-transform:uppercase; letter-spacing:0.1em;">
          <span class="icon is-small"><i class="fas fa-mobile-alt"></i></span> Mobile Friendly
        </span>
      </div>
    </div>
  </div>
</div>
{{/page}}

{{!-- ══════════════════════════════════════════════════
     TRACKS + LESSONS SPLIT LAYOUT
══════════════════════════════════════════════════ --}}
<section class="section" style="min-height:80vh;">
  <div class="container">

    {{#foreach posts}}

      {{!-- Track separator --}}
      <div class="columns is-variable is-8 mb-0 pb-6 {{#unless @last}}mb-6{{/unless}}" style="{{#unless @last}}border-bottom: 2px dashed #ededed;{{/unless}}">

        {{!-- ════════════════════════════
             LEFT — STICKY TRACK CARD
        ════════════════════════════ --}}
        <div class="column is-4-desktop is-12-tablet">
          <div style="position:sticky; top:1.5rem;">

            <div class="card" style="border-radius:18px; overflow:hidden; border:1px solid #e0e0e0; box-shadow:0 12px 40px rgba(0,0,0,0.09);">

              {{!-- Feature image --}}
              {{#if feature_image}}
                <div class="card-image">
                  <figure class="image is-3by2">
                    <img src="{{img_url feature_image size="m"}}" alt="{{title}}" style="object-fit:cover;">
                  </figure>
                </div>
              {{else}}
                <div class="has-background-dark is-flex is-align-items-center is-justify-content-center" style="height:160px;">
                  <span class="icon is-large has-text-grey-dark"><i class="fas fa-3x fa-graduation-cap"></i></span>
                </div>
              {{/if}}

              {{!-- Dark card body --}}
              <div class="card-content has-background-black-ter has-text-white" style="padding:1.5rem;">

                <div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
                  <span class="tag is-warning is-light is-rounded has-text-weight-bold is-size-7">
                    <span class="icon is-small"><i class="fas fa-layer-group"></i></span>&nbsp;Track Overview
                  </span>
                  {{#if primary_tag}}
                    <span class="tag is-dark is-rounded is-size-7">{{primary_tag.name}}</span>
                  {{/if}}
                </div>

                <h2 class="title is-4 has-text-white mb-3" style="line-height:1.25;">{{title}}</h2>

                <p class="is-size-7 has-text-grey-light mb-4" style="line-height:1.7;">{{excerpt words="22"}}&hellip;</p>

                {{!-- Meta row --}}
                <div class="columns is-mobile is-gapless mb-4">
                  <div class="column has-text-centered" style="border-right:1px solid rgba(255,255,255,0.1);">
                    <p class="heading has-text-grey is-size-8">Reading</p>
                    <p class="has-text-white has-text-weight-bold is-size-7">{{reading_time minute="1 min" minutes="% mins"}}</p>
                  </div>
                  <div class="column has-text-centered">
                    <p class="heading has-text-grey is-size-8">Level</p>
                    <p class="has-text-white has-text-weight-bold is-size-7">
                      {{#foreach tags limit="1"}}{{name}}{{/foreach}}
                    </p>
                  </div>
                </div>

                {{!-- Progress bar --}}
                <div class="p-3 mb-4" style="background:rgba(255,255,255,0.05); border-radius:10px; border:1px solid rgba(255,255,255,0.07);">
                  <div class="is-flex is-justify-content-space-between is-size-7 mb-2">
                    <span class="has-text-grey-light has-text-weight-semibold">Your Progress</span>
                    <span class="has-text-warning has-text-weight-bold">0%</span>
                  </div>
                  <progress class="progress is-warning is-small" value="0" max="100">0%</progress>
                  <p class="is-size-7 has-text-grey mt-2">
                    <span class="icon is-small"><i class="fas fa-lock"></i></span> Log in to track your progress
                  </p>
                </div>

                <a href="{{url}}" class="button is-warning is-fullwidth is-rounded has-text-weight-bold">
                  <span class="icon"><i class="fas fa-play"></i></span>
                  <span>Start Learning</span>
                </a>

              </div>
            </div>

          </div>
        </div>

        {{!-- ════════════════════════════
             RIGHT — LESSONS LIST
        ════════════════════════════ --}}
        <div class="column is-8-desktop is-12-tablet">

          {{!-- Section heading --}}
          <div class="is-flex is-justify-content-space-between is-align-items-center mb-5">
            <div>
              <p class="has-text-warning has-text-weight-bold is-size-7 mb-1" style="text-transform:uppercase; letter-spacing:0.12em;">
                <span class="icon is-small"><i class="fas fa-list-ul"></i></span> Curriculum
              </p>
              <h3 class="title is-4 mb-0">Course Modules</h3>
            </div>
            <span class="tag is-light is-rounded">
              <span class="icon is-small has-text-warning"><i class="fas fa-book"></i></span>&nbsp;All Lessons
            </span>
          </div>

          {{!-- Fetch lessons for this track --}}
          {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="all"}}

            {{#if posts}}
              {{#foreach posts}}

                <article class="media box is-shadowless p-4 mb-3"
                  style="border:1.5px solid #edf0f5; border-radius:14px; cursor:pointer; transition:border-color 0.18s, transform 0.18s, box-shadow 0.18s;"
                  onclick="window.location='{{url}}';"
                  onmouseover="this.style.borderColor='hsl(48,100%,67%)'; this.style.transform='translateX(8px)'; this.style.boxShadow='0 6px 24px rgba(0,0,0,0.07)';"
                  onmouseout="this.style.borderColor='#edf0f5'; this.style.transform='translateX(0)'; this.style.boxShadow='none';">

                  {{!-- Number bubble --}}
                  <figure class="media-left is-hidden-mobile">
                    <div class="is-flex is-align-items-center is-justify-content-center has-background-warning-light has-text-warning-dark has-text-weight-bold is-size-5"
                      style="width:48px; height:48px; border-radius:14px; border:2px solid hsl(48,100%,67%); flex-shrink:0;">
                      {{@number}}
                    </div>
                  </figure>

                  {{!-- Content --}}
                  <div class="media-content is-align-self-center">
                    <p class="has-text-weight-bold is-size-5 mb-1">
                      <a href="{{url}}" class="has-text-dark">{{title}}</a>
                    </p>
                    <p class="is-size-7 has-text-grey" style="line-height:1.6;">{{excerpt words="18"}}</p>
                    <div class="tags mt-2 mb-0">
                      {{#if primary_tag}}<span class="tag is-light is-rounded is-size-7">{{primary_tag.name}}</span>{{/if}}
                      <span class="tag is-light is-rounded is-size-7">
                        <span class="icon is-small"><i class="far fa-clock"></i></span>&nbsp;{{reading_time minute="1 min" minutes="% mins"}}
                      </span>
                    </div>
                  </div>

                  {{!-- Play button --}}
                  <div class="media-right is-flex is-align-items-center is-hidden-mobile">
                    <a href="{{url}}" class="button is-warning is-light is-rounded is-small has-text-weight-bold">
                      <span class="icon is-small"><i class="fas fa-play"></i></span>
                      <span>Start</span>
                    </a>
                  </div>

                </article>

              {{/foreach}}

            {{else}}

              {{!-- Empty state --}}
              <div class="message is-warning is-light" style="border-radius:14px;">
                <div class="message-body has-text-centered py-6">
                  <span class="icon is-large has-text-warning mb-2"><i class="fas fa-2x fa-hard-hat"></i></span>
                  <p class="has-text-weight-bold is-size-5 mt-3">Modules Under Construction</p>
                  <p class="has-text-grey">Lessons for this track are being written. Check back soon!</p>
                </div>
              </div>

            {{/if}}
          {{/get}}

        </div>

      </div>

    {{/foreach}}

    {{!-- Pagination --}}
    <div class="mt-6 pt-4 is-flex is-justify-content-center">
      {{pagination}}
    </div>

  </div>
</section>
