{{!< default}}
{{!-- training.hbs — Roadmaps / training tracks listing.
     Lists #training (track) posts; each card previews its modules. --}}

{{#page}}
  {{> "components/page-header" icon="ph-map-trifold" eyebrow="Roadmaps" title=title subtitle=custom_excerpt}}
{{else}}
  {{> "components/page-header" icon="ph-map-trifold" eyebrow="Roadmaps" title="Training Roadmaps" subtitle="Master the Salesforce ecosystem from basics to advanced analytics and development."}}
{{/page}}

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#foreach posts}}
      <div class="motion-safe:animate-fade-up">{{> "training/track-card"}}</div>
    {{/foreach}}

    {{!-- "Request a topic" CTA card --}}
    <div class="flex flex-col justify-center rounded-card bg-gradient-to-br from-brand-600 to-brand-900 p-6 text-white">
      <h3 class="font-heading text-xl font-bold">{{t "Looking for a specific topic?"}}</h3>
      <p class="mt-2 text-white/80">{{t "New workflows and tutorials are added every month. Tell us what you want to see next!"}}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href="/contact/" class="rounded-pill bg-white px-4 py-2 text-sm font-bold text-brand-700 transition hover:bg-brand-50">{{t "Request a topic"}}</a>
        <a href="/blog/" class="rounded-pill px-4 py-2 text-sm font-semibold ring-1 ring-white/40 transition hover:bg-white/10">{{t "Read the blog"}}</a>
      </div>
    </div>
  </div>

  {{pagination}}
</section>
