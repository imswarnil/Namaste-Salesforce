{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  training.hbs — /training/ IS the single training.

  There is no #training post: routes.yaml routes /training/ straight here. If a
  Ghost PAGE with slug `training` exists, its title/excerpt win (the {{#page}}
  fork below) — otherwise the copy here is used.

  The page is: a full-width two-column hero (short copy + subscribe, beside the
  trail artwork that names every stage), then every section as a stop on a
  roadmap.sh-style trail. Section ORDER lives in partials/training/sections.hbs
  — see that file for why.
═══════════════════════════════════════════════════════════════════════════ --}}

{{> "jsonld/training"}}

{{!-- ── Hero ─────────────────────────────────────────────────────────────────
     Medium height and left-aligned on every breakpoint. The previous cut was
     centre-on-mobile / left-on-desktop, which made the kicker, heading, stats
     and CTAs each shift axis at the lg breakpoint — nothing lined up with
     anything. One axis, one column of text, art beside it.
     `items-center` on the grid keeps the trail optically level with the copy
     rather than pinned to the top of a taller text column. --}}
{{!-- No overflow-hidden here: it would clip the search dropdown out of
     existence. The grid layer below is inset-0 + masked, so it can't overflow. --}}
<header class="relative border-b border-border bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid-corner text-brand-500/70"></div>

  <div class="relative grid items-center gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] lg:gap-14 lg:px-10 lg:py-10 xl:px-16">

    <div>
      {{!-- Breadcrumb ── --}}
      <nav aria-label="{{t "Breadcrumb"}}" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-muted">
        <a href="/" class="inline-flex items-center transition hover:text-brand-600" aria-label="{{t "Home"}}"><i class="ph ph-house" aria-hidden="true"></i></a>
        <i class="ph ph-caret-right text-[0.6rem]" aria-hidden="true"></i>
        <span class="text-ink">{{t "Training"}}</span>
      </nav>

      <p class="ns-kicker">{{t "Salesforce Training"}}</p>

      {{#page}}
        <h1 class="mt-2 font-heading text-2xl font-extrabold tracking-tight text-ink sm:text-3xl lg:text-4xl">{{title}}</h1>
        <p class="mt-2.5 max-w-lg text-muted">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "One training, in order — from your first org to certified."}}{{/if}}</p>
      {{else}}
        <h1 class="mt-2 font-heading text-2xl font-extrabold tracking-tight text-ink sm:text-3xl lg:text-4xl">{{t "From zero to Salesforce Engineer."}}</h1>
        <p class="mt-2.5 max-w-lg text-muted">{{t "One training, in order — no guessing what to learn next. Start with what Salesforce even is, finish able to build, automate and secure a real org."}}</p>
      {{/page}}

      {{!-- ── CTA + a search that stays out of the way until wanted.
           The magnifier is a toggle: the panel only exists once opened, so the
           hero stays a headline + one action rather than a form wall. `open`
           lives on the same x-data as `q` so closing also clears the query. --}}
      <div x-data="{ open: false, q: '' }" class="mt-5">
        <div class="flex flex-wrap items-center gap-3">
          {{!-- "Start learning" = the first lesson of the first section. Both
               hops are derived, so this no longer hardcodes a section slug —
               reordering or replacing the opening section just works. --}}
          {{#get "posts" filter="tag:hash-training-section" order="published_at asc" limit="1"}}
            {{#foreach posts}}
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="1"}}
                {{#foreach posts}}
                  <a href="{{url}}" class="ns-btn ns-btn--primary">
                    <i class="ph-fill ph-play" aria-hidden="true"></i>{{t "Start learning"}}
                  </a>
                {{/foreach}}
              {{/get}}
            {{/foreach}}
          {{/get}}

          <button type="button" @click="open = !open; open ? $nextTick(() => $refs.searchInput?.focus()) : q = ''"
                  :aria-expanded="open ? 'true' : 'false'" aria-controls="training-search"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-ink ns-transition hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-300"
                  :class="open && 'border-brand-500 text-brand-600'"
                  aria-label="{{t "Search training"}}">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </button>
        </div>

        {{> "training/search"}}

        {{!-- ── What you get, inline and small ── --}}
        <ul class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-muted">
          {{#get "posts" filter="tag:hash-training-content+visibility:public" limit="1"}}
            <li class="inline-flex items-center gap-1.5"><i class="ph-fill ph-lock-simple-open text-brand-500" aria-hidden="true"></i>{{pagination.total}} {{t "lessons free to read"}}</li>
          {{/get}}
          <li class="inline-flex items-center gap-1.5"><i class="ph-fill ph-video-camera text-brand-500" aria-hidden="true"></i>{{t "Video + hands-on"}}</li>
          <li class="inline-flex items-center gap-1.5"><i class="ph-fill ph-clock-countdown text-brand-500" aria-hidden="true"></i>{{t "Self-paced"}}</li>
          <li class="inline-flex items-center gap-1.5"><i class="ph-fill ph-seal-check text-brand-500" aria-hidden="true"></i>{{t "Cert-ready"}}</li>
        </ul>
      </div>

    </div>

    {{!-- the trail names every stage, so the copy beside it stays short --}}
    <div class="hidden lg:block">
      {{> "training/hero-trail"}}
    </div>
  </div>
</header>

{{!-- ── Every section, in order ── --}}
<section id="sections" class="scroll-mt-20 border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="mb-12 text-center">
      <span class="ns-kicker ns-kicker--center"><i class="ph-fill ph-map-trifold" aria-hidden="true"></i>{{t "The path"}}</span>
      <h2 class="mt-3 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{t "Every section, in order"}}</h2>
      <p class="mx-auto mt-3 text-muted">{{t "Each one assumes the last — follow the trail from the top."}}</p>
    </div>

  {{!-- The track: a START dot, then every section as a numbered stop on a
       single left-aligned spine (see .ns-track in course.css). Pure CSS +
       Handlebars — no JS. --}}
  <ol class="ns-track mx-auto max-w-3xl">
    <li class="ns-track__start"><span>{{t "Start here"}}</span></li>
    {{> "training/sections" view="card"}}

    {{!-- ── The trail terminates in the newsletter: you've seen the whole path,
         so the ask is "tell me when the next lesson lands", not a generic
         signup. Ghost's members form — no theme JS. ── --}}
    <li class="ns-track__end">
      <span class="ns-track__num ns-track__num--flag"><i class="ph-fill ph-flag-checkered" aria-hidden="true"></i></span>
      <div class="ns-road__finish">
        <p class="ns-road__finish-kicker"><i class="ph-fill ph-flag-checkered" aria-hidden="true"></i>{{t "End of the trail — for now"}}</p>
        <h3 class="ns-road__finish-title">{{t "Get notified the moment I publish new training content"}}</h3>
        <p class="ns-road__finish-desc">{{t "New lessons and sections land regularly. Drop your email and the next one comes straight to your inbox — free, unsubscribe in one click."}}</p>

        <form data-members-form="subscribe" class="ns-road__finish-form">
          <div class="flex overflow-hidden rounded-btn border border-border bg-surface-raised focus-within:border-brand-500">
            <input data-members-email type="email" required placeholder="{{t "you@example.com"}}" aria-label="{{t "Email address"}}"
                   class="w-full min-w-0 border-0 bg-transparent px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:outline-none">
            <button type="submit" class="shrink-0 bg-brand-500 px-5 text-sm font-bold text-white transition hover:bg-brand-600">
              <span data-members-loading class="hidden"><i class="ph ph-circle-notch animate-spin" aria-hidden="true"></i></span>
              <span data-members-default>{{t "Notify me"}}</span>
            </button>
          </div>
          <p data-members-success class="mt-2 text-sm font-semibold text-success" hidden>{{t "Check your inbox — your magic link is on its way!"}}</p>
          <p data-members-error class="mt-2 text-sm font-semibold text-error" hidden>{{t "Something went wrong — try again."}}</p>
        </form>
      </div>
    </li>
  </ol>

    {{!-- Request a topic --}}
    <div class="mt-16 flex flex-col items-center justify-between gap-5 rounded-card border border-border bg-surface-raised p-6 sm:flex-row sm:p-8">
      <div class="flex items-center gap-4 text-center sm:text-left">
        <span class="ns-chip hidden h-12 w-12 shrink-0 text-2xl sm:inline-flex"><i class="ph-fill ph-lightbulb" aria-hidden="true"></i></span>
        <div>
          <h2 class="font-heading text-lg font-bold text-ink sm:text-xl">{{t "Looking for a specific topic?"}}</h2>
          <p class="mt-1 text-sm text-muted">{{t "New lessons are added every month. Tell us what to build next."}}</p>
        </div>
      </div>
      <a href="/contact/" class="ns-btn ns-btn--primary shrink-0">{{> "icons/mail" class="h-5 w-5"}}{{t "Request a topic"}}</a>
    </div>
  </div>
</section>
