{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/course/**",
              "ui_kits/lms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|Inter Fallback|Phosphor|Phosphor-Fill))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, Inter Fallback, Phosphor, Phosphor-Fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|height|key|ref|className|style|children)$/]",
        "message": "<AdSlot> doesn't accept that prop. Declared props: label, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|bio|avatar|key|ref|className|style|children)$/]",
        "message": "<AuthorBox> doesn't accept that prop. Declared props: name, bio, avatar."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|key|ref|className|style|children)$/]",
        "message": "<AvatarRing> doesn't accept that prop. Declared props: src, alt, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|icon|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, icon, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|accent|success|warning|error)$/]",
        "message": "<Badge> variant must be one of 'default' | 'accent' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|excerpt|image|tag|authorName|date|readTime|href|onClick|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: index, title, excerpt, image, tag, authorName, date, readTime, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|white|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'white' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: icon, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:brand|accent)$/]",
        "message": "<Chip> variant must be one of 'brand' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|filename|copyable|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, filename, copyable."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|filename|language|copyable|defaultTheme|showLineNumbers|key|ref|className|style|children)$/]",
        "message": "<CodePanel> doesn't accept that prop. Declared props: code, filename, language, copyable, defaultTheme, showLineNumbers."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodePanel'] > JSXAttribute[name.name='defaultTheme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<CodePanel> defaultTheme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|excerpt|image|level|price|priceLabel|lessons|duration|authorName|featured|sponsored|href|onClick|key|ref|className|style|children)$/]",
        "message": "<CourseCard> doesn't accept that prop. Declared props: index, title, excerpt, image, level, price, priceLabel, lessons, duration, authorName, featured, sponsored, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:beginner|intermediate|advanced)$/]",
        "message": "<CourseCard> level must be one of 'beginner' | 'intermediate' | 'advanced'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute[name.name='price'] > Literal[value!=/^(?:free|paid)$/]",
        "message": "<CourseCard> price must be one of 'free' | 'paid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|key|ref|className|style|children)$/]",
        "message": "<CourseStat> doesn't accept that prop. Declared props: icon, value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurriculumItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|type|icon|duration|locked|preview|done|desc|key|ref|className|style|children)$/]",
        "message": "<CurriculumItem> doesn't accept that prop. Declared props: title, type, icon, duration, locked, preview, done, desc."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurriculumItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:video|article|quiz|exercise)$/]",
        "message": "<CurriculumItem> type must be one of 'video' | 'article' | 'quiz' | 'exercise'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|kicker|title|subtitle|media|stats|actions|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: variant, kicker, title, subtitle, media, stats, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:split|centered|compact)$/]",
        "message": "<Hero> variant must be one of 'split' | 'centered' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|icon|hint|type|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: placeholder, icon, hint, type, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|light|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, align, light."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Kicker> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|key|ref|className|style|children)$/]",
        "message": "<LevelBadge> doesn't accept that prop. Declared props: level."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelBadge'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:beginner|intermediate|advanced)$/]",
        "message": "<LevelBadge> level must be one of 'beginner' | 'intermediate' | 'advanced'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:iconSrc|text|compact|light|size|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: iconSrc, text, compact, light, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|type|icon|href|key|ref|className|style|children)$/]",
        "message": "<ResourceCard> doesn't accept that prop. Declared props: title, type, icon, href."
