      {
        "selector": "JSXOpeningElement[name.name='TrainingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|desc|icon|lessons|duration|progress|href|key|ref|className|style|children)$/]",
        "message": "<TrainingCard> doesn't accept that prop. Declared props: n, title, desc, icon, lessons, duration, progress, href."
