      {
        "selector": "JSXOpeningElement[name.name='VideoPoster'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|onPlay|key|ref|className|style|children)$/]",
        "message": "<VideoPoster> doesn't accept that prop. Declared props: image, onPlay."
      }
    ]
  },
