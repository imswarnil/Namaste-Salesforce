        "selector": "JSXOpeningElement[name.name='TimelineStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|activeIndex|key|ref|className|style|children)$/]",
        "message": "<TimelineStepper> doesn't accept that prop. Declared props: steps, activeIndex."
