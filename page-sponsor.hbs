{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  page-sponsor.hbs — Sponsorship pitch page (standalone, routed at /sponsor/).
  Why sponsor · who you reach · placements · tiers · CTA. Copy is original to
  the site; numbers pull live from Ghost where possible.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── Hero ── --}}
<header class="relative overflow-hidden border-b border-border bg-brand-900 text-white">
  {{> "components/hero-bg"}}
  <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:py-20">
    <p class="ns-kicker ns-kicker--light ns-kicker--center">{{t "Sponsorship"}}</p>
    <h1 class="mt-2 font-heading text-4xl font-extrabold tracking-tight sm:text-5xl">{{t "Put your brand in front of the Salesforce builders of tomorrow"}}</h1>
    <p class="mx-auto mt-4 max-w-xl text-white/80">{{t "Namaste Salesforce is a free, open-source learning platform. Sponsorship keeps every course, doc and training free — and puts your product beside people learning the exact skills you hire for."}}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener" class="ns-btn ns-btn--white ns-btn--lg">{{> icons name="github" class="h-4 w-4"}}{{t "Sponsor on GitHub"}}</a>
      <a href="mailto:swarnilsinghaicse@gmail.com?subject=Sponsoring%20Namaste%20Salesforce" class="ns-btn ns-btn--glass ns-btn--lg">{{> icons name="mail" class="h-4 w-4"}}{{t "Talk to us"}}</a>
    </div>
  </div>
</header>

{{!-- ── Why sponsor ── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="mb-10 max-w-2xl">
    <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Why it works"}}</h2>
    <p class="mt-2 text-muted">{{t "Not banner noise — a focused audience in learning mode."}}</p>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {{> "home/feature-card" icon="crosshair" title="A precise audience" body="Admins, developers and architects actively skilling up on Salesforce, Agentforce and AI — the people who evaluate and champion tools."}}
    {{> "home/feature-card" icon="timer" title="High-intent attention" body="Learners spend long, deliberate sessions in courses and docs — not drive-by pageviews."}}
    {{> "home/feature-card" icon="heart" title="Goodwill included" body="Your support visibly keeps the platform free and open source. The community notices who funds what they learn from."}}
    {{> "home/feature-card" icon="globe" title="Global by default" body="Content in plain English reaches learners across India and worldwide — where Salesforce hiring grows fastest."}}
    {{> "home/feature-card" icon="chart-line" title="Compounding reach" body="Evergreen courses and docs keep ranking and keep teaching — your placement appreciates instead of expiring."}}
    {{> "home/feature-card" icon="handshake" title="Simple to start" body="One conversation, clear placements, no ad-ops overhead. Start and stop whenever you like."}}
  </div>
</section>

{{!-- ── Placements ── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mb-10 max-w-2xl">
      <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Where your brand appears"}}</h2>
      <p class="mt-2 text-muted">{{t "Native placements built into the theme — no third-party ad scripts required."}}</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-card border border-border bg-surface-raised p-6 ns-transition hover:border-brand-500">
        <span class="ns-chip">{{> icons name="sidebar"}}</span>
        <h3 class="mt-3 font-heading font-bold">{{t "Sidebar cards"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Sponsor cards beside docs and lessons — pinned on screen while people read."}}</p>
      </div>
      <div class="rounded-card border border-border bg-surface-raised p-6 ns-transition hover:border-brand-500">
        <span class="ns-chip">{{> icons name="list"}}</span>
        <h3 class="mt-3 font-heading font-bold">{{t "In-content banners"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Leaderboard slots on listing pages and between curriculum sections."}}</p>
      </div>
      <div class="rounded-card border border-border bg-surface-raised p-6 ns-transition hover:border-brand-500">
        <span class="ns-chip">{{> icons name="megaphone"}}</span>
        <h3 class="mt-3 font-heading font-bold">{{t "Site-wide mention"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "A “Sponsored by” credit in the navbar/footer plus a shout-out on new releases."}}</p>
      </div>
    </div>
  </div>
</section>

{{!-- ── Tiers ── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="mb-10 max-w-2xl">
    <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Ways to support"}}</h2>
    <p class="mt-2 text-muted">{{t "From a coffee to a partnership — every tier keeps content free."}}</p>
  </div>
  <div class="grid gap-6 lg:grid-cols-3">

    <div class="flex flex-col rounded-card border border-border bg-surface-raised p-7 ns-transition hover:border-brand-500">
      <p class="ns-label inline-flex items-center gap-2">{{> icons name="coffee"}}{{t "Community"}}</p>
      <p class="mt-3 font-heading text-3xl font-extrabold">{{t "Any amount"}}</p>
      <ul class="mt-5 space-y-2.5 text-sm text-ink">
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Name on the supporters list"}}</li>
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Sponsor badge on your GitHub profile"}}</li>
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Our sincere gratitude, forever"}}</li>
      </ul>
      <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener" class="mt-auto pt-6"><span class="ns-btn ns-btn--outline w-full">{{t "Become a supporter"}}</span></a>
    </div>

    <div class="relative flex flex-col rounded-card border-2 border-brand-500 bg-surface-raised p-7">
      <span class="ns-label absolute -top-3 left-6 rounded-sm bg-brand-500 px-3 py-0.5 text-white">{{t "Most popular"}}</span>
      <p class="ns-label inline-flex items-center gap-2 text-brand-600 dark:text-brand-300">{{> icons name="star"}}{{t "Sponsor"}}</p>
      <p class="mt-3 font-heading text-3xl font-extrabold">{{t "Monthly"}}</p>
      <ul class="mt-5 space-y-2.5 text-sm text-ink">
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Logo + link in the sidebar sponsor card"}}</li>
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "“Sponsored by” credit across the site"}}</li>
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Mention in release notes and community posts"}}</li>
      </ul>
      <a href="mailto:swarnilsinghaicse@gmail.com?subject=Monthly%20sponsorship" class="mt-auto pt-6"><span class="ns-btn ns-btn--primary w-full">{{t "Sponsor monthly"}}</span></a>
    </div>

    <div class="flex flex-col rounded-card border border-border bg-surface-raised p-7 ns-transition hover:border-brand-500">
      <p class="ns-label inline-flex items-center gap-2">{{> icons name="buildings"}}{{t "Partner"}}</p>
      <p class="mt-3 font-heading text-3xl font-extrabold">{{t "Let's talk"}}</p>
      <ul class="mt-5 space-y-2.5 text-sm text-ink">
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Everything in Sponsor"}}</li>
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Co-branded course, workshop or challenge"}}</li>
        <li class="flex items-start gap-2.5">{{> icons name="check-circle" class="mt-0.5 text-success"}}{{t "Hiring-focused placements for your openings"}}</li>
      </ul>
      <a href="mailto:swarnilsinghaicse@gmail.com?subject=Partnering%20with%20Namaste%20Salesforce" class="mt-auto pt-6"><span class="ns-btn ns-btn--outline w-full">{{t "Start a conversation"}}</span></a>
    </div>
  </div>

  <p class="mt-8 text-center text-sm text-muted">{{t "Sponsorships are always labelled, never influence course content, and can be paused any time."}}</p>
</section>

{{!-- ── CTA ── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Keep Salesforce education free"}}</h2>
    <p class="mx-auto mt-3 max-w-lg text-muted">{{t "One sponsorship funds hosting, new courses and better docs for thousands of learners."}}</p>
    <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener" class="ns-btn ns-btn--primary ns-btn--lg mt-6">{{> icons name="heart" class="h-4 w-4"}}{{t "Become a sponsor"}}</a>
  </div>
</section>
