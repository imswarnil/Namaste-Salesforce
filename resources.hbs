{{!< default}}
{{!-- Resources — books, tools and links. A flat collection: no parents, no
     nesting, so the blog card is the right shape. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <p class="ns-kicker">{{t "Elsewhere"}}</p>
            {{#page}}
                <h1 class="ns-band__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
            {{else}}
                <h1 class="ns-band__title">{{t "Resources"}}</h1>
            {{/page}}
        </div>
    </div>
</section>
{{> "listing"}}
