{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  page-gtm.hbs — Custom template for the "Salesforce GTM" page (slug `gtm`).
  A full landing + curriculum experience for learning how to work in a
  Salesforce Go-To-Market (GTM) team.
  Hero → what is GTM → who it's for / roles → outcomes stats → curriculum
  timeline → how you'll learn (steps) → core skills → tools → testimonials →
  editable page body → FAQ → CTA.
  Reuses: components/hero-bg, components/cta, home/feature-card, home/step,
  home/testimonial, courses/faq-item, icons/*.
═══════════════════════════════════════════════════════════════════════════ --}}
{{#page}}

{{!-- ── 1. HERO ──────────────────────────────────────────────────────────── --}}
<section class="relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 text-white">
  {{> "components/hero-bg"}}
  <div class="relative mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 lg:py-32">
    <span class="inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-sm font-semibold ring-1 ring-white/20">
      {{> "icons/sparkle" class="h-4 w-4 text-brand-200"}}{{t "Go-To-Market · Salesforce careers"}}
    </span>

    <h1 class="mt-6 font-heading text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl sm:leading-[1.05] lg:text-6xl">
      {{#if title}}{{title}}{{else}}{{t "Learn to work in a"}}{{/if}}<br>
      <span class="bg-gradient-to-r from-brand-200 via-white to-brand-200 bg-clip-text text-transparent">{{t "Salesforce GTM team"}}</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-white/80 sm:text-xl">
      {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "A practical, role-by-role curriculum on how Go-To-Market really works inside the Salesforce ecosystem — sales, presales, marketing, customer success, RevOps and partners, working as one motion."}}{{/if}}
    </p>

    <div class="mx-auto mt-9 flex max-w-md flex-col justify-center gap-3 sm:flex-row">
      <a href="#curriculum" class="rounded-pill bg-white px-6 py-3 font-bold text-brand-700 transition hover:bg-brand-50">{{t "View the curriculum"}}</a>
      <a href="#roles" class="rounded-pill px-6 py-3 font-semibold text-white ring-1 ring-white/40 transition hover:bg-white/10">{{t "Explore GTM roles"}}</a>
    </div>
    <p class="mt-4 text-sm text-white/60">{{t "Self-paced · Beginner friendly · Built from real field experience"}}</p>
  </div>
</section>

{{!-- ── 2. WHAT IS GTM ───────────────────────────────────────────────────── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Start here"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "What is a Go-To-Market team?"}}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{{t "Go-To-Market (GTM) is how a company takes a product to its customers and grows revenue — the coordinated motion across sales, marketing, presales, customer success and operations. In the Salesforce world, GTM teams don't just sell software; they help customers transform how they run their business."}}</p>
      <p class="mt-4 leading-relaxed text-muted">{{t "This guide breaks down each GTM function, how they work together through the customer lifecycle, and the exact skills you need to land and thrive in any GTM role."}}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "Sales"}}</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "Presales / SE"}}</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "Marketing"}}</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "Customer Success"}}</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "RevOps"}}</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "Partners"}}</span>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      {{> "home/feature-card" icon="ph-target" title="Customer-led" body="Every GTM motion starts from the customer's problem, not the product's features."}}
      {{> "home/feature-card" icon="ph-handshake" title="One team" body="Sales, presales and success share the same number — pipeline to renewal."}}
      {{> "home/feature-card" icon="ph-chart-line-up" title="Revenue engine" body="Predictable pipeline, conversion and retention drive durable growth."}}
      {{> "home/feature-card" icon="ph-strategy" title="Repeatable" body="A motion you can measure, coach and scale — not heroics."}}
    </div>
  </div>
</section>

{{!-- ── 3. OUTCOMES / STATS ──────────────────────────────────────────────── --}}
<section class="border-y border-border bg-surface-sunken">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 px-4 py-12 text-center sm:px-6 lg:grid-cols-4">
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">6</div><div class="mt-1 text-sm font-medium text-muted">{{t "GTM functions covered"}}</div></div>
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">8</div><div class="mt-1 text-sm font-medium text-muted">{{t "Curriculum modules"}}</div></div>
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">40+</div><div class="mt-1 text-sm font-medium text-muted">{{t "Hands-on lessons"}}</div></div>
    <div><div class="font-heading text-3xl font-extrabold text-brand-600 dark:text-brand-300 sm:text-4xl">100%</div><div class="mt-1 text-sm font-medium text-muted">{{t "Free & open"}}</div></div>
  </div>
</section>

{{!-- ── 4. GTM ROLES / WHO IT'S FOR ──────────────────────────────────────── --}}
<section id="roles" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "The roles"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Who's on a Salesforce GTM team?"}}</h2>
    <p class="mt-3 text-muted">{{t "Six functions, one revenue motion. Find where you fit — or learn how the role next to you actually works."}}</p>
  </div>
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {{> "home/feature-card" icon="ph-phone-call" title="Account Executive (AE)" body="Owns the deal end-to-end: discovery, value framing, negotiation and close. Lives in pipeline and forecast."}}
    {{> "home/feature-card" icon="ph-presentation-chart" title="Solution / Sales Engineer" body="The technical trusted advisor. Runs demos, scoping and proofs-of-concept that prove the solution fits."}}
    {{> "home/feature-card" icon="ph-megaphone" title="Marketing & Demand Gen" body="Creates awareness and pipeline through content, campaigns, events and ABM. Feeds the top of funnel."}}
    {{> "home/feature-card" icon="ph-headset" title="SDR / BDR" body="The pipeline engine — prospecting, qualifying and booking the first meaningful conversations."}}
    {{> "home/feature-card" icon="ph-heart" title="Customer Success" body="Drives adoption, value realization and renewals after the sale. Turns customers into advocates."}}
    {{> "home/feature-card" icon="ph-gear-six" title="Revenue Operations" body="The connective tissue — process, data, tooling and analytics that make the whole motion run."}}
  </div>
</section>

{{!-- ── 5. CURRICULUM (timeline style) ───────────────────────────────────── --}}
<section id="curriculum" class="border-y border-border bg-surface-sunken">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="mb-12 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "The curriculum"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Your path into a GTM team"}}</h2>
      <p class="mt-3 text-muted">{{t "Eight modules, in order. Each builds on the last — from the fundamentals of GTM to running a live deal cycle alongside the team."}}</p>
    </div>

    <ol class="ns-timeline space-y-10">
      {{> "home/timeline-item" year="Module 1" title="GTM foundations" body="What Go-To-Market means, the revenue funnel end to end, key metrics (pipeline, ARR, win rate, NRR), and how Salesforce sells to its customers."}}
      {{> "home/timeline-item" year="Module 2" title="Know the customer & the market" body="Ideal customer profiles, personas, segmentation, industries and the buyer's journey. Why discovery beats pitching every time."}}
      {{> "home/timeline-item" year="Module 3" title="Sales fundamentals (AE track)" body="Qualification frameworks (MEDDIC, BANT), discovery calls, value selling, mutual action plans, negotiation and closing."}}
      {{> "home/timeline-item" year="Module 4" title="Presales & the technical sale" body="Running a discovery-led demo, solution scoping, handling objections, building a proof-of-concept and the AE/SE partnership."}}
      {{> "home/timeline-item" year="Module 5" title="Marketing & demand generation" body="Top-of-funnel motion: content, campaigns, ABM, events and SDR outreach. How marketing and sales hand off cleanly."}}
      {{> "home/timeline-item" year="Module 6" title="Customer success & expansion" body="Onboarding, adoption, value realization, renewals, upsell/cross-sell and turning customers into references."}}
      {{> "home/timeline-item" year="Module 7" title="Revenue operations & the CRM" body="How Salesforce runs on Salesforce: opportunity stages, forecasting, dashboards, data hygiene and the GTM tech stack."}}
      {{> "home/timeline-item" year="Module 8" title="Working as one GTM team" body="Cross-functional collaboration, deal reviews, QBRs, the AI era of GTM (Agentforce, Einstein) and building your career path."}}
    </ol>

    <div class="mt-12 text-center">
      <a href="/courses/" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">
        {{t "Browse related courses"}}{{> "icons/arrow-right" class="h-4 w-4"}}
      </a>
    </div>
  </div>
</section>

{{!-- ── 6. HOW YOU'LL LEARN (steps) ──────────────────────────────────────── --}}
<section class="relative overflow-hidden px-4 py-16 sm:px-6 lg:py-20">
  <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 text-ink/40"></div>
  <div class="relative mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "How you'll learn"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Learn it the way the job works"}}</h2>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {{> "home/step" num="1" icon="ph-book-open-text" title="Understand the motion" body="Short lessons that explain each GTM function and how revenue actually flows."}}
      {{> "home/step" num="2" icon="ph-users-three" title="Shadow a deal" body="Walk through a realistic deal cycle from first touch to closed-won and renewal."}}
      {{> "home/step" num="3" icon="ph-flask" title="Practice the skills" body="Run mock discovery calls, demos and forecasts with templates and checklists."}}
      {{> "home/step" num="4" icon="ph-briefcase" title="Land the role" body="Interview prep, role-specific playbooks and a portfolio to show hiring teams."}}
    </div>
  </div>
</section>

{{!-- ── 7. CORE SKILLS ───────────────────────────────────────────────────── --}}
<section class="border-y border-border bg-surface-sunken">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "What you'll master"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "The skills that move revenue"}}</h2>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {{> "home/feature-card" icon="ph-magnifying-glass" title="Discovery & qualification" body="Ask the questions that uncover real pain, budget and urgency — and qualify ruthlessly."}}
      {{> "home/feature-card" icon="ph-currency-circle-dollar" title="Value selling" body="Frame outcomes in business terms: ROI, time-to-value and risk — not feature lists."}}
      {{> "home/feature-card" icon="ph-projector-screen" title="Demos & storytelling" body="Tell a tailored story that connects the product to the customer's world."}}
      {{> "home/feature-card" icon="ph-chart-bar" title="Pipeline & forecasting" body="Manage stages, build clean pipeline and forecast a number you can stand behind."}}
      {{> "home/feature-card" icon="ph-arrows-clockwise" title="Adoption & renewals" body="Drive usage, prove value and turn renewals into expansion."}}
      {{> "home/feature-card" icon="ph-robot" title="AI-era selling" body="Use Agentforce and Einstein to research, prep and personalize at scale."}}
    </div>
  </div>
</section>

{{!-- ── 8. TOOLS OF THE TRADE ────────────────────────────────────────────── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "The stack"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Tools a GTM team lives in"}}</h2>
  </div>
  <div class="mt-10 flex flex-wrap justify-center gap-3">
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-cloud text-brand-500" aria-hidden="true"></i>{{t "Sales Cloud"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-robot text-brand-500" aria-hidden="true"></i>{{t "Agentforce"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-sparkle text-brand-500" aria-hidden="true"></i>{{t "Einstein"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-database text-brand-500" aria-hidden="true"></i>{{t "Data Cloud"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-chart-donut text-brand-500" aria-hidden="true"></i>{{t "Tableau / CRMA"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-megaphone text-brand-500" aria-hidden="true"></i>{{t "Marketing Cloud"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-handshake text-brand-500" aria-hidden="true"></i>{{t "Slack"}}</span>
    <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface-raised px-4 py-2 text-sm font-semibold shadow-card"><i class="ph-fill ph-list-checks text-brand-500" aria-hidden="true"></i>{{t "MEDDIC / MAP"}}</span>
  </div>
</section>

{{!-- ── 9. TESTIMONIALS ──────────────────────────────────────────────────── --}}
<section class="border-y border-border bg-surface-sunken">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "From the field"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Where this took them"}}</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {{> "home/testimonial" quote="I came from support with zero sales background. The GTM modules made the deal cycle finally click — I'm now an SDR booking meetings every week." name="Aarav M." role="Sales Development Rep"}}
      {{> "home/testimonial" quote="The presales track taught me how to run a discovery-led demo. I landed a Solution Engineer role within four months." name="Lena K." role="Solution Engineer"}}
      {{> "home/testimonial" quote="Understanding how marketing, sales and CS actually hand off changed how I work. RevOps suddenly made sense as a career." name="Tomás R." role="Revenue Operations Analyst"}}
    </div>
  </div>
</section>

{{!-- ── 10. EDITABLE PAGE BODY ───────────────────────────────────────────── --}}
{{#if content}}
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="prose prose-lg max-w-none gh-content">{{content}}</div>
  </section>
{{/if}}

{{!-- ── 11. FAQ ──────────────────────────────────────────────────────────── --}}
<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="mb-10 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Questions"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "GTM, answered"}}</h2>
  </div>
  <div class="space-y-3">
    {{> "courses/faq-item" q="Do I need a technical background to work in GTM?" a="Not for most roles. AEs, SDRs, marketing and customer success are business roles. Presales (Solution Engineering) is the most technical, but you can grow into it from a Salesforce admin or developer background."}}
    {{> "courses/faq-item" q="Which GTM role should I start with?" a="SDR/BDR is the most common entry point into sales. If you're more technical, look at Solution Engineering. If you like process and data, Revenue Operations is a great start. The curriculum helps you decide."}}
    {{> "courses/faq-item" q="How is this different from a Salesforce admin certification?" a="An admin cert teaches you to configure the platform. This teaches you how companies use Salesforce to sell and grow — the business motion around the product. They complement each other perfectly."}}
    {{> "courses/faq-item" q="How long does it take?" a="It's self-paced. Most learners work through the eight modules over 6–10 weeks alongside a job or studies."}}
    {{> "courses/faq-item" q="Is it really free?" a="Yes. The entire curriculum, like everything on Namaste Salesforce, is free and open — no paywall, ever."}}
  </div>
</section>

{{!-- ── 12. CTA ──────────────────────────────────────────────────────────── --}}
{{> "components/cta"}}

{{/page}}
