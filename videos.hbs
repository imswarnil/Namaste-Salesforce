{{!< default}}

{{!-- /videos — the library. Its hero is the dark, cinematic one
of the five listing styles: navy like the thumbnails, so the
cards feel continuous with it. --}}

<section class="videos-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="inner relative">
        <span class="kicker">{{> "icons/video"}} {{t "Videos"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Watch one thing get built, start to finish."}}{{/if}}</p>
        {{else}}
            <h1>{{t "Video Library"}}</h1>
            <p>{{t "Watch one thing get built, start to finish."}}</p>
        {{/page}}
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner">
        <div class="card-grid">
            {{#foreach posts}}
                {{> "card-video"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</main>
