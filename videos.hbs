{{!< default}}

{{!-- Structured data for this listing page. Keep `filter` identical
to this collection's filter in routes.yaml. --}}
{{> "json-ld-collection" name="Videos" path="videos" filter="tag:hash-video" itemType="VideoObject"}}

{{!-- /videos — the library. Its hero is the dark, cinematic one
of the five listing styles: navy like the thumbnails, so the
cards feel continuous with it. --}}

<section class="videos-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="inner relative">
        <span class="kicker">{{> "icons/video"}} {{t "Videos"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Watch one thing get built, start to finish."}}{{/if}}</p>
        {{else}}
            <h1>{{t "Video Library"}}</h1>
            <p>{{t "Watch one thing get built, start to finish."}}</p>
        {{/page}}

        {{#if @custom.social_youtube}}
            <div class="training-hero2-actions">
                <a class="btn btn-lg btn-youtube" href="{{@custom.social_youtube}}?sub_confirmation=1" target="_blank" rel="noopener">
                    {{> "icons/youtube"}} {{t "Subscribe on YouTube"}}
                </a>
            </div>
        {{/if}}

        <div class="training-hero2-stats">
            {{#get "posts" filter="tag:hash-video" limit="1" as |items counts|}}
                <div class="home-stat"><strong data-count="{{counts.total}}">{{counts.total}}</strong><span>{{t "Videos"}}</span></div>
            {{/get}}
            {{#get "tags" filter="visibility:public" limit="1" as |items counts|}}
                <div class="home-stat"><strong data-count="{{counts.total}}">{{counts.total}}</strong><span>{{t "Topics covered"}}</span></div>
            {{/get}}
            <div class="home-stat"><strong>{{t "Free"}}</strong><span>{{t "Forever"}}</span></div>
        </div>
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner">
        <div class="card-grid">
            {{#foreach posts}}
                {{> "card-video"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</main>
