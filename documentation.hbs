{{!< default}}

{{!-- Hidden span explicitly given 'index' so JS doesn't crash --}}
<span id="doc-current-id" data-id="index" hidden aria-hidden="true"></span>

<section class="section py-5 has-background-white">
  <div class="container is-fluid">
    <div class="columns is-variable is-5-desktop is-multiline">

      {{!-- LEFT SIDEBAR (Shared) --}}
      {{> "doc-sidebar"}}

      {{!-- MAIN CONTENT --}}
      <main class="column is-9-desktop is-8-tablet" role="main">
        <div class="content is-medium">
          <h1 class="title is-1 has-text-weight-bold">Namaste Salesforce Documentation</h1>
          <p class="subtitle is-4 has-text-grey">Select a guide from the sidebar to get started.</p>
          
          <hr class="my-5">

          <div class="columns is-multiline mt-4">
            {{#get "posts" filter="tag:documentation" limit="6" order="published_at desc"}}
              {{#foreach posts}}
                <div class="column is-6">
                  <a href="{{url}}" class="box h-100 is-shadowless" style="border: 1px solid #e2e8f0;">
                    <h3 class="title is-5 mb-2">{{title}}</h3>
                    <p class="is-size-6 has-text-grey">{{excerpt words="15"}}...</p>
                  </a>
                </div>
              {{/foreach}}
            {{/get}}
          </div>
          
        </div>
      </main>

    </div>
  </div>
</section>

{{!-- Reuse the exact same script for the mobile dropdown logic --}}
{{#contentFor "scripts"}}
<script>
(function () {
  'use strict';
  var dropdown = document.getElementById('docMobDropdown');
  var trigger = dropdown?.querySelector('.dropdown-trigger button');
  if (!dropdown || !trigger) return;

  function setOpen(open) {
    dropdown.classList.toggle('is-active', open);
    var c = trigger.querySelector('.doc-mob-toggle__caret');
    if (c) c.style.transform = open ? 'rotate(180deg)' : '';
  }

  trigger.addEventListener('click', function(e) {
    e.stopPropagation();
    setOpen(!dropdown.classList.contains('is-active'));
  });
  document.addEventListener('click', function(e) {
    if (dropdown.classList.contains('is-active') && !dropdown.contains(e.target)) setOpen(false);
  });
})();
</script>
{{/contentFor}}