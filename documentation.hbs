{{!< default}}
{{!-- documentation.hbs — Documentation hub (index).
     Compact two-column hero (copy + search left, floating-cards animation
     right) · professional section-card grid (docs/sections view="card") ·
     contributor CTA. Search filters cards/articles via a shared Alpine scope.
     Mobile gets the pinned docs menu (docs/mobile-bar). --}}
{{> "docs/mobile-bar"}}

<div x-data="{ q: '' }">

  {{!-- ── Hero: content left · animation right (compact) ── --}}
  <header class="relative overflow-hidden border-b border-border bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 text-white">
    {{> "components/hero-bg"}}
    <div class="relative mx-auto grid max-w-[90rem] items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:py-12">

      <div>
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-200">
          {{> "icons/documentation" class="h-4 w-4"}}{{t "Documentation"}}
        </p>
        <h1 class="mt-2 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{t "How can we help?"}}</h1>
        <p class="mt-3 max-w-xl text-white/80">{{t "Guides, references and how-tos for the Namaste Salesforce platform."}}</p>
        <label class="relative mt-6 block max-w-lg">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted">{{> "icons/search" class="h-5 w-5"}}</span>
          <input x-model="q" type="search" placeholder="{{t "Search the docs…"}}" aria-label="{{t "Search documentation"}}"
                 class="w-full rounded-pill border-0 bg-white py-3 pl-12 pr-4 text-ink shadow-raised placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand-300">
        </label>
      </div>

      {{!-- Floating doc-card animation (decorative) --}}
      <div class="relative hidden h-64 lg:block" aria-hidden="true">
        <div class="absolute right-1/2 top-1/2 h-56 w-56 -translate-y-1/2 translate-x-1/2 rounded-full bg-brand-400/25 blur-3xl"></div>

        <div class="absolute left-2 top-8 w-52 -rotate-6 rounded-xl bg-white/10 p-4 shadow-raised ring-1 ring-white/20 backdrop-blur [animation:ns-float_7s_ease-in-out_infinite]">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-400/30"><i class="ph-fill ph-rocket-launch text-sm text-brand-200"></i></span>
            <div class="h-2 w-24 rounded bg-white/40"></div>
          </div>
          <div class="mt-3 space-y-2">
            <div class="h-1.5 w-full rounded bg-white/25"></div>
            <div class="h-1.5 w-4/5 rounded bg-white/25"></div>
            <div class="h-1.5 w-3/5 rounded bg-white/25"></div>
          </div>
        </div>

        <div class="absolute right-4 top-0 w-56 rotate-3 rounded-xl bg-white/10 p-4 shadow-raised ring-1 ring-white/20 backdrop-blur [animation:ns-float_8.5s_ease-in-out_infinite_reverse]">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-400/30"><i class="ph-fill ph-seal-check text-sm text-brand-200"></i></span>
            <div class="h-2 w-28 rounded bg-white/40"></div>
          </div>
          <div class="mt-3 space-y-2">
            <div class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-xs text-brand-200"></i><div class="h-1.5 w-4/5 rounded bg-white/25"></div></div>
            <div class="flex items-center gap-2"><i class="ph-fill ph-check-circle text-xs text-brand-200"></i><div class="h-1.5 w-3/5 rounded bg-white/25"></div></div>
            <div class="flex items-center gap-2"><i class="ph ph-circle text-xs text-white/40"></i><div class="h-1.5 w-2/3 rounded bg-white/25"></div></div>
          </div>
        </div>

        <div class="absolute left-1/3 top-32 w-60 rounded-xl bg-white/10 p-4 shadow-raised ring-1 ring-white/20 backdrop-blur [animation:ns-float_9.5s_ease-in-out_1.2s_infinite]">
          <div class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-error/70"></span><span class="h-2 w-2 rounded-full bg-warning/70"></span><span class="h-2 w-2 rounded-full bg-success/70"></span>
          </div>
          <div class="mt-3 space-y-2 font-mono">
            <div class="h-1.5 w-1/2 rounded bg-brand-300/50"></div>
            <div class="ml-4 h-1.5 w-2/3 rounded bg-white/25"></div>
            <div class="ml-4 h-1.5 w-1/2 rounded bg-white/25"></div>
            <div class="h-1.5 w-1/3 rounded bg-brand-300/50"></div>
          </div>
        </div>
      </div>
    </div>
  </header>

  {{!-- ── Section cards ── --}}
  <main class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 lg:py-14">
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {{> "docs/sections" view="card"}}
    </div>

    {{!-- No-results (search) --}}
    <p x-show="q !== '' && ![...document.querySelectorAll('[data-cat] a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))"
       x-cloak class="mt-10 rounded-card border border-dashed border-border py-12 text-center text-muted">
      {{t "No articles match your search."}}
    </p>

    {{!-- Contributor CTA --}}
    <div class="mt-12 grid items-center gap-6 rounded-card border border-border bg-surface-sunken p-6 sm:grid-cols-[1fr_auto] sm:p-8">
      <div>
        <h3 class="font-heading text-lg font-bold">{{t "Help improve these docs"}}</h3>
        <p class="mt-1 text-sm text-muted">{{t "Spotted a gap or an error? Request contributor access or open an edit on GitHub — docs are community-maintained."}}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/imswarnil/Namaste-Salesforce/issues/new?labels=docs&title=Docs%20feedback" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-4 py-2.5 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">{{> "icons/github" class="h-4 w-4"}}{{t "Edit on GitHub"}}</a>
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-pill border border-border px-4 py-2.5 text-sm font-semibold transition hover:border-brand-500 hover:text-brand-600">{{> "icons/user-plus" class="h-4 w-4"}}{{t "Request access"}}</a>
      </div>
    </div>
  </main>
</div>
