{{!< default}}

{{!-- Hidden span explicitly given 'index' so JS doesn't crash --}}
<span id="doc-current-id" data-id="index" hidden aria-hidden="true"></span>

<section class="ns-section--tight">
  <div class="container is-fluid">
    <div class="columns is-variable is-5-desktop is-multiline">

      {{!-- LEFT SIDEBAR (Shared) --}}
      {{> "doc-sidebar"}}

      {{!-- MAIN CONTENT --}}
      <main class="column is-9-desktop is-8-tablet" role="main">

        <span class="ns-eyebrow ns-fade-up"><i class="ph ph-book-open mr-1"></i> Documentation</span>
        <h1 class="ns-display ns-gradient-text ns-fade-up ns-stagger-1">Namaste Salesforce Documentation</h1>
        <p class="ns-lead ns-fade-up ns-stagger-2">Select a guide from the sidebar to get started.</p>

        <div class="ns-divider"></div>

        <div class="ns-grid ns-grid--2 mt-4">
          {{#get "posts" filter="tag:documentation" limit="6" order="published_at desc"}}
            {{#foreach posts}}
              <a href="{{url}}" class="ns-feature-card is-block ns-fade-up ns-stagger-{{@number}}" style="text-decoration: none; height: 100%;">
                <div class="ns-feature-card__icon">
                  <i class="ph-fill ph-file-text"></i>
                </div>
                <h3 class="ns-feature-card__title">{{title}}</h3>
                <p class="ns-feature-card__body">{{excerpt words="15"}}...</p>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

      </main>

    </div>
  </div>
</section>

{{!-- Reuse the exact same script for the mobile dropdown logic --}}
{{#contentFor "scripts"}}
<script>
(function () {
  'use strict';
  var dropdown = document.getElementById('docMobDropdown');
  var trigger = dropdown?.querySelector('.dropdown-trigger button');
  if (!dropdown || !trigger) return;

  function setOpen(open) {
    dropdown.classList.toggle('is-active', open);
    var c = trigger.querySelector('.doc-mob-toggle__caret');
    if (c) c.style.transform = open ? 'rotate(180deg)' : '';
  }

  trigger.addEventListener('click', function(e) {
    e.stopPropagation();
    setOpen(!dropdown.classList.contains('is-active'));
  });
  document.addEventListener('click', function(e) {
    if (dropdown.classList.contains('is-active') && !dropdown.contains(e.target)) setOpen(false);
  });
})();
</script>
{{/contentFor}}