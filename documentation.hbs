{{!< default}}

{{!-- JSON-LD (unchanged) --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{#if name}}{{name}}{{else}}Documentation{{/if}} — {{@site.title}}",
  "url": "{{@site.url}}/documentation/",
  "description": "{{#if description}}{{description}}{{else}}Official documentation for {{@site.title}}{{/if}}",
  "publisher": {
    "@type": "Organization",
    "name": "{{@site.title}}"{{#if @site.logo}},
    "logo": { "@type": "ImageObject", "url": "{{@site.logo}}" }{{/if}}
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "{{#if name}}{{name}}{{else}}Documentation{{/if}}",
    "itemListElement": [
      {{#foreach posts}}
      {{#unless @first}},{{/unless}}
      {
        "@type": "ListItem",
        "position": {{@number}},
        "name": "{{title}}",
        "url": "{{url absolute="true"}}"
      }
      {{/foreach}}
    ]
  }
}
</script>

{{!-- ============================================================
  Hero – uses Bulma hero + custom gradient class
============================================================ --}}
<section class="hero is-medium docs-hero">
  <div class="hero-body">
    <div class="container">
      <div class="columns is-vcentered is-variable is-8-desktop">
        {{!-- Left column --}}
        <div class="column is-7-desktop">
          <span class="tag is-white is-light mb-4">
            <i class="ph ph-book-open-text mr-1"></i> Namaste Salesforce Docs
          </span>
          <h1 class="title is-1 has-text-white">
            Learn Salesforce,<br>
            <span class="has-text-white is-italic">the right way.</span>
          </h1>
          <p class="subtitle is-5 has-text-white">
            Free, community-maintained guides for every Salesforce topic —
            from first login to certified expert. Clear explanations, real
            examples, zero fluff.
          </p>
          <div class="buttons">
            {{#foreach posts}}
              {{#if @first}}
                <a href="{{url}}" class="button is-light is-medium">
                  <span class="icon"><i class="ph ph-rocket-launch"></i></span>
                  <span>Start from the beginning</span>
                </a>
              {{/if}}
            {{/foreach}}
            <button class="button is-white is-outlined is-medium" data-ghost-search>
              <span class="icon"><i class="ph ph-magnifying-glass"></i></span>
              <span>Search docs</span>
              <kbd class="ml-1 is-size-7">⌘K</kbd>
            </button>
          </div>
          <div class="tags">
            <span class="tag is-white is-light"><i class="ph ph-check-circle mr-1"></i>100% free, always</span>
            <span class="tag is-white is-light"><i class="ph ph-arrows-clockwise mr-1"></i>Updated regularly</span>
            <span class="tag is-white is-light"><i class="ph ph-users-three mr-1"></i>Community maintained</span>
            <span class="tag is-white is-light"><i class="ph ph-certificate mr-1"></i>Exam-prep friendly</span>
          </div>
        </div>

        {{!-- Right column – stat cards (desktop only) --}}
        <div class="column is-5-desktop is-hidden-mobile">
          <div class="columns is-multiline">
            <div class="column is-12">
              <div class="card docs-hero-card">
                <div class="card-content">
                  <div class="media">
                    <div class="media-left"><i class="ph ph-files is-size-2"></i></div>
                    <div class="media-content">
                      <p class="title is-4">{{posts.length}}</p>
                      <p class="subtitle is-6">Articles published</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="card docs-hero-card">
                <div class="card-content">
                  <div class="media">
                    <div class="media-left"><i class="ph ph-currency-dollar is-size-3"></i></div>
                    <div class="media-content">
                      <p class="title is-4">Free</p>
                      <p class="subtitle is-6">No paywall, ever</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="column is-6">
              <div class="card docs-hero-card">
                <div class="card-content">
                  <div class="media">
                    <div class="media-left"><i class="ph ph-graduation-cap is-size-3"></i></div>
                    <div class="media-content">
                      <p class="title is-4">All levels</p>
                      <p class="subtitle is-6">Beginner to advanced</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="column is-12">
              <div class="card docs-hero-card">
                <div class="card-content">
                  <div class="media">
                    <div class="media-left"><i class="ph ph-git-branch is-size-2"></i></div>
                    <div class="media-content">
                      <p class="title is-4">Open source</p>
                      <p class="subtitle is-6">Contribute on GitHub</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{{!-- ============================================================
  Topic Chips – Bulma tags
============================================================ --}}
<section class="section is-paddingless">
  <div class="container">
    <div class="tags are-medium">
      <span class="tag is-light"><i class="ph ph-layout mr-1"></i> Overview</span>
      <a href="https://trailhead.salesforce.com" target="_blank" class="tag is-light"><i class="ph ph-cloud mr-1"></i> Trailhead</a>
      <a href="/courses/" class="tag is-light"><i class="ph ph-book-open mr-1"></i> Courses</a>
      <a href="/training/" class="tag is-light"><i class="ph ph-graduation-cap mr-1"></i> Training</a>
      <a href="/blog/" class="tag is-light"><i class="ph ph-note-pencil mr-1"></i> Blog</a>
      <button class="tag is-light" data-ghost-search><i class="ph ph-magnifying-glass mr-1"></i> Search all</button>
    </div>
  </div>
</section>

{{!-- ============================================================
  Articles list – Bulma columns + cards
============================================================ --}}
<section class="section">
  <div class="container">
    <div class="block">
      <h2 class="title is-3">{{#if name}}{{name}}{{else}}All articles{{/if}}</h2>
      <p class="subtitle is-5">
        {{#if description}}{{description}}{{else}}Read in order to build a solid foundation, or jump to any article.{{/if}}
      </p>
    </div>

    <div class="columns is-multiline">
      {{#foreach posts}}
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <a href="{{url}}" class="card docs-card">
            <div class="card-content">
              <div class="media">
                <div class="media-left">
                  {{#if feature_image}}
                    <figure class="image is-48x48">
                      <img src="{{img_url feature_image size="xs"}}" alt="" loading="lazy">
                    </figure>
                  {{else}}
                    <span class="icon is-large"><i class="ph ph-file-text is-size-3"></i></span>
                  {{/if}}
                </div>
                <div class="media-content">
                  <p class="title is-6">{{title}}</p>
                  <p class="subtitle is-7">{{reading_time}}</p>
                </div>
                <span class="tag is-light is-rounded">{{@number}}</span>
              </div>
              {{#if custom_excerpt}}
                <p class="has-text-grey">{{custom_excerpt}}</p>
              {{else}}
                <p class="has-text-grey">{{excerpt words="18"}}…</p>
              {{/if}}
            </div>
            <footer class="card-footer">
              <span class="card-footer-item">
                <i class="ph ph-timer mr-1"></i> {{reading_time}}
              </span>
              <span class="card-footer-item">
                Read <i class="ph ph-arrow-right ml-1"></i>
              </span>
            </footer>
          </a>
        </div>
      {{else}}
        <div class="column has-text-centered">
          <div class="notification is-warning is-light">
            <i class="ph ph-books is-size-2"></i>
            <p class="title is-5">No articles yet</p>
            <p>Create a post and tag it <code>documentation</code> to see it here.</p>
          </div>
        </div>
      {{/foreach}}
    </div>

    {{#if pagination.pages}}
      <nav class="pagination is-centered" role="navigation" aria-label="pagination">
        {{#if pagination.prev}}<a class="pagination-previous" href="{{pagination.prev}}">Previous</a>{{/if}}
        {{#if pagination.next}}<a class="pagination-next" href="{{pagination.next}}">Next page</a>{{/if}}
        <ul class="pagination-list">
          {{#foreach pagination.pages}}
            <li><a class="pagination-link{{#if current}} is-current{{/if}}" href="{{url}}">{{page}}</a></li>
          {{/foreach}}
        </ul>
      </nav>
    {{/if}}
  </div>
</section>

{{!-- ============================================================
  Contribute section – Bulma columns + cards
============================================================ --}}
<section class="section has-background-light">
  <div class="container">
    <div class="columns is-vcentered is-variable is-8">
      <div class="column is-7">
        <span class="tag is-warning is-light mb-4">
          <i class="ph ph-git-pull-request mr-1"></i> Open to contributions
        </span>
        <h2 class="title is-2">Help us improve the docs</h2>
        <p class="subtitle is-5">
          Found a mistake? Have something to add? Every correction,
          new article, or clarification helps thousands of Salesforce
          learners. Submit a PR, open an issue, or reach out directly.
        </p>
        <div class="buttons">
          <a href="https://github.com/imswarnil/Namaste-Salesforce/issues/new"
             target="_blank" class="button is-primary is-medium">
            <span class="icon"><i class="ph ph-github-logo"></i></span>
            <span>Open an issue</span>
          </a>
          <a href="/contact/?ref=docs-write" class="button is-light is-medium">
            <span class="icon"><i class="ph ph-pencil-line"></i></span>
            <span>Write an article</span>
          </a>
          <a href="https://github.com/sponsors/imswarnil" target="_blank" class="button is-success is-light is-medium">
            <span class="icon"><i class="ph ph-currency-dollar"></i></span>
            <span>Sponsor</span>
          </a>
        </div>
      </div>

      <div class="column is-5 is-hidden-mobile">
        <div class="box">
          <div class="media">
            <div class="media-left"><span class="icon is-medium"><i class="ph ph-pencil-simple-line is-size-3"></i></span></div>
            <div class="media-content">
              <p class="title is-6">Fix anything instantly</p>
              <p class="subtitle is-7">Spot a typo or outdated detail — open a PR and it's live fast.</p>
            </div>
          </div>
          <div class="media">
            <div class="media-left"><span class="icon is-medium"><i class="ph ph-user-circle-plus is-size-3"></i></span></div>
            <div class="media-content">
              <p class="title is-6">Get credited as an author</p>
              <p class="subtitle is-7">All contributors are listed in the project changelog.</p>
            </div>
          </div>
          <div class="media">
            <div class="media-left"><span class="icon is-medium"><i class="ph ph-discord-logo is-size-3"></i></span></div>
            <div class="media-content">
              <p class="title is-6">Join the community</p>
              <p class="subtitle is-7">Chat with other Salesforce learners in our Discord.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>