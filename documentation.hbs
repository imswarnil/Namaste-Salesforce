{{!< default}}
{{!-- documentation.hbs — Documentation hub (index).
     Compact two-column hero (copy + search left, floating-cards animation
     right) · professional section-card grid (docs/sections view="card") ·
     contributor CTA. Search filters cards/articles via a shared Alpine scope.
     Mobile gets the pinned docs menu (docs/mobile-bar). --}}
{{> "docs/mobile-bar"}}

<div x-data="{ q: '' }">

  {{!-- ── Hero: copy + search left, animation right ──
       .ns-hero --dark --start --split --grid: the theme's hero component
       (2-components/hero.css) rather than a one-off navy band. Same object as
       every other page top on the site, so the docs hub does not have its own
       private idea of what a hero is. --}}
  <header class="ns-hero ns-hero--start ns-hero--split ns-hero--grid">
    <div class="ns-hero__inner">

      <div>
        <p class="ns-kicker ns-kicker--light">{{t "Documentation"}}</p>
        <h1 class="ns-hero__title">{{t "How can we help?"}}</h1>
        <p class="ns-hero__sub">{{t "Guides, references and how-tos for the Namaste Salesforce platform."}}</p>
        <label class="ns-input-wrap ns-hero__search">
          {{> icons name="search" class="ns-input-wrap__icon"}}
          <input x-model="q" type="search" placeholder="{{t "Search the docs…"}}" aria-label="{{t "Search documentation"}}" class="ns-input ns-input--has-icon">
        </label>
      </div>

      {{!-- Floating doc-card animation (decorative) --}}
      <div class="ns-hero__media relative hidden h-64 lg:block" aria-hidden="true">
        <div class="absolute left-2 top-8 w-52 -rotate-6 rounded-card bg-brand-800 p-4 ring-1 ring-white/20 [animation:ns-float_7s_ease-in-out_infinite]">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-sm bg-brand-400/30">{{> icons name="rocket" class="text-sm text-brand-200"}}</span>
            <div class="h-2 w-24 rounded bg-white/40"></div>
          </div>
          <div class="mt-3 space-y-2">
            <div class="h-1.5 w-full rounded bg-white/25"></div>
            <div class="h-1.5 w-4/5 rounded bg-white/25"></div>
            <div class="h-1.5 w-3/5 rounded bg-white/25"></div>
          </div>
        </div>

        <div class="absolute right-4 top-0 w-56 rotate-3 rounded-card bg-brand-800 p-4 ring-1 ring-white/20 [animation:ns-float_8.5s_ease-in-out_infinite_reverse]">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-sm bg-brand-400/30">{{> icons name="seal-check" class="text-sm text-brand-200"}}</span>
            <div class="h-2 w-28 rounded bg-white/40"></div>
          </div>
          <div class="mt-3 space-y-2">
            <div class="flex items-center gap-2">{{> icons name="check-circle" class="text-xs text-brand-200"}}<div class="h-1.5 w-4/5 rounded bg-white/25"></div></div>
            <div class="flex items-center gap-2">{{> icons name="check-circle" class="text-xs text-brand-200"}}<div class="h-1.5 w-3/5 rounded bg-white/25"></div></div>
            <div class="flex items-center gap-2">{{> icons name="circle" class="text-xs text-white/40"}}<div class="h-1.5 w-2/3 rounded bg-white/25"></div></div>
          </div>
        </div>

        <div class="absolute left-1/3 top-32 w-60 rounded-card bg-brand-800 p-4 ring-1 ring-white/20 [animation:ns-float_9.5s_ease-in-out_1.2s_infinite]">
          <div class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-error/70"></span><span class="h-2 w-2 rounded-full bg-warning/70"></span><span class="h-2 w-2 rounded-full bg-success/70"></span>
          </div>
          <div class="mt-3 space-y-2 font-mono">
            <div class="h-1.5 w-1/2 rounded bg-brand-300/50"></div>
            <div class="ml-4 h-1.5 w-2/3 rounded bg-white/25"></div>
            <div class="ml-4 h-1.5 w-1/2 rounded bg-white/25"></div>
            <div class="h-1.5 w-1/3 rounded bg-brand-300/50"></div>
          </div>
        </div>
      </div>
    </div>
  </header>

  {{!-- ── Section cards ── --}}
  <main class="ns-container ns-section">
    <div class="ns-grid ns-grid--3">
      {{> "docs/sections" view="card"}}
    </div>

    {{!-- No-results (search) --}}
    <p x-show="q !== '' && ![...document.querySelectorAll('[data-cat] a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))"
       x-cloak class="ns-empty mt-10">
      {{t "No articles match your search."}}
    </p>

    {{!-- Contributor CTA — the theme's .ns-cta-band, not a bespoke box --}}
    <div class="ns-cta-band ns-cta-band--start mt-12">
      <div>
        <h3 class="ns-cta-band__title">{{t "Help improve these docs"}}</h3>
        <p class="ns-cta-band__sub">{{t "Spotted a gap or an error? Request contributor access or open an edit on GitHub — docs are community-maintained."}}</p>
      </div>
      <div class="ns-cta-band__actions">
        <a href="https://github.com/imswarnil/Namaste-Salesforce/issues/new?labels=docs&title=Docs%20feedback" target="_blank" rel="noopener" class="ns-btn ns-btn--primary">{{> icons name="github" class="h-4 w-4"}}{{t "Edit on GitHub"}}</a>
        <a href="/contact/" class="ns-btn ns-btn--outline">{{> icons name="user-plus" class="h-4 w-4"}}{{t "Request access"}}</a>
      </div>
    </div>
  </main>
</div>
