{{!< default}}
{{!-- documentation.hbs — Documentation hub (index).
     Two-column layout: collapsible sidebar + a grid of doc cards. --}}

{{> "components/page-header" icon="ph-book-open" eyebrow="Documentation" title="Documentation" subtitle="Guides, references and how-tos for the Namaste Salesforce platform."}}

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
  <div class="grid gap-8 lg:grid-cols-[16rem_1fr]">

    {{> "docs/sidebar"}}

    <main role="main">
      <h2 class="font-heading text-2xl font-extrabold">{{t "All articles"}}</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {{#get "posts" filter="tag:documentation" limit="100" order="published_at asc"}}
          {{#foreach posts}}
            <a href="{{url}}" class="js-spotlight group relative flex items-start gap-3 overflow-hidden rounded-card border border-border bg-surface-raised p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-raised">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-500/10 text-xl text-brand-600 dark:text-brand-300">
                <i class="ph-fill ph-file-text" aria-hidden="true"></i>
              </span>
              <span class="relative">
                <span class="block font-heading font-bold transition-colors group-hover:text-brand-600 dark:group-hover:text-brand-300">{{title}}</span>
                <span class="mt-1 block text-sm text-muted">{{excerpt words="14"}}&hellip;</span>
              </span>
            </a>
          {{/foreach}}
        {{else}}
          <p class="text-muted">{{t "No documentation yet."}}</p>
        {{/get}}
      </div>
    </main>
  </div>
</section>
