{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  courses.hbs — the course catalog.

  The design system's `.ns-course-listing`: a filter rail beside a grid, the
  same shape as the blog listing so a reader who has used one has used both.

  ONE DEPARTURE FROM THE SYSTEM'S TEMPLATE, and it is a platform limit rather
  than a preference. Upstream the rail is a real `<form method="get">` that
  works with JavaScript off, because the app filters server-side. Ghost has no
  server-side facet filtering — a GET here would reload the page and be
  ignored — so the controls stay native and Alpine hides the non-matching
  cards client-side. The MARKUP is the system's; only the engine differs.

  THE COUNTS ARE REAL. Each facet's number comes from its own {{#get}} against
  Ghost rather than a hard-coded figure: a facet count that disagrees with the
  grid is worse than no count at all.
═══════════════════════════════════════════════════════════════════════════ --}}

{{#page}}
  {{> "components/page-header" icon="graduation-cap" eyebrow="Learning paths" title=title subtitle=custom_excerpt}}
{{else}}
  {{> "components/page-header" icon="graduation-cap" eyebrow="Learning paths" title="Course Catalog" subtitle="Structured learning paths to take you from beginner to Salesforce expert."}}
{{/page}}

<section class="ns-band ns-band--tight ns-band--sunken">
  <div class="ns-band__inner">
    <dl class="ns-statband">
      <div class="ns-statband__cell"><dd class="ns-statband__value">{{pagination.total}}</dd><dt class="ns-statband__label">{{t "Courses"}}</dt></div>
      {{#get "posts" filter="tag:hash-lesson" limit="1" as |l|}}
        <div class="ns-statband__cell"><dd class="ns-statband__value">{{l.pagination.total}}</dd><dt class="ns-statband__label">{{t "Lessons"}}</dt></div>
      {{/get}}
      <div class="ns-statband__cell"><dd class="ns-statband__value">{{t "All"}}</dd><dt class="ns-statband__label">{{t "Levels"}}</dt></div>
      <div class="ns-statband__cell"><dd class="ns-statband__value">∞</dd><dt class="ns-statband__label">{{t "Lifetime access"}}</dt></div>
    </dl>
  </div>
</section>

<div class="ns-container ns-course-listing"
  x-data="{
    q:'', price:'all', lv:{beginner:false,intermediate:false,advanced:false}, author:'', open:false,
    show(el){ var d=el.dataset;
      if(d.sponsored) return true;
      if(this.q && d.title.toLowerCase().indexOf(this.q.toLowerCase())===-1) return false;
      if(this.price!=='all' && d.price!==this.price) return false;
      var anyLv = this.lv.beginner || this.lv.intermediate || this.lv.advanced;
      if(anyLv && !this.lv[d.level]) return false;
      if(this.author && d.author!==this.author) return false;
      return true; },
    get any(){ return this.q || this.price!=='all' || this.author || this.lv.beginner || this.lv.intermediate || this.lv.advanced; },
    reset(){ this.q=''; this.price='all'; this.lv={beginner:false,intermediate:false,advanced:false}; this.author=''; }
  }">

  {{!-- The rail folds behind a control on a phone; that button is the only
       part of this the system does not model. --}}
  <button type="button" class="ns-btn ns-btn--outline ns-btn--sm ns-filters__toggle" @click="open=!open">
    {{> icons name="funnel"}}{{t "Filters"}}
  </button>

  <form class="ns-filters ns-course-listing__rail" :class="open ? 'is-open' : ''" @submit.prevent>
    <div class="ns-filters__head">
      <span class="ns-filters__title">{{t "Filters"}}</span>
      <button type="button" class="ns-btn ns-btn--quiet ns-btn--xs ns-filters__clear" @click="reset()" x-show="any" x-cloak>{{t "Clear all"}}</button>
    </div>

    <label class="ns-input-wrap ns-filters__search">
      <span class="ns-visually-hidden">{{t "Search courses"}}</span>
      {{> icons name="search" class="ns-input-wrap__icon"}}
      <input x-model="q" type="search" class="ns-input ns-input--has-icon" placeholder="{{t "Find a course"}}" autocomplete="off">
    </label>

    <details class="ns-filters__group" open>
      <summary class="ns-filters__legend">{{t "Price"}}{{> icons name="caret-down"}}</summary>
      <div class="ns-filters__list">
        <label class="ns-choice"><input class="ns-radio" type="radio" name="price" value="all" x-model="price"><span>{{t "All"}}</span><span class="ns-filters__count">{{pagination.total}}</span></label>
        {{#get "posts" filter="tag:hash-course+tag:hash-free" limit="1" as |f|}}
          <label class="ns-choice"><input class="ns-radio" type="radio" name="price" value="free" x-model="price"><span>{{t "Free"}}</span><span class="ns-filters__count">{{f.pagination.total}}</span></label>
        {{/get}}
        {{#get "posts" filter="tag:hash-course+tag:hash-paid" limit="1" as |p|}}
          <label class="ns-choice"><input class="ns-radio" type="radio" name="price" value="paid" x-model="price"><span>{{t "Members"}}</span><span class="ns-filters__count">{{p.pagination.total}}</span></label>
        {{/get}}
      </div>
    </details>

    <details class="ns-filters__group" open>
      <summary class="ns-filters__legend">{{t "Level"}}{{> icons name="caret-down"}}</summary>
      <div class="ns-filters__list">
        {{#get "posts" filter="tag:hash-course+tag:hash-level-beginner" limit="1" as |b|}}
          <label class="ns-choice"><input class="ns-checkbox" type="checkbox" x-model="lv.beginner"><span class="ns-dot ns-dot--beginner"></span><span>{{t "Beginner"}}</span><span class="ns-filters__count">{{b.pagination.total}}</span></label>
        {{/get}}
        {{#get "posts" filter="tag:hash-course+tag:hash-level-intermediate" limit="1" as |i|}}
          <label class="ns-choice"><input class="ns-checkbox" type="checkbox" x-model="lv.intermediate"><span class="ns-dot ns-dot--intermediate"></span><span>{{t "Intermediate"}}</span><span class="ns-filters__count">{{i.pagination.total}}</span></label>
        {{/get}}
        {{#get "posts" filter="tag:hash-course+tag:hash-level-advanced" limit="1" as |a|}}
          <label class="ns-choice"><input class="ns-checkbox" type="checkbox" x-model="lv.advanced"><span class="ns-dot ns-dot--advanced"></span><span>{{t "Advanced"}}</span><span class="ns-filters__count">{{a.pagination.total}}</span></label>
        {{/get}}
      </div>
    </details>

    <details class="ns-filters__group">
      <summary class="ns-filters__legend">{{t "Instructor"}}{{> icons name="caret-down"}}</summary>
      <div class="ns-filters__list">
        <label class="ns-choice"><input class="ns-radio" type="radio" name="author" value="" x-model="author"><span>{{t "Anyone"}}</span></label>
        {{#get "authors" limit="8" include="count.posts"}}{{#foreach authors}}
          <label class="ns-choice"><input class="ns-radio" type="radio" name="author" value="{{slug}}" x-model="author">
            {{#if profile_image}}<span class="ns-avatar ns-avatar--sm"><img loading="lazy" decoding="async" src="{{img_url profile_image size="xxs"}}" alt=""></span>{{/if}}
            <span>{{name}}</span><span class="ns-filters__count">{{count.posts}}</span></label>
        {{/foreach}}{{/get}}
      </div>
    </details>
  </form>

  <div>
    {{!-- The applied set, echoed above the grid: a filter you cannot see is a
         filter you forget you set. --}}
    <div class="ns-filters__applied" x-show="any" x-cloak>
      <template x-if="q"><button type="button" class="ns-tag" @click="q=''"><span x-text="q"></span> ✕</button></template>
      <template x-if="price!=='all'"><button type="button" class="ns-tag" @click="price='all'"><span x-text="price"></span> ✕</button></template>
      <template x-if="author"><button type="button" class="ns-tag" @click="author=''"><span x-text="author"></span> ✕</button></template>
    </div>

    <div class="ns-course-grid">
      {{> "courses/sponsored-card"}}

      {{#foreach posts}}
        <div x-show="show($el.firstElementChild)">{{> "courses/course-card"}}</div>
        {{#has number="nth:6"}}<div class="ns-course-grid__full">{{> "ads/leaderboard"}}</div>{{/has}}
      {{else}}
        <div class="ns-empty ns-empty--lg ns-course-grid__full">
          {{> icons name="graduation-cap" class="ns-empty__icon"}}
          <p class="ns-empty__title">{{t "Courses coming soon!"}}</p>
        </div>
      {{/foreach}}
    </div>

    {{pagination}}
  </div>
</div>

{{!-- Become an author --}}
<section class="ns-band ns-band--dark ns-band--grid ns-defer ns-defer--sm">
  <div class="ns-band__inner">
    <div class="ns-band__head ns-band__head--center">
      <p class="ns-kicker ns-kicker--light">{{t "Teach with us"}}</p>
      <h2 class="ns-band__title">{{t "Know Salesforce? Become an author."}}</h2>
      <p class="ns-band__lede">{{t "Share your expertise with thousands of learners. Publish a course or lesson — open, credited, and forever free to read."}}</p>
      <div class="ns-band__actions">
        <a href="{{#if @custom.become_author_url}}{{@custom.become_author_url}}{{else}}/become-author/{{/if}}" class="ns-btn ns-btn--white">{{> icons name="pen-nib"}}{{t "Become an author"}}</a>
        <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="ns-btn ns-btn--glass">{{> icons name="github"}}{{t "Contribute"}}</a>
      </div>
    </div>
  </div>
</section>
