{{!< default}}

{{!-- /courses — the catalogue. The filter toolbar is built from
the internal #course-level-* and #course-duration-* tags that
exist in the catalogue right now: publish a course with a new
level tag and the button appears; retire the last course with it
and the button goes. Button values and card data-attributes are
the same tag slugs, so assets/js/filters.js just compares
strings. Hero copy comes from the "courses" page
(`data: page.courses`). --}}

<section class="courses-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="inner relative">
        <span class="kicker">{{> "icons/graduation-cap"}} {{t "Courses"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Structured, lesson-by-lesson paths. Pick one and start building."}}{{/if}}</p>
        {{else}}
            <h1>{{t "Courses"}}</h1>
            <p>{{t "Structured, lesson-by-lesson paths. Pick one and start building."}}</p>
        {{/page}}
    </div>
</section>

<main id="site-main" class="courses-main outer">
    <div class="inner">

        {{!-- The toolbar's buttons are BUILT BY assets/js/filters.js
        from the data-level / data-duration attributes on the cards
        below — {{#get "tags"}} cannot see internal tags (Ghost serves
        themes through TagPublic), and deriving from the page keeps the
        toolbar incapable of disagreeing with the catalogue. The group
        shells stay hidden until they have at least two options. --}}
        <div class="filter-bar" data-filter-bar hidden>
            <div class="filter-group" data-filter-group="level" hidden>
                <span class="filter-label">{{> "icons/signal"}} {{t "Level"}}</span>
            </div>
            <div class="filter-group" data-filter-group="duration" hidden>
                <span class="filter-label">{{> "icons/clock"}} {{t "Duration"}}</span>
            </div>
            <button class="filter-clear" data-filter-clear>{{t "Clear filters"}}</button>
        </div>

        <div class="card-grid">
            {{#foreach posts}}
                {{> "card-course"}}
            {{/foreach}}
        </div>

        <div class="filter-empty" data-filter-empty>
            {{t "No courses match those filters — try clearing one."}}
        </div>

        {{pagination}}

    </div>
</main>
