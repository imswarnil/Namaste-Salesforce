{{!< default}}
{{!-- The course catalogue. Uses the course card, which counts each course's
     lessons from the posts carrying its tag — Ghost has no "lessons"
     relation, so a course IS a tag. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <p class="ns-kicker">{{t "Learn"}}</p>
            {{#page}}
                <h1 class="ns-band__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
            {{else}}
                <h1 class="ns-band__title">{{t "Courses"}}</h1>
                <p class="ns-band__lede">{{t "Structured, start to finish."}}</p>
            {{/page}}
        </div>
    </div>
</section>
{{> "collection" card="course"}}
