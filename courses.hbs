{{!< default}}
{{!-- courses.hbs — course catalog. Animated stats · fixed filter sidebar
     (search · price · level · duration slider · author) · course grid with a
     sponsored card and a leaderboard ad after every 4 courses · become-author
     band. Filtering is client-side (Alpine reads each card's data-* attrs). --}}

{{#page}}
  {{> "components/page-header" icon="graduation-cap" eyebrow="Learning paths" title=title subtitle=custom_excerpt}}
{{else}}
  {{> "components/page-header" icon="graduation-cap" eyebrow="Learning paths" title="Course Catalog" subtitle="Structured learning paths to take you from beginner to Salesforce expert."}}
{{/page}}

{{!-- Stats — simple inline row --}}
<section class="border-b border-border bg-surface-sunken">
  <div class="ns-cat-stats mx-auto max-w-4xl px-4 py-6 sm:px-6">
    <div class="ns-cat-stat">{{> icons name="graduation-cap"}}<b class="js-count" data-to="{{pagination.total}}">0</b><span>{{t "Courses"}}</span></div>
    {{#get "posts" filter="tag:hash-lesson" limit="1"}}<div class="ns-cat-stat">{{> icons name="play-circle"}}<b class="js-count" data-to="{{pagination.total}}">0</b><span>{{t "Lessons"}}</span></div>{{/get}}
    <div class="ns-cat-stat">{{> icons name="medal"}}<b>{{t "All"}}</b><span>{{t "Levels"}}</span></div>
    <div class="ns-cat-stat">{{> icons name="infinity"}}<b>{{t "Lifetime"}}</b><span>{{t "Access"}}</span></div>
  </div>
</section>

{{!-- Catalog with filters --}}
<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-14"
  x-data="{
    q:'', price:'all', lv:{beginner:false,intermediate:false,advanced:false}, author:'', maxH:13, open:false,
    mins(s){ s=s||''; var h=(s.match(/(\d+)h/)||[])[1]||0; var m=(s.match(/(\d+)m/)||[])[1]||0; return (+h)*60+(+m); },
    show(el){ var d=el.dataset;
      if(d.sponsored) return true;
      if(this.q && d.title.toLowerCase().indexOf(this.q.toLowerCase())===-1) return false;
      if(this.price!=='all' && d.price!==this.price) return false;
      var anyLv = this.lv.beginner || this.lv.intermediate || this.lv.advanced;
      if(anyLv && !this.lv[d.level]) return false;
      if(this.author && d.author!==this.author) return false;
      if(this.mins(d.duration) > this.maxH*60) return false;
      return true; },
    reset(){ this.q=''; this.price='all'; this.lv={beginner:false,intermediate:false,advanced:false}; this.author=''; this.maxH=13; }
  }">

  {{!-- mobile filter toggle --}}
  <button type="button" class="ns-btn ns-btn--outline ns-btn--sm mb-4 lg:hidden" @click="open=!open">{{> icons name="funnel"}}{{t "Filters"}}</button>

  <div class="grid gap-8 lg:grid-cols-[16rem_minmax(0,1fr)]">

    {{!-- ── Filter sidebar ── --}}
    {{!-- The system's filter rail (ds/components/css/catalog.css). Groups are
         <details>, so a long facet list collapses and stays collapsed on a
         phone; the legend is the <summary>. `is-open` is the theme's own
         mobile disclosure and is the one rule site-catalog.css still owns. --}}
    <aside class="ns-filters" :class="open ? 'is-open' : ''">
      <div class="lg:sticky lg:top-20">
        <div class="ns-filters__head">
          <h2 class="ns-filters__title">{{t "Filters"}}</h2>
          <button type="button" class="ns-btn ns-btn--ghost ns-btn--sm ns-filters__clear" @click="reset()">{{t "Reset"}}</button>
        </div>

        <label class="ns-input-wrap ns-filters__search">
          {{> icons name="search" class="ns-input-wrap__icon"}}
          <input x-model="q" type="search" placeholder="{{t "Search courses…"}}" aria-label="{{t "Search"}}" class="ns-input ns-input--has-icon">
        </label>

        {{!-- Price --}}
        <details class="ns-filters__group" open>
          <summary class="ns-filters__legend">{{t "Price"}}{{> icons name="caret-down"}}</summary>
          <div class="ns-filters__list">
            <label class="ns-choice"><input class="ns-radio" type="radio" name="price" value="all" x-model="price"><span>{{t "All"}}</span></label>
            <label class="ns-choice"><input class="ns-radio" type="radio" name="price" value="free" x-model="price"><span>{{t "Free"}}</span></label>
            <label class="ns-choice"><input class="ns-radio" type="radio" name="price" value="paid" x-model="price"><span>{{t "Members / Paid"}}</span></label>
          </div>
        </details>

        {{!-- Level --}}
        <details class="ns-filters__group" open>
          <summary class="ns-filters__legend">{{t "Level"}}{{> icons name="caret-down"}}</summary>
          <div class="ns-filters__list">
            <label class="ns-choice"><input class="ns-checkbox" type="checkbox" x-model="lv.beginner"><span class="ns-dot ns-dot--beginner"></span><span>{{t "Beginner"}}</span></label>
            <label class="ns-choice"><input class="ns-checkbox" type="checkbox" x-model="lv.intermediate"><span class="ns-dot ns-dot--intermediate"></span><span>{{t "Intermediate"}}</span></label>
            <label class="ns-choice"><input class="ns-checkbox" type="checkbox" x-model="lv.advanced"><span class="ns-dot ns-dot--advanced"></span><span>{{t "Advanced"}}</span></label>
          </div>
        </details>

        {{!-- Duration --}}
        <details class="ns-filters__group" open>
          <summary class="ns-filters__legend">{{t "Max duration"}}{{> icons name="caret-down"}}</summary>
          <div class="ns-filters__list">
            <input type="range" min="1" max="13" step="1" x-model.number="maxH" class="ns-slider">
            <p class="text-sm text-muted"><span x-text="maxH"></span>{{t "h or less"}}</p>
          </div>
        </details>

        {{!-- Author --}}
        <details class="ns-filters__group" open>
          <summary class="ns-filters__legend">{{t "Instructor"}}{{> icons name="caret-down"}}</summary>
          <div class="ns-filters__list">
            <label class="ns-choice"><input class="ns-radio" type="radio" name="author" value="" x-model="author"><span>{{t "Anyone"}}</span></label>
            {{#get "authors" limit="8"}}{{#foreach authors}}
              <label class="ns-choice"><input class="ns-radio" type="radio" name="author" value="{{slug}}" x-model="author">
                {{#if profile_image}}<span class="ns-avatar ns-avatar--sm"><img loading="lazy" decoding="async" src="{{img_url profile_image size="xxs"}}" alt=""></span>{{/if}}
                <span class="truncate">{{name}}</span></label>
            {{/foreach}}{{/get}}
          </div>
        </details>
      </div>
    </aside>

    {{!-- ── Grid ── --}}
    <div>
      <div class="ns-catalog-grid">
        {{!-- Sponsored card leads --}}
        {{> "courses/sponsored-card"}}

        {{#foreach posts}}
          <div x-show="show($el.firstElementChild)">{{> "courses/course-card"}}</div>
          {{#has number="nth:4"}}<div class="ns-catalog-grid__full">{{> "ads/leaderboard"}}</div>{{/has}}
        {{else}}
          <div class="ns-empty ns-empty--lg ns-catalog-grid__full">
            {{> icons name="graduation-cap" class="mb-3 text-4xl"}}
            <p class="text-lg font-semibold">{{t "Courses coming soon!"}}</p>
          </div>
        {{/foreach}}
      </div>

      {{pagination}}
    </div>
  </div>
</section>

{{!-- Become an author (animated) --}}
<section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
  <div class="ns-become ns-aurora relative overflow-hidden rounded-card bg-brand-900 p-8 text-white sm:p-10">
    <div aria-hidden="true" class="bg-dots pointer-events-none absolute inset-0 text-white/40"></div>
    <div class="relative grid items-center gap-6 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="ns-kicker ns-kicker--light">{{t "Teach with us"}}</p>
        <h2 class="mt-2 font-heading text-2xl font-extrabold sm:text-3xl">{{t "Know Salesforce? Become an author."}}</h2>
        <p class="mt-2 max-w-xl text-white/80">{{t "Share your expertise with thousands of learners. Publish a course or lesson — open, credited, and forever free to read."}}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/become-author/" class="ns-btn ns-btn--white">{{> icons name="pen-nib"}}{{t "Become an author"}}</a>
        <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="ns-btn ns-btn--glass">{{> icons name="github" class="h-5 w-5"}}{{t "Contribute"}}</a>
      </div>
    </div>
    {{!-- animated orbiting glyphs --}}
    <span class="ns-become__orbit ns-become__orbit--1">{{> icons name="code"}}</span>
    <span class="ns-become__orbit ns-become__orbit--2">{{> icons name="lightbulb"}}</span>
    <span class="ns-become__orbit ns-become__orbit--3">{{> icons name="rocket"}}</span>
  </div>
</section>
