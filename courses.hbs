{{!< default}}
{{!-- The course catalogue, on NSDS's course-listing.html.

     Courses are `.ns-path__card` — glyph-led — because a course is a
     DESTINATION you choose. Training sections are `.ns-trackcard`, numeral-
     led, because they are an order you follow. Same underlying data, two
     shapes, and the shape carries the meaning.

     `posts` is the collection: the course overview posts, filtered by
     `tag:hash-course` in routes.yaml. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <p class="ns-kicker">{{t "Learn"}}</p>
            {{#page}}
                <h1 class="ns-band__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
            {{else}}
                <h1 class="ns-band__title">{{t "Courses"}}</h1>
                <p class="ns-band__lede">{{t "Structured, start to finish. Pick the one you need."}}</p>
            {{/page}}
        </div>
    </div>
</section>

<section class="ns-band">
    <div class="ns-band__inner">
        {{#if posts}}
            <div class="ns-path">{{#foreach posts}}{{> "cards/path-card"}}{{/foreach}}</div>
        {{else}}
            <p class="ns-empty">{{t "No courses yet."}}</p>
        {{/if}}
        {{pagination}}
    </div>
</section>
