{{!< default}}

{{!-- 1. COURSE CATALOG HERO --}}
{{#page}}
<section class="hero is-medium has-background-dark has-text-white position-relative" style="background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)){{#if feature_image}}, url({{img_url feature_image size='xl'}}){{/if}}; background-size: cover; background-position: center;">
  <div class="hero-body px-4-mobile">
    <div class="container has-text-centered py-6">
      <span class="icon is-large has-text-primary mb-3">
        <i class="fas fa-2x fa-graduation-cap"></i>
      </span>
      <h1 class="title is-2-mobile is-1-tablet has-text-white has-text-weight-bold mb-4">{{title}}</h1>
      {{#if custom_excerpt}}
        <h2 class="subtitle is-5-mobile is-4-tablet has-text-grey-light mx-auto" style="max-width: 600px;">
          {{custom_excerpt}}
        </h2>
      {{/if}}
    </div>
  </div>
</section>
{{else}}
<section class="hero is-medium has-background-dark has-text-white">
  <div class="hero-body px-4-mobile">
    <div class="container has-text-centered py-6">
      <h1 class="title is-2-mobile is-1-tablet has-text-white has-text-weight-bold mb-4">Course Catalog</h1>
      <h2 class="subtitle is-5-mobile is-4-tablet has-text-grey-light mx-auto" style="max-width: 600px;">
        Structured learning paths to take you from beginner to Salesforce expert.
      </h2>
    </div>
  </div>
</section>
{{/page}}

{{!-- 2. COURSES GRID WITH EMBEDDED LESSONS --}}
<section class="section has-background-white-ter py-6 px-4-mobile">
  <div class="container">
    
    <div class="columns is-multiline">
      {{!-- Loops through the PARENT COURSES (filter: tag:hash-course) --}}
      {{#foreach posts}}
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          
          <div class="card is-flex is-flex-direction-column is-shadowless" style="height: 100%; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 25px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
            
            {{!-- Course Image --}}
            {{#if feature_image}}
              <div class="card-image">
                <a href="{{url}}">
                  <figure class="image is-16by9">
                    <img src="{{img_url feature_image size="m"}}" alt="{{title}}" style="object-fit: cover; height: 100%; width: 100%;">
                  </figure>
                </a>
              </div>
            {{/if}}

            {{!-- Course Content --}}
            <div class="card-content is-flex-grow-1 is-flex is-flex-direction-column p-4-mobile p-5-tablet">
              
              <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                {{#if primary_tag}}
                  <span class="tag is-primary is-light is-rounded has-text-weight-bold">
                    {{primary_tag.name}}
                  </span>
                {{/if}}
                <span class="is-size-7 has-text-grey has-text-weight-semibold">
                  <i class="far fa-clock mr-1"></i> {{reading_time minute="1 min" minutes="% mins"}}
                </span>
              </div>

              <h2 class="title is-4 mb-3" style="line-height: 1.3;">
                <a href="{{url}}" class="has-text-dark">{{title}}</a>
              </h2>

              <p class="is-size-6 has-text-grey mb-4">
                {{excerpt words="20"}}&hellip;
              </p>

              {{!-- ==============================================================
                    DYNAMIC LESSONS SYLLABUS
                    Fetches posts tagged with #lesson where the primary tag 
                    matches the current course's slug.
              ============================================================== --}}
              <div class="is-flex-grow-1 mt-2 mb-4">
                <p class="is-size-7 is-uppercase has-text-weight-bold has-text-grey-light tracking-wide mb-2">Syllabus</p>
                
                {{#get "posts" filter="tag:hash-lesson+primary_tag:{{slug}}" order="published_at asc" limit="all"}}
                  {{#if posts}}
                    {{!-- Scrollable container for lessons so the card doesn't get too long --}}
                    <div class="menu" style="max-height: 160px; overflow-y: auto; padding-right: 5px;">
                      <ul class="menu-list is-size-7">
                        {{#foreach posts}}
                          <li>
                            <a href="{{url}}" class="is-flex is-align-items-center has-text-grey-dark py-2 px-3 mb-1" style="border-radius: 6px; background-color: #f8fafc;">
                              <span class="icon is-small has-text-primary mr-2"><i class="fas fa-play-circle"></i></span>
                              <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                {{@number}}. {{title}}
                              </span>
                            </a>
                          </li>
                        {{/foreach}}
                      </ul>
                    </div>
                  {{else}}
                    <div class="has-background-light has-text-grey is-size-7 p-3" style="border-radius: 6px;">
                      <i class="fas fa-tools mr-1"></i> Lessons are being added...
                    </div>
                  {{/if}}
                {{/get}}
              </div>

              {{!-- Action Button --}}
              <div class="mt-auto pt-4" style="border-top: 1px solid #f5f5f5;">
                <a href="{{url}}" class="button is-primary is-fullwidth is-outlined has-text-weight-bold is-rounded">
                  View Course Details
                </a>
              </div>

            </div>
          </div>
          
        </div>
      {{/foreach}}
    </div>

    {{!-- 3. PAGINATION --}}
    <div class="mt-6 pt-4 is-flex is-justify-content-center">
      {{pagination}}
    </div>

  </div>
</section>