{{!< default}}

{{!-- Structured data for this listing page. Keep `filter` identical
to this collection's filter in routes.yaml. --}}
{{> "json-ld-collection" name="Courses" path="courses" filter="tag:hash-course" itemType="Course"}}

{{!-- /courses — the catalogue. The filter sidebar is built from
the internal #course-level-* and #course-duration-* tags that
exist in the catalogue right now: publish a course with a new
level tag and the button appears; retire the last course with it
and the button goes. Button values and card data-attributes are
the same tag slugs, so assets/js/filters.js just compares
strings. Hero copy comes from the "courses" page
(`data: page.courses`). --}}

<section class="courses-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="inner relative">
        <span class="kicker">{{> "icons/graduation-cap"}} {{t "Courses"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Structured, lesson-by-lesson paths. Pick one and start building."}}{{/if}}</p>
        {{else}}
            <h1>{{t "Courses"}}</h1>
            <p>{{t "Structured, lesson-by-lesson paths. Pick one and start building."}}</p>
        {{/page}}
    </div>
</section>

<main id="site-main" class="courses-main outer">
    <div class="inner listing-layout">

        {{!-- The sidebar. Filters first — their buttons are BUILT BY
        assets/js/filters.js from the data-level / data-duration
        attributes on the cards ({{#get "tags"}} cannot see internal
        tags), so the sidebar can never disagree with the catalogue,
        and it stays hidden until a facet has two options. Under it,
        the ad slot and the newsletter card; the whole column sticks. --}}
        <aside class="listing-side">
            <div class="listing-side-sticky">
                <div class="filter-sidebar" data-filter-bar hidden>
                    <div class="filter-side-group" data-filter-group="level" hidden>
                        <h4 class="widget-title">{{> "icons/signal"}} {{t "Level"}}</h4>
                    </div>
                    <div class="filter-side-group" data-filter-group="duration" hidden>
                        <h4 class="widget-title">{{> "icons/clock"}} {{t "Duration"}}</h4>
                    </div>
                    <button class="filter-clear" data-filter-clear>{{t "Clear filters"}}</button>
                </div>

                {{> "widgets/share-ask"}}

                {{#if @site.members_enabled}}
                    {{^if @member}}
                        {{> "widgets/newsletter"}}
                    {{/if}}
                {{/if}}
            </div>
        </aside>

        <div class="listing-main">
            <div class="card-grid">
                {{#foreach posts}}
                    {{> "card-course"}}
                {{/foreach}}
            </div>

            <div class="filter-empty" data-filter-empty>
                {{t "No courses match those filters — try clearing one."}}
            </div>

            {{pagination}}
        </div>

    </div>
</main>
