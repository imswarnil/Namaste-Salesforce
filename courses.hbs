{{!< default}}

{{!-- JSON‑LD for courses --}}
{{#contentFor "head-after"}}
    {{#get "posts" filter="tag:hash-course" include="authors,tags" limit="all" as |all_courses|}}
        {{#if all_courses}}
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ItemList",
                "name": "All Courses",
                "itemListElement": [
                {{#foreach all_courses}}
                    {
                        "@type": "ListItem",
                        "position": {{@number}},
                        "url": "{{url}}",
                        "item": {
                            "@type": "Course",
                            "name": "{{title}}",
                            "description": "{{excerpt}}",
                            "provider": {
                                "@type": "Organization",
                                "name": "{{@site.title}}",
                                "sameAs": "{{@site.url}}"
                            },
                            "author": {
                                "@type": "Person",
                                "name": "{{#if authors}}{{authors.[0].name}}{{/if}}"
                            }
                        }
                    }{{#unless @last}},{{/unless}}
                {{/foreach}}
                ]
            }
            </script>
        {{/if}}
    {{/get}}
{{/contentFor}}

<main>

    {{!-- Hero section with stats (dynamic) --}}
    {{#page}}
    <section class="hero is-small has-background-white-bis">
        <div class="hero-body py-6">
            <div class="container is-max-widescreen">

                <div class="columns is-vcentered is-variable is-5">
                    <div class="column is-narrow has-text-centered-mobile">
                        <span class="icon is-large has-text-primary">
                            <i class="ph-duotone ph-graduation-cap is-size-1" aria-hidden="true"></i>
                        </span>
                    </div>
                    <div class="column">
                        <h1 class="title is-2 has-text-dark mb-2">{{title}}</h1>
                        {{#if custom_excerpt}}
                            <p class="subtitle is-5 has-text-grey">{{custom_excerpt}}</p>
                        {{else}}
                            <p class="subtitle is-5 has-text-grey">
                                Practical Salesforce courses — Admin, Developer, and Architect tracks built for real outcomes.
                            </p>
                        {{/if}}
                    </div>
                </div>

                {{!-- Stats using Bulma level --}}
                {{#get "posts" filter="tag:hash-course" limit="1" as |courses_count|}}
                    {{#get "authors" limit="1" as |authors_count|}}
                        <div class="level is-mobile mt-5">
                            <div class="level-item has-text-centered">
                                <div>
                                    <p class="heading">Courses</p>
                                    <p class="title is-5">{{courses_count.pagination.total}}</p>
                                </div>
                            </div>
                            <div class="level-item has-text-centered">
                                <div>
                                    <p class="heading">Instructors</p>
                                    <p class="title is-5">{{authors_count.pagination.total}}</p>
                                </div>
                            </div>
                            <div class="level-item has-text-centered">
                                <div>
                                    <p class="heading">Lessons</p>
                                    <p class="title is-5">100+</p>
                                </div>
                            </div>
                            <div class="level-item has-text-centered">
                                <div>
                                    <p class="heading">Start</p>
                                    <p class="title is-5">Free</p>
                                </div>
                            </div>
                        </div>
                    {{/get}}
                {{/get}}

            </div>
        </div>
    </section>
    {{/page}}

    {{!-- Sponsored course (page 1 only) --}}
    {{#match pagination.page "=" 1}}
        <section class="section">
            <div class="container is-max-widescreen">
                <div class="notification is-warning is-light">
                    <div class="columns is-vcentered is-variable is-5">
                        <div class="column is-narrow">
                            <span class="tag is-warning is-medium">
                                <span class="icon is-small"><i class="ph ph-seal-check"></i></span>
                                <span>Sponsored</span>
                            </span>
                        </div>
                        <div class="column">
                            <p class="has-text-weight-semibold has-text-dark mb-1">
                                Salesforce Platform Developer I — Cert Bootcamp
                            </p>
                            <p class="is-size-7 has-text-grey">
                                Intensive PD1 exam prep. Covers Apex, SOQL, triggers, LWC fundamentals, and the Salesforce data model.
                            </p>
                        </div>
                        <div class="column is-narrow">
                            <a href="/courses/" class="button is-warning is-small">
                                <span class="icon is-small"><i class="ph ph-arrow-right"></i></span>
                                <span>Learn More</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {{/match}}

    {{!-- Featured courses (page 1 only) --}}
    {{#match pagination.page "=" 1}}
        {{#get "posts" filter="tag:hash-course+featured:true" include="tags,authors" limit="3" as |featured|}}
            {{#if featured}}
                <section class="section">
                    <div class="container is-max-widescreen">
                        <div class="is-flex is-align-items-center mb-5">
                            <h2 class="title is-5 mb-0 has-text-primary">
                                <span class="icon mr-1"><i class="ph-fill ph-star"></i></span>
                                Featured Courses
                            </h2>
                            <hr class="ml-4 is-flex-grow-1">
                        </div>
                        <div class="columns is-multiline is-variable is-5">
                            {{#foreach featured}}
                                <div class="column is-12-mobile is-6-tablet is-4-desktop">
                                    {{> "post-card" lazyLoading=true}}
                                </div>
                            {{/foreach}}
                        </div>
                    </div>
                </section>
            {{/if}}
        {{/get}}
    {{/match}}

    {{!-- All courses --}}
    <section class="section pt-0">
        <div class="container is-max-widescreen">

            <div class="is-flex is-align-items-center mb-5">
                <h2 class="title is-5 mb-0 has-text-dark">
                    <span class="icon has-text-grey mr-1"><i class="ph-fill ph-books"></i></span>
                    All Courses
                </h2>
                {{#if pagination}}
                    <span class="tag is-light ml-3">{{pagination.total}} total</span>
                {{/if}}
                <hr class="ml-4 is-flex-grow-1">
            </div>

            {{#if posts}}
                <div class="columns is-multiline is-variable is-5">
                    {{#foreach posts}}
                        <div class="column is-12-mobile is-6-tablet is-4-desktop">
                            {{> "post-card" lazyLoading=true}}
                        </div>

                        {{!-- Mid-grid CTA after 6th card (if exists) --}}
                        {{#match @index "=" 6}}
                            <div class="column is-12">
                                <div class="notification has-background-primary has-text-white p-5">
                                    <div class="columns is-vcentered is-variable is-6">
                                        <div class="column">
                                            <p class="heading has-text-white is-uppercase mb-2" style="opacity: .7;">
                                                <i class="ph ph-chalkboard-teacher mr-1"></i>
                                                For Salesforce Professionals
                                            </p>
                                            <h3 class="title is-4 has-text-white mb-3">Teach on Namaste Salesforce</h3>
                                            <p class="is-size-6 mb-4" style="opacity: .9;">
                                                Share your Salesforce knowledge with a growing community of learners.
                                                A single tutorial, a full course, or a certification walkthrough —
                                                your experience belongs here. No gatekeeping, free to publish.
                                            </p>
                                            <div class="tags are-medium">
                                                <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Free to publish</span>
                                                <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Ghost CMS editor</span>
                                                <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Open source platform</span>
                                                <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Real learner audience</span>
                                            </div>
                                        </div>
                                        <div class="column is-narrow">
                                            <div class="buttons is-flex-direction-column-mobile">
                                                <a href="/contact/" class="button is-white">
                                                    <span class="icon"><i class="ph ph-paper-plane-tilt"></i></span>
                                                    <span>Apply to Teach</span>
                                                </a>
                                                <a href="/contact/" class="button is-white is-outlined">
                                                    Ask a question
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {{/match}}
                    {{/foreach}}
                </div>

                {{!-- Pagination --}}
                {{#if pagination}}
                    <nav class="pagination is-centered mt-6" role="navigation">
                        {{pagination}}
                    </nav>
                {{/if}}
            {{else}}
                <div class="has-text-centered py-6">
                    <span class="icon is-large has-text-grey-light">
                        <i class="ph-duotone ph-warning-circle is-size-1"></i>
                    </span>
                    <p class="title is-5 has-text-grey mb-2">No courses found.</p>
                    <p class="subtitle is-6 has-text-grey-light">
                        Tag posts with <code>hash-course</code> to list them here.
                    </p>
                </div>
            {{/if}}

        </div>
    </section>

    {{!-- Bottom instructor CTA --}}
    <section class="section has-background-white-bis">
        <div class="container is-max-widescreen">
            <div class="notification has-background-primary has-text-white p-6">
                <div class="columns is-vcentered is-variable is-8">
                    <div class="column">
                        <p class="heading has-text-white is-uppercase mb-3" style="opacity: .7;">
                            <i class="ph ph-chalkboard-teacher mr-1"></i>
                            Open to all Salesforce professionals
                        </p>
                        <h2 class="title is-3 has-text-white mb-4">Share your Salesforce knowledge. Teach here.</h2>
                        <p class="is-size-5 mb-5" style="opacity: .9; max-width: 46rem;">
                            Namaste Salesforce is an open source, community-first learning platform.
                            If you've solved real Salesforce problems — in admin, development, or architecture —
                            there's a place for your course here. No complicated setup, no revenue split.
                            Just Ghost CMS and a community that wants to learn from practitioners.
                        </p>
                        <div class="tags are-medium">
                            <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Completely free to publish</span>
                            <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Ghost CMS — clean writing experience</span>
                            <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Open source — your content, your control</span>
                            <span class="tag is-light"><i class="ph-check-circle mr-1"></i> Real Salesforce learner audience</span>
                        </div>
                    </div>
                    <div class="column is-narrow">
                        <div class="box has-background-white p-5">
                            <p class="heading has-text-dark mb-3">What you get</p>
                            <div class="media mb-3">
                                <div class="media-left">
                                    <span class="icon has-text-primary"><i class="ph-article"></i></span>
                                </div>
                                <div class="media-content">
                                    <p class="is-size-7 has-text-weight-semibold mb-0">Ghost CMS</p>
                                    <p class="is-size-7 has-text-grey">Clean, distraction-free editor</p>
                                </div>
                            </div>
                            <div class="media mb-3">
                                <div class="media-left">
                                    <span class="icon has-text-primary"><i class="ph-users-three"></i></span>
                                </div>
                                <div class="media-content">
                                    <p class="is-size-7 has-text-weight-semibold mb-0">Community reach</p>
                                    <p class="is-size-7 has-text-grey">Growing Salesforce learner base</p>
                                </div>
                            </div>
                            <div class="media mb-4">
                                <div class="media-left">
                                    <span class="icon has-text-primary"><i class="ph-github-logo"></i></span>
                                </div>
                                <div class="media-content">
                                    <p class="is-size-7 has-text-weight-semibold mb-0">Open source</p>
                                    <p class="is-size-7 has-text-grey">Full transparency, no lock-in</p>
                                </div>
                            </div>
                            <a href="/contact/" class="button is-primary is-fullwidth is-small">
                                <span class="icon"><i class="ph-paper-plane-tilt"></i></span>
                                <span>Apply to Teach</span>
                            </a>
                            <a href="/contact/" class="button is-light is-fullwidth is-small mt-2">
                                Ask a question
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>