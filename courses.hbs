{{!< default}}
{{!-- courses.hbs — course catalog (custom template / routed collection).
     Lists #course posts; each card shows its lesson syllabus. --}}

{{#page}}
  {{> "components/page-header" icon="ph-graduation-cap" eyebrow="Learning paths" title=title subtitle=custom_excerpt}}
{{else}}
  {{> "components/page-header" icon="ph-graduation-cap" eyebrow="Learning paths" title="Course Catalog" subtitle="Structured learning paths to take you from beginner to Salesforce expert."}}
{{/page}}

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#foreach posts}}
      <div class="motion-safe:animate-fade-up">{{> "courses/course-card"}}</div>
    {{/foreach}}
  </div>

  {{^posts}}
    <div class="rounded-card border border-dashed border-border py-16 text-center text-muted">
      <i class="ph ph-graduation-cap mb-3 text-4xl" aria-hidden="true"></i>
      <p class="text-lg font-semibold">{{t "Courses coming soon!"}}</p>
    </div>
  {{/posts}}

  {{pagination}}
</section>
