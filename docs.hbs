{{!< default}}
{{!-- Documentation sections.

     Search is prominent here and absent from the other listings, because
     nobody arrives at documentation to browse — they arrive knowing roughly
     what they want, and the page's job is to get them out of it quickly. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <p class="ns-kicker">{{t "Reference"}}</p>
            {{#page}}
                <h1 class="ns-band__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-band__lede">{{custom_excerpt}}</p>{{/if}}
            {{else}}
                <h1 class="ns-band__title">{{t "Documentation"}}</h1>
            {{/page}}
        </div>

        {{#if @custom.show_search}}
            <button type="button" class="ns-navsearch ns-navsearch--block" data-ghost-search
                    aria-label="{{t "Search this site"}}">
                {{> "icons/navbar/search"}}
                <span class="ns-navsearch__text">{{t "Search the docs"}}</span>
                <kbd class="ns-navsearch__kbd">⌘K</kbd>
            </button>
        {{/if}}
    </div>
</section>
{{> "collection" card="course"}}
