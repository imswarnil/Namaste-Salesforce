

<div class="lesson-player-wrapper" style="overflow: hidden;"> 
    {{!-- Inline style used only to lock the screen height to create the app feel --}}

    <nav class="navbar has-background-info-dark p-3 is-flex is-justify-content-space-between is-align-items-center">
        <div class="is-flex is-align-items-center">
            {{!-- Link back to the parent Course page using the primary tag --}}
            {{#if primary_tag}}
                <a href="{{primary_tag.url}}" class="has-text-white is-flex is-align-items-center mr-4" title="Back to Course">
                    <i class="ph ph-caret-left is-size-4 mr-1"></i> Back
                </a>
                <div class="is-hidden-mobile">
                    <span class="has-text-weight-bold has-text-white is-size-5">{{primary_tag.name}}</span>
                </div>
            {{/if}}
        </div>
        
        <div class="is-flex is-align-items-center">
            <a href="#" class="button is-info is-light is-outlined is-small">
                <i class="ph ph-trophy mr-1"></i> Get Certificate
            </a>
        </div>
    </nav>

    <div class="columns is-marginless" style="height: calc(100vh - 64px);">
        
        <main class="column is-8-tablet is-9-desktop p-0 has-background-white-bis" style="overflow-y: auto; height: 100%;">
            
            <figure class="image is-16by9 has-background-black m-0">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="object-fit: cover;">
                {{else}}
                    <div class="is-flex is-align-items-center is-justify-content-center has-background-dark has-text-white" style="height: 100%;">
                        <i class="ph ph-video-camera" style="font-size: 4rem; opacity: 0.5;"></i>
                    </div>
                {{/if}}
            </figure>

            <div class="level is-mobile p-4 has-background-white m-0" style="border-bottom: 1px solid #dbdbdb;">
                <div class="level-left">
                    {{#prev_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-white has-text-grey-dark">
                        <i class="ph ph-arrow-left mr-2"></i> <span class="is-hidden-mobile">Previous Lesson</span>
                    </a>
                    {{/prev_post}}
                </div>
                <div class="level-right">
                    {{#next_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-info">
                        <span class="is-hidden-mobile mr-2">Next Lesson</span> <i class="ph ph-arrow-right"></i>
                    </a>
                    {{/next_post}}
                </div>
            </div>

            <div class="container is-max-desktop p-4">
                <div class="box is-shadowless p-5 mb-6" style="border: 1px solid #dbdbdb;">
                    <div class="content gh-content">
                        <h1 class="title is-3">{{title}}</h1>
                        {{!-- Pulls everything written in the Ghost editor --}}
                        {{content}}
                    </div>
                </div>
            </div>

        </main>

        <aside class="column is-4-tablet is-3-desktop p-0 has-background-white" style="overflow-y: auto; height: 100%; border-left: 1px solid #dbdbdb;">
            
            <div class="p-4 has-background-white-bis" style="position: sticky; top: 0; z-index: 10; border-bottom: 1px solid #dbdbdb;">
                <h2 class="title is-6 mb-0 is-uppercase has-text-grey-dark" style="letter-spacing: 1px;">Course Curriculum</h2>
            </div>

            <aside class="menu pt-2">
                {{!-- 1. FETCH THE PARENT COURSE: We look for the post tagged with #courses-col that shares the same primary tag as this lesson --}}
                {{#get "posts" filter="tag:hash-courses-col+primary_tag:{{primary_tag.slug}}" limit="1" as |course|}}
                    {{#foreach course}}
                        
                        {{!-- 2. FIND MODULE GROUPS: Loop through the Course's tags, looking for tags starting with #group- --}}
                        {{#foreach tags visibility="internal"}}
                            {{#match slug "~" "^hash-group"}}
                                
                                <p class="menu-label px-4 pt-3 mb-2 has-text-dark has-text-weight-bold is-flex is-justify-content-space-between is-align-items-center">
                                    <span class="is-size-6">{{#if description}}{{description}}{{else}}{{name}}{{/if}}</span>
                                    <i class="ph ph-caret-down is-size-5"></i>
                                </p>
                                
                                <ul class="menu-list px-2">
                                    {{!-- 3. FETCH LESSONS IN THIS MODULE: Fetch posts tagged with #lessons-col AND this specific #group- tag --}}
                                    {{#get "posts" filter="tag:hash-lessons-col+tag:{{slug}}" limit="all" order="published_at asc" as |lessons|}}
                                        {{#foreach lessons}}
                                            
                                            <li>
                                                <a href="{{url}}" data-lesson-url="{{url}}" class="dynamic-lesson-link is-flex is-align-items-flex-start p-3">
                                                    <i class="ph ph-play-circle has-text-grey-light is-size-5 mr-3 mt-1 dynamic-icon"></i>
                                                    <div>
                                                        <div class="has-text-weight-medium has-text-grey-dark dynamic-title">{{title}}</div>
                                                    </div>
                                                </a>
                                            </li>

                                        {{/foreach}}
                                    {{/get}}
                                </ul>
                                <hr class="my-2 mx-4" style="background-color: #dbdbdb;">

                            {{/match}}
                        {{/foreach}}

                    {{/foreach}}
                {{/get}}
            </aside>

        </aside>
    </div>

</div>

{{!-- Vanilla JS to apply Pure Bulma active classes to the current lesson in the sidebar --}}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const currentPath = window.location.pathname;
        const lessonLinks = document.querySelectorAll('.dynamic-lesson-link');
        
        lessonLinks.forEach(link => {
            // Check if the link's URL matches the browser's current URL
            if (link.getAttribute('data-lesson-url').includes(currentPath)) {
                // Apply pure Bulma active classes
                link.classList.add('has-background-info-light');
                link.style.borderLeft = "4px solid #3e8ed0";
                
                // Update text and icon to active states
                const icon = link.querySelector('.dynamic-icon');
                const title = link.querySelector('.dynamic-title');
                
                icon.classList.replace('ph', 'ph-fill');
                icon.classList.replace('has-text-grey-light', 'has-text-info');
                
                title.classList.replace('has-text-weight-medium', 'has-text-weight-bold');
                title.classList.replace('has-text-grey-dark', 'has-text-info-dark');
            }
        });
    });
</script>

