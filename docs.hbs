{{!< default}}
{{!-- =========================================================================
  docs.hbs  ·  Documentation Homepage  GET /docs/

  DATA CONTEXT: page.docs
    Ghost page with slug "docs" — supplies {{title}} and {{custom_excerpt}}.
    Create this page in Ghost Admin → Pages → slug: docs.

  WHAT THIS RENDERS:
    A grid of documentation section cards, one per #docs post.
    Each card shows:
      • Section title  (the #docs post title)
      • Description    (custom_excerpt of the #docs post)
      • Up to 5 article previews  (#docs-article posts with matching primary_tag)
      • "View all →" link to the section index page

  QUERY LOGIC:
    Outer {{#get}}  → all posts tagged hash-docs (the section posts)
    Inner {{#get}}  → for each section, fetch its #docs-article articles
                      using filter="primary_tag:{{primary_tag.slug}}+tag:hash-docs-article"
    primary_tag.slug inside the inner get accesses the OUTER foreach's current
    post's primary_tag — one safe context level up, correct Ghost HBS pattern.
========================================================================== --}}

<div class="docs-home">

  {{!-- ── Hero ──────────────────────────────────────────────────────────── --}}
  <section class="docs-home__hero">
    <div class="container">
      <div class="docs-home__hero-inner">
        <h1 class="docs-home__hero-title">
          {{#if title}}{{title}}{{else}}Documentation{{/if}}
        </h1>
        {{#if custom_excerpt}}
          <p class="docs-home__hero-lead">{{custom_excerpt}}</p>
        {{else}}
          <p class="docs-home__hero-lead">
            Browse guides and references across all topics.
          </p>
        {{/if}}
        <button class="docs-home__search-bar" type="button"
                data-ghost-search aria-label="Search documentation">
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          <span>Search documentation…</span>
          <kbd class="docs-home__search-kbd">⌘ K</kbd>
        </button>
      </div>
    </div>
  </section>

  {{!-- ── Section cards grid ────────────────────────────────────────────── --}}
  <section class="docs-home__sections">
    <div class="container">

      {{#get "posts"
        filter="tag:hash-docs"
        order="published_at asc"
        limit="50"
        include="tags"
      }}

        {{#if posts}}
          <div class="columns is-multiline docs-home__grid">

            {{#foreach posts}}
              {{!--
                Each post here is one documentation section (#docs post).
                primary_tag.slug = the section identifier, e.g. "api".
                We use it to fetch the articles inside this section.
              --}}
              <div class="column is-12-mobile is-6-tablet is-4-desktop">
                <div class="docs-section-card">

                  {{!-- Card header --}}
                  <div class="docs-section-card__head">
                    <span class="docs-section-card__icon" aria-hidden="true">
                      <i class="ph ph-book-open-text"></i>
                    </span>
                    <div class="docs-section-card__heading">
                      <h2 class="docs-section-card__title">
                        <a href="{{url}}" class="docs-section-card__title-link">
                          {{title}}
                        </a>
                      </h2>
                      {{#if custom_excerpt}}
                        <p class="docs-section-card__tagline">
                          {{custom_excerpt}}
                        </p>
                      {{/if}}
                    </div>
                  </div>

                  {{!-- Article previews (up to 5) --}}
                  {{#if primary_tag}}
                    {{#get "posts"
                      filter="primary_tag:{{primary_tag.slug}}+tag:hash-docs-article"
                      order="published_at asc"
                      limit="5"
                    }}
                      {{#if posts}}
                        <ul class="docs-section-card__list">
                          {{#foreach posts}}
                            <li class="docs-section-card__article-item">
                              <a href="{{url}}"
                                 class="docs-section-card__article-link">
                                <i class="ph ph-file-text" aria-hidden="true"></i>
                                <span>{{title}}</span>
                              </a>
                            </li>
                          {{/foreach}}
                        </ul>
                      {{/if}}
                    {{/get}}
                  {{/if}}

                  {{!-- View all link --}}
                  <div class="docs-section-card__footer">
                    <a href="{{url}}" class="docs-section-card__view-all">
                      View all articles
                      <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </a>
                  </div>

                </div>
              </div>
            {{/foreach}}

          </div>

        {{else}}
          {{!-- Empty state --}}
          <div class="docs-home__empty">
            <i class="ph ph-books docs-home__empty-icon" aria-hidden="true"></i>
            <h2 class="docs-home__empty-title">No documentation yet</h2>
            <p class="docs-home__empty-body">
              Create a post in Ghost Admin, tag it <code>#docs</code>,
              set a primary tag (e.g. <code>api</code>), and it will
              appear here as a documentation section.
            </p>
          </div>
        {{/if}}

      {{/get}}

    </div>
  </section>

</div>
