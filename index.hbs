{{!< default}}
{{!-- index.hbs — default post list (home fallback / collection route) --}}

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">

  {{!-- Post grid --}}
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#foreach posts}}
      <div class="motion-safe:animate-fade-up">
        {{> post-card}}
      </div>
    {{/foreach}}
  </div>

  {{!-- Empty state --}}
  {{^posts}}
    <div class="ns-empty ns-empty--lg">
      {{> icons name="newspaper" class="mb-3 text-4xl"}}
      <p class="text-lg font-semibold">{{t "No posts yet"}}</p>
    </div>
  {{/posts}}

  {{pagination}}
</section>
