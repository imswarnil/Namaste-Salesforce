{{!< default}}
{{!-- The generic listing, and the fallback for any route without its own
     template — including `/` when the publisher has not uploaded a routes.yaml
     mapping it to home.hbs. It therefore has to be a real page. --}}
<section class="ns-band ns-band--tight">
    <div class="ns-band__inner">
        <div class="ns-band__head">
            <h1 class="ns-band__title">{{@site.title}}</h1>
            {{#if @site.description}}<p class="ns-band__lede">{{@site.description}}</p>{{/if}}
        </div>
    </div>
</section>
{{> "collection" card="blog" rail=true}}
