{{!< default}}

{{!-- The catch-all archive: any post no collection claims lands
at /{slug}/ and paginates here (mounted at /archive/). --}}

<section class="archive-hero outer">
    <div class="archive-hero-inner inner">
        <div>
            <span class="kicker">{{> "icons/book-open"}} {{t "Archive"}}</span>
            <h1>{{t "Everything else"}}</h1>
            <p class="archive-hero-desc">{{t "Standalone posts that live outside the blog, courses and training."}}</p>
        </div>
    </div>
</section>

<main id="site-main" class="archive-main outer">
    <div class="inner">
        <div class="card-grid">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</main>
