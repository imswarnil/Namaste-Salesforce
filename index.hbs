{{!< default}}
{{!-- The default collection listing. See abstract/01 for which collections
     route here, and abstract/03 before writing any markup. --}}
<div class="ns-container ns-section">
  {{#foreach posts}}<article class="ns-card ns-bcard">
    <div class="ns-card__body">
      <a class="ns-card__link" href="{{url}}"><span class="ns-card__title">{{title}}</span></a>
    </div>
  </article>{{/foreach}}
  {{pagination}}
</div>
