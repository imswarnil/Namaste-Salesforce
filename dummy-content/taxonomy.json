{
  "_readme": "Internal-tag taxonomy for courses/lessons. Ghost internal-tag slugs use the hash- prefix.",
  "taxonomy": {
    "type": [
      {
        "tag": "hash-course",
        "name": "#course",
        "description": "Marks a post as a course (its primary public tag is the course tag; its slug must equal that tag)."
      },
      {
        "tag": "hash-lesson",
        "name": "#lesson",
        "description": "Marks a post as a lesson; its primary public tag is its parent course tag, so it nests at /courses/{tag}/{slug}/."
      }
    ],
    "price": [
      {
        "tag": "hash-free",
        "name": "#free",
        "description": "Course/lesson is free for everyone."
      },
      {
        "tag": "hash-paid",
        "name": "#paid",
        "description": "Course/lesson requires a paid membership tier (pair with Ghost post visibility = paid/tiers)."
      }
    ],
    "level": [
      {
        "tag": "hash-level-beginner",
        "name": "#level-beginner",
        "description": "Beginner level. Card badge colour: green."
      },
      {
        "tag": "hash-level-intermediate",
        "name": "#level-intermediate",
        "description": "Intermediate level. Card badge colour: amber."
      },
      {
        "tag": "hash-level-advanced",
        "name": "#level-advanced",
        "description": "Advanced level. Card badge colour: red."
      }
    ],
    "hero": [
      {
        "tag": "hash-hero-1",
        "name": "#hero-1",
        "description": "Course hero layout 1 (default: two-column, details left / media right)."
      },
      {
        "tag": "hash-hero-2",
        "name": "#hero-2",
        "description": "Course hero layout 2 (centered, large title over pattern background)."
      },
      {
        "tag": "hash-hero-3",
        "name": "#hero-3",
        "description": "Course hero layout 3 (image-forward, overlay details)."
      },
      {
        "tag": "hash-hero-4",
        "name": "#hero-4",
        "description": "Course hero layout 4 (compact bar with stats row)."
      },
      {
        "tag": "hash-hero-5",
        "name": "#hero-5",
        "description": "Course hero layout 5 (video hero: first content video plays inline on click)."
      }
    ],
    "image": [
      {
        "tag": "hash-show-image",
        "name": "#show-image",
        "description": "Show course/lesson feature images in listings and hero."
      },
      {
        "tag": "hash-hide-image",
        "name": "#hide-image",
        "description": "Hide feature images (icon/gradient only). Default when neither is set."
      }
    ],
    "lessonType": [
      {
        "tag": "hash-lesson-type-video",
        "name": "#lesson-type-video",
        "description": "Lesson is a video lesson (use with a #video-duration-* tag). Default (no tag) = article."
      }
    ],
    "access": [
      {
        "tag": "hash-preview",
        "name": "#preview",
        "description": "A locked-course lesson that anyone may preview for free."
      }
