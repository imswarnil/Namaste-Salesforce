{
  "name": "namaste-salesforce",
  "description": "A custom Ghost theme for Namaste Salesforce",
  "demo": "https://imswarnil.com",
  "version": "5.9.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "screenshots": {
    "desktop": "assets/screenshot-desktop.jpg",
    "mobile": "assets/screenshot-mobile.jpg"
  },
  "scripts": {
    "dev": "gulp",
    "zip": "gulp zip",
    "test": "gscan .",
    "test:ci": "gscan --fatal --verbose .",
    "pretest": "gulp build",
    "preship": "yarn test",
    "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then yarn version && git push --follow-tags; else echo \"Uncomitted changes found.\" && exit 1; fi",
    "postship": "git fetch && gulp release"
  },
  "author": {
    "name": "Swarnil",
    "email": "hello@imswarnil.com",
    "url": "https://imswarnil.com"
  },
  "gpm": {
    "type": "theme",
    "categories": ["Minimal", "Magazine"]
  },
  "keywords": ["ghost", "theme", "ghost-theme", "salesforce"],
  "repository": {
    "type": "git",
    "url": "https://github.com/imswarnil/Namaste-Salesforce.git"
  },
  "bugs": "https://github.com/imswarnil/Namaste-Salesforce/issues",
  "devDependencies": {
    "@tryghost/release-utils": "0.8.1",
    "autoprefixer": "10.4.24",
    "beeper": "2.1.0",
    "cssnano": "7.1.2",
    "gscan": "5.2.4",
    "gulp": "5.0.1",
    "gulp-concat": "2.6.1",
    "gulp-dart-sass": "^1.1.0",
    "gulp-livereload": "4.0.2",
    "gulp-postcss": "10.0.0",
    "gulp-uglify": "3.0.2",
    "gulp-zip": "^5.1.0",
    "inquirer": "13.2.2",
    "postcss": "8.5.6",
    "postcss-color-mod-function": "4.1.1",
    "postcss-easy-import": "4.0.0",
    "pump": "3.0.3",
    "sass": "^1.97.3"
  },
  "browserslist": ["defaults"],
  "config": {
    "posts_per_page": 25,
    "image_sizes": {
      "xxs": { "width": 30 },
      "xs":  { "width": 100 },
      "s":   { "width": 300 },
      "m":   { "width": 600 },
      "l":   { "width": 1000 },
      "xl":  { "width": 2000 }
    },
    "card_assets": true,
    "custom": {

      "sticky_header": {
        "type": "boolean",
        "default": true,
        "description": "Fix the header to the top of the page while scrolling"
      },

      "header_style": {
        "type": "select",
        "options": ["Solid", "Blur", "Transparent"],
        "default": "Solid",
        "description": "Header background style — Solid, frosted-glass Blur, or fully Transparent"
      },

      "show_github_button": {
        "type": "boolean",
        "default": true,
        "description": "Show the GitHub star button in the site navigation"
      },

      "github_url": {
        "type": "text",
        "default": "https://github.com/imswarnil/Namaste-Salesforce",
        "description": "GitHub repository URL used for the star button"
      },

      "show_reading_time": {
        "type": "boolean",
        "default": true,
        "group": "post",
        "description": "Display estimated reading time on blog posts"
      },

      "show_author_card": {
        "type": "boolean",
        "default": true,
        "group": "post",
        "description": "Show the author bio card at the bottom of posts"
      },

      "feed_layout": {
        "type": "select",
        "options": ["Grid", "List", "Magazine"],
        "default": "Grid",
        "group": "homepage",
        "description": "Layout style for the post feed on the homepage"
      },

      "footer_tagline": {
        "type": "text",
        "default": "Learn Salesforce. Land the job. Build the future.",
        "description": "Tagline shown in the footer accent strip"
      }

    }
  },
  "renovate": {
    "extends": ["@tryghost:theme"]
  },
  "dependencies": {
    "bulma": "^1.0.4"
  }
}