{
  "name": "namaste-salesforce",
  "description": "A Ghost theme for Namaste Salesforce, built on NS Design System.",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0",
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "ghost-theme",
    "salesforce",
    "learning",
    "documentation",
    "dark-mode"
  ],
  "author": {
    "name": "Swarnil Singhai",
    "email": "swarnilsinghaicse@gmail.com",
    "url": "https://imswarnil.com"
  },
  "scripts": {
    "dev": "gulp",
    "build": "NODE_ENV=production gulp build",
    "test": "npm run build && gscan .",
    "test:ci": "npm run build && gscan --fatal --verbose .",
    "zip": "npm run test:ci && mkdir -p dist && rm -f dist/namaste-salesforce.zip && zip -r dist/namaste-salesforce.zip . -x '*.git*' -x 'node_modules/*' -x 'dist/*' -x 'abstract/*' -x 'scripts/*' -x 'dummy-content/*' -x 'assets/css/*' -x '*.DS_Store' -x '*.md' -x 'gulpfile.mjs' -x 'package-lock.json'"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cssnano": "^7.1.2",
    "del": "^8.0.0",
    "gscan": "^4.43.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-postcss": "^10.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3"
  },
  "config": {
    "posts_per_page": 12,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": true,
    "custom": {}
  }
}
