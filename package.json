{
  "name": "namaste-salesforce",
  "description": "An open-source Ghost theme for Salesforce learning communities \u2014 courses, structured training, docs and a blog. Built on the Namaste Salesforce Design System (NSDS), Tailwind CSS v4 and self-hosted fonts.",
  "version": "0.1.0",
  "engines": {
    "ghost": ">=5.0.0",
    "node": ">=18"
  },
  "license": "MIT",
  "screenshots": {
    "desktop": "assets/screenshot-desktop.jpg",
    "mobile": "assets/screenshot-mobile.jpg"
  },
  "scripts": {
    "test": "gscan .",
    "test:ci": "gscan --fatal --verbose .",
    "zip": "npm run test && mkdir -p dist && zip -r dist/namaste-salesforce.zip . -x '*.git*' -x 'node_modules/*' -x 'dist/*' -x 'abstract/*' -x 'prompt/*' -x '*.md' -x '.github/*'"
  },
  "author": {
    "name": "Swarnil Singhai",
    "email": "swarnilsinghaicse@gmail.com",
    "url": "https://github.com/imswarnil"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Education",
      "Documentation"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "salesforce",
    "education",
    "learning",
    "courses",
    "lms",
    "tailwindcss",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imswarnil/Namaste-Salesforce.git"
  },
  "bugs": {
    "url": "https://github.com/imswarnil/Namaste-Salesforce/issues"
  },
  "contributors": "https://github.com/imswarnil/Namaste-Salesforce/graphs/contributors",
  "devDependencies": {
    "gscan": "^4.43.0"
  },
  "config": {
    "posts_per_page": 25,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": true,
    "custom": {}
  },
  "homepage": "https://github.com/imswarnil/Namaste-Salesforce#readme"
}
