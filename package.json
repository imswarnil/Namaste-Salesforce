{
    "name": "namaste-salesforce",
    "description": "An open-source Ghost theme for Salesforce learning communities — SLDS-inspired, fully responsive, with dark mode and reusable components. Built with a custom SCSS framework (no Bulma).",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "dev": "gulp",
        "build": "gulp build",
        "zip": "gulp zip",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "gulp build"
    },
    "author": {
        "name": "Swarnil Singhai",
        "email": "swarnilsinghaicse@gmail.com",
        "url": "https://github.com/imswarnil"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Education",
            "Documentation"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "salesforce",
        "education",
        "slds"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/imswarnil/Namaste-Salesforce.git"
    },
    "bugs": "https://github.com/imswarnil/Namaste-Salesforce/issues",
    "contributors": "https://github.com/imswarnil/Namaste-Salesforce/graphs/contributors",
    "devDependencies": {
        "@tryghost/theme-translations": "~0.0.14",
        "autoprefixer": "10.4.24",
        "beeper": "2.1.0",
        "cssnano": "7.1.2",
        "gscan": "^6.0.0",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-sass": "^6.0.1",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "postcss": "8.5.6",
        "pump": "3.0.3",
        "sass": "^1.99.0"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 25,
        "image_sizes": {
            "xxs": { "width": 30 },
            "xs": { "width": 100 },
            "s": { "width": 300 },
            "m": { "width": 600 },
            "l": { "width": 1000 },
            "xl": { "width": 2000 }
        },
        "card_assets": true
    }
}
