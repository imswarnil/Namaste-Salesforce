{
    "name": "namaste-salesforce",
    "description": "Namaste Salesforce \u2014 a Salesforce learning platform theme for Ghost: courses with a lesson player, tag-driven training modules, and a five-layout blog. Built on the NS Design System.",
    "version": "5.12.2",
    "engines": {
        "ghost": ">=5.0.0",
        "node": ">=22.12.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "build": "gulp build",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "pnpm zip",
        "pretest:ci": "pnpm zip",
        "preship": "pnpm test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then git push --follow-tags; else echo \"Uncomitted changes found.\" && exit 1; fi",
        "postship": "git fetch && gulp release"
    },
    "packageManager": "pnpm@11.22.0",
    "author": {
        "name": "Namaste Salesforce",
        "email": "swarnilsinghaicse@gmail.com"
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/TryGhost/Casper.git"
    },
    "bugs": "https://github.com/TryGhost/Casper/issues",
    "contributors": "https://github.com/TryGhost/Casper/graphs/contributors",
    "devDependencies": {
        "@tryghost/release-utils": "0.9.1",
        "@tryghost/theme-translations": "0.0.22",
        "autoprefixer": "10.5.2",
        "beeper": "2.1.0",
        "cssnano": "8.0.2",
        "gscan": "6.4.2",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "inquirer": "14.0.2",
        "postcss": "8.5.23",
        "postcss-color-mod-function": "4.1.1",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.4"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1000
            },
            "xl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "footer_tagline": {
                "type": "text",
                "default": "",
                "description": "Short line under the footer logo. Falls back to the site description."
            },
            "newsletter_heading": {
                "type": "text",
                "default": "",
                "description": "Heading for the newsletter CTAs (homepage band, blog hero, sidebar widget)."
            },
            "newsletter_text": {
                "type": "text",
                "default": "",
                "description": "Supporting line for the newsletter CTAs."
            },
            "dark_logo": {
                "type": "image",
                "description": "Logo variant for dark mode. Without one, the regular logo is recoloured to white automatically."
            },
            "social_youtube": {
                "type": "text",
                "default": "",
                "description": "Full URL of your YouTube profile, shown in the footer."
            },
            "social_linkedin": {
                "type": "text",
                "default": "",
                "description": "Full URL of your LinkedIn profile, shown in the footer."
            },
            "social_github": {
                "type": "text",
                "default": "",
                "description": "Full URL of your GitHub profile, shown in the footer."
            },
            "social_instagram": {
                "type": "text",
                "default": "",
                "description": "Full URL of your Instagram profile, shown in the footer."
            }
        }
    }
}
