{
    "name": "namaste-salesforce",
    "description": "Namaste Salesforce — A Ghost LMS theme inspired by Salesforce Lightning Design System",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "gulp build",
        "preship": "yarn test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then yarn version && git push --follow-tags; else echo \"Uncomitted changes found.\" && exit 1; fi",
        "postship": "git fetch && gulp release"
    },
    "author": {
        "name": "Namaste Salesforce",
        "email": "hello@namastesalesforce.com",
        "url": "https://namastesalesforce.com"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "LMS",
            "Education"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "lms",
        "salesforce",
        "education"
    ],
    "devDependencies": {
        "@tryghost/release-utils": "0.8.1",
        "@tryghost/theme-translations": "~0.0.14",
        "autoprefixer": "10.4.24",
        "beeper": "2.1.0",
        "cssnano": "7.1.2",
        "gscan": "5.2.4",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "inquirer": "13.2.2",
        "postcss": "8.5.6",
        "postcss-color-mod-function": "4.1.1",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.3"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 25,
        "image_sizes": {
            "xxs": { "width": 30 },
            "xs":  { "width": 100 },
            "s":   { "width": 300 },
            "m":   { "width": 600 },
            "l":   { "width": 1000 },
            "xl":  { "width": 2000 }
        },
        "card_assets": true,
        "custom": {

            "color_scheme": {
                "type": "select",
                "options": [
                    "Light",
                    "Dark",
                    "Auto"
                ],
                "default": "Light",
                "description": "Initial color scheme. Visitors can override this with the toggle button."
            },

            "show_publication_cover": {
                "type": "boolean",
                "default": true,
                "group": "homepage",
                "description": "Show a cover image on the homepage hero section."
            },

            "feed_layout": {
                "type": "select",
                "options": [
                    "Classic",
                    "Grid",
                    "List"
                ],
                "default": "Classic",
                "group": "homepage",
                "description": "Layout style for the post feed on the homepage."
            },

            "post_image_style": {
                "type": "select",
                "options": [
                    "Wide",
                    "Full",
                    "Small",
                    "Hidden"
                ],
                "default": "Wide",
                "group": "post",
                "description": "How the featured image is displayed inside a post."
            },

            "email_signup_text": {
                "type": "text",
                "default": "Enjoyed this? Subscribe for more Salesforce learning.",
                "group": "post",
                "description": "Call-to-action text shown below posts for non-members."
            },

            "show_recent_posts_footer": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Show related/recent posts below each article."
            }

        }
    },
    "renovate": {
        "extends": [
            "@tryghost:theme"
        ]
    }
}