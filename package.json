{
  "name": "namaste-salesforce",
  "description": "An open-source Ghost theme for Salesforce learning communities \u2014 courses, structured training, docs and a blog. Currently a stack-free starter; see abstract/ for the architecture and the decisions still open.",
  "version": "0.1.0",
  "engines": {
    "ghost": ">=5.0.0",
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "dev": "gulp",
    "build": "NODE_ENV=production gulp build",
    "test": "npm run build && gscan .",
    "test:ci": "npm run build && gscan --fatal --verbose .",
    "zip": "npm run test:ci && mkdir -p dist && rm -f dist/namaste-salesforce.zip && zip -r dist/namaste-salesforce.zip . -x '*.git*' -x 'node_modules/*' -x 'dist/*' -x 'abstract/*' -x 'prompt/*' -x 'scripts/*' -x 'dummy-content/*' -x 'assets/css/*' -x '*.DS_Store' -x '*.md' -x 'gulpfile.mjs' -x 'package-lock.json'"
  },
  "author": {
    "name": "Swarnil Singhai",
    "email": "swarnilsinghaicse@gmail.com",
    "url": "https://github.com/imswarnil"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Education",
      "Documentation"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "salesforce",
    "education",
    "learning",
    "courses",
    "starter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imswarnil/Namaste-Salesforce.git"
  },
  "bugs": {
    "url": "https://github.com/imswarnil/Namaste-Salesforce/issues"
  },
  "contributors": "https://github.com/imswarnil/Namaste-Salesforce/graphs/contributors",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cssnano": "^7.1.2",
    "del": "^8.0.0",
    "gscan": "^4.43.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-postcss": "^10.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3"
  },
  "config": {
    "posts_per_page": 25,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": true,
    "custom": {
      "show_search": {
        "type": "boolean",
        "default": true
      },
      "show_theme_toggle": {
        "type": "boolean",
        "default": true
      },
      "sticky_header": {
        "type": "boolean",
        "default": true
      },
      "navigation_layout": {
        "type": "select",
        "options": [
          "Logo on the left",
          "Logo in the centre",
          "Stacked"
        ],
        "default": "Logo on the left"
      },
      "feed_layout": {
        "type": "select",
        "options": [
          "Grid",
          "List",
          "Magazine"
        ],
        "default": "Grid",
        "group": "homepage"
      },
      "show_post_meta": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "show_author_card": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "show_related": {
        "type": "boolean",
        "default": true,
        "group": "post"
      },
      "show_toc": {
        "type": "boolean",
        "default": true,
        "group": "post"
      }
    }
  },
  "homepage": "https://github.com/imswarnil/Namaste-Salesforce#readme"
}
