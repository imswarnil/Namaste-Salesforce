{{!< default}}
{{!-- A 404 is a navigation problem, so it offers navigation rather than an
     apology. --}}
<div class="ns-page ns-page--narrow">
    <div class="ns-empty ns-error-state" role="alert">
        <p class="ns-empty__code">404</p>
        <p class="ns-empty__title">{{t "This page does not exist"}}</p>
        <p class="ns-empty__text">{{t "The link may be old, or the page may have moved."}}</p>
        <div class="ns-empty__action">
            <a class="ns-btn ns-btn--primary" href="{{@site.url}}">{{> "icons/home"}} {{t "Homepage"}}</a>
            <a class="ns-btn ns-btn--outline" href="{{@site.url}}/archive/rss/">{{> "icons/rss"}} RSS</a>
        </div>
    </div>
</div>
