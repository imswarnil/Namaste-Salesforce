{{!< default}}
{{!-- 404 specifically, because it is the one error a reader reaches by
     following a stale link rather than by the site breaking — so it offers a
     way onward rather than an apology. --}}
<section class="ns-band">
    <div class="ns-band__inner ns-page--prose">
        <p class="ns-kicker">404</p>
        <h1 class="ns-band__title">{{t "That page has moved or never existed"}}</h1>
        <p class="ns-band__lede">{{t "The rest of the site is still here."}}</p>
        <div class="ns-band__actions">
            <a class="ns-btn ns-btn--primary" href="{{@site.url}}">{{t "Go to the front page"}}</a>
            {{#if @custom.show_search}}
                <button type="button" class="ns-btn ns-btn--outline" data-ghost-search>
                    {{> "icons/navbar/search"}} {{t "Search"}}
                </button>
            {{/if}}
        </div>
    </div>
</section>

{{#get "posts" limit="3" include="tags,authors" as |recent|}}
    {{#if recent}}
        <section class="ns-band ns-band--sunken">
            <div class="ns-band__inner">
                <div class="ns-band__head"><h2 class="ns-band__title">{{t "Recent posts"}}</h2></div>
                <div class="ns-blog-grid">
                    {{#foreach recent}}{{> "cards/blog-card"}}{{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}
