{{!< default}}

{{!-- /signup — the free account pitch + the portal signup. --}}

<main id="site-main" class="auth-shell outer relative">
    <div class="bg-dots" aria-hidden="true"></div>
    <div class="auth-card">
        <span class="kicker">{{> "icons/sparkles"}} {{t "Free account"}}</span>
        <h1>{{t "Join Namaste Salesforce"}}</h1>
        <p>{{t "Everything here is free to read. An account adds the parts worth signing in for:"}}</p>

        <ul class="auth-benefits">
            <li>{{> "icons/check-circle"}} {{t "The weekly newsletter, in your inbox"}}</li>
            <li>{{> "icons/check-circle"}} {{t "Comment on lessons and articles"}}</li>
            <li>{{> "icons/check-circle"}} {{t "Pick up any course where you left off"}}</li>
        </ul>

        {{#if @member}}
            <p class="members-note">{{> "icons/check-circle"}} {{t "You're already a member — thank you!"}}</p>
            <a class="btn btn-lg" href="#/portal/account" data-portal="account">{{t "Open my account"}}</a>
        {{else}}
            <a class="btn btn-lg" href="#/portal/signup" data-portal="signup">{{> "icons/mail"}} {{t "Sign up free"}}</a>
            <p class="auth-alt">{{t "Already have an account?"}} <a href="{{@site.url}}/signin/">{{t "Sign in"}}</a></p>
        {{/if}}

        <p class="auth-alt">{{t "Want to go further?"}} <a href="{{@site.url}}/membership/">{{t "See membership"}}</a></p>
    </div>
</main>
