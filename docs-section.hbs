{{!< default}}
{{!-- docs-section.hbs — one docs section at /docs/{section}/ (routes.yaml
     routes each section here with `data: tag.{slug}`). Sticky docs sidebar ·
     numbered list of every article in the section · "Next section" card whose
     CTA opens the next section's first doc. --}}
{{#tag}}

{{> "docs/mobile-bar" label=name}}

{{!-- Lets docs/sidebar pop this section's group open --}}
<span id="doc-current-sec" data-sec="{{slug}}" hidden aria-hidden="true"></span>

<section class="mx-auto max-w-[90rem] px-4 py-10 sm:px-6">
  <div class="grid gap-10 lg:grid-cols-[17rem_minmax(0,1fr)]">

    {{> "docs/sidebar"}}

    <main role="main" class="min-w-0 max-w-4xl">
      {{!-- Breadcrumb (compact, icon-based) --}}
      <nav class="mb-4 flex items-center gap-1.5 text-xs text-muted" aria-label="Breadcrumb">
        <a href="/" class="inline-flex items-center transition hover:text-brand-600" aria-label="{{t "Home"}}">{{> icons name="house"}}</a>
        {{> icons name="caret-right" class="text-[0.6rem]"}}
        <a href="/docs/" class="inline-flex items-center gap-1 transition hover:text-brand-600">{{> icons name="book-open"}}{{t "Docs"}}</a>
        {{> icons name="caret-right" class="text-[0.6rem]"}}
        <span class="truncate text-ink">{{name}}</span>
      </nav>

      {{!-- Section header --}}
      <header class="flex items-start gap-4 border-b border-border pb-6">
        <span class="ns-chip shrink-0 text-2xl">
          {{#match slug "getting-started"}}{{> icons name="rocket"}}{{else match slug "account-profile"}}{{> icons name="user-circle"}}{{else match slug "courses-lessons"}}{{> icons name="graduation-cap"}}{{else match slug "roadmaps"}}{{> icons name="map-trifold"}}{{else match slug "membership-billing"}}{{> icons name="credit-card"}}{{else match slug "certificates-progress"}}{{> icons name="seal-check"}}{{else match slug "become-an-author"}}{{> icons name="pen-nib"}}{{else match slug "community-support"}}{{> icons name="users"}}{{else match slug "troubleshooting"}}{{> icons name="wrench"}}{{else}}{{> icons name="folder-open"}}{{/match}}
        </span>
        <div class="min-w-0">
          <h1 class="font-heading text-3xl font-extrabold tracking-tight">{{name}}</h1>
          {{#if description}}<p class="mt-1 text-muted">{{description}}</p>{{/if}}
        </div>
      </header>

      {{!-- Every article in this section, in reading order --}}
      {{#get "posts" filter="tag:documentation+primary_tag:{{slug}}" limit="100" order="published_at asc"}}
        <ol class="mt-6 space-y-2">
          {{#foreach posts}}
            <li>
              <a href="{{url}}" class="group flex items-center gap-4 rounded-card border border-border bg-surface-raised p-4 ns-transition hover:border-brand-500">
                <span class="ns-index flex h-9 w-9 shrink-0 items-center justify-center rounded-btn bg-surface-sunken text-sm text-brand-600 ns-hairline dark:text-brand-300">{{@number}}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-heading font-semibold group-hover:text-brand-600 dark:group-hover:text-brand-300">{{title}}</span>
                  {{#if custom_excerpt}}<span class="mt-0.5 block truncate text-sm text-muted">{{custom_excerpt}}</span>{{/if}}
                </span>
                <span class="hidden shrink-0 items-center gap-1 font-mono text-xs text-label sm:inline-flex">{{> icons name="timer"}}{{reading_time}}</span>
                {{> icons name="arrow-right" class="shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-brand-500"}}
              </a>
            </li>
          {{else}}
            <li class="ns-empty">{{t "Articles for this section are coming soon."}}</li>
          {{/foreach}}
        </ol>
      {{/get}}

      {{!-- Up next: the following section, with a CTA into its first doc --}}
      {{> "docs/next-section-for" current=slug}}
    </main>
  </div>
</section>
{{/tag}}
