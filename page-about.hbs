{{!< default}}
{{!-- ══════════════════════════════════════════════════════════════════════════
    page-about.hbs — Custom template for the "About" page
    ---------------------------------------------------------------------------
    Ghost automatically uses this template for the page whose slug is `about`
    (i.e. /about/). It wraps a designed hero + mission + values + contribute
    band around the page body, so the editorial copy stays editable in Ghost
    admin while the layout lives here.
═══════════════════════════════════════════════════════════════════════════ --}}

{{#page}}

{{!-- ── 1. HERO ──────────────────────────────────────────────────────────── --}}
<section class="ns-hero">
  <div class="ns-hero-mesh" aria-hidden="true">
    <div class="ns-hero-mesh__blob ns-hero-mesh__blob--1"></div>
    <div class="ns-hero-mesh__blob ns-hero-mesh__blob--2"></div>
    <div class="ns-hero-mesh__blob ns-hero-mesh__blob--3"></div>
  </div>

  <div class="container ns-hero__content">
    <span class="ns-eyebrow ns-fade-in ns-stagger-1" style="color:#fff;">
      <i class="ph-fill ph-heart" aria-hidden="true"></i>
      Our Story
    </span>
    <h1 class="ns-hero__title ns-fade-up ns-stagger-2">{{title}}</h1>
    <p class="ns-hero__subtitle ns-fade-up ns-stagger-3">
      {{#if custom_excerpt}}{{custom_excerpt}}{{else}}A free, open-source platform built to make world-class Salesforce education accessible to everyone — no paywalls, no gatekeeping.{{/if}}
    </p>
  </div>
</section>

{{!-- ── 2. MISSION ───────────────────────────────────────────────────────── --}}
<section class="ns-section">
  <div class="ns-container">
    <div class="columns is-variable is-8 is-vcentered">

      <div class="column is-6-desktop">
        <span class="ns-eyebrow"><i class="ph-fill ph-target" aria-hidden="true"></i> Our Mission</span>
        <h2 class="title is-2 mt-3">Learning Salesforce should be <span class="ns-gradient-text">free for everyone</span></h2>
        <p class="ns-lead mt-4">
          We believe talent is everywhere but opportunity isn't. Namaste Salesforce exists to
          close that gap — turning curious beginners into confident, certified professionals
          through hands-on, community-driven learning.
        </p>
      </div>

      <div class="column is-6-desktop">
        <div class="columns is-mobile is-multiline has-text-centered">
          <div class="column is-6">
            <div class="ns-stat"><span class="ns-stat__number">10K+</span><span class="ns-stat__label">Learners</span></div>
          </div>
          <div class="column is-6">
            <div class="ns-stat"><span class="ns-stat__number">50+</span><span class="ns-stat__label">Courses</span></div>
          </div>
          <div class="column is-6">
            <div class="ns-stat"><span class="ns-stat__number">300+</span><span class="ns-stat__label">Lessons</span></div>
          </div>
          <div class="column is-6">
            <div class="ns-stat"><span class="ns-stat__number">100%</span><span class="ns-stat__label">Free</span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<div class="ns-divider"></div>

{{!-- ── 3. VALUES ────────────────────────────────────────────────────────── --}}
<section class="ns-section ns-section--gradient">
  <div class="ns-container">
    <div class="has-text-centered mb-6">
      <span class="ns-eyebrow"><i class="ph-fill ph-sparkle" aria-hidden="true"></i> What We Stand For</span>
      <h2 class="title is-2 mt-3">The principles behind the platform</h2>
    </div>

    <div class="ns-grid ns-grid--4">
      <div class="ns-feature-card ns-fade-up ns-stagger-1">
        <div class="ns-feature-card__icon"><i class="ph-fill ph-lock-open" aria-hidden="true"></i></div>
        <div class="ns-feature-card__title">Open by Default</div>
        <div class="ns-feature-card__body">Curriculum, code, and content are open source. Anyone can learn from — or improve — what we build.</div>
      </div>
      <div class="ns-feature-card ns-fade-up ns-stagger-2">
        <div class="ns-feature-card__icon"><i class="ph-fill ph-flask" aria-hidden="true"></i></div>
        <div class="ns-feature-card__title">Learn by Doing</div>
        <div class="ns-feature-card__body">Real orgs, real Apex, real projects. We teach the way the job actually works.</div>
      </div>
      <div class="ns-feature-card ns-fade-up ns-stagger-3">
        <div class="ns-feature-card__icon"><i class="ph-fill ph-users-three" aria-hidden="true"></i></div>
        <div class="ns-feature-card__title">Community First</div>
        <div class="ns-feature-card__body">No one learns alone. Questions, answers, and mentorship sit at the heart of the platform.</div>
      </div>
      <div class="ns-feature-card ns-fade-up ns-stagger-4">
        <div class="ns-feature-card__icon"><i class="ph-fill ph-seal-check" aria-hidden="true"></i></div>
        <div class="ns-feature-card__title">Quality, Always</div>
        <div class="ns-feature-card__body">Every lesson is written and reviewed by certified Salesforce professionals.</div>
      </div>
    </div>
  </div>
</section>

<div class="ns-divider"></div>

{{!-- ── 4. EDITABLE PAGE BODY (managed in Ghost admin) ───────────────────── --}}
{{#if content}}
<section class="ns-section" style="padding-top:0;">
  <div class="ns-container">
    <div class="content gh-content">
      {{content}}
    </div>
  </div>
</section>
{{/if}}

{{!-- ── 5. OPEN-SOURCE / CONTRIBUTE BAND ─────────────────────────────────── --}}
<section class="ns-section ns-section--loose ns-section--gradient">
  <div class="ns-container">
    <div class="ns-glass-card has-text-centered" style="max-width:760px;margin:0 auto;padding:3.5rem 2rem;">
      <span class="ns-eyebrow"><i class="ph-fill ph-git-branch" aria-hidden="true"></i> Open Source</span>
      <h2 class="title is-2 mt-3">Help us build it</h2>
      <p class="ns-lead mt-3" style="max-width:560px;margin-left:auto;margin-right:auto;">
        This theme and its curriculum are open source. Found a bug, want a feature, or have a
        lesson to share? Contributions of every size are welcome.
      </p>
      <div class="buttons is-centered mt-5">
        <a class="button is-gradient is-large is-rounded ns-gradient-animated"
           href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener">
          <span class="icon"><i class="ph ph-github-logo" aria-hidden="true"></i></span>
          <span>View on GitHub</span>
        </a>
        <a class="button is-large is-rounded is-outlined"
           href="https://github.com/imswarnil/Namaste-Salesforce/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">
          <span class="icon"><i class="ph ph-book-open" aria-hidden="true"></i></span>
          <span>Contribution Guide</span>
        </a>
      </div>
    </div>
  </div>
</section>

{{/page}}
