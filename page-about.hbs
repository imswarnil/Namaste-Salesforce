{{!< default}}

{{#contentFor "head-after"}}
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <style>
        .about-shell .hero.is-primary {
            background:
                radial-gradient(circle at top right, rgba(255,255,255,0.18), transparent 30%),
                linear-gradient(135deg, var(--theme-brand, #009ed9) 0%, #002142 100%);
        }

        .about-shell .hero .title,
        .about-shell .hero .subtitle,
        .about-shell .hero .content,
        .about-shell .hero .tag {
            color: #fff;
        }

        .about-shell .hero .tag.is-light {
            color: #0f172a;
        }

        .about-shell .icon-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 3rem;
            height: 3rem;
            border-radius: 9999px;
            background: rgba(0, 158, 217, 0.1);
            color: var(--theme-brand, #009ed9);
            font-size: 1.35rem;
            margin-bottom: 1rem;
        }

        .about-shell .hero-icon-pill {
            background: rgba(255,255,255,0.16);
            color: #fff;
        }

        .about-shell .lift-card,
        .about-shell .lift-box {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .about-shell .lift-card:hover,
        .about-shell .lift-box:hover {
            transform: translateY(-4px);
        }

        .about-shell .soft-border {
            border: 1px solid rgba(15, 23, 42, 0.08);
        }

        .about-shell .about-avatar {
            border-radius: 1rem;
            overflow: hidden;
        }

        .about-shell .mini-stat {
            text-align: center;
        }

        .about-shell .mini-stat .title {
            margin-bottom: 0.25rem;
        }

        .about-shell .cta-box {
            background:
                linear-gradient(135deg, rgba(0, 158, 217, 0.06) 0%, rgba(129, 186, 255, 0.1) 100%);
        }

        .about-shell .strip {
            border-top: 1px solid rgba(15, 23, 42, 0.08);
            padding-top: 1rem;
        }

        .about-shell .ph {
            line-height: 1;
        }
    </style>
{{/contentFor}}

{{#page}}
<div class="about-shell">

    {{!-- 1. Hero --}}
    <div class="hero is-primary">
        <div class="hero-body">
            <div class="container is-fluid">
                <div class="columns is-vcentered is-variable is-6">
                    <div class="column is-12-mobile is-7-desktop">
                        <span class="tag is-light mb-4">
                            <i class="ph-fill ph-code mr-2"></i>
                            Open Source LMS for Salesforce People
                        </span>

                        <h1 class="title is-1 mb-4">
                            {{title}}
                        </h1>

                        {{#if custom_excerpt}}
                            <p class="subtitle is-4 mb-5">{{custom_excerpt}}</p>
                        {{else}}
                            <p class="subtitle is-4 mb-5">
                                A practical learning platform and open-source Ghost theme project started by Swarnil, built with Bulma, designed for Salesforce learners who want structure, clarity, and real-world usefulness.
                            </p>
                        {{/if}}

                        <div class="buttons">
                            <a href="/courses/" class="button is-light">
                                <span class="icon"><i class="ph-fill ph-graduation-cap"></i></span>
                                <span>Explore Courses</span>
                            </a>
                            <a href="#contribute" class="button is-primary is-outlined">
                                <span class="icon"><i class="ph-fill ph-git-pull-request"></i></span>
                                <span>Contribute</span>
                            </a>
                            <a href="#sponsor" class="button is-primary is-outlined">
                                <span class="icon"><i class="ph-fill ph-heart"></i></span>
                                <span>Sponsor</span>
                            </a>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-5-desktop">
                        <div class="box lift-box soft-border">
                            <span class="icon-pill hero-icon-pill">
                                <i class="ph-fill ph-rocket-launch"></i>
                            </span>
                            <p class="title is-4">Built with intent</p>
                            <p class="content mb-4">
                                This project is not just another theme. It is a learning-first foundation for courses, lessons, docs, newsletters, and community content.
                            </p>

                            <div class="columns is-mobile is-multiline">
                                <div class="column is-6 mini-stat">
                                    <p class="title is-5">Ghost</p>
                                    <p class="is-size-7">Publishing engine</p>
                                </div>
                                <div class="column is-6 mini-stat">
                                    <p class="title is-5">Bulma</p>
                                    <p class="is-size-7">CSS framework</p>
                                </div>
                                <div class="column is-6 mini-stat">
                                    <p class="title is-5">Open</p>
                                    <p class="is-size-7">Source first</p>
                                </div>
                                <div class="column is-6 mini-stat">
                                    <p class="title is-5">Salesforce</p>
                                    <p class="is-size-7">Audience focus</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
     </div>

    {{!-- 2. What matters most --}}
    <div class="section">
        <div class="container is-fluid">
            <div class="has-text-centered mb-6">
                <h2 class="title is-2">What matters most</h2>
                <p class="subtitle is-5">
                    Less noise. More clarity. More actual learning.
                </p>
            </div>

            <div class="columns is-multiline is-variable is-5">
                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-lightbulb"></i></span>
                        <h3 class="title is-5">Clarity</h3>
                        <p>
                            Concepts should be understandable, not wrapped in jargon like an overconfident corporate burrito.
                        </p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-hammer"></i></span>
                        <h3 class="title is-5">Practicality</h3>
                        <p>
                            Every lesson should help people build, solve, and apply something real.
                        </p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-stack"></i></span>
                        <h3 class="title is-5">Structure</h3>
                        <p>
                            Good learning needs paths, sequence, and progression—not random tabs and panic.
                        </p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-users-three"></i></span>
                        <h3 class="title is-5">Community</h3>
                        <p>
                            Open-source grows faster when people learn, build, and improve together.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 3. Built on Ghost + Bulma --}}
    <div class="section">
        <div class="container is-fluid">
            <div class="columns is-vcentered is-variable is-6">
                <div class="column is-12-mobile is-6-desktop">
                    <h2 class="title is-2 mb-4">Why Ghost + Bulma</h2>
                    <div class="content is-medium">
                        <p>
                            This project is built on <strong>Ghost</strong> for its clean publishing experience and strong content model, then shaped with <strong>Bulma</strong> because it keeps layout fast, readable, and flexible without fighting the browser every morning.
                        </p>
                        <p>
                            On top of that sits a custom theme layer designed specifically for LMS-style content: courses, lessons, docs, newsletter, showcase, and long-form learning.
                        </p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-desktop">
                    <div class="columns is-multiline is-variable is-4">
                        <div class="column is-6">
                            <div class="notification is-light">
                                <p class="has-text-weight-semibold">
                                    <i class="ph-fill ph-article mr-2"></i>Ghost CMS
                                </p>
                                <p>Fast publishing, content-first architecture, clean editor.</p>
                            </div>
                        </div>

                        <div class="column is-6">
                            <div class="notification is-light">
                                <p class="has-text-weight-semibold">
                                    <i class="ph-fill ph-layout mr-2"></i>Bulma
                                </p>
                                <p>Simple responsive layout system, readable classes, quick iteration.</p>
                            </div>
                        </div>

                        <div class="column is-6">
                            <div class="notification is-light">
                                <p class="has-text-weight-semibold">
                                    <i class="ph-fill ph-brackets-curly mr-2"></i>Custom Theme
                                </p>
                                <p>Purpose-built components for structured learning experiences.</p>
                            </div>
                        </div>

                        <div class="column is-6">
                            <div class="notification is-light">
                                <p class="has-text-weight-semibold">
                                    <i class="ph-fill ph-git-branch mr-2"></i>Open Source
                                </p>
                                <p>Transparent, extendable, community-friendly foundation.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 4. For Salesforce people --}}
    <div class="section">
        <div class="container is-fluid">
            <div class="has-text-centered mb-6">
                <h2 class="title is-2">Built for Salesforce people</h2>
                <p class="subtitle is-5">
                    Designed for learners, builders, and working professionals across the ecosystem.
                </p>
            </div>

            <div class="columns is-multiline is-variable is-5">
                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="card lift-card">
                        <div class="card-content">
                            <span class="icon-pill"><i class="ph-fill ph-gear"></i></span>
                            <h3 class="title is-5">Admins</h3>
                            <p>Learn configuration, automation, reports, flows, and better org thinking.</p>
                        </div>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="card lift-card">
                        <div class="card-content">
                            <span class="icon-pill"><i class="ph-fill ph-code"></i></span>
                            <h3 class="title is-5">Developers</h3>
                            <p>Work through Apex, LWC, integrations, patterns, and practical builds.</p>
                        </div>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="card lift-card">
                        <div class="card-content">
                            <span class="icon-pill"><i class="ph-fill ph-tree-structure"></i></span>
                            <h3 class="title is-5">Architects</h3>
                            <p>Think in systems, scale, governance, and long-term platform design.</p>
                        </div>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="card lift-card">
                        <div class="card-content">
                            <span class="icon-pill"><i class="ph-fill ph-student"></i></span>
                            <h3 class="title is-5">Career Switchers</h3>
                            <p>Get a structured path into the ecosystem without drowning in random content.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 5. About Swarnil --}}
    <div class="section">
        <div class="container is-fluid">
            <div class="columns is-vcentered is-variable is-6">
                <div class="column is-12-mobile is-4-desktop">
                    {{#if feature_image}}
                        <figure class="image about-avatar is-4by4">
                            <img src="{{img_url feature_image size="l"}}" alt="{{title}}">
                        </figure>
                    {{else}}
                        <div class="box has-text-centered">
                            <span class="icon-pill">
                                <i class="ph-fill ph-user"></i>
                            </span>
                            <p class="title is-4">Swarnil</p>
                            <p>Builder, storyteller, developer, open-source chaos manager.</p>
                        </div>
                    {{/if}}
                </div>

                <div class="column is-12-mobile is-8-desktop">
                    <h2 class="title is-2 mb-4">About Swarnil</h2>
                    <div class="content is-medium">
                        <p>
                            This project was started by <strong>Swarnil</strong> to build a more structured, modern, and practical learning experience for Salesforce people.
                        </p>
                        <p>
                            The aim is simple: create a clean open-source foundation where content, design, documentation, and learning paths work together instead of behaving like strangers forced into the same group project.
                        </p>
                        <p>
                            It is part learning platform, part theme system, part documentation engine—and fully focused on helping people learn better.
                        </p>
                    </div>

                    <div class="buttons mt-4">
                        <a href="https://imswarnil.com" target="_blank" rel="noopener" class="button is-primary">
                            <span class="icon"><i class="ph-fill ph-globe"></i></span>
                            <span>Visit Swarnil</span>
                        </a>
                        <a href="/contact/" class="button is-light">
                            <span class="icon"><i class="ph-fill ph-envelope"></i></span>
                            <span>Say Hello</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 6. Open source philosophy --}}
    <div class="section">
        <div class="container is-fluid">
            <div class="box">
                <div class="columns is-variable is-6">
                    <div class="column is-12-mobile is-6-desktop">
                        <h2 class="title is-3">Open source, by design</h2>
                        <div class="content">
                            <p>
                                This is meant to be an open foundation: readable code, reusable components, honest structure, and room for people to improve it.
                            </p>
                            <p>
                                Open source here is not a buzzword sticker slapped on top of confusion. It means people can inspect, learn, extend, and contribute.
                            </p>
                        </div>
                    </div>

                    <div class="column is-12-mobile is-6-desktop">
                        <div class="content">
                            <ul>
                                <li>Transparent theme structure</li>
                                <li>Reusable Bulma-first component patterns</li>
                                <li>Ghost-native templates and content architecture</li>
                                <li>Built for iteration, not lock-in</li>
                                <li>Community contributions welcome</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 7. Contribute --}}
    <div id="contribute" class="section">
        <div class="container is-fluid">
            <div class="has-text-centered mb-6">
                <h2 class="title is-2">How you can contribute</h2>
                <p class="subtitle is-5">Code, content, testing, feedback, ideas—pick your weapon.</p>
            </div>

            <div class="columns is-multiline is-variable is-5">
                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-bug"></i></span>
                        <h3 class="title is-5">Report Issues</h3>
                        <p>Find bugs, broken UI, weird flows, or anything behaving suspiciously.</p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-git-pull-request"></i></span>
                        <h3 class="title is-5">Submit PRs</h3>
                        <p>Improve templates, styles, docs, or reusable components.</p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-note-pencil"></i></span>
                        <h3 class="title is-5">Improve Content</h3>
                        <p>Suggest lessons, polish docs, improve wording, and fix confusing bits.</p>
                    </div>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <div class="box lift-box">
                        <span class="icon-pill"><i class="ph-fill ph-megaphone"></i></span>
                        <h3 class="title is-5">Share It</h3>
                        <p>Spread the project, tell people, and help useful things travel farther.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 8. Sponsor --}}
    <div id="sponsor" class="section">
        <div class="container is-fluid">
            <div class="columns is-vcentered is-variable is-6">
                <div class="column is-12-mobile is-7-desktop">
                    <h2 class="title is-2 mb-4">Sponsor the project</h2>
                    <div class="content is-medium">
                        <p>
                            Sponsorship helps keep the project evolving: better documentation, better components, better lessons, and more time spent building instead of wrestling random distractions.
                        </p>
                        <p>
                            If this project helps you, your team, or your community, sponsoring it is a practical way to keep it moving forward.
                        </p>
                    </div>
                </div>

                <div class="column is-12-mobile is-5-desktop">
                    <div class="box has-text-centered">
                        <span class="icon-pill"><i class="ph-fill ph-heart-straight"></i></span>
                        <p class="title is-4">Support the build</p>
                        <p class="mb-4">Help fund design, docs, content, and long-term maintenance.</p>
                        <div class="buttons is-centered">
                            <a href="/contact/" class="button is-primary">Become a Sponsor</a>
                            <a href="/newsletter/" class="button is-light">Stay Updated</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 9. Join team / collaborate --}}
    <div class="section">
        <div class="container is-fluid">
            <div class="box cta-box">
                <div class="columns is-vcentered is-variable is-6">
                    <div class="column is-12-mobile is-8-desktop">
                        <h2 class="title is-3 mb-3">Want to join the journey?</h2>
                        <p class="content mb-0">
                            If you are a developer, designer, writer, educator, Salesforce expert, or just someone who likes building useful things well, there is room to collaborate.
                        </p>
                    </div>

                    <div class="column is-12-mobile is-4-desktop">
                        <div class="buttons is-justify-content-flex-end">
                            <a href="/contact/" class="button is-primary">
                                <span class="icon"><i class="ph-fill ph-handshake"></i></span>
                                <span>Join Team</span>
                            </a>
                            <a href="#contribute" class="button is-light">
                                <span class="icon"><i class="ph-fill ph-plus-circle"></i></span>
                                <span>Contribute</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- 10. Roadmap --}}
    <div class="section">
        <div class="container is-fluid">
            <h2 class="title is-2 mb-5">What’s next</h2>

            <div class="columns is-multiline is-variable is-5">
                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <article class="message">
                        <div class="message-header">
                            <p>Courses</p>
                        </div>
                        <div class="message-body">
                            More structured learning paths and deeper lesson architecture.
                        </div>
                    </article>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <article class="message">
                        <div class="message-header">
                            <p>Docs</p>
                        </div>
                        <div class="message-body">
                            Better documentation patterns, reference pages, and reusable components.
                        </div>
                    </article>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <article class="message">
                        <div class="message-header">
                            <p>Community</p>
                        </div>
                        <div class="message-body">
                            More contribution pathways, collaboration loops, and shared feedback.
                        </div>
                    </article>
                </div>

                <div class="column is-12-mobile is-6-tablet is-3-desktop">
                    <article class="message">
                        <div class="message-header">
                            <p>Design System</p>
                        </div>
                        <div class="message-body">
                            Continued refinement of the Ghost + Bulma open-source theme foundation.
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>

    {{!-- 11. Optional page content from editor --}}
    {{#if content}}
    <div class="section">
        <div class="container is-fluid">
            <div class="columns is-centered">
                <div class="column is-12-mobile is-10-desktop">
                    <div class="box">
                        <h2 class="title is-3 mb-4">More about this project</h2>
                        <div class="content is-medium">
                            {{{content}}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- 12. Footer strip --}}
    <div class="section pt-0">
        <div class="container is-fluid">
            <div class="strip">
                <div class="level is-mobile is-flex-wrap-wrap">
                    <div class="level-left">
                        <div class="level-item">
                            <p class="is-size-7">
                                {{@site.title}} • Built on Ghost • Styled with Bulma • Started by Swarnil
                            </p>
                        </div>
                    </div>

                    <div class="level-right">
                        <div class="level-item">
                            <p class="is-size-7">
                                Proudly open source
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{{/page}}