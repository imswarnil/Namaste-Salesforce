{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  page-about.hbs — Custom template for /about/ (slug `about`).
  Hero → founder → mission → timeline → values → editable body → contribute.
  Reuses about/founder, home/timeline-item, home/feature-card, icons/*.
  Renders standalone via the /about/ route AND as a Ghost page (slug `about`);
  the sections live outside {{#page}}, post fields are optional overrides.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── Hero ── --}}
<section class="relative overflow-hidden bg-brand-900 text-white">
  {{> "components/hero-bg"}}
  <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:py-20">
    <span class="ns-kicker ns-kicker--light">{{t "Our story"}}</span>
    <h1 class="mt-6 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">{{#if title}}{{title}}{{else}}{{t "About Namaste Salesforce"}}{{/if}}</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-white/80">
      {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "A free, open-source platform built to make world-class Salesforce education accessible to everyone — no paywalls, no gatekeeping."}}{{/if}}
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="#/portal/signup" data-portal="signup" class="ns-btn ns-btn--white ns-btn--lg">{{> icons name="rocket"}}{{t "Start learning free"}}</a>
      <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="ns-btn ns-btn--glass ns-btn--lg">{{> icons name="github" class="h-4 w-4"}}{{t "Star on GitHub"}}</a>
    </div>
  </div>
</section>

{{!-- ── Founder ── --}}
<section class="ns-container ns-section">
  <div class="mb-8 text-center">
    <p class="ns-kicker">{{t "Meet the founder"}}</p>
    <h2 class="ns-band__title">{{t "Built by a Salesforce developer, for developers"}}</h2>
  </div>
  {{> "about/founder"}}
</section>

{{!-- ── Mission ── --}}
<section class="ns-band ns-band--sunken ns-band--edge-top ns-band--edge-bottom">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-20">
    <div>
      <p class="ns-kicker">{{t "Our mission"}}</p>
      <h2 class="ns-band__title">{{t "Learning Salesforce should be free for everyone"}}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{{t "Talent is everywhere but opportunity isn't. Namaste Salesforce exists to close that gap — turning curious beginners into confident, certified professionals through hands-on, community-driven learning."}}</p>
    </div>
    <div class="ns-features">
      {{> "home/feature-card" icon="users" title="10K+ learners" body="A worldwide community learning together."}}
      {{> "home/feature-card" icon="graduation-cap" title="50+ courses" body="Admin to Architect, beginner to advanced."}}
      {{> "home/feature-card" icon="video" title="300+ lessons" body="Bite-sized, hands-on, project-led."}}
      {{> "home/feature-card" icon="lock-open" title="100% free" body="Open curriculum, open code, forever."}}
    </div>
  </div>
</section>

{{!-- ── Mission timeline ── --}}
<section class="ns-container ns-section">
  <div class="mb-10 text-center">
    <p class="ns-kicker">{{t "The journey"}}</p>
    <h2 class="ns-band__title">{{t "How we got here"}}</h2>
  </div>
  <ol class="ns-timeline space-y-8">
    {{> "home/timeline-item" year="The why" title="Close the opportunity gap" body="Make hands-on Salesforce learning accessible to anyone, anywhere — for free."}}
    {{> "home/timeline-item" year="2024" title="Platform launched" body="The first open courses and training went live to a growing community."}}
    {{> "home/timeline-item" year="2025" title="10,000 learners" body="Crossed ten thousand learners and 300+ lessons across every role."}}
    {{> "home/timeline-item" year="2026" title="AI-era curriculum" body="Added Agentforce, Data Cloud and Einstein tracks for next-gen skills."}}
  </ol>
</section>

{{!-- ── Values ── --}}
<section class="ns-band ns-band--sunken ns-band--edge-top ns-band--edge-bottom">
  <div class="ns-band__inner">
    <div class="ns-band__head ns-band__head--center">
      <p class="ns-kicker">{{t "What we stand for"}}</p>
      <h2 class="ns-band__title">{{t "The principles behind the platform"}}</h2>
    </div>
    <div class="ns-features mt-12">
      {{> "home/feature-card" icon="lock-open" title="Open by default" body="Curriculum, code and content are open source — learn from or improve any of it."}}
      {{> "home/feature-card" icon="flask" title="Learn by doing" body="Real orgs, real Apex, real projects. We teach the way the job works."}}
      {{> "home/feature-card" icon="users" title="Community first" body="Questions, answers and mentorship sit at the heart of the platform."}}
      {{> "home/feature-card" icon="seal-check" title="Quality, always" body="Every lesson is written and reviewed by certified Salesforce pros."}}
    </div>
  </div>
</section>

{{!-- ── Editable page body (only when rendered as a real Ghost page) ── --}}
{{#page}}{{#if html}}
  <section class="ns-container ns-section">
    <div class="prose prose-lg max-w-none gh-content">{{content}}</div>
  </section>
{{/if}}{{/page}}

{{!-- ── Contribute band ── --}}
<section class="ns-band ns-band--sunken ns-band--edge-top">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
    <p class="ns-kicker">{{t "Open source"}}</p>
    <h2 class="ns-band__title">{{t "Help us build it"}}</h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">{{t "This theme and its curriculum are open source. Found a bug, want a feature, or have a lesson to share? Contributions of every size are welcome."}}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener"
         class="ns-btn ns-btn--primary ns-btn--lg">{{> icons name="github" class="h-5 w-5"}}{{t "View on GitHub"}}</a>
      <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 rounded-btn px-6 py-3 font-semibold text-pink-600 ring-1 ring-pink-500/30 ns-transition hover:bg-pink-500/10">{{> icons name="heart" class="h-5 w-5"}}{{t "Become a sponsor"}}</a>
    </div>
  </div>
</section>
