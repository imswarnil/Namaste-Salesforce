{{!< default}}
{{!-- ════════════════════════════════════════════════════════════════════════
  page-about.hbs — Custom template for the /about/ page.
  Ghost auto-uses this for the page with slug `about`. Designed hero + mission
  + values + editable body + open-source band. Reuses home/feature-card.
═══════════════════════════════════════════════════════════════════════════ --}}
{{#page}}

{{!-- ── Hero ── --}}
<section class="relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 text-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-20 -top-20 h-80 w-80 rounded-full bg-brand-400/30 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-violet-500/20 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:py-28">
    <span class="inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-sm font-semibold ring-1 ring-white/20">
      <i class="ph-fill ph-heart" aria-hidden="true"></i>{{t "Our story"}}
    </span>
    <h1 class="mt-6 font-heading text-4xl font-extrabold tracking-tight sm:text-5xl">{{title}}</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-white/80">
      {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "A free, open-source platform built to make world-class Salesforce education accessible to everyone — no paywalls, no gatekeeping."}}{{/if}}
    </p>
  </div>
</section>

{{!-- ── Mission ── --}}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Our mission"}}</p>
      <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Learning Salesforce should be free for everyone"}}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        {{t "Talent is everywhere but opportunity isn't. Namaste Salesforce exists to close that gap — turning curious beginners into confident, certified professionals through hands-on, community-driven learning."}}
      </p>
    </div>
    <div class="grid grid-cols-2 gap-4">
      {{> "home/feature-card" icon="ph-users-three" title="10K+ learners" body="A worldwide community learning together."}}
      {{> "home/feature-card" icon="ph-graduation-cap" title="50+ courses" body="Admin to Architect, beginner to advanced."}}
      {{> "home/feature-card" icon="ph-video" title="300+ lessons" body="Bite-sized, hands-on, project-led."}}
      {{> "home/feature-card" icon="ph-lock-open" title="100% free" body="Open curriculum, open code, forever."}}
    </div>
  </div>
</section>

{{!-- ── Editable page body (managed in Ghost admin) ── --}}
{{#if content}}
  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <div class="prose prose-lg max-w-none gh-content">{{content}}</div>
  </section>
{{/if}}

{{!-- ── Open-source / contribute band ── --}}
<section class="border-t border-border bg-surface-sunken">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">{{t "Open source"}}</p>
    <h2 class="mt-2 font-heading text-3xl font-extrabold sm:text-4xl">{{t "Help us build it"}}</h2>
    <p class="mx-auto mt-3 max-w-xl text-muted">{{t "This theme and its curriculum are open source. Found a bug, want a feature, or have a lesson to share? Contributions of every size are welcome."}}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-6 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">
        <i class="ph ph-github-logo" aria-hidden="true"></i>{{t "View on GitHub"}}
      </a>
      <a href="https://github.com/imswarnil/Namaste-Salesforce/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 rounded-pill border border-border px-6 py-3 font-semibold transition hover:border-brand-500 hover:text-brand-600">
        <i class="ph ph-book-open" aria-hidden="true"></i>{{t "Contribution guide"}}
      </a>
    </div>
  </div>
</section>

{{/page}}
