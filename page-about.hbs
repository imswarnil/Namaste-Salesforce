{{!< default}}

{{!-- /about — Ghost auto-picks page-about.hbs for the page with slug
"about". Homepage-grade, built from live data where it can be:

    hero        the author (Ghost's own profile: photo, bio) beside
                the page's title and excerpt, plus the facts strip
    the copy    the page's editable body, from the editor
    journey     the SAME timeline the homepage tells — one partial
    mission     what the site promises, and the ways to reach us
    ask         the signup moment

The Person/AboutPage structured data is emitted here because this
is the one page whose subject IS the author. The #get lives INSIDE
the contentFor: the other way round, contentFor registers against
the #get's switched context and the block never reaches the head. --}}

{{#post}}

{{#contentFor "head"}}
{{#get "authors" limit="1" as |host|}}
{{#if host.[0]}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": "{{url absolute="true"}}#about",
    "url": "{{url absolute="true"}}",
    "name": "{{title}}",
    "isPartOf": { "@id": "{{@site.url}}/#website" },
    "mainEntity": {
        "@type": "Person",
        "@id": "{{@site.url}}/#person",
        "name": "{{host.[0].name}}",
        "url": "{{host.[0].url}}"{{#if host.[0].profile_image}},
        "image": "{{img_url host.[0].profile_image size="m" absolute="true"}}"{{/if}}{{#if host.[0].bio}},
        "description": "{{host.[0].bio}}"{{/if}},
        "worksFor": { "@id": "{{@site.url}}/#organization" },
        "sameAs": [
            {{#if @custom.social_linkedin}}"{{@custom.social_linkedin}}",{{/if}}
            {{#if @custom.social_github}}"{{@custom.social_github}}",{{/if}}
            {{#if @custom.social_youtube}}"{{@custom.social_youtube}}",{{/if}}
            {{#if @custom.social_instagram}}"{{@custom.social_instagram}}",{{/if}}
            "{{@site.url}}/"
        ]
    }
}
</script>
{{/if}}
{{/get}}
{{/contentFor}}

{{!-- HERO. The old one put the page title beside a 4:5 portrait
card; with no profile image set that card was a 36rem grey box with
an avatar glyph in it, and it dominated the fold. The identity is
now a BYLINE — photo at 6rem, name, role, location, links, on one
line — which is all an about page ever needed, and the fold goes to
the sentence that actually says what this place is.

The strip underneath is live: the counts come from the API, so the
page cannot claim a course count it no longer has. --}}
<section class="about-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="orb" style="width: 460px; height: 460px; top: -180px; right: -120px;" aria-hidden="true"></div>
    <div class="orb" style="width: 320px; height: 320px; bottom: -160px; left: -90px; animation-delay: -3s;" aria-hidden="true"></div>

    <div class="inner relative">
        <div class="about-hero-grid">

            <div class="about-intro" data-animate="left">
                <nav class="crumbs" aria-label="Breadcrumb">
                    <a href="{{@site.url}}">{{> "icons/home"}} {{t "Home"}}</a>
                    {{> "icons/chevron-right"}}
                    <span aria-current="page">{{title}}</span>
                </nav>

                {{#get "authors" limit="1" as |host|}}
                    {{#foreach host}}
                        <div class="about-byline about-byline-top">
                            {{#if profile_image}}
                                <img class="about-byline-photo" src="{{img_url profile_image size="s"}}" alt="{{name}}" loading="eager" />
                            {{else}}
                                <span class="about-byline-photo is-glyph">{{> "icons/avatar"}}</span>
                            {{/if}}
                            <span class="about-byline-copy">
                                <strong>{{name}}</strong>
                                <span>{{t "Salesforce · CRM Analytics · on the way to GTM Engineer"}}{{#if location}} · {{location}}{{/if}}</span>
                            </span>
                        </div>
                    {{/foreach}}
                {{/get}}

                <h1>{{t "Hi, I'm Swarnil. I learn Salesforce, GTM and AI"}} <em>{{t "in public"}}</em>{{t " — so you don't have to learn it alone."}}</h1>

                <p class="about-hero-lead">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Seven-plus years in IT, four on the platform, most of them building dashboards for sales teams I did not fully understand. This site is me closing that gap — the CRM, the revenue process underneath it and the AI layer on top — one written-down lesson at a time."}}{{/if}}</p>

                <div class="about-hero-actions">
                    <a class="btn btn-lg" href="{{@site.url}}/training/">{{> "icons/layers"}} {{t "Walk the trail"}}</a>
                    <a class="btn btn-lg btn-ghost" href="#the-plan">{{> "icons/compass"}} {{t "Why this exists"}}</a>
                </div>

                <ul class="about-byline-social about-hero-social">
                    {{#if @custom.social_youtube}}<li><a href="{{@custom.social_youtube}}" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">{{> "icons/youtube"}}</a></li>{{/if}}
                    {{#if @custom.social_linkedin}}<li><a href="{{@custom.social_linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">{{> "icons/linkedin"}}</a></li>{{/if}}
                    {{#if @site.twitter}}<li><a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X" title="X">{{> "icons/x"}}</a></li>{{/if}}
                    {{#if @custom.social_github}}<li><a href="{{@custom.social_github}}" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">{{> "icons/github"}}</a></li>{{/if}}
                    {{#if @custom.social_instagram}}<li><a href="{{@custom.social_instagram}}" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">{{> "icons/instagram"}}</a></li>{{/if}}
                    <li><a href="{{@site.url}}/my-schedule/" aria-label="{{t "Schedule"}}" title="{{t "When I go live and publish"}}">{{> "icons/calendar"}}</a></li>
                </ul>
            </div>

            {{!-- The film. Same card grammar as the homepage hero
            (partials/hero.hbs, assets/js/hero-video.js): the cover at
            rest, press to play, press again to close. Nothing is
            requested from YouTube until the first press. --}}
            <div class="hero-feature about-hero-feature" data-animate="right">
                <div class="hero-feature-card has-video"
                    data-hero-video="{{#if @custom.hero_video}}{{@custom.hero_video}}{{else}}https://www.youtube.com/watch?v=RZMj7C41AuQ{{/if}}">
                    <div class="hero-feature-poster">
                        {{#if @site.cover_image}}
                            <img class="hero-feature-cover" src="{{img_url @site.cover_image size="l"}}" alt="" fetchpriority="high" />
                        {{else}}
                            <span class="hero-feature-grid" aria-hidden="true"></span>
                            <span class="hero-feature-mark"><img src="{{asset "images/ns-mark.svg"}}" alt="" /></span>
                        {{/if}}
                        <span class="hero-feature-scrim" aria-hidden="true"></span>
                        <span class="about-film-label">{{> "icons/video"}} {{t "Two minutes on why this exists"}}</span>
                    </div>
                    <div class="hero-feature-stage" data-hero-stage></div>
                    <button class="hero-feature-toggle" type="button" data-hero-toggle aria-expanded="false">
                        <span class="hero-feature-disc" aria-hidden="true">
                            <svg class="i-play" viewBox="0 0 24 24"><path d="M9 7.5v9l7.5-4.5z" fill="currentColor"/></svg>
                            <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
                        </span>
                        <span class="hero-feature-toggle-label">
                            <span class="on-idle">{{t "Watch the intro"}}</span>
                            <span class="on-playing">{{t "Close"}}</span>
                        </span>
                    </button>
                </div>
            </div>

        </div>

        {{!-- Live counts, not claims --}}
        <div class="about-stats" data-animate>
            {{#get "posts" filter="tag:hash-course" limit="1" as |i c|}}
                <a class="about-stat" href="{{@site.url}}/courses/">
                    <strong data-count="{{c.total}}">{{c.total}}</strong>
                    <span>{{t "Courses"}}</span>
                </a>
            {{/get}}
            {{#get "posts" filter="tag:hash-training" limit="1" as |i c|}}
                <a class="about-stat" href="{{@site.url}}/training/">
                    <strong data-count="{{c.total}}">{{c.total}}</strong>
                    <span>{{t "Training sections"}}</span>
                </a>
            {{/get}}
            {{#get "posts" filter="tag:hash-video" limit="1" as |i c|}}
                <a class="about-stat" href="{{@site.url}}/videos/">
                    <strong data-count="{{c.total}}">{{c.total}}</strong>
                    <span>{{t "Videos"}}</span>
                </a>
            {{/get}}
            {{#get "posts" filter="tag:hash-blog" limit="1" as |i c|}}
                <a class="about-stat" href="{{@site.url}}/blog/">
                    <strong data-count="{{c.total}}">{{c.total}}</strong>
                    <span>{{t "Articles"}}</span>
                </a>
            {{/get}}
            <span class="about-stat is-static">
                <strong>{{t "Free"}}</strong>
                <span>{{t "Forever"}}</span>
            </span>
        </div>
    </div>
</section>

{{!-- WHEN THINGS HAPPEN — the rhythm, proven: the last issue, video
and article with their real dates, then the standing schedule.
Every card links to the real post; /my-schedule/ has the full
board. --}}
<section class="section section-alt outer about-rhythm">
    <div class="inner">
        <div class="section-head" data-animate>
            <div>
                <span class="kicker">{{> "icons/calendar"}} {{t "The schedule"}}</span>
                <h2>{{t "When I go live, publish and send"}}</h2>
                <p>{{t "A weekly letter, a video most weeks, live sessions on YouTube — the dates below are the real last ones, not a promise."}}</p>
            </div>
            <div class="section-head-cta">
                {{#if @custom.social_youtube}}
                    <a class="btn btn-youtube" href="{{@custom.social_youtube}}?sub_confirmation=1" target="_blank" rel="noopener">{{> "icons/youtube"}} {{t "Subscribe on YouTube"}}</a>
                {{/if}}
                <a class="section-more" href="{{@site.url}}/my-schedule/">{{t "Full schedule"}} {{> "icons/arrow-right"}}</a>
            </div>
        </div>

        <div class="schedule-rhythm" data-animate-stagger>
            {{#get "posts" filter="tag:hash-newsletter" limit="1" as |last|}}
                {{#foreach last}}
                    <a class="rhythm-card" href="{{url}}">
                        <span class="rhythm-ico" aria-hidden="true">{{> "icons/mail"}}</span>
                        <span class="rhythm-kind">{{t "Last issue"}}</span>
                        <strong>{{title}}</strong>
                        <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="ddd, D MMM"}}</time>
                    </a>
                {{/foreach}}
            {{/get}}
            {{#get "posts" filter="tag:hash-video" limit="1" as |last|}}
                {{#foreach last}}
                    <a class="rhythm-card" href="{{url}}">
                        <span class="rhythm-ico" aria-hidden="true">{{> "icons/video"}}</span>
                        <span class="rhythm-kind">{{t "Last video"}}</span>
                        <strong>{{title}}</strong>
                        <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="ddd, D MMM"}}</time>
                    </a>
                {{/foreach}}
            {{/get}}
            {{#get "posts" filter="tag:hash-blog" limit="1" as |last|}}
                {{#foreach last}}
                    <a class="rhythm-card" href="{{url}}">
                        <span class="rhythm-ico" aria-hidden="true">{{> "icons/pen"}}</span>
                        <span class="rhythm-kind">{{t "Last article"}}</span>
                        <strong>{{title}}</strong>
                        <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="ddd, D MMM"}}</time>
                    </a>
                {{/foreach}}
            {{/get}}
            {{#get "posts" filter="tag:hash-lesson" limit="1" as |last|}}
                {{#foreach last}}
                    <a class="rhythm-card" href="{{url}}">
                        <span class="rhythm-ico" aria-hidden="true">{{> "icons/graduation-cap"}}</span>
                        <span class="rhythm-kind">{{t "Last lesson"}}</span>
                        <strong>{{title}}</strong>
                        <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="ddd, D MMM"}}</time>
                    </a>
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>

{{!-- WHY THIS EXISTS — the one piece of this page that is not live
data and never should be: a statement of intent, in the first
person, with a date on it.

The story is told ONCE, as prose, with a scannable summary beside
it. It used to run as five paragraphs followed by four cards that
repeated the same sentences almost word for word — the reader paid
for the story twice and the section read as filler.

The same voice shows up as partials/widgets/quote.hbs in the
training sidebar; if the story changes, change both. --}}
{{!-- This block is the page's <main>: the reading section moved in
here when the editable body was folded into it. #the-plan stays the
hero button's target, so it sits on the inner wrapper — an element
cannot carry two ids, and the first one silently wins. --}}
<main id="site-main" class="section outer">
    <div class="inner" id="the-plan">
        <div class="section-head" data-animate>
            <div>
                <span class="kicker">{{> "icons/compass"}} {{t "Why this exists"}}</span>
                <h2>{{t "The goal, the motive, and the plan"}}</h2>
                <p>{{t "I went looking for a proper, step-by-step way to learn go-to-market and found it scattered across a hundred places. So I started writing the one I wanted — in public, while I learn it myself."}}</p>
            </div>
        </div>

        {{!-- ONE story, never two.

        The page's own body WINS when the editor has written one —
        Ghost content always beats theme copy. The built-in version
        below is the fallback for an empty page, which is also what
        a fresh install gets.

        Both were rendering, one under the other, and they told the
        same story twice under different headings. --}}
        <div class="about-plan">
            <div class="about-why-story" data-animate>
                {{#if html}}
                    <div class="about-copy gh-content">{{content}}</div>
                {{else}}
                    <p>{{t "The first real thing I built in this ecosystem was Salesforce CRM Analytics — dashboards and reports for people who needed a number by Monday. I got good at the answer. I never really learned the question."}}</p>

                    <p>{{t "Then Twilio, where I heard the term GTM for the first time. Behind it were whole teams I had been building dashboards about without understanding: top-of-funnel, opportunity management, CPQ, quote-to-cash. I could report on the pipeline. I could not explain why it moved."}}</p>

                    <p>{{t "So this is me closing that gap in public — Salesforce in depth, the business process underneath it, then the stack growing around it. I don't know most of it today. That is the premise: watch it get written down as I learn it, and let's find out whether it lands me the job."}}</p>
                {{/if}}
            </div>

            <aside class="about-glance" data-animate="right">
                <div class="about-glance-card">
                    <h3>{{> "icons/list-icon"}} {{t "At a glance"}}</h3>
                    <dl>
                        <dt><span class="about-glance-ico">{{> "icons/rocket"}}</span>{{t "The goal"}}</dt>
                        <dd>{{t "GTM Engineer — and using AI to get there."}}</dd>

                        <dt><span class="about-glance-ico">{{> "icons/database"}}</span>{{t "Starting point"}}</dt>
                        <dd>{{t "Salesforce CRM Analytics. Dashboards, not decisions."}}</dd>

                        <dt><span class="about-glance-ico">{{> "icons/zap"}}</span>{{t "The turn"}}</dt>
                        <dd>{{t "Twilio, and the word GTM."}}</dd>

                        <dt><span class="about-glance-ico">{{> "icons/layers"}}</span>{{t "The plan"}}</dt>
                        <dd>{{t "Salesforce in depth, then n8n, Clay, 6sense and the AI layer."}}</dd>

                        <dt><span class="about-glance-ico">{{> "icons/compass"}}</span>{{t "Where it ends up"}}</dt>
                        <dd>{{t "The stepwise GTM path I could not find anywhere."}}</dd>
                    </dl>
                </div>
            </aside>
        </div>
    </div>
</main>

{{!-- The thesis, inking in word by word — the same band the
homepage carries, because the site should not say its one big
idea two different ways. --}}
{{> "scroll-quote"}}

{{!-- The road so far — the homepage keeps the horizontal
scroll-snap strip (partials/journey.hbs); this page gets its own
vertical stacked version (partials/journey-stacked.hbs), same
chapters, better suited to a page read top to bottom. --}}
{{> "journey-stacked"}}

{{!-- What the learning covers beyond the CRM — the section that
answers "why follow along if I don't work in Salesforce".

Six padded cards with a paragraph each ran the height of a screen
for what is really a LIST. Compact rows: icon, name, one line. The
two I already work in stay marked. --}}
<section class="section outer about-stack">
    <div class="inner">
        <div class="section-head" data-animate>
            <div>
                <span class="kicker">{{> "icons/layers"}} {{t "The stack"}}</span>
                <h2>{{t "Not just Salesforce"}}</h2>
                <p>{{t "A CRM on its own closes nothing. What I'm working through is the go-to-market system around it — and the AI layer quietly eating the manual parts."}}</p>
            </div>
        </div>

        <ul class="stack-grid" data-animate-stagger>
            <li class="stack-item is-core">
                <span class="stack-ico">{{> "icons/cloud"}}</span>
                <strong>{{t "Salesforce"}}</strong>
                <span>{{t "Data model, automation, security, deployment."}}</span>
            </li>
            <li class="stack-item is-core">
                <span class="stack-ico">{{> "icons/database"}}</span>
                <strong>{{t "CRM Analytics"}}</strong>
                <span>{{t "Where I started — datasets, dashboards, metrics."}}</span>
            </li>
            <li class="stack-item">
                <span class="stack-ico">{{> "icons/trending-up"}}</span>
                <strong>{{t "GTM process"}}</strong>
                <span>{{t "ToFu, routing, CPQ, quote-to-cash, retention."}}</span>
            </li>
            <li class="stack-item">
                <span class="stack-ico">{{> "icons/zap"}}</span>
                <strong>{{t "n8n"}}</strong>
                <span>{{t "The glue between systems that never talk."}}</span>
            </li>
            <li class="stack-item">
                <span class="stack-ico">{{> "icons/signal"}}</span>
                <strong>{{t "Clay & 6sense"}}</strong>
                <span>{{t "Enrichment and intent — a list becomes a pipeline."}}</span>
            </li>
            <li class="stack-item">
                <span class="stack-ico">{{> "icons/sparkles"}}</span>
                <strong>{{t "The AI layer"}}</strong>
                <span>{{t "Agents doing the work that used to be clicking."}}</span>
            </li>
        </ul>
    </div>
</section>

{{!-- The close: the three rules, then the ask. They were two
sections; the rules are the reason to say yes to the ask, so they
now sit in the same block. --}}
<section class="section outer">
    <div class="inner">
        <ul class="promise-strip" data-animate-stagger>
        <li>
        <span class="promise-ico">{{> "icons/gift"}}</span>
        <strong>{{t "Free, forever"}}</strong>
        <span>{{t "The lessons are the product. Membership never gates the path."}}</span>
        </li>
        <li>
        <span class="promise-ico">{{> "icons/code"}}</span>
        <strong>{{t "Built before it's written"}}</strong>
        <span>{{t "Everything here ran in a real org first — mistakes included."}}</span>
        </li>
        <li>
        <span class="promise-ico">{{> "icons/shield"}}</span>
        <strong>{{t "Honest, even when it's \"don't\""}}</strong>
        <span>{{t "Wrong tool, wrong answer — the lesson says so."}} <a href="{{@site.url}}/changelog/">{{t "Changelog"}}</a></span>
        </li>
        </ul>
    </div>
</section>

{{#if @site.members_enabled}}
    {{^if @member}}
        <section class="section outer about-close">
            <div class="inner">
                <div class="home-cta" data-animate="zoom">
                    <div class="orb" style="width: 300px; height: 300px; top: -100px; right: 10%; animation-delay: -2s;" aria-hidden="true"></div>
                    <h2>{{t "Follow along"}}</h2>
                    <p>{{t "One email a week — what got built, what broke, what to try next."}}</p>
                    <a class="btn btn-lg btn-inverse" href="{{@site.url}}/signup/">{{> "icons/mail"}} {{t "Subscribe free"}}</a>
                </div>
            </div>
        </section>
    {{/if}}
{{/if}}

{{/post}}
