{{!< default}}

{{!-- /shop — digital assets: ebooks, notes, themes, kits.
Prices are internal-tag descriptions (#shop-price-*); the single
holds the purchase link in its content. --}}

<section class="changelog-hero outer">
    <div class="inner">
        <span class="kicker">{{> "icons/gift"}} {{t "Shop"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
        {{else}}
            <h1>{{t "The shop"}}</h1>
            <p>{{t "Digital things I made and use — ebooks, working notes, themes and kits. Some free, all honest."}}</p>
        {{/page}}
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner">
        <div class="card-grid">
            {{#foreach posts}}
                {{> "card-product"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</main>
