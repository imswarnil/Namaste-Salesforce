{{!< default}}

{{!-- /shop — digital assets: ebooks, notes, themes, kits.
Prices are internal-tag descriptions (#shop-price-*); the single
holds the purchase link in its content. --}}

<section class="changelog-hero outer">
    <div class="inner">
        <span class="kicker">{{> "icons/gift"}} {{t "Shop"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
        {{else}}
            <h1>{{t "The shop"}}</h1>
            <p>{{t "Digital things I made and use — ebooks, working notes, themes and kits. Some free, all honest."}}</p>
        {{/page}}
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner">
        <div class="filter-bar" data-filter-bar data-filter-facets="sprice" hidden>
            <div class="filter-group" data-filter-group="sprice" hidden>
                <span class="filter-label">{{> "icons/gift"}} {{t "Price"}}</span>
            </div>
            <button class="filter-clear" data-filter-clear>{{t "Clear"}}</button>
        </div>

        <div class="card-grid">
            {{#foreach posts}}
                {{> "card-product"}}
            {{/foreach}}
        </div>
        <div class="filter-empty" data-filter-empty style="display:none">
            {{t "Nothing at that price — clear the filter."}}
        </div>
        {{pagination}}
    </div>
</main>
