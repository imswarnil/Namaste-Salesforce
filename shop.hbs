{{!< default}}

{{!-- Structured data for this listing page. Keep `filter` identical
to this collection's filter in routes.yaml. --}}
{{> "json-ld-collection" name="Shop" path="shop" filter="tag:hash-shop"}}

{{!-- /shop — digital assets: ebooks, notes, themes, kits.
Prices are internal-tag descriptions (#shop-price-*); the single
holds the purchase link in its content. --}}

<section class="changelog-hero outer">
    <div class="inner">
        <span class="kicker">{{> "icons/gift"}} {{t "Shop"}}</span>
        {{#page}}
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
        {{else}}
            <h1>{{t "The shop"}}</h1>
            <p>{{t "Digital things I made and use — ebooks, working notes, themes and kits. Some free, all honest."}}</p>
        {{/page}}
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner listing-layout">

        <aside class="listing-side">
            <div class="listing-side-sticky">
                <div class="filter-sidebar" data-filter-bar data-filter-facets="sprice" hidden>
                    <div class="filter-side-group" data-filter-group="sprice" hidden>
                        <h4 class="widget-title">{{> "icons/gift"}} {{t "Price"}}</h4>
                    </div>
                    <button class="filter-clear" data-filter-clear>{{t "Clear"}}</button>
                </div>

                {{> "widgets/sponsor"}}
            </div>
        </aside>

        <div class="listing-main">
            <div class="card-grid">
                {{#foreach posts}}
                    {{> "card-product"}}
                {{/foreach}}
            </div>
            <div class="filter-empty" data-filter-empty style="display:none">
                {{t "Nothing at that price — clear the filter."}}
            </div>
            {{pagination}}
        </div>

    </div>
</main>
