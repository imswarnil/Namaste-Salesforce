{{!-- blog/sidebar.hbs — blog sidebar WIDGETS (about, tag cloud, quick links,
     newsletter, sponsor). No outer wrapper: the caller provides
     <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start"> so it can be
     reused on both the listing and single-post pages. --}}

  {{!-- About --}}
  <div class="rounded-card border border-border bg-surface-raised p-5 shadow-card">
    <h3 class="font-heading font-bold">{{t "About the blog"}}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">
      {{#if @site.description}}{{@site.description}}{{else}}{{t "Notes, tips and deep dives from the Salesforce ecosystem — written by working developers."}}{{/if}}
    </p>
    <a href="/about/" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 dark:text-brand-300">{{t "About us"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
  </div>

  {{!-- Tag cloud --}}
  <div class="rounded-card border border-border bg-surface-raised p-5 shadow-card">
    <h3 class="font-heading font-bold">{{t "Topics"}}</h3>
    <div class="mt-3 flex flex-wrap gap-2">
      {{#get "tags" filter="visibility:public" limit="14" include="count.posts" order="count.posts desc"}}
        {{#foreach tags}}
          <a href="{{url}}" class="inline-flex items-center gap-1 rounded-pill border border-border px-3 py-1 text-xs font-medium text-muted transition hover:border-brand-500 hover:text-brand-600">
            #{{name}}<span class="text-brand-500">{{count.posts}}</span>
          </a>
        {{/foreach}}
      {{/get}}
    </div>
  </div>

  {{!-- Quick links / archive --}}
  <div class="rounded-card border border-border bg-surface-raised p-5 shadow-card">
    <h3 class="font-heading font-bold">{{t "Explore"}}</h3>
    <ul class="mt-3 space-y-1 text-sm">
      <li><a href="/courses/" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-muted transition hover:bg-brand-500/10 hover:text-brand-600">{{> "icons/courses" class="h-4 w-4"}}{{t "Courses"}}</a></li>
      <li><a href="/training/" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-muted transition hover:bg-brand-500/10 hover:text-brand-600">{{> "icons/training" class="h-4 w-4"}}{{t "Roadmaps"}}</a></li>
      <li><a href="/documentation/" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-muted transition hover:bg-brand-500/10 hover:text-brand-600">{{> "icons/documentation" class="h-4 w-4"}}{{t "Documentation"}}</a></li>
      <li><a href="{{@site.url}}/rss/" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-muted transition hover:bg-brand-500/10 hover:text-brand-600"><i class="ph ph-rss-simple text-base" aria-hidden="true"></i>{{t "RSS feed"}}</a></li>
    </ul>
  </div>

  {{> "ads/slot" format="square"}}

  {{!-- Newsletter --}}
  <div class="rounded-card bg-gradient-to-br from-brand-600 to-brand-900 p-5 text-white">
    <h3 class="font-heading font-bold">{{t "Join the newsletter"}}</h3>
    <p class="mt-1 text-sm text-white/80">{{t "Free Salesforce tips and new posts in your inbox."}}</p>
    <a href="#/portal/signup" data-portal="signup" class="mt-3 inline-flex items-center gap-1.5 rounded-pill bg-white px-4 py-2 text-sm font-bold text-brand-700 transition hover:bg-brand-50">{{> "icons/mail" class="h-4 w-4"}}{{t "Subscribe"}}</a>
  </div>

  {{!-- Sponsor / ad --}}
  {{> "ads/slot" format="rail"}}
