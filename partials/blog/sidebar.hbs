{{!-- blog/sidebar.hbs — the blog's rail widgets.

     Each box is the design system's `.ns-railbox` — a hairline card with a
     mono `__title`. The theme drew the same box four times out of the same
     five utilities, which is four places for the padding to drift.

     No outer wrapper: the caller supplies the sticky column
     (.ns-blog-listing__rail on the index, .ns-post__rail on a post), so this
     partial is placement-agnostic. --}}

{{!-- About --}}
<div class="ns-railbox">
  <p class="ns-railbox__title">{{t "About the blog"}}</p>
  <p class="ns-card__text">
    {{#if @site.description}}{{@site.description}}{{else}}{{t "Notes, tips and deep dives from the Salesforce ecosystem — written by working developers."}}{{/if}}
  </p>
  <a href="/about/" class="ns-btn ns-btn--quiet ns-btn--sm">{{t "About us"}}{{> icons name="arrow-right" class="ns-btn__arrow"}}</a>
</div>

{{!-- Topics — the system's tag strip, with the real post count on each --}}
<div class="ns-railbox">
  <p class="ns-railbox__title">{{t "Topics"}}</p>
  <div class="ns-strip">
    {{#get "tags" filter="visibility:public" limit="14" include="count.posts" order="count.posts desc"}}
      {{#foreach tags}}
        <a href="{{url}}" class="ns-tag ns-tag--pill">{{name}}<span class="ns-tag__count">{{count.posts}}</span></a>
      {{/foreach}}
    {{/get}}
  </div>
</div>

{{!-- Explore --}}
<nav class="ns-railbox" aria-label="{{t "Explore"}}">
  <p class="ns-railbox__title">{{t "Explore"}}</p>
  <div class="ns-sidebar__group">
    <a class="ns-sidebar__link" href="/courses/">{{> icons name="graduation-cap"}}{{t "Courses"}}</a>
    <a class="ns-sidebar__link" href="/training/">{{> icons name="steps"}}{{t "Training"}}</a>
    <a class="ns-sidebar__link" href="/docs/">{{> icons name="book-open"}}{{t "Documentation"}}</a>
    <a class="ns-sidebar__link" href="{{@site.url}}/rss/">{{> icons name="rss"}}{{t "RSS feed"}}</a>
  </div>
</nav>

{{> "ads/slot" format="square"}}
