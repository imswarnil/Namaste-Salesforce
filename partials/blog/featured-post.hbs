{{!-- blog/featured-post.hbs — large 2-column featured article.
     Context: a post (the first post on the blog listing). Reuses author-byline. --}}
<article class="js-spotlight group relative mb-10 grid overflow-hidden rounded-card border border-border bg-surface-raised shadow-card transition hover:shadow-raised lg:grid-cols-2">
  <a href="{{url}}" tabindex="-1" aria-hidden="true" class="block aspect-[16/9] overflow-hidden bg-surface-sunken lg:aspect-auto">
    {{#if feature_image}}
      <img loading="lazy" decoding="async" src="{{img_url feature_image size="l"}}" alt="{{title}}"
           class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]">
    {{else}}
      <span class="flex h-full min-h-64 items-center justify-center bg-gradient-to-br from-brand-700 to-brand-900 text-white/40">
        <i class="ph ph-image text-5xl" aria-hidden="true"></i>
      </span>
    {{/if}}
  </a>
  <div class="relative flex flex-col justify-center p-6 sm:p-8">
    {{#if primary_tag}}
      <a href="{{primary_tag.url}}" class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-600 dark:text-brand-300">{{primary_tag.name}}</a>
    {{/if}}
    <h2 class="mt-2 font-heading text-2xl font-extrabold leading-tight sm:text-3xl">
      <a href="{{url}}" class="transition-colors hover:text-brand-600 dark:hover:text-brand-300">{{title}}</a>
    </h2>
    <p class="mt-3 text-muted">{{excerpt words="32"}}&hellip;</p>
    <div class="mt-5">{{> "components/author-byline"}}</div>
  </div>
</article>
