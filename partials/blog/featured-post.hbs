{{!-- blog/featured-post.hbs — the one promoted piece at the top of the feed.

     The SAME card as every other post, wearing the system's `--wide` shape:
     two columns, a larger title and three lines of excerpt instead of two.
     It used to be twenty lines of bespoke grid + utilities that happened to
     look like a card — which meant the featured post and the cards under it
     drifted apart every time either was touched.

     Context: a post (the first post on the blog listing). --}}
<article class="ns-card ns-bcard ns-bcard--wide js-spotlight mb-10">
  {{#if feature_image}}
    <a href="{{url}}" tabindex="-1" aria-hidden="true" class="ns-bcard__cover">
      {{!-- Top of the feed, so this is usually the LCP element on /blog/. --}}
      {{> "components/img" src=feature_image alt="" eager=true
          sizes="(min-width: 48rem) 50vw, 100vw"}}
      {{#primary_tag}}<span class="ns-tag ns-bcard__cat">{{name}}</span>{{/primary_tag}}
    </a>
  {{else}}
    <span class="ns-bcard__cover ns-bcard__cover--empty">{{> icons name="image"}}</span>
  {{/if}}

  <div class="ns-card__body">
    <h2 class="ns-bcard__title"><a class="ns-card__link" href="{{url}}">{{title}}</a></h2>
    <p class="ns-bcard__excerpt">{{excerpt words="32"}}&hellip;</p>
    {{> "components/author-byline"}}
  </div>
</article>
