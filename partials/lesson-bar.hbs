{{!-- The sticky mobile lesson bar — previous, progress, "n / m",
next — shown under 1024px on the lesson player and the training
reader, where the rail has folded away. rail.js fills the bar from
the rail's list (same numbers as the course card). Context: the
post; prev/next walk in="primary_tag" like the post-nav does. --}}
<div class="lesson-bar" data-lesson-bar>
    {{#prev_post in="primary_tag"}}
        <a class="icon-btn" href="{{url}}" aria-label="{{t "Previous"}}: {{title}}" title="{{title}}">{{> "icons/arrow-left"}}</a>
    {{else}}
        <span class="icon-btn is-off" aria-hidden="true">{{> "icons/arrow-left"}}</span>
    {{/prev_post}}
    <div class="progress" data-lesson-bar-progress aria-hidden="true"></div>
    <span class="lesson-bar-count" data-lesson-bar-count></span>
    {{#next_post in="primary_tag"}}
        <a class="icon-btn" href="{{url}}" aria-label="{{t "Next"}}: {{title}}" title="{{title}}">{{> "icons/arrow-right"}}</a>
    {{else}}
        <span class="icon-btn is-off" aria-hidden="true">{{> "icons/arrow-right"}}</span>
    {{/next_post}}
</div>
