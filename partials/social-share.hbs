{{!-- partials/social-share.hbs — share buttons for the current post.
     Context: a post (uses {{title}} and {{url}}). Inline SVG icons. --}}
<div class="flex items-center gap-2">
  <span class="hidden text-sm font-medium text-muted sm:inline">{{t "Share"}}</span>

  <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute='true'}}"
     onclick="window.open(this.href,'share','width=580,height=400');return false;"
     aria-label="{{t "Share on"}} Twitter / X"
     class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition hover:border-brand-500 hover:text-brand-600">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>

  <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute='true'}}"
     onclick="window.open(this.href,'share','width=580,height=400');return false;"
     aria-label="{{t "Share on"}} Facebook"
     class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition hover:border-brand-500 hover:text-brand-600">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8v8.44C19.61 23.08 24 18.09 24 12.07z"/></svg>
  </a>

  <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute='true'}}"
     onclick="window.open(this.href,'share','width=580,height=400');return false;"
     aria-label="{{t "Share on"}} LinkedIn"
     class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition hover:border-brand-500 hover:text-brand-600">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
  </a>
</div>
