{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-documentation.hbs — Single documentation article
  3-column: docs sidebar · article · (TOC + sponsor on xl). Context: {{#post}}.
═══════════════════════════════════════════════════════════════════════════ --}}
{{!-- Carries the current post id so docs/sidebar can highlight the active link --}}
<span id="doc-current-id" data-id="{{id}}" hidden aria-hidden="true"></span>

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
  <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_14rem]">

    {{> "docs/sidebar"}}

    <main role="main" class="min-w-0">
      <article>
        {{!-- Breadcrumb --}}
        <nav class="mb-4 flex items-center gap-2 text-sm text-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600">{{t "Home"}}</a><span aria-hidden="true">/</span>
          <a href="/documentation/" class="hover:text-brand-600">{{t "Docs"}}</a><span aria-hidden="true">/</span>
          <span class="text-ink">{{title}}</span>
        </nav>

        <header class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-300">
            <i class="ph-fill ph-book-open-text" aria-hidden="true"></i> {{t "Documentation"}}
          </p>
          <h1 class="mt-2 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{title}}</h1>
          {{#if custom_excerpt}}<p class="mt-3 text-lg text-muted">{{custom_excerpt}}</p>{{/if}}
          <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-muted">
            <span class="inline-flex items-center gap-1"><i class="ph ph-timer" aria-hidden="true"></i>{{reading_time}}</span>
            {{#primary_author}}<span class="inline-flex items-center gap-1"><i class="ph ph-user-circle" aria-hidden="true"></i>{{name}}</span>{{/primary_author}}
          </div>
        </header>

        {{#if feature_image}}
          <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
               class="mb-8 w-full rounded-card object-cover shadow-card">
        {{/if}}

        <div class="prose max-w-none gh-content">{{content}}</div>

        {{!-- Prev / next --}}
        <nav class="mt-10 grid gap-4 border-t border-border pt-6 sm:grid-cols-2" aria-label="{{t "Article navigation"}}">
          {{#prev_post filter="tag:documentation"}}
            <a href="{{url}}" class="rounded-card border border-border p-4 transition hover:border-brand-500 hover:shadow-card">
              <span class="text-xs text-muted"><i class="ph ph-arrow-left" aria-hidden="true"></i> {{t "Previous"}}</span>
              <span class="mt-1 block font-semibold">{{title}}</span>
            </a>
          {{/prev_post}}
          {{#next_post filter="tag:documentation"}}
            <a href="{{url}}" class="rounded-card border border-border p-4 text-right transition hover:border-brand-500 hover:shadow-card sm:col-start-2">
              <span class="text-xs text-muted">{{t "Next"}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
              <span class="mt-1 block font-semibold">{{title}}</span>
            </a>
          {{/next_post}}
        </nav>
      </article>
    </main>

    {{!-- Right rail: table of contents + sponsor --}}
    <aside class="hidden xl:block">
      <div class="sticky top-20 space-y-6">
        {{> "components/toc"}}
        {{> "ads/slot" format="rail"}}
      </div>
    </aside>
  </div>
</section>
