{{!< default}}

{{!-- Hidden span carries current post id for JS active-state matching --}}
<span id="doc-current-id" data-id="{{id}}" hidden aria-hidden="true"></span>

{{!-- JSON-LD Omitted for brevity, paste your snippet back here! --}}

<section class="section py-5 has-background-white">
  <div class="container is-fluid">
    <div class="columns is-variable is-5-desktop is-multiline">

      {{!-- 1. LEFT SIDEBAR (Shared) --}}
      {{> "doc-sidebar"}}

      {{!-- 2. ARTICLE COLUMN --}}
      <main class="column is-7-desktop is-8-tablet" role="main">
        <article>
          
          {{!-- Breadcrumb --}}
          <nav class="breadcrumb has-succeeds-separator is-small mb-4" aria-label="breadcrumbs">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/documentation/">Documentation</a></li>
              <li class="is-active"><a href="#" aria-current="page">{{title}}</a></li>
            </ul>
          </nav>

          <header class="mb-6">
            <h1 class="title is-1 mb-3">{{title}}</h1>
            {{#if custom_excerpt}}
              <p class="subtitle is-4 has-text-grey">{{custom_excerpt}}</p>
            {{/if}}
            
            <div class="is-flex is-align-items-center is-flex-wrap-wrap is-size-7 has-text-grey mt-4">
              <span class="is-flex is-align-items-center mr-4">
                <i class="ph ph-timer mr-1" aria-hidden="true"></i> {{reading_time}}
              </span>
              {{#primary_author}}
                <span class="is-flex is-align-items-center mr-4">
                  <i class="ph ph-user-circle mr-1" aria-hidden="true"></i> {{name}}
                </span>
              {{/primary_author}}
            </div>
          </header>

          {{#if feature_image}}
            <figure class="image mb-6">
              <img src="{{img_url feature_image size="l"}}" alt="{{title}}" class="has-ratio">
            </figure>
          {{/if}}

          <div class="content gh-content">
            {{content}}
          </div>

          {{!-- Pagination --}}
          <nav class="columns is-mobile is-multiline mt-6 pt-6 is-border-top" aria-label="Article navigation">
            <div class="column is-half-tablet is-full-mobile">
              {{#prev_post filter="tag:documentation"}}
                <a href="{{url}}" class="box is-shadowless has-background-light h-100 is-block">
                  <p class="heading has-text-grey mb-1"><i class="ph ph-arrow-left"></i> Previous</p>
                  <p class="title is-6">{{title}}</p>
                </a>
              {{/prev_post}}
            </div>
            <div class="column is-half-tablet is-full-mobile has-text-right">
              {{#next_post filter="tag:documentation"}}
                <a href="{{url}}" class="box is-shadowless has-background-light h-100 is-block">
                  <p class="heading has-text-grey mb-1">Next <i class="ph ph-arrow-right"></i></p>
                  <p class="title is-6">{{title}}</p>
                </a>
              {{/next_post}}
            </div>
          </nav>

        </article>
      </main>

      {{!-- 3. RIGHT SIDEBAR (ToC & Ads) --}}
      <aside class="column is-2-desktop is-hidden-touch">
        <div style="position: sticky; top: 2rem;">
          <p class="is-size-7 is-uppercase has-text-weight-bold has-text-grey mb-3 tracking-wide">On this page</p>
          {{!-- Tocbot target --}}
          <div class="toc-container mb-5 is-size-7">
                  {{> "toc"}}

          </div> 

          <div class="box is-shadowless has-background-white-ter has-text-centered p-4 mt-6" style="border: 1px dashed #cbd5e1;">
            <p class="is-size-7 has-text-grey mb-2">Sponsor</p>
            <div style="height: 200px; background: #f1f5f9; border-radius: 6px;" class="is-flex is-align-items-center is-justify-content-center">
              <span class="icon is-large has-text-grey-light"><i class="ph ph-megaphone fa-2x"></i></span>
            </div>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>

{{!-- Dropdown & Active State JS --}}
{{#contentFor "scripts"}}
<script>
(function () {
  'use strict';
  // Highlight active link
  var currentId = document.getElementById('doc-current-id')?.getAttribute('data-id');
  if (currentId) {
    document.querySelectorAll('.doc-tl__link[data-doc-id]').forEach(function (a) {
      if (a.getAttribute('data-doc-id') === currentId) {
        a.classList.add('is-active', 'has-background-primary-light', 'has-text-primary', 'has-text-weight-bold');
        a.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  }

  // Mobile Dropdown logic
  var dropdown = document.getElementById('docMobDropdown');
  var trigger = dropdown?.querySelector('.dropdown-trigger button');
  if (!dropdown || !trigger) return;

  function setOpen(open) {
    dropdown.classList.toggle('is-active', open);
    var c = trigger.querySelector('.doc-mob-toggle__caret');
    if (c) c.style.transform = open ? 'rotate(180deg)' : '';
  }

  trigger.addEventListener('click', function(e) {
    e.stopPropagation();
    setOpen(!dropdown.classList.contains('is-active'));
  });
  document.addEventListener('click', function(e) {
    if (dropdown.classList.contains('is-active') && !dropdown.contains(e.target)) setOpen(false);
  });
})();
</script>
{{/contentFor}}