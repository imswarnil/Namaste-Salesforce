{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-documentation.hbs — Single documentation article
  ----------------------------------------------------------------------------
  Wide 3-column layout: sticky docs sidebar · article · right rail where the
  TOC, sponsor widget and ad pin one after another (sticky "deck": each stays
  fixed for a while, evenly spaced, then hands over to the next).
  Mobile gets the pinned docs menu bar. Context: {{#post}}.
═══════════════════════════════════════════════════════════════════════════ --}}
{{!-- Current post id + section — docs/sidebar highlights the active link and
     opens its section group --}}
<span id="doc-current-id" data-id="{{id}}" data-sec="{{primary_tag.slug}}" hidden aria-hidden="true"></span>

{{> "docs/mobile-bar" label=title}}

<section class="mx-auto max-w-[90rem] px-4 py-10 sm:px-6">
  <div class="grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)] xl:grid-cols-[17rem_minmax(0,1fr)_16rem]">

    {{> "docs/sidebar"}}

    <main role="main" class="min-w-0">
      <article>
        {{!-- Breadcrumb (compact, icon-based) --}}
        <nav class="mb-4 flex min-w-0 items-center gap-1.5 text-xs text-muted" aria-label="Breadcrumb">
          <a href="/" class="inline-flex shrink-0 items-center transition hover:text-brand-600" aria-label="{{t "Home"}}">{{> icons name="house"}}</a>
          {{> icons name="caret-right" class="shrink-0 text-[0.6rem]"}}
          <a href="/docs/" class="inline-flex shrink-0 items-center gap-1 transition hover:text-brand-600">{{> icons name="book-open"}}{{t "Docs"}}</a>
          {{#primary_tag}}
            {{> icons name="caret-right" class="shrink-0 text-[0.6rem]"}}
            <a href="/docs/{{slug}}/" class="truncate transition hover:text-brand-600">{{name}}</a>
          {{/primary_tag}}
          {{> icons name="caret-right" class="shrink-0 text-[0.6rem]"}}
          <span class="truncate text-ink">{{title}}</span>
        </nav>

        <header class="mb-6">
          <h1 class="font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{title}}</h1>
          {{#if custom_excerpt}}<p class="mt-3 text-lg text-muted">{{custom_excerpt}}</p>{{/if}}
          <div class="mt-4 flex flex-wrap items-center gap-4 font-mono text-xs text-label">
            <span class="inline-flex items-center gap-1">{{> icons name="timer"}}{{reading_time}}</span>
            {{#primary_author}}<span class="inline-flex items-center gap-1">{{> icons name="user-circle"}}{{name}}</span>{{/primary_author}}
            <span class="inline-flex items-center gap-1">{{> icons name="clock-clockwise"}}{{t "Updated"}} {{date updated_at format="D MMM YYYY"}}</span>
          </div>
        </header>

        {{#if feature_image}}
          {{> "components/img" src=feature_image alt=feature_image_alt eager=true
              class="mb-8 w-full rounded-card border border-border object-cover"
              sizes="(min-width: 64rem) 44rem, 100vw"}}
        {{/if}}

        <div class="prose max-w-none gh-content">{{content}}</div>

        {{!-- Pagination: prev/next inside the section; the edges switch section
             (first doc → section overview · last doc → next-section card) --}}
        <nav class="mt-10 grid gap-4 border-t border-border pt-6 sm:grid-cols-2" aria-label="{{t "Article navigation"}}">
          {{#prev_post in="primary_tag"}}
            <a href="{{url}}" class="group rounded-card border border-border p-4 ns-transition hover:border-brand-500">
              <span class="ns-label">{{> icons name="arrow-left" class="transition group-hover:-translate-x-0.5"}} {{t "Previous"}}</span>
              <span class="mt-1 block truncate font-semibold">{{title}}</span>
            </a>
          {{else}}
            {{#primary_tag}}
              <a href="/docs/{{slug}}/" class="group rounded-card border border-border p-4 ns-transition hover:border-brand-500">
                <span class="ns-label">{{> icons name="squares-four"}} {{t "Section overview"}}</span>
                <span class="mt-1 block truncate font-semibold">{{name}}</span>
              </a>
            {{/primary_tag}}
          {{/prev_post}}
          {{#next_post in="primary_tag"}}
            <a href="{{url}}" class="group rounded-card border border-border p-4 text-right ns-transition hover:border-brand-500 sm:col-start-2">
              <span class="ns-label">{{t "Next"}} {{> icons name="arrow-right" class="transition group-hover:translate-x-0.5"}}</span>
              <span class="mt-1 block truncate font-semibold">{{title}}</span>
            </a>
          {{/next_post}}
        </nav>

        {{!-- Last doc of the section → tee up the next section --}}
        {{#next_post in="primary_tag"}}{{else}}
          {{#primary_tag}}{{> "docs/next-section-for" current=slug}}{{/primary_tag}}
        {{/next_post}}

        {{!-- Comments (renders only when enabled in Ghost Admin → Membership) --}}
        <section class="mt-12 border-t border-border pt-8">
          {{comments}}
        </section>
      </article>
    </main>

    {{!-- Right rail: sticky handoff — each widget owns an equal flex-1 segment
         of the rail, pins (sticky) while its segment is in view, then scrolls
         away as the next segment's widget arrives and pins in its place. --}}
    <aside class="hidden xl:block">
      <div class="flex h-full flex-col gap-10">
        <div class="flex-1"><div class="sticky top-20">{{> "components/toc"}}</div></div>
        <div class="flex-1"><div class="sticky top-20">{{> "ads/slot" format="rail"}}</div></div>
        <div class="flex-1"><div class="sticky top-20 pb-10">{{> "ads/slot" format="square"}}</div></div>
      </div>
    </aside>
  </div>
</section>
