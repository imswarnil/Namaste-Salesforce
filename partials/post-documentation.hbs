{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-documentation.hbs — a single documentation article.

  Three columns, and they are the same three the whole site uses for reading:

    .ns-sidebar    the docs tree — how you LEAVE this page
    .ns-post__body the article at the measure
    .ns-post__aside the outline — how you move WITHIN it

  That leave/move-within split is the one every documentation site converged
  on, and it is why this is the system's `.ns-post` with a sidebar in front of
  it rather than a bespoke three-column grid: a doc page and a blog post are
  the same reading surface with a different left rail.

  The theme's version built that grid out of
  `lg:grid-cols-[17rem_minmax(0,1fr)] xl:grid-cols-[...]` and a hand-rolled
  "sticky handoff" rail. Both are gone — the component decides the columns and
  drops them in the right order on the way down.

  Context: {{#post}}, a #documentation post.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- The current article's id, read by docs/sidebar to mark aria-current
     and by rail.js to open the right group. --}}
<span id="doc-current-id" data-id="{{id}}" data-sec="{{primary_tag.slug}}" hidden aria-hidden="true"></span>

{{> "docs/mobile-bar" label=title}}

<div class="ns-docs">
  {{> "docs/sidebar"}}

  <div class="ns-post ns-post--docs">
    <article class="ns-post__body">

      <nav class="ns-breadcrumb" aria-label="Breadcrumb">
        <span class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="{{@site.url}}">{{t "Home"}}</a></span>
        <span class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="/docs/">{{t "Docs"}}</a></span>
        {{#primary_tag}}<span class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="/docs/{{slug}}/">{{name}}</a></span>{{/primary_tag}}
        <span class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="{{url}}" aria-current="page">{{title}}</a></span>
      </nav>

      <header>
        <h1 class="ns-posthead__title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="ns-posthead__standfirst">{{custom_excerpt}}</p>{{/if}}
        <p class="ns-postmeta ns-postmeta--dotted">
          <span>{{> icons name="timer"}}{{reading_time}}</span>
          {{#primary_author}}<span class="ns-postmeta__author">{{> icons name="user-circle"}}{{name}}</span>{{/primary_author}}
          <span>{{> icons name="clock-clockwise"}}{{t "Updated"}} {{date updated_at format="D MMM YYYY"}}</span>
        </p>
      </header>

      {{#if feature_image}}
        {{> "components/img" src=feature_image alt=feature_image_alt eager=true
            class="ns-posthead__cover" sizes="(min-width: 64rem) 44rem, 100vw"}}
      {{/if}}

      <div class="ns-prose gh-content">{{content}}</div>

      {{!-- Prev / next BY TITLE. The edges switch section: the first article
           points back at the section overview, the last tees up the next
           section entirely (docs/next-section-for). --}}
      <nav class="ns-postnav" aria-label="{{t "Article navigation"}}">
        {{#prev_post in="primary_tag"}}
          <a class="ns-postnav__link" href="{{url}}">
            <span class="ns-postnav__dir">{{t "Previous"}}</span>
            <span class="ns-postnav__title">{{title}}</span>
          </a>
        {{else}}
          {{#primary_tag}}
            <a class="ns-postnav__link" href="/docs/{{slug}}/">
              <span class="ns-postnav__dir">{{t "Section overview"}}</span>
              <span class="ns-postnav__title">{{name}}</span>
            </a>
          {{/primary_tag}}
        {{/prev_post}}

        {{#next_post in="primary_tag"}}
          <a class="ns-postnav__link ns-postnav__link--next" href="{{url}}">
            <span class="ns-postnav__dir">{{t "Next"}}</span>
            <span class="ns-postnav__title">{{title}}</span>
          </a>
        {{else}}
          <span class="ns-postnav__link ns-postnav__link--empty"></span>
        {{/next_post}}
      </nav>

      {{#next_post in="primary_tag"}}{{else}}
        {{#primary_tag}}{{> "docs/next-section-for" current=slug}}{{/primary_tag}}
      {{/next_post}}

      {{#if @site.comments_enabled}}{{comments}}{{/if}}
    </article>

    <aside class="ns-post__aside ns-post__aside--wide">
      {{> "components/toc"}}
      {{> "ads/slot" format="rail"}}
    </aside>
  </div>
</div>
