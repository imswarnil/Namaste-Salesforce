{{!-- duration — the post's time, from its #duration-* tag's DESCRIPTION.
     Never the slug: the author writes the display text in Ghost Admin, so
     adding #duration-90m needs no code change. --}}
{{~#foreach tags visibility="internal"~}}
    {{~#match slug "~^" "hash-duration-"~}}{{description}}{{~/match~}}
{{~/foreach~}}
