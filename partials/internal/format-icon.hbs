{{!-- format-icon — the glyph for a post's #format-* tag.

     ARTICLE IS THE DEFAULT, not an absent case. NSDS's rail rows all carry a
     type icon; emit nothing for reading and that row sits with a blank where
     every other row has a glyph, so the column stops lining up — which reads
     as a missing icon rather than a row without one.

     ⚠ Every glyph must be in the Phosphor subset — see internal/README. --}}
{{~#has tag="#format-video"~}}<i class="ph ph-video-camera ns-trainingnav__icon" aria-hidden="true"></i>
{{~else has tag="#format-exercise"~}}<i class="ph ph-flask ns-trainingnav__icon" aria-hidden="true"></i>
{{~else has tag="#format-quiz"~}}<i class="ph ph-exam ns-trainingnav__icon" aria-hidden="true"></i>
{{~else~}}<i class="ph ph-article ns-trainingnav__icon" aria-hidden="true"></i>
{{~/has~}}
