{{!-- =========================================================================
  partials/post-training-content.hbs
  3-col reader layout for individual #training-content posts.
  Called from post.hbs via:  {{#has tag="#training-content"}}

  LAYOUT:
    Left  is-3  — sticky sidebar: all modules in this training, active highlighted
    Main  is-7  — article content with prev/next navigation
    Right is-2  — TOC (desktop only)

  ACTIVE STATE:
    {{#match id ../../id}} — Ghost's ID comparison (render-time, no JS needed).

  PREV/NEXT:
    {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
    {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
    These are scoped to the same primary_tag group, so navigation stays
    within this training's modules.

  MOBILE:
    Sidebar hidden. Mobile bar at top with accordion toggle.
    JS toggles the panel; active item scrolls into view on load.
========================================================================== --}}

{{!-- ── Mobile sticky bar ──────────────────────────────────────────────────── --}}
<div class="tc-mobile-bar" id="tcMobileBar" aria-label="Module navigation">
  <span class="tc-mobile-bar__title">{{title}}</span>
  <button class="tc-mobile-bar__btn" type="button"
          id="tcMobileToggle"
          aria-expanded="false"
          aria-controls="tcMobilePanel">
    <i class="ph ph-list-bullets" aria-hidden="true"></i>
    <span>All modules</span>
    <i class="ph ph-caret-down" aria-hidden="true"></i>
  </button>
</div>

{{!-- ── Mobile panel ────────────────────────────────────────────────────────── --}}
<div class="tc-mobile-panel" id="tcMobilePanel" aria-hidden="true">
  <div class="tc-mobile-panel__inner">

    {{!-- Back to training overview --}}
    {{#get "posts"
      filter="tag:hash-training+slug:{{primary_tag.slug}}"
      limit="1"
    }}
      {{#foreach posts}}
        <a href="{{url}}" class="tc-sidebar__back">
          <i class="ph ph-arrow-left" aria-hidden="true"></i>
          Back to {{title}}
        </a>
      {{else}}
        <a href="/training/" class="tc-sidebar__back">
          <i class="ph ph-arrow-left" aria-hidden="true"></i>
          All training
        </a>
      {{/foreach}}
    {{/get}}

    <p class="menu-label tc-sidebar__label">Modules</p>

    <ul class="menu-list tc-sidebar__list">
      {{#get "posts"
        filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}"
        order="published_at asc"
        limit="100"
      }}
        {{#foreach posts}}
          <li>
            <a href="{{url}}"
               class="tc-sidebar__link{{#match id ../../id}} is-active{{/match}}">
              <span class="tc-sidebar__num">{{@number}}</span>
              <span class="tc-sidebar__link-text">{{title}}</span>
            </a>
          </li>
        {{/foreach}}
      {{/get}}
    </ul>

  </div>
</div>

{{!-- ── 3-col main layout ───────────────────────────────────────────────────── --}}
<div class="tc-wrapper">
  <div class="container is-fluid">
    <div class="columns is-variable is-5">

      {{!-- LEFT SIDEBAR (desktop/tablet) ───────────────────────────────────── --}}
      <aside class="column is-3-desktop is-4-tablet is-hidden-touch tc-sidebar-col">
        <div class="tc-sidebar-sticky">

          {{!-- Back to overview --}}
          {{#get "posts"
            filter="tag:hash-training+slug:{{primary_tag.slug}}"
            limit="1"
          }}
            {{#foreach posts}}
              <a href="{{url}}" class="tc-sidebar__back">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                Back to {{title}}
              </a>
            {{else}}
              <a href="/training/" class="tc-sidebar__back">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                All training
              </a>
            {{/foreach}}
          {{/get}}

          {{!-- Module list --}}
          <div class="tc-sidebar__scroll menu">
            <p class="menu-label tc-sidebar__label">
              {{#if primary_tag}}{{primary_tag.name}}{{else}}Modules{{/if}}
            </p>
            <ul class="menu-list tc-sidebar__list">
              {{#get "posts"
                filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}"
                order="published_at asc"
                limit="100"
              }}
                {{#foreach posts}}
                  <li>
                    <a href="{{url}}"
                       class="tc-sidebar__link{{#match id ../../id}} is-active{{/match}}">
                      <span class="tc-sidebar__num">{{@number}}</span>
                      <span class="tc-sidebar__link-text">{{title}}</span>
                    </a>
                  </li>
                {{/foreach}}
              {{/get}}
            </ul>
          </div>

        </div>
      </aside>

      {{!-- MAIN CONTENT ──────────────────────────────────────────────────────── --}}
      <main class="column is-12-mobile is-8-tablet is-7-desktop tc-main">
        <article class="box is-shadowless tc-document">
          <div class="content gh-content">

            {{!-- Header --}}
            <header class="tc-article-header">
              <div class="tags mb-4">
                <span class="tag is-primary is-light">Module</span>
                {{#if primary_tag}}
                  <span class="tag is-light">{{primary_tag.name}}</span>
                {{/if}}
                <span class="tag is-white has-text-grey">
                  <span class="icon is-small">
                    <i class="ph ph-clock" aria-hidden="true"></i>
                  </span>
                  <span>{{reading_time}}</span>
                </span>
              </div>

              <h1 class="title is-2 is-size-3-mobile mb-3">{{title}}</h1>

              {{#if custom_excerpt}}
                <p class="subtitle is-4 is-size-5-mobile has-text-grey mt-3">
                  {{custom_excerpt}}
                </p>
              {{/if}}

              {{#primary_author}}
                <div class="tc-article-author">
                  {{#if profile_image}}
                    <img src="{{img_url profile_image size="xxs"}}"
                         alt="{{name}}" loading="lazy"
                         class="tc-article-author__img">
                  {{/if}}
                  <span class="tc-article-author__name">{{name}}</span>
                  {{#if updated_at}}
                    <span class="tc-article-author__date">
                      · Updated {{date updated_at format="MMM D, YYYY"}}
                    </span>
                  {{/if}}
                </div>
              {{/primary_author}}
            </header>

            {{!-- Feature image --}}
            {{#if feature_image}}
              <figure class="image mb-6 tc-feature-image">
                <img src="{{img_url feature_image size="xl"}}"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                     loading="lazy">
              </figure>
            {{/if}}

            {{!-- Article body --}}
            <div class="tc-article-body js-toc-content">
              {{content}}
            </div>

            {{!-- Prev / Next navigation --}}
            <nav class="tc-nav-pager" aria-label="Module navigation">
              <div class="tc-nav-pager__prev">
                {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
                  <a href="{{url}}" class="tc-nav-pager__link">
                    <span class="tc-nav-pager__dir">
                      <i class="ph ph-arrow-left" aria-hidden="true"></i>
                      Previous
                    </span>
                    <span class="tc-nav-pager__title">{{title}}</span>
                  </a>
                {{/prev_post}}
              </div>

              <div class="tc-nav-pager__next">
                {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
                  <a href="{{url}}"
                     class="tc-nav-pager__link tc-nav-pager__link--right">
                    <span class="tc-nav-pager__dir">
                      Next
                      <i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </span>
                    <span class="tc-nav-pager__title">{{title}}</span>
                  </a>
                {{else}}
                  {{!-- Last module: back to training overview --}}
                  {{#get "posts"
                    filter="tag:hash-training+slug:{{primary_tag.slug}}"
                    limit="1"
                  }}
                    {{#foreach posts}}
                      <a href="{{url}}"
                         class="tc-nav-pager__link tc-nav-pager__link--right
                                tc-nav-pager__link--finish">
                        <span class="tc-nav-pager__dir">
                          <i class="ph ph-check-circle" aria-hidden="true"></i>
                          Finish training
                        </span>
                        <span class="tc-nav-pager__title">{{title}}</span>
                      </a>
                    {{else}}
                      <a href="/training/"
                         class="tc-nav-pager__link tc-nav-pager__link--right
                                tc-nav-pager__link--finish">
                        <span class="tc-nav-pager__dir">
                          <i class="ph ph-check-circle" aria-hidden="true"></i>
                          All done
                        </span>
                        <span class="tc-nav-pager__title">Back to training</span>
                      </a>
                    {{/foreach}}
                  {{/get}}
                {{/next_post}}
              </div>
            </nav>

          </div>
        </article>
      </main>

      {{!-- RIGHT SIDEBAR — TOC (desktop only) ────────────────────────────────── --}}
      <aside class="column is-2-desktop is-hidden-touch tc-toc-col">
        <div class="tc-toc-sticky">
          <div class="box is-shadowless tc-toc-box">
            <p class="heading has-text-weight-bold has-text-grey mb-3">
              On this page
            </p>
            <div class="tc-toc js-toc content is-small menu"></div>
          </div>
        </div>
      </aside>

    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var toggle = document.getElementById('tcMobileToggle');
  var panel  = document.getElementById('tcMobilePanel');
  if (!toggle || !panel) return;

  function setOpen(open) {
    panel.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
    var caret = toggle.querySelector('.ph-caret-down');
    if (caret) caret.style.transform = open ? 'rotate(180deg)' : '';
  }

  toggle.addEventListener('click', function () {
    setOpen(!panel.classList.contains('is-open'));
  });

  document.addEventListener('click', function (e) {
    if (panel.classList.contains('is-open') &&
        !panel.contains(e.target) &&
        !toggle.contains(e.target)) setOpen(false);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) {
      setOpen(false); toggle.focus();
    }
  });

  // Scroll active sidebar link into view
  var active = document.querySelector('.tc-sidebar__link.is-active');
  if (active) active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
})();
</script>
