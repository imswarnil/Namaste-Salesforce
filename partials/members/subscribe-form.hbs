{{!-- members/subscribe-form.hbs — the form itself.
     Split out of members/subscribe.hbs ONLY so the member / non-member branch
     there does not have to carry two copies of this markup. Never include this
     directly: subscribe.hbs is what decides whether asking is appropriate at
     all, and it owns the .ns-subscribe wrapper the state machine hangs off.

     The class names are the contract with 2-components/subscribe.css:
     `.ns-subscribe__form` is what Ghost stamps `loading` / `success` / `error`
     onto, and the two messages must remain its SIBLINGS — they are revealed
     with `~`, so nesting them inside the form would hide them permanently. --}}

<form data-members-form="subscribe"
      class="ns-subscribe__form{{#match layout "inline"}} ns-input-group{{/match}}{{#unless layout}} ns-input-group{{/unless}}">

  {{#match layout "stacked"}}
    <label class="ns-field">
      <span class="ns-field__label">{{#if label}}{{label}}{{else}}{{t "Email address"}}{{/if}}</span>
      <input data-members-email type="email" name="email" required autocomplete="email"
             placeholder="{{#if place}}{{place}}{{else}}you@example.com{{/if}}"
             class="ns-input">
    </label>
  {{else}}
    <input data-members-email type="email" name="email" required autocomplete="email"
           placeholder="{{#if place}}{{place}}{{else}}you@example.com{{/if}}"
           aria-label="{{t "Your email address"}}" class="ns-input">
  {{/match}}

  <button type="submit" class="ns-btn {{#match tone "dark"}}ns-btn--white{{else}}ns-btn--primary{{/match}}{{#match layout "stacked"}} ns-btn--block{{else}} shrink-0{{/match}}">
    <span class="ns-subscribe__spin">{{> icons name="circle-notch" class="animate-spin"}}</span>
    <span class="ns-subscribe__label">
      {{#if icon}}{{> icons name=icon}}{{/if}}{{#if cta}}{{cta}}{{else}}{{t "Subscribe"}}{{/if}}
    </span>
  </button>
</form>

<p class="ns-subscribe__msg ns-subscribe__msg--ok">
  {{> icons name="check-circle"}}
  <span>{{#if ok}}{{ok}}{{else}}{{t "Check your inbox — your magic link is on its way."}}{{/if}}</span>
</p>
<p class="ns-subscribe__msg ns-subscribe__msg--err">
  {{> icons name="warning"}}
  <span>{{#if err}}{{err}}{{else}}{{t "That didn't go through. Check the address and try again."}}{{/if}}</span>
</p>

{{#unless note}}
  <p class="ns-subscribe__note">{{t "Free. One click to unsubscribe."}}</p>
{{else}}
  {{#match note "false"}}{{else}}<p class="ns-subscribe__note">{{note}}</p>{{/match}}
{{/unless}}
