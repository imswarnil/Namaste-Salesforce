{{!-- ════════════════════════════════════════════════════════════════════════
     members/tiers.hbs — membership plans, PULLED FROM GHOST
     ------------------------------------------------------------------------
     Nothing here is authored. `{{#get "tiers"}}` returns the tiers configured
     in Ghost Admin → Settings → Tiers — real names, real descriptions, real
     benefit lists, and real prices in the real currency, formatted by Ghost's
     own {{price}} helper (which takes the integer minor units the API returns
     and renders them as money). That is the whole point: a price written into
     a template is a price that will one day disagree with the one that charges
     the card.

     Params
       eyebrow / title / body   the section framing. All optional.
       compact   truthy to drop the section framing and render only the grid,
                 for embedding inside a page that already has a heading.

     If members are switched off, or no paid tier exists yet, this renders
     nothing at all rather than an empty "Pricing" heading over blank space.
     ════════════════════════════════════════════════════════════════════════ --}}

{{#if @site.members_enabled}}
{{#get "tiers" include="monthly_price,yearly_price,benefits" limit="12"}}
  {{#if tiers}}
    <section class="ns-section">
      <div class="ns-container">

        {{#unless compact}}
          <div class="ns-band__head ns-band__head--center">
            <span class="ns-kicker">{{> icons name="credit-card"}}{{#if eyebrow}}{{eyebrow}}{{else}}{{t "Membership"}}{{/if}}</span>
            <h2 class="ns-band__title">{{#if title}}{{title}}{{else}}{{t "Learn free. Go further when you're ready."}}{{/if}}</h2>
            <p class="ns-band__lede">
              {{#if body}}{{body}}{{else}}{{t "The curriculum is free and open source. A membership funds it — and unlocks the parts that cost money to run."}}{{/if}}
            </p>
          </div>
        {{/unless}}

        <div class="ns-plans {{#unless compact}}mt-10{{/unless}}">
          {{#foreach tiers}}
            {{!-- PAID tiers carry the emphasis, the free tier does not. The
                  rule is derived from Ghost's own `type` rather than from a
                  "featured" param, because a param would have to be compared
                  across two block scopes ({{#get}} then {{#foreach}}) and a
                  `../../` path inside a partial is exactly the fragile thing
                  CLAUDE.md warns about. --}}
            <div class="ns-plan{{#match type "paid"}} ns-plan--featured{{/match}}">

              {{#match type "paid"}}
                <span class="ns-plan__flag ns-badge ns-badge--solid">{{t "Supports the site"}}</span>
              {{/match}}

              <h3 class="ns-plan__name">{{name}}</h3>
              {{#if description}}<p class="ns-plan__desc">{{description}}</p>{{/if}}

              <div class="ns-plan__price">
                {{#match type "free"}}
                  <span class="ns-plan__amount">{{t "Free"}}</span>
                  <span class="ns-plan__period">{{t "forever"}}</span>
                {{else}}
                  <span class="ns-plan__amount">{{price monthly_price currency=currency}}</span>
                  <span class="ns-plan__period">{{t "/ month"}}</span>
                {{/match}}
              </div>
              {{#match type "free"}}{{else}}
                {{#if yearly_price}}
                  <p class="ns-plan__yearly">{{t "or"}} {{price yearly_price currency=currency}} {{t "billed yearly"}}</p>
                {{/if}}
              {{/match}}

              {{#if benefits}}
                <ul class="ns-list ns-list--check ns-list--sm ns-plan__benefits">
                  {{#foreach benefits}}<li class="ns-list__item">{{.}}</li>{{/foreach}}
                </ul>
              {{/if}}

              <div class="ns-plan__cta">
                {{#if @member}}
                  <a href="#/portal/account/plans" data-portal="account/plans"
                     class="ns-btn ns-btn--block {{#match type "paid"}}ns-btn--primary{{else}}ns-btn--outline{{/match}}">
                    {{t "Change plan"}}
                  </a>
                {{else}}
                  <a href="#/portal/signup" data-portal="signup"
                     class="ns-btn ns-btn--block {{#match type "paid"}}ns-btn--primary{{else}}ns-btn--outline{{/match}}">
                    {{#match type "free"}}{{t "Create free account"}}{{else}}{{t "Choose"}} {{name}}{{/match}}
                  </a>
                {{/if}}
              </div>
            </div>
          {{/foreach}}
        </div>

        <p class="mt-6 text-center text-sm text-muted">
          {{t "Prices and plans come straight from Ghost — cancel or change yours any time from"}}
          <a href="#/portal/account" data-portal="account" class="font-semibold text-brand-600 hover:underline dark:text-brand-300">{{t "your account"}}</a>.
        </p>
      </div>
    </section>
  {{/if}}
{{/get}}
{{/if}}
