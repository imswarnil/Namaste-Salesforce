{{!-- ════════════════════════════════════════════════════════════════════════
  courses/lesson-row.hbs — ONE lesson, as the design system's `.ns-lesson`.

  THE POINT OF THIS PARTIAL: a lesson row looks the same everywhere. The
  course page's curriculum, the player's rail and the mobile drawer are one
  component wearing different containers, so a learner who has read the
  syllabus already knows how to read the rail. The theme used to draw three
  slightly different rows; this is the one.

  Params
    current  the id of the lesson being read, so the row can mark itself.
             Passed as `current=../../id` — a PROPERTY path, which is safe.
             (Calling a Ghost HELPER across `../` is what 500s a page.)
    first    true for the first row in a scroll region. The type tooltip opens
             upward, and on row one that is outside the box and clipped, so
             the first row's tooltip is forced --below.

  Context: a #lesson post inside {{#foreach}}.
═══════════════════════════════════════════════════════════════════════════ --}}
<a class="ns-lesson" href="{{url}}"
   {{#match id current}}aria-current="true"{{/match}}
   data-access="{{#has tag="#preview"}}free{{else}}{{#match visibility "public"}}free{{else match visibility "members"}}members{{else match visibility "paid"}}pro{{else}}tiers{{/match}}{{/has}}">

  <span class="ns-lesson__index" aria-hidden="true">{{@number}}</span>

  <span class="ns-lesson__title">{{title}}
    {{^has visibility="public"}}<span class="ns-visually-hidden"> ({{t "locked"}})</span>{{/has}}
  </span>

  <span class="ns-ltype ns-ltype--icon ns-tooltip-host {{#has tag="#lesson-type-video"}}ns-ltype--video{{else has tag="#lesson-type-quiz"}}ns-ltype--quiz{{else has tag="#lesson-type-lab"}}ns-ltype--lab{{else}}ns-ltype--article{{/has}}" tabindex="0">
    {{#has tag="#lesson-type-video"}}{{> icons name="video"}}<span class="ns-tooltip{{#if first}} ns-tooltip--below{{/if}}">{{t "Video"}}</span>
    {{else has tag="#lesson-type-quiz"}}{{> icons name="exam"}}<span class="ns-tooltip{{#if first}} ns-tooltip--below{{/if}}">{{t "Quiz"}}</span>
    {{else has tag="#lesson-type-lab"}}{{> icons name="flask"}}<span class="ns-tooltip{{#if first}} ns-tooltip--below{{/if}}">{{t "Lab"}}</span>
    {{else}}{{> icons name="article"}}<span class="ns-tooltip{{#if first}} ns-tooltip--below{{/if}}">{{t "Article"}}</span>{{/has}}
  </span>

  <span class="ns-lesson__time">
    {{#has visibility="public"}}
      {{#has tag="#lesson-type-video"}}{{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-video-duration-"}}{{description}}{{/match}}{{/foreach}}{{else}}{{reading_time minute="1 min" minutes="% min"}}{{/has}}
    {{else}}
      {{> icons name="lock"}}
    {{/has}}
  </span>
</a>
