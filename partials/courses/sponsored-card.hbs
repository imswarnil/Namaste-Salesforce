{{!-- courses/sponsored-card.hbs — a dummy sponsored course card, styled like a
     real course card but flagged "Sponsored" and linking out (e.g. Udemy).
     Marked data-sponsored so the catalog filter always keeps it visible. --}}
<article class="ns-ccard ns-ccard--sponsored js-spotlight group" data-sponsored="true">
  <span class="ns-ccard__ribbon ns-ccard__ribbon--sponsored"><i class="ph-fill ph-megaphone" aria-hidden="true"></i>{{t "Sponsored"}}</span>
  <a href="https://www.udemy.com/courses/development/?q=salesforce" target="_blank" rel="noopener sponsored" tabindex="-1" aria-hidden="true" class="ns-ccard__media">
    <span class="ns-ccard__sponsored-art"><i class="ph-fill ph-rocket-launch" aria-hidden="true"></i></span>
    <span class="ns-ccard__media-badges">
      <span class="ns-level ns-level--intermediate"><i class="ph-fill ph-gauge" aria-hidden="true"></i>{{t "All levels"}}</span>
      <span class="ns-price-tag ns-price-tag--paid"><i class="ph-fill ph-tag" aria-hidden="true"></i>{{t "Paid"}}</span>
    </span>
  </a>
  <div class="ns-ccard__body">
    <h2 class="font-heading text-lg font-bold leading-snug">
      <a href="https://www.udemy.com/courses/development/?q=salesforce" target="_blank" rel="noopener sponsored" class="transition-colors hover:text-brand-600 dark:hover:text-brand-300">{{t "Salesforce Certified — Full Bootcamp"}}</a>
    </h2>
    <p class="ns-ccard__excerpt mt-2 text-sm text-muted">{{t "A partner bootcamp on Udemy covering admin, development and certification prep. Sponsored placement."}}</p>
    <div class="ns-ccard__meta mt-4">
      <span><i class="ph ph-list-checks" aria-hidden="true"></i>320 {{t "lectures"}}</span>
      <span><i class="ph ph-clock" aria-hidden="true"></i>42h</span>
    </div>
    <div class="ns-ccard__foot">
      <span class="ns-ccard__author"><span class="ns-ccard__author-ph"><i class="ph-fill ph-buildings" aria-hidden="true"></i></span><span class="truncate">{{t "Udemy Partner"}}</span></span>
      <a href="https://www.udemy.com/courses/development/?q=salesforce" target="_blank" rel="noopener sponsored" class="ns-ccard__cta">{{t "Visit"}}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </div>
</article>
