{{!-- ════════════════════════════════════════════════════════════════════════
  courses/curriculum-list.hbs — the course's lessons, on the course page.

  The same `.ns-lesson` rows the player's rail and the mobile drawer render —
  courses/lesson-row is the single implementation. That is the whole idea of
  the system's LMS layer: a learner who has read the syllabus already knows
  how to read the rail.

  --flat because a Ghost course's lessons are flat under one primary tag.
  Sections belong to TRAINING, which has a real section model.

  Context: a #course post.
═══════════════════════════════════════════════════════════════════════════ --}}
<div class="ns-curriculum ns-curriculum--flat">
  {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" include="tags" order="published_at asc" limit="100" as |lessons|}}

    <div class="ns-curriculum__bar">
      <span class="ns-curriculum__totals">
        {{lessons.length}} {{t "lessons"}}
        {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}} · {{description}}{{/match}}{{/foreach}}
      </span>
    </div>

    {{#foreach lessons}}{{> "courses/lesson-row" first=@first}}{{else}}
      <p class="ns-empty">{{> icons name="wrench" class="ns-empty__icon"}}<span class="ns-empty__title">{{t "Lessons are being added."}}</span></p>
    {{/foreach}}
  {{/get}}
</div>
