{{!-- courses/curriculum-list.hbs — the course's lessons, pulled with {{#get}}
     (Handlebars, not JS). Each row shows a THUMBNAIL (lesson feature image →
     author avatar → type icon), the type (video/article), duration, and access
     state. Access is by Ghost VISIBILITY: public = free; members/paid = locked;
     a #preview lesson is always previewable. 3 styles via #curriculum-cards /
     #curriculum-timeline. Context: a #course post. --}}
<div class="ns-curriculum" data-style="{{#has tag="#curriculum-timeline"}}timeline{{else has tag="#curriculum-cards"}}cards{{else has tag="#curriculum-detailed"}}detailed{{else}}list{{/has}}">
  {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" include="tags,authors" order="published_at asc" limit="100" as |lessons|}}
    {{#foreach lessons}}
      <a href="{{url}}" class="ns-curriculum__item{{#has tag="#preview"}} is-preview{{else}}{{#match visibility "public"}}{{else}} is-locked{{/match}}{{/has}}">
        <span class="ns-curriculum__num">{{@number}}</span>

        {{!-- Thumbnail: lesson image → expert avatar → type icon --}}
        <span class="ns-curriculum__thumb">
          {{#if feature_image}}<img decoding="async" src="{{img_url feature_image size="xs"}}" alt="" loading="lazy">
          {{else}}{{#primary_author}}{{#if profile_image}}<img decoding="async" src="{{img_url profile_image size="xxs"}}" alt="{{name}}" loading="lazy">
          {{else}}{{#has tag="#lesson-type-video"}} {{> icons name="play-circle"}}{{else}} {{> icons name="file-text"}}{{/has}}{{/if}}
          {{else}}{{#has tag="#lesson-type-video"}} {{> icons name="play-circle"}}{{else}} {{> icons name="file-text"}}{{/has}}{{/primary_author}}{{/if}}
        </span>

        <span class="ns-curriculum__body">
          <span class="ns-curriculum__title">{{title}}</span>
          {{#if excerpt}}<span class="ns-curriculum__desc">{{excerpt words="16"}}</span>{{/if}}
          <span class="ns-curriculum__type">
            {{#has tag="#lesson-type-video"}}{{> icons name="video"}}{{t "Video"}}{{else}}{{> icons name="article"}}{{t "Article"}}{{/has}}
            {{#primary_author}} · {{name}}{{/primary_author}}
          </span>
        </span>

        <span class="ns-curriculum__meta">
          <span class="ns-curriculum__dur">
            {{#has tag="#lesson-type-video"}}{{> icons name="clock"}}{{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-video-duration-"}}{{description}}{{/match}}{{/foreach}}{{else}}{{> icons name="clock"}}{{reading_time minute="1 min" minutes="% min"}}{{/has}}
          </span>
          {{!-- Access badge — one per Ghost visibility, not a lock for everything:
               public=Free · members=Members · paid=Pro · tiers=Tier exclusive --}}
          {{#has tag="#preview"}}<span class="ns-curriculum__badge ns-curriculum__badge--preview">{{> icons name="eye"}}{{t "Preview"}}</span>
          {{else}}{{#match visibility "public"}}<span class="ns-curriculum__badge ns-curriculum__badge--free" title="{{t "Free — no account needed"}}">{{> icons name="lock-open"}}{{t "Free"}}</span>
          {{else match visibility "members"}}<span class="ns-curriculum__badge ns-curriculum__badge--members" title="{{t "Free with a member account"}}">{{> icons name="user-circle"}}{{t "Members"}}</span>
          {{else match visibility "paid"}}<span class="ns-curriculum__badge ns-curriculum__badge--paid" title="{{t "Requires a paid plan"}}">{{> icons name="crown"}}{{t "Pro"}}</span>
          {{else}}<span class="ns-curriculum__badge ns-curriculum__badge--tiers" title="{{t "Available on specific tiers"}}">{{> icons name="star"}}{{t "Tier"}}</span>{{/match}}{{/has}}
        </span>
      </a>
    {{else}}
      <p class="ns-curriculum__empty">{{> icons name="wrench"}} {{t "Lessons are being added."}}</p>
    {{/foreach}}
  {{/get}}
</div>
