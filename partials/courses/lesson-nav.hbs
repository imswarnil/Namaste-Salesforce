{{!-- ════════════════════════════════════════════════════════════════════════
  courses/lesson-nav.hbs — the curriculum rail beside a lesson.

  ONE list, two shapes. The container carries both `.ns-player__side` (the
  design system's rail — first grid column of `.ns-player`, collapsible via
  `data-rail`) and `.ns-lesson-panel` (the theme's sheet, which is what the
  rail becomes below lg and what the header's hamburger opens). Rendering the
  list twice — once for the rail and once for the drawer — is what the theme
  used to do, and the two copies disagreed about the active lesson.

  The rows are `.ns-lesson`, the same component the course page's curriculum
  and the mobile drawer render. That is the point of it: a learner who has
  read the syllabus already knows how to read this rail.

  Toggled by the Alpine store `lessonNav` (registered in
  components/course-player-header.hbs); dismissed by the ✕ in its bar, the
  scrim, or Escape.

  Context: a #lesson post.
═══════════════════════════════════════════════════════════════════════════ --}}
<div x-data class="js-lesson-nav">
  <nav id="lesson-list" class="ns-player__side ns-lesson-panel"
       :class="$store.lessonNav.open && 'is-open'" aria-label="{{t "Course lessons"}}">

    {{!-- The sheet's bar. Hidden while the rail is static (lg), shown when the
         same element is acting as a drawer or a quick-jump overlay. --}}
    <div class="ns-lesson-panel__bar">
      <span class="ns-player__side-head">{{> icons name="list-checks"}}{{t "Course lessons"}}</span>
      <button type="button" class="icon-btn" @click="$store.lessonNav.close()" aria-label="{{t "Close"}}">{{> icons name="x"}}</button>
    </div>

    {{!-- The way back out of this lesson and up to the course. It never
         scrolls away, which is why the breadcrumb in the article can. --}}
    {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}{{#foreach posts}}
      <a class="ns-player__side-back" href="{{url}}">{{> icons name="arrow-left"}}<span>{{title}}</span></a>
    {{/foreach}}{{/get}}

    <div class="ns-lesson-panel__body ns-player__list">
      {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" include="tags" order="published_at asc" limit="100"}}
        {{#foreach posts}}
          <a href="{{url}}" @click="$store.lessonNav.close()"
             class="ns-lesson{{#match id ../../id}} is-current{{/match}}"
             {{#match id ../../id}}aria-current="page"{{/match}}
             data-access="{{#has tag="#preview"}}free{{else}}{{#match visibility "public"}}free{{else match visibility "members"}}members{{else match visibility "paid"}}pro{{else}}tiers{{/match}}{{/has}}">
            <span class="ns-lesson__index" aria-hidden="true">{{@number}}</span>
            <span class="ns-lesson__body">
              <span class="ns-lesson__title">{{title}}</span>
            </span>
            <span class="ns-ltype ns-ltype--icon {{#has tag="#lesson-type-video"}}ns-ltype--video{{else}}ns-ltype--article{{/has}}">
              {{#has tag="#lesson-type-video"}}{{> icons name="video"}}<span>{{t "Video"}}</span>{{else}}{{> icons name="article"}}<span>{{t "Article"}}</span>{{/has}}
            </span>
          </a>
        {{/foreach}}
      {{/get}}
    </div>
  </nav>
</div>
