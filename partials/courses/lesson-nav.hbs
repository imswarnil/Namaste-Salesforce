{{!-- ════════════════════════════════════════════════════════════════════════
  courses/lesson-nav.hbs — the curriculum, in its three placements.

  ONE list of `.ns-lesson` rows, rendered into the design system's three
  containers. The theme used to draw its own drawer with an Alpine store and a
  hand-rolled `.ns-lesson-panel`; all of it is gone:

    .ns-player__side      the RAIL, lg and up. First grid column of .ns-player,
                          with the filter at its head — where you look before
                          you start scrolling, rather than after you give up.
    .ns-panelbar--fixed   BELOW lg, a fixed bar at the foot saying where you
                          are, with one control that opens…
    .ns-lessonmodal       …the drawer, which is a native `popover`. The
                          platform gives it the top layer, light dismiss and
                          Escape — so this needs NO JavaScript at all. That is
                          why the Alpine `lessonNav` store and the theme's
                          drawer CSS could both be deleted.

  A COURSE IS A FLAT LIST. No section headings: a course is one arc of eight
  to fourteen lessons, and a single "Section 1" wrapper is a disclosure control
  that discloses everything. Sections belong to TRAINING.

  THE KIND IS AN ICON, with the word arriving on hover or keyboard focus from
  `.ns-tooltip` — forty rows that each say VIDEO is forty repeats of what the
  glyph already said. The word stays in the DOM, so the accessible name is
  never dropped.

  `data-access` carries Ghost's VISIBILITY to the CSS so a locked row can dim
  without a second class. `aria-current="true"` marks the lesson being read.

  Context: a #lesson post.
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── The rail — lg and up ─────────────────────────────────────────────── --}}
<nav class="ns-player__side" id="player-rail" aria-label="{{t "Curriculum"}}">

  <div class="ns-player__side-search">
    <label class="ns-visually-hidden" for="lesson-search">{{t "Search lessons"}}</label>
    <span class="ns-input-wrap">
      {{> icons name="search" class="ns-input-wrap__icon"}}
      <input class="ns-input ns-input--has-icon" id="lesson-search" type="search"
             placeholder="{{t "Find a lesson"}}" autocomplete="off">
    </span>
  </div>

  {{!-- --timeline draws a hairline down the index column with each lesson
       number as a node on it: a course is a PATH, and a flat list of rows
       implies that without ever drawing it. --}}
  <div class="ns-player__list ns-player__list--timeline">
    {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" include="tags" order="published_at asc" limit="100"}}
      {{#foreach posts}}{{> "courses/lesson-row" current=../../id first=@first}}{{/foreach}}
    {{/get}}
  </div>

  {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}{{#foreach posts}}
    <a class="ns-player__side-brand" href="{{url}}">
      <span>{{t "A course by"}} <b>{{@site.title}}</b></span>
    </a>
  {{/foreach}}{{/get}}
</nav>

{{!-- ── Below lg: the bar that says where you are ────────────────────────── --}}
<div class="ns-panelbar ns-panelbar--fixed">
  <span class="ns-panelbar__now">
    {{#primary_tag}}<span class="ns-panelbar__kicker">{{name}}</span>{{/primary_tag}}
    <span class="ns-panelbar__title">{{title}}</span>
  </span>
  <button type="button" class="ns-btn ns-btn--outline ns-btn--sm" popovertarget="lesson-drawer">
    {{> icons name="list"}}{{t "Lessons"}}
  </button>
</div>

{{!-- ── …and the drawer it opens. A popover: no script, no store. ────────── --}}
<div class="ns-lessonmodal" id="lesson-drawer" popover>
  <div class="ns-lessonmodal__head">
    {{#primary_tag}}<span class="ns-lessonmodal__title">{{name}}</span>{{/primary_tag}}
    {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" limit="100" as |all|}}
      <span class="ns-lessonmodal__count">{{all.length}} {{t "lessons"}}</span>
    {{/get}}
    <button class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm" type="button"
            popovertarget="lesson-drawer" popovertargetaction="hide" aria-label="{{t "Close"}}">{{> icons name="x"}}</button>
  </div>

  {{!-- The panel is the ONLY lesson list below lg, so it carries the search
       too — a forty-lesson course does not get easier to scan because the
       viewport got smaller. --}}
  <div class="ns-player__side-search">
    <label class="ns-visually-hidden" for="panel-search">{{t "Search lessons"}}</label>
    <span class="ns-input-wrap">
      {{> icons name="search" class="ns-input-wrap__icon"}}
      <input class="ns-input ns-input--has-icon" id="panel-search" type="search"
             placeholder="{{t "Find a lesson"}}" autocomplete="off">
    </span>
  </div>

  <div class="ns-lessonmodal__list">
    {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" include="tags" order="published_at asc" limit="100"}}
      {{#foreach posts}}{{> "courses/lesson-row" current=../../id}}{{/foreach}}
    {{/get}}
  </div>
</div>
