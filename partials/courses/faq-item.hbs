{{!-- courses/faq-item.hbs — native <details> accordion. Params: q, a --}}
<details class="group rounded-card border border-border bg-surface-raised px-4 py-3">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
    {{q}}
    {{> icons name="caret-down" class="shrink-0 transition-transform group-open:rotate-180"}}
  </summary>
  <p class="mt-3 text-sm leading-relaxed text-muted">{{a}}</p>
</details>
