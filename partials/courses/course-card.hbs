{{!-- courses/course-card.hbs — one course in the catalog grid.

     Built on the design system's .ns-card + .ns-ccard (nsds/components/css/
     lms.css). .ns-ccard is a MODIFIER, not a component: the frame, body,
     title, link and text all come from .ns-card, and .ns-ccard adds only the
     parts a course has that nothing else does — the media wrapper, the corner
     level badge, the runtime chip, the promo flag and the mono meta row.
     That is why the class list is `ns-card ns-ccard` and not `ns-ccard` alone;
     drop `ns-card` and the card loses its frame entirely.

     Context: a #course post. The data-* attributes are the catalog filter's
     input — courses.hbs reads them in Alpine, so renaming one here breaks
     filtering there. --}}
<article class="ns-card ns-ccard js-spotlight"
         data-title="{{title}}"
         data-price="{{#has tag="#paid"}}paid{{else}}free{{/has}}"
         data-level="{{#has tag="#level-beginner"}}beginner{{else has tag="#level-intermediate"}}intermediate{{else has tag="#level-advanced"}}advanced{{else}}all{{/has}}"
         data-author="{{#primary_author}}{{slug}}{{/primary_author}}"
         data-duration="{{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}{{slug}}{{/match}}{{/foreach}}">

  {{#has tag="#hide-image"}}{{else}}{{#if feature_image}}
    <span class="ns-ccard__mediawrap">
      <a href="{{url}}" tabindex="-1" aria-hidden="true" class="ns-card__media">
        {{> "components/img" src=feature_image alt=""
            sizes="(min-width: 80rem) 22rem, (min-width: 40rem) 45vw, 92vw"}}
      </a>
      {{> "components/course-level" class="ns-ccard__level"}}
      {{#if featured}}<span class="ns-ccard__badge">{{t "Featured"}}</span>{{/if}}
      {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<span class="ns-ccard__dur">{{description}}</span>{{/match}}{{/foreach}}
    </span>
  {{/if}}{{/has}}

  <div class="ns-card__body">
    <span class="ns-card__kicker">// {{t "Course"}}</span>

    {{!-- With no media there is no corner to park the level badge in, so it
         rides above the title instead. Same badge, different anchor. --}}
    {{#has tag="#hide-image"}}
      <div class="ns-ccard__meta">{{> "components/course-level"}}</div>
    {{else}}{{#unless feature_image}}
      <div class="ns-ccard__meta">{{> "components/course-level"}}</div>
    {{/unless}}{{/has}}

    <a class="ns-card__link" href="{{url}}"><span class="ns-card__title">{{title}}</span></a>
    {{#if custom_excerpt}}<p class="ns-card__text">{{custom_excerpt}}</p>{{/if}}

    <span class="ns-ccard__meta">
      {{#get "posts" filter="tag:hash-lesson+primary_tag:{{slug}}" limit="100" as |ls|}}<span>{{> icons name="list-checks"}}{{ls.length}} {{t "lessons"}}</span>{{/get}}
      {{#has tag="#paid"}}<span>{{> icons name="crown"}}{{t "Members"}}</span>{{else}}<span>{{> icons name="gift"}}{{t "Free"}}</span>{{/has}}
      {{#primary_author}}<span>{{> icons name="user"}}{{name}}</span>{{/primary_author}}
    </span>
  </div>
</article>
