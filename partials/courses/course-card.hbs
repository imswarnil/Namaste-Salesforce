{{!-- courses/course-card.hbs — catalog card with embedded lesson syllabus.
     Context: a #course post (inside {{#foreach posts}}). Queries #lesson posts
     whose primary tag matches this course's slug. --}}
<article class="js-spotlight group relative flex h-full flex-col overflow-hidden rounded-card border border-border bg-surface-raised shadow-card transition hover:-translate-y-1 hover:shadow-raised">

  {{#if feature_image}}
    <a href="{{url}}" tabindex="-1" aria-hidden="true" class="block aspect-[16/9] overflow-hidden bg-surface-sunken">
      <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy"
           class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]">
    </a>
  {{/if}}

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-3 flex items-center justify-between gap-2">
      {{#if primary_tag}}
        <span class="inline-flex items-center rounded-pill bg-brand-500/10 px-2.5 py-0.5 text-xs font-semibold text-brand-600 dark:text-brand-300">{{primary_tag.name}}</span>
      {{/if}}
      <span class="inline-flex items-center gap-1 text-xs text-muted"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min" minutes="% mins"}}</span>
    </div>

    <h2 class="font-heading text-xl font-bold leading-snug">
      <a href="{{url}}" class="transition-colors hover:text-brand-600 dark:hover:text-brand-300">{{title}}</a>
    </h2>
    <p class="mt-2 text-sm text-muted">{{excerpt words="20"}}&hellip;</p>

    {{!-- Syllabus (lessons for this course) --}}
    <div class="mt-4 flex-1">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Syllabus"}}</p>
      {{#get "posts" filter="tag:hash-lesson+primary_tag:{{slug}}" order="published_at asc" limit="100"}}
        {{#if posts}}
          <ul class="space-y-0.5">
            {{#foreach posts}}
              <li>
                <a href="{{url}}" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-300">
                  <i class="ph-fill ph-play-circle shrink-0 text-brand-500" aria-hidden="true"></i>
                  <span class="line-clamp-1">{{@number}}. {{title}}</span>
                </a>
              </li>
            {{/foreach}}
          </ul>
        {{else}}
          <p class="rounded-md bg-surface-sunken px-3 py-2 text-sm text-muted"><i class="ph ph-wrench" aria-hidden="true"></i> {{t "Lessons are being added…"}}</p>
        {{/if}}
      {{/get}}
    </div>

    <a href="{{url}}" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-pill bg-brand-500 px-4 py-2.5 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">
      {{t "View course"}}<i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  </div>
</article>
