{{!-- courses/course-card.hbs — catalog course card (minimal).
     Context: a #course post. Carries data-* the catalog filter reads
     (title, price, level, author, duration tag). --}}
<article class="ns-ccard js-spotlight group{{#if featured}} is-featured{{/if}}"
         data-title="{{title}}"
         data-price="{{#has tag="#paid"}}paid{{else}}free{{/has}}"
         data-level="{{#has tag="#level-beginner"}}beginner{{else has tag="#level-intermediate"}}intermediate{{else has tag="#level-advanced"}}advanced{{else}}all{{/has}}"
         data-author="{{#primary_author}}{{slug}}{{/primary_author}}"
         data-duration="{{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}{{slug}}{{/match}}{{/foreach}}">

  {{#has tag="#hide-image"}}{{else}}{{#if feature_image}}
    <a href="{{url}}" tabindex="-1" aria-hidden="true" class="ns-ccard__media">
      <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" class="ns-zoom">
      <span class="ns-ccard__media-badges">{{> "components/course-level"}}</span>
      {{#has tag="#paid"}}<span class="ns-ccard__price ns-ccard__price--paid">{{t "Members"}}</span>{{else}}<span class="ns-ccard__price ns-ccard__price--free">{{t "Free"}}</span>{{/has}}
    </a>
  {{/if}}{{/has}}

  <div class="ns-ccard__body">
    {{#has tag="#hide-image"}}<div class="mb-2.5 flex items-center gap-2">{{> "components/course-level"}}{{#has tag="#paid"}}<span class="ns-ccard__price ns-ccard__price--paid ns-ccard__price--static">{{t "Members"}}</span>{{else}}<span class="ns-ccard__price ns-ccard__price--free ns-ccard__price--static">{{t "Free"}}</span>{{/has}}</div>
    {{else}}{{#unless feature_image}}<div class="mb-2.5 flex items-center gap-2">{{> "components/course-level"}}{{#has tag="#paid"}}<span class="ns-ccard__price ns-ccard__price--paid ns-ccard__price--static">{{t "Members"}}</span>{{else}}<span class="ns-ccard__price ns-ccard__price--free ns-ccard__price--static">{{t "Free"}}</span>{{/has}}</div>{{/unless}}{{/has}}

    <h2 class="font-heading text-[1.05rem] font-bold leading-snug">
      <a href="{{url}}" class="transition-colors hover:text-brand-600 dark:hover:text-brand-300">{{title}}</a>
    </h2>

    {{#if custom_excerpt}}<p class="ns-ccard__excerpt mt-1.5 text-sm text-muted">{{custom_excerpt}}</p>{{/if}}

    <div class="ns-ccard__meta mt-2.5">
      {{#get "posts" filter="tag:hash-lesson+primary_tag:{{slug}}" limit="100" as |ls|}}<span><i class="ph ph-list-checks" aria-hidden="true"></i>{{ls.length}} {{t "lessons"}}</span>{{/get}}
      {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<span><i class="ph ph-clock" aria-hidden="true"></i>{{description}}</span>{{/match}}{{/foreach}}
    </div>

    <div class="ns-ccard__foot">
      {{#primary_author}}<span class="ns-ccard__author">{{#if profile_image}}<img src="{{img_url profile_image size="xxs"}}" alt="{{name}}" class="h-5 w-5 rounded-full object-cover">{{else}}<span class="ns-ccard__author-ph h-5 w-5"><i class="ph-fill ph-user" aria-hidden="true"></i></span>{{/if}}<span class="truncate">{{name}}</span></span>{{/primary_author}}
      <a href="{{url}}" class="inline-flex shrink-0 items-center gap-1.5 rounded-pill bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold text-brand-600 transition hover:bg-brand-500 hover:text-white dark:text-brand-300 dark:hover:text-white" aria-label="{{t "Start"}} {{title}}">{{t "Start"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </div>
  </div>
</article>
