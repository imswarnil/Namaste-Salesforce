<article class="section">
    <div class="container is-max-desktop">
        <div class="content has-text-centered">

            {{#if primary_tag}}
                <div class="mb-4">
                    <a href="{{primary_tag.url}}" class="tag is-warning is-light">{{primary_tag.name}}</a>
                </div>
            {{/if}}

            <h1 class="title is-2">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="subtitle is-5">{{custom_excerpt}}</p>
            {{/if}}

            {{#if feature_image}}
                <figure class="image mb-6">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                </figure>
            {{/if}}
        </div>

        <div class="box">
            <div class="content gh-content">
                {{content}}
            </div>
        </div>
    </div>
</article>