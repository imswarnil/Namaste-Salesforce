{{!-- authorbox — NSDS's .ns-authorbox. Rendered only when there is a bio: a
     box containing a name and nothing else is worse than the byline already
     in the meta line. --}}
{{#primary_author}}
    {{#if bio}}
        <div class="ns-authorbox">
            {{#if profile_image}}
                <img class="ns-authorbox__avatar" src="{{img_url profile_image size="xs"}}"
                     alt="" width="64" height="64" loading="lazy" decoding="async">
            {{/if}}
            <div>
                <p class="ns-authorbox__name"><a href="{{url}}">{{name}}</a></p>
                {{#if location}}<p class="ns-authorbox__role">{{location}}</p>{{/if}}
                <p class="ns-authorbox__bio">{{bio}}</p>
                <div class="ns-authorbox__links">
                    <a class="ns-btn ns-btn--outline ns-btn--sm" href="{{url}}">{{t "All posts"}}</a>
                    {{#if website}}
                        <a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm" href="{{website}}"
                           target="_blank" rel="noopener" aria-label="{{t "Website"}}">
                            <i class="ph ph-link-simple" aria-hidden="true"></i>
                        </a>
                    {{/if}}
                </div>
            </div>
        </div>
    {{/if}}
{{/primary_author}}
