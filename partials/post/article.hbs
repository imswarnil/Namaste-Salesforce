{{!-- ══════════════════════════════════════════════════════════════════════
     post/article — the default reading surface.
     Ported from NS-Design-System/templates/blog-post.html.
     ------------------------------------------------------------------------
     Three things here are load-bearing and easy to remove by accident:

     · #post-body is on the PROSE div, not on <article>. It is what the
       reading-progress bar measures and what toc.js reads headings from.
       Move it up a level and both silently stop working.
     · data-toc-from lets toc.js build the outline from the article's own
       h2/h3 and add ids to any heading missing one. With JS off the rail is
       an empty labelled nav, which is why it carries a title.
     · .ns-prose is the 17px reading scale. Ghost's Koenig output has no
       classes of its own, so this one wrapper is what styles all of it.
     ══════════════════════════════════════════════════════════════════════ --}}
<span class="ns-lprogress ns-lprogress--article" data-target="#post-body"
      role="progressbar" aria-label="{{t "Reading progress"}}"
      aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></span>

<header class="ns-posthead ns-posthead--center">
    <div class="ns-posthead__inner">
        {{#primary_tag}}<a class="ns-tag ns-posthead__cat" href="{{url}}">{{name}}</a>{{/primary_tag}}
        <h1 class="ns-posthead__title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="ns-posthead__standfirst">{{custom_excerpt}}</p>{{/if}}

        <div class="ns-postmeta">
            {{#primary_author}}
                <span>
                    {{#if profile_image}}<img class="ns-postmeta__avatar" src="{{img_url profile_image size="xs"}}" alt="">{{/if}}
                    <a class="ns-postmeta__author" href="{{url}}">{{name}}</a>
                </span>
            {{/primary_author}}
            <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time></span>
            <span>{{reading_time}}</span>
        </div>

        {{#if feature_image}}
            <img class="ns-posthead__cover" src="{{img_url feature_image size="xl"}}"
                 srcset="{{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                 sizes="(min-width: 1200px) 1200px, 100vw"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}">
            {{#if feature_image_caption}}<span class="ns-posthead__credit">{{feature_image_caption}}</span>{{/if}}
        {{/if}}
    </div>
</header>

<div class="ns-post">
    <nav class="ns-post__rail ns-toc" aria-label="{{t "On this page"}}" data-toc-from="#post-body">
        <p class="ns-toc__title">{{t "On this page"}}</p>
    </nav>

    <article class="ns-post__body">
        <div class="ns-prose" id="post-body">{{content}}</div>
    </article>
</div>
