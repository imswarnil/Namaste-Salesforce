{{!-- post/article — everything inside .ns-post__body.

     Extracted so the layout branch in post/blog can include it from both arms
     without duplicating the markup.

     `id="post-body"` is load-bearing twice: the reading-progress line measures
     it, and the outline is built from the headings inside it. Pointing the TOC
     at the whole article instead would put "Read next" and three card titles
     in the outline. --}}

<div class="gh-content ns-prose" id="post-body">{{content}}</div>

<div class="sp-post-foot">

    {{#if tags}}
        <ul class="ns-taglist">
            {{#foreach tags}}<li><a class="ns-tag ns-tag--pill" href="{{url}}">{{name}}</a></li>{{/foreach}}
        </ul>
    {{/if}}

    {{> "post/authorbox"}}
    {{> "post/nav"}}

    {{!-- Related by the post's own primary tag, excluding itself.

         ⚠ THE FILTER CANNOT CONTAIN `../`. Ghost raises
         `IncorrectUsageError: unsupported path segment ""` — filter strings
         go through Ghost's own path resolver, which does dotted access but
         not parent traversal. So the {{#get}} stays at the POST's context,
         where {{id}} is the post and the tag is `{{primary_tag.slug}}`. --}}
    {{#if primary_tag}}
        {{#get "posts" filter="tags:{{primary_tag.slug}}+id:-{{id}}" limit="3" include="tags,authors" as |related|}}
            {{#if related}}
                <section class="ns-band ns-band--tight">
                    <div class="ns-band__head"><h2 class="ns-band__title">{{t "Read next"}}</h2></div>
                    <div class="ns-blog-grid">
                        {{#foreach related}}{{> "cards/bcard" minimal=true}}{{/foreach}}
                    </div>
                </section>
            {{/if}}
        {{/get}}
    {{/if}}

</div>
