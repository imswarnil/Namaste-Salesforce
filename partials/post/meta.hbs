{{!-- ══════════════════════════════════════════════════════════════════════
     postmeta — NSDS's .ns-postmeta.
     ------------------------------------------------------------------------
     PARAMETERS
       compact   truthy → date and duration only, no author. Cards use this;
                 a byline under every card in a single-author publication is
                 the same name eight times.

     THE DURATION FALLBACK. A post's time should come from its `#duration-*`
     tag when the author set one, and from Ghost's computed {{reading_time}}
     otherwise — word count is right for an article and meaningless for a
     video, which is why the tag exists.

     Handlebars has no variables and no way to ask "did that partial output
     anything", so `{{#if duration}}…{{else}}…{{/if}}` cannot be written: the
     test would have to run the same {{#foreach}} that produces the value.
     So the fallback is CSS — the span renders the tag's text and carries the
     computed time in a data attribute, and one rule in ghost/content.css
     shows the attribute only when the span came out empty.

     `:empty` is exact: no child nodes, not even whitespace. That is why
     internal/duration.hbs uses `{{~ ~}}` throughout.
     ══════════════════════════════════════════════════════════════════════ --}}
<div class="ns-postmeta">

    {{#unless compact}}
        {{#primary_author}}
            <span>
                {{#if profile_image}}
                    <img class="ns-postmeta__avatar" src="{{img_url profile_image size="xxs"}}"
                         alt="" width="24" height="24" loading="lazy" decoding="async">
                {{/if}}
                <a class="ns-postmeta__author" href="{{url}}">{{name}}</a>
            </span>
        {{/primary_author}}
    {{/unless}}

    <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></span>

    <span class="sp-duration"
          data-fallback="{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}">{{~> "internal/duration"~}}</span>

    {{!-- `unless access` is true when THIS READER cannot open the post, which
          is not the same as the post being paid — a paying member must not be
          shown a padlock on something they can read. --}}
    {{#unless access}}
        <span class="ns-laccess">
            {{> "icons/post/lock"}}
            {{#has visibility="paid"}}{{t "Paid"}}{{else}}{{t "Members"}}{{/has}}
        </span>
    {{/unless}}

</div>
