{{!-- post/toc-aside — the sticky rail that holds the table of contents.

     Rendered only from a branch in post/body that has ALREADY decided a TOC
     is wanted, so unlike post/toc this one is unconditional. Splitting the
     decision from the markup is what lets .ns-post pick its column count
     before it knows what is going in them. --}}
<aside class="ns-post__aside">
    <nav class="ns-toc ns-toc--card" data-toc-from=".gh-content" aria-label="{{t "On this page"}}">
        <p class="ns-toc__title">{{t "On this page"}}</p>
    </nav>
</aside>
