{{!-- ══════════════════════════════════════════════════════════════════════
     related — "Read next", from the post's own primary tag.
     ------------------------------------------------------------------------
     ⚠ THE FILTER CANNOT USE `../`. Ghost throws
         IncorrectUsageError: {{#get}} helper — unsupported path segment ""
     on `filter="…id:-{{../id}}"`. Filter strings are resolved by Ghost's own
     path resolver, which handles dotted access but not parent traversal.

     So the {{#get}} stays at the POST's own context — where `{{id}}` is the
     post and the tag is reachable by dotted access as `{{primary_tag.slug}}`
     — rather than being nested inside `{{#primary_tag}}` where the id would
     need a `../` to reach.

     Excluding the post itself is not optional; without it the first "read
     next" card is the page you are already on.
     ══════════════════════════════════════════════════════════════════════ --}}
{{#if primary_tag}}
    {{#get "posts" filter="tags:{{primary_tag.slug}}+id:-{{id}}" limit="3" include="tags,authors" as |related|}}
        {{#if related}}
            <section class="ns-band ns-band--tight">
                <div class="ns-band__head">
                    <h2 class="ns-band__title">{{t "Read next"}}</h2>
                </div>
                <div class="ns-blog-grid">
                    {{#foreach related}}{{> "cards/blog-card" minimal=true}}{{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
