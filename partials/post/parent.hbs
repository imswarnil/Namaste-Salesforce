{{!-- ══════════════════════════════════════════════════════════════════════
     post/parent — a course, a training section or a docs section.
     ------------------------------------------------------------------------
     One partial, because all three are the same SHAPE: an overview whose main
     content is the list of its children. What differs is how a child is
     drawn, and that is a parameter:

       childKind="lesson"  → .ns-lesson rows in a .ns-curriculum   (courses)
       childKind="unit"    → .ns-unit rows in .ns-units            (training, docs)

     That is not decoration. A course lesson row carries an index and an
     access state because a course is something you buy into partway; a
     training unit carries a type and a time because training is free and
     sequential. NSDS ships both components for that reason.

     PARAMETERS
       kind       the kicker — "Course", "Section"
       childWord / childWordPlural   for the count
       childKind  "lesson" or "unit"

     ── The slug==tag rule is what makes this work ─────────────────────────
     A parent's slug equals its own tag's slug, and every child carries that
     tag as its PRIMARY tag. So the parent finds its children by filtering on
     its own slug, and the children nest under it in the URL — one fact doing
     both jobs. `+id:-{{id}}` is not optional: the parent carries its own tag
     too, so without it every course lists itself as its first lesson.

     ⚠ TWO {{#get}} RULES, both learned the hard way:
       · ALWAYS `as |…|`. Without it the helper takes over the block context
         and the surrounding markup stops seeing the post — output vanishes
         rather than erroring.
       · Inside the block, the partial's own parameters need `../`, because
         the context IS switched even with `as`. Property access across `../`
         is fine; calling a HELPER across it is not, and does nothing.
     ══════════════════════════════════════════════════════════════════════ --}}
<article class="{{post_class}}">

    <section class="ns-chero{{#if feature_image}} ns-chero--split{{/if}}">
        <div class="ns-chero__inner">
            <div class="ns-chero__grid">

                <div class="ns-chero__body">
                    <p class="ns-chero__kicker">{{#if kind}}{{kind}}{{else}}{{t "Overview"}}{{/if}}</p>
                    <h1 class="ns-chero__title">{{title}}</h1>
                    {{#if custom_excerpt}}<p class="ns-chero__lede">{{custom_excerpt}}</p>{{/if}}

                    <div class="ns-chero__meta">
                        <span class="ns-tag sp-optional">{{~> "internal/level"~}}</span>
                        <span class="sp-duration sp-optional">{{~> "internal/duration"~}}</span>
                    </div>

                    {{#if @site.members_enabled}}
                        <div class="ns-chero__actions">{{> "chrome/members"}}</div>
                    {{/if}}
                </div>

                {{#if feature_image}}
                    <div class="ns-chero__media">
                        {{> "media" src=feature_image eager=true
                                    sizes="(min-width: 64rem) 34rem, 100vw"
                                    alt=(concat "" feature_image_alt)}}
                    </div>
                {{/if}}

            </div>
        </div>
    </section>

    {{!-- The overview's own body. Wide, because a course page's prose is a
          pitch rather than an article and does not want the reading rail. --}}
    <div class="ns-post ns-post--wide">
        <article class="ns-post__body">
            <div class="gh-content ns-prose" id="post-body">{{content}}</div>
        </article>
    </div>

    {{!-- ⚠ limit="all" IS NOT SUPPORTED — Ghost returns 15 and says nothing. --}}
    {{#get "posts" filter="tags:{{slug}}+id:-{{id}}" limit="100" order="published_at asc" include="tags" as |children|}}
        <section class="ns-band ns-band--sunken">
            <div class="ns-band__inner">

                <div class="ns-band__head ns-band__head--between">
                    <h2 class="ns-band__title">{{t "Curriculum"}}</h2>
                    {{#match children.length ">" 0}}
                        <p class="ns-band__lede">
                            {{children.length}}
                            {{#match children.length "=" 1}}{{../../childWord}}{{else}}{{../../childWordPlural}}{{/match}}
                        </p>
                    {{/match}}
                </div>

                {{#if children}}
                    {{#match ../childKind "lesson"}}
                        <div class="ns-curriculum">
                            {{#foreach children}}{{> "cards/lesson-row" index=@number}}{{/foreach}}
                        </div>
                    {{else}}
                        <div class="ns-units">
                            {{#foreach children}}{{> "cards/unit" currentSlug=""}}{{/foreach}}
                        </div>
                    {{/match}}
                {{else}}
                    {{!-- A parent with nothing under it yet. A page that is
                          simply blank below the fold reads as broken; saying
                          so reads as new. --}}
                    <p class="ns-empty">{{t "Nothing published here yet."}}</p>
                {{/if}}

            </div>
        </section>
    {{/get}}

</article>
