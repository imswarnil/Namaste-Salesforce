{{!-- ══════════════════════════════════════════════════════════════════════
     post/training-post — a post inside a training or docs section, on NSDS's
     training-post.html.
     ------------------------------------------------------------------------
     Same shell as post/section — the rail is what makes both of them a
     training surface rather than an article — with the reading column
     carrying the post instead of a list.

         .ns-training__main
             .ns-tbar                breadcrumb · prev/next
             .ns-modulehead          title, lede, .ns-tmeta
             .ns-tpost-body > .ns-tstage
                 .ns-toc             the outline
                 .ns-prose#post-body

     ⚠ THE {{#get}} WRAPS ONLY THE RAIL. It takes over the block context even
     with `as |…|`, so wrapping the whole template means the body has to be
     written `{{../content}}` — and `content` is a HELPER. Calling a Ghost
     helper across `../` is forbidden outright (CLAUDE.md) and renders
     NOTHING: the page came out with a title, a lede, three empty meta pills
     and no article. The meta pills were the same bug — internal/duration
     reads the post's tags, and inside the get block there were none.
     ══════════════════════════════════════════════════════════════════════ --}}
<div class="ns-training ns-training--doc {{post_class}}" data-ns-training data-rail="closed">

    <div class="ns-training__scrim" data-ns-training-close></div>

    {{!-- Excludes the section's own overview post, which carries the same
         tag — otherwise the section lists itself as its own first post. --}}
    {{#get "posts" filter="tags:{{primary_tag.slug}}+tag:-hash-training-module+tag:-hash-docs-section" limit="100" order="published_at asc" include="tags" as |siblings|}}
        <nav class="ns-trainingnav" data-ns-trainingnav aria-label="{{t "Curriculum"}}">

            <div class="ns-trainingnav__spine">
                <span class="ns-trainingnav__spine-label">{{t "Curriculum"}}</span>
            </div>

            <div class="ns-trainingnav__head">
                <a class="ns-trainingnav__brand" href="{{../primary_tag.url}}">
                    <i class="ph ph-graduation-cap" aria-hidden="true"></i> {{../primary_tag.name}}
                </a>
            </div>

            <div class="ns-trainingnav__scroll">
                <ul class="ns-trainingnav__list">
                    {{#foreach siblings}}
                        <li>
                            <a class="ns-trainingnav__link" href="{{url}}"{{#match slug ../../slug}} aria-current="page"{{/match}}>
                                {{> "internal/format-icon"}}
                                <span>{{title}}</span>
                                <span class="ns-trainingnav__time sp-duration sp-optional">{{~> "internal/duration"~}}</span>
                            </a>
                        </li>
                    {{/foreach}}
                </ul>
            </div>

        </nav>
    {{/get}}

    <div class="ns-training__main">

        <div class="ns-tbar">
            <p class="ns-tbar__crumb">
                <a href="{{@site.url}}">{{t "Home"}}</a>
                {{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}
            </p>
            <span class="ns-tbar__steps">
                {{#prev_post}}<a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm" href="{{url}}"
                   aria-label="{{t "Previous"}}: {{title}}"><i class="ph ph-caret-left" aria-hidden="true"></i></a>{{/prev_post}}
                {{#next_post}}<a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm" href="{{url}}"
                   aria-label="{{t "Next"}}: {{title}}"><i class="ph ph-caret-right" aria-hidden="true"></i></a>{{/next_post}}
            </span>
        </div>

        <div class="ns-training__reading">

            <header class="ns-modulehead">
                <h1 class="ns-modulehead__title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ns-modulehead__lede">{{custom_excerpt}}</p>{{/if}}

                {{!-- Each pill hides itself when its tag is absent — see the
                     .sp-optional:empty rule. Without it a post with no level
                     tag renders an empty pill with padding. --}}
                <div class="ns-tmeta">
                    <span class="ns-tmeta__item sp-optional">{{~> "internal/duration"~}}</span>
                    <span class="ns-tmeta__item sp-optional">{{~> "internal/level"~}}</span>
                    <span class="ns-tmeta__item sp-optional">{{~> "internal/format"~}}</span>
                </div>
            </header>

            <div class="ns-tpost-body">
                <div class="ns-tstage">

                    <nav class="ns-toc" data-toc-from="#post-body" aria-label="{{t "On this page"}}">
                        <p class="ns-toc__title">{{t "On this page"}}</p>
                    </nav>

                    <div class="gh-content ns-prose" id="post-body">{{content}}</div>

                    {{> "post/authorbox"}}
                    {{> "post/nav"}}

                </div>
            </div>

        </div>

    </div>

</div>
