{{!-- ══════════════════════════════════════════════════════════════════════
     post/blog — NSDS's blog-post.html, bound to Ghost. Also the fallback for
     an untyped post, because an untyped post is still a post and giving it a
     lesser layout is how a page ends up looking broken rather than plain.
     ------------------------------------------------------------------------
         .ns-lprogress--article      the reading line, pinned
         .ns-posthead                title, standfirst, meta, cover
         .ns-post                    a THREE-COLUMN grid:
             .ns-post__rail.ns-toc       14rem  — the outline
             .ns-post__body              prose  — article, author, pager
             .ns-post__aside.ns-share    3.5rem — the share rail

     ⚠ THE COLUMN COUNT IS THE LAYOUT. `.ns-post` is `14rem | measure |
     3.5rem` and grid places children in source order — so a `.ns-post` with
     one child puts the article in the 14rem column, and the page looks broken
     two elements away from the cause. With the outline off the whole thing
     takes `--wide`, the single-column variant, which is why the branch is out
     here rather than inside a TOC partial.

     The rail is `.ns-post__rail.ns-toc`, NOT `.ns-post__aside` — the aside is
     the SHARE column. Swapping them puts the outline in a 3.5rem strip.
     ══════════════════════════════════════════════════════════════════════ --}}

{{!-- lms.js drives this from the element named in data-target. Decoration:
     with JS off the bar stays at zero width. --}}
<span class="ns-lprogress ns-lprogress--article" data-target="#post-body"
      role="progressbar" aria-label="{{t "Reading progress"}}"
      aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></span>

{{> "post/head"}}

{{#has tag="#no-toc"}}
    <div class="ns-post ns-post--wide">
        <article class="ns-post__body">{{> "post/article"}}</article>
    </div>
{{else}}
    <div class="ns-post">
        <nav class="ns-post__rail ns-toc" data-toc-from="#post-body" aria-label="{{t "On this page"}}">
            <p class="ns-toc__title">{{t "On this page"}}</p>
        </nav>
        <article class="ns-post__body">{{> "post/article"}}</article>
        {{> "post/share"}}
    </div>
{{/has}}
