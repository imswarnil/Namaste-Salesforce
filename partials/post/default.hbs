{{!-- ══════════════════════════════════════════════════════════════════════
     post/default — a blog post, and the fallback for an untyped one.
     ------------------------------------------------------------------------
     NS-Design-System's blog-post archetype, in order:

         .ns-lprogress--article      the reading line, pinned to the top
         .ns-posthead                title, standfirst, meta, cover
         .ns-post                    a THREE-COLUMN grid:
             .ns-post__rail.ns-toc       14rem  — the outline
             .ns-post__body              prose  — article, author, pager
             .ns-post__aside.ns-share    3.5rem — the share rail

     ⚠ THE COLUMN COUNT IS THE LAYOUT. `.ns-post` is `14rem | measure |
     3.5rem`, and grid places children in source order — so a `.ns-post` with
     one child puts the article in the 14rem column and the page looks
     broken two elements away from the cause. When the outline is switched
     off the whole thing takes `--wide`, which is the single-column variant.
     That is why the branch is out here rather than inside the TOC partial.

     The rail is `.ns-post__rail.ns-toc`, NOT an `.ns-post__aside` — the aside
     is the share column. Getting those two the wrong way round puts the
     outline in a 3.5rem strip.
     ══════════════════════════════════════════════════════════════════════ --}}

{{!-- assets/js/lms.js drives this from the element named in data-target. It
      is decoration: with JS off the bar simply stays at zero width. --}}
<span class="ns-lprogress ns-lprogress--article" data-target="#post-body"
      role="progressbar" aria-label="{{t "Reading progress"}}"
      aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></span>

{{> "post/head"}}

{{#has tag="#no-toc, #no-sidebar"}}
    <div class="ns-post ns-post--wide">
        <article class="ns-post__body">{{> "post/article"}}</article>
    </div>
{{else has tag="#toc"}}
    <div class="ns-post">
        <nav class="ns-post__rail ns-toc" data-toc-from="#post-body" aria-label="{{t "On this page"}}">
            <p class="ns-toc__title">{{t "On this page"}}</p>
        </nav>
        <article class="ns-post__body">{{> "post/article"}}</article>
        {{> "post/share"}}
    </div>
{{else}}
    {{#if @custom.show_toc}}
        <div class="ns-post">
            <nav class="ns-post__rail ns-toc" data-toc-from="#post-body" aria-label="{{t "On this page"}}">
                <p class="ns-toc__title">{{t "On this page"}}</p>
            </nav>
            <article class="ns-post__body">{{> "post/article"}}</article>
            {{> "post/share"}}
        </div>
    {{else}}
        <div class="ns-post ns-post--wide">
            <article class="ns-post__body">{{> "post/article"}}</article>
        </div>
    {{/if}}
{{/has}}
