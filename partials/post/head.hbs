{{!-- post/head — NSDS's .ns-posthead, exactly.

     Art direction comes from an internal tag and is resolved by
     internal/hero-variant — one place, because the answer is needed by the
     header element and by the cover slot.

     The cover passes `eager`: it is the largest thing above the fold, and
     `loading="lazy"` on an already-visible image DELAYS it — the browser has
     to lay the page out before it knows the image is in view. That is a
     direct hit to Largest Contentful Paint. --}}
<header class="ns-posthead {{> "internal/hero-variant"}}">
    <div class="ns-posthead__inner">

        {{#primary_tag}}<a class="ns-tag ns-posthead__cat" href="{{url}}">{{name}}</a>{{/primary_tag}}

        <h1 class="ns-posthead__title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="ns-posthead__standfirst">{{custom_excerpt}}</p>
        {{/if}}

        {{#if @custom.show_post_meta}}{{> "post/meta"}}{{/if}}

        {{#if feature_image}}
            <span class="ns-posthead__cover">
                {{> "media" src=feature_image eager=true
                            sizes="(min-width: 88rem) 1408px, 100vw"
                            alt=(concat "" feature_image_alt)}}
            </span>
            {{#if feature_image_caption}}
                <span class="ns-posthead__credit">{{feature_image_caption}}</span>
            {{/if}}
        {{/if}}

    </div>
</header>
