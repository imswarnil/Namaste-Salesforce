{{!-- post/head — NSDS's .ns-posthead, from templates/blog-post.html.

     Art direction comes from an internal tag, resolved by
     internal/hero-variant — one place, because the answer is needed by both
     the header element and the cover slot.

     The cover passes `eager`: it is the largest thing above the fold, and
     `loading="lazy"` on an already-visible image DELAYS it. See media.hbs. --}}
<header class="ns-posthead {{> "internal/hero-variant"}}">
    <div class="ns-posthead__inner">

        {{#primary_tag}}<a class="ns-tag ns-posthead__cat" href="{{url}}">{{name}}</a>{{/primary_tag}}

        <h1 class="ns-posthead__title">{{title}}</h1>

        {{#if custom_excerpt}}<p class="ns-posthead__standfirst">{{custom_excerpt}}</p>{{/if}}

        {{> "post/meta"}}

        {{#if feature_image}}
            <span class="ns-posthead__cover">
                {{> "media" src=feature_image eager=true
                            sizes="(min-width: 88rem) 1408px, 100vw"
                            alt=(concat "" feature_image_alt)}}
            </span>
            {{#if feature_image_caption}}
                <span class="ns-posthead__credit">{{feature_image_caption}}</span>
            {{/if}}
        {{/if}}

    </div>
</header>
