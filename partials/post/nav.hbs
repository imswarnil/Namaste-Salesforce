{{!-- ══════════════════════════════════════════════════════════════════════
     post/nav — previous and next, on NSDS's .ns-postnav.
     ------------------------------------------------------------------------
     Ghost scopes {{#prev_post}} / {{#next_post}} to the post's own COLLECTION,
     which is what makes this correct inside a course: the next lesson is the
     next post in /lessons/, not the next thing published on the site.

     Each side renders only if it exists. A post at either end of a collection
     gets one link, not an empty box with a dangling arrow — and the whole nav
     is skipped when there is neither.
     ══════════════════════════════════════════════════════════════════════ --}}
<nav class="ns-postnav" aria-label="{{t "More posts"}}">
    {{#prev_post}}
        <a class="ns-postnav__link" href="{{url}}">
            <span class="ns-postnav__dir">{{> "icons/post/prev"}} {{t "Previous"}}</span>
            <span class="ns-postnav__title">{{title}}</span>
        </a>
    {{/prev_post}}
    {{#next_post}}
        <a class="ns-postnav__link ns-postnav__link--next" href="{{url}}">
            <span class="ns-postnav__dir">{{t "Next"}} {{> "icons/post/next"}}</span>
            <span class="ns-postnav__title">{{title}}</span>
        </a>
    {{/next_post}}
</nav>
