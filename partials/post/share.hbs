{{!-- share — NSDS's .ns-share--rail, the third column of .ns-post.

     Real links, not scripted buttons: a share intent URL works with JS off,
     opens in the reader's own signed-in session, and cannot leak anything the
     page does not already show. --}}
<aside class="ns-post__aside ns-share ns-share--rail">
    <span class="ns-share__label">{{t "Share"}}</span>
    <a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm"
       href="https://www.linkedin.com/sharing/share-offsite/?url={{encode url absolute="true"}}"
       target="_blank" rel="noopener" aria-label="{{t "Share on LinkedIn"}}">
        <i class="ph ph-linkedin-logo" aria-hidden="true"></i>
    </a>
    <a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm"
       href="https://x.com/intent/post?url={{encode url absolute="true"}}&text={{encode title}}"
       target="_blank" rel="noopener" aria-label="{{t "Share on X"}}">
        <i class="ph ph-x-logo" aria-hidden="true"></i>
    </a>
</aside>
