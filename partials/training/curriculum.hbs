{{!-- ════════════════════════════════════════════════════════════════════════
  training/curriculum.hbs — the training rail.

  NSDS's `.ns-trainingnav` (nsds/components/css/training.css), driven by the
  system's own `assets/js/nsds/training.js`: it opens the module holding
  `aria-current="page"`, closes the rest and scrolls it into view. Every module
  ships OPEN, so a script failure leaves the rail long rather than hidden.

  TRAINING IS MODULES → SECTIONS → POSTS. That is the structural difference
  from a COURSE, which is a flat list of lessons — and it is why the rail is
  nested <details> here and a flat `.ns-player__list` there.

  Below lg the rail is replaced by `.ns-panelbar` + a `.ns-lessonmodal`
  popover, exactly as the lesson player does it. That deleted the theme's
  `.ns-train-fab`, its scrim, and the last user of the Alpine `lessonNav`
  store — the platform gives a popover its top layer, light dismiss and Esc.

  Param: cur — the current section's slug, so the right module opens
         server-side and there is no flash before training.js runs.
═══════════════════════════════════════════════════════════════════════════ --}}

<nav class="ns-trainingnav" data-ns-trainingnav aria-label="{{t "Curriculum"}}" data-cur="{{cur}}">
  <a class="ns-trainingnav__track" href="/training/">{{> icons name="arrow-left"}}{{t "All training"}}</a>
  {{> "training/sections" view="nav" cur=cur curId=curId}}
</nav>

{{!-- Below lg: where you are, and one control to the whole curriculum. --}}
<div class="ns-panelbar ns-panelbar--fixed">
  <span class="ns-panelbar__now">
    <span class="ns-panelbar__kicker">{{t "Training"}}</span>
    <span class="ns-panelbar__title">{{title}}</span>
  </span>
  <button type="button" class="ns-btn ns-btn--outline ns-btn--sm" popovertarget="training-curriculum">
    {{> icons name="list"}}{{t "Curriculum"}}
  </button>
</div>

<div class="ns-lessonmodal" id="training-curriculum" popover>
  <div class="ns-lessonmodal__head">
    <span class="ns-lessonmodal__title">{{t "Training content"}}</span>
    {{#get "posts" filter="tag:hash-training-content" limit="1"}}
      <span class="ns-lessonmodal__count">{{pagination.total}} {{t "lessons"}}</span>
    {{/get}}
    <button class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm" type="button"
            popovertarget="training-curriculum" popovertargetaction="hide" aria-label="{{t "Close"}}">{{> icons name="x"}}</button>
  </div>
  <div class="ns-lessonmodal__list">
    <nav class="ns-trainingnav" aria-label="{{t "Curriculum"}}">
      {{> "training/sections" view="nav" cur=cur curId=curId}}
    </nav>
  </div>
</div>
