{{!-- training/curriculum.hbs — the whole training, grouped by section.
     There is ONE training, so this always lists every section (from
     training/sections.hbs, which owns their order) — not just the current
     post's. A section's lessons are #training-content posts whose PRIMARY tag
     is that section.
     • Search box on top filters modules AND hides emptied sections (Alpine q).
     • Sections are collapsible <details> with a keyword-matched icon + module
       count; the section containing the current module opens on load (script
       below), the rest start closed — and all stay user-toggleable.
     • Each module shows a type icon and its ACCESS state (lock for members/
       paid, tier star) straight from Ghost visibility.
     Static sidebar on lg; mobile drawer via the course-player hamburger. --}}
<div x-data="{ q: '' }" x-effect="if (q !== '') $el.querySelectorAll('details.train-sec').forEach(d => d.open = true)" class="js-lesson-nav">
  <nav id="training-curriculum" class="ns-lesson-panel" :class="$store.lessonNav.open && 'is-open'" aria-label="{{t "Curriculum"}}">

    <div class="ns-lesson-panel__bar">
      <span class="flex items-center gap-2 font-heading font-bold"><i class="ph-fill ph-books text-brand-500" aria-hidden="true"></i>{{t "Training content"}}</span>
      <button type="button" class="icon-btn" @click="$store.lessonNav.close()" aria-label="{{t "Close"}}">{{> "icons/x" class="h-5 w-5"}}</button>
    </div>

    <div class="ns-lesson-panel__body">
      <div class="mb-3 hidden items-center gap-2 lg:flex">
        <i class="ph-fill ph-books text-xl text-brand-500" aria-hidden="true"></i>
        <h3 class="font-heading font-bold">{{t "Training content"}}</h3>
      </div>

      {{!-- Search: filters modules; a section hides when nothing matches --}}
      <label class="relative mb-3 block">
        <i class="ph ph-magnifying-glass pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
        <input x-model="q" type="search" placeholder="{{t "Search this training…"}}" aria-label="{{t "Search lessons"}}"
               class="w-full rounded-btn border border-border bg-surface py-2 pl-9 pr-3 text-sm text-ink placeholder:text-muted focus:border-brand-500 focus:outline-none">
      </label>

      {{!-- One .train-rail around every section so the timeline is a single
           unbroken line through sections AND lessons (see course.css).
           Order comes from training/sections.hbs — section slugs are clean, so
           there's no query that can order them. --}}
      <div class="train-rail">
        {{> "training/sections" view="nav" cur=cur curId=curId}}
      </div>

      <p x-show="q !== '' && ![...document.querySelectorAll('#training-curriculum a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))"
         x-cloak class="ns-empty ns-empty--sm text-sm">{{t "No lessons match."}}</p>
    </div>
  </nav>
</div>

{{!-- Curriculum progress.

     1. Open the section containing the current module (others stay closed; on a
        training OVERVIEW open the first).
     2. Mark every lesson BEFORE the active one .is-done, and every section
        before the active section .is-done / the active one .is-current.
     3. Paint the rail: --tl-fill is the distance from the rail's top to the
        CENTRE of the active lesson, so the blue line stops exactly at "you are
        here". It's measured rather than computed in CSS because the rail spans
        collapsed <details> whose heights only exist at runtime — so it's
        re-measured whenever a section is toggled or the panel reflows. --}}
<script>
  (function () {
    var panel = document.querySelector('#training-curriculum');
    if (!panel) return;
    var rail = panel.querySelector('.train-rail');
    var active = panel.querySelector('.is-doc-active');

    if (active) {
      var d = active.closest('details');
      if (d) d.open = true;
    } else {
      var first = panel.querySelector('details.train-sec');
      if (first) first.open = true;
    }

    var activeLi = active ? active.closest('li') : null;

    // Progress only exists relative to a current module. On a training OVERVIEW
    // there is none, so nothing is done and the rail stays unpainted.
    if (activeLi) {
      // lessons: everything before the current module counts as done
      var items = panel.querySelectorAll('.train-tl li');
      for (var i = 0; i < items.length; i++) {
        if (items[i].classList.contains('is-active')) break;
        items[i].classList.add('is-done');
      }
      // sections: done if they end before the active lesson; current if they hold it
      var secs = panel.querySelectorAll('details.train-sec');
      for (var s = 0; s < secs.length; s++) {
        if (secs[s].contains(activeLi)) { secs[s].classList.add('is-current'); break; }
        secs[s].classList.add('is-done');
      }
    }

    function paint() {
      if (!rail) return;
      if (!activeLi) { rail.style.setProperty('--tl-fill', '0px'); return; }
      // only measurable when laid out; a collapsed section reports height 0
      var r = activeLi.getBoundingClientRect();
      if (!r.height) { rail.style.setProperty('--tl-fill', '0px'); return; }
      var top = rail.getBoundingClientRect().top + 16; // matches the rail's 1rem inset
      rail.style.setProperty('--tl-fill', Math.max(0, r.top + r.height / 2 - top) + 'px');
    }
    paint();
    panel.addEventListener('toggle', paint, true);   // <details> toggle doesn't bubble
    window.addEventListener('resize', paint);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(paint);
  })();
</script>
