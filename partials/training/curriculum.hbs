{{!-- ════════════════════════════════════════════════════════════════════════
  training/curriculum.hbs — the section rail.

  There is ONE training, so this always lists every section (order comes from
  training/sections.hbs); a section's lessons are #training-content posts whose
  PRIMARY tag is that section.

  Renders the .ns-sidenav COMPONENT — 2-components/sidebar-nav.css, documented
  at /styleguide/training-nav.html.

  THE OPEN/CLOSED RULE is native and server-rendered: each section is a
  <details> sharing one `name`, which is an exclusive accordion, and the
  current section gets `open` from Handlebars. So the right section is open on
  first paint (no flash), opening another closes it, and none of that needs
  JavaScript. The old version opened the section from a script on load and
  painted a progress rail by measuring element positions on every toggle and
  resize — all of that is gone.

  Params: cur   — slug of the section being viewed
          curId — id of the lesson being viewed (absent on a section overview)

  Static rail on lg; below that it is the drawer the player header opens.
═══════════════════════════════════════════════════════════════════════════ --}}
<div x-data="{ q: '' }" class="js-lesson-nav">
  <nav id="training-curriculum" class="ns-lesson-panel" data-cur="{{cur}}"
         :class="$store.lessonNav.open && 'is-open'" aria-label="{{t "Curriculum"}}">

    <div class="ns-lesson-panel__bar">
      <span class="flex items-center gap-2 font-heading font-bold"><i class="ph-fill ph-books text-brand-500" aria-hidden="true"></i>{{t "Training content"}}</span>
      <button type="button" class="icon-btn" @click="$store.lessonNav.close()" aria-label="{{t "Close"}}">{{> "icons/x" class="h-5 w-5"}}</button>
    </div>

    <div class="ns-lesson-panel__body">
      <div class="ns-sidenav ns-sidenav--sm">

        {{!-- Head: what this is, and how far through it you are. --}}
        <div class="ns-sidenav__head">
          <span class="ns-sidenav__title">{{t "Salesforce training"}}</span>
          {{#get "posts" filter="tag:hash-training-content" limit="1"}}
            <div class="ns-progress ns-progress--sm ns-sidenav__progress">
              <span class="ns-progress__bar js-train-progress"></span>
            </div>
            <div class="ns-sidenav__readout">
              <span class="js-train-done">0</span>
              <span>{{pagination.total}} {{t "lessons"}}</span>
            </div>
          {{/get}}
        </div>

        {{!-- Search: filters lessons; a section hides when nothing matches. --}}
        <label class="ns-input-icon mb-2">
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          <input x-model="q" type="search" placeholder="{{t "Search this training…"}}"
                 aria-label="{{t "Search lessons"}}" class="ns-input ns-input--sm">
        </label>

        {{> "training/sections" view="nav" cur=cur curId=curId}}

        <p x-show="q !== '' && ![...document.querySelectorAll('#training-curriculum a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))"
           x-cloak class="ns-empty ns-empty--sm text-sm">{{t "No lessons match."}}</p>

        <div class="ns-sidenav__foot">
          <a href="/training/" class="ns-btn ns-btn--outline ns-btn--sm ns-btn--block">
            <i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "All sections"}}
          </a>
        </div>

      </div>
    </div>
  </nav>
</div>

{{!-- Progress. Everything BEFORE the current lesson counts as done — that is
     the only thing a static site can honestly know without a member record.
     While a search is running, open every section so matches are visible;
     `name` would otherwise keep collapsing them to one. --}}
<script>
  (function () {
    var panel = document.querySelector('#training-curriculum');
    if (!panel) return;

    var links = Array.prototype.slice.call(panel.querySelectorAll('.ns-sidenav__link'));
    var current = panel.querySelector('.ns-sidenav__link.is-current');

    if (current) {
      for (var i = 0; i < links.length; i++) {
        if (links[i] === current) break;
        // the section overview rows are not lessons — don't count them
        if (links[i].querySelector('.ns-sidenav__num > span')) links[i].classList.add('is-done');
      }
      var done = panel.querySelectorAll('.ns-sidenav__link.is-done').length;
      var total = panel.querySelectorAll('.ns-sidenav__num > span').length;
      var bar = panel.querySelector('.js-train-progress');
      var out = panel.querySelector('.js-train-done');
      if (bar && total) bar.style.width = Math.round((done / total) * 100) + '%';
      if (out) out.textContent = done + ' / ' + total + ' done';
    }

    // Searching needs every section open at once, which is exactly what the
    // exclusive `name` prevents — so drop it while a query is active.
    var search = panel.querySelector('input[type="search"]');
    if (!search) return;
    var groups = Array.prototype.slice.call(panel.querySelectorAll('.ns-sidenav__group'));
    search.addEventListener('input', function () {
      var searching = search.value.trim() !== '';
      groups.forEach(function (g) {
        if (searching) { g.removeAttribute('name'); g.open = true; }
        else { g.setAttribute('name', 'ns-training-nav'); g.open = g.dataset.sec === panel.dataset.cur; }
      });
    });
  })();
</script>
