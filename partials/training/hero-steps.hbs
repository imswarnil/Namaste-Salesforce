{{!-- ════════════════════════════════════════════════════════════════════════
  training/hero-steps.hbs — the /training/ hero artwork.

  Salesforce upskilling, start → certified, as an ascending staircase: each
  tread is a section, and a learner climbs it, FILLING each tread as they land.
  It loops, so the promise ("stepwise, in order, you always know where you are")
  is legible without reading a word.

  Every tread is drawn hollow and STAYS drawn; only the blue fill is animated,
  timed to the climber's arrival. An earlier cut faded the whole tread in on a
  delay and the climber visibly floated in mid-air above a step that hadn't
  appeared yet — and the staircase started as an empty frame. Hollow→filled is
  also the same progress language the curriculum rail uses.

  Motion is CSS in one <style> here rather than screen.css: it's a single-use
  illustration, and nothing else can reuse a keyframe named for this staircase.
  prefers-reduced-motion settles it on the finished state.

  Role tokens only, so it flips in dark mode. Decorative → aria-hidden.
═══════════════════════════════════════════════════════════════════════════ --}}
<svg viewBox="0 0 460 340" fill="none" xmlns="http://www.w3.org/2000/svg"
     class="ns-steps-art h-auto w-full max-w-[30rem]" aria-hidden="true" focusable="false">
  <style>
    /* Only the FILL animates. Delays match the climber's arrival exactly, so a
       tread lights the moment it's landed on — never before, never after. */
    .ns-steps-art .fill   { opacity: 0; animation: nsFill 10s ease-out infinite both; }
    .ns-steps-art .fill-2 { animation-delay: 1.6s; }
    .ns-steps-art .fill-3 { animation-delay: 3.2s; }
    .ns-steps-art .fill-4 { animation-delay: 4.8s; }
    .ns-steps-art .fill-5 { animation-delay: 6.4s; }
    .ns-steps-art .climber { animation: nsClimb 10s cubic-bezier(0.65,0,0.35,1) infinite both; }
    .ns-steps-art .badge   { opacity: 0; animation: nsBadge 10s ease-out infinite both; animation-delay: 6.6s; }

    /* holds 0 through its delay (fill-mode: both reads the 0% frame) */
    @keyframes nsFill {
      0%        { opacity: 0; }
      3%, 90%   { opacity: 1; }
      97%, 100% { opacity: 0; }
    }
    /* rests on each tread, then hops. Arrival times: 0 / 16 / 32 / 48 / 64%. */
    @keyframes nsClimb {
      0%,   10% { transform: translate(0, 0); }
      16%,  26% { transform: translate(78px, -52px); }
      32%,  42% { transform: translate(156px, -104px); }
      48%,  58% { transform: translate(234px, -156px); }
      64%,  90% { transform: translate(312px, -208px); }
      97%, 100% { transform: translate(0, 0); }
    }
    @keyframes nsBadge {
      0%        { opacity: 0; transform: scale(0.7); }
      6%, 88%   { opacity: 1; transform: scale(1); }
      95%, 100% { opacity: 0; transform: scale(0.7); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ns-steps-art .fill, .ns-steps-art .badge { animation: none; opacity: 1; transform: none; }
      .ns-steps-art .climber { animation: none; transform: translate(312px, -208px); }
    }
  </style>

  {{!-- the ground the staircase stands on --}}
  <line x1="12" y1="300" x2="448" y2="300" class="stroke-border" stroke-width="1.5" stroke-dasharray="3 5"/>

  {{!-- risers --}}
  <path d="M92 257 H104 V205 M170 205 H182 V153 M248 153 H260 V101 M326 101 H338 V49"
        class="stroke-border" stroke-width="1.5" fill="none"/>

  {{!-- ── five treads: hollow base (always drawn) + an animated blue fill ── --}}
  <g>
    <rect x="26" y="252" width="66" height="10" rx="5" class="fill-surface stroke-border" stroke-width="1.5"/>
    <rect x="26" y="252" width="66" height="10" rx="5" class="fill fill-1 fill-brand-500"/>
    <rect x="26" y="268" width="40" height="4" rx="2" class="fill-muted" opacity="0.35"/>
  </g>
  <g>
    <rect x="104" y="200" width="66" height="10" rx="5" class="fill-surface stroke-border" stroke-width="1.5"/>
    <rect x="104" y="200" width="66" height="10" rx="5" class="fill fill-2 fill-brand-500"/>
    <rect x="104" y="216" width="46" height="4" rx="2" class="fill-muted" opacity="0.35"/>
  </g>
  <g>
    <rect x="182" y="148" width="66" height="10" rx="5" class="fill-surface stroke-border" stroke-width="1.5"/>
    <rect x="182" y="148" width="66" height="10" rx="5" class="fill fill-3 fill-brand-500"/>
    <rect x="182" y="164" width="38" height="4" rx="2" class="fill-muted" opacity="0.35"/>
  </g>
  <g>
    <rect x="260" y="96" width="66" height="10" rx="5" class="fill-surface stroke-border" stroke-width="1.5"/>
    <rect x="260" y="96" width="66" height="10" rx="5" class="fill fill-4 fill-brand-500"/>
    <rect x="260" y="112" width="50" height="4" rx="2" class="fill-muted" opacity="0.35"/>
  </g>
  <g>
    <rect x="338" y="44" width="66" height="10" rx="5" class="fill-surface stroke-border" stroke-width="1.5"/>
    <rect x="338" y="44" width="66" height="10" rx="5" class="fill fill-5 fill-brand-500"/>
    <rect x="338" y="60" width="34" height="4" rx="2" class="fill-muted" opacity="0.35"/>
  </g>

  {{!-- ── the certification badge at the summit ── --}}
  <g class="badge" style="transform-origin: 424px 22px;">
    <circle cx="424" cy="22" r="13" class="fill-brand-500" opacity="0.12"/>
    <circle cx="424" cy="22" r="8" class="fill-brand-500"/>
    <path d="M420.5 22l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  </g>

  {{!-- ── the learner, climbing ── --}}
  <g class="climber">
    <circle cx="59" cy="245" r="12" class="fill-brand-500" opacity="0.15"/>
    <circle cx="59" cy="245" r="7" class="fill-surface stroke-brand-500" stroke-width="2"/>
    <circle cx="59" cy="245" r="2.5" class="fill-brand-500"/>
  </g>
</svg>
