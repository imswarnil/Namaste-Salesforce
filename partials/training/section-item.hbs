{{!-- ════════════════════════════════════════════════════════════════════════
  training/section-item.hbs — one section, in one of two views.

  Called only from training/sections.hbs (which owns the order).
  Params: view ("card" | "nav" | "search") · n (step number) · slug · icon

  The tag is fetched by slug so this partial works from any context — /training/
  is a plain route with no posts of its own, so there's nothing to inherit.
  NOTE: {{#get}} repoints the context at its result, so `n`/`icon`/`view` are
  read INSIDE via ../ — they're partial params on the outer frame.
═══════════════════════════════════════════════════════════════════════════ --}}
{{#get "tags" filter="slug:{{slug}}" limit="1"}}
  {{#foreach tags}}

    {{#match ../../view "card"}}
      {{!-- ── Netflix-style card: the number is a huge outlined glyph the
           artwork sits against, not a badge. Hover lifts the card, pushes the
           number, and slides the title/CTA up (see .ns-nf-* in course.css). --}}
      <a href="/training/{{slug}}/" class="ns-nf group">
        <span class="ns-nf__num" aria-hidden="true">{{../../n}}</span>

        <span class="ns-nf__card">
          {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" class="ns-nf__img">
          {{else}}
            <span class="ns-nf__img ns-nf__img--empty"><i class="ph-fill {{../../icon}}" aria-hidden="true"></i></span>
          {{/if}}
          <span class="ns-nf__scrim" aria-hidden="true"></span>

          {{!-- lock lives on the card, not the title, so it survives the slide --}}
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:-public" limit="1"}}
            {{#if posts}}
              <span class="ns-nf__lock" title="{{t "Members only"}}"><i class="ph-fill ph-lock-simple" aria-hidden="true"></i></span>
            {{/if}}
          {{/get}}

          <span class="ns-nf__body">
            <span class="ns-nf__kicker">{{t "Section"}} {{../../n}}</span>
            <span class="ns-nf__title">{{name}}</span>
            {{#if description}}<span class="ns-nf__desc">{{description}}</span>{{/if}}
            <span class="ns-nf__meta">
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
                <span><i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "lessons"}}</span>
              {{/get}}
              <span class="ns-nf__go">{{t "Start"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </span>
          </span>
        </span>
      </a>
    {{/match}}

    {{#match ../../view "search"}}
      {{!-- ── One row in the training search results ── --}}
      <a href="/training/{{slug}}/" data-t="{{name}}"
         x-show="$el.dataset.t.toLowerCase().includes(q.trim().toLowerCase())"
         class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition hover:bg-surface-sunken">
        <i class="ph-fill {{../../icon}} shrink-0 text-brand-500" aria-hidden="true"></i>
        <span class="min-w-0 flex-1 truncate font-semibold text-ink">{{name}}</span>
        <span class="shrink-0 rounded-pill bg-brand-500/10 px-2 py-0.5 text-[0.65rem] font-bold uppercase text-brand-600 dark:text-brand-300">{{t "Section"}}</span>
      </a>
    {{/match}}

    {{#match ../../view "nav"}}
      {{!-- ── Curriculum rail: the section row + its lessons ── --}}
      <details class="train-sec group/sec" data-sec="{{slug}}"
               x-show="q === '' || [...$el.querySelectorAll('a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))">
        <summary class="flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-semibold text-ink transition hover:bg-surface-sunken [&::-webkit-details-marker]:hidden">
          <i class="ph-fill {{../../icon}} shrink-0 text-base text-brand-500" aria-hidden="true"></i>
          <span class="min-w-0 flex-1">{{name}}</span>
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
            <span class="shrink-0 rounded-pill bg-surface-sunken px-1.5 py-0.5 text-[0.65rem] font-bold text-muted">{{pagination.total}}</span>
          {{/get}}
          <i class="ph ph-caret-right shrink-0 text-xs text-muted transition-transform group-open/sec:rotate-90" aria-hidden="true"></i>
        </summary>

        <ol class="train-tl mb-2 pt-1">
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
            {{#foreach posts}}
              <li x-show="q === '' || $el.querySelector('a').dataset.title.toLowerCase().includes(q.toLowerCase())"
                  class="{{#match id ../../../../../../id}}is-active{{/match}}">
                <a href="{{url}}" data-title="{{title}}" @click="$store.lessonNav.close()"
                   class="doc-nav-link flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-sm text-muted transition hover:bg-surface-sunken hover:text-brand-600 dark:hover:text-brand-300 {{#match id ../../../../../../id}}is-doc-active{{/match}}">
                  <span class="flex min-w-0 items-center gap-2">
                    <i class="{{#match id ../../../../../../id}}ph-fill ph-play-circle{{else has tag="#training-type-video"}}ph ph-video-camera{{else has tag="#training-type-exercise"}}ph ph-barbell{{else has tag="#training-type-quiz"}}ph ph-exam{{else}}ph ph-file-text{{/match}} shrink-0" aria-hidden="true"></i>
                    <span class="truncate">{{title}}</span>
                  </span>
                  <span class="flex shrink-0 items-center gap-1.5 text-xs">
                    {{^has visibility="public"}}<i class="ph-fill ph-lock-simple" title="{{t "Members only"}}" aria-hidden="true"></i>{{/has}}
                    <span>{{reading_time minute="1m" minutes="%m"}}</span>
                  </span>
                </a>
              </li>
            {{/foreach}}
          {{/get}}
        </ol>
      </details>
    {{/match}}

  {{/foreach}}
{{/get}}
