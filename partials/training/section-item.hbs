{{!-- ════════════════════════════════════════════════════════════════════════
  training/section-item.hbs — one section, in one of two views.

  Called only from training/sections.hbs (which owns the order).
  Params: view ("card" | "nav" | "search" | "jsonld" | "jsonld-ref")
          n (step number) · slug · icon · first ("1" on the first section only,
          so jsonld-ref can omit its leading comma)
          cur   — slug of the section currently being viewed
          curId — id of the lesson currently being viewed (absent on a section
                  page, which is how "Overview is active" is decided)

  The tag is fetched by slug so this partial works from any context — /training/
  is a plain route with no posts of its own, so there's nothing to inherit.
  NOTE: {{#get}} repoints the context at its result, so params (`n`, `icon`,
  `view`, `cur`, `curId`) are read INSIDE via ../ — they live on the outer
  frame. Active state is passed in rather than walked to with a deep ../ chain:
  this partial renders from BOTH a post context (a lesson) and a tag context (a
  section page), so no fixed depth could be correct for both.
═══════════════════════════════════════════════════════════════════════════ --}}
{{#get "tags" filter="slug:{{slug}}" limit="1"}}
  {{#foreach tags}}

    {{#match ../../view "card"}}
      {{!-- ── One stop on the roadmap. Content-first: the blurb, lesson count
           and access are all visible at rest — the previous card hid them
           under an image scrim until hover, which meant never on touch. ── --}}
      <li class="ns-road__node">
        <a href="/training/{{slug}}/" class="ns-road__card">
          <span class="ns-road__thumb">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy">
            {{else}}
              <i class="ph-fill {{../../icon}}" aria-hidden="true"></i>
            {{/if}}
          </span>

          <span class="ns-road__body">
            <span class="ns-road__kicker">
              <span class="ns-road__num">{{../../n}}</span>{{t "Section"}}
            </span>
            <span class="ns-road__title">{{name}}</span>
            {{#if description}}<span class="ns-road__desc">{{description}}</span>{{/if}}

            <span class="ns-road__meta">
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
                <span><i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "lessons"}}</span>
              {{/get}}
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}
                <span><i class="ph ph-lock-simple-open" aria-hidden="true"></i>{{pagination.total}} {{t "free"}}</span>
              {{/get}}
              {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:-public" limit="1"}}
                {{#if posts}}<span><i class="ph-fill ph-lock-simple" aria-hidden="true"></i>{{t "Members"}}</span>{{/if}}
              {{/get}}
            </span>
          </span>
        </a>
      </li>
    {{/match}}

    {{#match ../../view "search"}}
      {{!-- ── One section row in the training search results ── --}}
      <a href="/training/{{slug}}/" data-t="{{name}}"
         x-show="$el.dataset.t.toLowerCase().includes(q.trim().toLowerCase())"
         class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition hover:bg-surface-sunken">
        <i class="ph-fill {{../../icon}} shrink-0 text-brand-500" aria-hidden="true"></i>
        <span class="min-w-0 flex-1 truncate font-semibold text-ink">{{name}}</span>
        <span class="shrink-0 rounded-pill bg-brand-500/10 px-2 py-0.5 text-[0.65rem] font-bold uppercase text-brand-600 dark:text-brand-300">{{t "Section"}}</span>
      </a>
    {{/match}}

    {{!-- ── JSON-LD: a bare @id reference, for the training's hasPart array.
         `first` suppresses the leading comma — these are five separate partial
         calls, so there's no {{@first}} to lean on. ── --}}
    {{#match ../../view "jsonld-ref"}}{{#unless ../../first}},{{/unless}}{ "@id": "{{@site.url}}/training/{{slug}}/#section" }{{/match}}

    {{!-- ── JSON-LD: the section's full node, with its lessons. Always leads
         with a comma — it always follows the training's Course node. ── --}}
    {{#match ../../view "jsonld"}},{
      "@type": "Course",
      "@id": "{{@site.url}}/training/{{slug}}/#section",
      "name": "{{name}}",
      {{#if description}}"description": "{{description}}",{{/if}}
      "url": "{{@site.url}}/training/{{slug}}/",
      {{#if feature_image}}"image": "{{feature_image}}",{{/if}}
      "position": {{../../n}},
      "provider": { "@id": "{{@site.url}}/#owner" },
      "inLanguage": "{{@site.locale}}",
      "isPartOf": { "@id": "{{@site.url}}/training/#course" },
      "hasCourseInstance": { "@type": "CourseInstance", "courseMode": "online" },
      "hasPart": [
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
          {{#foreach posts}}{{#unless @first}},{{/unless}}{
            "@type": "LearningResource",
            "@id": "{{url absolute="true"}}#lesson",
            "name": "{{title}}",
            "url": "{{url absolute="true"}}",
            "position": {{@number}},
            "learningResourceType": "{{#has tag="#training-type-video"}}Video{{else has tag="#training-type-exercise"}}Exercise{{else has tag="#training-type-quiz"}}Quiz{{else}}Reading{{/has}}",
            "isAccessibleForFree": {{#has visibility="public"}}true{{else}}false{{/has}}
          }{{/foreach}}
        {{/get}}
      ]
    }{{/match}}

    {{#match ../../view "nav"}}
      {{!-- ── Curriculum rail: the section row + its lessons ── --}}
      <details class="train-sec group/sec" data-sec="{{slug}}"
               x-show="q === '' || [...$el.querySelectorAll('a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))">
        <summary class="flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-semibold text-ink transition hover:bg-surface-sunken [&::-webkit-details-marker]:hidden">
          <i class="ph-fill {{../../icon}} shrink-0 text-base text-brand-500" aria-hidden="true"></i>
          <span class="min-w-0 flex-1">{{name}}</span>
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
            <span class="shrink-0 rounded-pill bg-surface-sunken px-1.5 py-0.5 text-[0.65rem] font-bold text-muted">{{pagination.total}}</span>
          {{/get}}
          <i class="ph ph-caret-right shrink-0 text-xs text-muted transition-transform group-open/sec:rotate-90" aria-hidden="true"></i>
        </summary>

        <ol class="train-tl mb-2 pt-1">
          {{!-- The section's OWN page, as the first entry under it — the
               "overview" for that section. Active when we're on it (no lesson
               is current, and the current section is this one). --}}
          <li class="{{#if ../../curId}}{{else}}{{#match ../../cur slug}}is-active{{/match}}{{/if}}">
            <a href="/training/{{slug}}/" data-title="{{name}} overview" @click="$store.lessonNav.close()"
               class="doc-nav-link flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-sm text-muted transition hover:bg-surface-sunken hover:text-brand-600 dark:hover:text-brand-300 {{#if ../../curId}}{{else}}{{#match ../../cur slug}}is-doc-active{{/match}}{{/if}}">
              <span class="flex min-w-0 items-center gap-2">
                <i class="ph{{#if ../../curId}} ph-squares-four{{else}}{{#match ../../cur slug}}-fill ph-play-circle{{else}} ph-squares-four{{/match}}{{/if}} shrink-0" aria-hidden="true"></i>
                <span class="truncate">{{t "Overview"}}</span>
              </span>
            </a>
          </li>

          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
            {{#foreach posts}}
              <li x-show="q === '' || $el.querySelector('a').dataset.title.toLowerCase().includes(q.toLowerCase())"
                  class="{{#match id ../../../../curId}}is-active{{/match}}">
                <a href="{{url}}" data-title="{{title}}" @click="$store.lessonNav.close()"
                   class="doc-nav-link flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-sm text-muted transition hover:bg-surface-sunken hover:text-brand-600 dark:hover:text-brand-300 {{#match id ../../../../curId}}is-doc-active{{/match}}">
                  <span class="flex min-w-0 items-center gap-2">
                    <i class="{{#match id ../../../../curId}}ph-fill ph-play-circle{{else has tag="#training-type-video"}}ph ph-video-camera{{else has tag="#training-type-exercise"}}ph ph-barbell{{else has tag="#training-type-quiz"}}ph ph-exam{{else}}ph ph-file-text{{/match}} shrink-0" aria-hidden="true"></i>
                    <span class="truncate">{{title}}</span>
                  </span>
                  <span class="flex shrink-0 items-center gap-1.5 text-xs">
                    {{^has visibility="public"}}<i class="ph-fill ph-lock-simple" title="{{t "Members only"}}" aria-hidden="true"></i>{{/has}}
                    <span>{{reading_time minute="1m" minutes="%m"}}</span>
                  </span>
                </a>
              </li>
            {{/foreach}}
          {{/get}}
        </ol>
      </details>
    {{/match}}

  {{/foreach}}
{{/get}}
