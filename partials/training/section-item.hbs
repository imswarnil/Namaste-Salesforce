{{!-- ════════════════════════════════════════════════════════════════════════
  training/section-item.hbs — one section, in one of several views.

  Called only from training/sections.hbs, which owns the query and the order.

  CONTEXT IS A POST — the section post (tagged #training-section). It used to
  be a tag fetched with {{#get "tags"}}, which is why every value was reached
  across a `../../` frame; that indirection is gone. Now:
      {{title}}         the section name
      {{slug}}          == its primary tag's slug, so it doubles as BOTH the
                        URL segment and the filter that finds that section's
                        lessons (tag:{{slug}})
      {{custom_excerpt}} the blurb
      {{feature_image}} optional artwork
      {{url}}           /training/{{slug}}/ — from the collection permalink

  Params: view ("card" | "nav" | "search" | "jsonld" | "jsonld-ref")
          n     step number (@number from the foreach)
          first true on the first section, so jsonld-ref can omit its comma
          cur   slug of the section currently being viewed
          curId id of the lesson currently being viewed (absent on a section
                page, which is how "Overview is active" is decided)

  NOTE: {{#get}} repoints the context at its result, so anything from the post
  must be read via ../ INSIDE those blocks.
═══════════════════════════════════════════════════════════════════════════ --}}

{{#match view "card"}}
  {{!-- ── One stop on the training track: a numbered badge on the spine, then a
       card with the section PHOTO on the left and content on the right. ── --}}
  <li class="ns-track__item">
    <span class="ns-track__num">{{n}}</span>
    <a href="{{url}}" class="ns-track__card">
      {{!-- Photo priority: the section TAG's image first (set once on the tag,
           shared everywhere the section appears), then the section POST's own
           feature image, then a position-rotated glyph so a section with
           neither still reads as a distinct stop. ── --}}
      <span class="ns-track__media">
        {{#if primary_tag.feature_image}}
          <img src="{{img_url primary_tag.feature_image size="s"}}" alt="" loading="lazy" decoding="async">
        {{else}}{{#if feature_image}}
          <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy" decoding="async">
        {{else}}
          <i class="ph-fill {{#match n 1}}ph-flag{{else match n 2}}ph-gear-six{{else match n 3}}ph-compass{{else match n 4}}ph-database{{else match n 5}}ph-shield-check{{else}}ph-steps{{/match}}" aria-hidden="true"></i>
        {{/if}}{{/if}}
      </span>

      <span class="ns-track__body">
        <span class="ns-track__kicker">{{t "Section"}} {{n}}</span>
        <span class="ns-track__title">{{title}}</span>
        {{#if custom_excerpt}}<span class="ns-track__desc">{{custom_excerpt}}</span>{{/if}}

        <span class="ns-track__meta">
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
            <span><i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "lessons"}}</span>
          {{/get}}
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}
            <span><i class="ph ph-lock-simple-open" aria-hidden="true"></i>{{pagination.total}} {{t "free"}}</span>
          {{/get}}
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:-public" limit="1"}}
            {{#if posts}}<span><i class="ph-fill ph-lock-simple" aria-hidden="true"></i>{{t "Members"}}</span>{{/if}}
          {{/get}}
        </span>

        {{!-- a <span>, not a nested <a>: the whole card is already the link --}}
        <span class="ns-track__cta">{{t "Start this section"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
      </span>
    </a>
  </li>
{{/match}}

{{#match view "overview"}}
  {{!-- ── One row in the HOME roadmap card: a numbered step on a connecting
       rail, section name + lesson count, chevron. Deliberately lighter than the
       full /training/ photo track — a glance, not the detailed roadmap. ── --}}
  <li class="ns-plist__item">
    <a href="{{url}}" class="ns-plist__row">
      <span class="ns-plist__num">{{n}}</span>
      <span class="ns-plist__main">
        <span class="ns-plist__title">{{title}}</span>
        <span class="ns-plist__meta">
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}<i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "lessons"}}{{/get}}
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}{{#if pagination.total}} · {{pagination.total}} {{t "free"}}{{/if}}{{/get}}
        </span>
      </span>
      <i class="ph ph-caret-right ns-plist__arrow" aria-hidden="true"></i>
    </a>
  </li>
{{/match}}

{{#match view "search"}}
  {{!-- ── One section row in the training search results ── --}}
  <a href="{{url}}" data-t="{{title}}"
     x-show="$el.dataset.t.toLowerCase().includes(q.trim().toLowerCase())"
     class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition hover:bg-surface-sunken">
    <i class="ph-fill ph-steps shrink-0 text-brand-500" aria-hidden="true"></i>
    <span class="min-w-0 flex-1 truncate font-semibold text-ink">{{title}}</span>
    <span class="ns-badge shrink-0">{{t "Section"}}</span>
  </a>
{{/match}}

{{!-- ── JSON-LD: a bare @id reference, for the training's hasPart array.
     `first` suppresses the leading comma. ── --}}
{{#match view "jsonld-ref"}}{{#unless first}},{{/unless}}{ "@id": "{{url absolute="true"}}#section" }{{/match}}

{{!-- ── JSON-LD: the section's full node, with its lessons. Always leads with
     a comma — it always follows the training's Course node. ── --}}
{{#match view "jsonld"}},{
  "@type": "Course",
  "@id": "{{url absolute="true"}}#section",
  "name": "{{title}}",
  {{#if custom_excerpt}}"description": "{{custom_excerpt}}",{{/if}}
  "url": "{{url absolute="true"}}",
  {{#if primary_tag.feature_image}}"image": "{{primary_tag.feature_image}}",{{else}}{{#if feature_image}}"image": "{{feature_image}}",{{/if}}{{/if}}
  "position": {{n}},
  "provider": { "@id": "{{@site.url}}/#owner" },
  "inLanguage": "{{@site.locale}}",
  "isPartOf": { "@id": "{{@site.url}}/training/#course" },
  "hasCourseInstance": { "@type": "CourseInstance", "courseMode": "online" },
  "hasPart": [
    {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
      {{#foreach posts}}{{#unless @first}},{{/unless}}{
        "@type": "LearningResource",
        "@id": "{{url absolute="true"}}#lesson",
        "name": "{{title}}",
        "url": "{{url absolute="true"}}",
        "position": {{@number}},
        "learningResourceType": "{{#has tag="#training-type-video"}}Video{{else has tag="#training-type-exercise"}}Exercise{{else has tag="#training-type-quiz"}}Quiz{{else has tag="#training-type-article"}}Article{{else}}Article{{/has}}",
        "isAccessibleForFree": {{#has visibility="public"}}true{{else}}false{{/has}}
      }{{/foreach}}
    {{/get}}
  ]
}{{/match}}

{{#match view "nav"}}
  {{!-- ── Curriculum rail: the section row + its lessons. Open by default when
       it is the section being viewed, so the reader lands with their own
       section expanded. ── --}}
  <details class="train-sec group/sec" data-sec="{{slug}}" {{#match cur slug}}open{{/match}}
           x-show="q === '' || [...$el.querySelectorAll('a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))">
    <summary class="flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2 py-2 text-sm font-semibold text-ink transition hover:bg-surface-sunken [&::-webkit-details-marker]:hidden">
      <i class="ph-fill ph-steps shrink-0 text-base text-brand-500" aria-hidden="true"></i>
      <span class="min-w-0 flex-1">{{title}}</span>
      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
        <span class="shrink-0 rounded-pill bg-surface-sunken px-1.5 py-0.5 text-[0.65rem] font-bold text-muted">{{pagination.total}}</span>
      {{/get}}
      <i class="ph ph-caret-right shrink-0 text-xs text-muted transition-transform group-open/sec:rotate-90" aria-hidden="true"></i>
    </summary>

    <ol class="train-tl mb-2 pt-1">
      {{!-- The section's OWN page, as the first entry under it — the
           "overview". Active when no lesson is current AND this is the
           current section. --}}
      <li class="{{#unless curId}}{{#match cur slug}}is-active{{/match}}{{/unless}}">
        <a href="{{url}}" data-title="{{title}} overview" @click="$store.lessonNav.close()"
           class="doc-nav-link flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-sm text-muted transition hover:bg-surface-sunken hover:text-brand-600 dark:hover:text-brand-300 {{#unless curId}}{{#match cur slug}}is-doc-active{{/match}}{{/unless}}">
          <span class="flex min-w-0 items-center gap-2">
            <i class="{{#unless curId}}{{#match cur slug}}ph-fill ph-play-circle{{else}}ph ph-squares-four{{/match}}{{else}}ph ph-squares-four{{/unless}} shrink-0" aria-hidden="true"></i>
            <span class="truncate">{{t "Overview"}}</span>
          </span>
        </a>
      </li>

      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
        {{#foreach posts}}
          <li x-show="q === '' || $el.querySelector('a').dataset.title.toLowerCase().includes(q.toLowerCase())"
              class="{{#match id ../../curId}}is-active{{/match}}">
            <a href="{{url}}" data-title="{{title}}" @click="$store.lessonNav.close()"
               class="doc-nav-link flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-sm text-muted transition hover:bg-surface-sunken hover:text-brand-600 dark:hover:text-brand-300 {{#match id ../../curId}}is-doc-active{{/match}}">
              <span class="flex min-w-0 items-center gap-2">
                <i class="{{#match id ../../curId}}ph-fill ph-play-circle{{else has tag="#training-type-video"}}ph ph-video-camera{{else has tag="#training-type-exercise"}}ph ph-barbell{{else has tag="#training-type-quiz"}}ph ph-exam{{else}}ph ph-file-text{{/match}} shrink-0" aria-hidden="true"></i>
                <span class="truncate">{{title}}</span>
              </span>
              <span class="flex shrink-0 items-center gap-1.5 text-xs">
                {{^has visibility="public"}}<i class="ph-fill ph-lock-simple" title="{{t "Members only"}}" aria-hidden="true"></i>{{/has}}
                <span>{{reading_time minute="1m" minutes="%m"}}</span>
              </span>
            </a>
          </li>
        {{/foreach}}
      {{/get}}
    </ol>
  </details>
{{/match}}
