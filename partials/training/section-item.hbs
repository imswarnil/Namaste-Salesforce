{{!-- ════════════════════════════════════════════════════════════════════════
  training/section-item.hbs — one section, in one of several views.

  Called only from training/sections.hbs, which owns the query and the order.

  CONTEXT IS A POST — the section post (tagged #training-section). It used to
  be a tag fetched with {{#get "tags"}}, which is why every value was reached
  across a `../../` frame; that indirection is gone. Now:
      {{title}}         the section name
      {{slug}}          == its primary tag's slug, so it doubles as BOTH the
                        URL segment and the filter that finds that section's
                        lessons (tag:{{slug}})
      {{custom_excerpt}} the blurb
      {{feature_image}} optional artwork
      {{url}}           /training/{{slug}}/ — from the collection permalink

  Params: view ("card" | "nav" | "search" | "jsonld" | "jsonld-ref")
          n     step number (@number from the foreach)
          first true on the first section, so jsonld-ref can omit its comma
          cur   slug of the section currently being viewed
          curId id of the lesson currently being viewed (absent on a section
                page, which is how "Overview is active" is decided)

  NOTE: {{#get}} repoints the context at its result, so anything from the post
  must be read via ../ INSIDE those blocks.
═══════════════════════════════════════════════════════════════════════════ --}}

{{#match view "card"}}
  {{!-- ── One section on the /training/ path: a numbered disc on the shared
       rail, then the card. .ns-track-card — see 2-components/track.css and
       /styleguide/training-overview.html. The disc number is generated by the
       component's counter, so re-ordering sections never leaves a stale one. ── --}}
  <article class="ns-track-card">
    <div class="ns-track-card__index"></div>
    <div class="ns-track-card__box">

      {{!-- The section's image, floated beside the copy. Tag image first (set
           once, shared everywhere the section appears), then the post's own,
           then the shared fallback glyph. --}}
      <span class="ns-track-card__media">
        {{#if primary_tag.feature_image}}
          <img src="{{img_url primary_tag.feature_image size="s"}}" alt="" loading="lazy" decoding="async">
        {{else}}{{#if feature_image}}
          <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy" decoding="async">
        {{else}}
          <i class="ph-fill ph-stack" aria-hidden="true"></i>
        {{/if}}{{/if}}
      </span>

      <div class="ns-track-card__head">
        <h3 class="ns-track-card__title"><a href="{{url}}">{{title}}</a></h3>
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:-public" limit="1"}}
          {{#if posts}}<span class="ns-badge ns-badge--neutral"><i class="ph ph-lock" aria-hidden="true"></i>{{t "Members"}}</span>{{/if}}
        {{/get}}
      </div>

      {{#if custom_excerpt}}<p class="ns-track-card__excerpt">{{custom_excerpt}}</p>{{/if}}

      <div class="ns-track-card__meta">
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
          <span>{{pagination.total}} {{t "lessons"}}</span>
        {{/get}}
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}
          {{#if pagination.total}}<span>{{pagination.total}} {{t "free"}}</span>{{/if}}
        {{/get}}
      </div>

      {{!-- The first few lessons, as a preview. Deliberately not the whole
           list: the section page is where the full contents lives. --}}
      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="3"}}
        {{#if posts}}
          <div class="ns-track-card__lessons">
            {{#foreach posts}}
              <a class="ns-track-card__lesson" href="{{url}}">
                <i class="ph-fill {{#has tag="#training-type-video"}}ph-play-circle{{else has tag="#training-type-exercise"}}ph-barbell{{else has tag="#training-type-quiz"}}ph-exam{{else}}ph-article{{/has}}" aria-hidden="true"></i>
                <span>{{title}}</span>
                <span class="ns-track-card__lesson-meta">
                  {{^has visibility="public"}}<i class="ph ph-lock" aria-hidden="true"></i>{{else}}{{reading_time minute="1m" minutes="%m"}}{{/has}}
                </span>
              </a>
            {{/foreach}}
          </div>
        {{/if}}
      {{/get}}
    </div>
  </article>
{{/match}}

{{#match view "overview"}}
  {{!-- ── One row in the HOME roadmap card: a numbered step on a connecting
       rail, section name + lesson count, chevron. Deliberately lighter than the
       full /training/ photo track — a glance, not the detailed roadmap. ── --}}
  <li class="ns-plist__item">
    <a href="{{url}}" class="ns-plist__row">
      <span class="ns-plist__num">{{n}}</span>
      <span class="ns-plist__main">
        <span class="ns-plist__title">{{title}}</span>
        <span class="ns-plist__meta">
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}<i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "lessons"}}{{/get}}
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}{{#if pagination.total}} · {{pagination.total}} {{t "free"}}{{/if}}{{/get}}
        </span>
      </span>
      <i class="ph ph-caret-right ns-plist__arrow" aria-hidden="true"></i>
    </a>
  </li>
{{/match}}

{{#match view "search"}}
  {{!-- ── One section row in the training search results ── --}}
  <a href="{{url}}" data-t="{{title}}"
     x-show="$el.dataset.t.toLowerCase().includes(q.trim().toLowerCase())"
     class="flex items-center gap-2.5 rounded-btn px-2.5 py-2 text-sm transition hover:bg-surface-sunken">
    <i class="ph-fill ph-steps shrink-0 text-brand-500" aria-hidden="true"></i>
    <span class="min-w-0 flex-1 truncate font-semibold text-ink">{{title}}</span>
    <span class="ns-badge shrink-0">{{t "Section"}}</span>
  </a>
{{/match}}

{{!-- ── JSON-LD: a bare @id reference, for the training's hasPart array.
     `first` suppresses the leading comma. ── --}}
{{#match view "jsonld-ref"}}{{#unless first}},{{/unless}}{ "@id": "{{url absolute="true"}}#section" }{{/match}}

{{!-- ── JSON-LD: the section's full node, with its lessons. Always leads with
     a comma — it always follows the training's Course node. ── --}}
{{#match view "jsonld"}},{
  "@type": "Course",
  "@id": "{{url absolute="true"}}#section",
  "name": "{{title}}",
  {{#if custom_excerpt}}"description": "{{custom_excerpt}}",{{/if}}
  "url": "{{url absolute="true"}}",
  {{#if primary_tag.feature_image}}"image": "{{primary_tag.feature_image}}",{{else}}{{#if feature_image}}"image": "{{feature_image}}",{{/if}}{{/if}}
  "position": {{n}},
  "provider": { "@id": "{{@site.url}}/#owner" },
  "inLanguage": "{{@site.locale}}",
  "isPartOf": { "@id": "{{@site.url}}/training/#course" },
  "hasCourseInstance": { "@type": "CourseInstance", "courseMode": "online" },
  "hasPart": [
    {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
      {{#foreach posts}}{{#unless @first}},{{/unless}}{
        "@type": "LearningResource",
        "@id": "{{url absolute="true"}}#lesson",
        "name": "{{title}}",
        "url": "{{url absolute="true"}}",
        "position": {{@number}},
        "learningResourceType": "{{#has tag="#training-type-video"}}Video{{else has tag="#training-type-exercise"}}Exercise{{else has tag="#training-type-quiz"}}Quiz{{else has tag="#training-type-article"}}Article{{else}}Article{{/has}}",
        "isAccessibleForFree": {{#has visibility="public"}}true{{else}}false{{/has}}
      }{{/foreach}}
    {{/get}}
  ]
}{{/match}}

{{#match view "nav"}}
  {{!-- ── One section in the rail. .ns-sidenav — see 2-components/sidebar-nav.css
       and /styleguide/training-nav.html.

       THE BEHAVIOUR RULE: the section you are in stays open, every other one is
       closed. `name` makes these a native exclusive accordion, so the browser
       enforces one-open-at-a-time and closes the previous when another opens —
       no script, and `open` is rendered server-side so there is no flash.

       Deliberately no lesson count on the row: the expanded list already shows
       it, and the number was the noisiest thing in the rail. ── --}}
  <details class="ns-sidenav__group" name="ns-training-nav" data-sec="{{slug}}" {{#match cur slug}}open{{/match}}
           x-show="q === '' || [...$el.querySelectorAll('a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))">
    <summary class="ns-sidenav__summary">
      {{!-- The section's own image is its icon. Tag image first (set once on
           the tag, shared everywhere the section appears), then the post's
           feature image, then ONE shared fallback glyph — the same for every
           section, so a missing image reads as "section" rather than as a
           different kind of thing. --}}
      <span class="ns-sidenav__icon">
        {{#if primary_tag.feature_image}}
          <img src="{{img_url primary_tag.feature_image size="xs"}}" alt="" loading="lazy" decoding="async">
        {{else}}{{#if feature_image}}
          <img src="{{img_url feature_image size="xs"}}" alt="" loading="lazy" decoding="async">
        {{else}}
          <i class="ph-fill ph-stack" aria-hidden="true"></i>
        {{/if}}{{/if}}
      </span>
      <span class="ns-sidenav__stitle">{{title}}</span>
      <i class="ns-sidenav__caret ph ph-caret-right" aria-hidden="true"></i>
    </summary>

    <div class="ns-sidenav__list">
      {{!-- The section's own page is the first row — its overview. Active when
           this is the current section AND no lesson is open. --}}
      <a href="{{url}}" data-title="{{title}} overview" @click="$store.lessonNav.close()"
         class="ns-sidenav__link{{#unless curId}}{{#match cur slug}} is-current{{/match}}{{/unless}}">
        <span class="ns-sidenav__num"><i class="ph ph-squares-four" aria-hidden="true"></i></span>
        <span class="ns-sidenav__text">{{t "Overview"}}</span>
      </a>

      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
        {{#foreach posts}}
          <a href="{{url}}" data-title="{{title}}" @click="$store.lessonNav.close()"
             x-show="q === '' || $el.dataset.title.toLowerCase().includes(q.toLowerCase())"
             class="ns-sidenav__link{{#match id ../../curId}} is-current{{/match}}{{^has visibility="public"}} is-locked{{/has}}">
            <span class="ns-sidenav__num"><span>{{@number}}</span></span>
            <i class="ns-sidenav__type {{#has tag="#training-type-video"}}ph-fill ph-play-circle{{else has tag="#training-type-exercise"}}ph-fill ph-barbell{{else has tag="#training-type-quiz"}}ph-fill ph-exam{{else}}ph-fill ph-article{{/has}}" aria-hidden="true"></i>
            <span class="ns-sidenav__text">{{title}}</span>
            <span class="ns-sidenav__meta">
              {{^has visibility="public"}}<i class="ph ph-lock" aria-hidden="true"></i>{{else}}{{reading_time minute="1m" minutes="%m"}}{{/has}}
            </span>
          </a>
        {{/foreach}}
      {{/get}}

      {{!-- When this section ends, the next one starts — without a trip back
           out to the path. Sections are ordered by published_at. --}}
      {{#get "posts" filter="tag:hash-training-section+published_at:>'{{published_at}}'" order="published_at asc" limit="1"}}
        {{#foreach posts}}
          <a href="{{url}}" class="ns-sidenav__next" @click="$store.lessonNav.close()">
            {{t "Next"}}<span>{{title}}</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        {{/foreach}}
      {{/get}}
    </div>
  </details>
{{/match}}
