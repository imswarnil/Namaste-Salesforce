{{!-- ════════════════════════════════════════════════════════════════════════
  training/section-item.hbs — one section, in one of several views.

  Called only from training/sections.hbs, which owns the query and the order.

  CONTEXT IS A POST — the section post (tagged #training-section). It used to
  be a tag fetched with {{#get "tags"}}, which is why every value was reached
  across a `../../` frame; that indirection is gone. Now:
      {{title}}         the section name
      {{slug}}          == its primary tag's slug, so it doubles as BOTH the
                        URL segment and the filter that finds that section's
                        lessons (tag:{{slug}})
      {{custom_excerpt}} the blurb
      {{feature_image}} optional artwork
      {{url}}           /training/{{slug}}/ — from the collection permalink

  Params: view ("card" | "nav" | "search" | "jsonld" | "jsonld-ref")
          n     step number (@number from the foreach)
          first true on the first section, so jsonld-ref can omit its comma
          cur   slug of the section currently being viewed
          curId id of the lesson currently being viewed (absent on a section
                page, which is how "Overview is active" is decided)

  NOTE: {{#get}} repoints the context at its result, so anything from the post
  must be read via ../ INSIDE those blocks.
═══════════════════════════════════════════════════════════════════════════ --}}

{{#match view "card"}}
  {{!-- ── One section on the /training/ path: a numbered disc on the shared
       rail, then the card. .ns-trackcard — see 2-components/track.css and
       /styleguide/training-overview.html. The disc number is generated by the
       component's counter, so re-ordering sections never leaves a stale one. ── --}}
  <article class="ns-trackcard">
    <div class="ns-trackcard__index"></div>
    <div class="ns-trackcard">

      {{!-- The section's image, floated beside the copy. Tag image first (set
           once, shared everywhere the section appears), then the post's own,
           then the shared fallback glyph. --}}
      <span class="ns-trackcard__icon">
        {{#if primary_tag.feature_image}}
          <img src="{{img_url primary_tag.feature_image size="s"}}" alt="" loading="lazy" decoding="async">
        {{else}}{{#if feature_image}}
          <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy" decoding="async">
        {{else}}
          {{> icons name="stack"}}
        {{/if}}{{/if}}
      </span>

      <div class="ns-trackcard__head">
        <h3 class="ns-trackcard__title"><a href="{{url}}">{{title}}</a></h3>
      </div>

      {{#if custom_excerpt}}<p class="ns-trackcard__text">{{custom_excerpt}}</p>{{/if}}

      <div class="ns-trackcard__meta">
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
          <span>{{pagination.total}} {{t "lessons"}}</span>
        {{/get}}
      </div>

      {{!-- The first few lessons, as a preview. Deliberately not the whole
           list: the section page is where the full contents lives. --}}
      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="3"}}
        {{#if posts}}
          <div class="ns-units">
            {{#foreach posts}}
              <a class="ns-unit{{^has visibility="public"}} is-locked{{/has}}" href="{{url}}">
                {{#has tag="#training-video"}}{{> icons name="play-circle"}}{{else has tag="#training-exercise"}}{{> icons name="barbell"}}{{else has tag="#training-quiz"}}{{> icons name="exam"}}{{else}}{{> icons name="article"}}{{/has}}
                <span>{{title}}</span>
                <span class="ns-unit__time">
                  {{^has visibility="public"}}{{> icons name="lock"}}{{else}}{{reading_time minute="1m" minutes="%m"}}{{/has}}
                </span>
              </a>
            {{/foreach}}
          </div>
        {{/if}}
      {{/get}}
    </div>
  </article>
{{/match}}

{{#match view "overview"}}
  {{!-- ── One row in the HOME roadmap card: a numbered step on a connecting
       rail, section name + lesson count, chevron. Deliberately lighter than the
       full /training/ photo track — a glance, not the detailed roadmap. ── --}}
  <li class="ns-plist__item">
    <a href="{{url}}" class="ns-plist__row">
      <span class="ns-plist__num">{{n}}</span>
      <span class="ns-plist__main">
        <span class="ns-plist__title">{{title}}</span>
        <span class="ns-plist__meta">
          {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}{{> icons name="stack"}}{{pagination.total}} {{t "lessons"}}{{/get}}
        </span>
      </span>
      {{> icons name="caret-right" class="ns-plist__arrow"}}
    </a>
  </li>
{{/match}}

{{#match view "search"}}
  {{!-- ── One section row in the training search results ── --}}
  <a href="{{url}}" data-t="{{title}}"
     x-show="$el.dataset.t.toLowerCase().includes(q.trim().toLowerCase())"
     class="flex items-center gap-2.5 rounded-btn px-2.5 py-2 text-sm transition hover:bg-surface-sunken">
    {{> icons name="steps" class="shrink-0 text-brand-500"}}
    <span class="min-w-0 flex-1 truncate font-semibold text-ink">{{title}}</span>
    <span class="ns-badge shrink-0">{{t "Section"}}</span>
  </a>
{{/match}}

{{!-- ── JSON-LD: a bare @id reference, for the training's hasPart array.
     `first` suppresses the leading comma. ── --}}
{{#match view "jsonld-ref"}}{{#unless first}},{{/unless}}{ "@id": "{{url absolute="true"}}#section" }{{/match}}

{{!-- ── JSON-LD: the section's full node, with its lessons. Always leads with
     a comma — it always follows the training's Course node. ── --}}
{{#match view "jsonld"}},{
  "@type": "Course",
  "@id": "{{url absolute="true"}}#section",
  "name": "{{title}}",
  {{#if custom_excerpt}}"description": "{{custom_excerpt}}",{{/if}}
  "url": "{{url absolute="true"}}",
  {{#if primary_tag.feature_image}}"image": "{{primary_tag.feature_image}}",{{else}}{{#if feature_image}}"image": "{{feature_image}}",{{/if}}{{/if}}
  "position": {{n}},
  "provider": { "@id": "{{@site.url}}/#owner" },
  "inLanguage": "{{@site.locale}}",
  "isPartOf": { "@id": "{{@site.url}}/training/#course" },
  "hasCourseInstance": { "@type": "CourseInstance", "courseMode": "online" },
  "hasPart": [
    {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
      {{#foreach posts}}{{#unless @first}},{{/unless}}{
        "@type": "LearningResource",
        "@id": "{{url absolute="true"}}#lesson",
        "name": "{{title}}",
        "url": "{{url absolute="true"}}",
        "position": {{@number}},
        "learningResourceType": "{{#has tag="#training-video"}}Video{{else has tag="#training-exercise"}}Exercise{{else has tag="#training-quiz"}}Quiz{{else}}Article{{/has}}",
        {{#if feature_image}}"image": "{{feature_image}}",{{/if}}
        "timeRequired": "PT{{reading_time minute="1" minutes="%"}}M",
        "isAccessibleForFree": {{#has visibility="public"}}true{{else}}false{{/has}}
      }{{/foreach}}
    {{/get}}
  ]
}{{/match}}

{{#match view "nav"}}
  {{!-- One MODULE in the rail — NSDS's `.ns-trainingnav__module`, a native
       <details>. It ships OPEN; nsds/training.js closes the ones that do not
       hold aria-current="page" and scrolls the open one into view.

       The theme's version used `name=` to make these an exclusive accordion,
       which the system deliberately does not do: closing the module you just
       navigated out of loses your place in a long curriculum.

       The count on the summary is the section's post count — a module row that
       does not say how big it is makes you open it to find out. --}}
  <details class="ns-trainingnav__module" data-sec="{{slug}}" open>
    <summary>
      {{> icons name="caret-right" class="ns-trainingnav__twist"}}
      {{title}}
      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
        <span class="ns-trainingnav__count">{{pagination.total}}</span>
      {{/get}}
    </summary>

    <ul class="ns-trainingnav__list">
      {{!-- The section's own page is the first row — its overview. Active when
           this is the current section AND no lesson is open. --}}
      <li><a class="ns-trainingnav__link" href="{{url}}" data-title="{{title}} overview"
             {{#unless curId}}{{#match cur slug}}aria-current="page"{{/match}}{{/unless}}>
        {{> icons name="squares-four" class="ns-trainingnav__icon"}}
        <span>{{t "Overview"}}</span>
      </a></li>

      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" include="tags" order="published_at asc" limit="50"}}
        {{#foreach posts}}
          {{!-- data-state is written as a whole attribute inside the block,
               not as a value containing {{^has visibility="public"}}: the
               inner quotes around "public" would close the attribute and Ghost
               reads the rest as unknown helpers. --}}
          <li><a class="ns-trainingnav__link" href="{{url}}" data-title="{{title}}"
                 {{^has visibility="public"}}data-state="locked"{{/has}}
                 {{#match id ../../curId}}aria-current="page"{{/match}}>
            {{#has tag="#training-video"}}{{> icons name="video" class="ns-trainingnav__icon"}}
            {{else has tag="#training-exercise"}}{{> icons name="flask" class="ns-trainingnav__icon"}}
            {{else has tag="#training-quiz"}}{{> icons name="exam" class="ns-trainingnav__icon"}}
            {{else}}{{> icons name="article" class="ns-trainingnav__icon"}}{{/has}}
            <span>{{title}}</span>
            <span class="ns-trainingnav__time">{{^has visibility="public"}}{{> icons name="lock"}}{{else}}{{reading_time minute="1m" minutes="%m"}}{{/has}}</span>
          </a></li>
        {{/foreach}}
      {{/get}}
    </ul>
  </details>
{{/match}}
