{{!-- ════════════════════════════════════════════════════════════════════════
  training/search.hbs — search scoped to TRAINING only.

  Searches two things and nothing else:
    • Training sections (→ /training/{section}/)
    • Lessons          (#training-content posts)

  It deliberately does NOT search the site's tags: a generic tag archive is
  never the answer to "where do I learn X", and course/blog/doc hits would
  drown the training results. Sections link to their section page.

  Hidden until the hero's magnifier toggles `open`, so the hero stays a
  headline + one action.

  Client-side, no index to build and nothing to keep in sync: every result is
  rendered as a real <a data-t="…"> and Alpine just hides the ones that don't
  match — the same pattern as the curriculum sidebar's filter. That keeps it
  working without JS too (the panel is simply always-hidden until you type).
═══════════════════════════════════════════════════════════════════════════ --}}
{{!-- Scope (open + q) comes from the hero's x-data — this partial deliberately
     declares none, so the toggle button and this panel share one state. --}}
<div id="training-search" x-show="open" x-cloak x-transition.opacity class="relative mt-3 max-w-md">

  <label class="relative block">
    <i class="ph ph-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-muted" aria-hidden="true"></i>
    <input x-model="q" type="search" autocomplete="off"
           placeholder="{{t "Search sections and lessons…"}}" aria-label="{{t "Search training"}}"
           class="w-full rounded-pill border border-border bg-surface-raised py-2.5 pl-10 pr-4 text-sm text-ink shadow-card placeholder:text-muted focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20">
  </label>

  {{!-- results: only once there's something worth matching on --}}
  <div x-show="q.trim().length > 1"
       class="absolute left-0 right-0 z-30 mt-2 max-h-80 overflow-y-auto rounded-card border border-border bg-surface-raised p-1.5 text-left shadow-raised">

    {{!-- Sections. Listed via the ordered partial because their slugs are
         clean — there's no filter that means "is a training section". --}}
    {{> "training/sections" view="search"}}

    {{#get "posts" filter="tag:hash-training-content" order="published_at asc" limit="100"}}
      {{#foreach posts}}
        <a href="{{url}}" data-t="{{title}}"
           x-show="$el.dataset.t.toLowerCase().includes(q.trim().toLowerCase())"
           class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition hover:bg-surface-sunken">
          <i class="{{#has tag="#training-type-video"}}ph-fill ph-video-camera{{else has tag="#training-type-exercise"}}ph-fill ph-barbell{{else has tag="#training-type-quiz"}}ph-fill ph-exam{{else}}ph ph-file-text{{/has}} shrink-0 text-muted" aria-hidden="true"></i>
          <span class="min-w-0 flex-1 truncate text-muted">{{title}}</span>
          {{^has visibility="public"}}
            <i class="ph-fill {{#has visibility="paid"}}ph-crown-simple{{else}}ph-lock-simple{{/has}} shrink-0 text-xs text-muted" aria-hidden="true"></i>
          {{/has}}
        </a>
      {{/foreach}}
    {{/get}}

    <p x-show="![...$el.parentElement.querySelectorAll('a[data-t]')].some(a => a.dataset.t.toLowerCase().includes(q.trim().toLowerCase()))"
       class="px-2.5 py-3 text-center text-sm text-muted">{{t "Nothing in training matches that."}}</p>
  </div>
</div>
