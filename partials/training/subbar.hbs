{{!-- training/subbar.hbs — the bar under the site header.

     It carries THREE things, and it is the only place any of them appear:

       1. the breadcrumb — once, here, never again above the title
       2. the "Training content" button, which opens the rail as a panel on
          EVERY screen size (on desktop the rail is already visible, but the
          panel is also where the search lives)
       3. how far through the training you are

     Params: section    — the section title
             sectionUrl — its URL, so the crumb can link to it
             lesson     — the lesson title (omitted on a section overview) --}}
<div class="ns-subbar">
  <div class="ns-subbar__inner">

    {{!-- The one breadcrumb on the page. --}}
    <nav class="ns-crumbs ns-crumbs--sm" aria-label="{{t "Breadcrumb"}}">
      <a class="ns-crumbs__link" href="/"><i class="ph ph-house" aria-hidden="true"></i></a>
      <i class="ns-crumbs__sep ph ph-caret-right" aria-hidden="true"></i>
      <a class="ns-crumbs__link" href="/training/"><i class="ph ph-flow-arrow" aria-hidden="true"></i>{{t "Training"}}</a>
      {{#if section}}
        <i class="ns-crumbs__sep ph ph-caret-right" aria-hidden="true"></i>
        {{#if lesson}}
          <a class="ns-crumbs__link" href="{{sectionUrl}}">{{section}}</a>
          <i class="ns-crumbs__sep ph ph-caret-right" aria-hidden="true"></i>
          <span class="ns-crumbs__current"><span>{{lesson}}</span></span>
        {{else}}
          <span class="ns-crumbs__current"><span>{{section}}</span></span>
        {{/if}}
      {{/if}}
    </nav>

    <div class="ns-subbar__progress">
      <div class="ns-progress ns-progress--xs">
        <span class="ns-progress__bar js-train-progress"></span>
      </div>
      <span class="ns-subbar__readout js-train-done"></span>
    </div>

    <button type="button" class="ns-btn ns-btn--outline ns-btn--xs ns-subbar__action"
            @click="$store.lessonNav.open = true" aria-controls="training-curriculum">
      <i class="ph ph-list" aria-hidden="true"></i>{{t "Training content"}}
    </button>

  </div>
</div>
