{{!-- training/subbar.hbs — the bar under the site header.

     Names what you are inside and how far through it you are, and on small
     screens it is the way into the section rail. This used to sit at the top
     of the rail itself, where it was repeated on every page and pushed the
     actual navigation down — see 2-components/subbar.css.

     Param: section — the section title to show after the training name. --}}
<div class="ns-subbar">
  <div class="ns-subbar__inner">
    <a href="/training/" class="ns-subbar__title">
      <i class="ph-fill ph-flow-arrow" aria-hidden="true"></i>{{t "Salesforce training"}}
    </a>
    {{#if section}}
      <i class="ns-subbar__sep ph ph-caret-right" aria-hidden="true"></i>
      <span class="ns-subbar__section">{{section}}</span>
    {{/if}}

    <div class="ns-subbar__progress">
      <div class="ns-progress ns-progress--xs">
        <span class="ns-progress__bar js-train-progress"></span>
      </div>
      <span class="ns-subbar__readout js-train-done"></span>
    </div>

    <button type="button" class="icon-btn icon-btn--sm ns-subbar__action ns-subbar__action--drawer"
            @click="$store.lessonNav.open = true" aria-label="{{t "Open the section list"}}">
      <i class="ph ph-list" aria-hidden="true"></i>
    </button>
  </div>
</div>
