{{!-- ══════════════════════════════════════════════════════════════════════
     training/people — who wrote it. From Ghost's authors, not from copy.
     Ported from NS-Design-System/templates/training-index.html §06.
     ------------------------------------------------------------------------
     Upstream's note: the COUNT is the fact that says the curriculum is
     maintained rather than dumped. So the count is read from Ghost per author
     — a hand-typed one would be a claim about maintenance that stops being
     true the moment it stops being edited, which is the exact opposite of
     what it is there to prove.

     The band hides itself entirely when there are no authors with posts,
     which on a fresh install is the honest state.
     ══════════════════════════════════════════════════════════════════════ --}}
{{#get "authors" limit="6" include="count.posts" as |people|}}
    {{#if people}}
        <section class="ns-band">
            <div class="ns-band__inner">
                <header class="ns-band__head">
                    <span class="ns-kicker">{{t "Who wrote it"}}</span>
                    <h2 class="ns-band__title">{{t "Written by people who use it"}}</h2>
                </header>

                <div class="ns-grid">
                    {{#foreach people}}
                        <a class="ns-trackcard" href="{{url}}">
                            <span class="ns-trackcard__head">
                                <span class="ns-trackcard__icon">{{> "icons/user-circle"}}</span>
                                <span class="ns-trackcard__index">{{count.posts}}</span>
                            </span>
                            <span class="ns-trackcard__title">{{name}}</span>
                            {{#if bio}}<span class="ns-trackcard__text">{{bio}}</span>{{/if}}
                            <span class="ns-trackcard__meta"><span>{{count.posts}} {{t "posts"}}</span></span>
                        </a>
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}
