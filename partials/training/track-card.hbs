{{!-- training/track-card.hbs — roadmap track card with its first modules.
     Context: a #training (track) post. Queries #training-content modules whose
     primary tag matches this track's slug. --}}
<div class="js-spotlight group relative flex h-full flex-col overflow-hidden rounded-card border border-border bg-surface-raised shadow-card transition hover:-translate-y-1 hover:shadow-raised">

  <div class="bg-gradient-to-br from-brand-600 to-brand-800 p-5 text-white">
    <h3 class="font-heading text-lg font-bold leading-snug">{{title}}</h3>
    <div class="mt-2 flex flex-wrap gap-2 text-xs">
      {{#if primary_tag}}<span class="rounded-pill bg-white/15 px-2.5 py-0.5 font-semibold">{{primary_tag.name}}</span>{{/if}}
      <span class="rounded-pill bg-black/20 px-2.5 py-0.5">{{reading_time minute="1 min" minutes="% mins"}} {{t "total"}}</span>
    </div>
  </div>

  {{#primary_author}}
    <div class="flex items-center gap-2 border-b border-border px-4 py-3">
      {{#if profile_image}}
        <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="h-8 w-8 rounded-full object-cover">
      {{else}}
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-500/10 text-brand-600"><i class="ph ph-user" aria-hidden="true"></i></span>
      {{/if}}
      <div>
        <p class="text-sm font-semibold">{{name}}</p>
        {{#if location}}<p class="text-xs text-muted">{{location}}</p>{{/if}}
      </div>
    </div>
  {{/primary_author}}

  <div class="flex flex-1 flex-col p-4">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Modules"}}</p>
    {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="4"}}
      {{#if posts}}
        <ul class="space-y-0.5">
          {{#foreach posts}}
            <li>
              <a href="{{url}}" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-300">
                <i class="ph-fill ph-play-circle shrink-0 text-brand-500" aria-hidden="true"></i>
                <span class="line-clamp-1 flex-1">{{title}}</span>
                <span class="shrink-0 text-xs">{{reading_time minute="1m" minutes="%m"}}</span>
              </a>
            </li>
          {{/foreach}}
        </ul>
        <a href="{{../url}}" class="mt-2 block rounded-md bg-surface-sunken px-2 py-1.5 text-center text-sm font-semibold text-brand-600 transition hover:bg-brand-500/10 dark:text-brand-300">{{t "View full curriculum →"}}</a>
      {{else}}
        <p class="text-sm italic text-muted">{{t "Lessons coming soon."}}</p>
      {{/if}}
    {{/get}}

    <a href="{{url}}" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-pill bg-brand-500 px-4 py-2.5 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">
      {{t "Start track"}}<i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  </div>
</div>
