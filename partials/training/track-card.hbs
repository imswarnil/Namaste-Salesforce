{{!-- training/track-card.hbs — one roadmap track as a clean "path stage" card.
     Context: a #training post inside {{#foreach posts}} (@number = stage).
     Feature image on top when set · corner border accents · a big low-opacity
     stage number bleeding half into the card · module preview + CTA.
     Reveals on scroll (.js-reveal). --}}
<article class="js-reveal group relative flex flex-col overflow-hidden rounded-card border border-border bg-surface-raised shadow-card transition hover:-translate-y-1 hover:border-brand-400 hover:shadow-raised">

  {{!-- corner accents (top-left / bottom-right brackets) --}}
  <span aria-hidden="true" class="pointer-events-none absolute left-0 top-0 z-10 h-7 w-7 rounded-tl-card border-l-2 border-t-2 border-brand-500/70 transition-all group-hover:h-9 group-hover:w-9"></span>
  <span aria-hidden="true" class="pointer-events-none absolute bottom-0 right-0 z-10 h-7 w-7 rounded-br-card border-b-2 border-r-2 border-brand-500/70 transition-all group-hover:h-9 group-hover:w-9"></span>

  {{#if feature_image}}
    <div class="relative aspect-[16/9] overflow-hidden bg-surface-sunken">
      <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy"
           class="h-full w-full object-cover saturate-[0.8] transition duration-300 group-hover:scale-105 group-hover:saturate-100">
      {{!-- brand tint so any image sits in the site's palette --}}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-brand-800/50 via-brand-500/15 to-transparent mix-blend-multiply"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-brand-500/10"></div>
    </div>
  {{/if}}

  <div class="relative flex flex-1 flex-col p-6">
    {{!-- big stage number, half inside the card --}}
    <span aria-hidden="true" class="pointer-events-none absolute -top-6 right-2 z-0 select-none font-heading text-[7rem] font-extrabold leading-none text-brand-500/10 dark:text-brand-300/10">{{@number}}</span>

    <p class="relative text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Stage"}} {{@number}}{{#if primary_tag}} · <span class="text-brand-600 dark:text-brand-300">{{primary_tag.name}}</span>{{/if}}</p>

    <h3 class="relative mt-2 font-heading text-xl font-bold leading-snug">
      <a href="{{url}}" class="transition-colors before:absolute before:inset-0 hover:text-brand-600 dark:hover:text-brand-300">{{title}}</a>
    </h3>
    <p class="relative mt-1.5 line-clamp-2 text-sm text-muted">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="24"}}&hellip;{{/if}}</p>

    {{!-- meta --}}
    <div class="relative mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
      {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" limit="1"}}<span class="inline-flex items-center gap-1.5"><i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "modules"}}</span>{{/get}}
      <span class="inline-flex items-center gap-1.5"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min" minutes="% mins"}}</span>
    </div>

    {{!-- module preview --}}
    {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" order="published_at asc" limit="3"}}
      {{#if posts}}
        <ul class="relative z-10 mt-4 space-y-1 border-t border-border pt-4">
          {{#foreach posts}}
            <li><a href="{{url}}" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-300"><i class="ph-fill ph-play-circle shrink-0 text-brand-500" aria-hidden="true"></i><span class="line-clamp-1">{{title}}</span></a></li>
          {{/foreach}}
        </ul>
      {{/if}}
    {{/get}}

    <span class="relative mt-5 inline-flex items-center gap-1.5 self-start text-sm font-bold text-brand-600 transition-all group-hover:gap-2.5 dark:text-brand-300">{{t "Start this stage"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
  </div>
</article>
