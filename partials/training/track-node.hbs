{{!-- training/track-node.hbs — one numbered timeline node for a training.
     Context: a #training post inside {{#foreach posts}} (uses @number). Reveals
     on scroll (.js-reveal). Queries the track's first #training-content modules. --}}
<li class="js-reveal relative flex gap-4 sm:gap-6">
  <div class="ns-step-num">{{@number}}</div>
  <div class="min-w-0 flex-1 pb-10">
    <div class="rounded-card border border-border bg-surface-raised p-5 shadow-card transition hover:shadow-raised sm:p-6">
      <div class="flex flex-wrap items-center gap-2">
        {{#if primary_tag}}<span class="rounded-pill bg-brand-500/10 px-2.5 py-0.5 text-xs font-semibold text-brand-600 dark:text-brand-300">{{primary_tag.name}}</span>{{/if}}
        <span class="inline-flex items-center gap-1 text-xs text-muted"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min" minutes="% mins"}}</span>
      </div>
      <h3 class="mt-2 font-heading text-xl font-bold leading-snug">{{title}}</h3>
      <p class="mt-1 text-sm text-muted">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="22"}}&hellip;{{/if}}</p>

      {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="4"}}
        {{#if posts}}
          <ul class="mt-4 space-y-0.5">
            {{#foreach posts}}
              <li><a href="{{url}}" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-300"><i class="ph-fill ph-play-circle shrink-0 text-brand-500" aria-hidden="true"></i><span class="line-clamp-1">{{title}}</span></a></li>
            {{/foreach}}
          </ul>
        {{/if}}
      {{/get}}

      <a href="{{url}}" class="mt-4 inline-flex items-center gap-2 rounded-pill bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "Start track"}}{{> "icons/arrow-right" class="h-4 w-4"}}</a>
    </div>
  </div>
</li>
