{{!-- ════════════════════════════════════════════════════════════════════════
  training/hero-trail.hbs — the /training/ hero artwork.

  A four-stop trail — Start → Admin → Development → Analytics — that RESOLVES
  into the credential: when the walker reaches the end, the whole trail gathers
  into a square certificate frame, which then travels back to the start,
  rounding into the dot the next run begins from. The loop is the promise: the
  path becomes the certification, and the certification is where you start.

  Each craft stop carries a minimal screen of the work itself — a Flow canvas,
  an Apex editor, a dashboard. Deliberately few marks each: at this size detail
  turns to noise. Screens and labels always sit on OPPOSITE sides of the line
  (screen below → label above, and vice versa), so neither crowds the route.

  How it works, so it stays fixable:
    • the route is ONE cubic path, reused three times — dotted base, blue
      progress (pathLength="100" → dashoffset is a plain percentage), and the
      walker's `offset-path`. Change `d` and you MUST change all three.
    • `.journey` wraps route + stops + walker so ONE opacity keyframe fades the
      whole trail as the certificate forms; the children keep their own
      animations underneath (opacity multiplies).
    • the square→circle morph animates the rect's `rx` (a real animatable CSS
      property on SVG rects), so the frame genuinely rounds into a dot rather
      than cross-fading with a decoy circle.
    • stop delays match the walker's arrival (14s loop; stops ≈1.4s apart).

  Role tokens only → flips in dark mode; the tick uses --color-success, the one
  place green belongs. Decorative → aria-hidden (stop names are real text in
  the hero copy).
═══════════════════════════════════════════════════════════════════════════ --}}
<svg viewBox="0 0 700 260" fill="none" xmlns="http://www.w3.org/2000/svg"
     class="ns-trail h-auto w-full" aria-hidden="true" focusable="false">
  <style>
    /* the trail, as one unit, so it can hand over to the certificate */
    .ns-trail .journey { animation: nsJourney 14s ease-in-out infinite both; }
    .ns-trail .route-fill { stroke-dasharray: 100; stroke-dashoffset: 100;
      animation: nsDraw 14s cubic-bezier(0.45,0,0.55,1) infinite both; }
    .ns-trail .walker { offset-path: path("M30 200 C 80 200, 100 178, 170 170 S 270 152, 330 132 S 420 108, 480 92 S 570 70, 620 58");
      offset-rotate: 0deg; animation: nsWalk 14s cubic-bezier(0.45,0,0.55,1) infinite both; }
    .ns-trail .stop   { opacity: 0; animation: nsStop 14s ease-out infinite both; }
    .ns-trail .stop-2 { animation-delay: 1.4s; }
    .ns-trail .stop-3 { animation-delay: 2.8s; }
    .ns-trail .stop-4 { animation-delay: 4.2s; }
    .ns-trail .halo { animation: nsHalo 2.2s ease-in-out infinite both; transform-origin: center; }

    /* the certificate: forms at the end, then walks home and becomes the dot */
    .ns-trail .cert { transform-box: fill-box; transform-origin: center;
      animation: nsCert 14s cubic-bezier(0.65,0,0.35,1) infinite both; }
    .ns-trail .cert-frame { animation: nsCertShape 14s cubic-bezier(0.65,0,0.35,1) infinite both; }
    .ns-trail .cert-ink   { animation: nsCertInk 14s ease-out infinite both; }

    @keyframes nsJourney { 0%, 38% { opacity: 1; } 44%, 93% { opacity: 0; } 97%, 100% { opacity: 1; } }
    @keyframes nsDraw    { 0% { stroke-dashoffset: 100; } 38%, 44% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes nsWalk    { 0% { offset-distance: 0%; } 38%, 44% { offset-distance: 100%; } 100% { offset-distance: 0%; } }
    @keyframes nsStop    { 0% { opacity: 0; } 3%, 40% { opacity: 1; } 48%, 100% { opacity: 0; } }
    @keyframes nsHalo    { 0%, 100% { transform: scale(1); opacity: 0.18; } 50% { transform: scale(1.5); opacity: 0.05; } }

    /* travels from the trail's end (620,58) to its start (30,200) */
    /* Three beats, each eased separately by the cubic-bezier on .cert:
         forms at the last node (620,58) → swings to CENTRE (350,130) at 1.6x,
         where it's held big and legible → then runs to the start (30,200),
         shrinking to the dot the next lap begins from.
       Offsets are deltas from the rect's authored centre (620,58). */
    @keyframes nsCert {
      0%,  38%  { opacity: 0; transform: translate(0,0) scale(0.25); }
      44%, 48%  { opacity: 1; transform: translate(0,0) scale(1); }
      58%, 74%  { opacity: 1; transform: translate(-270px, 72px) scale(1.6); }
      86%, 93%  { opacity: 1; transform: translate(-590px, 142px) scale(0.09); }
      97%, 100% { opacity: 0; transform: translate(-590px, 142px) scale(0.09); }
    }
    /* square while it's a certificate; a circle by the time it's the dot */
    @keyframes nsCertShape { 0%, 74% { rx: 10px; } 86%, 100% { rx: 55px; } }
    /* the text can't survive being shrunk to a dot — drop it before the trip */
    @keyframes nsCertInk { 0%, 40% { opacity: 0; } 46%, 76% { opacity: 1; } 82%, 100% { opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
      .ns-trail .journey, .ns-trail .stop, .ns-trail .halo { animation: none; opacity: 1; }
      .ns-trail .route-fill { animation: none; stroke-dashoffset: 0; }
      .ns-trail .walker { animation: none; offset-distance: 100%; }
      /* settle showing the credential, in place, legible */
      .ns-trail .cert { animation: none; opacity: 1; transform: none; }
      .ns-trail .cert-frame { animation: none; }
      .ns-trail .cert-ink { animation: none; opacity: 1; }
    }
  </style>

  <g class="journey">
    {{!-- the route, unwalked --}}
    <path d="M30 200 C 80 200, 100 178, 170 170 S 270 152, 330 132 S 420 108, 480 92 S 570 70, 620 58"
          class="stroke-border" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 7"/>
    {{!-- the route, walked --}}
    <path d="M30 200 C 80 200, 100 178, 170 170 S 270 152, 330 132 S 420 108, 480 92 S 570 70, 620 58"
          pathLength="100" class="route-fill stroke-brand-500" stroke-width="2.5" stroke-linecap="round"/>

    {{!-- ═══ 1 · Start ═══ --}}
    <g class="stop stop-1">
      <path d="M30 200 v-18" class="stroke-brand-500" stroke-width="1.5"/>
      <path d="M30 182 h12 l-3 4 3 4 h-12 z" class="fill-brand-500"/>
      <circle cx="30" cy="200" r="5" class="fill-brand-500"/>
      <text x="30" y="224" text-anchor="middle" class="fill-muted" font-size="11" font-weight="700">Start</text>
    </g>

    {{!-- ═══ 2 · Admin — a Flow canvas ═══
         Screen BELOW the line, so the label goes ABOVE it. Minimal: a start
         node, one decision, two branches — enough to read as Flow, no more. --}}
    <g class="stop stop-2">
      <path d="M170 170 v14" class="stroke-border" stroke-width="1" stroke-dasharray="2 3"/>
      <rect x="140" y="184" width="60" height="38" rx="4" class="fill-surface-raised stroke-border"/>
      <path d="M140 192 h60" class="stroke-border" stroke-width="1"/>
      <circle cx="145" cy="188" r="1.1" class="fill-muted" opacity="0.5"/>
      <circle cx="151" cy="203" r="3" class="fill-brand-500"/>
      <path d="M154 203 h9" class="stroke-brand-500" stroke-width="1.2"/>
      <path d="M168 203 l4 -4 4 4 -4 4 z" class="fill-surface stroke-brand-500" stroke-width="1.2"/>
      <path d="M176 203 h8" class="stroke-brand-500" stroke-width="1.2" opacity="0.6"/>
      <rect x="184" y="200" width="9" height="6" rx="2" class="fill-brand-500" opacity="0.5"/>
      <circle cx="170" cy="170" r="5" class="fill-surface stroke-brand-500" stroke-width="2"/>
      <text x="170" y="157" text-anchor="middle" class="fill-muted" font-size="11" font-weight="700">Admin</text>
    </g>

    {{!-- ═══ 3 · Development — an Apex editor ═══
         Screen ABOVE the line, so the label goes BELOW it. --}}
    <g class="stop stop-3">
      <path d="M330 132 v-14" class="stroke-border" stroke-width="1" stroke-dasharray="2 3"/>
      <rect x="300" y="80" width="60" height="38" rx="4" class="fill-brand-900"/>
      <path d="M300 88 h60" class="stroke-brand-700" stroke-width="1"/>
      <circle cx="305" cy="84" r="1.1" fill="#fff" opacity="0.35"/>
      <rect x="306" y="96" width="12" height="2.5" rx="1.25" class="fill-brand-300"/>
      <rect x="321" y="96" width="20" height="2.5" rx="1.25" fill="#fff" opacity="0.35"/>
      <rect x="311" y="104" width="26" height="2.5" rx="1.25" fill="#fff" opacity="0.2"/>
      <rect x="306" y="112" width="9" height="2.5" rx="1.25" class="fill-brand-300"/>
      <circle cx="330" cy="132" r="5" class="fill-surface stroke-brand-500" stroke-width="2"/>
      <text x="330" y="150" text-anchor="middle" class="fill-muted" font-size="11" font-weight="700">Development</text>
    </g>

    {{!-- ═══ 4 · Analytics — a dashboard ═══
         Screen BELOW the line, so the label goes ABOVE it. --}}
    <g class="stop stop-4">
      <path d="M480 92 v14" class="stroke-border" stroke-width="1" stroke-dasharray="2 3"/>
      <rect x="450" y="106" width="60" height="38" rx="4" class="fill-surface-raised stroke-border"/>
      <path d="M450 114 h60" class="stroke-border" stroke-width="1"/>
      <circle cx="455" cy="110" r="1.1" class="fill-muted" opacity="0.5"/>
      <rect x="457" y="130" width="5" height="8"  rx="1" class="fill-brand-500" opacity="0.35"/>
      <rect x="465" y="125" width="5" height="13" rx="1" class="fill-brand-500" opacity="0.6"/>
      <rect x="473" y="120" width="5" height="18" rx="1" class="fill-brand-500"/>
      <circle cx="495" cy="128" r="7" class="stroke-border" stroke-width="3" fill="none"/>
      <path d="M495 121 a7 7 0 0 1 6 10.4" class="stroke-brand-500" stroke-width="3" fill="none" stroke-linecap="round"/>
      <circle cx="480" cy="92" r="5" class="fill-surface stroke-brand-500" stroke-width="2"/>
      <text x="480" y="79" text-anchor="middle" class="fill-muted" font-size="11" font-weight="700">Analytics</text>
    </g>

    {{!-- the walker --}}
    <g class="walker">
      <circle r="10" class="halo fill-brand-500"/>
      <circle r="5" class="fill-surface stroke-brand-500" stroke-width="2"/>
      <circle r="2.2" class="fill-brand-500"/>
    </g>
  </g>

  {{!-- ═══ the credential the trail becomes ═══ --}}
  <g class="cert">
    <rect class="cert-frame fill-surface stroke-brand-500" x="565" y="3" width="110" height="110" rx="10" stroke-width="2"/>
    <g class="cert-ink">
      <rect x="574" y="12" width="92" height="92" rx="5" class="stroke-border" stroke-width="1" fill="none"/>
      <text x="620" y="42" text-anchor="middle" class="fill-muted" font-size="7" font-weight="800" letter-spacing="0.14em">CERTIFIED</text>
      <text x="620" y="58" text-anchor="middle" class="fill-ink" font-size="10" font-weight="800">Salesforce</text>
      <text x="620" y="70" text-anchor="middle" class="fill-ink" font-size="10" font-weight="800">Engineer</text>
      <circle cx="620" cy="90" r="10" class="fill-success" opacity="0.14"/>
      <circle cx="620" cy="90" r="7" class="fill-success"/>
      <path d="M617 90l2 2 4-4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </g>
  </g>
</svg>
