{{!-- ══════════════════════════════════════════════════════════════════════
     training/modules — THE CURRICULUM. Entirely from Ghost.
     ------------------------------------------------------------------------
     This is the band that must never contain content. A module is a POST
     tagged #training-module whose PRIMARY tag is the module tag; a lesson is
     a POST tagged #training-lesson whose primary tag is its MODULE's tag.
     That inheritance is the whole nesting trick, and it is why the lesson
     filter below can pair the module's own primary tag with the lesson tag.

     Adding a module is Ghost-Admin-only: make the tag, write the post with a
     matching slug, publish. Order is published_at asc — backdate to reorder.
     The full spec is abstract/01-content-model.md.

     ⚠ `hash-training-module`, NOT `#training-module`. In a FILTER STRING
     Ghost writes an internal tag with a `hash-` prefix. `tag:#training-module`
     matches nothing, silently — and an empty curriculum is indistinguishable
     from one nobody has written yet.

     ⚠ A NUMBER, NOT limit="all". Ghost's {{#get}} does not support "all":
     gscan warns and the helper falls back to 15, which silently truncates.
     Raise these if a real curriculum ever reaches them.
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="ns-band" id="modules">
    <div class="ns-band__inner">
        <header class="ns-band__head ns-band__head--between">
            <div>
                <span class="ns-kicker">{{t "The curriculum"}}</span>
                <h2 class="ns-band__title">{{t "Modules, in order"}}</h2>
                <p class="ns-band__lede">{{t "Each module ends where the next begins. Start at the top if you are new; jump in if you are not."}}</p>
            </div>
        </header>

        {{#get "posts" filter="tag:[hash-training-module,hash-training-section]" order="published_at asc" limit="50" include="tags" as |modules|}}
            {{#if modules}}
                <ol class="ns-modules">
                    {{#foreach modules}}
                        <li class="ns-module">
                            <span class="ns-module__node" aria-hidden="true">{{@number}}</span>
                            <a class="ns-module__card" href="{{url}}">
                                <div class="ns-module__head">
                                    <span class="ns-module__title">{{title}}</span>
                                    <span class="ns-module__meta">{{reading_time}}</span>
                                </div>
                                {{#if custom_excerpt}}<p class="ns-module__text">{{custom_excerpt}}</p>{{/if}}
                            </a>

                            {{!-- `{{primary_tag.slug}}` is dotted PROPERTY access,
                                 which is safe here. Calling a Ghost HELPER across
                                 `../` inside a nested get is what 500s the page —
                                 see abstract/01-content-model.md. --}}
                            {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:[hash-training-lesson,hash-training-content]" order="published_at asc" limit="100" as |lessons|}}
                                {{#if lessons}}
                                    <ul class="ns-units">
                                        {{#foreach lessons}}
                                            <li><a class="ns-unit" href="{{url}}">
                                                <span class="ns-unit__check" aria-hidden="true">{{> "icons/circle"}}</span>
                                                <span class="ns-unit__title">{{title}}</span>
                                                <span class="ns-unit__time">{{reading_time}}</span>
                                            </a></li>
                                        {{/foreach}}
                                    </ul>
                                {{/if}}
                            {{/get}}
                        </li>
                    {{/foreach}}
                </ol>
            {{else}}
                {{> "empty" title=(t "No modules published yet")}}
            {{/if}}
        {{/get}}
    </div>
</section>
