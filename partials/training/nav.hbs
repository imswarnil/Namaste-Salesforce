{{!-- ══════════════════════════════════════════════════════════════════════
     training/nav — the curriculum rail, in full.
     Ported from NS-Design-System/preview/demo-training-post.html.
     ------------------------------------------------------------------------
     Shared by the module page and the lesson page. It works for both without
     a parameter because of the content model rather than a flag: on a MODULE
     page `primary_tag` is the module's own tag, and on a LESSON page it is
     its module's tag. Same value either way, so "which section is open" is
     one comparison on both pages and the two cannot drift.

     ⚠ `../../primary_tag.slug`, AND THE DEPTH IS MEASURED, NOT GUESSED.
     {{#get}} and {{#foreach}} each push a frame, so the POST is two levels up.
     Rendered with all three printed:

         [me=foundations  up1=(empty)  up2=foundations]

     `../` lands on the {{#get}} frame, which has no primary_tag, so it
     renders EMPTY — and an empty string never matches a slug. Nothing errors
     and nothing warns; the rail just silently never opens the section you are
     reading. That is the whole failure mode, which is why the measurement is
     written down.

     Dotted PROPERTY access across `../` is safe. Calling a HELPER across
     `../` is what throws and 500s the page.

     ── THE FOUR ROWS ARE REQUIRED, NOT DECORATION ───────────────────────────
     Inside .ns-training--doc the rail is a GRID:

         grid-template-rows: auto minmax(0, 1fr) auto auto;
                             head  scrolling list  foot  watermark

     so its children are ROWS. Hand it a flat run of <details> and each lands
     in its own auto row: the second gets the `1fr` and stretches to fill the
     rail, and everything after is pushed off the bottom. Measured before the
     wrappers existed, two sections sat 680px apart in an empty column.

     ── THE CONTROLS ARE WIRED, NOT DECORATIVE ───────────────────────────────
     data-ns-trainingnav, -filter, -collapse, -close and -expand are all read
     by assets/js/0-vendor/training.js, which is vendored from upstream. The
     filter is CLIENT-SIDE over the rendered rows — it is not a search, and
     the magnifier beside it submits to the real one for that reason.

     ⚠ limit is a NUMBER, never "all" — {{#get}} does not support "all" and
     falls back to 15, silently truncating a curriculum.
     ══════════════════════════════════════════════════════════════════════ --}}
<nav class="ns-trainingnav" data-ns-trainingnav aria-label="{{t "Curriculum"}}">

    {{!-- Row 0 · the collapsed spine. Only visible once the rail is
         collapsed; it is what gets it back. --}}
    <div class="ns-trainingnav__spine">
        <button class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm ns-tooltip-host" type="button"
                aria-label="{{t "Open curriculum"}}" data-ns-training-expand>
            {{> "icons/caret-left"}}<span class="ns-tooltip">{{t "Open curriculum"}}</span>
        </button>
        <span class="ns-trainingnav__spine-label">{{t "Curriculum"}}</span>
    </div>

    {{!-- Row 1 · head — filter, search, collapse, close. --}}
    <div class="ns-trainingnav__head">
        {{!-- ⚠ NO data-ghost-search HERE. This is a LOCAL FILTER over the rows
             already rendered in the rail — assets/js/0-vendor/training.js reads
             data-ns-trainingnav-filter and hides non-matching rows in place.
             Ghost's Sodo Search binds to any element carrying
             data-ghost-search and opens its modal over the page, so putting it
             on this form meant typing one character threw the reader out of
             the lesson and into site-wide search. A filter and a search are
             two different controls; the magnifier beside it is the one that
             goes to site search. --}}
        <form class="ns-trainingnav__search" role="search" onsubmit="return false">
            <input class="ns-input" type="search" name="q" placeholder="{{t "Filter lessons"}}"
                   aria-label="{{t "Filter lessons"}}" data-ns-trainingnav-filter>
            <button class="ns-btn ns-btn--outline ns-btn--icon ns-btn--sm" type="button"
                    data-ghost-search aria-label="{{t "Search the whole site"}}">{{> "icons/magnifying-glass"}}</button>
            <button class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm ns-tooltip-host ns-trainingnav__collapse"
                    type="button" aria-label="{{t "Collapse curriculum"}}" data-ns-training-collapse>
                {{> "icons/caret-right"}}<span class="ns-tooltip">{{t "Collapse"}}</span>
            </button>
            <button class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm ns-tooltip-host ns-trainingnav__close"
                    type="button" aria-label="{{t "Close curriculum"}}" data-ns-training-close>
                {{> "icons/x"}}<span class="ns-tooltip">{{t "Close"}}</span>
            </button>
        </form>
        {{!-- The filter's live region. It has to exist BEFORE the count lands
             in it — a region created at the same moment as its message
             announces nothing. --}}
        <p class="ns-trainingnav__result" role="status" data-ns-trainingnav-result></p>
    </div>

    {{!-- Row 2 · the scrolling list. The only part that moves. --}}
    <div class="ns-trainingnav__scroll">
        {{#get "posts" filter="tag:hash-training-module" order="published_at asc" limit="50" include="tags" as |modules|}}
            {{#foreach modules}}
                <details class="ns-trainingnav__section"{{#match primary_tag.slug "=" ../../primary_tag.slug}} open{{/match}}>
                    <summary>
                        <span class="ns-trainingnav__twist" aria-hidden="true">{{> "icons/caret-right"}}</span>
                        <span class="ns-trainingnav__num">{{@number}}</span>
                        <span class="ns-trainingnav__section-icon">{{> "icons/books"}}</span>
                        <span class="ns-trainingnav__section-name">{{title}}</span>
                        {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-training-lesson" limit="1"}}<span class="ns-trainingnav__count">{{pagination.total}}</span>{{/get}}
                    </summary>

                    {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-training-lesson" order="published_at asc" limit="100" as |lessons|}}
                        {{!-- ⚠ THE METER READS ZERO AND THAT IS DELIBERATE.
                             Upstream fills it from the learner's read state,
                             which Ghost does not have — there is no per-member
                             progress on a post. A bar showing invented
                             progress is worse than an honest empty one, and
                             the max is real, so the row still says how long
                             the section is. --}}
                        <div class="ns-trainingnav__bar">
                            <progress class="ns-progress" value="0" max="{{lessons.length}}"
                                      aria-label="{{lessons.length}} {{t "lessons in this section"}}"></progress>
                        </div>

                        <ul class="ns-trainingnav__list">
                            <li><a class="ns-trainingnav__link" href="{{url}}">
                                <span class="ns-trainingnav__icon" aria-hidden="true">{{> "icons/book-open-text"}}</span>
                                <span>{{t "Overview"}}</span>
                            </a></li>
                            {{#foreach lessons}}
                                <li><a class="ns-trainingnav__link" href="{{url}}">
                                    <span class="ns-trainingnav__icon" aria-hidden="true">{{> "icons/article"}}</span>
                                    <span>{{title}}</span>
                                    <span class="ns-trainingnav__time">{{reading_time}}</span>
                                </a></li>
                            {{/foreach}}
                        </ul>
                    {{/get}}
                </details>
            {{/foreach}}
        {{/get}}
    </div>

    {{!-- Row 3 · foot — sharing. The links carry no JS: each is a real URL
         with the page's own address appended by Ghost, so they work with
         scripting off. --}}
    <div class="ns-trainingnav__foot">
        <div class="ns-share">
            <a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm ns-tooltip-host"
               href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true" encode="true"}}"
               target="_blank" rel="noopener" aria-label="{{t "Share on LinkedIn"}}">
                {{> "icons/brand-linkedin"}}<span class="ns-tooltip">LinkedIn</span>
            </a>
            <a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm ns-tooltip-host"
               href="https://x.com/intent/post?url={{url absolute="true" encode="true"}}&text={{title encode="true"}}"
               target="_blank" rel="noopener" aria-label="{{t "Share on X"}}">
                {{> "icons/brand-x"}}<span class="ns-tooltip">X</span>
            </a>
            <a class="ns-btn ns-btn--quiet ns-btn--icon ns-btn--sm ns-tooltip-host"
               href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true" encode="true"}}"
               target="_blank" rel="noopener" aria-label="{{t "Share on Facebook"}}">
                {{> "icons/brand-facebook"}}<span class="ns-tooltip">Facebook</span>
            </a>
        </div>
    </div>
</nav>
