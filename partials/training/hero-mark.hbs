{{!-- training/hero-mark.hbs — the animated mark beside the /training/ hero.

     ONE logo shape, drawn once and reused: a rounded square that traces itself
     in, with three orbiting dots on the same path a learner takes through the
     sections. Deliberately small — a single inline <svg>, no image request, no
     library, ~40 lines. It is decoration, so it is aria-hidden and every
     animation stops under prefers-reduced-motion (see effects.css).

     The stroke colours come from currentColor, so it inherits the hero's ink
     and needs no dark-mode branch. --}}
<svg class="ns-brandmark" viewBox="0 0 200 200" fill="none" aria-hidden="true" role="presentation">
  <defs>
    <linearGradient id="ns-mark-fade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%"   stop-color="currentColor" stop-opacity=".35"/>
      <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
    </linearGradient>
  </defs>

  {{!-- the ground: two concentric rounded squares, the outer one rotating --}}
  <rect class="ns-brandmark__ring" x="26" y="26" width="148" height="148" rx="38"
        stroke="url(#ns-mark-fade)" stroke-width="1.5"/>
  <rect x="54" y="54" width="92" height="92" rx="26"
        stroke="currentColor" stroke-width="1.5" stroke-opacity=".18"/>

  {{!-- the logo shape, drawing itself in --}}
  <path class="ns-brandmark__draw"
        d="M78 122V86a12 12 0 0 1 12-12h20a12 12 0 0 1 12 12v36M78 104h44"
        stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>

  {{!-- three dots travelling the ring — the three stages of the path --}}
  <g class="ns-brandmark__orbit">
    <circle cx="100" cy="26" r="5" fill="currentColor"/>
  </g>
  <g class="ns-brandmark__orbit ns-brandmark__orbit--2">
    <circle cx="100" cy="26" r="3.5" fill="currentColor" fill-opacity=".55"/>
  </g>
  <g class="ns-brandmark__orbit ns-brandmark__orbit--3">
    <circle cx="100" cy="26" r="2.5" fill="currentColor" fill-opacity=".35"/>
  </g>
</svg>
