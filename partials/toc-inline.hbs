{{!-- The inline table of contents — used wherever a page has NO
sidebar (the site rule: sidebar present → TOC lives there;
otherwise it sits here, right after the hero). toc.js fills it
and removes the whole box when the page has no headings. --}}
<details class="toc-inline" data-toc-wrap open>
    <summary>{{> "icons/list-icon"}} {{t "On this page"}} <span class="chev">{{> "icons/chevron-down"}}</span></summary>
    <ul class="toc-list" data-toc></ul>
</details>
