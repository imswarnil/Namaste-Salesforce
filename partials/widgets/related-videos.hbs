{{!-- Related videos — same shape as widgets/recent-posts.hbs,
scoped to the video library and excluding the video being read.
Renders nothing when there is nothing else to watch. --}}
{{#get "posts" filter="tag:hash-video+id:-{{id}}" limit="4" as |more|}}
    {{#if more}}
    <div class="widget">
        <h4 class="widget-title">{{> "icons/video"}} {{t "Related videos"}}</h4>
        <ul class="widget-posts">
            {{#foreach more}}
                <li class="widget-post">
                    {{#if feature_image}}
                        <img class="widget-post-thumb" src="{{img_url feature_image size="xs"}}" alt="" loading="lazy" />
                    {{else}}
                        <span class="widget-post-thumb"></span>
                    {{/if}}
                    <a href="{{url}}">
                        <span class="widget-post-title">{{title}}</span>
                        <span class="widget-post-date">{{> "duration-chip" chipClass="detail-plain"}}</span>
                    </a>
                </li>
            {{/foreach}}
        </ul>
        <a class="section-more" href="{{@site.url}}/videos/">{{t "All videos"}} {{> "icons/arrow-right"}}</a>
    </div>
    {{/if}}
{{/get}}
