{{!-- The share row itself — used bare in the post footer and
boxed by widgets/share.hbs. Plain intent URLs, no scripts.
Context: the post. --}}
<div class="share-row">
    <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}"
        target="_blank" rel="noopener" aria-label="{{t "Share on X"}}">{{> "icons/x"}}</a>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}"
        target="_blank" rel="noopener" aria-label="{{t "Share on LinkedIn"}}">{{> "icons/linkedin"}}</a>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}"
        target="_blank" rel="noopener" aria-label="{{t "Share on Facebook"}}">{{> "icons/facebook"}}</a>
    <a href="mailto:?subject={{encode title}}&body={{url absolute="true"}}"
        aria-label="{{t "Share by email"}}">{{> "icons/mail"}}</a>
</div>
