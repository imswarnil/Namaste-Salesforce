{{!-- Related prompts — same shape as widgets/recent-posts.hbs,
scoped to the prompt library and excluding the prompt being read. --}}
{{#get "posts" filter="tag:hash-prompt+id:-{{id}}" limit="5" as |more|}}
    {{#if more}}
    <div class="widget">
        <h4 class="widget-title">{{> "icons/sparkles"}} {{t "More prompts"}}</h4>
        <ul class="widget-posts">
            {{#foreach more}}
                <li class="widget-post">
                    <span class="widget-post-thumb widget-post-thumb-icon">{{> "icons/sparkles"}}</span>
                    <a href="{{url}}">
                        <span class="widget-post-title">{{title}}</span>
                    </a>
                </li>
            {{/foreach}}
        </ul>
        <a class="section-more" href="{{@site.url}}/prompts/">{{t "All prompts"}} {{> "icons/arrow-right"}}</a>
    </div>
    {{/if}}
{{/get}}
