{{!-- The why, in the author's own words. Fixed copy on purpose —
it is a statement of intent, not content that should drift with
the post list. The author's name/photo come from Ghost so the
attribution never goes stale. --}}
<figure class="widget widget-quote">
    <span class="widget-quote-mark" aria-hidden="true">&ldquo;</span>
    <blockquote>
        <p>{{t "I don't want to stay the CRM Analytics person. I want to understand the business under the system — how companies sell, how a deal actually moves — so I can solve business problems in any era."}}</p>
        <p>{{t "AI will come. Selling won't stop. It will only change shape."}}</p>
    </blockquote>
    {{#get "authors" limit="1" as |host|}}
        {{#foreach host}}
            <figcaption class="widget-quote-by">
                {{#if profile_image}}
                    <img src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                {{else}}
                    <span class="widget-quote-avatar">{{> "icons/avatar"}}</span>
                {{/if}}
                <span>
                    <strong>{{name}}</strong>
                    <em>{{t "On the way to GTM Engineer"}}</em>
                </span>
            </figcaption>
        {{/foreach}}
    {{/get}}
</figure>
