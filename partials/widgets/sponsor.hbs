{{!-- The sponsor card. One partial, two shapes: default box for
sidebars, skyscraper=true for the tall training rail slot. Both
route to the /sponsor page, which is a normal Ghost page —
edit the pitch there. --}}
<div class="widget widget-sponsor{{#if skyscraper}} is-skyscraper{{/if}}">
    <span class="widget-sponsor-badge">{{t "Sponsored"}}</span>
    <span class="widget-sponsor-icon">{{> "icons/megaphone"}}</span>
    <h4>{{t "Your product, right here"}}</h4>
    <p>{{t "Reach people building on Salesforce every week."}}</p>
    <a class="btn btn-sm" href="{{@site.url}}/sponsor/">{{t "Sponsor us"}} {{> "icons/arrow-right"}}</a>
</div>
