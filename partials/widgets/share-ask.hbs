{{!-- Share, or ask an AI about this page — the one widget that
sits where the sponsor card used to. Two rows: the social share
row (LinkedIn, X, copy link) and the AI row — open the page in
Claude, ChatGPT or Perplexity with a prompt already written for
the reader this site is for: a Salesforce person moving towards
an AI or GTM role. Every link is a plain URL with the documented
new-chat query parameter; no keys, no scripts beyond the copy
button share.js already handles. Context: the post. --}}
<div class="widget widget-ask">
    <h4 class="widget-title">{{> "icons/sparkles"}} {{t "Share, or ask an AI"}}</h4>

    <div class="share-row">
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}"
            target="_blank" rel="noopener" aria-label="{{t "Share on LinkedIn"}}" title="{{t "Share on LinkedIn"}}">{{> "icons/linkedin"}}</a>
        <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}"
            target="_blank" rel="noopener" aria-label="{{t "Share on X"}}" title="{{t "Share on X"}}">{{> "icons/x"}}</a>
        <a href="https://api.whatsapp.com/send?text={{encode title}}%20{{url absolute="true"}}"
            target="_blank" rel="noopener" aria-label="{{t "Share on WhatsApp"}}" title="{{t "Share on WhatsApp"}}">{{> "icons/message"}}</a>
        <a href="mailto:?subject={{encode title}}&body={{url absolute="true"}}"
            aria-label="{{t "Share by email"}}" title="{{t "Share by email"}}">{{> "icons/mail"}}</a>
        <button type="button" class="share-copy" data-copy-link="{{url absolute="true"}}" aria-label="{{t "Copy link"}}" title="{{t "Copy link"}}">
            <span class="share-copy-icon">{{> "icons/link-icon"}}</span>
            <span class="share-copy-done">{{> "icons/check-circle"}}</span>
        </button>
    </div>

    <p class="widget-ask-lead">{{t "Open this page in an AI assistant and ask it anything — the prompt is written for you."}}</p>

    <div class="ask-row">
        <a class="ask-btn" href="https://claude.ai/new?q={{encode "Read "}}{{encode (url absolute="true")}}{{encode " and explain it to me step by step. I know Salesforce and I am moving towards an AI or GTM role — tell me what matters most for that, then quiz me on it."}}"
            target="_blank" rel="noopener">{{> "icons/sparkles"}} {{t "Ask Claude"}}</a>
        <a class="ask-btn" href="https://chatgpt.com/?q={{encode "Read "}}{{encode (url absolute="true")}}{{encode " and explain it to me step by step. I know Salesforce and I am moving towards an AI or GTM role — tell me what matters most for that, then quiz me on it."}}"
            target="_blank" rel="noopener">{{> "icons/message"}} {{t "Ask ChatGPT"}}</a>
        <a class="ask-btn" href="https://www.perplexity.ai/search?q={{encode "Summarise "}}{{encode (url absolute="true")}}{{encode " for a Salesforce professional moving into an AI or GTM role"}}"
            target="_blank" rel="noopener">{{> "icons/search"}} {{t "Ask Perplexity"}}</a>
    </div>
</div>
