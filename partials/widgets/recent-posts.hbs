{{!-- Latest from the blog, excluding the post being read. --}}
{{#get "posts" filter="tag:hash-blog+id:-{{id}}" limit="4" as |recent|}}
    {{#if recent}}
    <div class="widget">
        <h4 class="widget-title">{{> "icons/book-open"}} {{t "Recent posts"}}</h4>
        <ul class="widget-posts">
            {{#foreach recent}}
                <li class="widget-post">
                    {{#if feature_image}}
                        <img class="widget-post-thumb" src="{{img_url feature_image size="xs"}}" alt="" loading="lazy" />
                    {{else}}
                        <span class="widget-post-thumb"></span>
                    {{/if}}
                    <a href="{{url}}">
                        <span class="widget-post-title">{{title}}</span>
                        <span class="widget-post-date">{{date format="DD MMM YYYY"}}</span>
                    </a>
                </li>
            {{/foreach}}
        </ul>
    </div>
    {{/if}}
{{/get}}
