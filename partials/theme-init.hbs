{{!-- ══════════════════════════════════════════════════════════════════════
     theme-init — INLINE and BLOCKING, before the stylesheet.
     ------------------------------------------------------------------------
     Vendored verbatim from NS-Design-System's assets/js/theme-init.js, which
     says at the top of the file that it must be inlined rather than linked.
     INTEGRATION.md §4 repeats it.

     THE PROBLEM. The page paints once, before any deferred script runs. Apply
     the theme after that and a dark-mode reader gets a white flash on every
     navigation. It has one fix: set the attribute synchronously, in the head,
     before first paint. A <script src> is fetched separately and lands too
     late; no amount of defer/async tuning helps.

     THE STORAGE KEY IS SHARED. `ns-theme`, the same key the Next.js LMS uses,
     so a reader moving between the marketing site and the app keeps their
     theme. INTEGRATION.md lists that as one of the three things that must not
     drift between the two products.

     "System" is stored as the ABSENCE of a value, which is what lets a reader
     who has never chosen keep following their OS — and what makes
     useSystem() a removeItem call rather than a third stored state.
     ══════════════════════════════════════════════════════════════════════ --}}
<script>
(function(){"use strict";
var KEY="ns-theme",root=document.documentElement;
function os(){return window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";}
function read(){try{var v=localStorage.getItem(KEY);return v==="light"||v==="dark"?v:null;}catch(e){return null;}}
function apply(t){root.setAttribute("data-theme",t);root.style.colorScheme=t;}
apply(read()||os());
if(window.matchMedia){
  var mq=window.matchMedia("(prefers-color-scheme: dark)"),on=function(e){
    if(read())return;apply(e.matches?"dark":"light");};
  if(mq.addEventListener)mq.addEventListener("change",on);else if(mq.addListener)mq.addListener(on);
}
window.nsTheme={key:KEY,
  get:function(){return root.getAttribute("data-theme");},
  set:function(v){apply(v);try{localStorage.setItem(KEY,v);}catch(e){}},
  toggle:function(){this.set(root.getAttribute("data-theme")==="dark"?"light":"dark");},
  useSystem:function(){try{localStorage.removeItem(KEY);}catch(e){}apply(os());}};
})();
</script>
