{{!-- The module landing — /training/{module}/. Mirrors the
course landing mechanism: this post's SLUG equals the module
tag's slug, so one {{#get}} on it lists the whole module. The
overview content reads first, then every section as a numbered
stop (the trail grammar), then the start CTA.
Context: a post tagged #module (dispatched by post.hbs). --}}

{{#contentFor "head"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{t "Training"}}", "item": "{{@site.url}}/training/" },
        { "@type": "ListItem", "position": 2, "name": "{{title}}", "item": "{{url absolute="true"}}" }
    ]
}
</script>
{{/contentFor}}

<section class="changelog-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="inner relative">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="{{@site.url}}/training/">{{> "icons/layers"}} {{t "Training"}}</a>
            {{> "icons/chevron-right"}}
            <span aria-current="page">{{title}}</span>
        </nav>

        <div class="module-hero-head">
            {{#primary_tag}}
                {{#if feature_image}}
                    <span class="trail-module-art" aria-hidden="true">
                        <img src="{{img_url feature_image size="s"}}" alt="" loading="eager" />
                    </span>
                {{else}}
                    <span class="trail-module-art is-icon" aria-hidden="true">{{> "icons/layers"}}</span>
                {{/if}}
            {{/primary_tag}}
            <div>
                <span class="kicker">{{> "icons/layers"}} {{t "Module"}}</span>
                <h1>{{title}}</h1>
                {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
            </div>
        </div>

        <div class="chips">
            {{#get "posts" filter="tag:{{slug}}+tag:hash-training" limit="1" as |s c|}}
                <span class="chip">{{> "icons/list-icon"}} {{c.total}} {{t "sections"}}</span>
            {{/get}}
            <span class="chip chip-free">{{t "Free"}}</span>
            <span class="chip">{{> "icons/calendar"}} {{t "Updated"}} {{date updated_at format="DD MMM YYYY"}}</span>
        </div>

        {{#get "posts" filter="tag:{{slug}}+tag:hash-training" order="published_at asc" limit="1" as |first|}}
            {{#if first}}
                <div class="module-hero-actions">
                    <a class="btn btn-lg" href="{{first.[0].url}}">{{> "icons/play-circle"}} {{t "Start the module"}}</a>
                </div>
            {{/if}}
        {{/get}}
    </div>
</section>

<main id="site-main" class="section outer">
    <div class="inner inner-narrow">

        <article class="gh-content entry-content">
            {{content}}
        </article>

        {{!-- Every section, in walking order --}}
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training" order="published_at asc" include="tags" limit="50" as |sections|}}
            {{#if sections}}
                <section class="module-sections">
                    <h2>{{> "icons/map-icon"}} {{t "The sections"}}</h2>
                    <ol class="trail-steps">
                        {{#foreach sections}}
                            <li class="trail-step">
                                <a href="{{url}}">
                                    <span class="trail-step-dot" aria-hidden="true">{{> "lesson-type-icon"}}</span>
                                    <span class="trail-step-body">
                                        <span class="trail-step-title">{{title}}</span>
                                        {{#if custom_excerpt}}<span class="trail-step-sub">{{custom_excerpt}}</span>{{/if}}
                                    </span>
                                    {{> "duration-chip" chipClass="trail-step-time"}}
                                    {{> "icons/arrow-right"}}
                                </a>
                            </li>
                        {{/foreach}}
                    </ol>
                </section>
            {{/if}}
        {{/get}}

        <footer class="entry-foot">
            <a class="btn btn-ghost" href="{{@site.url}}/training/">{{> "icons/arrow-left"}} {{t "All modules"}}</a>
        </footer>
    </div>
</main>
