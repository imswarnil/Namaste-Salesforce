{{!-- Live counts — limit 1, we only want pagination.total.
data-count makes animate.js count each number up from 0; the
rendered total stays as no-JS/no-motion fallback. Shared by
every hero style. --}}
<div class="home-stats" data-animate-stagger>
    {{#get "posts" filter="tag:[hash-course-col,hash-courses-col]" limit="1" as |items counts|}}
        <div class="home-stat"><span class="home-stat-icon">{{> "icons/graduation-cap"}}</span><strong data-count="{{counts.total}}">{{counts.total}}</strong><span>{{t "Courses"}}</span></div>
    {{/get}}
    {{#get "posts" filter="tag:[hash-lesson-col,hash-lessons-col]" limit="1" as |items counts|}}
        <div class="home-stat"><span class="home-stat-icon">{{> "icons/play-circle"}}</span><strong data-count="{{counts.total}}">{{counts.total}}</strong><span>{{t "Lessons"}}</span></div>
    {{/get}}
    {{#get "posts" filter="tag:[hash-training-col,hash-docs-col]" limit="1" as |items counts|}}
        <div class="home-stat"><span class="home-stat-icon">{{> "icons/layers"}}</span><strong data-count="{{counts.total}}">{{counts.total}}</strong><span>{{t "Training pages"}}</span></div>
    {{/get}}
    {{#get "posts" filter="tag:hash-blog-col" limit="1" as |items counts|}}
        <div class="home-stat"><span class="home-stat-icon">{{> "icons/pen"}}</span><strong data-count="{{counts.total}}">{{counts.total}}</strong><span>{{t "Articles"}}</span></div>
    {{/get}}
</div>
