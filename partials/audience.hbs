{{!-- Who this is for — the three readers the site is written for,
each with the gap they are closing and the door to walk through
first. Fixed copy on purpose: it is the positioning, not content
that should drift with the post list. --}}
<section class="section outer home-audience">
    <div class="inner">
        <div class="section-head" data-animate>
            <div>
                <span class="kicker">{{> "icons/avatar"}} {{t "Who this is for"}}</span>
                <h2>{{t "Three readers, one path"}}</h2>
                <p>{{t "Salesforce is the way in, not the destination. Pick the door that sounds like you and the trail does the rest."}}</p>
            </div>
        </div>

        <div class="audience-grid" data-animate-stagger>
            <a class="audience-card" href="{{@site.url}}/training/">
                <span class="audience-num" aria-hidden="true">01</span>
                <span class="audience-ico" aria-hidden="true">{{> "icons/cloud"}}</span>
                <h3>{{t "The Salesforce admin or developer"}}</h3>
                <p class="audience-gap">{{t "You can build the org. You want to understand the revenue process it runs — and stop being the last to hear why a deal moved."}}</p>
                <ul class="audience-list">
                    <li>{{> "icons/check-circle"}} {{t "Sales cycle, lead routing, quote-to-cash — explained before the objects"}}</li>
                    <li>{{> "icons/check-circle"}} {{t "Flow and Apex patterns that survive production"}}</li>
                </ul>
                <span class="audience-go">{{t "Start the training trail"}} {{> "icons/arrow-right"}}</span>
            </a>

            <a class="audience-card is-featured" href="{{@site.url}}/courses/">
                <span class="audience-num" aria-hidden="true">02</span>
                <span class="audience-ico" aria-hidden="true">{{> "icons/sparkles"}}</span>
                <h3>{{t "Moving into an AI or GTM engineering role"}}</h3>
                <p class="audience-gap">{{t "You have the CRM. The next job wants n8n, Clay, 6sense, Agentforce and an LLM doing the clicking. This is the stack, learned in the open."}}</p>
                <ul class="audience-list">
                    <li>{{> "icons/check-circle"}} {{t "Agentforce end to end, prompts that earn their keep"}}</li>
                    <li>{{> "icons/check-circle"}} {{t "The GTM tooling around Salesforce, piece by piece"}}</li>
                </ul>
                <span class="audience-go">{{t "Browse the courses"}} {{> "icons/arrow-right"}}</span>
            </a>

            <a class="audience-card" href="{{@site.url}}/courses/">
                <span class="audience-num" aria-hidden="true">03</span>
                <span class="audience-ico" aria-hidden="true">{{> "icons/graduation-cap"}}</span>
                <h3>{{t "New to the ecosystem"}}</h3>
                <p class="audience-gap">{{t "You know a spreadsheet and you want a step-by-step way in that does not cost anything and does not skip the why."}}</p>
                <ul class="audience-list">
                    <li>{{> "icons/check-circle"}} {{t "Admin Foundations, free, in a Developer Edition org"}}</li>
                    <li>{{> "icons/check-circle"}} {{t "Every lesson ends with something running in your org"}}</li>
                </ul>
                <span class="audience-go">{{t "Open lesson one"}} {{> "icons/arrow-right"}}</span>
            </a>
        </div>
    </div>
</section>
