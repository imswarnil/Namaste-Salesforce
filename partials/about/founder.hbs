{{!-- ════════════════════════════════════════════════════════════════════════
  about/founder.hbs — the founder profile.

  The design system's `.ns-instructor`, which is exactly this object: an
  avatar, a name, a role, a bio and a row of links. The theme built it as a
  two-column card with a navy identity panel, four hand-rolled round social
  buttons and eight hand-rolled pills — about fifty utilities reproducing
  three components the system already ships (.ns-instructor, .ns-navicon,
  .ns-tag--pill).

  Edit the copy here; it is deliberately hard-coded rather than pulled from a
  Ghost author, because this is the SITE's founder statement, not a byline.
═══════════════════════════════════════════════════════════════════════════ --}}
<div class="ns-instructor">
  {{#if @site.logo}}
    {{!-- The SITE LOGO standing in for a portrait, so the alt describes the
         logo. It used to claim to be a photo of a named person, which is
         wrong for anyone using a screen reader. --}}
    <img class="ns-instructor__avatar" loading="lazy" decoding="async" src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}">
  {{else}}
    <span class="ns-avatar ns-avatar--xl ns-instructor__avatar">SS</span>
  {{/if}}

  <div>
    <span class="ns-instructor__name">Swarnil Singhai</span>
    <span class="ns-instructor__role">{{t "Founder · Salesforce Developer & Architect"}}</span>

    <p class="ns-instructor__bio">
      {{t "I've spent years building on the Salesforce platform — from Apex and LWC to data architecture and AI. I started Namaste Salesforce to share everything I wish I'd had when I began: practical, project-led learning that's open to all."}}
    </p>

    <p class="ns-kicker">{{t "Focus areas"}}</p>
    <div class="ns-strip">
      <span class="ns-tag ns-tag--pill">Apex</span>
      <span class="ns-tag ns-tag--pill">LWC</span>
      <span class="ns-tag ns-tag--pill">Flow</span>
      <span class="ns-tag ns-tag--pill">Agentforce</span>
      <span class="ns-tag ns-tag--pill">Data Cloud</span>
      <span class="ns-tag ns-tag--pill">CRM Analytics</span>
      <span class="ns-tag ns-tag--pill">Integration</span>
      <span class="ns-tag ns-tag--pill">Architecture</span>
    </div>

    <ul class="ns-outcomes ns-outcomes--single">
      <li>{{> icons name="check-circle"}}<span>{{t "Writes and reviews every course and training on the platform."}}</span></li>
      <li>{{> icons name="check-circle"}}<span>{{t "Ships real-world projects and open-source tooling for the community."}}</span></li>
      <li>{{> icons name="check-circle"}}<span>{{t "Focused on bringing AI-era skills — Agentforce, Data Cloud, Einstein — to everyone."}}</span></li>
    </ul>

    <div class="ns-instructor__stats">
      <a class="ns-navicon" href="https://github.com/imswarnil" target="_blank" rel="noopener" aria-label="GitHub">{{> icons name="github"}}</a>
      <a class="ns-navicon" href="https://www.linkedin.com/in/imswarnil" target="_blank" rel="noopener" aria-label="LinkedIn">{{> icons name="linkedin"}}</a>
      <a class="ns-navicon" href="https://twitter.com/imswarnil" target="_blank" rel="noopener" aria-label="X">{{> icons name="x-logo"}}</a>
      <a class="ns-navicon" href="mailto:swarnilsinghaicse@gmail.com" aria-label="{{t "Email"}}">{{> icons name="mail"}}</a>
      <span class="ns-postmeta">{{> icons name="map-pin"}}{{t "Bengaluru, India"}}</span>
    </div>
  </div>
</div>
