{{!-- ════════════════════════════════════════════════════════════════════════
  about/founder.hbs — Founder profile card (Swarnil)
  Edit the copy/links here. Avatar shows the site logo if set, else initials.
═══════════════════════════════════════════════════════════════════════════ --}}
<div class="overflow-hidden rounded-card border border-border bg-surface-raised shadow-card">
  <div class="grid md:grid-cols-[18rem_1fr]">

    {{!-- Identity --}}
    <div class="flex flex-col items-center gap-4 border-b border-border bg-gradient-to-br from-brand-600 to-brand-900 p-8 text-center text-white md:border-b-0 md:border-r md:border-white/10">
      {{#if @site.logo}}
        {{!-- This is the SITE LOGO standing in for a portrait, so the alt
             describes the logo. It previously claimed to be a photo of a
             named person, which is wrong for anyone using a screen reader. --}}
        <img loading="lazy" decoding="async" src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}" class="h-24 w-24 rounded-full object-cover ring-4 ring-white/20">
      {{else}}
        <span class="flex h-24 w-24 items-center justify-center rounded-full bg-white/15 font-heading text-3xl font-extrabold ring-4 ring-white/20">SS</span>
      {{/if}}
      <div>
        <p class="font-heading text-xl font-bold">Swarnil Singhai</p>
        <p class="mt-0.5 text-sm text-white/80">{{t "Founder · Salesforce Developer & Architect"}}</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="https://github.com/imswarnil" target="_blank" rel="noopener" aria-label="GitHub" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">{{> "icons/github" class="h-4 w-4"}}</a>
        <a href="https://www.linkedin.com/in/imswarnil" target="_blank" rel="noopener" aria-label="LinkedIn" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">{{> "icons/linkedin" class="h-4 w-4"}}</a>
        <a href="https://twitter.com/imswarnil" target="_blank" rel="noopener" aria-label="Twitter / X" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">{{> "icons/twitter" class="h-4 w-4"}}</a>
        <a href="mailto:swarnilsinghaicse@gmail.com" aria-label="Email" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">{{> "icons/mail" class="h-4 w-4"}}</a>
      </div>
      <p class="inline-flex items-center gap-1 text-xs text-white/70"><i class="ph ph-map-pin" aria-hidden="true"></i>{{t "Bengaluru, India"}}</p>
    </div>

    {{!-- Bio + details --}}
    <div class="p-8">
      <h3 class="font-heading text-lg font-bold">{{t "Hi, I'm Swarnil 👋"}}</h3>
      <p class="mt-3 leading-relaxed text-muted">
        {{t "I've spent years building on the Salesforce platform — from Apex and LWC to data architecture and AI. I started Namaste Salesforce to share everything I wish I'd had when I began: practical, project-led learning that's open to all."}}
      </p>

      <p class="mt-5 text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Focus areas"}}</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">Apex</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">LWC</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">Flow</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">Agentforce</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">Data Cloud</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">CRM Analytics</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">Integration</span>
        <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">Architecture</span>
      </div>

      <ul class="mt-6 space-y-2.5 text-sm">
        <li class="flex items-start gap-2"><i class="ph-fill ph-check-circle mt-0.5 text-success" aria-hidden="true"></i><span>{{t "Writes and reviews every course and training on the platform."}}</span></li>
        <li class="flex items-start gap-2"><i class="ph-fill ph-check-circle mt-0.5 text-success" aria-hidden="true"></i><span>{{t "Ships real-world projects and open-source tooling for the community."}}</span></li>
        <li class="flex items-start gap-2"><i class="ph-fill ph-check-circle mt-0.5 text-success" aria-hidden="true"></i><span>{{t "Focused on bringing AI-era skills — Agentforce, Data Cloud, Einstein — to everyone."}}</span></li>
      </ul>
    </div>
  </div>
</div>
