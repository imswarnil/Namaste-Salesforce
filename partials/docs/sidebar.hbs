{{!-- docs/sidebar.hbs — Documentation navigation
     ---------------------------------------------------------------------------
     Lists all `documentation`-tagged posts. Sticky on desktop; on mobile it
     collapses behind a toggle (Alpine). The current article (when on a single
     doc page that prints #doc-current-id) is highlighted via the inline script. --}}
<aside class="relative lg:sticky lg:top-20 lg:self-start" x-data="{ open: false }">

  {{!-- Mobile toggle --}}
  <button type="button" class="subnav-bar group"
          @click="open = !open" :aria-expanded="open.toString()" aria-controls="docs-nav">
    <span class="flex items-center gap-2"><i class="ph ph-list-bullets" aria-hidden="true"></i>{{t "All articles"}}</span>
    <i class="ph ph-caret-down transition-transform" :class="open && 'rotate-180'" aria-hidden="true"></i>
  </button>

  <nav id="docs-nav" class="subnav-panel lg:!block" :class="open ? 'block' : 'hidden'" aria-label="{{t "Documentation"}}">
    <a href="/documentation/" class="mb-4 inline-flex items-center gap-1 text-sm text-muted transition hover:text-brand-600">
      <i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "Docs home"}}
    </a>
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.12em] text-muted">{{t "Contents"}}</p>
    <ul class="space-y-0.5 border-l border-border">
      {{#get "posts" filter="tag:documentation" limit="100" order="published_at asc"}}
        {{#foreach posts}}
          <li>
            <a href="{{url}}" data-doc-id="{{id}}"
               class="doc-nav-link -ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-muted transition hover:border-brand-400 hover:text-brand-600 dark:hover:text-brand-300">
              {{title}}
            </a>
          </li>
        {{/foreach}}
      {{/get}}
    </ul>
  </nav>
</aside>

{{!-- Highlight the current doc (single-doc pages print #doc-current-id). --}}
<script>
  (function () {
    var c = document.getElementById('doc-current-id');
    if (!c) return;
    var link = document.querySelector('[data-doc-id="' + c.getAttribute('data-id') + '"]');
    if (link) link.classList.add('is-doc-active');
  })();
</script>
