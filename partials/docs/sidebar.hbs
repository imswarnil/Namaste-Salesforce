{{!-- docs/sidebar.hbs — the documentation rail.

     The design system's `.ns-sidebar`: sticky under the navbar, its own
     scroll region, collapsing to static below lg (the component decides that,
     not this file). Sections are `.ns-sidebar__group` <details> rendered by
     docs/sections view="nav".

     THE ONE LINE OF SCRIPT sets `aria-current="page"` on the row for the doc
     being read. It has to be script rather than a Handlebars `{{#match}}`
     because the sections are pulled with {{#get}}, which swaps the context —
     the current post's id is not reachable inside the loop without a `../`
     path that Ghost 500s on. Everything else is the system's:
     assets/js/ds/rail.js reads that attribute and closes the groups that do
     not contain it. --}}
<aside class="ns-sidebar" aria-label="{{t "Documentation"}}">
  <a class="ns-sidebar__link" href="/docs/">{{> icons name="books"}}{{t "Docs home"}}</a>
  {{> "docs/sections" view="nav"}}
</aside>

<script>
  (function () {
    var cur = document.getElementById('doc-current-id');
    if (!cur) return;
    var id = cur.getAttribute('data-id');
    document.querySelectorAll('[data-doc-id="' + id + '"]').forEach(function (a) {
      a.setAttribute('aria-current', 'page');
    });
  })();
</script>
