{{!-- docs/section-item.hbs — one docs section, rendered per `view`
     ---------------------------------------------------------------------------
     Params (all passed by docs/sections): view · slug · legacy · name · icon ·
     desc.  Views:
       "nav"  — collapsible <details> group for the sidebar / mobile menu
                (native disclosure, no Alpine; sidebar script opens the active
                 group and highlights the current doc as a brand button).
       "card" — professional hub card: icon, blurb, first articles, section CTA.
     Posts are matched on BOTH the clean slug and the legacy docs-NN-* slug so
     the site keeps working until tags are renamed in Ghost Admin. --}}
{{#match view "nav"}}
  {{!-- The design system's `.ns-sidebar__group` as a native <details>: the
       section collapses with no JavaScript and no ARIA of its own. It ships
       OPEN, so a script failure leaves the nav long rather than hidden;
       assets/js/ds/rail.js then closes the ones that do not hold the current
       page. The active link is `aria-current="page"` — the attribute the
       system styles and the screen reader announces, so the two cannot
       disagree. --}}
  <details class="ns-sidebar__group" data-sec="{{slug}}" data-sec-legacy="{{legacy}}" open>
    <summary>
      {{> icons name=icon}}
      <span class="ns-sidebar__label">{{name}}</span>
      {{> icons name="caret-right" class="ns-sidebar__twist"}}
    </summary>
    {{#get "posts" filter="tag:documentation+primary_tag:[{{slug}},{{legacy}}]" limit="100" order="published_at asc"}}
      {{#foreach posts}}
        <a class="ns-sidebar__link" href="{{url}}" data-doc-id="{{id}}">{{title}}</a>
      {{/foreach}}
    {{/get}}
    <a class="ns-sidebar__link" href="/docs/{{slug}}/">{{t "View section"}}{{> icons name="arrow-right"}}</a>
  </details>
{{else match view "card"}}
  <article data-cat data-section="{{slug}}"
           x-show="q === '' || [...$el.querySelectorAll('a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))"
           {{!-- min-w-0: the article is a grid item, so without it the track is
                 sized to the LONGEST article title in the list — those titles
                 are `truncate` (nowrap), which has no break opportunity to
                 give, and one long one widened every card past the phone. --}}
           class="group/card flex min-w-0 flex-col rounded-card border border-border bg-surface-raised p-6 ns-transition hover:border-brand-500">
    <div class="flex items-start gap-3.5">
      <span class="ns-chip shrink-0">
        {{> icons name=icon}}
      </span>
      <div class="min-w-0">
        <h2 class="font-heading text-lg font-bold tracking-tight">
          <a href="/docs/{{slug}}/" class="transition group-hover/card:text-brand-600 dark:group-hover/card:text-brand-300">{{name}}</a>
        </h2>
        <p class="mt-0.5 text-sm text-muted">{{desc}}</p>
      </div>
    </div>
    {{#get "posts" filter="tag:documentation+primary_tag:[{{slug}},{{legacy}}]" limit="4" order="published_at asc"}}
      <ul class="mt-4 space-y-0.5 border-t border-border pt-3">
        {{#foreach posts}}
          <li>
            <a href="{{url}}" data-title="{{title}}"
               x-show="q === '' || $el.dataset.title.toLowerCase().includes(q.toLowerCase())"
               class="group/l flex items-center gap-2 rounded-btn px-2 py-1.5 text-sm text-ink ns-transition hover:bg-surface-sunken">
              {{> icons name="file-text" class="shrink-0 text-brand-500 opacity-70"}}
              <span class="truncate group-hover/l:text-brand-600 dark:group-hover/l:text-brand-300">{{title}}</span>
            </a>
          </li>
        {{else}}
          <li class="px-2 py-1.5 text-sm italic text-muted">{{t "Coming soon."}}</li>
        {{/foreach}}
      </ul>
      <a href="/docs/{{slug}}/" class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-brand-600 transition hover:gap-2.5 dark:text-brand-300">
        {{t "Browse all"}} {{pagination.total}} {{t "articles"}} {{> icons name="arrow-right"}}
      </a>
    {{/get}}
  </article>
{{/match}}
