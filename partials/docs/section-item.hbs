{{!-- docs/section-item.hbs — one docs section, rendered per `view`
     ---------------------------------------------------------------------------
     Params (all passed by docs/sections): view · slug · legacy · name · icon ·
     desc.  Views:
       "nav"  — collapsible <details> group for the sidebar / mobile menu
                (native disclosure, no Alpine; sidebar script opens the active
                 group and highlights the current doc as a brand button).
       "card" — professional hub card: icon, blurb, first articles, section CTA.
     Posts are matched on BOTH the clean slug and the legacy docs-NN-* slug so
     the site keeps working until tags are renamed in Ghost Admin. --}}
{{#match view "nav"}}
  <details class="doc-sec group/sec" data-sec="{{slug}}" data-sec-legacy="{{legacy}}">
    <summary class="flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-semibold text-ink transition hover:bg-surface-sunken [&::-webkit-details-marker]:hidden">
      <i class="ph {{icon}} shrink-0 text-base text-brand-500" aria-hidden="true"></i>
      <span class="min-w-0 flex-1 truncate">{{name}}</span>
      <i class="ph ph-caret-right shrink-0 text-xs text-muted transition-transform group-open/sec:rotate-90" aria-hidden="true"></i>
    </summary>
    <ul class="mb-2 ml-[1.15rem] space-y-0.5 border-l border-border pl-2.5 pt-1">
      {{#get "posts" filter="tag:documentation+primary_tag:[{{slug}},{{legacy}}]" limit="100" order="published_at asc"}}
        {{#foreach posts}}
          <li>
            <a href="{{url}}" data-doc-id="{{id}}"
               class="doc-nav-link block rounded-lg px-2.5 py-1.5 text-sm text-muted transition hover:bg-surface-sunken hover:text-brand-600 dark:hover:text-brand-300">{{title}}</a>
          </li>
        {{/foreach}}
      {{/get}}
      <li>
        <a href="/docs/{{slug}}/" class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-semibold text-brand-600 transition hover:gap-1.5 dark:text-brand-300">
          {{t "View section"}} <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </li>
    </ul>
  </details>
{{else match view "card"}}
  <article data-cat data-section="{{slug}}"
           x-show="q === '' || [...$el.querySelectorAll('a[data-title]')].some(a => a.dataset.title.toLowerCase().includes(q.toLowerCase()))"
           class="group/card flex flex-col rounded-card border border-border bg-surface-raised p-6 shadow-card transition hover:-translate-y-0.5 hover:border-brand-500/40 hover:shadow-raised">
    <div class="flex items-start gap-3.5">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-xl text-brand-600 transition group-hover/card:scale-105 dark:text-brand-300">
        <i class="ph-fill {{icon}}" aria-hidden="true"></i>
      </span>
      <div class="min-w-0">
        <h2 class="font-heading text-lg font-bold tracking-tight">
          <a href="/docs/{{slug}}/" class="transition group-hover/card:text-brand-600 dark:group-hover/card:text-brand-300">{{name}}</a>
        </h2>
        <p class="mt-0.5 text-sm text-muted">{{desc}}</p>
      </div>
    </div>
    {{#get "posts" filter="tag:documentation+primary_tag:[{{slug}},{{legacy}}]" limit="4" order="published_at asc"}}
      <ul class="mt-4 space-y-0.5 border-t border-border pt-3">
        {{#foreach posts}}
          <li>
            <a href="{{url}}" data-title="{{title}}"
               x-show="q === '' || $el.dataset.title.toLowerCase().includes(q.toLowerCase())"
               class="group/l flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-ink transition hover:bg-surface-sunken">
              <i class="ph ph-file-text shrink-0 text-brand-500 opacity-70" aria-hidden="true"></i>
              <span class="truncate group-hover/l:text-brand-600 dark:group-hover/l:text-brand-300">{{title}}</span>
            </a>
          </li>
        {{else}}
          <li class="px-2 py-1.5 text-sm italic text-muted">{{t "Coming soon."}}</li>
        {{/foreach}}
      </ul>
      <a href="/docs/{{slug}}/" class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-brand-600 transition hover:gap-2.5 dark:text-brand-300">
        {{t "Browse all"}} {{pagination.total}} {{t "articles"}} <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    {{/get}}
  </article>
{{/match}}
