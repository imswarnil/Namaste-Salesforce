{{!-- ══════════════════════════════════════════════════════════════════════
     empty — NSDS's .ns-empty, for a listing with nothing in it.
     ------------------------------------------------------------------------
     Takes partial parameters:
        {{> "empty" title="Nothing here yet" text="Check back on Monday."}}

     An empty listing that renders as a blank column reads as a broken page.
     This is the same component the 404 uses, minus the code.
     ══════════════════════════════════════════════════════════════════════ --}}
<div class="ns-empty">
    <p class="ns-empty__title">{{#if title}}{{title}}{{else}}{{t "Nothing here yet"}}{{/if}}</p>
    {{#if text}}<p class="ns-empty__text">{{text}}</p>{{/if}}
</div>
