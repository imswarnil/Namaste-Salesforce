{{!-- ══════════════════════════════════════════════════════════════════════
     chrome/topnav — NS-Design-System's navbar.html, bound to Ghost.
     ------------------------------------------------------------------------
     Ported whole from templates/navbar.html; the only changes are the ones
     INTEGRATION.md §5 calls for — hrefs to {{@site.url}}, the brand to
     {{@site.title}}, the link row to {{navigation}}. Every class, every
     attribute and the element order are the design system's.

     WHAT WAS DROPPED, and why each one:
       .ns-pathpick   a training-path switcher. It needs a notion of "the path
                      you are on", which Ghost has no way to store per reader.
       .ns-navstar    a GitHub star count. It needs a live API call, and a
                      theme that fetches a third party on every page load is a
                      privacy and performance decision the publisher did not
                      make.
       .ns-megamenu   mega panels are authored content, and Ghost's navigation
                      is a flat list of label/url pairs with nowhere to put a
                      description or a column heading.

     Each is markup NSDS can express and Ghost cannot supply data for. Leaving
     an empty shell in would look like a broken component rather than an
     absent one.

     THREE DECISIONS from navbar.css shape the rest: state is aria-expanded /
     aria-current and never a class; the bar is solid, never blurred; the
     current page is a 2px underline, never a filled pill.
     ══════════════════════════════════════════════════════════════════════ --}}
<nav class="ns-topnav" aria-label="{{t "Main"}}" data-ns-scrolled>
    <div class="ns-topnav__inner">

        <a class="ns-topnav__brand" href="{{@site.url}}">
            {{#if @site.icon}}<img src="{{img_url @site.icon size="xs"}}" alt="" width="24" height="24">{{/if}}
            <span class="ns-topnav__brand-name">{{@site.title}}</span>
        </a>

        {{navigation}}

        <div class="ns-topnav__actions">

            {{!-- data-ghost-search is Ghost's own hook: Sodo Search binds to
                 it and opens the modal, so there is no theme-side search to
                 build, index or keep working. NSDS's demo used data-ns-search
                 for the same control. --}}
            <button type="button" class="ns-navsearch" data-ghost-search
                    aria-label="{{t "Search this site"}}">
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                <span class="ns-navsearch__text">{{t "Search"}}</span>
                <kbd class="ns-navsearch__kbd">⌘K</kbd>
            </button>

            {{!-- Both glyph states live in CSS, driven by data-theme on
                 <html> — so the right one is in the first painted frame,
                 before any script runs. nav.js only keeps aria-checked
                 honest. --}}
            <button type="button" class="ns-themeswitch" role="switch" aria-checked="false"
                    aria-label="{{t "Dark mode"}}" data-ns-theme-toggle>
                <span class="ns-themeswitch__mark" aria-hidden="true"></span>
            </button>

            {{#if @site.members_enabled}}
                <div class="ns-topnav__auth">{{> "chrome/members" size="sm"}}</div>
            {{/if}}

            <button type="button" class="ns-burger" data-ns-sheet="site-nav"
                    aria-controls="site-nav" aria-expanded="false"
                    aria-haspopup="dialog" aria-label="{{t "Menu"}}">
                <span class="ns-burger__bar"></span><span class="ns-burger__bar"></span><span class="ns-burger__bar"></span>
            </button>

        </div>
    </div>
</nav>
