{{!-- members — sign in / subscribe / account, on NSDS's .ns-btn.

     Three states, and all three must be handled or a signed-in reader is
     invited to sign in again:
       signed in                    → Account
       signed out, open signup      → Sign in + Subscribe
       signed out, invite-only site → Sign in only

     `data-portal` is Ghost's hook — Portal intercepts the click and opens its
     modal rather than navigating. The href stays a real fragment so the
     control still does something if Portal fails to load.

     PARAMETERS
       size    "sm" → the small button a 3rem bar takes
       block   truthy → full-width, for the sheet's pinned footer --}}
{{#if @site.members_enabled}}
    {{#if @member}}
        <a class="ns-btn ns-btn--outline{{#match size "sm"}} ns-btn--sm{{/match}}{{#if block}} ns-btn--block{{/if}}"
           href="#/portal/account" data-portal="account">
            <i class="ph ph-user-circle" aria-hidden="true"></i> {{t "Account"}}
        </a>
    {{else}}
        {{#unless @site.members_invite_only}}
            <a class="ns-btn ns-btn--quiet{{#match size "sm"}} ns-btn--sm{{/match}}{{#if block}} ns-btn--block{{/if}}"
               href="#/portal/signin" data-portal="signin">
                <i class="ph ph-user-circle" aria-hidden="true"></i> {{t "Sign in"}}
            </a>
            <a class="ns-btn ns-btn--primary{{#match size "sm"}} ns-btn--sm{{/match}}{{#if block}} ns-btn--block{{/if}}"
               href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
        {{else}}
            <a class="ns-btn ns-btn--primary{{#match size "sm"}} ns-btn--sm{{/match}}{{#if block}} ns-btn--block{{/if}}"
               href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
        {{/unless}}
    {{/if}}
{{/if}}
