{{!-- ══════════════════════════════════════════════════════════════════════
     chrome/footer — NSDS's .ns-footer from sections.css.
     ------------------------------------------------------------------------
     IT REPEATS THE PRIMARY NAVIGATION DELIBERATELY. The mobile sheet needs
     JavaScript to open, so without this a reader with scripts disabled on a
     phone has no route to the rest of the site. Repeating it is what makes
     "the script layer is optional" true rather than merely stated.

     Every column is Ghost data — the two navigation menus and the site
     description — so a change in Admin reaches the footer with no edit here.
     ══════════════════════════════════════════════════════════════════════ --}}
<footer class="ns-footer">
    <div class="ns-page">

        <div class="ns-footer__grid">

            <div class="ns-footer__col">
                <p class="ns-footer__head">{{@site.title}}</p>
                {{#if @site.description}}<p class="ns-footer__blurb">{{@site.description}}</p>{{/if}}
            </div>

            <nav class="ns-footer__col" aria-label="{{t "Footer"}}">
                <p class="ns-footer__head">{{t "Explore"}}</p>
                {{navigation variant="footer"}}
            </nav>

            {{#if @site.secondary_navigation}}
                <nav class="ns-footer__col" aria-label="{{t "More"}}">
                    <p class="ns-footer__head">{{t "More"}}</p>
                    {{navigation type="secondary" variant="footer"}}
                </nav>
            {{/if}}

            {{#if @site.members_enabled}}
                <div class="ns-footer__col">
                    <p class="ns-footer__head">{{t "Newsletter"}}</p>
                    <p class="ns-footer__blurb">{{t "New lessons and posts, straight to your inbox."}}</p>
                    {{> "chrome/members" block=true}}
                </div>
            {{/if}}

        </div>

        <div class="ns-footer__bar">
            <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
            <span class="ns-footer__spacer"></span>
            <a href="{{@site.url}}/rss/">{{t "RSS"}}</a>
            <a href="https://ghost.org/" target="_blank" rel="noopener">{{t "Published with Ghost"}}</a>
        </div>

    </div>
</footer>
