{{!-- ══════════════════════════════════════════════════════════════════════
     chrome/nav-sheet — the mobile navigation, from NSDS's navbar.html.
     ------------------------------------------------------------------------
     A real <dialog>, opened with showModal(). That is what grants the focus
     trap, Esc-to-close, an inert background and top-layer stacking — four
     things that are hard to get right by hand and that a div-with-a-class
     gets right none of.

     It covers the whole viewport rather than sliding in as a drawer: on a
     phone a 20rem drawer leaves a strip of unusable page, and the links get
     to be large enough to hit.

     IT SITS OUTSIDE THE BAR. A modal dialog nested inside a position:sticky
     ancestor inherits that stacking context in some engines and renders
     underneath the page it is meant to cover.

     The three-state theme control lives here rather than in the bar because
     there is room: "Auto" is a real choice, and a two-state toggle silently
     converts every visitor into someone with an explicit preference.
     ══════════════════════════════════════════════════════════════════════ --}}
<dialog class="ns-navsheet" id="site-nav" aria-label="{{t "Site menu"}}">

    <div class="ns-navsheet__head">
        <a class="ns-topnav__brand" href="{{@site.url}}">
            {{#if @site.icon}}<img src="{{img_url @site.icon size="xs"}}" alt="" width="24" height="24">{{/if}}
            <span class="ns-topnav__brand-name">{{@site.title}}</span>
        </a>
        <button type="button" class="ns-btn ns-btn--quiet ns-btn--icon ns-navsheet__close"
                data-ns-sheet-close aria-label="{{t "Close menu"}}">
            <i class="ph ph-x" aria-hidden="true"></i>
        </button>
    </div>

    <div class="ns-navsheet__body">
        {{navigation variant="sheet"}}

        {{#if @site.secondary_navigation}}
            <p class="ns-navsheet__label">{{t "More"}}</p>
            {{navigation type="secondary" variant="sheet"}}
        {{/if}}

        <p class="ns-navsheet__label">{{t "Theme"}}</p>
        <div class="ns-themetoggle" role="radiogroup" aria-label="{{t "Colour theme"}}" data-ns-theme>
            <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="false"
                    aria-label="{{t "Light"}}" data-ns-theme-value="light">{{t "Light"}}</button>
            <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="true"
                    aria-label="{{t "Match the system setting"}}" data-ns-theme-value="system">{{t "Auto"}}</button>
            <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="false"
                    aria-label="{{t "Dark"}}" data-ns-theme-value="dark">{{t "Dark"}}</button>
        </div>
    </div>

    {{#if @site.members_enabled}}
        {{!-- Pinned, not scrolled to: subscribing is why the sheet exists on
             a publication, and it must not depend on reaching the end of a
             long site map. --}}
        <div class="ns-navsheet__foot">{{> "chrome/members" block=true}}</div>
    {{/if}}

</dialog>
