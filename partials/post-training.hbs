{{!-- partials/post-training.hbs
     Single shared partial for both training overview and training content reader.
     Dispatched from post.hbs for both tag "#training" and tag "#training-content".
     Uses has helper to switch between the two layouts.
     Sidebar is identical for both views.
--}}

{{!-- Mobile sticky bar --}}
<div class="tc-mobile-bar" id="tcMobileBar">
  <span class="tc-mobile-bar__title">{{title}}</span>
  <button class="tc-mobile-bar__btn" type="button"
          id="tcMobileToggle"
          aria-expanded="false"
          aria-controls="tcMobilePanel">
    <i class="ph ph-list-bullets" aria-hidden="true"></i>
    <span>All modules</span>
    <i class="ph ph-caret-down" aria-hidden="true"></i>
  </button>
</div>

{{!-- Mobile accordion panel --}}
<div class="tc-mobile-panel" id="tcMobilePanel" aria-hidden="true">
  <div class="tc-mobile-panel__inner">
    <a href="/training/" class="tc-sidebar__back">
      <i class="ph ph-arrow-left" aria-hidden="true"></i>
      All training
    </a>
    {{!-- All trainings grouped --}}
    {{#get "posts"
      filter="tag:hash-training"
      order="published_at asc"
      limit="100"
    }}
      {{#foreach posts}}
        <div class="tc-sidebar__group">
          <a href="{{url}}"
             class="tc-sidebar__group-hd{{#match id ../../id}} is-active{{/match}}">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="xxs"}}"
                   alt="" class="tc-sidebar__group-img" aria-hidden="true">
            {{else}}
              <span class="tc-sidebar__group-icon" aria-hidden="true">
                <i class="ph ph-stack"></i>
              </span>
            {{/if}}
            <span>{{title}}</span>
          </a>
          {{#get "posts"
            filter="tag:hash-training-content+primary_tag:{{slug}}"
            order="published_at asc"
            limit="100"
          }}
            {{#if posts}}
              <ul class="menu-list tc-sidebar__list">
                {{#foreach posts}}
                  <li>
                    <a href="{{url}}"
                       class="tc-sidebar__link{{#match id ../../../../id}} is-active{{/match}}">
                      <span class="tc-sidebar__num">{{@number}}</span>
                      <span class="tc-sidebar__link-text">{{title}}</span>
                    </a>
                  </li>
                {{/foreach}}
              </ul>
            {{/if}}
          {{/get}}
        </div>
      {{/foreach}}
    {{/get}}
  </div>
</div>

{{!-- Main layout --}}
<div class="tc-wrapper">
  <div class="container is-fluid">
    <div class="columns is-variable is-0">

      {{!-- LEFT SIDEBAR --}}
      <aside class="column is-3-desktop is-4-tablet is-hidden-touch tc-sidebar-col">
        <div class="tc-sidebar-sticky">
          <a href="/training/" class="tc-sidebar__back">
            <i class="ph ph-arrow-left" aria-hidden="true"></i>
            All training
          </a>
          <nav class="tc-sidebar__nav menu">
            {{!-- All trainings grouped with their modules --}}
            {{#get "posts"
              filter="tag:hash-training"
              order="published_at asc"
              limit="100"
            }}
              {{#foreach posts}}
                <div class="tc-sidebar__group">
                  <a href="{{url}}"
                     class="tc-sidebar__group-hd{{#match id ../../id}} is-active{{/match}}">
                    {{#if feature_image}}
                      <img src="{{img_url feature_image size="xxs"}}"
                           alt="" class="tc-sidebar__group-img" aria-hidden="true">
                    {{else}}
                      <span class="tc-sidebar__group-icon" aria-hidden="true">
                        <i class="ph ph-stack"></i>
                      </span>
                    {{/if}}
                    <span>{{title}}</span>
                  </a>
                  {{#get "posts"
                    filter="tag:hash-training-content+primary_tag:{{slug}}"
                    order="published_at asc"
                    limit="100"
                  }}
                    {{#if posts}}
                      <ul class="menu-list tc-sidebar__list">
                        {{#foreach posts}}
                          <li>
                            <a href="{{url}}"
                               class="tc-sidebar__link{{#match id ../../../../id}} is-active{{/match}}">
                              <span class="tc-sidebar__num">{{@number}}</span>
                              <span class="tc-sidebar__link-text">{{title}}</span>
                            </a>
                          </li>
                        {{/foreach}}
                      </ul>
                    {{/if}}
                  {{/get}}
                </div>
              {{/foreach}}
            {{/get}}
          </nav>
        </div>
      </aside>

      {{!-- MAIN CONTENT: switches between overview and reader --}}
      <main class="column is-12-mobile is-8-tablet is-7-desktop tc-main-col">

        {{!-- TRAINING OVERVIEW layout --}}
        {{#has tag="#training"}}

          <div class="tc-overview">

            {{!-- Breadcrumb --}}
            <nav class="tc-breadcrumb" aria-label="breadcrumb">
              <a href="/">Home</a>
              <i class="ph ph-caret-right" aria-hidden="true"></i>
              <a href="/training/">Training</a>
              <i class="ph ph-caret-right" aria-hidden="true"></i>
              <span>{{title}}</span>
            </nav>

            {{!-- Hero card --}}
            <div class="tc-overview__hero">
              {{#if feature_image}}
                <div class="tc-overview__hero-cover">
                  <img src="{{img_url feature_image size="l"}}"
                       alt="{{title}}" loading="lazy">
                </div>
              {{/if}}
              <div class="tc-overview__hero-body">
                {{#if primary_tag}}
                  <div class="tc-overview__cat">
                    {{#if primary_tag.feature_image}}
                      <img src="{{img_url primary_tag.feature_image size="xxs"}}"
                           alt="" class="tc-overview__cat-img"
                           aria-hidden="true" loading="lazy">
                    {{else}}
                      <span class="tc-overview__cat-icon" aria-hidden="true">
                        <i class="ph ph-tag-simple"></i>
                      </span>
                    {{/if}}
                    <span class="tc-overview__cat-name">{{primary_tag.name}}</span>
                  </div>
                {{/if}}
                <h1 class="title is-2 mb-3">{{title}}</h1>
                {{#if custom_excerpt}}
                  <p class="subtitle is-5 has-text-grey">{{custom_excerpt}}</p>
                {{/if}}
                <div class="tc-overview__stats">
                  {{#get "posts"
                    filter="tag:hash-training-content+primary_tag:{{slug}}"
                    limit="100"
                  }}
                    <span class="tc-overview__stat">
                      <i class="ph ph-stack" aria-hidden="true"></i>
                      {{posts.length}} modules
                    </span>
                  {{/get}}
                  {{#foreach tags visibility="internal"}}
                    {{#match slug "~^" "hash-training-duration-"}}
                      {{#if description}}
                        <span class="tc-overview__stat">
                          <i class="ph ph-clock" aria-hidden="true"></i>
                          {{description}}
                        </span>
                      {{/if}}
                    {{/match}}
                  {{/foreach}}
                  {{#foreach tags visibility="internal"}}
                    {{#match slug "~^" "hash-training-level-"}}
                      {{#if description}}
                        <span class="tc-overview__stat">
                          <i class="ph ph-signal-high" aria-hidden="true"></i>
                          {{description}}
                        </span>
                      {{/if}}
                    {{/match}}
                  {{/foreach}}
                  <span class="tc-overview__stat">
                    <i class="ph ph-calendar" aria-hidden="true"></i>
                    Updated {{date updated_at format="MMM YYYY"}}
                  </span>
                </div>
                {{#primary_author}}
                  <div class="tc-overview__author">
                    {{#if profile_image}}
                      <img src="{{img_url profile_image size="xs"}}"
                           alt="{{name}}" class="tc-overview__author-img" loading="lazy">
                    {{else}}
                      <i class="ph ph-user-circle" aria-hidden="true"
                         style="font-size:2rem;color:var(--theme-text-weak)"></i>
                    {{/if}}
                    <div>
                      <p style="font-size:.75rem;color:var(--theme-text-weak);margin:0">By</p>
                      <p style="font-weight:700;margin:0">{{name}}</p>
                    </div>
                  </div>
                {{/primary_author}}
                {{!-- CTA: first module --}}
                {{#get "posts"
                  filter="tag:hash-training-content+primary_tag:{{slug}}"
                  order="published_at asc"
                  limit="1"
                }}
                  {{#foreach posts}}
                    <div class="tc-overview__ctas">
                      <a href="{{url}}" class="button is-primary is-medium">
                        <span class="icon is-small">
                          <i class="ph ph-rocket-launch" aria-hidden="true"></i>
                        </span>
                        <span>Start Training</span>
                      </a>
                    </div>
                  {{else}}
                    <div class="tc-overview__ctas">
                      <span class="button is-primary is-medium" style="opacity:.5;pointer-events:none">
                        Coming soon
                      </span>
                    </div>
                  {{/foreach}}
                {{/get}}
              </div>
            </div>

            {{!-- About content --}}
            {{#if content}}
              <div class="tc-overview__about">
                <h2 class="title is-4 mb-4">About this training</h2>
                <div class="content gh-content">{{content}}</div>
              </div>
            {{/if}}

            {{!-- Module grid --}}
            {{#get "posts"
              filter="tag:hash-training-content+primary_tag:{{slug}}"
              order="published_at asc"
              limit="100"
              include="tags"
            }}
              {{#if posts}}
                <div class="tc-overview__modules">
                  <h2 class="title is-4 mb-4">
                    Course Modules
                    <span class="tag is-light ml-2">{{posts.length}} modules</span>
                  </h2>
                  <div class="tc-mod-grid">
                    {{#foreach posts}}
                      <a href="{{url}}" class="tc-mod-card">
                        <div class="tc-mod-card__num">{{@number}}</div>
                        <div class="tc-mod-card__body">
                          <p class="tc-mod-card__title">{{title}}</p>
                          {{#if custom_excerpt}}
                            <p class="tc-mod-card__excerpt">{{custom_excerpt}}</p>
                          {{/if}}
                        </div>
                        <div class="tc-mod-card__meta">
                          <span>
                            <i class="ph ph-timer" aria-hidden="true"></i>
                            {{reading_time}}
                          </span>
                        </div>
                        <i class="ph ph-arrow-right tc-mod-card__arrow" aria-hidden="true"></i>
                      </a>
                    {{/foreach}}
                  </div>
                </div>
              {{else}}
                <div class="tc-overview__modules">
                  <p class="has-text-grey is-size-6">No modules published yet.</p>
                </div>
              {{/if}}
            {{/get}}

          </div>

        {{!-- TRAINING CONTENT (module reader) layout --}}
        {{else has tag="#training-content"}}

          <article class="box is-shadowless tc-reader">
            <div class="content gh-content">

              <header class="tc-reader__header">
                <div class="tags mb-3">
                  <span class="tag is-primary is-light">Module</span>
                  {{#if primary_tag}}
                    <a href="{{primary_tag.url}}" class="tag is-light">
                      {{primary_tag.name}}
                    </a>
                  {{/if}}
                  <span class="tag is-white has-text-grey">
                    <span class="icon is-small">
                      <i class="ph ph-clock" aria-hidden="true"></i>
                    </span>
                    <span>{{reading_time}}</span>
                  </span>
                </div>
                <h1 class="title is-2 is-size-3-mobile mb-3">{{title}}</h1>
                {{#if custom_excerpt}}
                  <p class="subtitle is-4 is-size-5-mobile has-text-grey mt-3">
                    {{custom_excerpt}}
                  </p>
                {{/if}}
                {{#primary_author}}
                  <div class="tc-reader__author">
                    {{#if profile_image}}
                      <img src="{{img_url profile_image size="xxs"}}"
                           alt="{{name}}" loading="lazy" class="tc-reader__author-img">
                    {{/if}}
                    <span class="tc-reader__author-name">{{name}}</span>
                    {{#if updated_at}}
                      <span class="tc-reader__author-date">
                        · Updated {{date updated_at format="MMM D, YYYY"}}
                      </span>
                    {{/if}}
                  </div>
                {{/primary_author}}
              </header>

              {{#if feature_image}}
                <figure class="tc-reader__cover">
                  <img src="{{img_url feature_image size="xl"}}"
                       alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                       loading="lazy">
                </figure>
              {{/if}}

              <div class="tc-reader__body js-toc-content">
                {{content}}
              </div>

              {{!-- Prev / Next --}}
              <nav class="tc-reader__pager" aria-label="Module navigation">
                <div class="tc-reader__pager-prev">
                  {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
                    <a href="{{url}}" class="tc-reader__pager-link">
                      <span class="tc-reader__pager-dir">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i>
                        Previous
                      </span>
                      <span class="tc-reader__pager-title">{{title}}</span>
                    </a>
                  {{/prev_post}}
                </div>
                <div class="tc-reader__pager-next">
                  {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
                    <a href="{{url}}"
                       class="tc-reader__pager-link tc-reader__pager-link--right">
                      <span class="tc-reader__pager-dir">
                        Next
                        <i class="ph ph-arrow-right" aria-hidden="true"></i>
                      </span>
                      <span class="tc-reader__pager-title">{{title}}</span>
                    </a>
                  {{else}}
                    {{#get "posts"
                      filter="tag:hash-training+slug:{{primary_tag.slug}}"
                      limit="1"
                    }}
                      {{#foreach posts}}
                        <a href="{{url}}"
                           class="tc-reader__pager-link tc-reader__pager-link--right
                                  tc-reader__pager-link--done">
                          <span class="tc-reader__pager-dir">
                            <i class="ph ph-check-circle" aria-hidden="true"></i>
                            Finish training
                          </span>
                          <span class="tc-reader__pager-title">{{title}}</span>
                        </a>
                      {{else}}
                        <a href="/training/"
                           class="tc-reader__pager-link tc-reader__pager-link--right
                                  tc-reader__pager-link--done">
                          <span class="tc-reader__pager-dir">
                            <i class="ph ph-check-circle" aria-hidden="true"></i>
                            All done
                          </span>
                          <span class="tc-reader__pager-title">Back to training</span>
                        </a>
                      {{/foreach}}
                    {{/get}}
                  {{/next_post}}
                </div>
              </nav>

            </div>
          </article>

        {{/has}}
      </main>

      {{!-- RIGHT TOC (desktop, reader view only) --}}
      {{#has tag="#training-content"}}
        <aside class="column is-2-desktop is-hidden-touch tc-toc-col">
          <div class="tc-toc-sticky">
            <div class="box is-shadowless">
              <p class="heading has-text-weight-bold has-text-grey mb-3">On this page</p>
              <div class="tc-toc js-toc content is-small menu"></div>
            </div>
          </div>
        </aside>
      {{/has}}

    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var toggle = document.getElementById('tcMobileToggle');
  var panel  = document.getElementById('tcMobilePanel');
  if (!toggle || !panel) return;

  function setOpen(open) {
    panel.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
    var caret = toggle.querySelector('.ph-caret-down');
    if (caret) caret.style.transform = open ? 'rotate(180deg)' : '';
  }

  toggle.addEventListener('click', function () {
    setOpen(!panel.classList.contains('is-open'));
  });
  document.addEventListener('click', function (e) {
    if (panel.classList.contains('is-open') &&
        !panel.contains(e.target) &&
        !toggle.contains(e.target)) setOpen(false);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) {
      setOpen(false); toggle.focus();
    }
  });

  var active = document.querySelector('.tc-sidebar__link.is-active, .tc-sidebar__group-hd.is-active');
  if (active) {
    active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    var grp = active.closest('.tc-sidebar__group');
    if (grp) grp.classList.add('is-current');
  }
})();
</script>
