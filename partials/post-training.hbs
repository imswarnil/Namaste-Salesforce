{{!-- The module reader, v6 — the layout as specified:

    ┌──────────────┬───────────────────────────────┐
    │  TRAINING    │ HERO — full width of region,  │
    │  NAVIGATION  │ canvas grid + thumbnail       │
    │  full-height ├────────────────────┬──────────┤
    │  divide,     │                    │ small    │
    │  sticky      │  CONTENT           │ sidebar  │
    │  (all        │                    │ (toc,    │
    │  modules,    │                    │ share)   │
    │  active open)│                    │          │
    └──────────────┴────────────────────┴──────────┘

The nav rail is on the LEFT, the side the lesson player keeps
its rail on — the two readers should not disagree about where
"where am I" lives.

Site TOC rule: sidebars exist → the TOC lives in a sidebar; here
that is the small right-hand one. Video-typed pages flip the hero
to the dark cinematic variant. prev/next walks in="primary_tag".
Context: a training post. --}}

{{#contentFor "head"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{t "Training"}}", "item": "{{@site.url}}/training/" },
        {{#primary_tag}}
        { "@type": "ListItem", "position": 2, "name": "{{name}}", "item": "{{@site.url}}/training/{{slug}}/" },
        {{/primary_tag}}
        { "@type": "ListItem", "position": 3, "name": "{{title}}" }
    ]
}
</script>
{{/contentFor}}

<div class="trainer2">

    {{!-- LEFT: the training navigation, full-height divide --}}
    <aside class="trainer2-nav">
        {{> "rail-toggle"}}

        <div class="trainer2-nav-scroll">
            {{!-- Training home — the first item in the nav, styled as
            a row like every module under it, not a pill floating
            above them. --}}
            <a class="rail-home" href="{{@site.url}}/training/">
                <span class="rail-home-ico" aria-hidden="true">{{> "icons/layers"}}</span>
                <span class="rail-home-label">{{t "Training home"}}</span>
                {{> "icons/arrow-right"}}
            </a>
            {{> "training-list" currentSlug=slug currentModule=primary_tag.slug}}
        </div>
    </aside>

    {{!-- RIGHT REGION: hero, then content + sidebar --}}
    <div class="trainer2-left">

        {{!-- Video pages open with the player; article pages open
        with the cover. Both title blocks are partials/trainer-head.hbs
        — on a video page it renders below the stage, in the reading
        column, because the video has the hero to itself. --}}
        {{> "video-stage"}}

        {{#match (post_class) "~" "tag-hash-lesson-type-video"}}{{else}}
            <section class="trainer-hero relative">
                <div class="bg-grid" aria-hidden="true"></div>
                <div class="trainer-hero-inner">
                    {{> "trainer-head" crumbTail=true}}

                    {{#if feature_image}}
                        <div class="trainer-hero-media">
                            <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager" fetchpriority="high" />
                        </div>
                    {{/if}}
                </div>
            </section>
        {{/match}}

        <div class="trainer2-body">

            <main id="site-main" class="trainer-main">

                {{!-- Mobile: module nav folds in above the content --}}
                <details class="trainer-nav-mobile">
                    <summary>
                        {{> "icons/layers"}}
                        {{t "Modules"}}
                        <span class="chev">{{> "icons/chevron-down"}}</span>
                    </summary>
                    <div class="trainer-nav-mobile-body">
                        {{> "training-list" currentSlug=slug currentModule=primary_tag.slug}}
                    </div>
                </details>

                <article class="trainer-article {{post_class}}">
                    {{#match (post_class) "~" "tag-hash-lesson-type-video"}}
                        <header class="trainer-article-head">
                            {{> "trainer-head" crumbTail=true}}
                        </header>
                    {{/match}}

                    {{#if access}}
                    <section class="gh-content">
                        {{content}}
                    </section>
                    {{else}}
                        {{!-- Members-only and this reader is outside: the locked
                        surface instead of a truncated article. --}}
                        {{> "reader-locked"}}
                    {{/if}}

                            <nav class="post-nav" aria-label="{{t "Module navigation"}}">
                        {{#prev_post in="primary_tag"}}
                            <a class="post-nav-link post-nav-prev" href="{{url}}">
                                <span class="post-nav-label">{{> "icons/arrow-left"}} {{t "Previous"}}</span>
                                <span class="post-nav-title">{{title}}</span>
                            </a>
                        {{/prev_post}}
                        {{#next_post in="primary_tag"}}
                            <a class="post-nav-link post-nav-next" href="{{url}}">
                                <span class="post-nav-label">{{t "Next"}} {{> "icons/arrow-right"}}</span>
                                <span class="post-nav-title">{{title}}</span>
                            </a>
                        {{else}}
                            {{!-- Last page of this module: cross into the next
                            one. Modules order by tag slug — the same walk
                            training-list does — so the next module is the
                            first later-slugged public tag that has training
                            posts. Every candidate renders a card; CSS keeps
                            only the first (.post-nav-module ~ hides the rest),
                            because foreach cannot break. --}}
                            {{#get "tags" filter="visibility:public+slug:>'{{primary_tag.slug}}'" order="slug asc" limit="15" as |laterTags|}}
                                {{#foreach laterTags}}
                                    {{#> "with-this" moduleTag=.}}
                                        {{#get "posts" filter="tag:{{moduleTag.slug}}+tag:hash-training" order="published_at asc" limit="1" as |firstpage|}}
                                            {{#foreach firstpage}}
                                                <a class="post-nav-link post-nav-next post-nav-module" href="{{url}}">
                                                    <span class="post-nav-label">{{t "Next module"}} {{> "icons/arrow-right"}}</span>
                                                    <span class="post-nav-title">{{../../moduleTag.name}} — {{title}}</span>
                                                </a>
                                            {{/foreach}}
                                        {{/get}}
                                    {{/with-this}}
                                {{/foreach}}
                            {{/get}}
                        {{/next_post}}
                    </nav>
                </article>

            </main>

            {{!-- TOC, then the share row on one line. No sponsor
            card: /training and the module landing pages both
            dropped theirs, and this page sits between them. --}}
            {{!-- Sidebar order is reading order: where am I in this
            video (chapters), what is on this page (TOC), who wrote it,
            and only then the ask. Share sits last because it is the one
            thing nobody needs until they have finished. --}}
            <aside class="trainer-side">
                <div class="trainer-side-sticky">
                    {{> "widgets/chapters"}}
                    {{> "widgets/toc"}}
                    {{> "widgets/author"}}
                    {{> "widgets/share-compact"}}
                </div>
            </aside>

        </div>
    </div>

</div>

{{> "lesson-bar"}}
