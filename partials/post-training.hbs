{{!-- partials/post-training.hbs --}}

<section
  class="section"
  data-training-shell
  data-current-slug="{{slug}}"
  data-current-module="{{primary_tag.slug}}"
>
  <nav class="navbar is-dark" role="navigation" aria-label="training navigation">
    <div class="navbar-brand">
      <div class="navbar-item">
        {{#has tag="#training-content"}}
          {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |module_posts|}}
            {{#if module_posts.[0]}}
              {{#foreach module_posts}}
                <a href="{{url}}" class="button is-dark is-small mr-3">
                  <span class="icon"><i class="ph ph-caret-left"></i></span>
                  <span>Back</span>
                </a>
                <span class="has-text-weight-semibold">{{title}}</span>
              {{/foreach}}
            {{else}}
              <a href="/training/" class="button is-dark is-small mr-3">
                <span class="icon"><i class="ph ph-caret-left"></i></span>
                <span>Back</span>
              </a>
              <span class="has-text-weight-semibold">{{primary_tag.name}}</span>
            {{/if}}
          {{/get}}
        {{else}}
          <a href="/training/" class="button is-dark is-small mr-3">
            <span class="icon"><i class="ph ph-caret-left"></i></span>
            <span>Back</span>
          </a>
          <span class="has-text-weight-semibold">{{title}}</span>
        {{/has}}
      </div>
    </div>

    <div class="navbar-end">
      <div class="navbar-item">
        <a href="/training/" class="button is-link is-light is-small">
          <span class="icon"><i class="ph ph-book-open"></i></span>
          <span>Training Hub</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="container is-fluid mt-5">
    <div class="columns is-variable is-5">

      {{!-- MAIN --}}
      <main class="column is-12-tablet is-8-desktop">
        {{#if feature_image}}
          <figure class="image mb-4">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
          </figure>
        {{else}}
          <article class="message is-dark mb-4">
            <div class="message-body">
              <p class="has-text-weight-semibold">{{title}}</p>
              <p class="is-size-7">{{primary_tag.name}}</p>
            </div>
          </article>
        {{/if}}

        {{!-- ACTION BAR --}}
        <div class="box mb-4">
          <div class="level is-mobile">
            <div class="level-left">
              <div class="level-item">
                {{!-- PREVIOUS --}}
                {{#has tag="#training-section"}}
                  {{#get "posts" filter="tag:hash-training-content+published_at:<'{{published_at}}'" limit="1" order="published_at desc" as |prev_lessons|}}
                    {{#if prev_lessons.[0]}}
                      {{#foreach prev_lessons}}
                        <a href="{{url}}" class="button is-light">
                          <span class="icon"><i class="ph ph-arrow-left"></i></span>
                          <span>Previous</span>
                        </a>
                      {{/foreach}}
                    {{else}}
                      <button class="button is-light" disabled>
                        <span class="icon"><i class="ph ph-arrow-left"></i></span>
                        <span>Previous</span>
                      </button>
                    {{/if}}
                  {{/get}}
                {{else}}
                  {{#get "posts" filter="tag:hash-training-content+published_at:<'{{published_at}}'" limit="1" order="published_at desc" as |prev_lessons|}}
                    {{#if prev_lessons.[0]}}
                      {{#foreach prev_lessons}}
                        <a href="{{url}}" class="button is-light">
                          <span class="icon"><i class="ph ph-arrow-left"></i></span>
                          <span>Previous</span>
                        </a>
                      {{/foreach}}
                    {{else}}
                      {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |module_posts|}}
                        {{#if module_posts.[0]}}
                          {{#foreach module_posts}}
                            <a href="{{url}}" class="button is-light">
                              <span class="icon"><i class="ph ph-arrow-left"></i></span>
                              <span>Overview</span>
                            </a>
                          {{/foreach}}
                        {{else}}
                          <button class="button is-light" disabled>
                            <span class="icon"><i class="ph ph-arrow-left"></i></span>
                            <span>Previous</span>
                          </button>
                        {{/if}}
                      {{/get}}
                    {{/if}}
                  {{/get}}
                {{/has}}
              </div>
            </div>

            <div class="level-right">
              <div class="level-item">
                <div class="buttons mb-0">
                  <button class="button is-light" type="button">
                    <span class="icon"><i class="ph ph-bookmark-simple"></i></span>
                    <span>Bookmark</span>
                  </button>

                  {{!-- NEXT --}}
                  {{#has tag="#training-section"}}
                    {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" limit="1" order="published_at asc" as |first_module_lessons|}}
                      {{#if first_module_lessons.[0]}}
                        {{#foreach first_module_lessons}}
                          <a href="{{url}}" class="button is-primary">
                            <span>Start Module</span>
                            <span class="icon"><i class="ph ph-arrow-right"></i></span>
                          </a>
                        {{/foreach}}
                      {{else}}
                        {{#get "posts" filter="tag:hash-training-content+published_at:>'{{published_at}}'" limit="1" order="published_at asc" as |next_lessons|}}
                          {{#if next_lessons.[0]}}
                            {{#foreach next_lessons}}
                              <a href="{{url}}" class="button is-primary">
                                <span>Next</span>
                                <span class="icon"><i class="ph ph-arrow-right"></i></span>
                              </a>
                            {{/foreach}}
                          {{else}}
                            <button class="button is-primary" disabled>End of Training</button>
                          {{/if}}
                        {{/get}}
                      {{/if}}
                    {{/get}}
                  {{else}}
                    {{#get "posts" filter="tag:hash-training-content+published_at:>'{{published_at}}'" limit="1" order="published_at asc" as |next_lessons|}}
                      {{#if next_lessons.[0]}}
                        {{#foreach next_lessons}}
                          <a href="{{url}}" class="button is-primary">
                            <span>Complete & Continue</span>
                            <span class="icon"><i class="ph ph-arrow-right"></i></span>
                          </a>
                        {{/foreach}}
                      {{else}}
                        <button class="button is-primary" disabled>End of Training</button>
                      {{/if}}
                    {{/get}}
                  {{/has}}
                </div>
              </div>
            </div>
          </div>
        </div>

        {{!-- CONTENT CARD --}}
        <div class="box">
          <div class="tabs is-boxed mb-5">
            <ul>
              <li class="is-active"><a>Overview</a></li>
              <li><a href="/training/">All Modules</a></li>
              <li><a href="#curriculum">Curriculum</a></li>
            </ul>
          </div>

          <div class="content">
            {{#has tag="#training-section"}}
              <span class="tag is-link is-light mb-3">Training Module</span>
              <h1 class="title is-3">{{title}}</h1>
              <p class="subtitle is-6">{{primary_tag.name}}</p>

              {{#if custom_excerpt}}
                <article class="message is-light mb-4">
                  <div class="message-body">
                    {{custom_excerpt}}
                  </div>
                </article>
              {{/if}}

              {{content}}

              <hr>

              <h2 class="title is-5">Lessons in this module</h2>

              <nav class="panel">
                {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" limit="all" order="published_at asc" as |module_lessons|}}
                  {{#foreach module_lessons}}
                    <a href="{{url}}" class="panel-block">
                      <span class="panel-icon"><i class="ph ph-play-circle"></i></span>
                      <span>
                        <span class="is-block">{{title}}</span>
                        <span class="is-size-7 has-text-grey">{{reading_time}}</span>
                      </span>
                    </a>
                  {{else}}
                    <div class="panel-block has-text-grey">No lessons yet.</div>
                  {{/foreach}}
                {{/get}}
              </nav>

            {{else}}
              {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |module_posts|}}
                {{#if module_posts.[0]}}
                  {{#foreach module_posts}}
                    <p class="mb-3">
                      <a href="{{url}}" class="button is-white is-small">
                        <span class="icon"><i class="ph ph-caret-left"></i></span>
                        <span>{{title}}</span>
                      </a>
                    </p>
                  {{/foreach}}
                {{/if}}
              {{/get}}

              <span class="tag is-primary is-light mb-3">Lesson</span>
              <h1 class="title is-3">{{title}}</h1>
              <p class="subtitle is-6">{{primary_tag.name}} • {{reading_time}}</p>

              {{#if custom_excerpt}}
                <article class="message is-light mb-4">
                  <div class="message-body">
                    {{custom_excerpt}}
                  </div>
                </article>
              {{/if}}

              {{content}}
            {{/has}}
          </div>
        </div>
      </main>

      {{!-- SIDEBAR --}}
      <aside class="column is-12-tablet is-4-desktop" id="curriculum">
        <div class="box">
          <h2 class="title is-5 mb-2">Course Content</h2>
          <p class="is-size-7 has-text-grey mb-4">All modules and lessons</p>

          <aside class="menu" data-training-sidebar>
            {{#get "posts" filter="tag:hash-training-section" limit="all" order="published_at asc" as |sections|}}
              {{#foreach sections}}
                <div class="mb-4" data-module-block="{{slug}}">
                  <p class="menu-label mb-2">
                    <button
                      type="button"
                      class="button is-light is-small is-fullwidth"
                      data-module-toggle="{{slug}}"
                      aria-expanded="false"
                    >
                      <span class="is-flex is-align-items-center is-justify-content-space-between" style="width:100%;">
                        <span class="icon-text">
                          <span class="icon" data-module-icon>
                            <i class="ph ph-folder-open"></i>
                          </span>
                          <span>{{@number}}. {{title}}</span>
                        </span>

                        <span class="icon" data-module-caret>
                          <i class="ph ph-caret-down"></i>
                        </span>
                      </span>
                    </button>
                  </p>

                  <ul class="menu-list is-hidden" data-module-list="{{slug}}">
                    <li>
                      <a
                        href="{{url}}"
                        data-link-slug="{{slug}}"
                        data-link-module="{{slug}}"
                        data-link-kind="overview"
                      >
                        <span class="icon-text">
                          <span class="icon is-small" data-link-icon>
                            <i class="ph ph-book-open"></i>
                          </span>
                          <span>Overview</span>
                        </span>
                      </a>

                      {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="all" order="published_at asc" as |section_lessons|}}
                        {{#if section_lessons.[0]}}
                          <ul>
                            {{#foreach section_lessons}}
                              <li>
                                <a
                                  href="{{url}}"
                                  data-link-slug="{{slug}}"
                                  data-link-module="{{../slug}}"
                                  data-link-kind="lesson"
                                >
                                  <span class="icon-text">
                                    <span class="icon is-small" data-link-icon>
                                      <i class="ph ph-play-circle"></i>
                                    </span>
                                    <span>
                                      <span class="is-block">{{title}}</span>
                                      <span class="is-size-7 has-text-grey">{{reading_time}}</span>
                                    </span>
                                  </span>
                                </a>
                              </li>
                            {{/foreach}}
                          </ul>
                        {{else}}
                          <ul>
                            <li>
                              <a class="is-static has-text-grey">
                                No lessons yet
                              </a>
                            </li>
                          </ul>
                        {{/if}}
                      {{/get}}
                    </li>
                  </ul>
                </div>
              {{else}}
                <article class="message is-light">
                  <div class="message-body">No training sections found.</div>
                </article>
              {{/foreach}}
            {{/get}}
          </aside>
        </div>
      </aside>

    </div>
  </div>
</section>