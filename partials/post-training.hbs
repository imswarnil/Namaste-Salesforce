{{!-- post-training.hbs — Training player layout.
     Dispatched for #training (overview) and #training-content (reader).
     Sidebar lists all training modules + their steps. --}}

<div class="training-player">

    {{!-- Player top nav --}}
    <nav class="training-player__topbar" aria-label="{{t "Training navigation"}}">
        <a href="/training/" class="btn btn-ghost btn-sm training-player__back">
            <i class="ph ph-caret-left btn-icon" aria-hidden="true"></i>
            {{t "All Training"}}
        </a>
        {{#has tag="#training-content"}}
            <div class="training-player__breadcrumb">
                {{#get "posts" filter="tag:hash-training+slug:{{primary_tag.slug}}" limit="1"}}
                    {{#foreach posts}}<a href="{{url}}" class="training-player__breadcrumb-link">{{title}}</a>{{/foreach}}
                {{/get}}
                <i class="ph ph-caret-right" aria-hidden="true"></i>
                <span>{{title}}</span>
            </div>
        {{else has tag="#training"}}
            <span class="training-player__breadcrumb-link sfdc-font-semibold">{{title}}</span>
        {{/has}}
        <span class="training-player__badge">
            <i class="ph ph-graduation-cap" aria-hidden="true"></i>{{t "Training"}}
        </span>
    </nav>

    {{!-- Mobile bar + panel --}}
    <div class="training-mob-bar" id="trainingMobBar">
        <span class="training-mob-bar__title">{{title}}</span>
        <button class="btn btn-neutral btn-sm" id="trainingMobToggle" aria-expanded="false" aria-controls="trainingMobPanel">
            <i class="ph ph-list-bullets btn-icon" aria-hidden="true"></i>{{t "Modules"}}
            <i class="ph ph-caret-down btn-icon training-mob-caret" aria-hidden="true"></i>
        </button>
    </div>

    <div class="training-mob-panel" id="trainingMobPanel" aria-hidden="true">
        <div class="training-sidebar__body">
            {{#get "posts" filter="tag:hash-training" order="published_at asc" limit="100"}}
                {{#foreach posts}}
                    <div class="training-sidebar__group">
                        <a href="{{url}}" class="training-sidebar__group-hd{{#match id ../../id}} is-active{{/match}}">
                            <i class="ph ph-stack" aria-hidden="true"></i>
                            <span>{{title}}</span>
                        </a>
                        {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="100"}}
                            {{#if posts}}<div class="training-sidebar__lessons">
                                {{#foreach posts}}
                                    <a href="{{url}}" class="training-sidebar__lesson{{#match id ../../../../id}} is-active{{/match}}">
                                        <i class="ph ph-play-circle" aria-hidden="true"></i>
                                        <span>{{title}}</span>
                                        <span class="sfdc-text-xs sfdc-text-weak">{{reading_time}}</span>
                                    </a>
                                {{/foreach}}
                            </div>{{/if}}
                        {{/get}}
                    </div>
                {{/foreach}}
            {{/get}}
        </div>
    </div>

    {{!-- Player body --}}
    <div class="training-player__body">

        {{!-- MAIN CONTENT --}}
        <main class="training-player__main">

            {{!-- OVERVIEW layout --}}
            {{#has tag="#training"}}
                <div class="training-overview outer"><div class="inner">
                    <nav class="doc-breadcrumb sfdc-mb-xl" aria-label="{{t "Breadcrumb"}}">
                        <a href="/">{{t "Home"}}</a><i class="ph ph-caret-right" aria-hidden="true"></i>
                        <a href="/training/">{{t "Training"}}</a><i class="ph ph-caret-right" aria-hidden="true"></i>
                        <span aria-current="page">{{title}}</span>
                    </nav>

                    {{#if feature_image}}
                        <figure class="training-overview__hero-image">
                            <img src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="eager" />
                        </figure>
                    {{/if}}

                    <h1 class="sfdc-mt-xl" style="font-size:var(--sfdc-font-size-h1)">{{title}}</h1>
                    {{#if custom_excerpt}}<p class="lead sfdc-mt-md">{{custom_excerpt}}</p>{{/if}}

                    <div class="sfdc-flex sfdc-gap-xl sfdc-flex-wrap sfdc-mt-xl sfdc-mb-2xl">
                        {{#foreach tags visibility="internal"}}
                            {{#match slug "~^" "hash-training-duration-"}}{{#if description}}
                                <span class="sfdc-flex sfdc-gap-xs sfdc-items-center sfdc-text-sm sfdc-text-weak"><i class="ph ph-clock" aria-hidden="true"></i>{{description}}</span>
                            {{/if}}{{/match}}
                            {{#match slug "~^" "hash-training-level-"}}{{#if description}}
                                <span class="sfdc-flex sfdc-gap-xs sfdc-items-center sfdc-text-sm sfdc-text-weak"><i class="ph ph-signal-high" aria-hidden="true"></i>{{description}}</span>
                            {{/if}}{{/match}}
                        {{/foreach}}
                        <time class="sfdc-flex sfdc-gap-xs sfdc-items-center sfdc-text-sm sfdc-text-weak" datetime="{{date updated_at format="YYYY-MM-DD"}}">
                            <i class="ph ph-calendar" aria-hidden="true"></i>{{t "Updated"}} {{date updated_at format="MMM YYYY"}}
                        </time>
                    </div>

                    {{#primary_author}}<div class="sfdc-flex sfdc-gap-md sfdc-items-center sfdc-mb-2xl">
                        {{#if profile_image}}<img class="course-hero__author-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy" />{{/if}}
                        <div><p class="sfdc-text-xs sfdc-text-weak sfdc-mb-0">{{t "Instructor"}}</p><strong>{{name}}</strong></div>
                    </div>{{/primary_author}}

                    {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="1"}}
                        {{#foreach posts}}
                            <div class="sfdc-flex sfdc-gap-md sfdc-mb-3xl">
                                <a href="{{url}}" class="btn btn-primary btn-lg btn-pill">
                                    <i class="ph ph-rocket-launch btn-icon" aria-hidden="true"></i>{{t "Start Training"}}
                                </a>
                                <a href="/training/" class="btn btn-neutral btn-lg btn-pill">{{t "All courses"}}</a>
                            </div>
                        {{else}}
                            <p class="sfdc-text-weak sfdc-mb-3xl">{{t "Coming soon — no modules published yet."}}</p>
                        {{/foreach}}
                    {{/get}}

                    {{#if content}}<div class="training-overview__about">
                        <h2 class="sfdc-mb-xl" style="font-size:var(--sfdc-font-size-h3)">{{t "About this training"}}</h2>
                        <div class="gh-content">{{content}}</div>
                    </div>{{/if}}

                    {{!-- Module list --}}
                    {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="100"}}
                        {{#if posts}}<div class="training-overview__modules sfdc-mt-3xl">
                            <div class="sfdc-flex sfdc-justify-between sfdc-items-center sfdc-mb-xl">
                                <h2 style="font-size:var(--sfdc-font-size-h3);margin:0">{{t "Course Modules"}}</h2>
                                <span class="sfdc-text-sm sfdc-text-weak">{{posts.length}} {{t "modules"}}</span>
                            </div>
                            {{#foreach posts}}
                                <a href="{{url}}" class="training-mod-row">
                                    <span class="training-mod-row__num">{{@number}}</span>
                                    <div class="training-mod-row__body">
                                        <p class="training-mod-row__title">{{title}}</p>
                                        {{#if custom_excerpt}}<p class="training-mod-row__sub">{{custom_excerpt}}</p>{{/if}}
                                    </div>
                                    <span class="sfdc-text-xs sfdc-text-weak">{{reading_time}}</span>
                                    <i class="ph ph-arrow-right" aria-hidden="true"></i>
                                </a>
                            {{/foreach}}
                        </div>
                        {{else}}<p class="sfdc-text-weak sfdc-mt-xl">{{t "No modules published yet."}}</p>
                        {{/if}}
                    {{/get}}
                </div></div>
            {{/has}}

            {{!-- MODULE READER layout --}}
            {{#has tag="#training-content"}}
                <div class="training-lesson-bar">
                    {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
                        <a href="{{url}}" class="btn btn-neutral btn-sm"><i class="ph ph-arrow-left btn-icon" aria-hidden="true"></i>{{t "Previous"}}</a>
                    {{else}}<button class="btn btn-neutral btn-sm" disabled><i class="ph ph-arrow-left btn-icon" aria-hidden="true"></i>{{t "Previous"}}</button>
                    {{/prev_post}}
                    <span class="training-lesson-bar__title">{{title}}</span>
                    {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
                        <a href="{{url}}" class="btn btn-primary btn-sm">{{t "Continue"}}<i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i></a>
                    {{else}}
                        {{#get "posts" filter="tag:hash-training+slug:{{primary_tag.slug}}" limit="1"}}
                            {{#foreach posts}}<a href="{{url}}" class="btn btn-soft-success btn-sm"><i class="ph ph-check-circle btn-icon" aria-hidden="true"></i>{{t "Finish"}}</a>{{/foreach}}
                        {{/get}}
                    {{/next_post}}
                </div>

                {{#if feature_image}}
                    <div class="training-lesson-cover">
                        <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager" />
                    </div>
                {{/if}}

                <div class="training-lesson-content outer"><div class="inner">
                    <div class="training-lesson-doc">
                        <header class="sfdc-mb-2xl">
                            <div class="sfdc-flex sfdc-gap-sm sfdc-mb-md">
                                <span class="article-tag-link">{{t "Module"}}</span>
                                {{#if primary_tag}}<a href="{{primary_tag.url}}" class="article-tag-link">{{primary_tag.name}}</a>{{/if}}
                                {{#if reading_time}}<span class="sfdc-text-sm sfdc-text-weak sfdc-flex sfdc-gap-xs sfdc-items-center">
                                    <i class="ph ph-clock" aria-hidden="true"></i>{{reading_time}}
                                </span>{{/if}}
                            </div>
                            <h1 style="font-size:var(--sfdc-font-size-h2)">{{title}}</h1>
                            {{#if custom_excerpt}}<p class="lead sfdc-mt-md">{{custom_excerpt}}</p>{{/if}}
                            {{> "components/author-inline"}}
                        </header>

                        <div class="gh-content js-toc-content">{{content}}</div>

                        <nav class="lesson-nav__inner sfdc-mt-3xl sfdc-pt-xl" style="border-top:1px solid var(--sfdc-border-color-divider)" aria-label="{{t "Module navigation"}}">
                            {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
                                <a class="lesson-nav__card lesson-nav__card--prev" href="{{url}}" rel="prev">
                                    <span class="lesson-nav__dir"><i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "Previous"}}</span>
                                    <span class="lesson-nav__title">{{title}}</span>
                                </a>
                            {{/prev_post}}
                            {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
                                <a class="lesson-nav__card lesson-nav__card--next" href="{{url}}" rel="next">
                                    <span class="lesson-nav__dir">{{t "Next"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                                    <span class="lesson-nav__title">{{title}}</span>
                                </a>
                            {{else}}
                                {{#get "posts" filter="tag:hash-training+slug:{{primary_tag.slug}}" limit="1"}}
                                    {{#foreach posts}}<a class="lesson-nav__card lesson-nav__card--next lesson-nav__card--done" href="{{url}}">
                                        <span class="lesson-nav__dir"><i class="ph ph-check-circle" aria-hidden="true"></i>{{t "Finish training"}}</span>
                                        <span class="lesson-nav__title">{{title}}</span>
                                    </a>{{/foreach}}
                                {{/get}}
                            {{/next_post}}
                        </nav>
                    </div>
                </div></div>
            {{/has}}
        </main>

        {{!-- RIGHT SIDEBAR (desktop) --}}
        <aside class="training-player__sidebar" aria-label="{{t "Course content"}}">
            <div class="training-sidebar__head">
                <h2>{{t "Course Content"}}</h2>
            </div>
            <div class="training-sidebar__body">
                {{#get "posts" filter="tag:hash-training" order="published_at asc" limit="100"}}
                    {{#foreach posts}}
                        <div class="training-sidebar__group">
                            <a href="{{url}}" class="training-sidebar__group-hd{{#match id ../../id}} is-active{{/match}}">
                                <i class="ph ph-stack" aria-hidden="true"></i>
                                <span>{{title}}</span>
                                <i class="ph ph-caret-down training-sidebar__caret" aria-hidden="true"></i>
                            </a>
                            {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="100"}}
                                {{#if posts}}<div class="training-sidebar__lessons">
                                    {{#foreach posts}}
                                        <a href="{{url}}" class="training-sidebar__lesson{{#match id ../../../../id}} is-active{{/match}}">
                                            <i class="ph ph-play-circle" aria-hidden="true"></i>
                                            <div>
                                                <p class="training-sidebar__lesson-title">{{title}}</p>
                                                <p class="training-sidebar__lesson-meta sfdc-text-xs sfdc-text-weak">{{reading_time}}</p>
                                            </div>
                                        </a>
                                    {{/foreach}}
                                </div>{{/if}}
                            {{/get}}
                        </div>
                    {{/foreach}}
                {{/get}}
            </div>
        </aside>

    </div>
</div>

<script>
(function(){
    'use strict';
    /* Mobile panel */
    var btn=document.getElementById('trainingMobToggle'), panel=document.getElementById('trainingMobPanel');
    if(btn&&panel){
        function set(open){ panel.classList.toggle('is-open',open); panel.setAttribute('aria-hidden',!open); btn.setAttribute('aria-expanded',open); var c=btn.querySelector('.training-mob-caret'); if(c) c.style.transform=open?'rotate(180deg)':''; }
        btn.addEventListener('click',function(){ set(!panel.classList.contains('is-open')); });
        document.addEventListener('click',function(e){ if(panel.classList.contains('is-open')&&!panel.contains(e.target)&&!btn.contains(e.target)) set(false); });
        document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&panel.classList.contains('is-open')){ set(false); btn.focus(); } });
    }
    /* Expand active sidebar group */
    var active=document.querySelector('.training-sidebar__lesson.is-active');
    if(active){ active.closest('.training-sidebar__group').classList.add('is-open'); active.scrollIntoView({block:'nearest',behavior:'smooth'}); }
})();
</script>
