{{!-- partials/post-training.hbs --}}
{{!--
  Expected content model:
  - Module / section post:
      1) Public module tag first (slug matches module post slug)
      2) #training-section

  - Lesson post:
      1) Same public module tag first
      2) #training-content
--}}

<nav class="navbar is-dark" role="navigation" aria-label="training navigation">
  <div class="navbar-brand">
    <div class="navbar-item">
      {{#has tag="#training-content"}}
        {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |module_posts|}}
          {{#if module_posts.[0]}}
            {{#foreach module_posts}}
              <a href="{{url}}" class="button is-dark is-small mr-3">
                <span class="icon"><i class="ph ph-caret-left"></i></span>
                <span>Back</span>
              </a>
              <span class="has-text-weight-semibold">{{title}}</span>
            {{/foreach}}
          {{else}}
            <a href="/training/" class="button is-dark is-small mr-3">
              <span class="icon"><i class="ph ph-caret-left"></i></span>
              <span>Back</span>
            </a>
            <span class="has-text-weight-semibold">{{primary_tag.name}}</span>
          {{/if}}
        {{/get}}
      {{else}}
        <a href="/training/" class="button is-dark is-small mr-3">
          <span class="icon"><i class="ph ph-caret-left"></i></span>
          <span>Back</span>
        </a>
        <span class="has-text-weight-semibold">{{title}}</span>
      {{/has}}
    </div>
  </div>

  <div class="navbar-end">
    <div class="navbar-item">
      <a href="/training/" class="button is-link is-light is-small">
        <span class="icon"><i class="ph ph-book-open"></i></span>
        <span>Training Hub</span>
      </a>
    </div>
  </div>
</nav>

<section class="section">
  <div class="container is-fluid">
    <div class="columns is-variable is-5">

      {{!-- MAIN --}}
      <main class="column is-12-tablet is-8-desktop">
        {{#if feature_image}}
          <figure class="image mb-4">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
          </figure>
        {{/if}}

        <div class="box">
          <div class="level is-mobile mb-4">
            <div class="level-left">
              <div class="level-item">
                {{!-- =====================================
                    PREVIOUS BUTTON
                ====================================== --}}
                {{#has tag="#training-section"}}
                  {{#get "posts" filter="tag:hash-training-section+published_at:<'{{published_at}}'" limit="1" order="published_at desc" as |prev_sections|}}
                    {{#if prev_sections.[0]}}
                      {{#foreach prev_sections}}
                        <a href="{{url}}" class="button is-light">
                          <span class="icon"><i class="ph ph-arrow-left"></i></span>
                          <span>Previous</span>
                        </a>
                      {{/foreach}}
                    {{else}}
                      <button class="button is-light" disabled>
                        <span class="icon"><i class="ph ph-arrow-left"></i></span>
                        <span>Previous</span>
                      </button>
                    {{/if}}
                  {{/get}}
                {{else}}
                  {{#prev_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-light">
                      <span class="icon"><i class="ph ph-arrow-left"></i></span>
                      <span>Previous</span>
                    </a>
                  {{else}}
                    {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |current_sections|}}
                      {{#if current_sections.[0]}}
                        {{#foreach current_sections}}
                          {{#get "posts" filter="tag:hash-training-section+published_at:<'{{published_at}}'" limit="1" order="published_at desc" as |prev_sections|}}
                            {{#if prev_sections.[0]}}
                              {{#foreach prev_sections}}
                                {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="1" order="published_at desc" as |prev_last_lessons|}}
                                  {{#if prev_last_lessons.[0]}}
                                    {{#foreach prev_last_lessons}}
                                      <a href="{{url}}" class="button is-light">
                                        <span class="icon"><i class="ph ph-arrow-left"></i></span>
                                        <span>Previous</span>
                                      </a>
                                    {{/foreach}}
                                  {{else}}
                                    <a href="{{url}}" class="button is-light">
                                      <span class="icon"><i class="ph ph-arrow-left"></i></span>
                                      <span>Previous</span>
                                    </a>
                                  {{/if}}
                                {{/get}}
                              {{/foreach}}
                            {{else}}
                              <button class="button is-light" disabled>
                                <span class="icon"><i class="ph ph-arrow-left"></i></span>
                                <span>Previous</span>
                              </button>
                            {{/if}}
                          {{/get}}
                        {{/foreach}}
                      {{else}}
                        <button class="button is-light" disabled>
                          <span class="icon"><i class="ph ph-arrow-left"></i></span>
                          <span>Previous</span>
                        </button>
                      {{/if}}
                    {{/get}}
                  {{/prev_post}}
                {{/has}}
              </div>
            </div>

            <div class="level-right">
              <div class="level-item">
                {{!-- =====================================
                    NEXT BUTTON
                ====================================== --}}
                {{#has tag="#training-section"}}
                  {{#next_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-primary">
                      <span>Start Module</span>
                      <span class="icon"><i class="ph ph-arrow-right"></i></span>
                    </a>
                  {{else}}
                    {{#get "posts" filter="tag:hash-training-section+published_at:>'{{published_at}}'" limit="1" order="published_at asc" as |next_sections|}}
                      {{#if next_sections.[0]}}
                        {{#foreach next_sections}}
                          {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="1" order="published_at asc" as |next_first_lessons|}}
                            {{#if next_first_lessons.[0]}}
                              {{#foreach next_first_lessons}}
                                <a href="{{url}}" class="button is-primary">
                                  <span>Next</span>
                                  <span class="icon"><i class="ph ph-arrow-right"></i></span>
                                </a>
                              {{/foreach}}
                            {{else}}
                              <a href="{{url}}" class="button is-primary">
                                <span>Next</span>
                                <span class="icon"><i class="ph ph-arrow-right"></i></span>
                              </a>
                            {{/if}}
                          {{/get}}
                        {{/foreach}}
                      {{else}}
                        <button class="button is-primary" disabled>End of Training</button>
                      {{/if}}
                    {{/get}}
                  {{/next_post}}
                {{else}}
                  {{#next_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-primary">
                      <span>Complete & Continue</span>
                      <span class="icon"><i class="ph ph-arrow-right"></i></span>
                    </a>
                  {{else}}
                    {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |current_sections|}}
                      {{#if current_sections.[0]}}
                        {{#foreach current_sections}}
                          {{#get "posts" filter="tag:hash-training-section+published_at:>'{{published_at}}'" limit="1" order="published_at asc" as |next_sections|}}
                            {{#if next_sections.[0]}}
                              {{#foreach next_sections}}
                                {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="1" order="published_at asc" as |next_first_lessons|}}
                                  {{#if next_first_lessons.[0]}}
                                    {{#foreach next_first_lessons}}
                                      <a href="{{url}}" class="button is-primary">
                                        <span>Complete & Continue</span>
                                        <span class="icon"><i class="ph ph-arrow-right"></i></span>
                                      </a>
                                    {{/foreach}}
                                  {{else}}
                                    <a href="{{url}}" class="button is-primary">
                                      <span>Next Section</span>
                                      <span class="icon"><i class="ph ph-arrow-right"></i></span>
                                    </a>
                                  {{/if}}
                                {{/get}}
                              {{/foreach}}
                            {{else}}
                              <button class="button is-primary" disabled>End of Training</button>
                            {{/if}}
                          {{/get}}
                        {{/foreach}}
                      {{else}}
                        <button class="button is-primary" disabled>End of Training</button>
                      {{/if}}
                    {{/get}}
                  {{/next_post}}
                {{/has}}
              </div>
            </div>
          </div>

          <div class="tabs is-boxed mb-5">
            <ul>
              <li class="is-active"><a>Overview</a></li>
              <li><a href="/training/">All Modules</a></li>
              <li><a href="#curriculum">Curriculum</a></li>
            </ul>
          </div>

          <div class="content">
            {{#has tag="#training-section"}}
              <p class="tag is-link is-light mb-3">Training Module</p>
              <h1 class="title is-3">{{title}}</h1>
              <p class="subtitle is-6">{{primary_tag.name}}</p>

              {{#if custom_excerpt}}
                <div class="notification is-light">
                  {{custom_excerpt}}
                </div>
              {{/if}}

              {{content}}

              <hr>

              <h2 class="title is-5">Lessons in this module</h2>

              <div class="menu">
                <ul class="menu-list">
                  {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" limit="all" order="published_at asc" as |module_lessons|}}
                    {{#foreach module_lessons}}
                      <li>
                        <a href="{{url}}">
                          <span class="mr-2">{{@number}}.</span>{{title}}
                        </a>
                      </li>
                    {{else}}
                      <li><span class="has-text-grey">No lessons yet.</span></li>
                    {{/foreach}}
                  {{/get}}
                </ul>
              </div>

            {{else}}
              {{#get "posts" filter="tag:hash-training-section+primary_tag:{{primary_tag.slug}}" limit="1" as |module_posts|}}
                {{#if module_posts.[0]}}
                  {{#foreach module_posts}}
                    <p class="mb-3">
                      <a href="{{url}}" class="button is-white is-small">
                        <span class="icon"><i class="ph ph-caret-left"></i></span>
                        <span>{{title}}</span>
                      </a>
                    </p>
                  {{/foreach}}
                {{/if}}
              {{/get}}

              <p class="tag is-primary is-light mb-3">Lesson</p>
              <h1 class="title is-3">{{title}}</h1>
              <p class="subtitle is-6">{{primary_tag.name}} • {{reading_time}}</p>

              {{#if custom_excerpt}}
                <div class="notification is-light">
                  {{custom_excerpt}}
                </div>
              {{/if}}

              {{content}}
            {{/has}}
          </div>
        </div>
      </main>

  <aside class="column is-12-tablet is-4-desktop" id="curriculum">
  <div class="box">
    <h2 class="title is-5 mb-2">Course Content</h2>
    <p class="is-size-7 has-text-grey mb-4">All modules and lessons</p>

    {{!-- =========================
        WHEN CURRENT PAGE IS A SECTION
    ========================== --}}
    {{#has tag="#training-section"}}
      {{#get "posts" filter="tag:hash-training-section" limit="all" order="published_at asc" as |sections|}}
        {{#foreach sections}}
          <details {{#match slug ../slug}}open{{/match}} class="mb-4">
            <summary class="button is-fullwidth is-light is-justify-content-space-between">
              <span class="icon-text">
                {{#match slug ../slug}}
                  <span class="icon has-text-success"><i class="ph-fill ph-check-circle"></i></span>
                {{else}}
                  <span class="icon"><i class="ph ph-folder-open"></i></span>
                {{/match}}
                <span>{{@number}}. {{title}}</span>
              </span>
              <span class="icon"><i class="ph ph-caret-down"></i></span>
            </summary>

            <nav class="panel mt-2">
              <a href="{{url}}" class="panel-block {{#match slug ../slug}}is-active has-background-link-light has-text-link-dark{{/match}}">
                {{#match slug ../slug}}
                  <span class="icon has-text-success mr-2"><i class="ph-fill ph-check-circle"></i></span>
                {{else}}
                  <span class="icon mr-2"><i class="ph ph-book-open"></i></span>
                {{/match}}
                <span>Overview</span>
              </a>

              {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="all" order="published_at asc" as |section_lessons|}}
                {{#foreach section_lessons}}
                  <a href="{{url}}" class="panel-block">
                    <span class="icon mr-2"><i class="ph ph-play-circle"></i></span>
                    <span>
                      <span class="is-block">{{title}}</span>
                      <span class="is-size-7 has-text-grey">{{reading_time}}</span>
                    </span>
                  </a>
                {{else}}
                  <div class="panel-block has-text-grey is-size-7">
                    No lessons yet
                  </div>
                {{/foreach}}
              {{/get}}
            </nav>
          </details>
        {{else}}
          <article class="message is-light">
            <div class="message-body">No training sections found.</div>
          </article>
        {{/foreach}}
      {{/get}}

    {{!-- =========================
        WHEN CURRENT PAGE IS A LESSON
    ========================== --}}
    {{else has tag="#training-content"}}
      {{#get "posts" filter="tag:hash-training-section" limit="all" order="published_at asc" as |sections|}}
        {{#foreach sections}}
          <details {{#match slug ../primary_tag.slug}}open{{/match}} class="mb-4">
            <summary class="button is-fullwidth is-light is-justify-content-space-between">
              <span class="icon-text">
                {{#match slug ../primary_tag.slug}}
                  <span class="icon has-text-success"><i class="ph-fill ph-check-circle"></i></span>
                {{else}}
                  <span class="icon"><i class="ph ph-folder-open"></i></span>
                {{/match}}
                <span>{{@number}}. {{title}}</span>
              </span>
              <span class="icon"><i class="ph ph-caret-down"></i></span>
            </summary>

            <nav class="panel mt-2">
              <a href="{{url}}" class="panel-block {{#match slug ../primary_tag.slug}}has-background-light{{/match}}">
                {{#match slug ../primary_tag.slug}}
                  <span class="icon has-text-success mr-2"><i class="ph-fill ph-check-circle"></i></span>
                {{else}}
                  <span class="icon mr-2"><i class="ph ph-book-open"></i></span>
                {{/match}}
                <span>Overview</span>
              </a>

              {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" limit="all" order="published_at asc" as |section_lessons|}}
                {{#foreach section_lessons}}
                  <a href="{{url}}" class="panel-block {{#match slug ../../slug}}is-active has-background-link-light has-text-link-dark{{/match}}">
                    {{#match slug ../../slug}}
                      <span class="icon has-text-success mr-2"><i class="ph-fill ph-check-circle"></i></span>
                    {{else}}
                      <span class="icon mr-2"><i class="ph ph-play-circle"></i></span>
                    {{/match}}
                    <span>
                      <span class="is-block">{{title}}</span>
                      <span class="is-size-7 has-text-grey">{{reading_time}}</span>
                    </span>
                  </a>
                {{else}}
                  <div class="panel-block has-text-grey is-size-7">
                    No lessons yet
                  </div>
                {{/foreach}}
              {{/get}}
            </nav>
          </details>
        {{else}}
          <article class="message is-light">
            <div class="message-body">No training sections found.</div>
          </article>
        {{/foreach}}
      {{/get}}
    {{/has}}
  </div>
</aside>

    </div>
  </div>
</section>