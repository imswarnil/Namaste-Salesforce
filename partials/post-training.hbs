{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — the training LESSON at
  /training/{section}/{lesson}/ (#training-content). Context: {{#post}}.

  Renders the .ns-training COMPONENT — 2-components/reader.css, documented at
  /styleguide/training-lesson.html. Three columns from lg: the section rail,
  the lesson, and the on-this-page rail. Below lg it is one column, the rail
  becomes the drawer the player header opens, and the contents render inline
  above the article.

  The reading column is --container-read (58rem): wider than the article
  measure, because a lesson is prose plus code, tables and screenshots. The
  video runs wider still (--wide-media).

  The training name and progress are in the sub bar above, not in the rail.

  VIDEO lessons put the player in __media; training-video.js adopts the first
  embed found in the content and wires chapter-table timestamps to seek it.

  There is no training-overview branch: /training/ is a route, not a post, so
  this partial only ever renders a lesson. See routes.yaml.
═══════════════════════════════════════════════════════════════════════════ --}}

<div class="ns-training ns-training--nav-start ">

  {{!-- ── The section rail. cur/curId drive the active row: the lesson's
       primary tag IS its section, and curId marks the lesson itself, so the
       section's "Overview" row correctly stays inactive. ── --}}
    {{> "training/curriculum" cur=primary_tag.slug curId=id}}

  <div class="ns-training__main">

        {{!-- ── Head ── --}}
    <div class="ns-modulehead">

      {{!-- ── Where you are. The lesson had no trail at all: the rail says
           which section you are in, but only if you can see it, which below lg
           you cannot. --bar gives it a hairline strip of its own, since there
           is no hero here for it to sit inside.

           Four steps is the most a crumb should carry, so the section is named
           and the lesson is not — the <h1> directly below is the lesson, and
           repeating it in the trail spends the only truncating slot on the one
           thing already in full.

           No rule under it: the page is already divided the other way, by the
           column rules either side of the reading column, and a horizontal
           hairline crossing them turns a clean grid into a box. ── --}}
      <nav class="ns-crumbs ns-crumbs--sm" aria-label="{{t "Breadcrumb"}}">
        <a class="ns-crumbs__link" href="/" aria-label="{{t "Home"}}">{{> icons name="house"}}</a>
        <i class="ns-crumbs__sep" aria-hidden="true"></i>
        <a class="ns-crumbs__link" href="/training/">{{> icons name="graduation-cap"}}{{t "Training"}}</a>
        <i class="ns-crumbs__sep" aria-hidden="true"></i>
        <span class="ns-crumbs__current">{{> icons name="stack"}}<span>{{primary_tag.name}}</span></span>
      </nav>

      <h1 class="ns-modulehead__title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="ns-page__lede">{{custom_excerpt}}</p>{{/if}}

      <div class="ns-modulehead__lede">
        {{#has tag="#training-video"}}
          <span class="ns-lesson-type ns-lesson-type--video">{{> icons name="video"}}{{t "Video"}}</span>
        {{else has tag="#training-exercise"}}
          <span class="ns-lesson-type ns-lesson-type--article">{{> icons name="barbell"}}{{t "Exercise"}}</span>
        {{else has tag="#training-quiz"}}
          <span class="ns-lesson-type ns-lesson-type--article">{{> icons name="exam"}}{{t "Quiz"}}</span>
        {{else}}
          <span class="ns-lesson-type ns-lesson-type--article">{{> icons name="article"}}{{t "Article"}}</span>
        {{/has}}
        <span class="ns-lesson-chip">{{> icons name="clock"}}{{reading_time minute="1 min" minutes="% min"}}</span>
        {{#match visibility "public"}}
          <span class="ns-badge ns-badge--dot ns-badge--success">{{t "Free to read"}}</span>
        {{else}}
          <span class="ns-badge ns-badge--neutral">{{> icons name="lock"}}{{t "Members only"}}</span>
        {{/match}}
      </div>
    </div>

    {{!-- ── Media. Video lessons get the player frame (training-video.js swaps
         the poster for the embed); everything else shows its image, if it has
         one. ── --}}
    {{#has tag="#training-video"}}
      <div class="ns-figure__frame">
        <div data-video-hero class="ns-video">
          {{#if feature_image}}
            {{> "components/img" src=feature_image alt="" eager=true sizes="100vw"}}
          {{else}}
            <span class="ns-video-poster__fallback"></span>
          {{/if}}
          <span class="ns-video-poster__play"><span>{{> icons name="play"}}</span></span>
        </div>
      </div>
    {{else}}
      {{#if feature_image}}
        <div class="ns-figure__frame">
          <div class="ns-media ns-media--frame">
            {{> "components/img" src=feature_image alt="" eager=true sizes="(min-width: 64rem) 40rem, 100vw"}}
          </div>
        </div>
      {{/if}}
    {{/has}}

    {{!-- Contents, inline — the rail carries its own copy from lg up. --}}
    <div class="ns-training__reading xl:hidden">
      {{> "components/toc"}}
    </div>

    {{!-- ── The gate ────────────────────────────────────────────────────────
         Ghost stops the content and leaves the excerpt visible, which on its
         own just looks like a lesson that ends abruptly. This says why.

         It is the full width of the column rather than the reading measure,
         and centred inside it: a gate is not part of the prose, it is the end
         of it, and the one thing on the page that should be impossible to
         mistake for another paragraph. Everything else about it stays quiet —
         a hairline, one glyph, one button — because the reader is being told
         "not yet", not sold to.

         The condition is {{#unless access}}, not {{#unless @member}}. A free
         member reading a PAID lesson is signed in and still cannot read it —
         `access` is the only value that answers "can this visitor see the
         content", which is the actual question. Getting it wrong showed no
         gate at all to exactly the people most likely to upgrade.

         Ghost renders its own <aside class="gh-post-upgrade-cta"> inside the
         content for the same situation. There is no theme setting to turn it
         off, so it is hidden in lock.css — the two together were two gates
         one after the other, in two different design languages. ── --}}
    {{^has visibility="public"}}
      {{#unless access}}
        <div class="ns-gate">
          <span class="ns-gate__icon">{{> icons name="lock"}}</span>
          <h2 class="ns-gate__title">
            {{#match visibility "paid"}}{{t "This lesson is for paid members"}}
            {{else match visibility "tiers"}}{{t "This lesson is for selected tiers"}}
            {{else}}{{t "This lesson is for members"}}{{/match}}
          </h2>
          <p class="ns-gate__text">
            {{#match visibility "paid"}}{{t "Upgrade to read the rest of this lesson and everything else behind the paywall."}}
            {{else match visibility "tiers"}}{{t "Your plan does not include this lesson. Change tier to read the rest of it."}}
            {{else}}{{t "Sign in to read the rest of it. Membership is free, and it unlocks every members-only lesson in the training."}}{{/match}}
          </p>
          <div class="ns-gate__panel">
            {{#match visibility "public"}}{{else}}
              <a href="#/portal/signup" data-portal="signup" class="ns-btn ns-btn--primary">
                {{> icons name="lock-open"}}
                {{#match visibility "paid"}}{{t "See plans"}}{{else}}{{t "Create a free account"}}{{/match}}
              </a>
            {{/match}}
            <a href="#/portal/signin" data-portal="signin" class="ns-btn ns-btn--outline">{{t "Sign in"}}</a>
          </div>
        </div>
      {{/unless}}
    {{/has}}

    {{!-- ── The lesson ── --}}
    <div class="ns-training__reading gh-content prose">{{content}}</div>


    {{!-- ── Prev / next. training-nav.js fills these in and flows across
         section boundaries, then swaps in "finish" on the last lesson. The
         empty slot keeps "next" on the right when there is no previous.
         They start on .is-hidden — a class, not an inline style: two words of
         CSS in a template are still CSS in a template. ── --}}
    <div class="ns-tpager">
      <a class="js-train-prev ns-tpager__btn is-hidden" href="#">
        <span class="ns-tpager__dir">{{> icons name="arrow-left"}} {{t "Previous"}}</span>
        <span class="ns-tpager__title">{{> icons name="article" class="js-train-icon"}}<span class="js-train-label"></span></span>
      </a>
      <span class="ns-tpager__btn" aria-hidden="true"></span>
      <a class="js-train-next ns-tpager__btn ns-tpager__btn ns-tpager__btn--next is-hidden" href="#">
        <span class="ns-tpager__dir">{{t "Next"}} {{> icons name="arrow-right"}}</span>
        <span class="ns-tpager__title">{{> icons name="article" class="js-train-icon"}}<span class="js-train-label"></span></span>
      </a>
      <a class="js-train-finish ns-tpager__btn ns-tpager__btn ns-tpager__btn--next is-hidden" href="/training/">
        <span class="ns-tpager__dir">{{> icons name="check-circle"}} {{t "Training complete"}}</span>
        <span class="ns-tpager__title">{{> icons name="flag-checkered"}}{{t "Back to all sections"}}</span>
      </a>
    </div>

    {{!-- ── Comments. Ghost renders nothing unless commenting is enabled in
         Admin → Settings → Access, so this is safe to always emit.
         title="" because the heading below already labels the block. ── --}}
    <section class="ns-training__reading mt-12">
      <h2 class="mb-5 flex items-center gap-2 font-heading text-lg font-extrabold text-ink">
        {{> icons name="chats" class="text-brand-500"}}{{t "Questions & discussion"}}
      </h2>
      {{comments title=""}}
    </section>

    {{!-- ── The one ask on the page, after everything else is read. It is a
         BAND rather than a rail widget because it needs room to explain what
         subscribing actually does — the widget in the sidebar said "new
         lessons by email" and nothing more. ── --}}

    <section class="ns-training__reading">
      <div class="ns-news-band ns-news-band--brand">
        <div>
          <span class="ns-kicker">{{> icons name="mail"}}{{t "Training newsletter"}}</span>
          <h2 class="ns-news-band__title">{{t "Get every new lesson as it lands"}}</h2>
          <p class="ns-news-band__body">
            {{t "Turn this on and anything added to the training — a new lesson, a new section, a rewrite of one you have already read — arrives in your inbox. Nothing else is sent to it."}}
          </p>
          <ul class="ns-list ns-list--check ns-list--sm ns-news-band__points">
            <li class="ns-list__item">{{t "New lessons and sections, the day they publish"}}</li>
            <li class="ns-list__item">{{t "Updates to lessons you have already worked through"}}</li>
            <li class="ns-list__item">{{t "No marketing, no digest, no third parties"}}</li>
          </ul>
        </div>

        {{> "members/subscribe" layout="stacked" cta=(t "Turn on training updates")}}
      </div>
    </section>

  </div>

  {{!-- ── The on-this-page rail — contents, then the sponsor slots. ── --}}
  <aside class="ns-training__ads">
    <div class="ns-widget ns-widget--toc ns-widget--sunken">
      <div class="ns-widget__head"><span class="ns-widget__title">{{t "On this page"}}</span></div>
      <div class="ns-widget__body">{{> "components/toc"}}</div>
    </div>
    <div>{{> "ads/slot" format="rail"}}</div>
  </aside>

</div>
