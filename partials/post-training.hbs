{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — Roadmap track overview (#training) AND the
  module/lesson player (#training-content). Main column + curriculum sidebar.
  Context: {{#post}}.
═══════════════════════════════════════════════════════════════════════════ --}}
<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">

    <main class="min-w-0">

      {{!-- ─── Branch A: track overview ─── --}}
      {{#has tag="#training"}}
        <div class="rounded-card border border-border bg-surface-raised p-6 shadow-card sm:p-8">
          {{#if primary_tag}}
            <span class="inline-flex items-center gap-1 rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">
              <i class="ph-fill ph-tag" aria-hidden="true"></i>{{primary_tag.name}}
            </span>
          {{/if}}
          <h1 class="mt-4 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{title}}</h1>
          {{#if custom_excerpt}}<p class="mt-3 text-lg text-muted">{{custom_excerpt}}</p>{{/if}}

          <hr class="my-6 border-border">
          <div class="flex flex-wrap items-center justify-between gap-4">
            {{#primary_author}}
              <div class="flex items-center gap-3">
                {{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="h-11 w-11 rounded-full border-2 border-border object-cover">{{else}}<span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-500/10 text-brand-600"><i class="ph-fill ph-user-circle text-2xl" aria-hidden="true"></i></span>{{/if}}
                <div>
                  <p class="text-xs uppercase tracking-wider text-muted">{{t "Instructor"}}</p>
                  <p class="font-bold">{{name}}</p>
                </div>
              </div>
            {{/primary_author}}
            {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="1"}}
              {{#foreach posts}}
                <a href="{{url}}" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-5 py-2.5 font-bold text-white shadow-brand transition hover:bg-brand-600">
                  <i class="ph-fill ph-play" aria-hidden="true"></i>{{t "Start learning"}}
                </a>
              {{else}}
                <span class="inline-flex items-center gap-2 rounded-pill border border-border px-5 py-2.5 font-semibold text-muted"><i class="ph ph-clock" aria-hidden="true"></i>{{t "Coming soon"}}</span>
              {{/foreach}}
            {{/get}}
          </div>
        </div>

        <div class="mt-6 rounded-card border border-border bg-surface-raised p-6 shadow-card sm:p-8">
          <h2 class="font-heading text-xl font-extrabold">{{t "About this track"}}</h2>
          <div class="prose mt-4 max-w-none gh-content">{{content}}</div>
        </div>
      {{/has}}

      {{!-- ─── Branch B: module / lesson player ─── --}}
      {{#has tag="#training-content"}}
        {{#if feature_image}}
          <div class="relative aspect-video overflow-hidden rounded-card bg-black shadow-card">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="h-full w-full object-cover opacity-90">
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-brand-600 shadow-raised"><i class="ph-fill ph-play text-2xl" aria-hidden="true"></i></span>
            </span>
          </div>
        {{/if}}

        {{!-- Nav bar --}}
        <div class="mt-3 flex items-center justify-between gap-2 rounded-card border border-border bg-surface-raised p-3">
          {{#prev_post in="primary_tag"}}
            <a href="{{url}}" class="inline-flex items-center gap-2 rounded-pill border border-border px-4 py-2 text-sm font-semibold transition hover:border-brand-500"><i class="ph ph-arrow-left" aria-hidden="true"></i><span class="hidden sm:inline">{{t "Previous"}}</span></a>
          {{else}}
            <span class="inline-flex items-center gap-2 rounded-pill border border-border px-4 py-2 text-sm text-muted"><i class="ph ph-arrow-left" aria-hidden="true"></i></span>
          {{/prev_post}}
          {{#next_post in="primary_tag"}}
            <a href="{{url}}" class="inline-flex items-center gap-2 rounded-pill bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600"><span class="hidden sm:inline">{{t "Next lesson"}}</span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          {{else}}
            <a href="/training/" class="inline-flex items-center gap-2 rounded-pill bg-success px-4 py-2 text-sm font-bold text-white transition hover:opacity-90"><i class="ph-fill ph-check-circle" aria-hidden="true"></i><span class="hidden sm:inline">{{t "Finish"}}</span></a>
          {{/next_post}}
        </div>

        <article class="mt-6 rounded-card border border-border bg-surface-raised p-6 shadow-card sm:p-8">
          <h1 class="font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{title}}</h1>
          <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-muted">
            {{#if primary_tag}}<span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">{{primary_tag.name}}</span>{{/if}}
            <span class="inline-flex items-center gap-1"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min read" minutes="% min read"}}</span>
          </div>

          <div class="mt-6 rounded-lg border border-border p-4">
            <p class="mb-2 flex items-center gap-2 text-sm font-bold"><i class="ph-fill ph-list-dashes text-brand-500" aria-hidden="true"></i>{{t "Table of contents"}}</p>
            {{> "components/toc"}}
          </div>

          <div class="prose mt-6 max-w-none gh-content">{{content}}</div>
        </article>

        {{!-- Big bottom prev/next --}}
        <div class="mt-6 grid grid-cols-2 gap-3">
          <div>
            {{#prev_post in="primary_tag"}}
              <a href="{{url}}" class="flex h-full flex-col justify-center rounded-card border border-border p-4 transition hover:border-brand-500 hover:shadow-card">
                <span class="text-xs text-muted"><i class="ph ph-arrow-left" aria-hidden="true"></i> {{t "Previous"}}</span>
                <span class="mt-1 font-bold leading-snug">{{title}}</span>
              </a>
            {{/prev_post}}
          </div>
          <div>
            {{#next_post in="primary_tag"}}
              <a href="{{url}}" class="flex h-full flex-col justify-center rounded-card border border-border p-4 text-right transition hover:border-brand-500 hover:shadow-card">
                <span class="text-xs text-muted">{{t "Next"}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                <span class="mt-1 font-bold leading-snug">{{title}}</span>
              </a>
            {{else}}
              <a href="/training/" class="flex h-full flex-col justify-center rounded-card border border-success/40 p-4 text-right transition hover:shadow-card">
                <span class="text-xs font-semibold text-success"><i class="ph-fill ph-check-circle" aria-hidden="true"></i> {{t "Course complete"}}</span>
                <span class="mt-1 font-bold leading-snug text-success">{{t "Return to track"}}</span>
              </a>
            {{/next_post}}
          </div>
        </div>
      {{/has}}
    </main>

    {{!-- Curriculum sidebar --}}
    <aside class="lg:sticky lg:top-20 lg:self-start">
      {{> "training/curriculum"}}
    </aside>
  </div>
</section>
