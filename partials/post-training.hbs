{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — Roadmap track overview (#training) AND the
  module/lesson player (#training-content).
  ----------------------------------------------------------------------------
  Layout (module player):  curriculum sidebar LEFT (docs-style, sticky)
  · right region = full-width medium hero (VIDEO modules put the video itself
  in the hero — training-video.js adopts the first embed and wires timestamp
  tables to seek it; other modules get a clean gradient hero with title)
  · below the hero, two columns: article content + right rail where TOC and
  ad/sponsor widgets pin one after another (sticky deck).
  Mobile: curriculum stays in the drawer under the navbar (player header
  hamburger), the TOC renders inline above the content. Context: {{#post}}.
═══════════════════════════════════════════════════════════════════════════ --}}
{{!-- Full-bleed: edge to edge, sections divided by hairline borders --}}
<section class="w-full">
  <div class="grid lg:grid-cols-[19rem_minmax(0,1fr)]">

    {{!-- ── Left: curriculum (sticky on lg; mobile drawer via player header) ── --}}
    <aside class="lg:border-r lg:border-border">
      <div class="lg:sticky lg:top-16 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto lg:p-4">
        {{> "training/curriculum"}}
      </div>
    </aside>

    <div class="min-w-0 px-4 py-8 sm:px-6 lg:px-8">

      {{!-- ─── Branch A: track overview ─── --}}
      {{#has tag="#training"}}
        {{> "components/breadcrumb"}}
        <header class="relative overflow-hidden rounded-card bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 p-6 text-white sm:p-10">
          {{> "components/hero-bg"}}
          <div class="relative">
            {{#if primary_tag}}
              <span class="inline-flex items-center gap-1 rounded-pill bg-white/10 px-3 py-1 text-xs font-semibold text-brand-100 ring-1 ring-white/20">
                <i class="ph-fill ph-map-trifold" aria-hidden="true"></i>{{primary_tag.name}}
              </span>
            {{/if}}
            <h1 class="mt-4 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{title}}</h1>
            {{#if custom_excerpt}}<p class="mt-3 max-w-2xl text-lg text-white/80">{{custom_excerpt}}</p>{{/if}}
            <div class="mt-6 flex flex-wrap items-center gap-4">
              {{#get "posts" filter="tag:hash-training-content+primary_tag:{{primary_tag.slug}}" order="published_at asc" limit="1"}}
                {{#foreach posts}}
                  <a href="{{url}}" class="inline-flex items-center gap-2 rounded-pill bg-white px-5 py-2.5 font-bold text-brand-700 shadow-card transition hover:bg-brand-50">
                    <i class="ph-fill ph-play" aria-hidden="true"></i>{{t "Start learning"}}
                  </a>
                  <span class="text-sm text-white/70">{{pagination.total}} {{t "modules"}}</span>
                {{else}}
                  <span class="inline-flex items-center gap-2 rounded-pill border border-white/30 px-5 py-2.5 font-semibold text-white/80"><i class="ph ph-clock" aria-hidden="true"></i>{{t "Coming soon"}}</span>
                {{/foreach}}
              {{/get}}
            </div>
          </div>
        </header>

        <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1fr)_16rem]">
          <div class="min-w-0">
            {{#primary_author}}
              <div class="flex items-center gap-3 border-b border-border pb-6">
                {{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="h-11 w-11 rounded-full border-2 border-border object-cover">{{else}}<span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-500/10 text-brand-600"><i class="ph-fill ph-user-circle text-2xl" aria-hidden="true"></i></span>{{/if}}
                <div>
                  <p class="text-xs uppercase tracking-wider text-muted">{{t "Instructor"}}</p>
                  <p class="font-bold">{{name}}</p>
                </div>
              </div>
            {{/primary_author}}
            <h2 class="mt-6 font-heading text-xl font-extrabold">{{t "About this track"}}</h2>
            <div class="prose mt-4 max-w-none gh-content">{{content}}</div>
          </div>
          <aside class="hidden xl:block xl:border-l xl:border-border xl:pl-8">
            <div class="flex h-full flex-col gap-10">
              <div class="flex-1"><div class="sticky top-20">{{> "ads/slot" format="rail"}}</div></div>
              <div class="flex-1"><div class="sticky top-20 pb-10">{{> "ads/slot" format="square"}}</div></div>
            </div>
          </aside>
        </div>
      {{/has}}

      {{!-- ─── Branch B: module / lesson player ─── --}}
      {{#has tag="#training-content"}}

        {{!-- Hero: medium height, full width of the content region.
             VIDEO modules → the video lives here (poster until
             training-video.js adopts the embed); others → gradient title hero --}}
        {{#has tag="#training-type-video"}}
          <div data-video-hero class="relative aspect-video max-h-[32rem] w-full overflow-hidden rounded-card bg-black shadow-card">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="h-full w-full object-cover opacity-90">
            {{else}}
              <div class="h-full w-full bg-gradient-to-br from-brand-700 to-brand-900"></div>
            {{/if}}
            <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-brand-600 shadow-raised"><i class="ph-fill ph-play text-2xl" aria-hidden="true"></i></span>
            </span>
          </div>
        {{else}}
          <header class="relative overflow-hidden rounded-card bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 p-6 text-white sm:p-10">
            {{> "components/hero-bg"}}
            <div class="relative">
              {{#if primary_tag}}<span class="inline-flex items-center gap-1 rounded-pill bg-white/10 px-3 py-1 text-xs font-semibold text-brand-100 ring-1 ring-white/20"><i class="ph-fill ph-map-trifold" aria-hidden="true"></i>{{primary_tag.name}}</span>{{/if}}
              <h1 class="mt-4 font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{title}}</h1>
              {{#if custom_excerpt}}<p class="mt-2 max-w-2xl text-white/80">{{custom_excerpt}}</p>{{/if}}
            </div>
          </header>
        {{/has}}

        {{!-- Below the hero: content left · TOC + widgets right --}}
        <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1fr)_16rem]">

          <article class="min-w-0">
            {{!-- Video modules carry their title here, under the player --}}
            {{#has tag="#training-type-video"}}
              <h1 class="font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{title}}</h1>
              {{#if custom_excerpt}}<p class="mt-2 text-lg text-muted">{{custom_excerpt}}</p>{{/if}}
            {{/has}}

            <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-muted">
              {{#if primary_tag}}<span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">{{primary_tag.name}}</span>{{/if}}
              {{!-- Module type chip --}}
              {{#has tag="#training-type-video"}}<span class="ns-lesson-type ns-lesson-type--video"><i class="ph-fill ph-video-camera" aria-hidden="true"></i>{{t "Video"}}</span>
              {{else has tag="#training-type-exercise"}}<span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-barbell" aria-hidden="true"></i>{{t "Exercise"}}</span>
              {{else has tag="#training-type-quiz"}}<span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-exam" aria-hidden="true"></i>{{t "Quiz"}}</span>
              {{else}}<span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-article" aria-hidden="true"></i>{{t "Article"}}</span>{{/has}}
              <span class="inline-flex items-center gap-1"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min" minutes="% min"}}</span>
            </div>

            {{!-- Mobile/tablet TOC (the xl rail has its own instance) --}}
            <div class="mt-6 border-l-2 border-brand-500/30 pl-4 xl:hidden">
              {{> "components/toc"}}
            </div>

            <div class="prose mt-6 max-w-none gh-content">{{content}}</div>

            {{!-- Bottom prev/next (training-nav.js flows across tracks) --}}
            <div class="mt-10 grid grid-cols-2 gap-3 border-t border-border pt-6">
              <a class="js-train-prev flex h-full flex-col justify-center rounded-card border border-border p-4 transition hover:border-brand-500 hover:shadow-card" href="#" style="display:none">
                <span class="text-xs text-muted"><i class="ph ph-arrow-left" aria-hidden="true"></i> {{t "Previous"}}</span>
                <span class="js-train-label mt-1 font-bold leading-snug"></span>
              </a>
              <a class="js-train-next flex h-full flex-col justify-center rounded-card border border-border p-4 text-right transition hover:border-brand-500 hover:shadow-card sm:col-start-2" href="#" style="display:none">
                <span class="text-xs text-muted">{{t "Next"}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                <span class="js-train-label mt-1 font-bold leading-snug"></span>
              </a>
              <a class="js-train-finish flex h-full flex-col justify-center rounded-card border border-success/40 p-4 text-right transition hover:shadow-card sm:col-start-2" href="/training/" style="display:none">
                <span class="text-xs font-semibold text-success"><i class="ph-fill ph-check-circle" aria-hidden="true"></i> {{t "Course complete"}}</span>
                <span class="mt-1 font-bold leading-snug text-success">{{t "Return to track"}}</span>
              </a>
            </div>
          </article>

          {{!-- Right rail: TOC → ad → ad, sequential sticky handoff (each widget
               pins inside its own flex-1 segment, then cycles to the next) --}}
          <aside class="hidden xl:block xl:border-l xl:border-border xl:pl-8">
            <div class="flex h-full flex-col gap-10">
              <div class="flex-1"><div class="sticky top-20">{{> "components/toc"}}</div></div>
              <div class="flex-1"><div class="sticky top-20">{{> "ads/slot" format="rail"}}</div></div>
              <div class="flex-1"><div class="sticky top-20 pb-10">{{> "ads/slot" format="square"}}</div></div>
            </div>
          </aside>
        </div>
      {{/has}}
    </div>
  </div>
</section>
