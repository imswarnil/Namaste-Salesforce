{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — the training LESSON at
  /training/{section}/{lesson}/ (#training-content). Context: {{#post}}.

  Renders the .ns-reader COMPONENT — 2-components/reader.css, documented at
  /styleguide/training-lesson.html. Three columns from lg: the section rail,
  the lesson, and the on-this-page rail. Below lg it is one column, the rail
  becomes the drawer the player header opens, and the contents render inline
  above the article.

  The reading column is --container-read (58rem): wider than the article
  measure, because a lesson is prose plus code, tables and screenshots. The
  video runs wider still (--wide-media).

  The training name and progress are in the sub bar above, not in the rail.

  VIDEO lessons put the player in __media; training-video.js adopts the first
  embed found in the content and wires chapter-table timestamps to seek it.

  There is no training-overview branch: /training/ is a route, not a post, so
  this partial only ever renders a lesson. See routes.yaml.
═══════════════════════════════════════════════════════════════════════════ --}}

{{> "training/subbar" section=primary_tag.name sectionUrl=primary_tag.url lesson=title}}

<div class="ns-reader ns-reader--both ns-reader--fluid ns-reader--wide-media">

  {{!-- ── The section rail. cur/curId drive the active row: the lesson's
       primary tag IS its section, and curId marks the lesson itself, so the
       section's "Overview" row correctly stays inactive. ── --}}
  <aside class="ns-reader__rail">
    {{> "training/curriculum" cur=primary_tag.slug curId=id}}
  </aside>

  <div class="ns-reader__main">

        {{!-- ── Head ── --}}
    <div class="ns-reader__head">

      <h1 class="ns-reader__title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="ns-page__lede">{{custom_excerpt}}</p>{{/if}}

      <div class="ns-reader__meta">
        {{#has tag="#training-type-video"}}
          <span class="ns-lesson-type ns-lesson-type--video"><i class="ph-fill ph-video-camera" aria-hidden="true"></i>{{t "Video"}}</span>
        {{else has tag="#training-type-exercise"}}
          <span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-barbell" aria-hidden="true"></i>{{t "Exercise"}}</span>
        {{else has tag="#training-type-quiz"}}
          <span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-exam" aria-hidden="true"></i>{{t "Quiz"}}</span>
        {{else}}
          <span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-article" aria-hidden="true"></i>{{t "Article"}}</span>
        {{/has}}
        <span class="ns-lesson-chip"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min" minutes="% min"}}</span>
        {{#match visibility "public"}}
          <span class="ns-badge ns-badge--dot ns-badge--success">{{t "Free to read"}}</span>
        {{else}}
          <span class="ns-badge ns-badge--neutral"><i class="ph ph-lock" aria-hidden="true"></i>{{t "Members only"}}</span>
        {{/match}}
      </div>
    </div>

    {{!-- ── Media. Video lessons get the player frame (training-video.js swaps
         the poster for the embed); everything else shows its image, if it has
         one. ── --}}
    {{#has tag="#training-type-video"}}
      <div class="ns-reader__media">
        <div data-video-hero class="ns-video">
          {{#if feature_image}}
            <img loading="lazy" decoding="async" src="{{img_url feature_image size="xl"}}" alt="{{title}}">
          {{else}}
            <span class="ns-video-poster__fallback"></span>
          {{/if}}
          <span class="ns-video-poster__play"><span><i class="ph-fill ph-play" aria-hidden="true"></i></span></span>
        </div>
      </div>
    {{else}}
      {{#if feature_image}}
        <div class="ns-reader__media">
          <div class="ns-media ns-media--frame">
            <img decoding="async" src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="eager">
          </div>
        </div>
      {{/if}}
    {{/has}}

    {{!-- Contents, inline — the rail carries its own copy from lg up. --}}
    <div class="ns-reader__body xl:hidden">
      {{> "components/toc"}}
    </div>

    {{!-- A locked lesson says so plainly, above the excerpt Ghost leaves
         visible — a chip alone is easy to miss when the content just stops. --}}
    {{^has visibility="public"}}
      {{#unless @member}}
        <div class="ns-reader__body">
          <div class="ns-note ns-note--warning">
            <i class="ns-note__icon ph-fill ph-lock" aria-hidden="true"></i>
            <div class="ns-note__body">
              <span class="ns-note__title">{{t "Members only"}}</span> —
              {{t "sign in to read the rest of this lesson. Membership is free."}}
            </div>
            <a href="#/portal/signup" data-portal="signup" class="ns-btn ns-btn--primary ns-btn--sm ns-note__action">{{t "Sign in"}}</a>
          </div>
        </div>
      {{/unless}}
    {{/has}}

    {{!-- ── The lesson ── --}}
    <div class="ns-reader__body gh-content prose">{{content}}</div>

    <hr class="ns-reader__sep">

    {{!-- ── Prev / next. training-nav.js fills these in and flows across
         section boundaries, then swaps in "finish" on the last lesson. The
         empty slot keeps "next" on the right when there is no previous. ── --}}
    <div class="ns-reader__foot">
      <a class="js-train-prev ns-reader__step" href="#" style="display:none">
        <span class="ns-reader__step-label"><i class="ph ph-arrow-left" aria-hidden="true"></i> {{t "Previous"}}</span>
        <span class="js-train-label ns-reader__step-title"></span>
      </a>
      <span class="ns-reader__step ns-reader__step--empty"></span>
      <a class="js-train-next ns-reader__step ns-reader__step--next" href="#" style="display:none">
        <span class="ns-reader__step-label">{{t "Next"}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
        <span class="js-train-label ns-reader__step-title"></span>
      </a>
      <a class="js-train-finish ns-reader__step ns-reader__step--next" href="/training/" style="display:none">
        <span class="ns-reader__step-label"><i class="ph-fill ph-check-circle" aria-hidden="true"></i> {{t "Training complete"}}</span>
        <span class="ns-reader__step-title">{{t "Back to all sections"}}</span>
      </a>
    </div>

    {{!-- ── Comments. Ghost renders nothing unless commenting is enabled in
         Admin → Settings → Access, so this is safe to always emit.
         title="" because the heading below already labels the block. ── --}}
    <section class="ns-reader__body mt-12 border-t border-border pt-8">
      <h2 class="mb-5 flex items-center gap-2 font-heading text-lg font-extrabold text-ink">
        <i class="ph-fill ph-chats-circle text-brand-500" aria-hidden="true"></i>{{t "Questions & discussion"}}
      </h2>
      {{comments title=""}}
    </section>

    {{!-- ── The one ask on the page, after everything else is read. It is a
         BAND rather than a rail widget because it needs room to explain what
         subscribing actually does — the widget in the sidebar said "new
         lessons by email" and nothing more. ── --}}
    <hr class="ns-reader__sep">

    <section class="ns-reader__body">
      <div class="ns-news-band ns-news-band--brand">
        <div>
          <span class="ns-kicker"><i class="ph-fill ph-envelope-simple" aria-hidden="true"></i>{{t "Training newsletter"}}</span>
          <h2 class="ns-news-band__title">{{t "Get every new lesson as it lands"}}</h2>
          <p class="ns-news-band__body">
            {{t "Turn this on and anything added to the training — a new lesson, a new section, a rewrite of one you have already read — arrives in your inbox. Nothing else is sent to it."}}
          </p>
          <ul class="ns-list ns-list--check ns-list--sm ns-news-band__points">
            <li class="ns-list__item">{{t "New lessons and sections, the day they publish"}}</li>
            <li class="ns-list__item">{{t "Updates to lessons you have already worked through"}}</li>
            <li class="ns-list__item">{{t "No marketing, no digest, no third parties"}}</li>
          </ul>
        </div>

        <form data-members-form="subscribe" class="ns-news-band__form">
          <label class="ns-field">
            <span class="ns-field__label">{{t "Email address"}}</span>
            <input data-members-email type="email" required placeholder="{{t "you@example.com"}}"
                   aria-label="{{t "Email address"}}" class="ns-input">
          </label>
          <button type="submit" class="ns-btn ns-btn--primary ns-btn--block">
            <span data-members-loading class="hidden"><i class="ph ph-circle-notch animate-spin" aria-hidden="true"></i></span>
            <span data-members-default>{{t "Turn on training updates"}}</span>
          </button>
          <span class="ns-news-band__note">{{t "Free. One click to unsubscribe."}}</span>
          <p data-members-success class="text-sm font-semibold text-success" hidden>{{t "Check your inbox — your magic link is on its way!"}}</p>
          <p data-members-error class="text-sm font-semibold text-error" hidden>{{t "Something went wrong — try again."}}</p>
        </form>
      </div>
    </section>

  </div>

  {{!-- ── The on-this-page rail — contents, then the sponsor slots. ── --}}
  <aside class="ns-reader__aside hidden xl:block">
    <div class="ns-widget ns-widget--toc ns-widget--sunken">
      <div class="ns-widget__head"><span class="ns-widget__title">{{t "On this page"}}</span></div>
      <div class="ns-widget__body">{{> "components/toc"}}</div>
    </div>
    {{> "ads/slot" format="rail"}}
  </aside>

</div>
