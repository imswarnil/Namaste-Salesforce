{{!-- ═══════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — Namaste Salesforce 
  (Strictly Pure Bulma: No Inline CSS, No Custom SCSS)
═══════════════════════════════════════════════════════════════════════ --}}

<div class="columns is-marginless is-multiline has-background-white-ter">

  {{!-- ═══ LEFT: MAIN CONTENT AREA ═══ --}}
  <main class="column is-12-touch is-8-desktop is-9-widescreen py-6 px-4 px-6-desktop">
    <div class="container is-max-desktop">

      {{!-- ─── BRANCH A: COURSE OVERVIEW (#training) ─── --}}
      {{#has tag="#training"}}
        
        {{!-- Hero Box --}}
        <div class="box p-6 mb-6 is-shadowless">
          {{#if primary_tag}}
            <span class="tag is-primary is-light is-rounded has-text-weight-bold mb-4 px-3 py-2">
              <span class="icon is-small mr-1"><i class="ph-fill ph-tag"></i></span>
              <span>{{primary_tag.name}}</span>
            </span>
          {{/if}}

          <h1 class="title is-1 is-size-2-mobile has-text-weight-bold mb-4">{{title}}</h1>
          
          {{#if custom_excerpt}}
            <p class="subtitle is-4 is-size-5-mobile has-text-grey">{{custom_excerpt}}</p>
          {{/if}}

          <hr class="has-background-grey-lighter my-5">

          <nav class="level">
            <div class="level-left">
              {{#primary_author}}
                <div class="level-item">
                  <figure class="image is-48x48 mr-3">
                    {{#if profile_image}}
                      <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="is-rounded">
                    {{else}}
                      <i class="ph-fill ph-user-circle is-size-1 has-text-grey-light"></i>
                    {{/if}}
                  </figure>
                  <div>
                    <p class="heading mb-0 has-text-grey">Instructor</p>
                    <p class="title is-6">{{name}}</p>
                  </div>
                </div>
              {{/primary_author}}
            </div>
            
            <div class="level-right">
              <div class="level-item">
                {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="1"}}
                  {{#foreach posts}}
                    <a href="{{url}}" class="button is-primary is-medium is-rounded has-text-weight-bold">
                      <span class="icon"><i class="ph-fill ph-play"></i></span>
                      <span>Start Learning</span>
                    </a>
                  {{else}}
                    <button class="button is-light is-medium is-rounded" disabled>Coming Soon</button>
                  {{/foreach}}
                {{/get}}
              </div>
            </div>
          </nav>
        </div>

        {{!-- About Box --}}
        <div class="box p-6 is-shadowless">
          <h2 class="title is-4 mb-5">About this track</h2>
          <div class="content is-medium">
            {{content}}
          </div>
        </div>

      {{/has}}


      {{!-- ─── BRANCH B: LESSON PLAYER (#training-content) ─── --}}
      {{#has tag="#training-content"}}

        {{!-- Video Player Wrapper --}}
        <div class="box p-0 mb-5 has-background-black is-clipped is-shadowless">
          <figure class="image is-16by9 is-marginless">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="has-ratio">
              <div class="is-overlay is-flex is-justify-content-center is-align-items-center">
                <button class="button is-large is-rounded is-primary">
                  <span class="icon is-large"><i class="ph-fill ph-play"></i></span>
                </button>
              </div>
            {{else}}
              <div class="is-overlay is-flex is-justify-content-center is-align-items-center">
                <span class="icon is-large has-text-grey-dark"><i class="ph ph-video-camera is-size-1"></i></span>
              </div>
            {{/if}}
          </figure>
          
          {{!-- Top Pagination & Action Bar --}}
          <div class="has-background-white p-4">
            <nav class="level is-mobile mb-0">
              <div class="level-left">
                <div class="level-item">
                  {{#prev_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-light is-rounded has-text-weight-medium">
                      <span class="icon"><i class="ph ph-arrow-left"></i></span>
                      <span class="is-hidden-mobile">Previous</span>
                    </a>
                  {{else}}
                    <button class="button is-light is-rounded" disabled><span class="icon"><i class="ph ph-arrow-left"></i></span></button>
                  {{/prev_post}}
                </div>
              </div>
              
              <div class="level-right">
                <div class="level-item">
                  <button class="button is-light is-rounded mr-2">
                    <span class="icon"><i class="ph ph-bookmark-simple"></i></span>
                  </button>
                  {{#next_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-link is-rounded has-text-weight-bold">
                      <span class="is-hidden-mobile">Next Lesson</span>
                      <span class="icon"><i class="ph ph-arrow-right"></i></span>
                    </a>
                  {{else}}
                    <a href="/training/" class="button is-success is-rounded has-text-weight-bold">
                      <span class="icon"><i class="ph-fill ph-check-circle"></i></span>
                      <span class="is-hidden-mobile">Finish</span>
                    </a>
                  {{/next_post}}
                </div>
              </div>
            </nav>
          </div>
        </div>

        {{!-- Ad Slot --}}
        <div class="notification is-warning is-light has-text-centered mb-5">
          <p class="heading has-text-grey mb-2">Advertisement</p>
          <p class="is-size-6">Place your sponsor or AdSense block here.</p>
        </div>

        {{!-- Main Lesson Content --}}
        <div class="box p-6 is-shadowless">
          <h1 class="title is-2 mb-4">{{title}}</h1>
          
          <div class="is-flex is-align-items-center mb-6">
            {{#if primary_tag}}
              <span class="tag is-light is-rounded mr-3 has-text-weight-medium">{{primary_tag.name}}</span>
            {{/if}}
            <span class="has-text-grey is-size-7">
              <span class="icon"><i class="ph ph-clock"></i></span> {{reading_time minute="1 min read" minutes="% min read"}}
            </span>
          </div>

          {{!-- Table of Contents Partial --}}
          <div class="notification is-info is-light mb-6">
            <p class="has-text-weight-bold mb-3 is-size-5">Table of Contents</p>
            {{> "toc"}}
          </div>

          {{!-- Article Body --}}
          <div class="content is-medium">
            {{content}}
          </div>
        </div>

        {{!-- Large Bottom Pagination --}}
        <div class="columns is-mobile mt-6">
          <div class="column is-half is-flex">
            {{#prev_post in="primary_tag"}}
              <a href="{{url}}" class="box has-background-white-ter is-shadowless is-flex-grow-1 is-flex is-flex-direction-column is-justify-content-center">
                <p class="heading has-text-grey mb-1"><i class="ph ph-arrow-left"></i> Previous</p>
                <p class="has-text-link has-text-weight-bold mb-0">{{title}}</p>
              </a>
            {{/prev_post}}
          </div>
          <div class="column is-half is-flex">
            {{#next_post in="primary_tag"}}
              <a href="{{url}}" class="box has-background-white-ter is-shadowless is-flex-grow-1 is-flex is-flex-direction-column is-justify-content-center has-text-right">
                <p class="heading has-text-grey mb-1">Next <i class="ph ph-arrow-right"></i></p>
                <p class="has-text-link has-text-weight-bold mb-0">{{title}}</p>
              </a>
            {{else}}
               <a href="/training/" class="box has-background-success-light is-shadowless is-flex-grow-1 is-flex is-flex-direction-column is-justify-content-center has-text-right">
                <p class="heading has-text-success mb-1"><i class="ph-fill ph-check-circle"></i> Course Complete</p>
                <p class="has-text-success has-text-weight-bold mb-0">Return to Track</p>
              </a>
            {{/next_post}}
          </div>
        </div>

      {{/has}}

    </div>
  </main>


  {{!-- ═══ RIGHT: CURRICULUM SIDEBAR ═══ --}}
  <aside class="column is-12-touch is-4-desktop is-3-widescreen has-background-white py-6 px-5">
    
    <div class="is-flex is-align-items-center mb-6">
      <span class="icon has-text-link mr-2 is-medium"><i class="ph-fill ph-books is-size-4"></i></span>
      <h3 class="title is-5 mb-0">Course Content</h3>
    </div>

    <aside class="menu">
      {{#get "posts" filter="tag:hash-training" order="published_at asc" limit="50"}}
        {{#foreach posts}}
          
          <p class="menu-label has-text-weight-bold has-text-grey-dark mt-6 mb-3">
            {{title}}
          </p>
          
          <ul class="menu-list">
            {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="100" as |lessons|}}
              {{#if lessons}}
                {{#foreach lessons}}
                  <li>
                    <a href="{{url}}" class="{{#match id ../../../../id}}is-active{{/match}} is-flex is-align-items-center is-justify-content-space-between py-3">
                      
                      <div class="is-flex is-align-items-center is-clipped">
                        <span class="icon mr-2 is-flex-shrink-0">
                          <i class="{{#match id ../../../../id}}ph-fill ph-play-circle{{else}}ph ph-circle{{/match}}"></i>
                        </span>
                        <span>{{title}}</span>
                      </div>

                      <span class="is-size-7 ml-3 is-flex-shrink-0 {{#match id ../../../../id}}has-text-white{{else}}has-text-grey-light{{/match}}">
                        {{reading_time minute="1m" minutes="%m"}}
                      </span>
                      
                    </a>
                  </li>
                {{/foreach}}
              {{else}}
                <li><a class="has-text-grey-light" disabled>No lessons yet.</a></li>
              {{/if}}
            {{/get}}
          </ul>

        {{/foreach}}
      {{else}}
        <p class="has-text-grey">No training courses found.</p>
      {{/get}}
    </aside>

  </aside>

</div>