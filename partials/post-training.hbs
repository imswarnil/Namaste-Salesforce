{{!-- ═══════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — Namaste Salesforce
═══════════════════════════════════════════════════════════════════════ --}}

<div class="columns is-marginless is-multiline">

  {{!-- ═══ LEFT: MAIN CONTENT AREA ═══ --}}
  <main class="column is-12-touch is-8-desktop is-9-widescreen py-6 px-4 px-6-desktop">
    <div class="container is-max-desktop">

      {{!-- ─── BRANCH A: TRACK OVERVIEW (#training) ─── --}}
      {{#has tag="#training"}}

        {{!-- Track Hero --}}
        <div class="ns-glass-card p-6 mb-6" style="border-radius: 16px;">
          {{#if primary_tag}}
            <span class="tag ns-badge ns-badge--gradient is-medium is-rounded has-text-weight-bold mb-4 px-3 py-2">
              <span class="icon is-small mr-1"><i class="ph-fill ph-tag"></i></span>
              {{primary_tag.name}}
            </span>
          {{/if}}

          <h1 class="title is-1 is-size-2-mobile has-text-weight-bold mb-4 ns-fade-up" style="line-height: 1.15;">
            {{title}}
          </h1>

          {{#if custom_excerpt}}
            <p class="ns-lead ns-fade-up ns-stagger-1">{{custom_excerpt}}</p>
          {{/if}}

          <div class="ns-divider"></div>

          <div class="is-flex is-align-items-center is-justify-content-space-between is-flex-wrap-wrap" style="gap: 1rem;">
            {{#primary_author}}
              <div class="is-flex is-align-items-center" style="gap: 0.75rem;">
                <figure class="image is-48x48">
                  {{#if profile_image}}
                    <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="is-rounded" style="border: 2px solid rgba(128,128,128,0.2);">
                  {{else}}
                    <span class="icon is-large" style="opacity: 0.4;"><i class="ph-fill ph-user-circle" style="font-size: 3rem;"></i></span>
                  {{/if}}
                </figure>
                <div>
                  <p class="is-size-7 mb-0" style="opacity: 0.55; letter-spacing: 0.06em; text-transform: uppercase;">Instructor</p>
                  <p class="has-text-weight-bold is-size-6 mb-0">{{name}}</p>
                </div>
              </div>
            {{/primary_author}}

            {{!-- Start Learning CTA --}}
            {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="1"}}
              {{#foreach posts}}
                <a href="{{url}}" class="button is-gradient ns-gradient-animated is-medium is-rounded has-text-weight-bold">
                  <span class="icon"><i class="ph-fill ph-play"></i></span>
                  <span>Start Learning</span>
                </a>
              {{else}}
                <button class="button is-light is-medium is-rounded" disabled>
                  <span class="icon"><i class="ph ph-clock"></i></span>
                  <span>Coming Soon</span>
                </button>
              {{/foreach}}
            {{/get}}
          </div>
        </div>

        {{!-- About Track --}}
        <div class="ns-glass-card p-6" style="border-radius: 16px;">
          <h2 class="title is-4 mb-5">About this track</h2>
          <div class="content is-medium">
            {{content}}
          </div>
        </div>

      {{/has}}


      {{!-- ─── BRANCH B: LESSON PLAYER (#training-content) ─── --}}
      {{#has tag="#training-content"}}

        {{!-- Video / Feature Image Player --}}
        <div class="mb-5" style="border-radius: 16px; overflow: hidden; background: #000;">
          <figure class="image is-16by9 is-marginless">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="has-ratio" style="object-fit: cover; opacity: 0.9;">
              <div class="is-overlay is-flex is-justify-content-center is-align-items-center">
                <button class="button is-large is-rounded is-gradient has-text-weight-bold" style="box-shadow: 0 8px 24px rgba(0,0,0,0.35);">
                  <span class="icon is-medium"><i class="ph-fill ph-play"></i></span>
                </button>
              </div>
            {{else}}
              <div class="is-overlay is-flex is-justify-content-center is-align-items-center" style="background: #111;">
                <span class="icon is-large" style="opacity: 0.2;"><i class="ph ph-video-camera" style="font-size: 4rem; color: #fff;"></i></span>
              </div>
            {{/if}}
          </figure>

          {{!-- Top Nav Bar --}}
          <div class="ns-glass-card p-4" style="border-radius: 0;">
            <nav class="level is-mobile mb-0">
              <div class="level-left">
                <div class="level-item">
                  {{#prev_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-light is-rounded has-text-weight-semibold">
                      <span class="icon"><i class="ph ph-arrow-left"></i></span>
                      <span class="is-hidden-mobile">Previous</span>
                    </a>
                  {{else}}
                    <button class="button is-light is-rounded" disabled>
                      <span class="icon"><i class="ph ph-arrow-left"></i></span>
                    </button>
                  {{/prev_post}}
                </div>
              </div>
              <div class="level-right">
                <div class="level-item" style="gap: 0.5rem;">
                  <button class="button is-light is-rounded">
                    <span class="icon"><i class="ph ph-bookmark-simple"></i></span>
                  </button>
                  {{#next_post in="primary_tag"}}
                    <a href="{{url}}" class="button is-gradient is-rounded has-text-weight-bold">
                      <span class="is-hidden-mobile">Next Lesson</span>
                      <span class="icon"><i class="ph ph-arrow-right"></i></span>
                    </a>
                  {{else}}
                    <a href="/training/" class="button is-glow is-rounded has-text-weight-bold">
                      <span class="icon"><i class="ph-fill ph-check-circle"></i></span>
                      <span class="is-hidden-mobile">Finish</span>
                    </a>
                  {{/next_post}}
                </div>
              </div>
            </nav>
          </div>
        </div>

        {{!-- Main Lesson Content --}}
        <div class="ns-glass-card p-6" style="border-radius: 16px;">
          <h1 class="title is-2 mb-4 ns-fade-up">{{title}}</h1>

          <div class="is-flex is-align-items-center mb-6" style="gap: 0.75rem; flex-wrap: wrap;">
            {{#if primary_tag}}
              <span class="tag ns-badge is-rounded has-text-weight-semibold">{{primary_tag.name}}</span>
            {{/if}}
            <span class="is-size-7" style="opacity: 0.55;">
              <span class="icon is-small mr-1"><i class="ph ph-clock"></i></span>
              {{reading_time minute="1 min read" minutes="% min read"}}
            </span>
          </div>

          {{!-- Table of Contents --}}
          <div class="ns-glass-card p-4 mb-6" style="border-radius: 10px;">
            <p class="has-text-weight-bold mb-3 is-size-6">
              <span class="icon is-small mr-1"><i class="ph-fill ph-list-dashes"></i></span>
              Table of Contents
            </p>
            {{> "toc"}}
          </div>

          {{!-- Article Body --}}
          <div class="content is-medium">
            {{content}}
          </div>
        </div>

        {{!-- Large Bottom Pagination --}}
        <div class="columns is-mobile mt-6" style="gap: 0.25rem;">
          <div class="column is-half">
            {{#prev_post in="primary_tag"}}
              <a href="{{url}}" class="ns-glass-card p-4 is-flex is-flex-direction-column is-justify-content-center h-100" style="border-radius: 12px; min-height: 80px; text-decoration: none; display: flex;">
                <p class="is-size-7 mb-1" style="opacity: 0.5;">
                  <i class="ph ph-arrow-left mr-1"></i> Previous
                </p>
                <p class="has-text-weight-bold mb-0" style="line-height: 1.3;">{{title}}</p>
              </a>
            {{/prev_post}}
          </div>
          <div class="column is-half">
            {{#next_post in="primary_tag"}}
              <a href="{{url}}" class="ns-glass-card p-4 is-flex is-flex-direction-column is-justify-content-center has-text-right h-100" style="border-radius: 12px; min-height: 80px; text-decoration: none; display: flex;">
                <p class="is-size-7 mb-1" style="opacity: 0.5;">
                  Next <i class="ph ph-arrow-right ml-1"></i>
                </p>
                <p class="has-text-weight-bold mb-0" style="line-height: 1.3;">{{title}}</p>
              </a>
            {{else}}
              <a href="/training/" class="ns-glass-card p-4 is-flex is-flex-direction-column is-justify-content-center has-text-right h-100" style="border-radius: 12px; min-height: 80px; text-decoration: none; display: flex; border-color: rgba(72,199,142,0.4);">
                <p class="is-size-7 has-text-success mb-1">
                  <i class="ph-fill ph-check-circle mr-1"></i> Course Complete
                </p>
                <p class="has-text-success has-text-weight-bold mb-0">Return to Track</p>
              </a>
            {{/next_post}}
          </div>
        </div>

      {{/has}}

    </div>
  </main>


  {{!-- ═══ RIGHT: CURRICULUM SIDEBAR ═══ --}}
  <aside class="column is-12-touch is-4-desktop is-3-widescreen py-6 px-5" style="border-left: 1px solid rgba(128,128,128,0.1);">

    <div class="is-flex is-align-items-center mb-5" style="gap: 0.5rem;">
      <span class="icon has-text-primary is-medium"><i class="ph-fill ph-books" style="font-size: 1.4rem;"></i></span>
      <h3 class="title is-5 mb-0">Course Content</h3>
    </div>

    <aside class="menu">
      {{#get "posts" filter="tag:hash-training" order="published_at asc" limit="50"}}
        {{#foreach posts}}

          <p class="menu-label has-text-weight-bold mt-5 mb-2" style="letter-spacing: 0.06em;">
            {{title}}
          </p>

          <ul class="menu-list">
            {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="100" as |lessons|}}
              {{#if lessons}}
                {{#foreach lessons}}
                  <li>
                    <a href="{{url}}" class="is-flex is-align-items-center is-justify-content-space-between py-3
                      {{#match id ../../../../id}}is-active{{/match}}"
                      style="border-radius: 8px; gap: 0.5rem;">

                      <div class="is-flex is-align-items-center is-clipped" style="gap: 0.4rem;">
                        <span class="icon is-small is-flex-shrink-0">
                          <i class="{{#match id ../../../../id}}ph-fill ph-play-circle{{else}}ph ph-circle{{/match}}"></i>
                        </span>
                        <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{title}}</span>
                      </div>

                      <span class="is-size-7 is-flex-shrink-0 {{#match id ../../../../id}}{{else}}has-text-grey-light{{/match}}">
                        {{reading_time minute="1m" minutes="%m"}}
                      </span>

                    </a>
                  </li>
                {{/foreach}}
              {{else}}
                <li><span class="is-size-7 px-3 py-2 is-block" style="opacity: 0.45; font-style: italic;">No lessons yet.</span></li>
              {{/if}}
            {{/get}}
          </ul>

        {{/foreach}}
      {{else}}
        <p class="is-size-6" style="opacity: 0.5;">No training courses found.</p>
      {{/get}}
    </aside>

  </aside>

</div>
