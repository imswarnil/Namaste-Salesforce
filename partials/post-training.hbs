{{!-- partials/post-training.hbs
     LMS player layout for both training overview and module reader.
     Dispatched from post.hbs for tag "#training" and tag "#training-content".
     Uses has helper to branch layouts. Sidebar is shared.
--}}

{{!-- Mobile top bar --}}
<div class="ns-player-mob-bar is-hidden-desktop" id="nsPlayerMobBar">
  <span class="ns-player-mob-title">{{title}}</span>
  <button class="button is-light is-small ns-player-mob-btn"
          type="button"
          id="nsPlayerMobToggle"
          aria-expanded="false"
          aria-controls="nsPlayerMobPanel">
    <span class="icon is-small"><i class="ph ph-list-bullets" aria-hidden="true"></i></span>
    <span>Modules</span>
    <span class="icon is-small"><i class="ph ph-caret-down" aria-hidden="true"></i></span>
  </button>
</div>

{{!-- Mobile panel --}}
<div class="ns-player-mob-panel is-hidden-desktop" id="nsPlayerMobPanel" aria-hidden="true">
  <nav class="panel ns-mob-panel-nav">
    <p class="panel-heading">Course Content</p>
    <a href="/training/" class="panel-block">
      <span class="panel-icon"><i class="ph ph-arrow-left" aria-hidden="true"></i></span>
      All training
    </a>
    {{#get "posts"
      filter="tag:hash-training"
      order="published_at asc"
      limit="100"
    }}
      {{#foreach posts}}
        <div class="ns-mob-group">
          <a href="{{url}}"
             class="panel-block ns-mob-group-hd{{#match id ../../id}} is-active{{/match}}">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="xxs"}}"
                   alt="" class="ns-mob-group-img" aria-hidden="true">
            {{else}}
              <span class="panel-icon"><i class="ph ph-stack" aria-hidden="true"></i></span>
            {{/if}}
            <span class="has-text-weight-semibold">{{title}}</span>
          </a>
          {{#get "posts"
            filter="tag:hash-training-content+primary_tag:{{slug}}"
            order="published_at asc"
            limit="100"
          }}
            {{#if posts}}
              {{#foreach posts}}
                <a href="{{url}}"
                   class="panel-block ns-mob-lesson{{#match id ../../../../id}} is-active{{/match}}">
                  <span class="panel-icon is-size-7 has-text-grey ns-mob-lesson-num">{{@number}}</span>
                  <span class="is-size-7">{{title}}</span>
                  <span class="ml-auto is-size-7 has-text-grey-light">{{reading_time}}</span>
                </a>
              {{/foreach}}
            {{/if}}
          {{/get}}
        </div>
      {{/foreach}}
    {{/get}}
  </nav>
</div>

{{!-- PLAYER SHELL --}}
<div class="ns-player">

  {{!-- Player top navbar --}}
  <nav class="navbar ns-player-nav" role="navigation" aria-label="Player navigation">
    <div class="navbar-brand">
      <a href="/training/" class="navbar-item ns-player-back">
        <span class="icon is-small"><i class="ph ph-caret-left" aria-hidden="true"></i></span>
        <span class="is-hidden-mobile">All training</span>
        <span class="is-hidden-tablet">Back</span>
      </a>
      {{#has tag="#training-content"}}
        <div class="navbar-item is-hidden-mobile">
          {{#get "posts"
            filter="tag:hash-training+slug:{{primary_tag.slug}}"
            limit="1"
          }}
            {{#foreach posts}}
              <span class="has-text-weight-semibold ns-player-course-name">{{title}}</span>
              <span class="mx-2 has-text-grey-light">/</span>
            {{/foreach}}
          {{/get}}
          <span class="has-text-grey-dark">{{title}}</span>
        </div>
      {{else has tag="#training"}}
        <div class="navbar-item is-hidden-mobile">
          <span class="has-text-weight-bold">{{title}}</span>
        </div>
      {{/has}}
    </div>
    <div class="navbar-end">
      <div class="navbar-item">
        <span class="tag is-primary is-light">
          <i class="ph ph-graduation-cap mr-1" aria-hidden="true"></i>
          Training
        </span>
      </div>
    </div>
  </nav>

  {{!-- Player body: main + sidebar --}}
  <div class="ns-player-body">

    {{!-- =========================================================
      LEFT MAIN CONTENT
    ========================================================= --}}
    <main class="ns-player-main">

      {{!-- TRAINING OVERVIEW --}}
      {{#has tag="#training"}}
        <div class="container ns-overview py-5">

          {{!-- Bulma breadcrumb --}}
          <nav class="breadcrumb is-small mb-5" aria-label="breadcrumbs">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/training/">Training</a></li>
              <li class="is-active">
                <a href="{{url}}" aria-current="page">{{title}}</a>
              </li>
            </ul>
          </nav>

          {{!-- Hero card --}}
          <div class="card ns-overview-hero mb-5">
            {{#if feature_image}}
              <div class="card-image">
                <figure class="image is-16by9">
                  <img src="{{img_url feature_image size="l"}}"
                       alt="{{title}}" loading="lazy">
                </figure>
              </div>
            {{/if}}
            <div class="card-content">
              {{#if primary_tag}}
                <div class="ns-overview-cat mb-3">
                  {{#if primary_tag.feature_image}}
                    <img src="{{img_url primary_tag.feature_image size="xxs"}}"
                         alt="" class="ns-overview-cat-img" aria-hidden="true" loading="lazy">
                  {{else}}
                    <span class="ns-overview-cat-icon" aria-hidden="true">
                      <i class="ph ph-tag-simple"></i>
                    </span>
                  {{/if}}
                  <span class="tag is-primary is-light">{{primary_tag.name}}</span>
                </div>
              {{/if}}
              <h1 class="title is-2 mb-3">{{title}}</h1>
              {{#if custom_excerpt}}
                <p class="subtitle is-5 has-text-grey">{{custom_excerpt}}</p>
              {{/if}}
              <div class="ns-overview-stats mt-4 mb-5">
                {{#get "posts"
                  filter="tag:hash-training-content+primary_tag:{{slug}}"
                  limit="100"
                }}
                  <span class="ns-overview-stat">
                    <i class="ph ph-stack" aria-hidden="true"></i>
                    {{posts.length}} modules
                  </span>
                {{/get}}
                {{#foreach tags visibility="internal"}}
                  {{#match slug "~^" "hash-training-duration-"}}
                    {{#if description}}
                      <span class="ns-overview-stat">
                        <i class="ph ph-clock" aria-hidden="true"></i>
                        {{description}}
                      </span>
                    {{/if}}
                  {{/match}}
                {{/foreach}}
                {{#foreach tags visibility="internal"}}
                  {{#match slug "~^" "hash-training-level-"}}
                    {{#if description}}
                      <span class="ns-overview-stat">
                        <i class="ph ph-signal-high" aria-hidden="true"></i>
                        {{description}}
                      </span>
                    {{/if}}
                  {{/match}}
                {{/foreach}}
                <span class="ns-overview-stat">
                  <i class="ph ph-calendar" aria-hidden="true"></i>
                  Updated {{date updated_at format="MMM YYYY"}}
                </span>
              </div>
              {{#primary_author}}
                <div class="media mb-4">
                  <figure class="media-left">
                    {{#if profile_image}}
                      <p class="image is-48x48">
                        <img src="{{img_url profile_image size="xs"}}"
                             alt="{{name}}" class="is-rounded" loading="lazy">
                      </p>
                    {{else}}
                      <p class="image is-48x48" style="display:flex;align-items:center;justify-content:center">
                        <i class="ph ph-user-circle" style="font-size:3rem;color:var(--theme-text-weak)"></i>
                      </p>
                    {{/if}}
                  </figure>
                  <div class="media-content">
                    <p class="is-size-7 has-text-grey mb-0">Instructor</p>
                    <p class="has-text-weight-bold mb-0">{{name}}</p>
                  </div>
                </div>
              {{/primary_author}}
              {{#get "posts"
                filter="tag:hash-training-content+primary_tag:{{slug}}"
                order="published_at asc"
                limit="1"
              }}
                {{#foreach posts}}
                  <div class="buttons">
                    <a href="{{url}}" class="button is-primary is-medium">
                      <span class="icon is-small">
                        <i class="ph ph-rocket-launch" aria-hidden="true"></i>
                      </span>
                      <span>Start Training</span>
                    </a>
                    <a href="/training/" class="button is-light is-medium">
                      <span class="icon is-small">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i>
                      </span>
                      <span>All courses</span>
                    </a>
                  </div>
                {{else}}
                  <button class="button is-primary is-medium" disabled>Coming soon</button>
                {{/foreach}}
              {{/get}}
            </div>
          </div>

          {{!-- About / post content --}}
          {{#if content}}
            <div class="box mb-5">
              <h2 class="title is-4 mb-4">About this training</h2>
              <div class="content gh-content">{{content}}</div>
            </div>
          {{/if}}

          {{!-- Module accordion list --}}
          {{#get "posts"
            filter="tag:hash-training-content+primary_tag:{{slug}}"
            order="published_at asc"
            limit="100"
            include="tags"
          }}
            {{#if posts}}
              <div class="box">
                <div class="level mb-4">
                  <div class="level-left">
                    <div class="level-item">
                      <h2 class="title is-4 mb-0">Course Modules</h2>
                    </div>
                    <div class="level-item">
                      <span class="tag is-light">{{posts.length}} modules</span>
                    </div>
                  </div>
                </div>
                {{#foreach posts}}
                  <a href="{{url}}" class="ns-mod-row">
                    <div class="ns-mod-row-num">{{@number}}</div>
                    <div class="ns-mod-row-body">
                      <p class="ns-mod-row-title">{{title}}</p>
                      {{#if custom_excerpt}}
                        <p class="ns-mod-row-excerpt">{{custom_excerpt}}</p>
                      {{/if}}
                    </div>
                    <div class="ns-mod-row-meta">
                      <span class="tag is-light is-small">
                        <i class="ph ph-timer mr-1" aria-hidden="true"></i>
                        {{reading_time}}
                      </span>
                    </div>
                    <i class="ph ph-arrow-right ns-mod-row-arrow" aria-hidden="true"></i>
                  </a>
                {{/foreach}}
              </div>
            {{else}}
              <div class="notification is-light">No modules published yet.</div>
            {{/if}}
          {{/get}}

        </div>

      {{!-- MODULE READER --}}
      {{else has tag="#training-content"}}

        {{!-- Lesson action bar --}}
        <div class="ns-lesson-bar">
          {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
            <a href="{{url}}" class="button is-white has-text-grey-dark">
              <span class="icon"><i class="ph ph-arrow-left" aria-hidden="true"></i></span>
              <span class="is-hidden-mobile">Previous</span>
            </a>
          {{else}}
            <button class="button is-white" disabled>
              <span class="icon"><i class="ph ph-arrow-left" aria-hidden="true"></i></span>
              <span class="is-hidden-mobile">Previous</span>
            </button>
          {{/prev_post}}
          <span class="ns-lesson-bar-title is-hidden-mobile">{{title}}</span>
          {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
            <a href="{{url}}" class="button is-primary">
              <span class="is-hidden-mobile">Continue</span>
              <span class="is-hidden-tablet">Next</span>
              <span class="icon"><i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          {{else}}
            {{#get "posts"
              filter="tag:hash-training+slug:{{primary_tag.slug}}"
              limit="1"
            }}
              {{#foreach posts}}
                <a href="{{url}}" class="button is-success">
                  <span class="icon"><i class="ph ph-check-circle" aria-hidden="true"></i></span>
                  <span>Finish</span>
                </a>
              {{else}}
                <a href="/training/" class="button is-success">
                  <span class="icon"><i class="ph ph-check-circle" aria-hidden="true"></i></span>
                  <span>Done</span>
                </a>
              {{/foreach}}
            {{/get}}
          {{/next_post}}
        </div>

        {{!-- Feature image as lesson cover --}}
        {{#if feature_image}}
          <div class="ns-lesson-cover">
            <figure class="image is-16by9">
              <img src="{{img_url feature_image size="xl"}}"
                   alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                   loading="lazy">
            </figure>
          </div>
        {{/if}}

        {{!-- Content area --}}
        <div class="container is-fluid py-5">
          <div class="box ns-lesson-box">

            {{!-- Content tabs --}}
            <div class="tabs">
              <ul>
                <li class="is-active"><a>Overview</a></li>
              </ul>
            </div>

            <div class="content gh-content mt-4">

              {{!-- Article header --}}
              <header class="ns-reader-header mb-5">
                <div class="tags mb-3">
                  <span class="tag is-primary is-light">Module</span>
                  {{#if primary_tag}}
                    <a href="{{primary_tag.url}}" class="tag is-light">
                      {{primary_tag.name}}
                    </a>
                  {{/if}}
                  <span class="tag is-white has-text-grey">
                    <span class="icon is-small">
                      <i class="ph ph-clock" aria-hidden="true"></i>
                    </span>
                    <span>{{reading_time}}</span>
                  </span>
                </div>
                <h1 class="title is-2 is-size-3-mobile">{{title}}</h1>
                {{#if custom_excerpt}}
                  <p class="subtitle is-5 has-text-grey">{{custom_excerpt}}</p>
                {{/if}}
                {{#primary_author}}
                  <div class="is-flex is-align-items-center mt-4" style="gap:.5rem;flex-wrap:wrap">
                    {{#if profile_image}}
                      <figure class="image is-32x32">
                        <img src="{{img_url profile_image size="xxs"}}"
                             alt="{{name}}" class="is-rounded" loading="lazy">
                      </figure>
                    {{else}}
                      <i class="ph ph-user-circle has-text-grey" style="font-size:2rem"></i>
                    {{/if}}
                    <span class="is-size-7 has-text-grey">{{name}}</span>
                    {{#if updated_at}}
                      <span class="is-size-7 has-text-grey-light">
                        · Updated {{date updated_at format="MMM D, YYYY"}}
                      </span>
                    {{/if}}
                  </div>
                {{/primary_author}}
              </header>

              {{!-- Article body --}}
              <div class="ns-reader-body js-toc-content">{{content}}</div>

              {{!-- Prev / Next pager --}}
              <div class="ns-reader-pager mt-6 pt-5">
                <div class="ns-reader-pager-prev">
                  {{#prev_post in="primary_tag" filter="tag:hash-training-content"}}
                    <a href="{{url}}" class="ns-pager-card">
                      <p class="ns-pager-dir">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i> Previous
                      </p>
                      <p class="ns-pager-title">{{title}}</p>
                    </a>
                  {{/prev_post}}
                </div>
                <div class="ns-reader-pager-next">
                  {{#next_post in="primary_tag" filter="tag:hash-training-content"}}
                    <a href="{{url}}" class="ns-pager-card ns-pager-card--right">
                      <p class="ns-pager-dir">
                        Next <i class="ph ph-arrow-right" aria-hidden="true"></i>
                      </p>
                      <p class="ns-pager-title">{{title}}</p>
                    </a>
                  {{else}}
                    {{#get "posts"
                      filter="tag:hash-training+slug:{{primary_tag.slug}}"
                      limit="1"
                    }}
                      {{#foreach posts}}
                        <a href="{{url}}"
                           class="ns-pager-card ns-pager-card--right ns-pager-card--done">
                          <p class="ns-pager-dir">
                            <i class="ph ph-check-circle" aria-hidden="true"></i> Finish training
                          </p>
                          <p class="ns-pager-title">{{title}}</p>
                        </a>
                      {{else}}
                        <a href="/training/"
                           class="ns-pager-card ns-pager-card--right ns-pager-card--done">
                          <p class="ns-pager-dir">
                            <i class="ph ph-check-circle" aria-hidden="true"></i> All done
                          </p>
                          <p class="ns-pager-title">Back to training</p>
                        </a>
                      {{/foreach}}
                    {{/get}}
                  {{/next_post}}
                </div>
              </div>

            </div>
          </div>
        </div>

      {{/has}}
    </main>

    {{!-- =========================================================
      RIGHT SIDEBAR — shared for both views
    ========================================================= --}}
    <aside class="ns-player-sidebar is-hidden-touch">

      <div class="ns-sidebar-head">
        <h2 class="title is-5 mb-0">Course Content</h2>
      </div>

      <div class="ns-sidebar-body">
        {{!-- All trainings grouped with their modules --}}
        {{#get "posts"
          filter="tag:hash-training"
          order="published_at asc"
          limit="100"
        }}
          {{#foreach posts}}
            <div class="ns-sidebar-group">

              {{!-- Group header: training title + icon --}}
              <a href="{{url}}"
                 class="ns-sidebar-group-hd{{#match id ../../id}} is-active{{/match}}">
                <span class="ns-sidebar-group-hd-left">
                  {{#if feature_image}}
                    <img src="{{img_url feature_image size="xxs"}}"
                         alt="" class="ns-sidebar-group-img" aria-hidden="true">
                  {{else}}
                    <span class="ns-sidebar-group-icon" aria-hidden="true">
                      <i class="ph ph-stack"></i>
                    </span>
                  {{/if}}
                  <span class="ns-sidebar-group-title">{{title}}</span>
                </span>
                <i class="ph ph-caret-down ns-sidebar-group-caret" aria-hidden="true"></i>
              </a>

              {{!-- Module list --}}
              {{#get "posts"
                filter="tag:hash-training-content+primary_tag:{{slug}}"
                order="published_at asc"
                limit="100"
              }}
                {{#if posts}}
                  <div class="ns-sidebar-lessons">
                    {{#foreach posts}}
                      <a href="{{url}}"
                         class="ns-sidebar-lesson{{#match id ../../../../id}} is-active{{/match}}">
                        <i class="ph ph-play-circle ns-sidebar-lesson-icon" aria-hidden="true"></i>
                        <div class="ns-sidebar-lesson-body">
                          <p class="ns-sidebar-lesson-title">{{title}}</p>
                          <p class="ns-sidebar-lesson-meta">
                            <i class="ph ph-timer" aria-hidden="true"></i>
                            {{reading_time}}
                          </p>
                        </div>
                      </a>
                    {{/foreach}}
                  </div>
                {{/if}}
              {{/get}}

            </div>
          {{/foreach}}
        {{/get}}
      </div>

    </aside>

  </div>
</div>

<script>
(function () {
  'use strict';
  var toggle = document.getElementById('nsPlayerMobToggle');
  var panel  = document.getElementById('nsPlayerMobPanel');
  if (!toggle || !panel) return;

  function setOpen(open) {
    panel.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open', open);
    var caret = toggle.querySelector('.ph-caret-down');
    if (caret) caret.style.transform = open ? 'rotate(180deg)' : '';
  }

  toggle.addEventListener('click', function () {
    setOpen(!panel.classList.contains('is-open'));
  });
  document.addEventListener('click', function (e) {
    if (panel.classList.contains('is-open') &&
        !panel.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) {
      setOpen(false); toggle.focus();
    }
  });

  var active = document.querySelector(
    '.ns-sidebar-lesson.is-active, .ns-sidebar-group-hd.is-active');
  if (active) {
    active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    var grp = active.closest('.ns-sidebar-group');
    if (grp) grp.classList.add('is-open');
  }
})();
</script>
