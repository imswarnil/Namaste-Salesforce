{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-training.hbs — the training LESSON player (#training-content).
  ----------------------------------------------------------------------------
  Layout (module player):  curriculum sidebar LEFT (docs-style, sticky)
  · right region = full-width medium hero (VIDEO modules put the video itself
  in the hero — training-video.js adopts the first embed and wires timestamp
  tables to seek it; other modules get a clean light hero with title)
  · below the hero, two columns: article content + right rail where TOC and
  ad/sponsor widgets pin one after another (sticky deck).
  Mobile: curriculum stays in the drawer under the navbar (player header
  hamburger), the TOC renders inline above the content. Context: {{#post}}.
═══════════════════════════════════════════════════════════════════════════ --}}
{{!-- Full-bleed: edge to edge, sections divided by hairline borders --}}
<section class="w-full">
  <div class="grid lg:grid-cols-[19rem_minmax(0,1fr)]">

    {{!-- ── Left: curriculum (sticky on lg; mobile drawer via player header) ── --}}
    <aside class="lg:border-r lg:border-border">
      <div class="lg:sticky lg:top-16 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto lg:p-4">
        {{!-- cur/curId drive the rail's active row: the lesson's primary tag IS
             its section, and curId marks the lesson itself (so the section's
             "Overview" row correctly stays inactive). --}}
        {{> "training/curriculum" cur=primary_tag.slug curId=id}}
        {{> "training/newsletter-widget"}}
      </div>
    </aside>

    <div class="min-w-0 px-4 py-8 sm:px-6 lg:px-8">

      {{!-- There is no training-overview branch any more: /training/ is the
           training (a route, not a post), so this partial only ever renders a
           LESSON. See routes.yaml. --}}

      {{!-- ─── The lesson player ─── --}}
      {{#has tag="#training-content"}}
        {{!-- Hero: medium height, full width of the content region.
             VIDEO modules → the video lives here (poster until
             training-video.js adopts the embed); others → light title hero --}}
        {{#has tag="#training-type-video"}}
          <div data-video-hero class="relative aspect-video max-h-[32rem] w-full overflow-hidden rounded-card bg-black shadow-card">
            {{#if feature_image}}
              <img loading="lazy" decoding="async" src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="h-full w-full object-cover opacity-90">
            {{else}}
              <div class="h-full w-full bg-brand-900"></div>
            {{/if}}
            <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-brand-600 shadow-raised"><i class="ph-fill ph-play text-2xl" aria-hidden="true"></i></span>
            </span>
          </div>
        {{else}}
          {{!-- Light hero. When the lesson HAS an image it goes two-column and
               shows it; without one the copy simply spans the full width, so
               there's no empty slot to fill. The grid hugs the image side and
               dissolves before it reaches the text. --}}
          <header class="relative overflow-hidden rounded-card border border-border bg-surface p-6 sm:p-10">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid-corner text-brand-500/70"></div>
            <div class="relative grid items-center gap-6 {{#if feature_image}}sm:grid-cols-[minmax(0,1fr)_14rem]{{/if}}">
              <div>
                {{#if primary_tag}}
                  {{!-- the primary tag IS the section, so link it there --}}
                  <a href="/training/{{primary_tag.slug}}/" class="ns-badge ns-transition hover:text-brand-700"><i class="ph-fill ph-folder-open" aria-hidden="true"></i>{{primary_tag.name}}</a>
                {{/if}}
                <h1 class="mt-4 font-heading text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{{title}}</h1>
                {{#if custom_excerpt}}<p class="mt-2 max-w-2xl text-muted">{{custom_excerpt}}</p>{{/if}}
              </div>
              {{#if feature_image}}
                <img decoding="async" src="{{img_url feature_image size="m"}}" alt="" loading="eager"
                     class="hidden aspect-[4/3] w-full rounded-card border border-border object-cover sm:block">
              {{/if}}
            </div>
          </header>
        {{/has}}

        {{!-- Below the hero: content left · TOC + widgets right --}}
        <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1fr)_16rem]">

          <article class="min-w-0">
            {{!-- Video modules carry their title here, under the player --}}
            {{#has tag="#training-type-video"}}
              <h1 class="font-heading text-2xl font-extrabold tracking-tight sm:text-3xl">{{title}}</h1>
              {{#if custom_excerpt}}<p class="mt-2 text-lg text-muted">{{custom_excerpt}}</p>{{/if}}
            {{/has}}

            <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-muted">
              {{#if primary_tag}}<span class="ns-badge">{{primary_tag.name}}</span>{{/if}}
              {{!-- Module type chip --}}
              {{#has tag="#training-type-video"}}<span class="ns-lesson-type ns-lesson-type--video"><i class="ph-fill ph-video-camera" aria-hidden="true"></i>{{t "Video"}}</span>
              {{else has tag="#training-type-exercise"}}<span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-barbell" aria-hidden="true"></i>{{t "Exercise"}}</span>
              {{else has tag="#training-type-quiz"}}<span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-exam" aria-hidden="true"></i>{{t "Quiz"}}</span>
              {{else}}<span class="ns-lesson-type ns-lesson-type--article"><i class="ph-fill ph-article" aria-hidden="true"></i>{{t "Article"}}</span>{{/has}}
              <span class="inline-flex items-center gap-1 font-mono text-xs text-label"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time minute="1 min" minutes="% min"}}</span>
            </div>

            {{!-- Mobile/tablet TOC (the xl rail has its own instance) --}}
            <div class="mt-6 border-l-2 border-brand-500/30 pl-4 xl:hidden">
              {{> "components/toc"}}
            </div>

            <div class="prose mt-6 max-w-none gh-content">{{content}}</div>

            {{!-- Bottom prev/next (training-nav.js flows across tracks) --}}
            <div class="mt-10 grid grid-cols-2 gap-3 border-t border-border pt-6">
              <a class="js-train-prev flex h-full flex-col justify-center rounded-card border border-border p-4 ns-transition hover:border-brand-500" href="#" style="display:none">
                <span class="text-xs text-muted"><i class="ph ph-arrow-left" aria-hidden="true"></i> {{t "Previous"}}</span>
                <span class="js-train-label mt-1 font-bold leading-snug"></span>
              </a>
              <a class="js-train-next flex h-full flex-col justify-center rounded-card border border-border p-4 text-right ns-transition hover:border-brand-500 sm:col-start-2" href="#" style="display:none">
                <span class="text-xs text-muted">{{t "Next"}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                <span class="js-train-label mt-1 font-bold leading-snug"></span>
              </a>
              <a class="js-train-finish flex h-full flex-col justify-center rounded-card border border-success/40 p-4 text-right ns-transition hover:border-success sm:col-start-2" href="/training/" style="display:none">
                <span class="text-xs font-semibold text-success"><i class="ph-fill ph-check-circle" aria-hidden="true"></i> {{t "Training complete"}}</span>
                <span class="mt-1 font-bold leading-snug text-success">{{t "Back to all sections"}}</span>
              </a>
            </div>

            {{!-- ── Comments, after the lesson ──────────────────────────────
                 Ghost renders nothing here unless commenting is enabled in
                 Admin → Settings → Access, so this is safe to always emit.
                 title="" because the heading below already labels the block. --}}
            <section class="mt-12 border-t border-border pt-8">
              <h2 class="mb-5 flex items-center gap-2 font-heading text-lg font-extrabold text-ink">
                <i class="ph-fill ph-chats-circle text-brand-500" aria-hidden="true"></i>{{t "Questions & discussion"}}
              </h2>
              {{comments title=""}}
            </section>
          </article>

          {{!-- Right rail: TOC → ad → ad, sequential sticky handoff (each widget
               pins inside its own flex-1 segment, then cycles to the next) --}}
          <aside class="hidden xl:block xl:border-l xl:border-border xl:pl-8">
            <div class="flex h-full flex-col gap-10">
              <div class="flex-1"><div class="sticky top-20">{{> "components/toc"}}</div></div>
              <div class="flex-1"><div class="sticky top-20">{{> "ads/slot" format="rail"}}</div></div>
              <div class="flex-1"><div class="sticky top-20 pb-10">{{> "ads/slot" format="square"}}</div></div>
            </div>
          </aside>
        </div>
      {{/has}}
    </div>
  </div>
</section>
