{{!-- Training module cards, discovered from content.

A module IS a public tag: the primary tag its posts carry. This
walks the public tags and keeps only those with training posts —
so a module appears the moment its first post is published and
disappears with its last, and blog-only tags never show. The tag
supplies name, description, image and ordering; the posts supply
the contents list.

Cards are sequence-aware: the wrapping container counts them
(CSS counter → .module-num), and on /training the .training-path
layout threads a connector between consecutive cards so module N
visibly hands off to module N+1.

Param: moduleLimit — cards to render ("2" on home, "24" on
/training/). --}}

{{#get "tags" filter="visibility:public" order="slug asc" limit="30" as |moduleTags|}}
    {{#foreach moduleTags}}
        {{#> "with-this" moduleTag=. }}
            {{#get "posts" filter="tag:{{moduleTag.slug}}+tag:[hash-training-col,hash-docs-col]" order="published_at asc" limit="100" as |modulePosts|}}
                {{#if modulePosts}}
                    <article class="module-card" id="module-{{../moduleTag.slug}}">

                        <span class="module-num" aria-hidden="true"></span>

                        <header class="module-card-head">
                            {{#if ../moduleTag.feature_image}}
                                <span class="module-card-art" aria-hidden="true">
                                    <img src="{{img_url ../moduleTag.feature_image size="s"}}" alt="" loading="lazy" />
                                </span>
                            {{else}}
                                <span class="module-card-art is-icon" aria-hidden="true">{{> "icons/layers"}}</span>
                            {{/if}}
                            <span class="kicker">{{> "icons/layers"}} {{t "Module"}} <span class="module-count-chip">{{modulePosts.length}} {{t "sections"}}</span></span>
                            <h2><a href="{{modulePosts.[0].url}}">{{../moduleTag.name}}</a></h2>
                            {{#if ../moduleTag.description}}
                                <p class="module-card-desc">{{../moduleTag.description}}</p>
                            {{/if}}
                        </header>

                        <ol class="module-list">
                            {{#foreach modulePosts}}
                                <li>
                                    <a href="{{url}}">
                                        <span>{{title}}</span>
                                        {{> "icons/arrow-right"}}
                                    </a>
                                </li>
                            {{/foreach}}
                        </ol>

                        <footer class="module-card-foot">
                            <a class="btn btn-sm" href="{{modulePosts.[0].url}}">{{> "icons/play-circle"}} {{t "Start module"}}</a>
                            <span class="module-foot-note">{{t "work straight through, in order"}}</span>
                        </footer>

                    </article>
                {{/if}}
            {{/get}}
        {{/with-this}}
    {{/foreach}}
{{/get}}
