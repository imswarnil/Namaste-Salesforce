{{!-- Site-level structured data. One @graph: the WebSite, the
Organization behind it, and the primary navigation spelled out
as SiteNavigationElement items — built dynamically from Ghost's
navigation settings, so it never drifts from the real navbar.
Page-level types (Course, BreadcrumbList) are emitted by the
templates that own those pages. --}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": "{{@site.url}}/#website",
            "url": "{{@site.url}}/",
            "name": "{{@site.title}}",
            "description": "{{@site.description}}",
            "publisher": { "@id": "{{@site.url}}/#organization" }
        },
        {
            "@type": "Organization",
            "@id": "{{@site.url}}/#organization",
            "name": "{{@site.title}}",
            "url": "{{@site.url}}/"{{#if @site.logo}},
            "logo": {
                "@type": "ImageObject",
                "url": "{{@site.logo}}"
            }{{/if}}
        },
        {
            "@type": "ItemList",
            "@id": "{{@site.url}}/#navigation",
            "name": "Primary navigation",
            "itemListElement": [
                {{#foreach @site.navigation}}
                {
                    "@type": "SiteNavigationElement",
                    "position": {{@number}},
                    "name": "{{label}}",
                    "url": "{{#match this.url "~^" "http"}}{{this.url}}{{else}}{{@site.url}}{{this.url}}{{/match}}"
                }{{#unless @last}},{{/unless}}
                {{/foreach}}
            ]
        }
        {{!-- Page-level nodes join the same graph. The collection
        tag picks the type; lessons and module sections are listed
        WITH positions, so the numbering is machine-readable. --}}
        {{#post}}
        {{#match (post_class) "~" "tag-hash-course"}},
        {
            "@type": "Course",
            "@id": "{{url absolute="true"}}#course",
            "name": "{{title}}",
            "description": "{{custom_excerpt}}",
            "url": "{{url absolute="true"}}",
            "provider": { "@id": "{{@site.url}}/#organization" },
            "isAccessibleForFree": true,
            "hasPart": [
                {{#get "posts" filter="tag:{{slug}}+tag:hash-lesson" order="published_at asc" limit="50" as |lessons|}}
                {{#foreach lessons}}
                {
                    "@type": "LearningResource",
                    "position": {{@number}},
                    "name": "{{title}}",
                    "url": "{{url absolute="true"}}"
                }{{#unless @last}},{{/unless}}
                {{/foreach}}
                {{/get}}
            ]
        }
        {{else match (post_class) "~" "tag-hash-training"}}{{#primary_tag}},
        {
            "@type": "Course",
            "@id": "{{@site.url}}/training/{{slug}}/#module",
            "name": "{{name}}",
            "description": "{{description}}",
            "url": "{{@site.url}}/training/{{slug}}/",
            "provider": { "@id": "{{@site.url}}/#organization" },
            "isAccessibleForFree": true,
            "hasPart": [
                {{#get "posts" filter="tag:{{slug}}+tag:hash-training" order="published_at asc" limit="50" as |sections|}}
                {{#foreach sections}}
                {
                    "@type": "LearningResource",
                    "position": {{@number}},
                    "name": "{{title}}",
                    "url": "{{url absolute="true"}}"
                }{{#unless @last}},{{/unless}}
                {{/foreach}}
                {{/get}}
            ]
        }
        {{/primary_tag}}
        {{else match (post_class) "~" "tag-hash-video"}},
        {
            "@type": "VideoObject",
            "@id": "{{url absolute="true"}}#video",
            "name": "{{title}}",
            "description": "{{custom_excerpt}}",
            "url": "{{url absolute="true"}}",
            {{#if feature_image}}"thumbnailUrl": "{{img_url feature_image size="l" absolute="true"}}",{{/if}}
            "uploadDate": "{{date published_at format="YYYY-MM-DD"}}"
        }
        {{else match (post_class) "~" "tag-hash-blog"}},
        {
            "@type": "BreadcrumbList",
            "@id": "{{url absolute="true"}}#crumbs",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{@site.url}}/" },
                { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{@site.url}}/blog/" },
                { "@type": "ListItem", "position": 3, "name": "{{title}}", "item": "{{url absolute="true"}}" }
            ]
        }
        {{/match}}
        {{/post}}
    ]
}
</script>
