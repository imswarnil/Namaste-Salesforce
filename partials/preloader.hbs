<div id="ns-preloader" role="status" aria-label="Loading Namaste Salesforce">
  <div class="ns-pre__stage" id="ns-stage">
    
    <div class="ns-pre__logo-wrap">
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="" class="ns-pre__logo">
      {{else if @site.icon}}
        <img src="{{@site.icon}}" alt="" class="ns-pre__icon">
      {{else}}
        <div class="ns-pre__monogram">NS</div>
      {{/if}}
    </div>

    <h1 class="ns-pre__brand">
      <span class="ns-pre__word" id="ns-word">Namaste</span>
      <span class="ns-pre__suffix">
        Salesf<span class="ns-pre__o" id="ns-portal">o</span>rce
      </span>
    </h1>

  </div>
</div>

<style>
  :root {
    --ns-blue: #0176d3;
    /* Automatically uses Ghost site background/text colors */
    --ns-bg: #ffffff; 
    --ns-text: #181818;
  }
  @media (prefers-color-scheme: dark) {
    :root { --ns-bg: #0b0e14; --ns-text: #f3f4f6; }
  }

  #ns-preloader {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: var(--ns-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* This ensures we use your site's primary font family */
    font-family: var(--font-family, inherit);
  }

  .ns-pre__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    will-change: transform, opacity;
    /* The origin will be updated via JS to hit the 'o' exactly */
    transform-origin: center center;
  }

  .ns-pre__brand {
    font-size: clamp(2.2rem, 8vw, 3.8rem);
    font-weight: 900;
    margin: 0;
    display: flex;
    align-items: baseline;
    letter-spacing: -0.03em;
    color: var(--ns-text);
    white-space: nowrap;
  }

  .ns-pre__word {
    color: var(--ns-blue);
    min-width: 5ch;
    text-align: right;
    display: inline-block;
    transition: transform 0.1s ease-out, filter 0.1s ease-out;
    filter: blur(var(--ns-blur, 0px));
    transform: translateY(var(--ns-y, 0px));
  }

  .ns-pre__suffix { margin-left: 0.25em; }

  .ns-pre__o {
    display: inline-block;
    color: var(--ns-blue);
    position: relative;
  }

  /* The Cinematic Zoom Out */
  .ns-pre--zoom-active {
    transition: transform 1.1s cubic-bezier(0.7, 0, 0.3, 1), 
                opacity 0.8s ease-in;
    transform: scale(100); /* Extreme scale to go "through" the letter */
    opacity: 0;
  }

  .ns-pre__logo-wrap { transition: opacity 0.4s ease; }
  .ns-pre--zoom-active .ns-pre__logo-wrap { opacity: 0; }

  /* Final Removal */
  .ns-pre--hidden {
    display: none !important;
  }
</style>

<script>
(function() {
  const overlay = document.getElementById('ns-preloader');
  const stage = document.getElementById('ns-stage');
  const wordEl = document.getElementById('ns-word');
  const portalO = document.getElementById('ns-portal');
  
  const WORDS = ['Namaste', 'Hola', 'Ciao', 'Hello', 'Bonjour', 'Hallo', 'こんにちは', '你好', 'Merhaba', 'Olá', 'Namaste'];
  
  const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

  function playZoop(isFinal = false) {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    
    osc.type = 'sine';
    osc.frequency.setValueAtTime(isFinal ? 150 : 450, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(isFinal ? 900 : 1200, audioCtx.currentTime + 0.08);
    
    gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
    
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.08);
  }

  function playTudum() {
    [0, 0.1].forEach(t => {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(55, audioCtx.currentTime + t);
      gain.gain.setValueAtTime(0.25, audioCtx.currentTime + t);
      gain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + t + 0.5);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(audioCtx.currentTime + t);
      osc.stop(audioCtx.currentTime + t + 0.6);
    });
  }

  let idx = 0;
  function cycle() {
    if (idx >= WORDS.length - 1) {
      setTimeout(startNetflixZoom, 600);
      return;
    }

    // Motion Blur "Zoop"
    wordEl.style.setProperty('--ns-blur', '15px');
    wordEl.style.setProperty('--ns-y', '-25px');
    
    setTimeout(() => {
      idx++;
      wordEl.textContent = WORDS[idx];
      playZoop(idx === WORDS.length - 1);
      
      wordEl.style.setProperty('--ns-blur', '0px');
      wordEl.style.setProperty('--ns-y', '0px');
      
      setTimeout(cycle, idx === WORDS.length - 1 ? 400 : 110);
    }, 50);
  }

  function startNetflixZoom() {
    // 1. Calculate the 'o' position relative to the stage
    const rectO = portalO.getBoundingClientRect();
    const rectStage = stage.getBoundingClientRect();
    
    // 2. Set the transform origin to the center of the 'o'
    const originX = rectO.left + (rectO.width / 2) - rectStage.left;
    const originY = rectO.top + (rectO.height / 2) - rectStage.top;
    
    stage.style.transformOrigin = `${originX}px ${originY}px`;
    
    // 3. Fire the effects
    playTudum();
    stage.classList.add('ns-pre--zoom-active');
    
    setTimeout(() => {
      overlay.style.opacity = '0';
      setTimeout(() => overlay.classList.add('ns-pre--hidden'), 500);
    }, 1000);
  }

  // Trigger
  if (!sessionStorage.getItem('ns_pre_v2')) {
    window.addEventListener('load', () => setTimeout(cycle, 300));
    sessionStorage.setItem('ns_pre_v2', '1');
  } else {
    overlay.remove();
  }
})();
</script>