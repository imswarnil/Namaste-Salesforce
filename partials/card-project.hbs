{{!-- A repo card, GitHub grammar: book icon + mono name +
"Public" badge, the description, then the meta row — language
dot (colour keyed off the #project-lang-* slug, label from its
description), star count (#project-stars-* description), topic.
An optional cover image sits above the head row (most repos carry
none — GitHub cards don't either — but a project with a real
screenshot gets to show it). #audience-admin/-dev/-consultant is
the same facet card-resource.hbs uses, so it filters identically
here. Context: a post tagged #project. --}}

<article class="proj-card" data-filter-item
    {{~#foreach tags visibility="internal"~}}
        {{~#match slug "~^" "hash-audience-"}} data-audience="{{slug}}" data-audience-label="{{description}}"{{/match~}}
    {{~/foreach~}}>
    <a class="proj-card-link" href="{{url}}">
        {{#if feature_image}}
            <div class="proj-card-media">
                <img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" />
            </div>
        {{/if}}
        <header class="proj-head">
            {{> "icons/book-open"}}
            <h3 class="proj-name">{{title}}</h3>
            <span class="proj-badge">{{t "Public"}}</span>
        </header>

        {{#if custom_excerpt}}
            <p class="proj-desc">{{custom_excerpt}}</p>
        {{/if}}

        <footer class="proj-meta">
            {{#foreach tags visibility="internal"}}
                {{#match slug "~^" "hash-project-lang-"}}
                    {{#if description}}
                        <span class="proj-lang"><i class="proj-lang-dot {{slug}}"></i>{{description}}</span>
                    {{/if}}
                {{/match}}
                {{#match slug "~^" "hash-project-stars-"}}
                    {{#if description}}
                        <span class="proj-stars">{{> "icons/star"}} {{description}}</span>
                    {{/if}}
                {{/match}}
            {{/foreach}}
            {{#primary_tag}}
                <span class="proj-topic">{{name}}</span>
            {{/primary_tag}}
        </footer>
    </a>
</article>
