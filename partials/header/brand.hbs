{{!-- partials/header/brand.hbs
     Shared brand block for all white navbars. --}}
<a class="ns-brand navbar-item" href="{{@site.url}}">
  {{#if @site.logo}}
    <img class="ns-brand__logo" src="{{@site.logo}}" alt="{{@site.title}}">
  {{else}}
    <span class="icon has-text-primary"><i class="ph-bold ph-cloud" aria-hidden="true"></i></span>
  {{/if}}
  <div class="ns-brand__text">
    <span class="ns-brand__title">{{@site.title}}</span>
  </div>
</a>
