{{!-- partials/header/portal-buttons.hbs
     Shared member authentication buttons. Shows account chip when signed in,
     Log in + Sign Up pair otherwise. Used by blog, videos, docs, default. --}}
{{#if @member}}
  <a class="button is-light is-rounded is-small" href="#/portal/account" data-portal="account">
    <span class="icon is-small"><i class="ph ph-user-circle" aria-hidden="true"></i></span>
    <span>{{@member.name}}</span>
  </a>
{{else}}
  <a class="button is-light is-rounded is-small" href="#/portal/signin" data-portal="signin">Log in</a>
  <a class="button is-primary is-rounded is-small has-text-weight-bold" href="#/portal/signup" data-portal="signup">Sign Up</a>
{{/if}}
