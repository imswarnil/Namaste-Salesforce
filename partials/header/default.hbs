{{!-- =========================================================================
  partials/header/default.hbs
  Standard full-site navbar. Used on all pages except #lesson and #blog posts.
  
  Context-aware CTA (end of actions):
    • Default pages   → Sign in / Login  OR  Account dropdown
    • #course posts   → "Become Instructor" button
    → Blog/lesson handled in their own partials
========================================================================== --}}

<header
  class="default-header site-header{{#if @custom.sticky_header}} is-sticky{{/if}}"
  role="banner"
  id="siteHeader"
>
  <nav class="navbar default-header__navbar" role="navigation" aria-label="Main navigation">
    <div class="container default-header__wrap">

      {{!-- ── Brand + Learn path dropdown ──────────────────────────────── --}}
      <div class="navbar-brand default-header__brand-group">

        <a class="navbar-item default-header__brand"
           href="{{@site.url}}"
           aria-label="{{@site.title}} — go to homepage">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}"
                 class="default-header__logo" width="32" height="32">
          {{/if}}
          <span class="default-header__title">{{@site.title}}</span>
        </a>

        {{!-- Separator --}}
        <span class="default-header__brand-sep is-hidden-touch" aria-hidden="true"></span>

        {{!-- "Learn" quick-access dropdown — desktop only --}}
        <div class="default-header__learn-wrap is-hidden-touch" id="learnDropdownWrap">
          <button class="default-header__learn-btn" type="button"
                  aria-haspopup="true" aria-expanded="false"
                  id="learnDropdownBtn">
            <i class="ph ph-graduation-cap" aria-hidden="true"></i>
            <span>Learn</span>
            <i class="ph ph-caret-down default-header__learn-caret" aria-hidden="true"></i>
          </button>

          <div class="default-header__learn-panel" id="learnDropdown" hidden>
            <p class="default-header__learn-heading">Learning Paths</p>
            <div class="default-header__learn-grid">
              <a class="default-header__learn-item" href="/training/">
                <span class="default-header__learn-icon">
                  <i class="ph ph-user-gear" aria-hidden="true"></i>
                </span>
                <span class="default-header__learn-label">
                  <strong>Admin</strong>
                  <small>Manage orgs &amp; users</small>
                </span>
              </a>
              <a class="default-header__learn-item" href="/courses/">
                <span class="default-header__learn-icon">
                  <i class="ph ph-code" aria-hidden="true"></i>
                </span>
                <span class="default-header__learn-label">
                  <strong>Developer</strong>
                  <small>Apex, LWC &amp; APIs</small>
                </span>
              </a>
              <a class="default-header__learn-item" href="/courses/">
                <span class="default-header__learn-icon">
                  <i class="ph ph-paint-brush" aria-hidden="true"></i>
                </span>
                <span class="default-header__learn-label">
                  <strong>Designer</strong>
                  <small>UX &amp; Lightning Design</small>
                </span>
              </a>
              <a class="default-header__learn-item" href="/courses/">
                <span class="default-header__learn-icon">
                  <i class="ph ph-chart-line" aria-hidden="true"></i>
                </span>
                <span class="default-header__learn-label">
                  <strong>Analyst</strong>
                  <small>Reports &amp; Dashboards</small>
                </span>
              </a>
              <a class="default-header__learn-item" href="/courses/">
                <span class="default-header__learn-icon">
                  <i class="ph ph-trophy" aria-hidden="true"></i>
                </span>
                <span class="default-header__learn-label">
                  <strong>Exam Prep</strong>
                  <small>Cert study guides</small>
                </span>
              </a>
              <a class="default-header__learn-item" href="/videos/">
                <span class="default-header__learn-icon">
                  <i class="ph ph-play-circle" aria-hidden="true"></i>
                </span>
                <span class="default-header__learn-label">
                  <strong>Videos</strong>
                  <small>Watch &amp; learn</small>
                </span>
              </a>
            </div>
            <div class="default-header__learn-footer">
              <a href="/courses/" class="default-header__learn-all">
                Browse all courses
                <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>

        {{!-- Mobile tools --}}
        <div class="default-header__mobile-tools is-hidden-desktop"
             role="group" aria-label="Quick actions">
          <button class="default-header__icon-btn" type="button"
                  aria-label="Search" data-ghost-search>
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </button>
          <button class="default-header__icon-btn" type="button"
                  aria-label="Switch to dark mode" data-theme-toggle>
            <i class="ph ph-moon" aria-hidden="true"></i>
          </button>
          <button class="default-header__burger" type="button"
                  aria-label="Toggle menu" aria-expanded="false"
                  aria-controls="defaultNavMenu" id="defaultNavBurger">
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
          </button>
        </div>

      </div>
      {{!-- /brand --}}

      {{!-- ── Nav menu ────────────────────────────────────────────────── --}}
      <div id="defaultNavMenu" class="navbar-menu default-header__menu"
           aria-label="Site navigation" aria-hidden="true">

        <div class="navbar-start default-header__nav" id="defaultNavLinks">
          {{navigation}}
        </div>

        {{!-- Actions end --}}
        <div class="navbar-end default-header__actions">

          {{!-- Search (desktop) --}}
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button"
                    aria-label="Search" data-ghost-search>
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            </button>
          </div>

          {{!-- Dark mode (desktop) --}}
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button"
                    aria-label="Switch to dark mode" data-theme-toggle>
              <i class="ph ph-moon" aria-hidden="true"></i>
            </button>
          </div>

          {{!-- ── Context-aware CTA ──────────────────────────────────── --}}
          {{#is "post"}}
            {{#post}}
              {{#has tag="#course"}}

                {{!-- On a course page: Become Instructor CTA --}}
                <div class="navbar-item">
                  <a class="default-header__cta default-header__cta--instructor"
                     href="/contact/?ref=instructor">
                    <i class="ph ph-chalkboard-teacher" aria-hidden="true"></i>
                    <span>Become Instructor</span>
                  </a>
                </div>

              {{else}}

                {{!-- Default auth --}}
                {{> "header/auth"}}

              {{/has}}
            {{/post}}
          {{else}}

            {{!-- Default auth --}}
            {{> "header/auth"}}

          {{/is}}

          {{!-- GitHub Star — always last --}}
          <div class="navbar-item">
            <a class="default-header__github-btn"
               href="https://github.com/imswarnil/Namaste-Salesforce"
               target="_blank" rel="noopener noreferrer"
               aria-label="Star on GitHub">
              <i class="ph ph-github-logo" aria-hidden="true"></i>
              <span>Star</span>
              <i class="ph ph-star default-header__github-star" aria-hidden="true"></i>
            </a>
          </div>

        </div>
        {{!-- /actions --}}

      </div>
      {{!-- /menu --}}

    </div>
  </nav>
</header>

<script>
(function () {
  'use strict';

  var SK  = 'site-color-scheme';
  var doc = document.documentElement;

  // ── Theme ─────────────────────────────────────────────────────────────────
  function getTheme() { return doc.getAttribute('data-color-scheme') === 'dark' ? 'dark' : 'light'; }
  function applyTheme(t) {
    doc.setAttribute('data-color-scheme', t);
    localStorage.setItem(SK, t);
    syncUI(t);
  }
  function syncUI(t) {
    var dark = t === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
      var ic = b.querySelector('i');
      if (ic) ic.className = dark ? 'ph ph-sun-dim' : 'ph ph-moon';
      b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    });
  }
  var sv = localStorage.getItem(SK);
  syncUI((sv === 'light' || sv === 'dark') ? sv : getTheme());
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-theme-toggle]')) applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

  // ── Mobile burger ──────────────────────────────────────────────────────────
  var burger = document.getElementById('defaultNavBurger');
  var menu   = document.getElementById('defaultNavMenu');
  var hdr    = document.getElementById('siteHeader');

  function toggleMenu(force) {
    var open = force !== undefined ? force : !burger.classList.contains('is-open');
    burger.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    if (hdr) hdr.classList.toggle('menu-is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  if (burger && menu) {
    burger.addEventListener('click', function () { toggleMenu(); });
    document.addEventListener('click', function (e) {
      if (menu.classList.contains('is-open') &&
          !menu.contains(e.target) && !burger.contains(e.target)) toggleMenu(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        toggleMenu(false); burger.focus();
      }
    });
  }

  // ── Nav dropdown builder ───────────────────────────────────────────────────
  // Items with data-child="true" become children of the preceding item.
  // Wraps are only kept when they have ≥1 child.
  document.addEventListener('DOMContentLoaded', function () {
    var nav = document.getElementById('defaultNavLinks');
    if (!nav) return;

    var items   = Array.from(nav.querySelectorAll('.default-header__nav-item'));
    var current = null; // { wrap, trigger, list }

    items.forEach(function (el) {
      if (el.getAttribute('data-child') === 'true' && current) {
        // Strip "- " from label display
        var lbl = el.querySelector('.default-header__nav-label');
        if (lbl) lbl.textContent = lbl.textContent.replace(/^[\-–]\s*/, '').trim();
        var li = document.createElement('li');
        li.appendChild(el);
        current.list.appendChild(li);
      } else {
        // Wrap this item
        var wrap = document.createElement('div');
        wrap.className = 'default-header__dropdown-wrap';
        el.parentNode.insertBefore(wrap, el);
        wrap.appendChild(el);
        var list = document.createElement('ul');
        list.className = 'default-header__dropdown-menu';
        list.setAttribute('role', 'menu');
        wrap.appendChild(list);
        current = { wrap: wrap, trigger: el, list: list };
      }
    });

    // Finalise: remove wraps with no children, add chevrons to those that have
    nav.querySelectorAll('.default-header__dropdown-wrap').forEach(function (wrap) {
      var list = wrap.querySelector('.default-header__dropdown-menu');
      var item = wrap.querySelector('.default-header__nav-item');

      if (!list || !list.children.length) {
        // Unwrap — no children
        if (item) { wrap.parentNode.insertBefore(item, wrap); }
        wrap.remove();
        return;
      }

      wrap.classList.add('has-dropdown');
      if (item) {
        item.classList.add('has-dropdown-trigger');
        item.setAttribute('aria-haspopup', 'true');
        item.setAttribute('aria-expanded', 'false');
        var chev = document.createElement('i');
        chev.className = 'ph ph-caret-down default-header__dropdown-chevron';
        chev.setAttribute('aria-hidden', 'true');
        item.appendChild(chev);
      }
    });

    // Mobile: tap to open
    nav.addEventListener('click', function (e) {
      var trigger = e.target.closest('.has-dropdown-trigger');
      if (!trigger || window.innerWidth >= 1024) return;
      e.preventDefault();
      var wrap   = trigger.closest('.has-dropdown');
      var isOpen = wrap.classList.contains('is-open');
      nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) {
        d.classList.remove('is-open');
        var t = d.querySelector('.has-dropdown-trigger');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) { wrap.classList.add('is-open'); trigger.setAttribute('aria-expanded', 'true'); }
    });

    document.addEventListener('click', function (e) {
      if (!nav.contains(e.target)) {
        nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) { d.classList.remove('is-open'); });
      }
    });
  });

  // ── Learn dropdown ─────────────────────────────────────────────────────────
  function makeDropdown(btnId, panelId, wrapId) {
    var btn  = document.getElementById(btnId);
    var panel = document.getElementById(panelId);
    var wrap  = document.getElementById(wrapId);
    if (!btn || !panel) return;

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('is-open', open);
    });
    document.addEventListener('click', function (e) {
      if (wrap && !wrap.contains(e.target)) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
        btn.focus();
      }
    });
  }

  makeDropdown('learnDropdownBtn', 'learnDropdown', 'learnDropdownWrap');

  // ── Account dropdown ────────────────────────────────────────────────────────
  // Populate initials if no avatar
  var initialsEl = document.getElementById('memberInitials');
  if (initialsEl) {
    var nameEl = document.querySelector('.default-header__account-name');
    if (nameEl) {
      initialsEl.textContent = nameEl.textContent.trim()
        .split(/\s+/).map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase();
    }
  }

  makeDropdown('accountBtn', 'accountDropdown', 'accountWrap');

})();
</script>
