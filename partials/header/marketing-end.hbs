{{!-- partials/header/marketing-end.hbs
     Shared navbar-end for marketing-style pages:
     blog, videos, default post, non-post pages.
     Contains: search (desktop), theme toggle, GitHub star, portal buttons. --}}
<div class="navbar-end">
  <a class="navbar-item is-hidden-touch" href="#search" data-ghost-search aria-label="Search">
    <span class="icon"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></span>
  </a>
  <div class="navbar-item">
    <div class="buttons">
      {{> "header/theme-toggle"}}
      {{> "header/github-button"}}
      {{> "header/portal-buttons"}}
    </div>
  </div>
</div>
