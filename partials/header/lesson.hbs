{{!--
    header/lesson.hbs — Namaste Salesforce
    ============================================================
    Compact header for #lesson posts.

    WHY NO {{#get}} HERE:
      The header partial runs before the post body renders.
      {{#get}} with primary_tag.slug would fail because the
      header context (pre-body) doesn't reliably resolve it.

    HOW LESSONS ARE LOADED:
      post-lesson.hbs embeds a hidden <div id="gh-lesson-data">
      containing all lessons as <a> elements. This is available
      in the DOM by DOMContentLoaded. The inline script below
      reads it and builds the sidebar — no API call, no key needed.

    LAYOUT:
      LEFT:   [Logo] [|] [Course Name] [≡ Lessons toggle]
      CENTER: [━━━ Progress bar only (no text) ━━━]
      RIGHT:  [⭐ Star] [🌙/☀ Dark] [🔍 Search] [✕ Back]

    DATA ATTRIBUTES on <header>:
      data-lesson-id    — current post id (for active detection)
      data-course-slug  — primary_tag.slug (course)
    ============================================================
--}}

<header
    id="gh-head"
    class="gh-head gh-head-lesson outer"
    data-lesson-id="{{id}}"
    data-course-slug="{{primary_tag.slug}}"
>
    <div class="gh-head-inner inner">

        {{!-- ── LEFT: Logo + Course name + Lessons toggle ─── --}}
        <div class="gh-lesson-left">

            {{!-- Site logo --}}
            <a
                class="gh-lesson-logo{{#unless @site.logo}} no-image{{/unless}}"
                href="{{@site.url}}"
                aria-label="{{@site.title}} — home"
            >
                {{#if @site.logo}}
                    <img class="gh-lesson-logo-img" src="{{@site.logo}}" alt="{{@site.title}}" loading="eager" />
                {{else}}
                    <span class="gh-lesson-logo-text">{{@site.title}}</span>
                {{/if}}
            </a>

            {{!-- Divider --}}
            <div class="gh-lesson-divider" aria-hidden="true"></div>

            {{!-- Course name links back to course --}}
            {{#if primary_tag}}
                <a class="gh-lesson-course-name" href="/courses/{{primary_tag.slug}}/">
                    {{primary_tag.name}}
                </a>
            {{/if}}

            {{!-- Lessons list toggle (hamburger) --}}
            <button
                class="gh-lesson-toggle"
                aria-label="{{t "Open lesson list"}}"
                aria-expanded="false"
                aria-controls="gh-lesson-panel"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

        </div>

        {{!-- ── CENTER: Progress bar ONLY ─────────────────── --}}
        <div class="gh-lesson-center">
            <div
                class="gh-lesson-progress-bar"
                role="progressbar"
                aria-label="{{t "Lesson progress"}}"
                aria-valuenow="0"
                aria-valuemin="0"
                aria-valuemax="100"
            >
                <div class="gh-lesson-progress-fill" id="gh-lesson-fill"></div>
            </div>
        </div>

        {{!-- ── RIGHT: Star, Dark toggle, Search, Back ────── --}}
        <div class="gh-lesson-right">

            <a
                href="https://github.com/namastesalesforce"
                class="gh-star-btn gh-icon-btn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Star on GitHub"
                title="Star on GitHub"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
            </a>

            <button class="gh-dark-toggle gh-icon-btn" id="gh-dark-toggle" aria-label="{{t "Toggle dark mode"}}">
                <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </button>

            <button class="gh-search gh-icon-btn" aria-label="{{t "Search"}}" data-ghost-search>
                {{> "icons/search"}}
            </button>

            <a
                href="/courses/{{primary_tag.slug}}/"
                class="gh-lesson-back gh-icon-btn"
                aria-label="{{t "Back to course"}}"
                title="{{#if primary_tag}}{{primary_tag.name}}{{else}}{{t "Course"}}{{/if}}"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </a>

        </div>
    </div>

    {{!-- Full-width bottom progress strip --}}
    <div class="gh-lesson-progress-strip" aria-hidden="true">
        <div class="gh-lesson-progress-strip-fill" id="gh-lesson-strip-fill"></div>
    </div>
</header>


{{!-- ── Lesson panel sidebar ──────────────────────── --}}
<div
    id="gh-lesson-panel"
    class="gh-lesson-panel"
    role="dialog"
    aria-modal="false"
    aria-label="{{t "Course lessons"}}"
    aria-hidden="true"
>
    <div class="gh-lesson-panel-inner">
        <div class="gh-lesson-panel-header">
            <div class="gh-lesson-panel-course">
                {{#if primary_tag.feature_image}}
                    <img class="gh-lesson-panel-thumb" src="{{img_url primary_tag.feature_image size="xs"}}" alt="" aria-hidden="true" />
                {{/if}}
                <span class="gh-lesson-panel-course-name">{{primary_tag.name}}</span>
            </div>
            <button class="gh-lesson-panel-close gh-icon-btn" aria-label="{{t "Close"}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        {{!-- Progress summary inside panel --}}
        <div class="gh-lesson-panel-progress" id="gh-panel-progress">
            <div class="gh-lesson-panel-progress-bar">
                <div class="gh-lesson-panel-progress-fill" id="gh-panel-progress-fill"></div>
            </div>
            <span class="gh-lesson-panel-progress-label" id="gh-panel-progress-label">0 / 0</span>
        </div>

        <nav class="gh-lesson-panel-nav" aria-label="{{t "Lessons"}}">
            <ol class="gh-lesson-list" id="gh-lesson-list" role="list">
                {{!-- Populated by JS from #gh-lesson-data embedded by post-lesson.hbs --}}
                <li class="gh-lesson-loading">Loading…</li>
            </ol>
        </nav>

        <div class="gh-lesson-panel-footer">
            <a href="/courses/{{primary_tag.slug}}/" class="gh-lesson-panel-back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                {{t "Course overview"}}
            </a>
        </div>
    </div>
</div>
<div class="gh-lesson-backdrop" aria-hidden="true"></div>


{{!-- ================================================================
     LESSON HEADER SCRIPT
     Reads lesson data from #gh-lesson-data embedded by post-lesson.hbs
     — no API call, no key required.
     ================================================================ --}}
<script>
(function () {
    'use strict';

    document.addEventListener('DOMContentLoaded', function () {

        var header     = document.getElementById('gh-head');
        if (!header) return;

        var lessonId   = header.dataset.lessonId;
        var courseSlug = header.dataset.courseSlug;
        var storageKey = 'sfdc-complete-' + courseSlug;

        /* ── Read lesson data embedded by post-lesson.hbs ── */
        var dataEl   = document.getElementById('gh-lesson-data');
        var listEl   = document.getElementById('gh-lesson-list');
        var fillEl   = document.getElementById('gh-lesson-fill');
        var stripEl  = document.getElementById('gh-lesson-strip-fill');
        var panelBar = document.getElementById('gh-panel-progress-fill');
        var panelLbl = document.getElementById('gh-panel-progress-label');
        var progBar  = document.querySelector('.gh-lesson-progress-bar');

        function getCompleted() {
            try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch (e) { return []; }
        }

        /* ── Build sidebar from embedded anchor elements ── */
        if (dataEl && listEl) {
            var anchors   = Array.prototype.slice.call(dataEl.querySelectorAll('a[data-id]'));
            var total     = anchors.length;
            var completed = getCompleted();
            var currentIndex = 0;

            if (total === 0) {
                listEl.innerHTML = '<li class="gh-lesson-empty" style="padding:1.4rem 1.6rem;color:var(--sfdc-text-color-weak);font-size:1.3rem;">No lessons found.</li>';
            } else {
                var html = anchors.map(function (a, i) {
                    var id       = a.dataset.id;
                    var slug     = a.dataset.slug;
                    var url      = a.getAttribute('href');
                    var title    = a.textContent.trim();
                    var isCur    = id === lessonId;
                    var isDone   = completed.indexOf(slug) !== -1;
                    if (isCur) currentIndex = i + 1;

                    return '<li class="gh-lesson-item' +
                        (isCur  ? ' is-current'  : '') +
                        (isDone ? ' is-complete'  : '') +
                        '">' +
                        '<a class="gh-lesson-link" href="' + url + '"' +
                        (isCur ? ' aria-current="page"' : '') + '>' +
                        '<span class="gh-lesson-num">' + (i + 1) + '</span>' +
                        '<span class="gh-lesson-link-title">' + escHtml(title) + '</span>' +
                        '<span class="gh-lesson-check" aria-hidden="true">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' +
                        '</span></a></li>';
                }).join('');

                listEl.innerHTML = html;

                /* Scroll current into view */
                var cur = listEl.querySelector('.is-current');
                if (cur) { setTimeout(function () { cur.scrollIntoView({ block: 'nearest' }); }, 150); }
            }

            /* ── Update progress ── */
            if (!currentIndex) currentIndex = 1;
            var pct = total > 0 ? Math.round((currentIndex / total) * 100) : 0;

            if (fillEl)  fillEl.style.width = pct + '%';
            if (stripEl) stripEl.style.width = pct + '%';
            if (panelBar) panelBar.style.width = pct + '%';
            if (panelLbl) panelLbl.textContent = currentIndex + ' / ' + total;
            if (progBar)  progBar.setAttribute('aria-valuenow', pct);
        }

        /* ── Panel open / close ── */
        var toggleBtn = document.querySelector('.gh-lesson-toggle');
        var closeBtn  = document.querySelector('.gh-lesson-panel-close');
        var panel     = document.getElementById('gh-lesson-panel');
        var backdrop  = document.querySelector('.gh-lesson-backdrop');

        function openPanel() {
            document.body.classList.add('gh-lesson-open');
            if (panel)     panel.setAttribute('aria-hidden', 'false');
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        }
        function closePanel() {
            document.body.classList.remove('gh-lesson-open');
            if (panel)     panel.setAttribute('aria-hidden', 'true');
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        }

        if (toggleBtn) toggleBtn.addEventListener('click', function () {
            document.body.classList.contains('gh-lesson-open') ? closePanel() : openPanel();
        });
        if (closeBtn)  closeBtn.addEventListener('click', closePanel);
        if (backdrop)  backdrop.addEventListener('click', closePanel);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && document.body.classList.contains('gh-lesson-open')) {
                closePanel();
                if (toggleBtn) toggleBtn.focus();
            }
        });

        function escHtml(s) {
            return String(s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

    });
})();
</script>
