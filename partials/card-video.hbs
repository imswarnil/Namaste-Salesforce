{{!-- A video card: thumbnail, play badge, duration — nothing
else but the title. Context: a video post (include tags for the
duration chip). --}}
<article class="card video-card">
    <div class="card-media">
        {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
        {{else}}
            {{> "thumb-placeholder" icon="video"}}
        {{/if}}
        {{> "video-preview"}}
        <span class="video-card-play">{{> "icons/play-circle"}}</span>
        {{> "duration-chip" chipClass="video-card-duration"}}
    </div>
    <div class="card-body">
        <h3 class="card-title"><a class="card-link" href="{{url}}">{{title}}</a></h3>
    </div>
</article>
