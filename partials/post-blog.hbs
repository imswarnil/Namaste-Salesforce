{{!-- partials/post-blog.hbs — blog article layout --}}
<main class="ns-section pb-6">
  <div class="ns-container">
    <div class="columns is-variable is-8">

      {{!-- ==========================================
            LEFT COLUMN: MAIN CONTENT
      ========================================== --}}
      <div class="column is-8-desktop">

        {{!-- Meta & Title block --}}
        <div class="is-flex is-align-items-center is-flex-wrap-wrap mb-4" style="gap: 0.5rem;">
          {{#if primary_tag}}
            <a href="{{primary_tag.url}}" class="tag ns-badge ns-badge--gradient is-medium is-rounded has-text-weight-bold">
              {{primary_tag.name}}
            </a>
          {{/if}}
          <span class="is-flex is-align-items-center is-size-7" style="opacity: 0.6; gap: 0.25rem;">
            <i class="ph ph-calendar-blank"></i>
            <span>{{date format="MMMM DD, YYYY"}}</span>
          </span>
          <span class="is-flex is-align-items-center is-size-7" style="opacity: 0.6; gap: 0.25rem;">
            <i class="ph ph-clock"></i>
            <span>{{reading_time}}</span>
          </span>
        </div>

        <h1 class="title is-1 is-size-2-mobile has-text-weight-bold mb-4 ns-fade-up" style="line-height: 1.15; letter-spacing: -1px;">
          {{title}}
        </h1>

        {{#if custom_excerpt}}
          <p class="ns-lead mt-2 mb-5 ns-fade-up ns-stagger-1">
            {{custom_excerpt}}
          </p>
        {{/if}}

        {{!-- Feature Image --}}
        {{#if feature_image}}
          <figure class="image is-16by9 mb-6 ns-scale-in" style="border-radius: 16px; overflow: hidden;">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="object-fit: cover; width: 100%; height: 100%;">
          </figure>
          {{#if feature_image_caption}}
            <p class="is-size-7 has-text-centered mb-6" style="opacity: 0.55;">{{feature_image_caption}}</p>
          {{/if}}
        {{/if}}

        {{!-- MOBILE TOC --}}
        <div class="ns-glass-card is-hidden-desktop mb-6" style="border-radius: 12px;">
          <div class="is-flex is-justify-content-space-between is-align-items-center is-clickable p-4" id="mobile-toc-toggle">
            <h3 class="title is-6 mb-0 is-flex is-align-items-center" style="gap: 0.5rem;">
              <span class="icon has-text-primary"><i class="ph-fill ph-list-dashes"></i></span>
              <span class="has-text-weight-bold">{{t "Table of Contents"}}</span>
            </h3>
            <span class="icon" style="opacity: 0.5;"><i class="ph ph-caret-down" id="mobile-toc-icon"></i></span>
          </div>
          <div id="mobile-toc-menu" class="menu px-4 pb-4 is-hidden">
            <ul class="menu-list js-toc-list has-text-weight-medium"></ul>
          </div>
        </div>

        {{!-- Post Content --}}
        <div class="content is-medium gh-content js-post-content mb-6">
          {{content}}
        </div>

        {{!-- Social Share --}}
        <div class="is-flex is-align-items-center py-5" style="border-top: 1px solid; border-color: rgba(128,128,128,0.15); gap: 0.75rem; flex-wrap: wrap;">
          <p class="has-text-weight-bold is-size-6 mr-2">Share:</p>
          <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute='true'}}" target="_blank" rel="noopener" class="button is-light is-rounded is-small">
            <span class="icon"><i class="ph-fill ph-twitter-logo"></i></span>
          </a>
          <a href="https://www.linkedin.com/shareArticle?mini=true&url={{url absolute='true'}}&title={{encode title}}" target="_blank" rel="noopener" class="button is-light is-rounded is-small">
            <span class="icon"><i class="ph-fill ph-linkedin-logo"></i></span>
          </a>
        </div>

        {{!-- Tags list --}}
        {{#if tags}}
          <div class="tags mt-4" style="gap: 0.5rem; flex-wrap: wrap;">
            {{#foreach tags visibility="public"}}
              <a href="{{url}}" class="tag ns-badge is-rounded is-small">{{name}}</a>
            {{/foreach}}
          </div>
        {{/if}}

        {{!-- Related Posts --}}
        {{> related-posts}}

      </div>

      {{!-- ==========================================
            RIGHT COLUMN: STICKY SIDEBAR & TOC
      ========================================== --}}
      <div class="column is-4-desktop is-hidden-touch">

        {{!-- Newsletter Widget --}}
        <div class="ns-glass-card p-5 mb-6" style="border-radius: 16px;">
          <h3 class="title is-5 mb-2">{{t "Join the Community"}}</h3>
          <p class="is-size-6 mb-4" style="opacity: 0.75;">{{t "Get weekly tips and exclusive tutorials."}}</p>
          <form data-members-form="subscribe">
            <div class="field">
              <div class="control is-expanded mb-3">
                <input data-members-email class="input is-medium is-rounded" type="email" placeholder="Email address" required>
              </div>
              <div class="control">
                <button class="button is-gradient ns-gradient-animated is-medium is-rounded is-fullwidth has-text-weight-bold" type="submit">
                  {{t "Subscribe"}}
                </button>
              </div>
            </div>
          </form>
        </div>

        {{!-- STICKY TOC --}}
        <aside style="position: sticky; top: 2rem; max-height: calc(100vh - 4rem); overflow-y: auto; padding-right: 4px;">
          {{>"toc"}}
        </aside>

      </div>

    </div>
  </div>
</main>
