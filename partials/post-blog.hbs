{{!< default}}

<main class="section pt-5 pb-6 has-background-white">
  <div class="container is-max-widescreen">
    <div class="columns is-variable is-8">
      
      {{!-- ==========================================
            LEFT COLUMN: MAIN CONTENT
      ========================================== --}}
      <div class="column is-8-desktop">

        {{!-- Top Ad Space --}}
        <div class="box has-background-white-ter is-shadowless is-flex is-align-items-center is-justify-content-center mb-6" style="border: 1px dashed #ccc; min-height: 90px; width: 100%;">
          <span class="has-text-grey is-size-7"><i class="ph ph-ad mr-1"></i> Leaderboard Ad (728x90)</span>
        </div>

        {{!-- Meta & Titles --}}
        <div class="is-flex is-align-items-center is-flex-wrap-wrap mb-4">
          {{#if primary_tag}}
            <a href="{{primary_tag.url}}" class="tag is-link is-light is-medium is-rounded has-text-weight-bold mr-4 mb-2">
              {{primary_tag.name}}
            </a>
          {{/if}}
          <div class="is-flex is-align-items-center has-text-grey is-size-7 mr-4 mb-2">
            <span class="icon is-small mr-1"><i class="ph ph-calendar-blank"></i></span>
            <span>{{date format="MMMM DD, YYYY"}}</span>
          </div>
          <div class="is-flex is-align-items-center has-text-grey is-size-7 mb-2">
            <span class="icon is-small mr-1"><i class="ph ph-clock"></i></span>
            <span>{{reading_time}}</span>
          </div>
        </div>

        <h1 class="title is-1 is-size-2-mobile has-text-weight-bold has-text-dark mb-4" style="line-height: 1.2; letter-spacing: -1px;">
          {{title}}
        </h1>

        {{#if custom_excerpt}}
          <p class="subtitle is-4 is-size-5-mobile has-text-grey mt-2 mb-5" style="line-height: 1.5;">
            {{custom_excerpt}}
          </p>
        {{/if}}

        {{!-- Feature Image --}}
        {{#if feature_image}}
          <figure class="image is-16by9 mb-4" style="border-radius: 12px; overflow: hidden; border: 1px solid #ededed;">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="object-fit: cover;">
          </figure>
          {{#if feature_image_caption}}
            <p class="is-size-7 has-text-centered has-text-grey mb-6">{{feature_image_caption}}</p>
          {{/if}}
        {{/if}}

        {{!-- MOBILE TOC (Hidden on Desktop) --}}
        <div class="box is-hidden-desktop mb-6 has-background-white-ter is-shadowless" style="border: 1px solid #ededed; border-radius: 12px;">
          <div class="is-flex is-justify-content-space-between is-align-items-center is-clickable" id="mobile-toc-toggle">
            <h3 class="title is-6 mb-0 is-flex is-align-items-center has-text-dark">
              <span class="icon has-text-primary mr-2"><i class="ph-fill ph-list-dashes is-size-5"></i></span>
              <span class="has-text-weight-bold">{{t "Table of Contents"}}</span>
            </h3>
            <span class="icon has-text-grey"><i class="ph ph-caret-down" id="mobile-toc-icon"></i></span>
          </div>
          <div id="mobile-toc-menu" class="menu mt-4 is-hidden">
            <ul class="menu-list js-toc-list has-text-weight-medium"></ul>
          </div>
        </div>

        {{!-- Post Content (Ghost handles internal typography via gh-content) --}}
        <div class="content is-medium has-text-grey-dark gh-content js-post-content mb-6">
          {{content}}
        </div>

        {{!-- Bottom Ad Space --}}
        <div class="box has-background-white-ter is-shadowless is-flex is-align-items-center is-justify-content-center mt-6 mb-6" style="border: 1px dashed #ccc; min-height: 90px; width: 100%;">
          <span class="has-text-grey is-size-7"><i class="ph ph-ad mr-1"></i> Bottom Content Ad (728x90)</span>
        </div>

        {{!-- Social Share --}}
        <div class="level is-mobile py-5" style="border-top: 1px solid #ededed; border-bottom: 1px solid #ededed;">
          <div class="level-left">
            <div class="level-item">
              <p class="has-text-weight-bold has-text-dark is-size-6 mr-3">Share:</p>
              <div class="buttons">
                <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute='true'}}" target="_blank" class="button is-light is-rounded has-text-info">
                  <span class="icon"><i class="ph-fill ph-twitter-logo"></i></span>
                </a>
                <a href="https://www.linkedin.com/shareArticle?mini=true&url={{url absolute='true'}}&title={{encode title}}" target="_blank" class="button is-light is-rounded has-text-link">
                  <span class="icon"><i class="ph-fill ph-linkedin-logo"></i></span>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>

      {{!-- ==========================================
            RIGHT COLUMN: STICKY SIDEBAR & TOC
      ========================================== --}}
      <div class="column is-4-desktop is-hidden-touch">
        
        {{!-- Newsletter Widget (Scrolls away) --}}
        <div class="box has-background-link has-text-white is-shadowless p-5 mb-6" style="border-radius: 16px;">
          <h3 class="title is-4 has-text-white mb-2">{{t "Join the Community"}}</h3>
          <p class="is-size-6 mb-4" style="opacity: 0.9;">{{t "Get weekly tips and exclusive tutorials."}}</p>
          <form data-members-form="subscribe">
            <div class="field">
              <div class="control is-expanded mb-3">
                <input data-members-email class="input is-medium is-rounded" type="email" placeholder="Email address" required>
              </div>
              <div class="control">
                <button class="button is-white is-medium is-rounded is-fullwidth has-text-link has-text-weight-bold" type="submit">
                  {{t "Subscribe"}}
                </button>
              </div>
            </div>
          </form>
        </div>

        {{!-- STICKY AREA --}}
        <aside style="position: sticky; top: 2rem; max-height: calc(100vh - 4rem); overflow-y: auto; padding-right: 4px;">
          
          {{!-- Desktop TOC Widget --}}
          <div class="box mb-5 is-shadowless" style="border: 1px solid #ededed; border-radius: 12px;">
            <h3 class="title is-6 mb-4 is-flex is-align-items-center has-text-dark">
              <span class="icon has-text-link mr-2"><i class="ph-fill ph-list-bullets is-size-5"></i></span>
              <span class="has-text-weight-bold">{{t "Table of Contents"}}</span>
            </h3>
            <div class="menu">
              <ul class="menu-list js-toc-list has-text-weight-medium"></ul>
            </div>
          </div>

          {{!-- Sticky Sidebar Ad --}}
          <div class="box has-background-white-ter is-shadowless is-flex is-align-items-center is-justify-content-center" style="border: 1px dashed #ccc; min-height: 600px; width: 100%; border-radius: 12px;">
            <span class="has-text-grey is-size-7"><i class="ph ph-ad mr-1"></i> Sticky Rail Ad (300x600)</span>
          </div>

        </aside>
      </div>

    </div>
  </div>
</main>

