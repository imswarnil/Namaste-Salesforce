{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-blog.hbs — Single blog post
  Two columns: article (breadcrumb, byline, content, share, discussion) +
  sidebar (TOC, tags, quick links, ads). Context: {{#post}} for a #blog post.
═══════════════════════════════════════════════════════════════════════════ --}}
<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">

    {{!-- Article --}}
    <article class="min-w-0">
      {{> "components/breadcrumb"}}

      <header class="mb-6">
        {{#primary_tag}}
          <a href="{{url}}" class="ns-badge">{{name}}</a>
        {{/primary_tag}}
        <h1 class="mt-4 font-heading text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{{title}}</h1>
        {{#if custom_excerpt}}<p class="mt-4 text-lg text-muted">{{custom_excerpt}}</p>{{/if}}
        <div class="mt-6 border-y border-border py-4">{{> "components/author-byline"}}</div>
      </header>

      {{#if feature_image}}
        <figure class="mb-8">
          <img loading="lazy" decoding="async" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" class="w-full rounded-card border border-border object-cover">
          {{#if feature_image_caption}}<figcaption class="mt-2 text-center text-sm text-muted">{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
      {{/if}}

      {{> "ads/slot" format="horizontal" slot="blog-top"}}

      <div class="prose prose-lg max-w-none gh-content">{{content}}</div>

      <footer class="mt-10 flex flex-col gap-6 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
        {{> "components/tag-pills"}}
        {{> social-share}}
      </footer>

      {{#if @site.comments_enabled}}
        <section class="mt-12 border-t border-border pt-8" aria-label="{{t "Discussion"}}">
          <h2 class="mb-4 flex items-center gap-2 font-heading text-xl font-extrabold">
            <i class="ph ph-chat-circle-text text-brand-500" aria-hidden="true"></i>{{t "Discussion"}}
          </h2>
          {{comments title=""}}
        </section>
      {{/if}}
    </article>

    {{!-- Sidebar: TOC + blog widgets --}}
    <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
      {{> "components/toc"}}
      {{> "blog/sidebar"}}
    </aside>
  </div>
</section>

{{> related-posts}}
