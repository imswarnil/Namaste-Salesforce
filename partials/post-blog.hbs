{{!-- post-blog.hbs — Blog post: 2-col (content + sticky sidebar) --}}
<main class="site-main post-blog-page">
<div class="post-blog-wrap outer">
<div class="inner">
<div class="post-blog-grid">

    {{!-- ── MAIN COLUMN ──────────────────────────────────── --}}
    <article class="post-blog-main article {{post_class}}">

        {{!-- Meta bar: tag + date + reading time --}}
        <div class="sfdc-flex sfdc-gap-sm sfdc-items-center sfdc-flex-wrap sfdc-mb-xl">
            {{#primary_tag}}<a class="article-tag-link" href="{{url}}">{{name}}</a>{{/primary_tag}}
            {{#if featured}}<span class="article-featured-badge">{{> "icons/fire"}} {{t "Featured"}}</span>{{/if}}
            <time class="sfdc-text-weak sfdc-text-sm" datetime="{{date format="YYYY-MM-DD"}}">
                <i class="ph ph-calendar-blank" aria-hidden="true"></i> {{date format="DD MMM YYYY"}}
            </time>
            {{#if reading_time}}
                <span class="sfdc-text-weak sfdc-text-sm">
                    <i class="ph ph-clock" aria-hidden="true"></i>
                    {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
                </span>
            {{/if}}
        </div>

        {{!-- Title + excerpt --}}
        <h1 class="article-title sfdc-mb-md">{{title}}</h1>
        {{#if custom_excerpt}}<p class="lead sfdc-mb-xl">{{custom_excerpt}}</p>{{/if}}

        {{!-- Author byline --}}
        {{> "components/author-inline"}}

        {{!-- Feature image --}}
        {{#if feature_image}}
            <figure class="post-blog-hero-image sfdc-mt-2xl">
                <img srcset="{{img_url feature_image size="s"}} 300w,
                             {{img_url feature_image size="m"}} 600w,
                             {{img_url feature_image size="l"}} 1000w,
                             {{img_url feature_image size="xl"}} 2000w"
                     sizes="92vw"
                     src="{{img_url feature_image size="xl"}}"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                     loading="eager" />
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}

        {{!-- Mobile TOC (shown on mobile only, below image) --}}
        <div class="toc-mobile">
            {{> "components/toc"}}
        </div>

        {{!-- Content --}}
        <section class="gh-content js-toc-content sfdc-mt-2xl">{{content}}</section>

        {{!-- Tags + Share --}}
        <div class="post-blog-footer sfdc-mt-3xl">
            {{#if tags}}<div class="article-tags sfdc-mb-xl">
                <span class="article-tags-label">{{t "Topics"}}</span>
                {{#foreach tags}}{{#unless internal}}<a href="{{url}}" class="article-tag-pill">{{name}}</a>{{/unless}}{{/foreach}}
            </div>{{/if}}
            {{> "components/share"}}
        </div>

        {{!-- Author card(s) --}}
        <div class="sfdc-mt-3xl">{{> "components/author-card"}}</div>

        {{!-- Comments --}}
        {{#if comments}}<section class="article-comments sfdc-mt-3xl">{{comments}}</section>{{/if}}

    </article>

    {{!-- ── SIDEBAR ─────────────────────────────────────── --}}
    <aside class="post-blog-sidebar" aria-label="{{t "Sidebar"}}">
        <div class="post-blog-sidebar__sticky">

            {{!-- Newsletter --}}
            {{#if @site.members_enabled}}{{#unless @member}}
                <div class="post-blog-sidebar__card sfdc-mb-xl">
                    <h3 class="sfdc-mb-xs" style="font-size:var(--sfdc-font-size-h5)">{{t "Join the community"}}</h3>
                    <p class="sfdc-text-secondary sfdc-text-sm sfdc-mb-lg">{{t "Get weekly tips and exclusive tutorials."}}</p>
                    <a href="#/portal/signup" data-portal="signup" class="btn btn-primary btn-block btn-pill sfdc-mb-sm">
                        <i class="ph ph-envelope-simple btn-icon" aria-hidden="true"></i>{{t "Subscribe Free"}}
                    </a>
                    <a href="#/portal/signin" data-portal="signin" class="btn btn-ghost btn-block btn-sm">{{t "Already a member? Sign in"}}</a>
                </div>
            {{/unless}}{{/if}}

            {{!-- Desktop TOC --}}
            <div class="post-blog-sidebar__card toc--sidebar">
                {{> "components/toc"}}
            </div>

        </div>
    </aside>

</div>
</div>
</div>
</main>

{{!-- Related blog posts --}}
{{#if @custom.show_recent_posts_footer}}
    {{#get "posts" filter="tag:hash-blog+id:-{{id}}" limit="3" as |related|}}
        {{#if related}}<aside class="read-more-wrap outer" aria-label="{{t "More from the blog"}}">
            <h3 class="read-more-title inner">{{t "More from the blog"}}</h3>
            <div class="read-more inner">{{#foreach related}}{{> "post-card"}}{{/foreach}}</div>
        </aside>{{/if}}
    {{/get}}
{{/if}}
