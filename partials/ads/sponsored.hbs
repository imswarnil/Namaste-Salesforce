{{!-- ads/sponsored.hbs — a configured sponsor, as the design system's
     `.ns-sponsor` (nsds/components/css/monetization.css).

     The theme used to draw its own sponsor box. The system's says the same
     things in the same order — label, mark, name, tagline, one line of copy,
     the action — and says them the same way in the app, which matters because
     a sponsor sees both.

     Shapes: --article sits INSIDE a reading column (wide, horizontal);
             --skyscraper is the rail (narrow, stacked).

     Everything here is a Ghost custom setting (Admin → Design), so a sponsor
     is changed without touching the theme. With no sponsor_url set this
     renders nothing at all — an empty sponsor slot is worse than none.

     Params: shape — "article" (default) or "skyscraper" --}}
{{#if @custom.sponsor_url}}
<a class="ns-sponsor {{#match shape "skyscraper"}}ns-sponsor--skyscraper{{else}}ns-sponsor--article{{/match}}"
   href="{{@custom.sponsor_url}}" target="_blank" rel="noopener sponsored">
  <span class="ns-sponsor__label">{{#if @custom.sponsor_label}}{{@custom.sponsor_label}}{{else}}{{t "Sponsored"}}{{/if}}</span>
  {{#if @custom.sponsor_image}}
    <img class="ns-sponsor__logo" src="{{img_url @custom.sponsor_image size="xs"}}" alt="" loading="lazy" decoding="async">
  {{/if}}
  <span class="ns-sponsor__body">
    {{#if @custom.sponsor_headline}}<span class="ns-sponsor__name">{{@custom.sponsor_headline}}</span>{{/if}}
    {{#if @custom.sponsor_body}}<span class="ns-sponsor__text">{{@custom.sponsor_body}}</span>{{/if}}
  </span>
  <span class="ns-sponsor__cta">{{#if @custom.sponsor_cta}}{{@custom.sponsor_cta}}{{else}}{{t "Learn more"}}{{/if}}{{> icons name="arrow-right"}}</span>
</a>
{{/if}}
