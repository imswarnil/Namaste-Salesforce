{{!-- ads/placeholder.hbs — dummy "Advertise with us" slot (visible by default so
     ad areas are obvious in the layout). Param: format = square | horizontal | rail. --}}
<a href="/contact/" class="group flex w-full items-center justify-center rounded-card border border-dashed border-border bg-surface-sunken text-center text-muted transition hover:border-brand-400 hover:text-brand-600 {{#match format "horizontal"}}min-h-[6rem]{{/match}}{{#match format "rail"}}min-h-[26rem]{{/match}}{{#match format "square"}}aspect-square{{/match}}{{^match format "horizontal"}}{{^match format "rail"}}{{^match format "square"}}min-h-[12rem]{{/match}}{{/match}}{{/match}}">
  <span class="px-4 py-3">
    <i class="ph ph-megaphone block text-2xl" aria-hidden="true"></i>
    <span class="mt-1 block text-sm font-semibold">{{t "Advertise with us"}}</span>
    <span class="mt-0.5 block text-xs opacity-70">{{#match format "horizontal"}}728 × 90{{else}}{{#match format "rail"}}160 × 600{{else}}300 × 250{{/match}}{{/match}}</span>
  </span>
</a>
