{{!-- ads/adsense.hbs — Google AdSense ad slot
     ---------------------------------------------------------------------------
     Renders only when ads are enabled AND a publisher ID is set in
     Ghost Admin → Design → (Ads). The AdSense loader <script> is added
     conditionally in default.hbs <head>.
     Usage: {{> "ads/adsense" slot="1234567890"}}  (slot id from your AdSense unit)
     --}}
{{#if @custom.enable_ads}}{{#if @custom.adsense_publisher_id}}
<div class="my-8 text-center">
  <span class="mb-1 block text-[0.6rem] uppercase tracking-wider text-muted">{{t "Advertisement"}}</span>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="{{@custom.adsense_publisher_id}}"
       data-ad-slot="{{slot}}"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
{{/if}}{{/if}}
