{{!-- A training-module card. Context: a #module landing post — its
slug equals the module tag's slug, which is what makes the section
count a one-line query. Same .card furniture as card-course.hbs so
the two collections sit side by side without looking like cousins. --}}

<article class="card module-card">
    <div class="card-media">
        {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}"
                srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
                sizes="(max-width: 700px) 92vw, 400px"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy" />
        {{else}}
            {{> "thumb-placeholder"}}
        {{/if}}
    </div>

    <div class="card-body">
        <div class="card-eyebrow">
            {{> "collection-chip"}}
        </div>

        <h3 class="card-title"><a class="card-link" href="{{url}}">{{title}}</a></h3>

        {{#if custom_excerpt}}
            <p class="card-excerpt">{{custom_excerpt}}</p>
        {{else if excerpt}}
            <p class="card-excerpt">{{excerpt words="24"}}</p>
        {{/if}}

        <div class="card-meta">
            {{#get "posts" filter="tag:hash-training+tag:{{slug}}" limit="1" as |sections total|}}
                <span class="course-card-lessons">{{> "icons/list-icon"}} {{total.total}} {{t "sections"}}</span>
            {{/get}}
            <span class="module-card-go">{{t "Start"}} {{> "icons/arrow-right"}}</span>
        </div>
    </div>
</article>
