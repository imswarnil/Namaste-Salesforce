{{!-- The icon for a lesson's #lesson-type-* tag. Article is the
default — an untyped lesson is a written one. Context: a post. --}}
{{#match (post_class) "~" "tag-hash-lesson-type-video"}}{{> "icons/play-circle"}}
{{~else match (post_class) "~" "tag-hash-lesson-type-quiz"}}{{> "icons/help-circle"}}
{{~else match (post_class) "~" "tag-hash-lesson-type-audio"}}{{> "icons/headphones"}}
{{~else}}{{> "icons/file-text"}}{{/match}}
