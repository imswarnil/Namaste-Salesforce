{{!-- =========================================================================
  partials/head.hbs
  ─────────────────────────────────────────────────────────────────────────
  WHAT GHOST HANDLES AUTOMATICALLY via {{ghost_head}}:
    ✓ <title> with site name fallback
    ✓ Meta description
    ✓ Open Graph (og:title, og:description, og:image, og:type, og:url)
    ✓ Twitter Card (twitter:card, twitter:title, twitter:description, twitter:image)
    ✓ Canonical URL (<link rel="canonical">)
    ✓ JSON-LD for Article / Person / Organization (on posts/pages/authors)
    ✓ Pagination prev/next link tags
    ✓ RSS autodiscovery
  WHAT WE ADD MANUALLY:
    • Performance: preconnect, dns-prefetch, resource hints
    • Phosphor Icons (loaded ONCE from CDN — NOT repeated in default.hbs)
    • Main stylesheet
    • Additional structured data for homepage / WebSite schema
    • Dynamic social image fallback meta
    • Article-specific extras (published_time, modified_time, section)
    • Colour scheme meta for browser chrome
=========================================================================== --}}

{{!-- ── 1. Performance: preconnect hints ─────────────────────────────────── --}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="dns-prefetch" href="https://www.google-analytics.com">
<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">

{{!-- ── 2. Preload critical assets ────────────────────────────────────────── --}}
<link rel="preload" as="style" href="{{asset "built/main.css"}}">
<link rel="preload" as="style" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" crossorigin>

{{!-- ── 3. Stylesheets ────────────────────────────────────────────────────── --}}
<link rel="stylesheet" href="{{asset "built/main.css"}}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css"    crossorigin>

{{!-- ── 4. Browser colour scheme hint ────────────────────────────────────── --}}
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#0176d3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#171b22" media="(prefers-color-scheme: dark)">

{{!-- ── 5. Additional SEO meta ────────────────────────────────────────────── --}}
<meta name="generator" content="Ghost {{@site.version}}">
<meta name="HandheldFriendly" content="True">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

{{!-- ── 6. Open Graph extras ───────────────────────────────────────────────── --}}
<meta property="og:site_name" content="{{@site.title}}">

{{!-- Article-specific OG meta — only on posts --}}
{{#is "post"}}
{{#post}}
<meta property="article:published_time" content="{{date published_at format="YYYY-MM-DDTHH:mm:ssZ"}}">
<meta property="article:modified_time"  content="{{date updated_at  format="YYYY-MM-DDTHH:mm:ssZ"}}">
{{#if primary_tag}}
<meta property="article:section" content="{{primary_tag.name}}">
{{/if}}
{{#foreach tags visibility="public"}}
<meta property="article:tag" content="{{name}}">
{{/foreach}}
{{!-- FIX: {{#author}} is deprecated. Use {{#primary_author}} instead. --}}
{{#primary_author}}
<meta property="article:author" content="{{url absolute="true"}}">
{{/primary_author}}
{{/post}}
{{/is}}

{{!-- ── 7. Twitter Card extras ─────────────────────────────────────────────── --}}
<meta name="twitter:site"    content="@imswarnil">
<meta name="twitter:creator" content="@imswarnil">

{{!-- ── 8. Favicon & apple touch icon ────────────────────────────────────── --}}
{{#if @site.icon}}
<link rel="icon"             href="{{@site.icon}}" type="image/png">
<link rel="apple-touch-icon" href="{{@site.icon}}">
{{else}}
<link rel="icon"             href="{{asset "images/favicon.png"}}" type="image/png">
<link rel="apple-touch-icon" href="{{asset "images/favicon.png"}}">
{{/if}}

{{!-- ── 9. RSS feed autodiscovery ─────────────────────────────────────────── --}}
<link rel="alternate" type="application/rss+xml" title="{{@site.title}} RSS" href="{{@site.url}}/rss/">

{{!-- ── 10. JSON-LD structured data ──────────────────────────────────────────
  Ghost outputs Article/Person JSON-LD automatically via {{ghost_head}}.
  We add: WebSite+SearchAction (home), BreadcrumbList (tag/author/post pages).
──────────────────────────────────────────────────────────────────────────── --}}

{{!-- WebSite + SearchAction — homepage only --}}
{{#is "home"}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}",
      {{#if @site.description}}"description": "{{@site.description}}",{{/if}}
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": {
          "@type": "ImageObject",
          "url": "{{@site.logo}}",
          "width": 512,
          "height": 512
        }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{@site.url}}/?s={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
{{/is}}

{{!-- BreadcrumbList for tag pages --}}
{{#is "tag"}}
{{#tag}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",   "item": "{{@site.url}}/" },
    { "@type": "ListItem", "position": 2, "name": "Topics", "item": "{{@site.url}}/tags/" },
    { "@type": "ListItem", "position": 3, "name": "{{name}}", "item": "{{url absolute="true"}}" }
  ]
}
</script>
{{/tag}}
{{/is}}

{{!-- BreadcrumbList for author pages --}}
{{!-- FIX: {{#author}} is deprecated — replaced with {{#foreach authors limit="1"}} --}}
{{#is "author"}}
{{#foreach authors limit="1"}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",    "item": "{{@site.url}}/" },
    { "@type": "ListItem", "position": 2, "name": "Authors", "item": "{{@site.url}}/authors/" },
    { "@type": "ListItem", "position": 3, "name": "{{name}}", "item": "{{url absolute="true"}}" }
  ]
}
</script>
{{/foreach}}
{{/is}}

{{!-- BreadcrumbList for posts --}}
{{#is "post"}}
{{#post}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{@site.url}}/" }{{#if primary_tag}},
    { "@type": "ListItem", "position": 2, "name": "{{primary_tag.name}}", "item": "{{primary_tag.url}}" },
    { "@type": "ListItem", "position": 3, "name": "{{title}}", "item": "{{url absolute="true"}}" }{{else}},
    { "@type": "ListItem", "position": 2, "name": "{{title}}", "item": "{{url absolute="true"}}" }{{/if}}
  ]
}
</script>
{{/post}}
{{/is}}

{{!-- ── 11. Ghost head — MUST be last in <head> ───────────────────────────── --}}
{{ghost_head}}
