{{!-- Hero style: ILLUSTRATED. Copy left, the platform drawn as
one SVG right — the learning trail climbing to the Salesforce
cloud and leaving as a rocket (illustrations/hero-platform.hbs).
The drawing rides CSS vars, so it follows dark mode. --}}
<section class="home-hero hero-v-illustrated outer relative">
    <div class="bg-grid" aria-hidden="true"></div>

    <div class="orb" style="width: 380px; height: 380px; top: -120px; left: -140px;" aria-hidden="true"></div>
    <div class="orb" style="width: 320px; height: 320px; bottom: -100px; right: -100px; animation-delay: -4s;" aria-hidden="true"></div>

    <div class="home-hero-grid inner">

        <div class="home-hero-copy">
            {{> "hero-copy"}}
        </div>

        <div class="home-hero-panel is-illustration">
            {{> "illustrations/hero-platform"}}
        </div>

    </div>

    <div class="inner">
        {{> "hero-stats"}}
    </div>
</section>
