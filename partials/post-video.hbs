{{!-- =========================================================
  PARTIAL: partials/post-video.hbs
  PURPOSE: Video page layout for posts tagged #video
  NOTE: Put your embed (YouTube/Vimeo/etc) inside the editor content.
========================================================= --}}

<section class="section">
  <div class="container is-max-desktop">

    <nav class="breadcrumb is-small mb-4" aria-label="breadcrumbs">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/videos/">Videos</a></li>
        <li class="is-active"><a href="{{url}}" aria-current="page">{{title}}</a></li>
      </ul>
    </nav>

    <header class="mb-5">
      <div class="tags mb-3">
        <span class="tag is-primary is-light is-rounded">
          <span class="icon is-small"><i class="ph ph-play"></i></span>
          <span>Video</span>
        </span>

        <span class="tag is-light">
          <span class="icon is-small"><i class="ph ph-calendar"></i></span>
          <span>{{date format="DD MMM YYYY"}}</span>
        </span>

        <span class="tag is-light">
          <span class="icon is-small"><i class="ph ph-timer"></i></span>
          <span>{{reading_time}}</span>
        </span>
      </div>

      <h1 class="title is-2">{{title}}</h1>

      {{#if custom_excerpt}}
        <p class="subtitle is-5 has-text-grey">{{custom_excerpt}}</p>
      {{/if}}
    </header>

    {{#if feature_image}}
      <figure class="image is-16by9 mb-5">
        <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="object-fit: cover;">
      </figure>
    {{/if}}

    <div class="content gh-content is-medium">
      {{content}}
    </div>

  </div>
</section>