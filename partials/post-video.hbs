{{!-- A library video — wide two-column layout.

Main: the embed (first card in the content), the notes, then a
Details card — published date, duration, topic, presenter — sits
right below the video itself, in the reading column, not tucked
in the sidebar.

Aside: CHAPTERS (right, alongside the video) — assets/js/video.js
finds the first table in the content whose left column is
timestamps (0:45, 2:10, 1:02:30…), lifts it into [data-chapters],
hides the original, and wires each row to seek the YouTube player.
No table, no widget. Below it: related videos, TOC, sponsor.
Context: the post. --}}

{{#contentFor "head"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "{{title}}",
    "description": "{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="40"}}{{/if}}",
    "uploadDate": "{{date published_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
    "url": "{{url absolute="true"}}"{{#if feature_image}},
    "thumbnailUrl": ["{{img_url feature_image size="l" absolute="true"}}"]{{/if}},
    "publisher": { "@id": "{{@site.url}}/#organization" },
    "isFamilyFriendly": true
}
</script>
{{/contentFor}}

<main id="site-main" class="section outer">
<div class="inner">
<div class="video-grid {{post_class}}">

    <article class="video-main">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="{{@site.url}}">{{> "icons/home"}} {{t "Home"}}</a>
            {{> "icons/chevron-right"}}
            <a href="{{@site.url}}/videos/">{{t "Videos"}}</a>
            {{> "icons/chevron-right"}}
            <span aria-current="page">{{title}}</span>
        </nav>

        <header class="post-header">
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="post-excerpt">{{custom_excerpt}}</p>{{/if}}
            <div class="chips">
                <span class="chip chip-accent">{{> "icons/play-circle"}} {{t "Video"}}</span>
                {{> "duration-chip"}}
                <span class="chip">{{> "icons/calendar"}} {{date format="DD MMM YYYY"}}</span>
            </div>
        </header>

        <section class="gh-content">
            {{content}}
        </section>

        <div class="widget widget-inline">
            <h4 class="widget-title">{{> "icons/info"}} {{t "Details"}}</h4>
            <dl class="detail-list">
                <div><dt>{{t "Published"}}</dt><dd>{{date format="DD MMM YYYY"}}</dd></div>
                <div><dt>{{t "Duration"}}</dt><dd>{{> "duration-chip" chipClass="detail-plain"}}</dd></div>
                {{#primary_tag}}
                    <div><dt>{{t "Topic"}}</dt><dd><a href="{{url}}">{{name}}</a></dd></div>
                {{/primary_tag}}
                {{#foreach authors limit="1"}}
                    <div><dt>{{t "Presented by"}}</dt><dd><a href="{{url}}">{{name}}</a></dd></div>
                {{/foreach}}
            </dl>
        </div>

        <footer class="post-footer">
            {{#if tags}}
                <ul class="tag-cloud">
                    {{#foreach tags}}<li><a href="{{url}}">{{name}}</a></li>{{/foreach}}
                </ul>
            {{/if}}
            {{> "widgets/share-links"}}
        </footer>
    </article>

    <aside class="video-aside">

        {{> "widgets/chapters"}}

        {{> "widgets/related-videos"}}

        {{> "widgets/toc"}}

        {{> "widgets/sponsor"}}

    </aside>

</div>
</div>
</main>
