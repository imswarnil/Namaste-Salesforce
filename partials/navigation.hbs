<div class="site-nav-source is-hidden" hidden aria-hidden="true" id="site-nav-source">
    {{#foreach navigation}}
        <span
            class="js-site-nav-source-item"
            data-label="{{label}}"
            data-url="{{url absolute="true"}}"
            data-slug="{{slug}}"
            data-current="{{#if current}}true{{else}}false{{/if}}"
            data-icon="{{#match slug "=" "home"}}ph-house{{else match slug "=" "about"}}ph-user{{else match slug "=" "blog"}}ph-note-pencil{{else match slug "=" "training"}}ph-student{{else match slug "=" "contact"}}ph-envelope-simple{{else match slug "=" "courses"}}ph-book-open{{else match slug "=" "projects"}}ph-code{{else match slug "=" "portfolio"}}ph-briefcase{{else match slug "=" "videos"}}ph-play-circle{{else match slug "=" "newsletter"}}ph-newspaper{{else match slug "=" "tags"}}ph-hash{{else}}ph-dot-outline{{/match}}"
        ></span>
    {{/foreach}}
</div>