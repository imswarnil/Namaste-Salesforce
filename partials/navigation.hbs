{{!-- ══════════════════════════════════════════════════════════════════════
     navigation — RESERVED NAME. Ghost renders this from the {{navigation}}
     helper, never from {{> navigation}}, so it is the only place the site's
     navigation markup exists.
     ------------------------------------------------------------------------
     ONE PARTIAL, THREE SURFACES. The helper forwards any attribute passed to
     it onto the context, so `{{navigation variant="sheet"}}` arrives here as
     {{variant}}. That is what lets the bar, the mobile sheet and the footer
     share one source rather than three copies that disagree about which link
     is current.

     `aria-current="page"` rather than a class: the CSS keys off the same
     attribute a screen reader announces, so the highlighted item and the
     announced item cannot drift. Ghost computes `current` server-side, which
     is why the bar's underline is right with JavaScript disabled.
     ══════════════════════════════════════════════════════════════════════ --}}

{{#match variant "sheet"}}

    {{#foreach navigation}}
        <a class="ns-navsheet__link" href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>
            {{!-- Mono index — NSDS's numbering device, which makes the site
                 map read as a table of contents. Padded to two digits so the
                 column stays straight; `match` with an operator is the only
                 arithmetic a Ghost template has. --}}
            <span class="ns-navsheet__index">{{#match @number "<" 10}}0{{/match}}{{@number}}</span>
            {{label}}
            <i class="ph ph-caret-right" aria-hidden="true"></i>
        </a>
    {{/foreach}}

{{else match variant "footer"}}

    {{!-- sections.css styles `.ns-footer__col ul`, so this needs no class of
         its own — only to be a <ul> inside the column. --}}
    <ul>
        {{#foreach navigation}}
            <li><a href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>{{label}}</a></li>
        {{/foreach}}
    </ul>

{{else}}

    <ul class="ns-topnav__links">
        {{#foreach navigation}}
            <li><a href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>{{label}}</a></li>
        {{/foreach}}
    </ul>

{{/match}}
