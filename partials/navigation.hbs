{{!-- =========================================================================
  navigation.hbs
  Ghost primary navigation rendered as .default-header__nav-item links.
  
  CSS CLASS CONTRACT (must match _header.scss exactly):
    Top-level item  → .default-header__nav-item
    Child item      → .default-header__nav-item  +  data-child="true"
    Icon wrapper    → .default-header__nav-icon
    Label wrapper   → .default-header__nav-label

  DROPDOWN CONVENTION:
    Label starts with "- " (dash + space) → child of preceding item.
    JS in default.hbs reads data-child="true" and builds dropdown DOM.
    The "- " prefix is stripped from the visible label by JS.
========================================================================== --}}

{{#foreach navigation}}

  {{!-- ── CHILD item — label starts with "- " ──────────────────────────── --}}
  {{#match label "~^" "- "}}
    <a
      class="default-header__nav-item{{#if current}} is-active{{/if}}"
      href="{{url absolute="true"}}"
      data-child="true"
      data-nav-slug="{{slug}}"
      {{#if current}}aria-current="page"{{/if}}
    >
      <span class="default-header__nav-icon" aria-hidden="true">
        {{> "icons/fire" slug=slug}}
      </span>
      <span class="default-header__nav-label">{{label}}</span>
    </a>

  {{!-- ── TOP-LEVEL item ─────────────────────────────────────────────────── --}}
  {{else}}
    <a
      class="default-header__nav-item{{#if current}} is-active{{/if}}"
      href="{{url absolute="true"}}"
      data-nav-slug="{{slug}}"
      {{#if current}}aria-current="page"{{/if}}
    >
      <span class="default-header__nav-icon" aria-hidden="true">
        {{#match slug "=" "home"}}
          <i class="ph ph-house-simple"></i>
        {{else match slug "=" "about"}}
          <i class="ph ph-user"></i>
        {{else match slug "=" "blog"}}
          <i class="ph ph-note-pencil"></i>
        {{else match slug "=" "training"}}
          <i class="ph ph-student"></i>
        {{else match slug "=" "contact"}}
          <i class="ph ph-envelope-simple"></i>
        {{else match slug "=" "courses"}}
          <i class="ph ph-book-open"></i>
        {{else match slug "=" "projects"}}
          <i class="ph ph-code"></i>
        {{else match slug "=" "portfolio"}}
          <i class="ph ph-briefcase"></i>
        {{else match slug "=" "videos"}}
          <i class="ph ph-play-circle"></i>
        {{else match slug "=" "newsletter"}}
          <i class="ph ph-newspaper"></i>
        {{else match slug "=" "tags"}}
          <i class="ph ph-hash"></i>
        {{else match slug "=" "authors"}}
          <i class="ph ph-users"></i>
        {{else}}
          <i class="ph ph-circle-dashed"></i>
        {{/match}}
      </span>
      <span class="default-header__nav-label">{{label}}</span>
    </a>
  {{/match}}

{{/foreach}}
