{{!-- partials/navigation.hbs — primary/secondary nav items
     Rendered by the {{navigation}} helper. Outputs <li> links with a per-slug
     icon (components/nav-icon). The parent <ul> handles layout (row in the
     header, column in the mobile menu / footer). --}}
{{#foreach navigation}}
  <li>
    <a href="{{url absolute="true"}}" class="nav-link{{#if current}} is-current{{/if}}">
      {{> "components/nav-icon" slug=slug}}
      <span>{{label}}</span>
    </a>
  </li>
{{/foreach}}
