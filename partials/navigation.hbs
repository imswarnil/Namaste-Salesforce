{{!-- partials/navigation.hbs — primary/secondary nav items
     Rendered by the {{navigation}} helper. Outputs <li> links only so the
     parent <ul> can lay them out (row in the header, column in the mobile
     menu / footer). The current page's item gets `.is-current`. --}}
{{#foreach navigation}}
  <li>
    <a href="{{url absolute="true"}}" class="nav-link{{#if current}} is-current{{/if}}">{{label}}</a>
  </li>
{{/foreach}}
