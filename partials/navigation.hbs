{{!-- Rendered by the {{navigation}} helper, which supplies what
raw @site.navigation cannot: each item's computed slug and
current flag.

DROPDOWNS ARE A LABEL CONVENTION — Ghost's navigation is a flat
list, so hierarchy is written in Admin → Settings → Navigation
with prefixes, exactly like the bright theme:

    Home          a normal item
    +Learn        a dropdown parent, displayed as "Learn"
    -Courses      a child of the dropdown above it
    -Training     another child
    Blog          no prefix — ends the dropdown, back to top level

A run of children ends at the first unprefixed item. The
dropdown itself is pure CSS (:hover / :focus-within — keyboard
included); in the mobile drawer children render inline, indented.

Icons resolve per item as icons/nav-{slug} (Ghost slugifies the
label, prefix and all: "+Learn" → "learn", "-Courses" →
"courses"); items without a matching partial render as text.

Modes:
    {{navigation}}                       header
    {{navigation isFooter=true}}         footer — flat, prefixes stripped
    {{navigation type="secondary" isFooter=true}}
--}}

{{#if isFooter}}
    {{!-- linkLimit (optional hash param) caps the flat list; the
    footer's Explore column passes 5. Unset → everything. --}}
    <ul>
        {{#foreach navigation limit=linkLimit}}
            {{#match label.[0] "+"}}
                <li><a href="{{url absolute="true"}}">{{#foreach label from="2"}}{{this}}{{/foreach}}</a></li>
            {{else match label.[0] "-"}}
                <li><a href="{{url absolute="true"}}">{{#foreach label from="2"}}{{this}}{{/foreach}}</a></li>
            {{else}}
                <li><a href="{{url absolute="true"}}">{{label}}</a></li>
            {{/match}}
        {{/foreach}}
    </ul>
{{else}}
    <ul class="site-nav">
        {{#foreach navigation}}

            {{#match label.[0] "+"}}
                {{!-- Dropdown parent. Its children are the run of "-"
                items that follows; they render inside this <li>, and
                the top-level loop skips them (next branch). --}}
                <li class="nav-item nav-has-dropdown">
                    <a href="{{url absolute="true"}}" aria-haspopup="true">
                        {{#> (concat "icons/nav-" slug)}}{{/undefined}}
                        {{#foreach label from="2"}}{{this}}{{/foreach}}
                        {{> "icons/chevron-down"}}
                    </a>
                    <ul class="nav-dropdown">
                        {{#foreach ../navigation from=@number limit="11"}}
                            {{#unless @first}}
                                <li class="nav-sub-item{{#match label.[0] "!=" "-"}} is-break{{/match}}{{#if current}} nav-current{{/if}}">
                                    <a href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>
                                        {{#> (concat "icons/nav-" slug)}}{{/undefined}}
                                        {{#foreach label from="2"}}{{this}}{{/foreach}}
                                        <span class="nav-sub-chev">{{> "icons/chevron-right"}}</span>
                                    </a>
                                </li>
                            {{/unless}}
                        {{/foreach}}
                    </ul>
                </li>

            {{else match label.[0] "-"}}
                {{!-- A child — already rendered inside its parent. --}}

            {{else}}
                <li class="nav-item{{#if current}} nav-current{{/if}}">
                    <a href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>
                        {{#> (concat "icons/nav-" slug)}}{{/undefined}}
                        {{label}}
                    </a>
                </li>
            {{/match}}

        {{/foreach}}
    </ul>
{{/if}}
