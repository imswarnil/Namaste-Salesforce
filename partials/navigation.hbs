{{!-- ═══════════════════════════════════════════════════════════════════════
  partials/navigation.hbs — Navbar menu (framework .navbar-* classes),
  icons + dropdowns, zero inline CSS

  LABEL CONVENTION (Ghost Admin → Settings → Navigation):
    Home          → regular top-level .navbar-item
    - More        → dropdown parent (label starts with "- ")
    -- About      → dropdown child  (label starts with "-- ")
    ---           → divider inside the current dropdown

  ICONS by slug (inline SVG, no icon-font dependency):
    home, courses, training, blog, videos, documentation,
    contact, tags, about, authors
  Children keep a small default "circle" marker so they align visually.

  FORCED ACTIVE MAP (post tag → nav slug):
    hash-lesson / hash-course             → courses
    hash-training / hash-training-content → training
    hash-blog                             → blog
    hash-videos                           → videos
    documentation (public)                → documentation

  HOW IT WORKS
    Ghost {{#foreach}} is flat and has no lookahead. We emit a <template>
    (zero render cost, no CSS needed) with data-* attributes. JS reads it,
    restructures "- "/"-- " labels into .has-dropdown.is-hoverable markup,
    and injects the result where the <template> lived.
═══════════════════════════════════════════════════════════════════════ --}}

<template id="nsNavData">
  {{#foreach navigation}}
    <a href="{{url absolute="true"}}"
       data-label="{{label}}"
       data-slug="{{slug}}"
       data-current="{{#if current}}1{{else}}0{{/if}}"
       data-force="{{#../post}}{{#has tag="#lesson,#course"}}courses{{/has}}{{#has tag="#training,#training-content"}}training{{/has}}{{#has tag="#blog"}}blog{{/has}}{{#has tag="#videos"}}videos{{/has}}{{#has tag="documentation"}}documentation{{/has}}{{/../post}}"
    ></a>
  {{/foreach}}
</template>

<script>
  (function () {
    var tpl = document.getElementById('nsNavData');
    if (!tpl) return;

    // ─── Inline SVG icon set (Phosphor-styled, no external dep) ───────
    var icons = {
      home:          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
      courses:       '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>',
      training:      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>',
      blog:          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
      videos:        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>',
      documentation: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
      contact:       '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
      tags:          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>',
      about:         '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
      authors:       '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
      _default:      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/></svg>'
    };

    function iconHTML(slug) {
      var svg = icons[slug] || icons._default;
      return '<span class="icon is-small mr-1">' + svg + '</span>';
    }

    function escape(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
      });
    }

    // Collect flat items from template
    var items = Array.prototype.slice.call(
      tpl.content.querySelectorAll('a')
    );

    var html = '';
    var inDropdown = false;

    items.forEach(function (el) {
      var label   = el.getAttribute('data-label')   || '';
      var slug    = el.getAttribute('data-slug')    || '';
      var href    = el.getAttribute('href')         || '#';
      var force   = el.getAttribute('data-force')   || '';
      var current = el.getAttribute('data-current') === '1';
      var active  = (current || (force && slug === force)) ? ' is-active' : '';

      // Divider inside an open dropdown
      if (label === '---') {
        if (inDropdown) html += '<hr class="navbar-divider">';
        return;
      }

      // Dropdown child: "-- Label"
      if (label.indexOf('-- ') === 0) {
        html +=
          '<a class="navbar-item' + active + '" href="' + escape(href) + '">' +
            iconHTML(slug) +
            '<span>' + escape(label.slice(3)) + '</span>' +
          '</a>';
        return;
      }

      // New top-level item — close any open dropdown first
      if (inDropdown) {
        html += '</div></div>';
        inDropdown = false;
      }

      // Dropdown parent: "- Label"
      if (label.indexOf('- ') === 0) {
        html +=
          '<div class="navbar-item has-dropdown is-hoverable">' +
            '<a class="navbar-link has-text-weight-medium">' +
              iconHTML(slug) +
              '<span>' + escape(label.slice(2)) + '</span>' +
            '</a>' +
            '<div class="navbar-dropdown">';
        inDropdown = true;
        return;
      }

      // Plain top-level link
      html +=
        '<a class="navbar-item has-text-weight-medium' + active + '" href="' + escape(href) + '">' +
          iconHTML(slug) +
          '<span>' + escape(label) + '</span>' +
        '</a>';
    });

    if (inDropdown) html += '</div></div>';

    // Replace the <template> with the rendered navbar items
    var wrap = document.createElement('span');
    wrap.innerHTML = html;
    var parent = tpl.parentNode;
    while (wrap.firstChild) {
      parent.insertBefore(wrap.firstChild, tpl);
    }
    tpl.remove();
  })();
</script>
