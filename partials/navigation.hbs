{{#foreach navigation}}
    <a href="{{url absolute="true"}}" class="navbar-item nav-{{slug}}{{#if current}} is-active{{/if}}">
        <span class="icon">
            {{#match slug "=" "home"}}
                <i class="ph ph-house"></i>
            {{else match slug "=" "about"}}
                <i class="ph ph-user"></i>
            {{else match slug "=" "blog"}}
                <i class="ph ph-note-pencil"></i>
            {{else match slug "=" "contact"}}
                <i class="ph ph-envelope-simple"></i>
            {{else match slug "=" "courses"}}
                <i class="ph ph-book-open"></i>
            {{else match slug "=" "projects"}}
                <i class="ph ph-code"></i>
            {{else match slug "=" "portfolio"}}
                <i class="ph ph-briefcase"></i>
            {{else match slug "=" "videos"}}
                <i class="ph ph-play-circle"></i>
            {{else match slug "=" "newsletter"}}
                <i class="ph ph-newspaper"></i>
            {{else match slug "=" "tags"}}
                <i class="ph ph-hash"></i>
            {{else}}
                <i class="ph ph-dot-outline"></i>
            {{/match}}
        </span>
        <span>{{label}}</span>
    </a>
{{/foreach}}