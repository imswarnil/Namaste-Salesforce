{{!-- partials/landing-block__content.hbs --}}

{{#if isHero}}
    <div class="sx-hero">
        <div class="sx-hero__badge">
            <span class="sx-dot"></span>
            <span>{{#if primary_tag}}{{primary_tag.name}}{{else}}Namaste Salesforce{{/if}}</span>
        </div>

        <h1 class="sx-hero__title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="sx-hero__excerpt">{{custom_excerpt}}</p>
        {{else}}
            <p class="sx-hero__excerpt">{{excerpt}}</p>
        {{/if}}

        <div class="sx-hero__meta">
            <span class="sx-pill">LMS</span>
            <span class="sx-pill">CRM Analytics</span>
            <span class="sx-pill">Real Projects</span>
        </div>

        <div class="sx-hero__actions">
            {{#has tag="#landing-cta-courses"}}
                <a class="sx-btn sx-btn--primary" href="/courses/">Explore Courses</a>
            {{else}}
                <a class="sx-btn sx-btn--primary" href="/courses/">Explore Courses</a>
            {{/has}}

            {{#has tag="#landing-cta-blog"}}
                <a class="sx-btn sx-btn--ghost" href="/blog/">Read Blog</a>
            {{else}}
                <a class="sx-btn sx-btn--ghost" href="/blog/">Read Blog</a>
            {{/has}}

            {{#has tag="#landing-cta-subscribe"}}
                {{#unless @member}}
                    <a class="sx-btn sx-btn--ghost" href="/subscribe/">Subscribe</a>
                {{/unless}}
            {{/has}}
        </div>
    </div>

{{else}}
    <header class="sx-block__head">
        <h2 class="sx-block__title">{{title}}</h2>
        {{#if custom_excerpt}}<p class="sx-block__sub">{{custom_excerpt}}</p>{{/if}}
    </header>

    <div class="sx-block__body gh-content">

        {{!-- Dynamic content modes --}}
        {{#has tag="#landing-blog-feed"}}
            {{#get "posts" filter="tag:hash-blog-col" limit="12" order="published_at desc" include="authors,tags"}}
                {{#if posts}}
                    <div class="sx-feed sx-feed--posts">
                        {{#foreach posts}}
                            <article class="sx-card">
                                <a class="sx-card__link" href="{{url}}">
                                    {{#if feature_image}}
                                        <div class="sx-card__media">
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
                                        </div>
                                    {{/if}}
                                    <div class="sx-card__body">
                                        <h3 class="sx-card__title">{{title}}</h3>
                                        <p class="sx-card__excerpt">{{excerpt words="16"}}</p>
                                        <div class="sx-card__meta">
                                            <span>{{date format="MMM D, YYYY"}}</span>
                                            <span class="sx-sep">•</span>
                                            <span>{{reading_time minute="1 min" minutes="% min"}}</span>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        {{/foreach}}
                    </div>

                    <div class="sx-block__foot">
                        <a class="sx-btn sx-btn--ghost" href="/blog/">View all posts</a>
                    </div>
                {{else}}
                    <p class="sx-muted">No blog posts found under <strong>#blog-col</strong>.</p>
                {{/if}}
            {{/get}}

        {{else has tag="#landing-courses-feed"}}
            {{#get "posts" filter="tag:hash-courses-col" limit="12" order="published_at desc" include="tags"}}
                {{#if posts}}
                    <div class="sx-feed sx-feed--courses">
                        {{#foreach posts}}
                            <article class="sx-card">
                                <a class="sx-card__link" href="{{url}}">
                                    {{#if feature_image}}
                                        <div class="sx-card__media">
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}">
                                        </div>
                                    {{/if}}
                                    <div class="sx-card__body">
                                        <h3 class="sx-card__title">{{title}}</h3>
                                        <p class="sx-card__excerpt">{{excerpt words="18"}}</p>
                                        <div class="sx-card__meta">
                                            {{#if primary_tag}}<span>{{primary_tag.name}}</span>{{/if}}
                                            <span class="sx-sep">•</span>
                                            <span>{{reading_time minute="1 min" minutes="% min"}}</span>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        {{/foreach}}
                    </div>

                    <div class="sx-block__foot">
                        <a class="sx-btn sx-btn--ghost" href="/courses/">View all courses</a>
                    </div>
                {{else}}
                    <p class="sx-muted">No courses found under <strong>#courses-col</strong>.</p>
                {{/if}}
            {{/get}}

        {{else has tag="#landing-lessons-feed"}}
            {{#if primary_tag}}
                {{#get "posts" filter="tag:hash-lessons-col+tag:{{primary_tag.slug}}" limit="24" order="published_at asc"}}
                    {{#if posts}}
                        <div class="sx-list">
                            {{#foreach posts}}
                                <a class="sx-list__item" href="{{url}}">
                                    <span class="sx-list__num">{{@number}}</span>
                                    <span class="sx-list__title">{{title}}</span>
                                    <span class="sx-list__arrow" aria-hidden="true">→</span>
                                </a>
                            {{/foreach}}
                        </div>
                    {{else}}
                        <p class="sx-muted">No lessons found for <strong>{{primary_tag.slug}}</strong>.</p>
                    {{/if}}
                {{/get}}
            {{else}}
                <p class="sx-muted">Add a <strong>primary tag</strong> to this landing block to choose which course lessons to show.</p>
            {{/if}}

        {{else}}
            {{content}}
        {{/has}}

    </div>
{{/if}}