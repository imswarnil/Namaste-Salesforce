{{!-- THE hero — Swarnil's story, told by the site itself.

Identity comes straight from Ghost: the headline is @site.title,
the sub is @site.description, and when a publication cover is
set (Admin → Design → Publication cover) it becomes the hero's
background — masked and faded so the copy always wins.

Right: the stack — every format as a SMALL, low-fidelity screen
(skeleton bars and shapes, not real meta) so each card reads as
WHAT IT IS at a glance: an app window, a camcorder, a waypoint,
a sheet of writing, an envelope, a shipped badge. Every card
still links to the real latest post of its kind; the title rides
along as the accessible label. --}}

<section class="home-hero outer relative">
    {{!-- The backdrop is a PATTERN, not a photo: the crosshair
    blueprint (.home-hero-pattern) — an SVG tile used as a mask
    over a solid colour, so it recolours with the theme. --}}
    <div class="home-hero-pattern" aria-hidden="true"></div>

    <div class="orb" style="width: 420px; height: 420px; top: -120px; left: -140px;" aria-hidden="true"></div>
    <div class="orb" style="width: 360px; height: 360px; bottom: -80px; right: -100px; animation-delay: -4s;" aria-hidden="true"></div>

    <div class="home-hero-grid inner">

        <div class="home-hero-copy">

            {{#get "authors" limit="1" as |host|}}
                {{#foreach host}}
                    <a class="home-hero-badge is-host" href="{{url}}">
                        {{#if profile_image}}
                            <img src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                        {{else}}
                            {{> "icons/avatar"}}
                        {{/if}}
                        {{name}} &middot; {{t "learning in public"}}
                    </a>
                {{/foreach}}
            {{/get}}

            <h1>{{@site.title}}</h1>
            <svg class="hero-flourish" viewBox="0 0 220 12" aria-hidden="true"><path d="M3 9 C 45 3, 85 11, 125 6 S 195 3, 217 7"/></svg>
            <p class="home-hero-sub">{{#if @site.description}}{{@site.description}}{{else}}{{t "Namaste! I'm seven-plus years into IT, and this site is my rule made public: build the thing first, then share exactly how."}}{{/if}}</p>

            {{!-- The ask — compact --}}
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <form class="signup-form hero-signup is-compact" data-members-form="signup">
                        <div class="signup-row">
                            <input class="signup-input" data-members-email type="email" required
                                placeholder="{{t "you@work-email.com"}}" aria-label="{{t "Your email"}}" />
                            <button class="btn signup-btn" type="submit">
                                {{> "icons/mail"}} {{t "Follow along"}}
                            </button>
                        </div>
                        <p class="signup-note">{{t "Free forever · one email a week · unsubscribe in one click"}}</p>
                        <p class="signup-success">{{> "icons/check-circle"}} {{t "Almost in! Check your inbox and click the magic link."}}</p>
                        <p class="signup-error" data-members-error></p>
                    </form>
                {{else}}
                    <div class="home-hero-actions">
                        <a class="btn btn-lg" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Continue learning"}}</a>
                    </div>
                {{/unless}}
            {{else}}
                <div class="home-hero-actions">
                    <a class="btn btn-lg" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Browse courses"}}</a>
                </div>
            {{/if}}

            {{!-- Crowd proof + freshness --}}
            <div class="hero-proof">
                <span class="proof-stack" aria-hidden="true">
                    {{#get "authors" limit="4" as |folks|}}
                        {{#foreach folks}}
                            {{#if profile_image}}
                                <img class="p-avatar" src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                            {{/if}}
                        {{/foreach}}
                    {{/get}}
                    <span class="p-avatar p-mono" style="--h: 210;">A</span>
                    <span class="p-avatar p-mono" style="--h: 152;">R</span>
                    <span class="p-avatar p-mono" style="--h: 264;">M</span>
                    <span class="p-avatar p-mono" style="--h: 24;">K</span>
                </span>
                <span class="hero-proof-text">
                    <strong>{{t "20+ learners"}}</strong> {{t "building along in real orgs"}}
                </span>
            </div>

            {{#get "posts" filter="tag:hash-changelog" limit="1" as |shipped|}}
                {{#if shipped}}
                    <a class="home-shipped" href="{{shipped.[0].url}}">
                        <span class="home-shipped-ping" aria-hidden="true"></span>
                        <strong>{{t "Just shipped"}}</strong>
                        <span class="home-shipped-title">{{shipped.[0].title}}</span>
                        {{> "icons/arrow-right"}}
                    </a>
                {{/if}}
            {{/get}}

            {{!-- Where else I share --}}
            <div class="hero-socials" aria-label="{{t "Elsewhere"}}">
                {{#if @custom.social_youtube}}<a href="{{@custom.social_youtube}}" target="_blank" rel="noopener" aria-label="YouTube">{{> "icons/youtube"}}</a>{{/if}}
                {{#if @custom.social_linkedin}}<a href="{{@custom.social_linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a>{{/if}}
                {{#if @custom.social_github}}<a href="{{@custom.social_github}}" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a>{{/if}}
                {{#if @custom.social_instagram}}<a href="{{@custom.social_instagram}}" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a>{{/if}}
                {{#if @site.twitter}}<a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">{{> "icons/x"}}</a>{{/if}}
                <a href="{{@site.url}}/rss/" aria-label="RSS">{{> "icons/rss"}}</a>
            </div>
        </div>

        {{!-- The stack: every format as a small lo-fi screen.
        Skeleton bars, not meta — each card reads as WHAT it is. --}}
        <div class="hero-stack">
            {{!-- The web: animate.js draws one thin line from the
            hub to every screen and satellite, and redraws them
            every frame while the gravity scroll runs. --}}
            <svg class="hero-web" aria-hidden="true"></svg>
            <span class="hero-stack-spine" aria-hidden="true"></span>

            {{!-- The hub: the publication itself. The cover photo
            in a rounded square, radar rings pulsing, tiny UI bits
            pinned to it — every screen orbits this tile. --}}
            <span class="hero-hub" aria-hidden="true">
                <i class="hero-hub-ring"></i>
                <i class="hero-hub-ring r2"></i>
                <span class="hero-hub-tile is-person">
                    {{#if @site.cover_image}}
                        <img src="{{img_url @site.cover_image size="m"}}" alt="" loading="eager" fetchpriority="high" />
                    {{else}}
                        {{#get "authors" limit="1" as |h|}}
                            {{#if h.[0].profile_image}}
                                <img src="{{img_url h.[0].profile_image size="m"}}" alt="" loading="eager" fetchpriority="high" />
                            {{else if @site.icon}}
                                <img src="{{img_url @site.icon size="s"}}" alt="" loading="eager" />
                            {{else}}
                                {{> "icons/avatar"}}
                            {{/if}}
                        {{/get}}
                    {{/if}}
                </span>
                <span class="hero-bit is-notif"><i></i>{{> "icons/bell"}}</span>
                <span class="hero-bit is-verified">{{> "icons/check-circle"}} {{t "building live"}}</span>
                <span class="hero-bit is-git">{{> "icons/github"}} main<i class="ok"></i></span>
            </span>

            {{!-- 1 · course = app window --}}
            {{#get "posts" filter="tag:hash-course" order="featured desc, published_at asc" limit="1" as |star|}}
                {{#foreach star}}
                    <a class="hero-shot is-course hero-app" href="{{url}}" aria-label="{{title}}" data-tilt>
                        <span class="hero-app-bar" aria-hidden="true">
                            <span class="hero-app-dots"><i></i><i></i><i></i></span>
                            <span class="hero-app-url">/courses</span>
                        </span>
                        <span class="hero-app-body" aria-hidden="true">
                            <span class="hero-app-rail">
                                <span class="sk sk-w80"></span>
                                <span class="sk-row is-now"><i class="sk-dot"></i><span class="sk sk-w70"></span></span>
                                <span class="sk-row"><i class="sk-dot"></i><span class="sk sk-w60"></span></span>
                                <span class="sk-row"><i class="sk-dot"></i><span class="sk sk-w70"></span></span>
                            </span>
                            <span class="hero-app-stage">
                                <span class="hero-app-screen">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" />
                                    {{/if}}
                                    <span class="hero-app-play">{{> "icons/play-circle"}}</span>
                                </span>
                                <span class="hero-app-progress"><i></i></span>
                            </span>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 2 · video = camcorder --}}
            {{#get "posts" filter="tag:hash-video" include="tags" order="published_at desc" limit="1" as |vid|}}
                {{#foreach vid}}
                    <a class="hero-shot is-video" href="{{url}}" aria-label="{{title}}">
                        <span class="hero-cam-top" aria-hidden="true">
                            <span class="hero-cam-rec"><i></i> REC</span>
                            {{> "duration-chip" chipClass="hero-cam-time"}}
                        </span>
                        <span class="hero-screen-media" aria-hidden="true">
                            {{#if feature_image}}
                                <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" />
                            {{else}}
                                {{> "thumb-placeholder" icon="video"}}
                            {{/if}}
                            {{> "video-preview"}}
                            <i class="hero-cam-corner tl"></i><i class="hero-cam-corner tr"></i>
                            <i class="hero-cam-corner bl"></i><i class="hero-cam-corner br"></i>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 3 · training = waypoint on a trail --}}
            {{#get "posts" filter="tag:hash-training" order="published_at desc" limit="1" as |tr|}}
                {{#foreach tr}}
                    <a class="hero-shot is-training" href="{{url}}" aria-label="{{title}}">
                        <span class="hero-shot-label" aria-hidden="true">{{t "Training"}}</span>
                        <span class="hero-train-node" aria-hidden="true">{{> "icons/layers"}}</span>
                        <span class="hero-train-body" aria-hidden="true">
                            <span class="sk sk-thin sk-w40"></span>
                            <span class="sk sk-w80"></span>
                            <span class="hero-train-ticks"><i class="done"></i><i class="done"></i><i></i><i></i></span>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 4 · blog = a sheet of writing --}}
            {{#get "posts" filter="tag:hash-blog" limit="1" as |art|}}
                {{#foreach art}}
                    <a class="hero-shot is-writing" href="{{url}}" aria-label="{{title}}">
                        <span class="hero-shot-label" aria-hidden="true">{{t "Blog"}}</span>
                        <span class="hero-shot-tag" aria-hidden="true">{{> "icons/pen"}}</span>
                        <span class="hero-sheet-body" aria-hidden="true">
                            <span class="sk sk-w80"></span>
                            <span class="sk sk-thin sk-w90"></span>
                            <span class="sk sk-thin sk-w70"></span>
                            <span class="sk sk-thin sk-w80"></span>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 5 · newsletter = an envelope, opened. Real subject
            line for context; sits top-right above the VS Code
            window in the orbit. --}}
            {{#get "posts" filter="tag:hash-newsletter" limit="1" as |iss|}}
                {{#foreach iss}}
                    <a class="hero-shot is-mail" href="{{url}}" aria-label="{{title}}">
                        <span class="hero-mail-flap" aria-hidden="true"></span>
                        <span class="hero-shot-label" aria-hidden="true">{{t "Newsletter"}}</span>
                        <span class="hero-shot-tag" aria-hidden="true">{{> "icons/mail"}}</span>
                        <span class="hero-sheet-body" aria-hidden="true">
                            <b class="hero-mail-subj">{{t "The Weekly Namaste"}}</b>
                            <span class="sk sk-w70"></span>
                            <span class="sk sk-thin sk-w50"></span>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 6 · snippet = a mini VS Code window: real file
            names in the tab strip, lo-fi buffer, status bar --}}
            {{#get "posts" filter="tag:hash-snippet" limit="1" as |snip|}}
                {{#foreach snip}}
                    <a class="hero-shot is-snip" href="{{url}}" aria-label="{{title}}">
                        <span class="hero-snip-bar" aria-hidden="true"><i></i><i></i><i></i><em>VS Code</em></span>
                        <span class="hero-snip-tabs" aria-hidden="true">
                            <b class="is-on">{{> "icons/code"}} apex.cls</b>
                            <b>lwc.html</b>
                            <b>flow.xml</b>
                        </span>
                        <span class="hero-snip-code" aria-hidden="true">
                            <b class="vt-k" style="width: 34%;"></b>
                            <b class="vt-s" style="width: 58%;"></b>
                            <b style="width: 44%;"></b>
                        </span>
                        <span class="hero-snip-status" aria-hidden="true">{{> "icons/github"}} main &middot; Apex</span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 7 · prompt = a chat exchange --}}
            {{#get "posts" filter="tag:hash-prompt" limit="1" as |pmt|}}
                {{#foreach pmt}}
                    <a class="hero-shot is-chat" href="{{url}}" aria-label="{{title}}">
                        <span class="hero-shot-label" aria-hidden="true">{{t "Prompts"}}</span>
                        <span class="hero-chat-you" aria-hidden="true"><span class="sk sk-thin sk-w80"></span></span>
                        <span class="hero-chat-ai" aria-hidden="true">{{> "icons/sparkles"}}<i></i><i></i><i></i></span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 8 · resource = a bookmark chip --}}
            {{#get "posts" filter="tag:hash-resource" limit="1" as |res|}}
                {{#foreach res}}
                    <a class="hero-shot is-res" href="{{url}}" aria-label="{{title}}">
                        {{> "icons/bookmark"}}
                        <span class="sk sk-thin" style="width: 7rem;" aria-hidden="true"></span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 9 · shop = a price tag --}}
            {{#get "posts" filter="tag:hash-shop" include="tags" limit="1" as |item|}}
                {{#foreach item}}
                    <a class="hero-shot is-shop" href="{{url}}" aria-label="{{title}}">
                        {{> "icons/gift"}}
                        <span class="sk sk-thin" style="width: 5.6rem;" aria-hidden="true"></span>
                        {{#foreach tags visibility="internal"}}
                            {{#match slug "~^" "hash-shop-price-"}}
                                {{#if description}}<b>{{description}}</b>{{/if}}
                            {{/match}}
                            {{#match slug "hash-shop-free"}}<b>{{t "Free"}}</b>{{/match}}
                        {{/foreach}}
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 10 · changelog = the shipped badge --}}
            {{#get "posts" filter="tag:hash-changelog" include="tags" limit="1" as |chg|}}
                {{#foreach chg}}
                    <a class="hero-shot is-ship" href="{{url}}" aria-label="{{title}}">
                        {{> "changelog-badge"}}
                        <span class="sk sk-w60" aria-hidden="true"></span>
                        {{> "icons/arrow-right"}}
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- Tiny satellites — pure garnish, threaded into the
            web so the collage reads as one connected system --}}
            <span class="hero-dot is-d1" aria-hidden="true">{{> "icons/cloud"}}</span>
            <span class="hero-dot is-d2" aria-hidden="true">{{> "icons/zap"}}</span>
            <span class="hero-dot is-d3" aria-hidden="true">{{> "icons/sparkles"}}</span>
        </div>

    </div>

    {{!-- Every collection, one inline strip --}}
    <div class="inner">
        <nav class="hero-collections" aria-label="{{t "Browse everything"}}">
            <a href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Courses"}}</a>
            <a href="{{@site.url}}/training/">{{> "icons/layers"}} {{t "Training"}}</a>
            <a href="{{@site.url}}/videos/">{{> "icons/video"}} {{t "Videos"}}</a>
            <a href="{{@site.url}}/blog/">{{> "icons/pen"}} {{t "Blog"}}</a>
            <a href="{{@site.url}}/newsletter/">{{> "icons/newspaper"}} {{t "Newsletter"}}</a>
            <a href="{{@site.url}}/snippets/">{{> "icons/code"}} {{t "Snippets"}}</a>
            <a href="{{@site.url}}/prompts/">{{> "icons/sparkles"}} {{t "Prompts"}}</a>
            <a href="{{@site.url}}/resources/">{{> "icons/bookmark"}} {{t "Resources"}}</a>
            <a href="{{@site.url}}/projects/">{{> "icons/github"}} {{t "Projects"}}</a>
            <a href="{{@site.url}}/shop/">{{> "icons/gift"}} {{t "Shop"}}</a>
            <a href="{{@site.url}}/changelog/">{{> "icons/history"}} {{t "Changelog"}}</a>
        </nav>

        {{> "hero-stats"}}
    </div>
</section>
