{{!-- THE hero — Swarnil's story, told by the site itself.

Left: the story (7+ years in IT, learning in public, build first
→ share how, aiming at GTM engineering in the AI era), a compact
signup, the avatar-fan proof, the shipped pill, and the social
row. Right: the whole platform as a connected stack of screens —
the featured course in an app window, the latest video in a
camcorder frame (REC blinking, muted autoplay when the post
carries #video-preview), the newest training stop as a waypoint
card, the latest blog post as a sheet of writing, the latest
issue as an envelope, the latest changelog entry as a shipped
badge — every one live data, hanging off one dashed spine.
Below the grid: every collection as one inline strip. --}}

<section class="home-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>

    <div class="orb" style="width: 420px; height: 420px; top: -120px; left: -140px;" aria-hidden="true"></div>
    <div class="orb" style="width: 360px; height: 360px; bottom: -80px; right: -100px; animation-delay: -4s;" aria-hidden="true"></div>
    <div class="home-deco" style="top: 14%; left: 44%;" data-parallax="0.08" aria-hidden="true">
        <span class="home-bubble float">{{> "icons/cloud"}}</span>
    </div>
    <div class="home-deco" style="bottom: 26%; left: 4%;" data-parallax="0.12" aria-hidden="true">
        <span class="home-bubble float-alt" style="animation-delay: -6s;">{{> "icons/code"}}</span>
    </div>

    <div class="home-hero-grid inner">

        <div class="home-hero-copy">

            {{#get "authors" limit="1" as |host|}}
                {{#foreach host}}
                    <a class="home-hero-badge is-host" href="{{url}}">
                        {{#if profile_image}}
                            <img src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                        {{else}}
                            {{> "icons/avatar"}}
                        {{/if}}
                        {{name}} &middot; {{t "learning in public"}}
                    </a>
                {{/foreach}}
            {{/get}}

            {{#page}}
                <h1>{{title}}</h1>
                <svg class="hero-flourish" viewBox="0 0 220 12" aria-hidden="true"><path d="M3 9 C 45 3, 85 11, 125 6 S 195 3, 217 7"/></svg>
                <p class="home-hero-sub">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Namaste! I'm seven-plus years into IT, and this site is my rule made public: build the thing first, then share exactly how. Courses, training, videos and notes — all from real builds, mistakes left in."}}{{/if}}</p>
            {{else}}
                <h1>{{t "I build first."}} <em>{{t "Then I show you how."}}</em></h1>
                <svg class="hero-flourish" viewBox="0 0 220 12" aria-hidden="true"><path d="M3 9 C 45 3, 85 11, 125 6 S 195 3, 217 7"/></svg>
                <p class="home-hero-sub">{{t "Namaste! I'm seven-plus years into IT, and this site is my rule made public: build the thing first, then share exactly how. Courses, training, videos and notes — all from real builds, mistakes left in."}}</p>
            {{/page}}

            <ul class="hero-facts">
                <li>{{> "icons/shield"}} {{t "7+ years in IT"}}</li>
                <li>{{> "icons/zap"}} {{t "Build → then share"}}</li>
                <li>{{> "icons/rocket"}} {{t "Next: GTM Engineer, powered by the AI era"}}</li>
            </ul>

            {{!-- The ask — compact --}}
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <form class="signup-form hero-signup is-compact" data-members-form="signup">
                        <div class="signup-row">
                            <input class="signup-input" data-members-email type="email" required
                                placeholder="{{t "you@work-email.com"}}" aria-label="{{t "Your email"}}" />
                            <button class="btn signup-btn" type="submit">
                                {{> "icons/mail"}} {{t "Follow along"}}
                            </button>
                        </div>
                        <p class="signup-note">{{t "Free forever · one email a week · unsubscribe in one click"}}</p>
                        <p class="signup-success">{{> "icons/check-circle"}} {{t "Almost in! Check your inbox and click the magic link."}}</p>
                        <p class="signup-error" data-members-error></p>
                    </form>
                {{else}}
                    <div class="home-hero-actions">
                        <a class="btn btn-lg" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Continue learning"}}</a>
                    </div>
                {{/unless}}
            {{else}}
                <div class="home-hero-actions">
                    <a class="btn btn-lg" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Browse courses"}}</a>
                </div>
            {{/if}}

            {{!-- Crowd proof + freshness --}}
            <div class="hero-proof">
                <span class="proof-stack" aria-hidden="true">
                    {{#get "authors" limit="4" as |folks|}}
                        {{#foreach folks}}
                            {{#if profile_image}}
                                <img class="p-avatar" src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                            {{/if}}
                        {{/foreach}}
                    {{/get}}
                    <span class="p-avatar p-mono" style="--h: 210;">A</span>
                    <span class="p-avatar p-mono" style="--h: 152;">R</span>
                    <span class="p-avatar p-mono" style="--h: 264;">M</span>
                    <span class="p-avatar p-mono" style="--h: 24;">K</span>
                </span>
                <span class="hero-proof-text">
                    <strong>{{t "20+ learners"}}</strong> {{t "building along in real orgs"}}
                </span>
            </div>

            {{#get "posts" filter="tag:[hash-changelog-col,hash-feed-col]" limit="1" as |shipped|}}
                {{#if shipped}}
                    <a class="home-shipped" href="{{shipped.[0].url}}">
                        <span class="home-shipped-ping" aria-hidden="true"></span>
                        <strong>{{t "Just shipped"}}</strong>
                        <span class="home-shipped-title">{{shipped.[0].title}}</span>
                        {{> "icons/arrow-right"}}
                    </a>
                {{/if}}
            {{/get}}

            {{!-- Where else I share --}}
            <div class="hero-socials" aria-label="{{t "Elsewhere"}}">
                {{#if @custom.social_youtube}}<a href="{{@custom.social_youtube}}" target="_blank" rel="noopener" aria-label="YouTube">{{> "icons/youtube"}}</a>{{/if}}
                {{#if @custom.social_linkedin}}<a href="{{@custom.social_linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a>{{/if}}
                {{#if @custom.social_github}}<a href="{{@custom.social_github}}" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a>{{/if}}
                {{#if @custom.social_instagram}}<a href="{{@custom.social_instagram}}" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a>{{/if}}
                {{#if @site.twitter}}<a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">{{> "icons/x"}}</a>{{/if}}
                <a href="{{@site.url}}/rss/" aria-label="RSS">{{> "icons/rss"}}</a>
            </div>
        </div>

        {{!-- The stack: every format, one spine --}}
        <div class="hero-stack" aria-hidden="false">
            <span class="hero-stack-spine" aria-hidden="true"></span>

            {{!-- 1 · the featured course, as the app --}}
            {{#get "posts" filter="tag:[hash-course-col,hash-courses-col]" order="featured desc, published_at asc" limit="1" as |star|}}
                {{#foreach star}}
                    <a class="hero-shot is-course hero-app" href="{{url}}" data-tilt>
                        <span class="hero-app-bar" aria-hidden="true">
                            <span class="hero-app-dots"><i></i><i></i><i></i></span>
                            <span class="hero-app-url">/courses/{{slug}}</span>
                        </span>
                        <span class="hero-app-body" aria-hidden="true">
                            <span class="hero-app-rail">
                                <strong>{{title}}</strong>
                                {{#> "with-this" courseSlug=slug}}
                                    {{#get "posts" filter="tag:{{courseSlug}}+tag:[hash-lesson-col,hash-lessons-col]" order="published_at asc" limit="3" as |lessons|}}
                                        {{#foreach lessons}}
                                            <span class="hero-app-lesson{{#if @first}} is-now{{/if}}">
                                                {{#if @first}}{{> "icons/play-circle"}}{{else}}{{> "icons/check-circle"}}{{/if}}
                                                {{title}}
                                            </span>
                                        {{/foreach}}
                                    {{/get}}
                                {{/with-this}}
                            </span>
                            <span class="hero-app-stage">
                                <span class="hero-app-screen">
                                    {{#if feature_image}}
                                        <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" />
                                    {{/if}}
                                    <span class="hero-app-play">{{> "icons/play-circle"}}</span>
                                </span>
                                <span class="hero-app-progress"><i></i></span>
                            </span>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 2 · the latest video, in the camcorder --}}
            {{#get "posts" filter="tag:hash-video-col" include="tags" order="published_at desc" limit="1" as |vid|}}
                {{#foreach vid}}
                    <a class="hero-shot is-video" href="{{url}}">
                        <span class="hero-cam-top" aria-hidden="true">
                            <span class="hero-cam-rec"><i></i> REC</span>
                            {{> "duration-chip" chipClass="hero-cam-time"}}
                        </span>
                        <span class="hero-screen-media" aria-hidden="true">
                            {{#if feature_image}}
                                <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" />
                            {{else}}
                                {{> "thumb-placeholder" icon="video"}}
                            {{/if}}
                            {{> "video-preview"}}
                            <i class="hero-cam-corner tl"></i><i class="hero-cam-corner tr"></i>
                            <i class="hero-cam-corner bl"></i><i class="hero-cam-corner br"></i>
                        </span>
                        <span class="hero-shot-caption">{{> "icons/video"}} {{title}}</span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 3 · the newest training stop, as a waypoint card --}}
            {{#get "posts" filter="tag:[hash-training-col,hash-docs-col]" order="published_at desc" limit="1" as |tr|}}
                {{#foreach tr}}
                    <a class="hero-shot is-training" href="{{url}}">
                        <span class="hero-train-node" aria-hidden="true">{{> "icons/layers"}}</span>
                        <span class="hero-train-body">
                            {{#primary_tag}}<small>{{name}}</small>{{/primary_tag}}
                            <strong>{{title}}</strong>
                            <span class="hero-train-ticks" aria-hidden="true"><i class="done"></i><i class="done"></i><i></i><i></i></span>
                        </span>
                    </a>
                {{/foreach}}
            {{/get}}

            {{!-- 4+5 · the latest writing (a sheet) and issue (an envelope) --}}
            <div class="hero-stack-row">
                {{#get "posts" filter="tag:hash-blog-col" limit="1" as |art|}}
                    {{#foreach art}}
                        <a class="hero-shot is-writing" href="{{url}}">
                            <span class="hero-sheet-lines" aria-hidden="true"><i></i><i></i><i></i></span>
                            <small>{{> "icons/pen"}} {{t "Writing"}}</small>
                            <strong>{{title}}</strong>
                        </a>
                    {{/foreach}}
                {{/get}}
                {{#get "posts" filter="tag:hash-newsletter-col" limit="1" as |iss|}}
                    {{#foreach iss}}
                        <a class="hero-shot is-mail" href="{{url}}">
                            <span class="hero-mail-flap" aria-hidden="true"></span>
                            <small>{{> "icons/mail"}} {{t "Latest issue"}}</small>
                            <strong>{{title}}</strong>
                        </a>
                    {{/foreach}}
                {{/get}}
            </div>

            {{!-- 6 · the latest changelog entry, as the shipped badge --}}
            {{#get "posts" filter="tag:[hash-changelog-col,hash-feed-col]" include="tags" limit="1" as |chg|}}
                {{#foreach chg}}
                    <a class="hero-shot is-ship" href="{{url}}">
                        {{> "changelog-badge"}}
                        <strong>{{title}}</strong>
                        {{> "icons/arrow-right"}}
                    </a>
                {{/foreach}}
            {{/get}}
        </div>

    </div>

    {{!-- Every collection, one inline strip --}}
    <div class="inner">
        <nav class="hero-collections" aria-label="{{t "Browse everything"}}">
            <a href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Courses"}}</a>
            <a href="{{@site.url}}/training/">{{> "icons/layers"}} {{t "Training"}}</a>
            <a href="{{@site.url}}/videos/">{{> "icons/video"}} {{t "Videos"}}</a>
            <a href="{{@site.url}}/blog/">{{> "icons/pen"}} {{t "Blog"}}</a>
            <a href="{{@site.url}}/newsletter/">{{> "icons/newspaper"}} {{t "Newsletter"}}</a>
            <a href="{{@site.url}}/snippets/">{{> "icons/code"}} {{t "Snippets"}}</a>
            <a href="{{@site.url}}/prompts/">{{> "icons/sparkles"}} {{t "Prompts"}}</a>
            <a href="{{@site.url}}/resources/">{{> "icons/bookmark"}} {{t "Resources"}}</a>
            <a href="{{@site.url}}/shop/">{{> "icons/gift"}} {{t "Shop"}}</a>
            <a href="{{@site.url}}/changelog/">{{> "icons/history"}} {{t "Changelog"}}</a>
        </nav>

        {{> "hero-stats"}}
    </div>
</section>
