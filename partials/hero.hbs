{{!-- THE hero — Swarnil's story, told by the site itself.

Identity comes straight from Ghost: the headline is @site.title,
the sub is @site.description, and when a publication cover is
set (Admin → Design → Publication cover) it becomes the hero's
background — masked and faded so the copy always wins.

Right: ONE square — the publication's own mark, and the film
behind it. The card sits at 1:1 until it is pressed, then morphs
to 16:9 and plays the intro; closing it returns the square. It
replaced a five-screen lo-fi collage: the collage said "look how
much this site makes", which the .hero-collections strip below
already says better, and it said it with five fake windows.
Everything the site makes still lives one row down in
.hero-collections — the hero itself stays quiet. --}}

<section class="home-hero outer relative">
    {{!-- The backdrop is a PATTERN, not a photo: the crosshair
    blueprint (.home-hero-pattern) — an SVG tile used as a mask
    over a solid colour, so it recolours with the theme. --}}
    <div class="home-hero-pattern" aria-hidden="true"></div>

    <div class="orb" style="width: 420px; height: 420px; top: -120px; left: -140px;" aria-hidden="true"></div>
    <div class="orb" style="width: 360px; height: 360px; bottom: -80px; right: -100px; animation-delay: -4s;" aria-hidden="true"></div>

    <div class="home-hero-grid inner">

        <div class="home-hero-copy">

            {{#get "authors" limit="1" as |host|}}
                {{#foreach host}}
                    <a class="home-hero-badge is-host" href="{{url}}">
                        {{#if profile_image}}
                            <img src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                        {{else}}
                            {{> "icons/avatar"}}
                        {{/if}}
                        {{name}} &middot; {{t "learning in public"}}
                    </a>
                {{/foreach}}
            {{/get}}

            <h1>{{@site.title}}</h1>
            <svg class="hero-flourish" viewBox="0 0 220 12" aria-hidden="true"><path d="M3 9 C 45 3, 85 11, 125 6 S 195 3, 217 7"/></svg>
            <p class="home-hero-sub">{{#if @site.description}}{{@site.description}}{{else}}{{t "Namaste! I'm seven-plus years into IT, and this site is my rule made public: build the thing first, then share exactly how."}}{{/if}}</p>

            {{!-- The ask — compact --}}
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <form class="signup-form hero-signup is-compact" data-members-form="signup">
                        <div class="signup-row">
                            <input class="signup-input" data-members-email type="email" required
                                placeholder="{{t "you@work-email.com"}}" aria-label="{{t "Your email"}}" />
                            <button class="btn signup-btn" type="submit">
                                {{> "icons/mail"}} {{t "Follow along"}}
                            </button>
                        </div>
                        <p class="signup-note">{{t "Free forever · one email a week · unsubscribe in one click"}}</p>
                        <p class="signup-success">{{> "icons/check-circle"}} {{t "Almost in! Check your inbox and click the magic link."}}</p>
                        <p class="signup-error" data-members-error></p>
                    </form>
                {{else}}
                    <div class="home-hero-actions">
                        <a class="btn btn-lg" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Continue learning"}}</a>
                    </div>
                {{/unless}}
            {{else}}
                <div class="home-hero-actions">
                    <a class="btn btn-lg" href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Browse courses"}}</a>
                </div>
            {{/if}}

            {{!-- Crowd proof + freshness --}}
            <div class="hero-proof">
                <span class="proof-stack" aria-hidden="true">
                    {{#get "authors" limit="4" as |folks|}}
                        {{#foreach folks}}
                            {{#if profile_image}}
                                <img class="p-avatar" src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                            {{/if}}
                        {{/foreach}}
                    {{/get}}
                    <span class="p-avatar p-mono" style="--h: 210;">A</span>
                    <span class="p-avatar p-mono" style="--h: 152;">R</span>
                    <span class="p-avatar p-mono" style="--h: 264;">M</span>
                    <span class="p-avatar p-mono" style="--h: 24;">K</span>
                </span>
                <span class="hero-proof-text">
                    <strong>{{t "20+ learners"}}</strong> {{t "building along in real orgs"}}
                </span>
            </div>

            {{#get "posts" filter="tag:hash-changelog" limit="1" as |shipped|}}
                {{#if shipped}}
                    <a class="home-shipped" href="{{shipped.[0].url}}">
                        <span class="home-shipped-ping" aria-hidden="true"></span>
                        <strong>{{t "Just shipped"}}</strong>
                        <span class="home-shipped-title">{{shipped.[0].title}}</span>
                        {{> "icons/arrow-right"}}
                    </a>
                {{/if}}
            {{/get}}
        </div>

        {{!-- Right: the publication cover, and the film behind it.

        The card rests at 1:1 showing the publication cover (Admin →
        Design → Publication cover) under a brand scrim. ONE toggle
        straddles its bottom edge: press it and the card morphs to
        16:9 and mounts the YouTube embed, press it again and the
        cover returns. The toggle floats OUTSIDE the frame on
        purpose — inside, it landed on YouTube's own controls.

        NOTHING is requested from YouTube until that first press, so
        a visitor who never plays the film meets no third-party
        frame, script or cookie. See assets/js/hero-video.js.

        The chips floating around the card are the publication's own
        most-used tags, not decoration invented here — they grow and
        change with the site instead of going stale.

        The film's address comes from Admin → Design → Site-wide →
        "Hero video". Empty, the card is simply the cover. --}}
        <div class="hero-feature">
            <div class="hero-feature-card{{#if @custom.hero_video}} has-video{{/if}}"
                {{#if @custom.hero_video}}data-hero-video="{{@custom.hero_video}}"{{/if}}>

                <div class="hero-feature-poster">
                    {{#if @site.cover_image}}
                        <img class="hero-feature-cover" src="{{img_url @site.cover_image size="l"}}" alt="" fetchpriority="high" />
                    {{else}}
                        {{!-- No cover set: the brand square stands in, so the
                        hero never renders as an empty grey box. --}}
                        <span class="hero-feature-grid" aria-hidden="true"></span>
                        <span class="hero-feature-mark">
                            {{#if @site.icon}}
                                <img src="{{img_url @site.icon size="m"}}" alt="" fetchpriority="high" />
                            {{else}}
                                <img src="{{asset "images/ns-mark.svg"}}" alt="" fetchpriority="high" />
                            {{/if}}
                        </span>
                    {{/if}}

                    <span class="hero-feature-scrim" aria-hidden="true"></span>

                    <span class="hero-feature-meta">
                        <b class="hero-feature-title">{{@site.title}}</b>
                    </span>
                </div>

                {{#if @custom.hero_video}}
                    {{!-- The embed lands here on press and is torn out again
                    on close, so a closed card holds no frame. --}}
                    <div class="hero-feature-stage" data-hero-stage></div>

                    {{!-- One control, two states — pressing it plays, pressing
                    it again brings the cover back. --}}
                    <button class="hero-feature-toggle" type="button"
                        data-hero-toggle
                        aria-expanded="false">
                        <span class="hero-feature-disc" aria-hidden="true">
                            <svg class="i-play" viewBox="0 0 24 24"><path d="M9 7.5v9l7.5-4.5z" fill="currentColor"/></svg>
                            <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
                        </span>
                        <span class="hero-feature-toggle-label">
                            <span class="on-idle">{{t "Watch the intro"}}</span>
                            <span class="on-playing">{{t "Close"}}</span>
                        </span>
                    </button>
                {{/if}}
            </div>

            {{!-- Floating chips. Typed ones win (Admin → Design →
            Site-wide → "Hero chips"); empty falls back to the AI-era
            defaults in assets/js/hero-video.js, which is also where
            the labels are cut up and matched to icons — Handlebars
            has no split, and a chip's icon is chosen from its word.

            The publication's tags were the obvious source and the
            wrong one: ordered by post count they read "Apex, Admin,
            DevOps, Flow, Apex Triggers" — a sentence-length admin
            vocabulary, not what the site is about now.

            Decorative, hence aria-hidden: the same words are real
            links in the quick-links strip below. --}}
            {{#if @custom.hero_chips}}
                <ul class="hero-feature-chips" data-hero-chips="{{@custom.hero_chips}}" aria-hidden="true"></ul>
            {{else}}
                <ul class="hero-feature-chips" data-hero-chips aria-hidden="true"></ul>
            {{/if}}

            {{!-- Social rail on the card's left edge. Ghost's own
            accounts (Admin → Settings → Social accounts) plus the
            theme's own link settings; each renders only when set, and
            the rail disappears entirely when none are. --}}
            <ul class="hero-feature-social">
                {{#if @site.twitter}}
                    <li><a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">{{> "icons/x"}}</a></li>
                {{/if}}
                {{#if @site.facebook}}
                    <li><a href="{{social_url type="facebook"}}" target="_blank" rel="noopener" aria-label="Facebook">{{> "icons/facebook"}}</a></li>
                {{/if}}
                {{#if @custom.social_youtube}}
                    <li><a href="{{@custom.social_youtube}}" target="_blank" rel="noopener" aria-label="YouTube">{{> "icons/youtube"}}</a></li>
                {{/if}}
                {{#if @custom.social_linkedin}}
                    <li><a href="{{@custom.social_linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a></li>
                {{/if}}
                {{#if @custom.social_github}}
                    <li><a href="{{@custom.social_github}}" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a></li>
                {{/if}}
                {{#if @custom.social_instagram}}
                    <li><a href="{{@custom.social_instagram}}" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a></li>
                {{/if}}
            </ul>
        </div>

    </div>

</section>

{{!-- Everything the site makes, as a bento.

Sizes carry the hierarchy: the two things you are meant to start
with take double-width tiles, the rest are equal singles. Each tile
hides an oversized icon half-off its bottom-right corner — on hover
it rises INTO the tile rather than appearing from nothing, which is
what makes the movement read as one object instead of a flicker. --}}
<section class="quicklinks outer">
    <div class="inner">
        <div class="ql-head">
            <span class="kicker">{{> "icons/layers"}} {{t "Everything here"}}</span>
            <h2>{{t "Pick a way in"}}</h2>
        </div>

        <nav class="ql-grid" aria-label="{{t "Browse everything"}}">
            <a class="ql-tile is-wide" href="{{@site.url}}/courses/">
                <span class="ql-name">{{t "Courses"}}</span>
                <span class="ql-note">{{t "Structured, lesson by lesson"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/graduation-cap"}}</span>
            </a>
            <a class="ql-tile is-wide" href="{{@site.url}}/training/">
                <span class="ql-name">{{t "Training"}}</span>
                <span class="ql-note">{{t "Modular paths you can follow live"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/layers"}}</span>
            </a>

            <a class="ql-tile" href="{{@site.url}}/videos/">
                <span class="ql-name">{{t "Videos"}}</span>
                <span class="ql-note">{{t "Watch it get built"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/video"}}</span>
            </a>
            <a class="ql-tile" href="{{@site.url}}/slides/">
                <span class="ql-name">{{t "Slides"}}</span>
                <span class="ql-note">{{t "Decks to skim"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/presentation"}}</span>
            </a>
            <a class="ql-tile" href="{{@site.url}}/blog/">
                <span class="ql-name">{{t "Blog"}}</span>
                <span class="ql-note">{{t "Notes from the work"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/pen"}}</span>
            </a>
            <a class="ql-tile" href="{{@site.url}}/newsletter/">
                <span class="ql-name">{{t "Newsletter"}}</span>
                <span class="ql-note">{{t "One email a week"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/newspaper"}}</span>
            </a>

            <a class="ql-tile" href="{{@site.url}}/snippets/">
                <span class="ql-name">{{t "Snippets"}}</span>
                <span class="ql-note">{{t "Apex, LWC, Flow"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/code"}}</span>
            </a>
            <a class="ql-tile" href="{{@site.url}}/prompts/">
                <span class="ql-name">{{t "Prompts"}}</span>
                <span class="ql-note">{{t "AI that earns its place"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/sparkles"}}</span>
            </a>
            <a class="ql-tile" href="{{@site.url}}/resources/">
                <span class="ql-name">{{t "Resources"}}</span>
                <span class="ql-note">{{t "Links worth keeping"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/bookmark"}}</span>
            </a>
            <a class="ql-tile" href="{{@site.url}}/projects/">
                <span class="ql-name">{{t "Projects"}}</span>
                <span class="ql-note">{{t "Build logs, in the open"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/github"}}</span>
            </a>

            <a class="ql-tile is-wide" href="{{@site.url}}/shop/">
                <span class="ql-name">{{t "Shop"}}</span>
                <span class="ql-note">{{t "Paid material, when you want to go deeper"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/gift"}}</span>
            </a>
            <a class="ql-tile is-wide" href="{{@site.url}}/changelog/">
                <span class="ql-name">{{t "Changelog"}}</span>
                <span class="ql-note">{{t "What shipped, and when"}}</span>
                <span class="ql-mark" aria-hidden="true">{{> "icons/history"}}</span>
            </a>
        </nav>
    </div>
</section>
