<footer class="footer has-background-black-ter has-text-grey-light pb-6 pt-6">
  <div class="container">
    <div class="columns is-multiline">
      
      <div class="column is-12-mobile is-6-tablet is-4-desktop pr-6-desktop">
        <h3 class="title is-4 has-text-white mb-4">Namaste Salesforce</h3>
        <p class="is-size-6 mb-4 has-text-grey-light">
          An open-source Learning Management System dedicated to mastering the Salesforce ecosystem. Empowering developers to learn and build together.
        </p>
        <p class="is-size-7">
          Built with 💻 by <a href="https://www.iamswarnil.com" class="has-text-primary has-text-weight-bold" target="_blank" rel="noopener">Swarnil</a>.
        </p>
      </div>

      <div class="column is-12-mobile is-6-tablet is-2-desktop">
        <h4 class="title is-6 has-text-white is-uppercase has-text-weight-semibold tracking-wide mb-4">{{t "Navigation"}}</h4>
        <div class="content is-small">
          {{navigation}}
        </div>
      </div>

      <div class="column is-12-mobile is-6-tablet is-2-desktop">
        <h4 class="title is-6 has-text-white is-uppercase has-text-weight-semibold tracking-wide mb-4">{{t "Connect"}}</h4>
        <div class="content is-small">
          {{> social-media}}
        </div>
      </div>

      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <h4 class="title is-6 has-text-white is-uppercase has-text-weight-semibold tracking-wide mb-4">{{t "Stay Updated"}}</h4>
        <p class="is-size-7 mb-4 has-text-grey-light">{{t "Get the latest Salesforce tutorials and platform updates delivered directly to your inbox." }}</p>
        
        <form data-members-form="subscribe">
          <div class="field">
            <div class="control is-expanded mb-3">
              <input class="input has-background-dark has-text-white has-text-centered-mobile" style="border-color: #363636;" aria-labelledby="footer-subscribe" data-members-email type="email" placeholder="Your email address" required/>
            </div>
            <div class="control">
              <button class="button is-primary is-fullwidth has-text-weight-bold" type="submit" title="{{t "Subscribe"}}" aria-label="{{t "Subscribe"}}">
                {{t "Subscribe"}}
              </button>
            </div>
          </div>
        </form>
      </div>
      
    </div>

    <div class="column is-12 px-0">
      <hr class="has-background-grey-darker my-5">
      <div class="level is-size-7 mt-5">
        <div class="level-left">
          <div class="level-item has-text-centered-mobile">
            <p>&copy; {{date format="YYYY"}} <a href="{{@site.url}}" class="has-text-white has-text-weight-bold">{{@site.title}}</a>. All rights reserved.</p>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item has-text-centered-mobile mt-3-mobile">
            <p>Published with <a href="https://ghost.org" class="has-text-grey hover-text-white">Ghost</a> & <a href="https://bulma.io/" class="has-text-grey hover-text-white">Bulma</a></p>
          </div>
        </div>
      </div>
    </div>

  </div>
</footer>