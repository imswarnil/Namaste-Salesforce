{{!-- =========================================================================
  footer.hbs · Namaste Salesforce Ghost Theme

  Structure (Bulma-driven):
    ① Accent strip  — 3px brand top-border + tagline
    ② Main body     — .columns.is-multiline with 4 .column children
        Col 1  Brand       : logo · tagline · social · cert badges
        Col 2  Explore     : secondary nav links
        Col 3  Popular Tags: Ghost {{get}} tags cloud with post counts
        Col 4  Subscribe   : newsletter CTA
    ③ Bottom bar    — .level: copyright left · open-source credit right
========================================================================== --}}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{@site.url}}/#organization",
  "name": "{{@site.title}}",
  "url": "{{@site.url}}/",
  {{#if @site.description}}"description": "{{@site.description}}",{{/if}}
  {{#if @site.logo}}
  "logo": { "@type": "ImageObject", "url": "{{@site.logo}}" },
  {{/if}}
  "founder": { "@type": "Person", "name": "Swarnil", "url": "https://imswarnil.com/about" },
  "sameAs": [
    "https://twitter.com/imswarnil",
    "https://github.com/imswarnil",
    "https://linkedin.com/in/imswarnil",
    "https://youtube.com/@imswarnil"
  ]
}
</script>

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
  {{!-- ════════════════════════════════════════════════════════════════
    ② MAIN BODY  — Bulma .columns grid
  ════════════════════════════════════════════════════════════════════ --}}
  <div class="site-footer__main">
    <div class="container">

      <div class="columns is-multiline is-variable is-5">

        {{!-- ── Col 1 · Brand (3/12 desktop, 6/12 tablet, full mobile) ── --}}
        <div class="column is-3-desktop is-6-tablet is-12-mobile site-footer__col">

          <a class="site-footer__brand" href="{{@site.url}}" aria-label="{{@site.title}} homepage">
            {{#if @site.logo}}
              <img src="{{@site.logo}}" alt="{{@site.title}}"
                   class="site-footer__logo" width="38" height="38" loading="lazy">
            {{/if}}
            <span class="site-footer__brand-name">{{@site.title}}</span>
          </a>

          {{#if @site.description}}
            <p class="site-footer__tagline">{{@site.description}}</p>
          {{/if}}

          {{!-- Social --}}
          <div class="buttons site-footer__social" aria-label="Social links">
            <a class="button is-small is-light site-footer__social-btn"
               href="https://twitter.com/imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
              <span class="icon is-small"><i class="ph ph-x-logo"></i></span>
            </a>
            <a class="button is-small is-light site-footer__social-btn"
               href="https://github.com/imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <span class="icon is-small"><i class="ph ph-github-logo"></i></span>
            </a>
            <a class="button is-small is-light site-footer__social-btn"
               href="https://linkedin.com/in/imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <span class="icon is-small"><i class="ph ph-linkedin-logo"></i></span>
            </a>
            <a class="button is-small is-light site-footer__social-btn"
               href="https://youtube.com/@imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <span class="icon is-small"><i class="ph ph-youtube-logo"></i></span>
            </a>
          </div>

          {{!-- Cert badges using Bulma .tags --}}
          <div class="tags site-footer__certs" aria-label="Salesforce certifications">
            <span class="tag is-primary is-light is-small">
              <span class="icon is-small"><i class="ph ph-certificate"></i></span>
              <span>Admin</span>
            </span>
            <span class="tag is-primary is-light is-small">
              <span class="icon is-small"><i class="ph ph-certificate"></i></span>
              <span>Developer</span>
            </span>
            <span class="tag is-primary is-light is-small">
              <span class="icon is-small"><i class="ph ph-certificate"></i></span>
              <span>Architect</span>
            </span>
          </div>

        </div>
        {{!-- /col-brand --}}

        {{!-- ── Col 2 · Explore — secondary nav (2/12 desktop, 6/12 tablet) ── --}}
        <div class="column is-2-desktop is-6-tablet is-12-mobile site-footer__col">
          <p class="site-footer__col-heading">Explore</p>
          <nav aria-label="Explore navigation">
            {{#foreach navigation type="secondary"}}
              <a class="site-footer__nav-link"
                 href="{{url absolute="true"}}"
                 {{#if current}}aria-current="page"{{/if}}>
                <span class="icon is-small"><i class="ph ph-caret-right"></i></span>
                <span>{{label}}</span>
              </a>
            {{/foreach}}
            {{!-- Fallbacks --}}
          </nav>
        </div>
        {{!-- /col-explore --}}

        {{!-- ── Col 3 · Popular Tags cloud (4/12 desktop, 6/12 tablet) ── --}}
        <div class="column is-4-desktop is-6-tablet is-12-mobile site-footer__col">
          <p class="site-footer__col-heading">Popular Topics</p>

          <div class="site-footer__tag-cloud" aria-label="Popular topics">
            {{#get "tags" limit="16" order="count.posts desc" include="count.posts"}}
              {{#foreach tags}}
                <a
                  class="tag site-footer__tag{{#if @first}} is-medium{{/if}}"
                  href="{{url}}"
                  aria-label="{{name}} — {{count.posts}} posts"
                >
                  {{name}}
                  <span class="site-footer__tag-count">{{count.posts}}</span>
                </a>
              {{/foreach}}
            {{/get}}
          </div>

        </div>
        {{!-- /col-tags --}}

        {{!-- ── Col 4 · Subscribe (3/12 desktop, 6/12 tablet) ── --}}
        <div class="column is-3-desktop is-6-tablet is-12-mobile site-footer__col">
          <p class="site-footer__col-heading">Stay Updated</p>
          <p class="site-footer__subscribe-copy">
            Salesforce tips, exam prep &amp; tutorials — delivered before your coffee gets cold.
          </p>

          {{#if @site.members_enabled}}
            {{#unless @member}}
              {{#unless @site.members_invite_only}}
                <a class="button is-primary is-fullwidth site-footer__cta"
                   href="#/portal/signup" data-portal="signup">
                  <span class="icon"><i class="ph ph-envelope-simple"></i></span>
                  <span>Subscribe free</span>
                </a>
                <a class="site-footer__secondary-link" href="#/portal/signin" data-portal="signin">
                  Already a member? Sign in →
                </a>
              {{else}}
                <a class="button is-primary is-fullwidth site-footer__cta"
                   href="#/portal/signin" data-portal="signin">
                  <span class="icon"><i class="ph ph-sign-in"></i></span>
                  <span>Sign in</span>
                </a>
              {{/unless}}
            {{else}}
              <a class="button is-light is-fullwidth site-footer__cta"
                 href="#/portal/account" data-portal="account">
                <span class="icon"><i class="ph ph-user-circle"></i></span>
                <span>My Account</span>
              </a>
            {{/unless}}
          {{else}}
            <a class="button is-primary is-fullwidth site-footer__cta"
               href="https://github.com/imswarnil/Namaste-Salesforce"
               target="_blank" rel="noopener noreferrer">
              <span class="icon"><i class="ph ph-github-logo"></i></span>
              <span>Star on GitHub</span>
            </a>
          {{/if}}

        </div>
        {{!-- /col-subscribe --}}

      </div>
      {{!-- /columns --}}

    </div>
  </div>
  {{!-- /footer-main --}}

  {{!-- ════════════════════════════════════════════════════════════════
    ③ BOTTOM BAR  — Bulma .level
  ════════════════════════════════════════════════════════════════════ --}}
  <div class="site-footer__bottom">
    <div class="container">
      <div class="level site-footer__bottom-level">

        {{!-- Left: copyright --}}
        <div class="level-left">
          <div class="level-item">
            <p class="site-footer__copyright">
              &copy; {{date format="YYYY"}}
              <a class="site-footer__inline-link" href="{{@site.url}}">{{@site.title}}</a>.
              All rights reserved.
            </p>
          </div>
        </div>

        {{!-- Right: open source credit + back to top --}}
        <div class="level-right">
          <div class="level-item">
            <p class="site-footer__credit">
              Proudly open source &middot; Built on
              <a class="site-footer__inline-link"
                 href="https://ghost.org" target="_blank" rel="noopener noreferrer">Ghost</a>
              with
              <a class="site-footer__inline-link"
                 href="https://bulma.io" target="_blank" rel="noopener noreferrer">Bulma</a>
              &amp; hazelnut cold coffee ☕ by
              <a class="site-footer__inline-link site-footer__credit-author"
                 href="https://imswarnil.com/about"
                 target="_blank" rel="noopener noreferrer"
                 title="Still cold. Somehow.">Swarnil</a>
            </p>
          </div>
          <div class="level-item">
            <button class="button is-small is-light site-footer__back-top"
                    type="button"
                    aria-label="Back to top"
                    onclick="window.scrollTo({top:0,behavior:'smooth'})">
              <span class="icon is-small"><i class="ph ph-arrow-up"></i></span>
              <span>Top</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
  {{!-- /bottom bar --}}

</footer>
