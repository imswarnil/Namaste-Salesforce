{{!-- ════════════════════════════════════════════════════════════════════════
  partials/footer.hbs — the site footer.

  THE DESIGN SYSTEM'S `.ns-footer` (ds/components/css/sections.css): an
  auto-fitting column grid over a legal bar. The theme used to hand-roll this
  out of Tailwind utilities — four columns, a `md:grid-cols-2 lg:grid-cols-4`
  guess, and its own social row — which is the same object the system already
  ships, drawn slightly differently on every breakpoint.

  Columns come from Ghost where possible: the "Explore" column is the
  SECONDARY navigation (Admin → Settings → Navigation), so the footer can be
  re-pointed without touching the theme.
═══════════════════════════════════════════════════════════════════════════ --}}
<footer class="ns-footer">
  <div class="ns-footer__grid">

    {{!-- Brand column — the mark, one sentence, and the social row --}}
    <div class="ns-footer__col">
      <a href="{{@site.url}}" class="ns-topnav__brand">
        {{#if @site.logo}}<img src="{{img_url @site.logo size="xs"}}" alt="" width="32" height="32" loading="lazy" decoding="async">{{/if}}
        <span class="ns-topnav__brand-name">{{@site.title}}</span>
      </a>
      <p class="ns-footer__blurb">
        {{#if @site.description}}{{@site.description}}{{else}}{{t "Open-source Salesforce learning — courses, documentation and hands-on tutorials."}}{{/if}}
      </p>
      {{> "components/social-icons"}}
    </div>

    {{!-- Explore — Ghost's secondary navigation --}}
    <nav class="ns-footer__col" aria-label="{{t "Footer"}}">
      <p class="ns-footer__head">{{t "Explore"}}</p>
      <ul>{{navigation type="secondary"}}</ul>
    </nav>

    {{!-- Project --}}
    <div class="ns-footer__col">
      <p class="ns-footer__head">{{t "Project"}}</p>
      <ul>
        <li><a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener">{{t "Star on GitHub"}}</a></li>
        <li><a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener">{{t "Become a sponsor"}}</a></li>
        <li><a href="{{#if @custom.become_author_url}}{{@custom.become_author_url}}{{else}}/become-author/{{/if}}">{{t "Become an author"}}</a></li>
        <li><a href="/contact/">{{t "Contact"}}</a></li>
      </ul>
    </div>

    {{!-- The newsletter ask, answered in place rather than at the cost of a
         page transition. One signup form in the theme — members/subscribe. --}}
    {{#if @site.members_enabled}}
      <div class="ns-footer__col">
        <p class="ns-footer__head">{{t "Stay in the loop"}}</p>
        <p class="ns-footer__blurb">{{t "Free Salesforce tips & new lessons in your inbox."}}</p>
        {{> "members/subscribe" layout="stacked" icon="mail"}}
      </div>
    {{/if}}
  </div>

  <div class="ns-footer__bar">
    <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
    <span class="ns-footer__spacer"></span>
    <a href="/privacy/">{{t "Privacy"}}</a>
    <a href="/terms/">{{t "Terms"}}</a>
    <a href="https://ghost.org" target="_blank" rel="noopener">{{t "Built with Ghost"}}</a>
  </div>
</footer>
