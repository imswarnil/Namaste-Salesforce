{{!-- Footer: brand + tagline, the two Ghost navigations as link
columns, social row, legal line. Always dark navy — the one
surface that doesn't flip with the theme.

READER FRAMES GET A STRIP INSTEAD. The lesson player and the
training reader run a fixed full-height rail down one side; a
nine-column navy slab underneath it reads as a second website, and
the rail would sit beside it looking stranded. Those pages get one
quiet line instead, inset past the rail (see .site-foot-strip in
2-layout/_footer.css). Matched on the post's collection tag, the
same way post.hbs dispatches layouts — this partial renders from
default.hbs, where `post` is in scope. --}}

{{#match (post_class) "~" "tag-hash-lesson"}}
    {{> "footer-strip"}}
{{else match (post_class) "~" "tag-hash-training"}}
    {{> "footer-strip"}}
{{else match (post_class) "~" "tag-hash-module"}}
    {{> "footer-strip"}}
{{else}}

<footer class="site-foot outer relative">
    <div class="bg-blueprint bg-fade-bottom" aria-hidden="true"></div>
    <div class="site-foot-inner inner">

        {{!-- Top row: who this is, and the one ask. The form is Ghost's
        native members form (it stamps loading / success / error on the
        <form>), the same markup the hero uses, dressed for navy. --}}
        <div class="site-foot-top">
            <div class="site-foot-brand">
                <a class="site-head-logo" href="{{@site.url}}">
                    {{#if @site.logo}}
                        {{#if @custom.dark_logo}}
                            <img class="logo-dark" src="{{@custom.dark_logo}}" alt="{{@site.title}}" />
                        {{else}}
                            <img class="logo-invertible" src="{{@site.logo}}" alt="{{@site.title}}" />
                        {{/if}}
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </a>
                <p class="site-foot-tagline">
                    {{#if @custom.footer_tagline}}{{@custom.footer_tagline}}{{else}}{{@site.description}}{{/if}}
                </p>
                <div class="site-foot-social">
                    {{#social_accounts @site}}
                        <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                            {{#match type "facebook"}}{{> "icons/facebook"}}{{else match type "twitter"}}{{> "icons/x"}}{{else match type "threads"}}{{> "icons/threads"}}{{else match type "bluesky"}}{{> "icons/bluesky"}}{{else match type "mastodon"}}{{> "icons/mastodon"}}{{else match type "tiktok"}}{{> "icons/tiktok"}}{{else match type "youtube"}}{{> "icons/youtube"}}{{else match type "instagram"}}{{> "icons/instagram"}}{{else match type "linkedin"}}{{> "icons/linkedin"}}{{else}}<span>{{name}}</span>{{/match}}
                        </a>
                    {{/social_accounts}}
                    {{#if @custom.social_youtube}}
                        <a href="{{@custom.social_youtube}}" target="_blank" rel="noopener" aria-label="YouTube">{{> "icons/youtube"}}</a>
                    {{/if}}
                    {{#if @custom.social_linkedin}}
                        <a href="{{@custom.social_linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a>
                    {{/if}}
                    {{#if @custom.social_github}}
                        <a href="{{@custom.social_github}}" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a>
                    {{/if}}
                    {{#if @custom.social_instagram}}
                        <a href="{{@custom.social_instagram}}" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a>
                    {{/if}}
                    <a href="{{@site.url}}/rss/" target="_blank" rel="noopener" aria-label="RSS">
                        {{> "icons/rss"}}
                    </a>
                </div>
            </div>

            <div class="site-foot-ask">
                <span class="kicker">{{> "icons/mail"}} {{t "The weekly letter"}}</span>
                <h3>{{t "Follow the trail, one email a week"}}</h3>
                <p>{{t "New lessons, the GTM tools I'm learning, and the release notes that matter — written as I go."}}</p>
                {{#if @site.members_enabled}}
                    {{#unless @member}}
                        <form class="signup-form foot-signup" data-members-form="signup">
                            <div class="signup-row">
                                <input class="signup-input" data-members-email type="email" required
                                    placeholder="{{t "you@work-email.com"}}" aria-label="{{t "Your email"}}" />
                                <button class="btn signup-btn" type="submit">
                                    {{> "icons/mail"}} {{t "Join free"}}
                                </button>
                            </div>
                            <p class="signup-note">{{t "Free forever · unsubscribe in one click"}}</p>
                            <p class="signup-success">{{> "icons/check-circle"}} {{t "Almost in! Check your inbox and click the magic link."}}</p>
                            <p class="signup-error" data-members-error></p>
                        </form>
                    {{else}}
                        <p class="members-note">{{> "icons/check-circle"}} {{t "You're on the list — the next issue is coming to you."}}</p>
                    {{/unless}}
                {{else}}
                    <a class="btn" href="{{@site.url}}/newsletter/">{{> "icons/mail"}} {{t "Browse the issues"}}</a>
                {{/if}}
            </div>
        </div>

        {{!-- Link columns. Learn / Read / Build are the collections
        from routes.yaml — fixed on purpose, that is the URL model.
        The fourth column is Ghost's secondary navigation (Admin →
        Settings → Navigation), so the pages the owner lists there
        appear without a template edit. Icons match per slug in
        partials/nav-icon.hbs. --}}
        <div class="site-foot-grid">

            <nav class="site-foot-nav" aria-label="{{t "Learn"}}">
                <h4>{{> "icons/graduation-cap"}} {{t "Learn"}}</h4>
                <ul>
                    <li><a href="{{@site.url}}/courses/">{{> "nav-icon" slug="courses"}} {{t "Courses"}}</a></li>
                    <li><a href="{{@site.url}}/training/">{{> "nav-icon" slug="training"}} {{t "Training trail"}}</a></li>
                    <li><a href="{{@site.url}}/videos/">{{> "nav-icon" slug="videos"}} {{t "Videos"}}</a></li>
                    <li><a href="{{@site.url}}/slides/">{{> "nav-icon" slug="slides"}} {{t "Slides"}}</a></li>
                    <li><a href="{{@site.url}}/resources/">{{> "nav-icon" slug="resources"}} {{t "Resources"}}</a></li>
                </ul>
            </nav>

            <nav class="site-foot-nav" aria-label="{{t "Read"}}">
                <h4>{{> "icons/pen"}} {{t "Read"}}</h4>
                <ul>
                    <li><a href="{{@site.url}}/blog/">{{> "nav-icon" slug="blog"}} {{t "Blog"}}</a></li>
                    <li><a href="{{@site.url}}/newsletter/">{{> "nav-icon" slug="newsletter"}} {{t "Newsletter"}}</a></li>
                    <li><a href="{{@site.url}}/changelog/">{{> "nav-icon" slug="changelog"}} {{t "Changelog"}}</a></li>
                    <li><a href="{{@site.url}}/snippets/">{{> "nav-icon" slug="snippets"}} {{t "Snippets"}}</a></li>
                    <li><a href="{{@site.url}}/prompts/">{{> "nav-icon" slug="prompts"}} {{t "Prompts"}}</a></li>
                </ul>
            </nav>

            <nav class="site-foot-nav" aria-label="{{t "Build"}}">
                <h4>{{> "icons/code"}} {{t "Build"}}</h4>
                <ul>
                    <li><a href="{{@site.url}}/projects/">{{> "nav-icon" slug="projects"}} {{t "Projects"}}</a></li>
                    <li><a href="{{@site.url}}/products-i-use/">{{> "nav-icon" slug="products-i-use"}} {{t "Products I use"}}</a></li>
                    <li><a href="{{@site.url}}/shop/">{{> "nav-icon" slug="shop"}} {{t "Shop"}}</a></li>
                    <li><a href="{{@site.url}}/llms/">{{> "icons/file-text"}} llms.txt</a></li>
                    {{#if @custom.social_github}}
                        <li><a href="{{@custom.social_github}}" target="_blank" rel="noopener">{{> "icons/github"}} {{t "Source on GitHub"}}</a></li>
                    {{/if}}
                </ul>
            </nav>

            <nav class="site-foot-nav" aria-label="{{t "Site"}}">
                <h4>{{> "icons/compass"}} {{t "Site"}}</h4>
                {{navigation type="secondary" isFooter=true}}
            </nav>

        </div>

        <div class="site-foot-legal">
            <span>&copy; {{date format="YYYY"}} <a href="{{@site.url}}">{{@site.title}}</a>. {{t "All rights reserved."}}</span>
            <span class="site-foot-legal-right">
                <span>{{t "Built in the open, in a real org."}}</span>
                <a href="https://ghost.org/" target="_blank" rel="noopener">{{t "Powered by Ghost"}}</a>
                <a class="site-foot-top-link" href="#top">{{t "Back to top"}} {{> "icons/chevron-down"}}</a>
            </span>
        </div>

    </div>
</footer>

{{/match}}
