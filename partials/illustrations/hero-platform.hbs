{{!-- What Namaste Salesforce IS, as one drawing: the Salesforce
cloud up in its tile, a dashed learning trail climbing to it
through lesson stops (video, reading, code), a zap of automation,
and the rocket that leaves at the end. Same visual grammar as
the generated thumbnails: glow, dashed ring, dot grid, rounded
tiles, one stroke weight. Colours ride CSS vars so the drawing
follows light/dark mode. --}}
<svg class="hero-il" viewBox="0 0 520 440" fill="none" role="img" aria-label="{{t "From first login to deployed — the Namaste Salesforce learning path"}}">

    {{!-- ground: glow, ring, dots --}}
    <circle cx="290" cy="200" r="185" fill="var(--accent-soft)" opacity="0.55"/>
    <circle cx="290" cy="200" r="148" class="il-faint" stroke-dasharray="2 12"/>
    <circle cx="86" cy="84" r="34" class="il-faint"/>
    <circle cx="452" cy="332" r="9" fill="var(--accent)" opacity="0.45" stroke="none"/>
    <g fill="var(--text-faint)" opacity="0.4" stroke="none">
        <circle cx="424" cy="392" r="3"/><circle cx="452" cy="392" r="3"/><circle cx="480" cy="392" r="3"/>
        <circle cx="424" cy="416" r="3"/><circle cx="452" cy="416" r="3"/><circle cx="480" cy="416" r="3"/>
    </g>

    {{!-- the trail: dashed under-path climbing through the stops --}}
    <path class="il-trail" d="M 56 402 C 140 410, 120 330, 196 314 S 300 290, 300 218 C 300 180, 350 160, 408 112"/>

    {{!-- the cloud tile: Salesforce itself --}}
    <rect x="222" y="64" width="140" height="140" rx="30" class="il-tile"/>
    <path class="il-accent" d="M322 152a17 17 0 0 0 3.4-33.6 22.6 22.6 0 0 0-44.1 6A14.3 14.3 0 0 0 285 152h37z" transform="translate(-10 -6)"/>

    {{!-- lesson stops: watch, read, code --}}
    <g transform="translate(36 382)">
        <circle r="24" class="il-node"/>
        <path class="il-accent" transform="translate(-12 -12)" d="M10 8.5v7l6-3.5z"/>
        <circle r="9.5" class="il-accent" transform="translate(0 0)"/>
    </g>
    <g transform="translate(196 314)">
        <circle r="24" class="il-node"/>
        <path class="il-accent" transform="translate(-12 -12) scale(1)" d="M12 6.5C10 4.8 7 4.5 4 5v13c3-.5 6-.2 8 1.5 2-1.7 5-2 8-1.5V5c-3-.5-6-.2-8 1.5v13"/>
    </g>
    <g transform="translate(300 218)">
        <circle r="24" class="il-node"/>
        <path class="il-accent" transform="translate(-12 -12)" d="m9 8-4 4 4 4M15 8l4 4-4 4"/>
    </g>

    {{!-- automation zap drifting near the tile --}}
    <g transform="translate(160 120)">
        <rect x="-20" y="-20" width="40" height="40" rx="10" class="il-node"/>
        <path class="il-accent" transform="translate(-12 -12) scale(0.85)" d="M13 3 5.4 13h5.2L11 21l7.6-10h-5.2L13 3z"/>
    </g>

    {{!-- and the rocket that leaves at the end --}}
    <g class="il-rocket" transform="translate(422 84)">
        <path class="il-strong" d="M0 -26c8 5 12 14 12 23l-5 15H-7l-5-15c0-9 4-18 12-23z"/>
        <circle cx="0" cy="-6" r="4.5" class="il-strong"/>
        <path class="il-strong" d="M-11 6l-6 10 9-2M11 6l6 10-9-2"/>
        <path class="il-accent" d="M0 14v9"/>
    </g>
</svg>
