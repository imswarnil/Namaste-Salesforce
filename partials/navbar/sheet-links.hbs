{{!-- ══════════════════════════════════════════════════════════════════════
     navbar/sheet-links — the same menu, flat and indented, for the sheet.
     ------------------------------------------------------------------------
     Rendered through partials/navigation.hbs.

     FLAT, NOT ACCORDIONS. The bar nests children in a dropdown; here they are
     indented under their parent and always visible. On a phone that is the
     better trade: no tap to discover what is inside, no second disclosure to
     keep in sync with the bar's, and no <details> left standing empty when a
     parent has no children. .ns-navsheet__sub supplies the indent.

     Same "-" convention and the same balanced-across-iterations structure as
     navbar/links.hbs — read the comment there first.
     ══════════════════════════════════════════════════════════════════════ --}}
{{~#foreach navigation}}
    {{~#match label "~^" "-"~}}
        <a class="ns-navsheet__link" href="{{url absolute="true"}}" {{#if current}}aria-current="page"{{/if}}>{{> "navbar/icon"}} {{> "navbar/label"}}</a>
    {{~else~}}
        {{~#unless @first}}</div>{{/unless~}}
        <a class="ns-navsheet__link" href="{{url absolute="true"}}" {{#if current}}aria-current="page"{{/if}}><span class="ns-navsheet__index">{{number}}</span> {{> "navbar/label"}} {{> "icons/caret-right"}}</a><div class="ns-navsheet__sub">
    {{~/match~}}
{{~/foreach~}}
{{~#if navigation}}</div>{{/if~}}
