{{!-- ══════════════════════════════════════════════════════════════════════
     navbar/actions — the right-hand cluster.
     ------------------------------------------------------------------------
     Order is deliberate and runs from least to most committing: find
     something, look at the source, change how it looks, then sign in, then
     subscribe. The burger is last because on the widths where it appears the
     others have already collapsed.
     ══════════════════════════════════════════════════════════════════════ --}}
<div class="ns-topnav__actions">
    {{> "navbar/search"}}
    {{> "navbar/github-star"}}
    {{> "navbar/theme-toggle"}}
    {{> "navbar/auth"}}
    {{> "navbar/burger"}}
</div>
