{{!-- ══════════════════════════════════════════════════════════════════════
     nav-sheet — the mobile menu. Ported from NSDS's navbar archetype.
     ------------------------------------------------------------------------
     A <dialog>, so focus trapping, Esc and the inert background come from the
     platform rather than from us. nav.js only calls showModal()/close().

     The items come from Ghost's {{navigation}} helper — see the warning at
     the top of partials/navigation.hbs. The markup for them is in
     partials/navbar/sheet-links.hbs.
     ══════════════════════════════════════════════════════════════════════ --}}
<dialog class="ns-navsheet" id="site-nav" aria-label="{{t "Site menu"}}">

    <div class="ns-navsheet__head">
        <a class="ns-topnav__brand" href="{{@site.url}}">
            {{#if @site.icon}}<img src="{{img_url @site.icon size="xs"}}" alt="">{{/if}}
            <span class="ns-topnav__brand-name">{{@site.title}}</span>
        </a>
        <button type="button" class="ns-btn ns-btn--quiet ns-btn--icon ns-navsheet__close"
                data-ns-sheet-close aria-label="{{t "Close menu"}}">{{> "icons/x"}}</button>
    </div>

    <div class="ns-navsheet__body">
        {{navigation variant="sheet"}}

        <p class="ns-navsheet__label">{{t "Theme"}}</p>
        <div class="ns-themetoggle" role="radiogroup" aria-label="{{t "Colour theme"}}" data-ns-theme>
            <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="false"
                    data-ns-theme-value="light">{{t "Light"}}</button>
            <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="true"
                    aria-label="{{t "Match the system setting"}}" data-ns-theme-value="system">{{t "Auto"}}</button>
            <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="false"
                    data-ns-theme-value="dark">{{t "Dark"}}</button>
        </div>

        {{#if @site.members_enabled}}
            <p class="ns-navsheet__label">{{t "Follow along"}}</p>
            {{> "footer/social"}}
        {{/if}}
    </div>

    {{#if @site.members_enabled}}
        {{#unless @member}}
            <div class="ns-navsheet__foot">
                <a class="ns-btn ns-btn--primary" href="#/portal/signup" data-portal="signup">
                    {{> "icons/envelope"}} {{t "Subscribe"}}
                </a>
                <a class="ns-btn ns-btn--outline" href="#/portal/signin" data-portal="signin">
                    {{> "icons/user-circle"}} {{t "Sign in"}}
                </a>
                <p class="ns-navsheet__meta"><span>{{t "Free · no card"}}</span></p>
            </div>
        {{/unless}}
    {{/if}}
</dialog>
