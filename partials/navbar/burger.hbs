{{!-- ══════════════════════════════════════════════════════════════════════
     navbar/burger — opens the sheet.
     ------------------------------------------------------------------------
     Three bars that nav.js animates into a cross. It drives that from the
     aria-expanded it flips, so the control's appearance and the state a
     screen reader announces cannot disagree — there is one source.

     aria-haspopup="dialog" because the sheet is a <dialog>: the platform
     supplies the focus trap, Esc and the inert background.
     ══════════════════════════════════════════════════════════════════════ --}}
<button type="button" class="ns-burger" data-ns-sheet="site-nav"
        aria-expanded="false" aria-haspopup="dialog" aria-label="{{t "Menu"}}">
    <span class="ns-burger__bar"></span>
    <span class="ns-burger__bar"></span>
    <span class="ns-burger__bar"></span>
</button>
