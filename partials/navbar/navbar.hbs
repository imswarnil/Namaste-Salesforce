{{!-- ══════════════════════════════════════════════════════════════════════
     navbar — the site bar. Ported from NS-Design-System/templates/navbar.html.
     ------------------------------------------------------------------------
     The items come from Ghost's {{navigation}} HELPER, not from a foreach in
     this file — see the warning at the top of partials/navigation.hbs for why
     iterating `navigation` anywhere else renders nothing at all.

     `variant` is ours: the helper merges its own hash into the context, so
     one helper and one partial serve the bar, the sheet and the footer.

     The dropdown convention ("-Label" nests under the item above) is
     documented in partials/navbar/links.hbs.
     ══════════════════════════════════════════════════════════════════════ --}}
<nav class="ns-topnav ns-topnav--center" aria-label="{{t "Main"}}">

    <a class="ns-topnav__brand" href="{{@site.url}}">
        {{#if @site.icon}}<img src="{{img_url @site.icon size="xs"}}" alt="">{{/if}}
        <span class="ns-topnav__brand-name">{{@site.title}}</span>
    </a>

    {{navigation variant="bar"}}


    <div class="ns-topnav__actions">

        {{!-- Light · Auto · Dark lives in the sheet; the bar gets the switch,
             which shows both states and which one is current instead of
             asking you to infer the current mode from the icon of the other
             one. Its position comes from data-theme in CSS, so it is right in
             the first painted frame. --}}
        <button type="button" class="ns-themeswitch" role="switch" aria-checked="false"
                aria-label="{{t "Dark mode"}}" data-ns-theme-toggle>
            <span class="ns-themeswitch__mark" aria-hidden="true"></span>
        </button>

        {{!-- data-portal is Ghost's Members hook and needs no JS of ours. --}}
        {{#if @site.members_enabled}}
            <div class="ns-topnav__auth">
                {{#unless @member}}
                    <a class="ns-btn ns-btn--quiet ns-btn--sm" href="#/portal/signin" data-portal="signin">
                        {{> "icons/user-circle"}} {{t "Sign in"}}
                    </a>
                    <a class="ns-btn ns-btn--primary ns-btn--sm" href="#/portal/signup" data-portal="signup">
                        {{> "icons/envelope"}} {{t "Subscribe"}}
                    </a>
                {{else}}
                    <a class="ns-btn ns-btn--quiet ns-btn--sm" href="#/portal/account" data-portal="account">
                        {{> "icons/user-circle"}} {{t "Account"}}
                    </a>
                {{/unless}}
            </div>
        {{/if}}

        {{!-- The hamburger. Three bars that nav.js animates into a cross —
             .ns-burger is NSDS's own, and the aria-expanded it flips is what
             drives that, so the control and the sheet cannot disagree. --}}
        <button type="button" class="ns-burger" data-ns-sheet="site-nav"
                aria-expanded="false" aria-haspopup="dialog" aria-label="{{t "Menu"}}">
            <span class="ns-burger__bar"></span>
            <span class="ns-burger__bar"></span>
            <span class="ns-burger__bar"></span>
        </button>
    </div>
</nav>
