{{!-- Most recent on the platform — the pulse, live. Every
collection in one feed: the three newest posts across every tag,
each naming its collection via partials/collection-chip.hbs (the
same post_class match post.hbs dispatches layouts on), so a
visitor can tell a video from a newsletter from a course before
reading a word of the title.

THREE, not six: a short row of good cards beats a wall of them,
and the fourth cell is the ask. Every card is the same shape —
16:9 image, chip, two lines of title, a footer — so the row reads
as one object instead of four different ones. Posts without a
feature image get the branded placeholder, never a grey hole. --}}

{{#get "posts" include="tags" order="published_at desc" limit="3" as |activity|}}
    {{#if activity}}
        <section class="section outer home-activity">
            <div class="inner">
                <div class="section-head" data-animate>
                    <div>
                        <span class="kicker">{{> "icons/signal"}} {{t "Live"}}</span>
                        <h2>{{t "Most recent on the platform"}}</h2>
                        <p>{{t "Everything lands here first — a resource for the job hunt one day, a trigger pattern the next."}}</p>
                    </div>
                    <a class="section-more" href="{{@site.url}}/blog/">{{t "Browse everything"}} {{> "icons/arrow-right"}}</a>
                </div>

                <div class="activity-grid" data-animate-stagger>
                    {{#foreach activity}}
                        <a class="activity-card{{#if @first}} is-latest{{/if}}" href="{{url}}">

                            <div class="activity-card-media">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" />
                                {{else}}
                                    {{> "thumb-placeholder"}}
                                {{/if}}

                                {{#if @first}}
                                    <span class="activity-card-badge">{{> "icons/signal"}} {{t "Latest"}}</span>
                                {{/if}}
                            </div>

                            <div class="activity-card-body">
                                {{> "collection-chip"}}

                                <strong class="activity-card-title">{{title}}</strong>

                                {{#if custom_excerpt}}
                                    <span class="activity-card-sub">{{custom_excerpt}}</span>
                                {{/if}}

                                <span class="activity-card-foot">
                                    <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at timeago="true"}}</time>
                                    <span class="activity-card-go" aria-hidden="true">{{> "icons/arrow-right"}}</span>
                                </span>
                            </div>
                        </a>
                    {{/foreach}}

                    {{!-- The last cell: the ask. Same card shape as the
                    three beside it so the row stays a row. --}}
                    <div class="activity-card activity-card-cta">
                        <span class="activity-card-cta-icon" aria-hidden="true">{{> "icons/mail"}}</span>
                        <strong>{{t "Never miss one"}}</strong>
                        <p>{{t "Subscribe and everything I post lands in your inbox — lessons, modules, videos, the lot."}}</p>
                        {{#if @site.members_enabled}}
                            <a class="btn btn-sm" href="{{@site.url}}/signup/">{{> "icons/mail"}} {{t "Stay updated"}}</a>
                        {{else}}
                            <a class="btn btn-sm" href="{{@site.url}}/newsletter/">{{> "icons/mail"}} {{t "Stay updated"}}</a>
                        {{/if}}
                    </div>
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}
