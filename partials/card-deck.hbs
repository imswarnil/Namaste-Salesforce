{{!-- One deck as a card: a STACK of slides — two offset sheets
behind the cover — the duration chip, and a Members badge when
the post's access gates it. Context: a #slides post. Used by the
/slides/ index (the all-decks grid AND the by-topic shelves).

data-filter-item + data-duration/-access: the same courses-filter
mechanism (assets/js/filters.js), so the /slides filter sidebar
builds its buttons from whatever decks are actually on the page —
this card renders in the shelves too, so a filter narrows those
right along with the all-decks grid below them. --}}
<article class="card deck-card" data-filter-item
    data-access="{{#match visibility "!=" "public"}}members{{else}}free{{/match}}"
    data-access-label="{{#match visibility "!=" "public"}}{{t "Members"}}{{else}}{{t "Free"}}{{/match}}"
    {{~#foreach tags visibility="internal"~}}
        {{~#match slug "~^" "hash-duration-"}} data-duration="{{slug}}" data-duration-label="{{description}}"{{/match~}}
    {{~/foreach~}}>
    <div class="deck-card-stack" aria-hidden="true">
        <span class="deck-sheet is-back"></span>
        <span class="deck-sheet is-mid"></span>
        <div class="card-media deck-sheet is-front">
            {{#if feature_image}}
                <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
            {{else}}
                {{> "thumb-placeholder" icon="presentation"}}
            {{/if}}
            <span class="deck-card-play">{{> "icons/play-circle"}}</span>
        </div>
    </div>
    <div class="card-body">
        <div class="chips">
            {{#match visibility "!=" "public"}}
                <span class="chip deck-chip-members">{{> "icons/lock"}} {{t "Members"}}</span>
            {{/match}}
            {{> "duration-chip" chipClass="chip"}}
            {{#if primary_tag}}
                <span class="chip">{{#if primary_tag.feature_image}}<img class="card-tag-icon" src="{{img_url primary_tag.feature_image size="xs"}}" alt="" loading="lazy" />{{/if}} {{primary_tag.name}}</span>
            {{/if}}
        </div>
        <h3 class="card-title"><a class="card-link" href="{{url}}">{{title}}</a></h3>
        {{#if custom_excerpt}}<p class="card-excerpt">{{custom_excerpt}}</p>{{/if}}
    </div>
</article>
