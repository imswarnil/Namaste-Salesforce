{{!-- Hero style: CENTERED. The classic LMS landing — everything
on one calm center axis, big type, proof and stats beneath.
No panel; the mesh background and orbs carry the visual. --}}
<section class="home-hero hero-v-centered outer relative">
    <div class="bg-grid" aria-hidden="true"></div>

    <div class="orb" style="width: 420px; height: 420px; top: -140px; left: -160px;" aria-hidden="true"></div>
    <div class="orb" style="width: 360px; height: 360px; bottom: -100px; right: -120px; animation-delay: -4s;" aria-hidden="true"></div>
    <div class="home-deco" style="top: 20%; right: 8%;" data-parallax="0.10" aria-hidden="true">
        <span class="home-bubble float">{{> "icons/cloud"}}</span>
    </div>
    <div class="home-deco" style="top: 26%; left: 7%;" data-parallax="0.08" aria-hidden="true">
        <span class="home-bubble float-alt" style="animation-delay: -2s;">{{> "icons/graduation-cap"}}</span>
    </div>
    <div class="home-deco" style="bottom: 24%; right: 16%;" data-parallax="0.06" aria-hidden="true">
        <span class="home-bubble float" style="animation-delay: -5s;">{{> "icons/zap"}}</span>
    </div>
    <div class="home-deco" style="bottom: 30%; left: 12%;" data-parallax="0.12" aria-hidden="true">
        <span class="home-bubble float-alt" style="animation-delay: -6s;">{{> "icons/code"}}</span>
    </div>

    <div class="inner relative">
        <div class="home-hero-copy is-centered">
            {{> "hero-copy"}}
        </div>

        {{> "hero-stats"}}
    </div>
</section>
