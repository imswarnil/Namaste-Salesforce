{{!-- Hero style: SHOWCASE SPLIT (the default). Copy left, the
featured course rendered live as a tilting card deck right, with
the taught-by and latest-video chips floating on it. --}}
<section class="home-hero outer relative">
    <div class="bg-grid" aria-hidden="true"></div>

    <div class="orb" style="width: 420px; height: 420px; top: -120px; left: -140px;" aria-hidden="true"></div>
    <div class="orb" style="width: 360px; height: 360px; bottom: -80px; right: -100px; animation-delay: -4s;" aria-hidden="true"></div>
    <div class="home-deco" style="top: 14%; right: 6%;" data-parallax="0.10" aria-hidden="true">
        <span class="home-bubble float">{{> "icons/cloud"}}</span>
    </div>
    <div class="home-deco" style="top: 58%; right: 44%;" data-parallax="0.06" aria-hidden="true">
        <span class="home-bubble float-alt">{{> "icons/zap"}}</span>
    </div>
    <div class="home-deco" style="top: 24%; left: 42%;" data-parallax="0.08" aria-hidden="true">
        <span class="home-bubble float" style="animation-delay: -3s;">{{> "icons/database"}}</span>
    </div>
    <div class="home-deco" style="bottom: 30%; left: 4%;" data-parallax="0.12" aria-hidden="true">
        <span class="home-bubble float-alt" style="animation-delay: -6s;">{{> "icons/code"}}</span>
    </div>

    <div class="home-hero-grid inner">

        <div class="home-hero-copy">
            {{> "hero-copy"}}
        </div>

        {{#get "posts" filter="tag:[hash-course-col,hash-courses-col]" include="tags" order="featured desc, published_at asc" limit="1" as |star|}}
            {{#if star}}
                <div class="home-hero-panel" data-tilt>
                    <span class="home-hero-ring" aria-hidden="true"></span>
                    <span class="home-hero-deck" aria-hidden="true"></span>
                    {{#foreach star}}
                        {{> "card-course"}}
                    {{/foreach}}
                    {{#get "authors" limit="3" as |folks|}}
                        {{#if folks}}
                            <div class="home-hero-float home-hero-float-top">
                                <span class="avatar-stack" aria-hidden="true">
                                    {{#foreach folks}}
                                        {{#if profile_image}}
                                            <img class="avatar" src="{{img_url profile_image size="xs"}}" alt="" loading="lazy" />
                                        {{/if}}
                                    {{/foreach}}
                                </span>
                                <span>
                                    <strong>{{t "Taught by"}}</strong>
                                    {{#foreach folks}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}
                                </span>
                            </div>
                        {{/if}}
                    {{/get}}
                    {{#get "posts" filter="tag:hash-video-col" limit="1" as |v|}}
                        {{#if v}}
                            <a class="home-hero-float" href="{{v.[0].url}}">
                                {{> "icons/play-circle"}}
                                <span>
                                    <strong>{{t "Latest video"}}</strong>
                                    {{v.[0].title}}
                                </span>
                            </a>
                        {{/if}}
                    {{/get}}
                </div>
            {{/if}}
        {{/get}}

    </div>

    <div class="inner">
        {{> "hero-stats"}}
    </div>
</section>
