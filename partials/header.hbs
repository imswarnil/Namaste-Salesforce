{{!-- ════════════════════════════════════════════════════════════════════════
  partials/header.hbs — Primary site header / navigation
  ----------------------------------------------------------------------------
  Sticky, translucent (glass) bar. Desktop shows the brand + primary nav +
  actions; below `lg` it collapses to an Alpine-powered slide-down menu.
  Reuses components/theme-toggle and the navigation partial.
═══════════════════════════════════════════════════════════════════════════ --}}
<header class="sticky top-0 z-40 border-b border-border bg-surface/80 backdrop-blur supports-[backdrop-filter]:bg-surface/70"
        x-data="{ open: false }">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6">

    {{!-- Brand --}}
    <a href="{{@site.url}}" class="flex shrink-0 items-center gap-2 font-heading text-lg font-extrabold">
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}" class="h-8 w-auto">
      {{else}}
        <span class="text-brand-600 dark:text-brand-300">{{@site.title}}</span>
      {{/if}}
    </a>

    {{!-- Desktop nav --}}
    <nav class="ml-2 hidden lg:block" aria-label="{{t "Primary"}}">
      <ul class="flex items-center gap-1">{{navigation}}</ul>
    </nav>

    {{!-- Actions --}}
    <div class="ml-auto flex items-center gap-2">
      <a href="#/search" data-ghost-search aria-label="{{t "Search"}}"
         class="hidden h-9 w-9 items-center justify-center rounded-full border border-border text-ink transition hover:bg-brand-500/10 hover:text-brand-600 sm:inline-flex">
        <i class="ph ph-magnifying-glass text-lg" aria-hidden="true"></i>
      </a>

      {{> "components/theme-toggle"}}

      {{#if @member}}
        <a href="#/portal/account" data-portal="account"
           class="hidden rounded-pill border border-border px-4 py-2 text-sm font-medium transition hover:border-brand-500 sm:inline-flex">{{t "Account"}}</a>
      {{else}}
        <a href="#/portal/signup" data-portal="signup"
           class="hidden rounded-pill bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600 sm:inline-flex">{{t "Subscribe"}}</a>
      {{/if}}

      {{!-- Mobile menu toggle --}}
      <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-ink lg:hidden"
              @click="open = !open" :aria-expanded="open.toString()" aria-controls="mobile-menu" aria-label="{{t "Menu"}}">
        <i class="ph text-xl" :class="open ? 'ph-x' : 'ph-list'" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  {{!-- Mobile menu --}}
  <div id="mobile-menu" class="lg:hidden" x-show="open" x-cloak
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0">
    <nav class="border-t border-border px-4 py-3" aria-label="{{t "Mobile"}}">
      <ul class="flex flex-col gap-1">{{navigation}}</ul>
      <div class="mt-3 flex items-center gap-2 border-t border-border pt-3">
        {{#if @member}}
          <a href="#/portal/account" data-portal="account" class="rounded-pill border border-border px-4 py-2 text-sm font-medium">{{t "Account"}}</a>
        {{else}}
          <a href="#/portal/signin" data-portal="signin" class="rounded-pill border border-border px-4 py-2 text-sm font-medium">{{t "Log in"}}</a>
          <a href="#/portal/signup" data-portal="signup" class="rounded-pill bg-brand-500 px-4 py-2 text-sm font-bold text-white">{{t "Subscribe"}}</a>
        {{/if}}
      </div>
    </nav>
  </div>
</header>
