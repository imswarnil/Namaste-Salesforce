{{!-- ════════════════════════════════════════════════════════════════════════
  partials/header.hbs — the site bar.

  THE DESIGN SYSTEM'S `.ns-topnav` (ds/components/css/navbar.css), driven by
  the system's own `assets/js/ds/nav.js`. Behaviour comes from the system too:
  nav.js opens the menus and the mobile sheet by flipping `aria-expanded`,
  marks the bar `data-ns-scrolled` past the fold, and owns the theme switch.
  The theme writes no navbar JavaScript at all any more.

  WITH JAVASCRIPT OFF THIS BAR STILL NAVIGATES. Every link is a real link, and
  the mobile sheet is a native <dialog> — focus trapping, Escape and the inert
  background come from the platform rather than from us.

  Nav items come from Ghost (Admin → Settings → Navigation) via the reserved
  `{{navigation}}` helper, which renders partials/navigation.hbs. Add or
  reorder items there, not here.

  A LESSON PAGE GETS A DIFFERENT BAR — components/course-player-header — which
  default.hbs swaps in. That one is a reading chrome: no mega menu, an exit
  control, and the lesson rail's toggle.
═══════════════════════════════════════════════════════════════════════════ --}}

<a href="#main" class="ns-skiplink">{{t "Skip to content"}}</a>

{{!-- @custom.navbar_behavior (Ghost Admin → Design) maps onto the system's own
     bar variants rather than onto theme JS. `data-ns-scrolled` opts the bar
     into nav.js's one scroll listener, which sets data-scrolled="true" past
     the fold — that is what --transparent keys off to go solid over a hero. --}}
<nav class="ns-topnav{{#match @custom.navbar_behavior "Fixed on scroll"}} ns-topnav--compact{{/match}}{{#match @custom.navbar_behavior "Island on scroll"}} ns-topnav--floating{{/match}}{{#match @custom.navbar_behavior "Static"}} ns-topnav--sunken{{/match}}"
     aria-label="{{t "Main"}}" data-ns-scrolled>
  <div class="ns-topnav__inner">

    {{!-- Brand. The logo is the one image in the bar and it is above the fold
         on every route, so it is eager with an explicit box — a late logo
         shifts the whole row. --}}
    <a class="ns-topnav__brand" href="{{@site.url}}" aria-label="{{@site.title}}">
      {{#if @site.logo}}
        <img src="{{img_url @site.logo size="xs"}}" alt="" width="32" height="32" decoding="async" fetchpriority="high">
      {{else}}
        <img src="{{asset "logo/icon-192.png"}}" alt="" width="32" height="32" decoding="async" fetchpriority="high">
      {{/if}}
      <span class="ns-topnav__brand-name">{{@site.title}}</span>
    </a>

    <ul class="ns-topnav__links">{{navigation}}</ul>

    <div class="ns-topnav__actions">

      {{#if @custom.navbar_show_search}}
        <button type="button" class="ns-navsearch" data-ghost-search aria-label="{{t "Search"}}">
          {{> icons name="search"}}
          <span class="ns-navsearch__text">{{t "Search…"}}</span>
          <kbd class="ns-navsearch__kbd">⌘K</kbd>
        </button>
      {{/if}}

      {{!-- One piece of social proof, and it is a link to the repo. --}}
      {{#if @custom.navbar_show_github}}
        <a class="ns-navstar" href="https://github.com/imswarnil/Namaste-Salesforce"
           target="_blank" rel="noopener" aria-label="{{t "Star on GitHub"}}">
          <span class="ns-navstar__label">{{> icons name="github"}}<span>{{t "Star"}}</span></span>
        </a>
      {{/if}}

      {{!-- The theme switch is the system's, wired by nav.js against the same
           `ns-theme` storage key the pre-paint script in default.hbs reads. --}}
      <button type="button" class="ns-themeswitch" role="switch" aria-checked="false"
              aria-label="{{t "Dark mode"}}" data-ns-theme-toggle>
        <span class="ns-themeswitch__mark" aria-hidden="true"></span>
      </button>

      {{#if @site.members_enabled}}
        <div class="ns-topnav__auth">
          {{#if @member}}
            {{#if @custom.navbar_show_app}}{{> "members/app-link"}}{{/if}}
            <a class="ns-btn ns-btn--quiet ns-btn--sm" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
          {{else}}
            <a class="ns-btn ns-btn--quiet ns-btn--sm" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
            <a class="ns-btn ns-btn--primary ns-btn--sm" href="#/portal/signup" data-portal="signup">{{t "Start learning"}}</a>
          {{/if}}
        </div>
      {{/if}}

      <button type="button" class="ns-burger" data-ns-sheet="site-nav"
              aria-expanded="false" aria-haspopup="dialog" aria-label="{{t "Menu"}}">
        <span class="ns-burger__bar"></span><span class="ns-burger__bar"></span><span class="ns-burger__bar"></span>
      </button>
    </div>
  </div>
</nav>

{{!-- ── Mobile sheet ──────────────────────────────────────────────────────
  A native <dialog>. The index numerals are the house vocabulary — a sheet is
  a LIST of destinations, and numbering them is what makes it scannable at a
  glance rather than a stack of equal-weight words.
───────────────────────────────────────────────────────────────────────── --}}
<dialog class="ns-navsheet" id="site-nav" aria-label="{{t "Site menu"}}">
  <div class="ns-navsheet__head">
    <a class="ns-topnav__brand" href="{{@site.url}}">
      {{#if @site.logo}}<img src="{{img_url @site.logo size="xs"}}" alt="" width="32" height="32" loading="lazy" decoding="async">{{/if}}
      <span class="ns-topnav__brand-name">{{@site.title}}</span>
    </a>
    <button type="button" class="ns-btn ns-btn--quiet ns-btn--icon ns-navsheet__close"
            data-ns-sheet-close aria-label="{{t "Close menu"}}">{{> icons name="x"}}</button>
  </div>

  <div class="ns-navsheet__body">
    {{#foreach navigation}}
      <a class="ns-navsheet__link" href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>
        <span class="ns-navsheet__index">{{#if @index}}{{@number}}{{else}}01{{/if}}</span>
        {{label}}
        {{> icons name="caret-right"}}
      </a>
    {{/foreach}}

    <p class="ns-navsheet__label">{{t "Theme"}}</p>
    <div class="ns-themetoggle" role="radiogroup" aria-label="{{t "Colour theme"}}" data-ns-theme>
      <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="false" data-ns-theme-value="light">{{t "Light"}}</button>
      <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="true"  data-ns-theme-value="system">{{t "Auto"}}</button>
      <button type="button" class="ns-themetoggle__opt" role="radio" aria-checked="false" data-ns-theme-value="dark">{{t "Dark"}}</button>
    </div>
  </div>

  {{#if @site.members_enabled}}
    <div class="ns-navsheet__foot">
      {{#unless @member}}
        <a class="ns-btn ns-btn--primary" href="#/portal/signup" data-portal="signup">{{t "Start learning"}}</a>
        <a class="ns-btn ns-btn--outline" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
      {{else}}
        <a class="ns-btn ns-btn--outline" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
      {{/unless}}
    </div>
  {{/if}}
</dialog>
