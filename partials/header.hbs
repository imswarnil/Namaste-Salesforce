{{!--
    header.hbs — Namaste Salesforce
    ============================================================
    Route-aware header router.

    PATTERN:
      {{#post}} ... {{else}} ... {{/post}}
      The {{else}} renders when there is no post context
      (homepage, tag page, author page, collections index).
      Inside {{#post}}, {{#has}} can reliably check tags.

    ROUTING:
      #lesson              → header/lesson.hbs
      #course              → header/course.hbs
      #training-content    → header/training-content.hbs
      #training            → header/training.hbs
      documentation (tag)  → header/documentation.hbs
      #blog / #videos / anything else → header/default.hbs
      Non-post pages       → header/default.hbs
    ============================================================
--}}

{{#post}}
    {{#has tag="#lesson"}}
        {{> "header/lesson"}}
    {{else has tag="#course"}}
        {{> "header/course"}}
    {{else has tag="#training-content"}}
 {{> "header/training"}}
     {{else has tag="#training"}}
        {{> "header/training"}}
    {{else has tag="documentation"}}
        {{> "header/documentation"}}
    {{else}}
        {{> "header/default"}}
    {{/has}}
{{else}}
    {{> "header/default"}}
{{/post}}
