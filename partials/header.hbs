<header class="default-header blog-header site-header is-sticky"
        role="banner" id="siteHeader">
  <nav class="navbar default-header__navbar" role="navigation" aria-label="Main navigation">
    <div class="container default-header__wrap">

      <div class="navbar-brand default-header__brand-group">

        {{!-- Animated brand --}}
        <div class="default-header__brand-wrap">
          <a class="navbar-item default-header__brand" href="{{@site.url}}"
             aria-label="{{@site.title}} — homepage" id="brandLink">
            {{#if @site.logo}}
              <img src="{{@site.logo}}" alt="{{@site.title}}"
                   class="default-header__logo" width="32" height="32">
            {{/if}}
            <span class="default-header__title" id="brandTitle">{{@site.title}}</span>
          </a>
          <button class="default-header__brand-speak" type="button"
                  id="brandSpeakBtn" aria-label="Pronounce site name">
            <i class="ph ph-speaker-simple-high" aria-hidden="true"></i>
          </button>
        </div>

        <span class="default-header__brand-sep is-hidden-touch" aria-hidden="true"></span>

        {{!-- Contribute dropdown --}}
        <div class="default-header__learn-wrap is-hidden-touch" id="contributeWrap">
          <button class="default-header__learn-btn" type="button" id="contributeBtn"
                  aria-haspopup="true" aria-expanded="false" data-sound="pop">
            <i class="ph ph-git-pull-request" aria-hidden="true"></i>
            <span>Contribute</span>
            <i class="ph ph-caret-down default-header__learn-caret" aria-hidden="true"></i>
          </button>
          <div class="default-header__learn-panel" id="contributePanel" hidden>
            <p class="default-header__learn-heading">Get Involved</p>
            <div class="default-header__learn-grid">
              <a class="default-header__learn-item" href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener noreferrer">
                <span class="default-header__learn-icon"><i class="ph ph-github-logo" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>GitHub</strong><small>Star &amp; fork the repo</small></span>
              </a>
              <a class="default-header__learn-item" href="https://github.com/imswarnil/Namaste-Salesforce/issues/new" target="_blank" rel="noopener noreferrer">
                <span class="default-header__learn-icon"><i class="ph ph-bug" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Report a Bug</strong><small>Open a GitHub issue</small></span>
              </a>
              <a class="default-header__learn-item" href="https://github.com/imswarnil/Namaste-Salesforce/pulls" target="_blank" rel="noopener noreferrer">
                <span class="default-header__learn-icon"><i class="ph ph-git-pull-request" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Pull Request</strong><small>Submit improvements</small></span>
              </a>
              <a class="default-header__learn-item" href="/contact/?ref=write">
                <span class="default-header__learn-icon"><i class="ph ph-pencil-line" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Write a Post</strong><small>Share your knowledge</small></span>
              </a>
            </div>
            <div class="default-header__learn-footer">
              <a href="https://github.com/imswarnil/Namaste-Salesforce" class="default-header__learn-all" target="_blank" rel="noopener noreferrer">
                View on GitHub <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>

        {{!-- Products I Use dropdown --}}
        <div class="default-header__learn-wrap is-hidden-touch" id="productsWrap">
          <button class="default-header__learn-btn" type="button" id="productsBtn"
                  aria-haspopup="true" aria-expanded="false" data-sound="pop">
            <i class="ph ph-squares-four" aria-hidden="true"></i>
            <span>Products</span>
            <i class="ph ph-caret-down default-header__learn-caret" aria-hidden="true"></i>
          </button>
          <div class="default-header__learn-panel" id="productsPanel" hidden>
