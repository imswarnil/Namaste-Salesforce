{{!-- =========================================================================
  partials/header.hbs  ·  Namaste Salesforce
  SINGLE FILE — zero sub-partials. All three header variants inline.

  VARIANTS:
    #lesson post  → Course header  (lesson bar + slide-down panel)
    #blog   post  → Blog header    (reading progress bar)
    everything    → Default header

  RIGHT RAIL (default + blog):
    [Search] [Theme] [Contribute] [Social: Twitter LinkedIn YouTube GitHub★]
    [Support ▾] [Auth: Sign in / Account]

  OPEN SOURCE PATTERN (replaces Learn + Topics dropdowns):
    • Contribute pill     → GitHub repo
    • Support dropdown   → GitHub Sponsors · Buy Me a Coffee
    • Social icon strip  → Twitter, LinkedIn, YouTube, GitHub (+star count)
    • Auth block         → Ghost members sign in / account

  NAV DROPDOWNS:
    Add "- " prefix to a nav label in Ghost Admin to make it a child item.
    JS builds the dropdown DOM from data-child="true" links.

  JSON-LD:
    SiteNavigationElement + WebSite emitted on every page.
========================================================================== --}}

{{!-- ── JSON-LD ──────────────────────────────────────────────────────────── --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}"{{#if @site.description}},
      "description": "{{@site.description}}"{{/if}},
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": { "@type": "ImageObject", "url": "{{@site.logo}}" }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{@site.url}}/?s={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "@id": "{{@site.url}}/#site-navigation",
      "name": "Site Navigation",
      "itemListElement": [
        {{#foreach navigation}}
          {{#match label "~^" "- "}}{{else}}
          { "@type": "ListItem", "position": {{@number}}, "name": "{{label}}", "url": "{{url absolute="true"}}" }{{#unless @last}},{{/unless}}
          {{/match}}
        {{/foreach}}
      ]
    }
  ]
}
</script>

{{!-- ══════════════════════════════════════════════════════════════════════
  DISPATCH
══════════════════════════════════════════════════════════════════════════ --}}
{{#is "post"}}
