              <span class="icon is-small"><i class="ph ph-moon ns-theme-icon"></i></span>
            </button>
            <a class="button is-dark is-rounded is-small has-text-weight-semibold"
               href="https://github.com/imswarnil/Namaste-Salesforce"
               target="_blank" rel="noopener noreferrer">
              <span class="icon is-small"><i class="ph ph-github-logo"></i></span>
              <span class="is-hidden-touch">Star on GitHub</span>
            </a>
            {{#if @member}}
              <a class="button is-light is-rounded is-small" href="#/portal/account" data-portal="account">{{@member.name}}</a>
            {{else}}
              <a class="button is-light is-rounded is-small" href="#/portal/signin" data-portal="signin">Log in</a>
              <a class="button is-gradient is-rounded is-small has-text-weight-bold" href="#/portal/signup" data-portal="signup">Sign Up</a>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
{{/post}}

{{!-- ═══════════════════════════════════════════════════════════════════
     Burger toggle behavior only — dark mode is handled in default.hbs
     ═══════════════════════════════════════════════════════════════════ --}}
<script>
  (function () {
    document.querySelectorAll('.navbar-burger').forEach(function (b) {
      b.addEventListener('click', function () {
        var t = document.getElementById(b.dataset.target);
        b.classList.toggle('is-active');
        if (t) t.classList.toggle('is-active');
      });
    });
  })();
</script>
