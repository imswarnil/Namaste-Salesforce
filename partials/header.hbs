{{!-- =========================================================================
  partials/header.hbs  ·  Namaste Salesforce
  SINGLE FILE — zero sub-partials.

  VARIANTS:
    #lesson post  → course-header   compact bar (desktop: back + title + ✕ only)
    #blog   post  → default-header  + reading progress strip
    everything    → default-header

  BRAND STRIP (left, desktop):
    [Logo + Title] — clean, no dropdowns next to brand.

  ACTIONS RAIL (desktop, right):
    [More ▾]  [🔍]  [☀/🌙]  [$]  [Auth]  [Star on GitHub]
    • More = 2-column dropdown: Contribute | Community (Discord, IG, Twitter, LI, YT, Trailblazer)
    • Products I Use = single link in More footer
    • $ = ph-currency-dollar → coins sound on hover → GitHub Sponsors

  COURSE HEADER:
    Desktop: [← Back]  [Lesson title - plain text]  [✕]  — no panel, no badge
    Mobile:  [← Back]  [Lesson title toggle ▾]  [☰]  [✕]  — lesson list panel

  MOBILE MENU:
    Full mirror of desktop actions — every item visible in the drawer.
    Smooth slide-down from top (Bulma navbar-menu pattern preserved).

  SOUNDS (Web Audio API — gentle, not harsh, no external files):
    Light mode → soft 3-note chime (ascending sine, very low gain)
    Dark mode  → soft 2-note descending tone
    Burger     → brief soft click (noise burst, low volume)
    Dropdown   → gentle pop (short sine sweep)
    Search     → soft swoosh (highpass noise)
    Nav click  → subtle tick (very short high sine)
    $ hover    → delicate coins (4 quiet high pings)

  JSON-LD: SiteNavigationElement built dynamically from Ghost {{navigation}}.
========================================================================== --}}

{{!-- ── JSON-LD ──────────────────────────────────────────────────────────── --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}"{{#if @site.description}},
      "description": "{{@site.description}}"{{/if}},
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": { "@type": "ImageObject", "url": "{{@site.logo}}" }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{@site.url}}/?s={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SiteNavigationElement",
      "@id": "{{@site.url}}/#site-navigation",
      "name": "Primary Navigation",
      "hasPart": [
        {{#foreach navigation}}
        {{#unless @first}},{{/unless}}
        {
          "@type": "SiteNavigationElement",
          "name": "{{label}}",
          "url": "{{url absolute="true"}}",
          "position": {{@number}}
        }
        {{/foreach}}
      ]
    },
    {
      "@type": "SiteNavigationElement",
      "@id": "{{@site.url}}/#more-navigation",
      "name": "Contribute & Community",
      "hasPart": [
        { "@type": "SiteNavigationElement", "name": "GitHub Repository", "url": "https://github.com/imswarnil/Namaste-Salesforce" },
        { "@type": "SiteNavigationElement", "name": "Documentation", "url": "{{@site.url}}/docs/" },
        { "@type": "SiteNavigationElement", "name": "Become an Author", "url": "{{@site.url}}/contact/?ref=author" },
        { "@type": "SiteNavigationElement", "name": "Become a Sponsor", "url": "https://github.com/sponsors/imswarnil" },
        { "@type": "SiteNavigationElement", "name": "Discord Community", "url": "https://discord.gg/imswarnil" },
        { "@type": "SiteNavigationElement", "name": "YouTube", "url": "https://youtube.com/@imswarnil" },
        { "@type": "SiteNavigationElement", "name": "Products I Use", "url": "{{@site.url}}/products/" }
      ]
    }
  ]
}
</script>

{{!-- ════════════════════════════════════════════════════════════════════════
  DISPATCH
════════════════════════════════════════════════════════════════════════════ --}}
{{#is "post"}}{{#post}}{{#has tag="#lesson"}}

{{!-- ────────────────────────────────────────────────────────────────────────
  COURSE HEADER  (#lesson posts)
  Desktop: [← Back]  [Title - plain text]  [✕]   — no panel, no badge
  Mobile:  [← Back]  [Title button ▾]  [☰]  [✕]  — lesson panel on mobile only
──────────────────────────────────────────────────────────────────────────── --}}
<header class="course-header site-header" role="banner" id="siteHeader">
  <div class="course-header__bar">
    <div class="container is-fluid">
      <div class="course-header__inner">

        {{!-- Left: back to course --}}
        <div class="course-header__left">
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__back" href="{{url}}" aria-label="Back to {{title}}">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">{{title}}</span>
              </a>
            {{else}}
              <a class="course-header__back" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">Courses</span>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

        {{!-- Center: lesson title
             Desktop → plain <span> (no toggle)
             Mobile  → <button> that opens lesson panel --}}
        <div class="course-header__center">
          {{!-- Desktop: plain text --}}
          <span class="course-header__title is-hidden-touch">{{title}}</span>
          {{!-- Mobile: toggles lesson list --}}
          <button class="course-header__title-btn is-hidden-desktop" type="button"
                  id="coursePanelBurger"
                  aria-label="Show all lessons in this course"
                  aria-expanded="false" aria-controls="courseLessonPanel">
            <span class="course-header__title">{{title}}</span>
            <i class="ph ph-caret-down course-header__title-caret" aria-hidden="true"></i>
          </button>
        </div>

        {{!-- Right: mobile burger + exit ✕ --}}
        <div class="course-header__right">
          {{!-- ☰ lesson list toggle — mobile only --}}
          <button class="course-header__burger is-hidden-desktop" type="button"
                  id="courseBurgerBtn"
                  aria-label="Toggle lesson list"
                  aria-expanded="false" aria-controls="courseLessonPanel">
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
          </button>
          {{!-- ✕ exit lesson — always visible --}}
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__close" href="{{url}}" aria-label="Exit lesson">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{else}}
              <a class="course-header__close" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

      </div>
    </div>
  </div>

  {{!-- Lesson list panel — mobile only (hidden on desktop via CSS) --}}
  <div class="course-header__lesson-panel" id="courseLessonPanel"
       aria-label="Course lessons" aria-hidden="true">
    <div class="container is-fluid">
      <div class="course-header__lesson-wrap">
        <p class="course-header__lesson-label menu-label">
          <i class="ph ph-list-checks" aria-hidden="true"></i>
          Course Lessons
        </p>
        <ul class="menu-list course-header__lesson-list" id="courseLessonList">
          {{#get "posts"
            filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}"
            order="published_at asc"
            limit="100"
          }}
            {{#foreach posts}}
              <li>
                <a href="{{url}}"
                   class="course-header__lesson-link{{#match id ../../../../id}} is-active{{/match}}"
                   data-lesson-num="{{@number}}"
                   data-lesson-total="{{../length}}">
                  <span class="course-header__lesson-num">{{@number}}</span>
                  <span class="course-header__lesson-name">{{title}}</span>
                  {{#match id ../../../../id}}
                    <span class="course-header__lesson-dot" aria-label="Current lesson"></span>
                  {{/match}}
                </a>
              </li>
            {{/foreach}}
          {{/get}}
        </ul>
      </div>
    </div>
  </div>
</header>

{{else has tag="#blog"}}

{{!-- ────────────────────────────────────────────────────────────────────────
