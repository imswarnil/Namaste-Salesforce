{{!-- =========================================================================
  header.hbs
  
  1. Emits JSON-LD on EVERY page (WebSite + SiteNavigationElement).
     Child items (label starts with "- ") are excluded from JSON-LD.
  
  2. Dispatches to the right header partial:
       #lesson post  →  partials/header/course.hbs
       #blog post    →  partials/header/blog.hbs
       everything    →  partials/header/default.hbs
========================================================================== --}}

{{!-- ══════════════════════════════════════════════════════════════════════
  JSON-LD — emitted on EVERY page, always valid
══════════════════════════════════════════════════════════════════════════ --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}"{{#if @site.description}},
      "description": "{{@site.description}}"{{/if}},
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": {
          "@type": "ImageObject",
          "url": "{{@site.logo}}"
        }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{@site.url}}/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "@id": "{{@site.url}}/#site-navigation",
      "name": "Site Navigation",
      "itemListElement": [
        {{!-- Only top-level items (no "- " prefix) → clean JSON-LD --}}
        {{#foreach navigation}}
          {{#match label "~^" "- "}}{{else}}
          {
            "@type": "ListItem",
            "position": {{@number}},
            "name": "{{label}}",
            "url": "{{url absolute="true"}}"
          }{{#unless @last}},{{/unless}}
          {{/match}}
        {{/foreach}}
      ]
    }
  ]
}
</script>

{{!-- ══════════════════════════════════════════════════════════════════════
  Header dispatch
══════════════════════════════════════════════════════════════════════════ --}}
{{#is "post"}}
  {{#post}}
    {{#has tag="#lesson"}}
      {{> "header/course"}}
    {{else has tag="#blog"}}
      {{> "header/blog"}}
    {{else}}
      {{> "header/default"}}
    {{/has}}
  {{/post}}
{{else}}
  {{> "header/default"}}
{{/is}}
