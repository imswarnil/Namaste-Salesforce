{{#is "post"}}{{#post}}{{#has tag="#lesson"}}

{{!-- ──────────────────────────────────────────────────────────────────────
  COURSE HEADER  (#lesson posts only)
  [← Back]  [Lesson title ▾]  [X/N  ☰  ✕]
────────────────────────────────────────────────────────────────────────── --}}
<header class="course-header site-header" role="banner" id="siteHeader">
  <div class="course-header__bar">
    <div class="container is-fluid">
      <div class="course-header__inner">
        <div class="course-header__left">
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__back" href="{{url}}" aria-label="Back to {{title}}">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">{{title}}</span>
              </a>
            {{else}}
              <a class="course-header__back" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">Courses</span>
              </a>
            {{/foreach}}
          {{/get}}
        </div>
        <div class="course-header__center">
          <button class="course-header__title-btn" type="button" id="coursePanelBurger"
                  aria-label="Show all lessons" aria-expanded="false" aria-controls="courseLessonPanel">
            <span class="course-header__title">{{title}}</span>
            <i class="ph ph-caret-down course-header__title-caret" aria-hidden="true"></i>
          </button>
        </div>
        <div class="course-header__right">
          <span class="course-header__badge" id="lessonBadge" aria-live="polite">
            <i class="ph ph-list-checks" aria-hidden="true"></i>
            <span id="lessonBadgeText">…</span>
          </span>
          <button class="course-header__burger" type="button" id="courseBurgerBtn"
                  aria-label="Toggle lesson list" aria-expanded="false" aria-controls="courseLessonPanel">
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
          </button>
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__close" href="{{url}}" aria-label="Exit lesson">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{else}}
              <a class="course-header__close" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{/foreach}}
          {{/get}}
        </div>
      </div>
    </div>
  </div>
  <div class="course-header__lesson-panel" id="courseLessonPanel"
       aria-label="Course lessons" aria-hidden="true">
    <div class="container is-fluid">
      <div class="course-header__lesson-wrap">
        <p class="course-header__lesson-label menu-label">
          <i class="ph ph-list-checks" aria-hidden="true"></i> Course Lessons
        </p>
        <ul class="menu-list course-header__lesson-list" id="courseLessonList">
          {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}"
            order="published_at asc" limit="100"}}
            {{#foreach posts}}
              <li>
                <a href="{{url}}"
                   class="course-header__lesson-link{{#match id ../../../../id}} is-active{{/match}}"
                   data-lesson-num="{{@number}}" data-lesson-total="{{../length}}">
                  <span class="course-header__lesson-num">{{@number}}</span>
                  <span class="course-header__lesson-name">{{title}}</span>
                  {{#match id ../../../../id}}
                    <span class="course-header__lesson-dot" aria-label="Current lesson"></span>
                  {{/match}}
                </a>
              </li>
            {{/foreach}}
          {{/get}}
        </ul>
      </div>
    </div>
  </div>
</header>

{{else has tag="#blog"}}

