{{!-- =========================================================================
  partials/header.hbs  ·  Namaste Salesforce  (single file — zero sub-partials)

  VARIANTS:
    #lesson post  → course-header   sticky bar + right-slide lesson drawer
    #blog   post  → default-header  + reading-progress strip
    everything    → default-header

  COURSE HEADER:
    Desktop: [← Back to Course]  [Course · Lesson breadcrumb]  [✕]
    Mobile:  [← Back to Course]  [Course Name truncated]       [☰]
             Burger opens a right-side slide-in lesson drawer (same as
             default mobile menu but from the right).

  DEFAULT HEADER BRAND:
    [Logo · Title]  |  [nav links…]  |  [More▾][🔍][☀/🌙][📅][💲]  [Auth]  [GitHub]
    Divider after brand title before nav links.

  MORE ▾ MEGA-DROPDOWN:
    Left column:  Contribute (GitHub, Docs, Bug, PR, Become Author, Sponsor)
    Right column: Community (Trailblazer, Discord, Instagram, Twitter, LinkedIn, YouTube)
    Footer: Products I Use link

  MOBILE TOOLBAR (header bar, right side):
    [🔍] [☀/🌙] [💲] [☰]   — icon-only, no labels, no tooltips

  MOBILE MENU (slide-down drawer):
    Full mirror of desktop actions — More, Search, Theme, Topmate, $, Auth, GitHub
    All items visible as full-width rows with labels.

  JSON-LD:
    • WebSite + Organisation + SearchAction
    • SiteNavigationElement for every Ghost nav item (primary navigation)
    • SiteNavigationElement for More dropdown items (contribute + community)
    All items from navigation.hbs are looped here correctly.

  SOUNDS (Web Audio, no files):
    Light mode  → 3-note ascending chime
    Dark mode   → 2-note descending tone
    Burger      → soft bandpass click
    Dropdown    → gentle pop
    Search      → swoosh
    Nav click   → subtle tick
    $ hover     → coin pings
========================================================================== --}}

{{!-- ════════════════════════════════════════════════════════════════════════
  JSON-LD — emitted once per page load, uses Ghost site and navigation data.
  FIX: navigation items use separate lines to avoid }}} parse error.
  The "position" field is omitted because {{@number}}} hits the HBS parser.
════════════════════════════════════════════════════════════════════════════ --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}"{{#if @site.description}},
      "description": "{{@site.description}}"{{/if}},
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": {
          "@type": "ImageObject",
          "url": "{{@site.logo}}"
        }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{@site.url}}/?s={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "@id": "{{@site.url}}/#site-navigation",
      "name": "{{@site.title}} Navigation",
      "description": "Primary site navigation links",
      "itemListElement": [
        {{!--
          Loop over every Ghost navigation item.
          We use @index (0-based) + 1 for position.
          CRITICAL: keep the closing JSON }} and the object closing } on
          separate tokens so HBS never sees }}} (triple-mustache).
        --}}
        {{#foreach navigation}}
        {{#unless @first}},{{/unless}}
        {
          "@type": "SiteLinksSearchBox",
          "@id": "{{url absolute="true"}}",
          "name": "{{label}}",
          "url": "{{url absolute="true"}}"
        }
        {{/foreach}}
      ]
    },
    {
      "@type": "ItemList",
      "@id": "{{@site.url}}/#more-navigation",
      "name": "Contribute and Community",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "GitHub Repository",  "url": "https://github.com/imswarnil/Namaste-Salesforce" },
        { "@type": "ListItem", "position": 2, "name": "Documentation",      "url": "{{@site.url}}/docs/" },
        { "@type": "ListItem", "position": 3, "name": "Become an Author",   "url": "{{@site.url}}/contact/?ref=author" },
        { "@type": "ListItem", "position": 4, "name": "Become a Sponsor",   "url": "https://github.com/sponsors/imswarnil" },
        { "@type": "ListItem", "position": 5, "name": "Discord",            "url": "https://discord.gg/imswarnil" },
        { "@type": "ListItem", "position": 6, "name": "YouTube",            "url": "https://youtube.com/@imswarnil" },
        { "@type": "ListItem", "position": 7, "name": "Products I Use",     "url": "{{@site.url}}/products/" },
        { "@type": "ListItem", "position": 8, "name": "Schedule a Call",    "url": "https://topmate.io/imswarnil" }
      ]
    }
  ]
}
</script>

{{!-- ════════════════════════════════════════════════════════════════════════
  DISPATCH — choose header variant based on current post type
════════════════════════════════════════════════════════════════════════════ --}}
{{#is "post"}}{{#post}}{{#has tag="#lesson"}}

{{!-- ────────────────────────────────────────────────────────────────────────
  COURSE HEADER  (#lesson posts)

  Desktop  ≥1024px:
    LEFT   ← Back to Course  (icon + text)
    CENTER Course Name  ›  Lesson Name  (breadcrumb, both truncated)
    RIGHT  ✕  (closes / exits to course page)

  Mobile  <1024px:
    LEFT   ← Back to Course  (icon + text, label hides at ≤480px)
    CENTER Course Name  (truncated)
    RIGHT  ☰  (same 3-bar burger, opens right-side lesson drawer)

  Lesson drawer: position:fixed right-side overlay with backdrop.
  Position: sticky on all viewports.
──────────────────────────────────────────────────────────────────────────── --}}
<header class="course-header site-header" role="banner" id="siteHeader">

  <nav class="navbar course-header__navbar" role="navigation"
       aria-label="Course navigation">
    <div class="container">
      <div class="course-header__wrap">

        {{!-- LEFT: back to course --}}
        <div class="course-header__left">
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__back" href="{{url}}" aria-label="Back to {{title}}">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-label">Back to Course</span>
              </a>
            {{else}}
              <a class="course-header__back" href="/courses/" aria-label="Back to all courses">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-label">Back to Course</span>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

        {{!-- CENTER --}}
        <div class="course-header__center">
          {{!-- Desktop: Course › Lesson breadcrumb --}}
          <nav class="course-header__breadcrumb is-hidden-touch"
               aria-label="Course breadcrumb">
            {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
              {{#foreach posts}}
                <span class="course-header__course-name">{{title}}</span>
                <i class="ph ph-caret-right course-header__sep" aria-hidden="true"></i>
              {{/foreach}}
            {{/get}}
            <span class="course-header__lesson-name-title">{{title}}</span>
          </nav>
          {{!-- Mobile: course name only --}}
          <div class="course-header__mobile-title is-hidden-desktop">
            {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
              {{#foreach posts}}
                <span class="course-header__course-name">{{title}}</span>
              {{else}}
                <span class="course-header__course-name">Course</span>
              {{/foreach}}
            {{/get}}
          </div>
        </div>

        {{!-- RIGHT: desktop ✕ / mobile ☰ --}}
        <div class="course-header__right">
          {{!-- Desktop close --}}
          <div class="is-hidden-touch">
            {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
              {{#foreach posts}}
                <a class="course-header__close" href="{{url}}" aria-label="Exit course">
                  <i class="ph ph-x" aria-hidden="true"></i>
                </a>
              {{else}}
                <a class="course-header__close" href="/courses/" aria-label="Back to courses">
                  <i class="ph ph-x" aria-hidden="true"></i>
                </a>
              {{/foreach}}
            {{/get}}
          </div>
          {{!-- Mobile burger --}}
          <button class="course-header__burger is-hidden-desktop" type="button"
                  id="courseBurgerBtn"
                  aria-label="Show all lessons"
                  aria-expanded="false"
                  aria-controls="courseLessonPanel">
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
          </button>
        </div>

      </div>
    </div>
  </nav>

  {{!-- Lesson drawer: right-slide overlay (mobile only, hidden on desktop) --}}
  <div class="course-header__lesson-panel" id="courseLessonPanel"
       role="dialog" aria-modal="false"
       aria-label="Course lessons" aria-hidden="true">
    <div class="course-header__lesson-overlay" id="courseLessonOverlay"
         aria-hidden="true"></div>
    <div class="course-header__lesson-drawer">
      <div class="course-header__lesson-header">
        <p class="course-header__lesson-label">
          <i class="ph ph-list-checks" aria-hidden="true"></i>
          Course Lessons
        </p>
        <button class="course-header__lesson-close" type="button"
                id="coursePanelClose" aria-label="Close lesson list">
          <i class="ph ph-x" aria-hidden="true"></i>
        </button>
      </div>
      <div class="course-header__lesson-body">
        {{#get "posts"
          filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}"
          order="published_at asc"
          limit="100"
        }}
          {{#foreach posts}}
            <a href="{{url}}"
               class="course-header__lesson-link{{#match id ../../../../id}} is-active{{/match}}"
               data-lesson-num="{{@number}}"
               data-lesson-total="{{../length}}">
              <span class="course-header__lesson-num">{{@number}}</span>
              <span class="course-header__lesson-name">{{title}}</span>
              {{#match id ../../../../id}}
                <span class="course-header__lesson-dot" aria-label="Current lesson"></span>
              {{/match}}
            </a>
          {{/foreach}}
        {{/get}}
      </div>
    </div>
  </div>

</header>

{{else has tag="#blog"}}

{{!-- ────────────────────────────────────────────────────────────────────────
  BLOG HEADER  (#blog posts)
  Standard navbar + reading progress strip.
──────────────────────────────────────────────────────────────────────────── --}}
<header class="default-header blog-header site-header is-sticky"
        role="banner" id="siteHeader">
  <nav class="navbar default-header__navbar" role="navigation"
       aria-label="Main navigation">
    <div class="container default-header__wrap">

      <div class="navbar-brand default-header__brand-group">
        <a class="navbar-item default-header__brand"
           href="{{@site.url}}"
           aria-label="{{@site.title}} — homepage">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}"
                 class="default-header__logo" width="38" height="38"
                 loading="eager">
          {{/if}}
          <span class="default-header__title">{{@site.title}}</span>
        </a>

        {{!-- Brand divider → nav links --}}
        <span class="default-header__brand-sep is-hidden-touch" aria-hidden="true"></span>

        {{!-- Mobile toolbar: icon-only, no labels --}}
        <div class="default-header__mobile-tools is-hidden-desktop"
             role="group" aria-label="Quick actions">
          <button class="default-header__icon-btn" type="button"
                  aria-label="Search" data-ghost-search data-sound="swoosh">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </button>
          <button class="default-header__icon-btn" type="button"
                  aria-label="Switch to dark mode" data-theme-toggle>
            <i class="ph ph-moon" aria-hidden="true"></i>
          </button>
          <a class="default-header__icon-btn default-header__donate-btn--mob"
             href="https://github.com/sponsors/imswarnil"
             target="_blank" rel="noopener noreferrer"
             aria-label="Sponsor this project"
             data-donate>
            <i class="ph ph-currency-dollar" aria-hidden="true"></i>
          </a>
          <button class="default-header__burger" type="button"
