                  aria-label="Toggle navigation menu"
                  aria-expanded="false" aria-controls="blogNavMenu"
                  data-sound="click">
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <div id="blogNavMenu" class="navbar-menu default-header__menu" aria-hidden="true">
        <div class="navbar-start default-header__nav" id="blogNavLinks">
          {{navigation}}
        </div>
        <div class="navbar-end default-header__actions">

          {{!-- More ▾ mega-dropdown --}}
          <div class="navbar-item">
            <div class="dh-more-wrap" id="moreWrap">
              <button class="dh-more-btn" type="button"
                      id="moreBtn"
                      aria-haspopup="true" aria-expanded="false"
                      aria-controls="morePanel" data-sound="pop">
                <i class="ph ph-dots-three-bold" aria-hidden="true"></i>
                <span>More</span>
                <i class="ph ph-caret-down dh-more-caret" aria-hidden="true"></i>
              </button>
              <div class="dh-more-panel" id="morePanel" hidden>
                <div class="dh-more-body">
                  {{!-- Contribute --}}
