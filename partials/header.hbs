              <i class="ph ph-github-logo" aria-hidden="true"></i>
              <i class="ph ph-star default-header__github-star" aria-hidden="true"></i>
            </a>
          </div>
          {{!-- Donate — $ icon --}}
          <div class="navbar-item is-hidden-touch">
            <a class="default-header__donate-btn" id="donateBtnBlog"
               href="https://github.com/sponsors/imswarnil"
               target="_blank" rel="noopener noreferrer"
               aria-label="Sponsor this project">
              <i class="ph ph-currency-dollar" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

    </div>
  </nav>
</header>
<div class="blog-header__progress-strip" id="blogReadingStrip"
