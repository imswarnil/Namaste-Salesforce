<header class="site-header">
    <nav class="navbar site-navbar" role="navigation" aria-label="main navigation">
        <div class="container">
            <div class="navbar-brand">
                <a class="navbar-item site-navbar__brand" href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img
                            src="{{@site.logo}}"
                            alt="{{@site.title}}"
                            class="site-navbar__logo"
                            width="32"
                            height="32"
                        >
                    {{/if}}

                    <span class="site-navbar__title has-text-weight-semibold">
                        {{@site.title}}
                    </span>
                </a>

                <div class="site-navbar__mobile-tools is-hidden-desktop">
                    <button
                        class="button is-light is-small"
                        type="button"
                        aria-label="Search this site"
                        data-ghost-search
                    >
                        <span class="icon is-small">
                            <i class="ph ph-magnifying-glass"></i>
                        </span>
                    </button>

                    <button
                        class="button is-light is-small"
                        type="button"
                        aria-label="Toggle dark mode"
                        data-theme-toggle
                    >
                        <span class="icon is-small">
                            <i class="ph ph-moon"></i>
                        </span>
                    </button>

                    <button
                        class="navbar-burger"
                        type="button"
                        aria-label="menu"
                        aria-expanded="false"
                        aria-controls="siteNavbarMenu"
                        data-target="siteNavbarMenu"
                    >
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                    </button>
                </div>
            </div>

            <div id="siteNavbarMenu" class="navbar-menu">
                {{navigation}}

                <div class="navbar-start site-navbar__center js-site-nav-render"></div>

                <div class="navbar-end site-navbar__actions">
                    <div class="navbar-item is-hidden-touch">
                        <button
                            class="button is-light is-small"
                            type="button"
                            aria-label="Toggle dark mode"
                            data-theme-toggle
                        >
                            <span class="icon is-small">
                                <i class="ph ph-moon"></i>
                            </span>
                        </button>
                    </div>

                    <div class="navbar-item is-hidden-touch">
                        <button
                            class="button is-light is-small"
                            type="button"
                            aria-label="Search this site"
                            data-ghost-search
                        >
                            <span class="icon is-small">
                                <i class="ph ph-magnifying-glass"></i>
                            </span>
                            <span>Search</span>
                        </button>
                    </div>

                    {{#if @site.members_enabled}}
                        <div class="navbar-item">
                            <div class="buttons">
                                {{#unless @member}}
                                    {{#unless @site.members_invite_only}}
                                        <a
                                            class="button is-light is-small"
                                            href="#/portal/signin"
                                            data-portal="signin"
                                        >
                                            <span class="icon is-small">
                                                <i class="ph ph-sign-in"></i>
                                            </span>
                                            <span>Sign in</span>
                                        </a>

                                        <a
                                            class="button is-primary is-small"
                                            href="#/portal/signup"
                                            data-portal="signup"
                                        >
                                            <span class="icon is-small">
                                                <i class="ph ph-sparkle"></i>
                                            </span>
                                            <span>Subscribe</span>
                                        </a>
                                    {{else}}
                                        <a
                                            class="button is-primary is-small"
                                            href="#/portal/signin"
                                            data-portal="signin"
                                        >
                                            <span class="icon is-small">
                                                <i class="ph ph-sign-in"></i>
                                            </span>
                                            <span>Sign in</span>
                                        </a>
                                    {{/unless}}
                                {{else}}
                                    <a
                                        class="button is-primary is-small"
                                        href="#/portal/account"
                                        data-portal="account"
                                    >
                                        <span class="icon is-small">
                                            <i class="ph ph-user-circle"></i>
                                        </span>
                                        <span>Account</span>
                                    </a>
                                {{/unless}}
                            </div>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var html = document.documentElement;
    var storageKey = 'site-color-scheme';

    var header = document.querySelector('.site-header');
    var burger = header ? header.querySelector('.navbar-burger') : null;
    var menu = document.getElementById('siteNavbarMenu');
    var themeButtons = document.querySelectorAll('[data-theme-toggle]');
    var navSource = document.getElementById('site-nav-source');
    var navRender = document.querySelector('.js-site-nav-render');

    function getTheme() {
        return html.getAttribute('data-color-scheme') === 'dark' ? 'dark' : 'light';
    }

    function applyTheme(theme) {
        html.setAttribute('data-color-scheme', theme);
        localStorage.setItem(storageKey, theme);

        themeButtons.forEach(function (button) {
            var icon = button.querySelector('i');
            if (!icon) return;

            icon.className = theme === 'dark' ? 'ph ph-sun-dim' : 'ph ph-moon';
            button.setAttribute(
                'aria-label',
                theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
            );
        });
    }

    function readNavigationItems() {
        if (!navSource) return [];

        return Array.from(navSource.querySelectorAll('.js-site-nav-source-item')).map(function (item) {
            return {
                label: item.dataset.label || '',
                url: item.dataset.url || '#',
                slug: item.dataset.slug || '',
                current: item.dataset.current === 'true',
                icon: item.dataset.icon || 'ph-dot-outline'
            };
        });
    }

    function writeNavigationJson(items) {
        var existing = document.getElementById('site-navigation-json');
        if (existing) existing.remove();

        var jsonScript = document.createElement('script');
        jsonScript.id = 'site-navigation-json';
        jsonScript.type = 'application/json';
        jsonScript.textContent = JSON.stringify(items);

        if (navSource && navSource.parentNode) {
            navSource.parentNode.insertBefore(jsonScript, navSource.nextSibling);
        } else {
            document.body.appendChild(jsonScript);
        }
    }

    function stripChildPrefix(label) {
        return (label || '').replace(/^\s*-\s+/, '');
    }

    function isChildLabel(label) {
        return /^\s*-\s+/.test(label || '');
    }

    function createIcon(iconClass) {
        var span = document.createElement('span');
        span.className = 'icon is-small';

        var i = document.createElement('i');
        i.className = 'ph ' + iconClass;

        span.appendChild(i);
        return span;
    }

    function createText(text) {
        var span = document.createElement('span');
        span.textContent = text;
        return span;
    }

    function createNavAnchor(item, className) {
        var link = document.createElement('a');
        link.className = className;
        link.href = item.url;
        link.appendChild(createIcon(item.icon));
        link.appendChild(createText(stripChildPrefix(item.label)));

        if (item.current) {
            link.classList.add('is-active');
        }

        return link;
    }

    function buildNavigation(items) {
        if (!navRender) return;

        var fragment = document.createDocumentFragment();
        var i = 0;

        while (i < items.length) {
            var item = items[i];

            if (isChildLabel(item.label)) {
                i += 1;
                continue;
            }

            var next = items[i + 1];
            var hasChildren = !!(next && isChildLabel(next.label));

            if (!hasChildren) {
                fragment.appendChild(createNavAnchor(item, 'navbar-item'));
                i += 1;
                continue;
            }

            var dropdown = document.createElement('div');
            dropdown.className = 'navbar-item has-dropdown is-hoverable';

            var parentLink = createNavAnchor(item, 'navbar-link js-nav-parent-toggle');
            var dropdownMenu = document.createElement('div');
            dropdownMenu.className = 'navbar-dropdown';

            if (item.current) {
                parentLink.classList.add('is-active');
                dropdown.classList.add('has-current');
            }

            var j = i + 1;
            while (j < items.length && isChildLabel(items[j].label)) {
                var child = items[j];
                var childLink = createNavAnchor(child, 'navbar-item');

                if (child.current) {
                    childLink.classList.add('is-active');
                    parentLink.classList.add('is-active');
                    dropdown.classList.add('has-current');
                }

                dropdownMenu.appendChild(childLink);
                j += 1;
            }

            dropdown.appendChild(parentLink);
            dropdown.appendChild(dropdownMenu);
            fragment.appendChild(dropdown);

            i = j;
        }

        navRender.innerHTML = '';
        navRender.appendChild(fragment);
    }

    function closeMobileMenu() {
        if (!burger || !menu) return;

        burger.classList.remove('is-active');
        menu.classList.remove('is-active');
        burger.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('is-clipped');

        menu.querySelectorAll('.navbar-item.has-dropdown.is-active').forEach(function (item) {
            item.classList.remove('is-active');
        });
    }

    function toggleMobileMenu() {
        if (!burger || !menu) return;

        var active = burger.classList.toggle('is-active');
        menu.classList.toggle('is-active', active);
        burger.setAttribute('aria-expanded', active ? 'true' : 'false');
        document.body.classList.toggle('is-clipped', active);
    }

    var navItems = readNavigationItems();
    writeNavigationJson(navItems);
    buildNavigation(navItems);
    applyTheme(getTheme());

    if (header) {
        header.addEventListener('click', function (event) {
            var themeToggle = event.target.closest('[data-theme-toggle]');
            if (themeToggle) {
                applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
                return;
            }

            var burgerButton = event.target.closest('.navbar-burger');
            if (burgerButton) {
                toggleMobileMenu();
                return;
            }

            var parentToggle = event.target.closest('.js-nav-parent-toggle');
            if (parentToggle && window.innerWidth < 1024) {
                event.preventDefault();
                var parentItem = parentToggle.closest('.navbar-item.has-dropdown');
                if (parentItem) {
                    parentItem.classList.toggle('is-active');
                }
                return;
            }

            var clickedLink = event.target.closest('#siteNavbarMenu a.navbar-item');
            if (clickedLink && window.innerWidth < 1024) {
                if (!clickedLink.classList.contains('navbar-link')) {
                    closeMobileMenu();
                }
            }
        });
    }

    window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024) {
            closeMobileMenu();
        }
    });
});
</script>