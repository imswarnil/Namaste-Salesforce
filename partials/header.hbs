{{!-- =========================================================================
  partials/header.hbs  ·  Namaste Salesforce  (single-file, no sub-partials)

  BRAND STRIP (next to logo, desktop):
    [Learn ▾] [Contribute ▾] [Products ▾]
    — "Learn" and "Topics" removed; replaced with richer context dropdowns.

  RIGHT RAIL (desktop, always clean):
    [Search] [Theme 🔊] [Account / Sign in] [GitHub ⭐] [$]

  SOUNDS:
    Theme toggle   → rooster chirp (light) / owl hoot (dark)
    Mobile burger  → soft "tok" click
    Dropdown open  → very short "pop"
    Search modal   → swoosh / whoosh
    $ hover        → coins jingle

  BRAND ANIMATION:
    "Namaste Salesforce" cycles through 10 languages with a fast wobble
    transition every 2.4 s. A small 🔊 speaker button sits to the top-right
    of the brand text; click it to hear "Namaste Salesforce" spoken aloud
    via Web Speech API, cycling through different voices / pitches.
========================================================================== --}}

{{!-- ── JSON-LD ──────────────────────────────────────────────────────────── --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}"{{#if @site.description}},
      "description": "{{@site.description}}"{{/if}},
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": { "@type": "ImageObject", "url": "{{@site.logo}}" }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{@site.url}}/?s={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "@id": "{{@site.url}}/#site-navigation",
      "name": "Site Navigation",
      "itemListElement": [
        {{#foreach navigation}}
          {{#match label "~^" "- "}}{{else}}
          { "@type": "ListItem", "position": {{@number}}, "name": "{{label}}", "url": "{{url absolute="true"}}" }{{#unless @last}},{{/unless}}
          {{/match}}
        {{/foreach}}
      ]
    }
  ]
}
</script>

{{!-- ═══════════════════════════════════════════════════════════════════════
  BRAND DROPDOWN PARTIALS  (reused by all three header variants via macros)
