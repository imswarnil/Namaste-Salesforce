{{!-- ═══════════════════════════════════════════════════════════════════════
  partials/header.hbs — Pure Bulma (v1+), single file, no custom classes
  ═══════════════════════════════════════════════════════════════════════
  Contexts (all in this one file):
    [1] #training-content → dark fixed navbar + breadcrumb + curriculum burger
    [2] #training         → dark fixed navbar + Start Training CTA
    [3] #lesson           → fixed navbar + lesson-list burger + prev/next
    [4] #course           → fixed navbar + Start Course CTA
    [5] #blog             → fixed navbar + reading progress (<progress>)
    [6] documentation     → fixed navbar + All Docs + GitHub
    [7] #videos           → fixed navbar
    [8] default post      → fixed navbar + GitHub
    [—] non-post pages    → fixed navbar + GitHub

  Dark mode: Bulma v1 native. <html data-theme="dark"|"light">.
  Persists to localStorage; respects OS on first load.

  Brand: logo (if set) + site title together.
  Badges: use Bulma .tag is-*-light.
  Breadcrumb: use Bulma .breadcrumb.
  Reading progress: use Bulma <progress> element.
═══════════════════════════════════════════════════════════════════════ --}}

{{#post}}

{{!-- ───────────────── [1] TRAINING-CONTENT ───────────────── --}}
{{#has tag="#training, #training-content"}}
<nav class="navbar has-shadow" id="ns-navbar" role="navigation" aria-label="Training player navigation">
  <div class="container">
    
    {{!-- 1. BRAND & MOBILE TITLE ─── --}}
    <div class="navbar-brand">
      <a class="navbar-item" href="{{@site.url}}">
        {{#if @site.logo}}
          <img src="{{@site.logo}}" alt="{{@site.title}}" style="max-height: 2rem;">
        {{else}}
          <span class="has-text-weight-bold is-size-5">{{@site.title}}</span>
        {{/if}}
      </a>

      {{!-- Mobile Breadcrumb Fragment --}}
      <div class="navbar-item is-hidden-desktop px-2">
        <span class="icon is-small has-text-grey-light mr-2"><i class="ph ph-caret-right"></i></span>
        <span class="has-text-weight-semibold is-size-7 is-truncated" style="max-width: 40vw;">{{title}}</span>
      </div>

      <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="nsTcMenu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </a>
    </div>

    {{!-- 2. DESKTOP BREADCRUMB ─── --}}
    <div id="nsTcMenu" class="navbar-menu">
      <div class="navbar-start is-flex-grow-1 is-flex is-align-items-center">
        
        {{!-- Breadcrumb Flow --}}
        <div class="navbar-item is-hidden-touch">
          <nav class="breadcrumb has-succeeds-separator mb-0" aria-label="breadcrumbs">
            <ul>
              <li><a href="/training/" class="has-text-grey">Training</a></li>
              {{#get "posts" filter="tag:hash-training+slug:{{primary_tag.slug}}" limit="1"}}
                {{#foreach posts}}
                  <li><a href="{{url}}" class="has-text-grey">{{title}}</a></li>
                {{/foreach}}
              {{/get}}
              <li class="is-active"><a href="#" aria-current="page" class="has-text-weight-bold">{{title}}</a></li>
            </ul>
          </nav>
        </div>
      </div>

      {{!-- 3. MOBILE MENU & GLOBAL ACTIONS ─── --}}
      <div class="navbar-end">
        {{!-- Full Height Mobile Curriculum Panel --}}
        <div class="navbar-item is-hidden-desktop px-4 py-5" style="height: calc(100vh - 3.25rem); overflow-y: auto;">
          <aside class="menu">
            <p class="menu-label is-size-7 has-text-weight-bold is-uppercase has-text-grey">Course Curriculum</p>
            {{#get "posts" filter="tag:hash-training" order="published_at asc" limit="all"}}
              {{#foreach posts}}
                <p class="menu-label is-size-7 has-text-weight-bold has-text-link mt-5 mb-2">{{title}}</p>
                <ul class="menu-list">
                  {{#get "posts" filter="tag:hash-training-content+primary_tag:{{slug}}" order="published_at asc" limit="all" as |lessons|}}
                    {{#foreach lessons}}
                      <li>
                        <a href="{{url}}" class="{{#match id ../../../../id}}is-active{{/match}} py-3 is-rounded">
                          <span class="icon is-small mr-2">
                            <i class="{{#match id ../../../../id}}ph-fill ph-play-circle{{else}}ph ph-circle{{/match}}"></i>
                          </span>
                          <span>{{title}}</span>
                        </a>
                      </li>
                    {{/foreach}}
                  {{/get}}
                </ul>
              {{/foreach}}
            {{/get}}
          </aside>
          <hr class="navbar-divider mt-5">
        </div>

        {{!-- Action Buttons --}}
        <div class="navbar-item">
          <div class="buttons is-flex-wrap-nowrap">
            {{!-- GitHub Star --}}
            <a class="button is-small is-rounded is-dark" 
               href="https://github.com/imswarnil/Namaste-Salesforce" 
               target="_blank" rel="noopener">
              <span class="icon is-small"><i class="ph ph-github-logo"></i></span>
              <span class="is-hidden-touch">Star</span>
            </a>

            {{!-- Theme Toggle --}}
            <button class="button is-small is-rounded is-light" data-theme-toggle title="Toggle Theme">
              <span class="icon is-small"><i class="ph ph-moon"></i></span>
            </button>

            {{!-- Exit Player --}}
            <a class="button is-small is-rounded is-danger is-light has-text-weight-bold" href="/training/">
              <span class="icon is-small"><i class="ph ph-x"></i></span>
              <span>Exit</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

{{!-- ───────────────── [3] LESSON ───────────────── --}}
{{else has tag="#lesson"}}
<nav class="navbar has-shadow" id="ns-navbar" role="navigation" aria-label="Lesson navigation">
  <div class="container is-fluid">
    <div class="navbar-brand is-flex-grow-1">
      
      {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
        {{#foreach posts}}
          <a class="navbar-item has-text-link has-text-weight-semibold" href="{{url}}">
            <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
            <span class="is-hidden-mobile">{{title}}</span>
            <span class="is-hidden-desktop">Course</span>
          </a>
        {{/foreach}}
      {{/get}}

    <div class="navbar-item is-flex-grow-1 is-flex is-align-items-center px-4">
  <span class="is-size-7 has-text-grey has-text-weight-semibold mr-3 is-hidden-mobile">Progress</span>
  
  <progress id="course-progress-bar" class="progress is-primary is-small mb-0 is-flex-grow-1" value="0" max="100">0%</progress>
  
  <span id="course-progress-text" class="is-size-7 has-text-weight-bold ml-3">0%</span>

  {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" order="published_at asc" limit="all"}}
    <script>
      let currentLessonNumber = 0;
      let totalLessonsCount = 0;

      {{#foreach posts}}
        {{#match id ../../id}}
          currentLessonNumber = {{@number}};
        {{/match}}
        
        {{#if @last}}
          totalLessonsCount = {{@number}};
        {{/if}}
      {{/foreach}}

      document.addEventListener('DOMContentLoaded', function() {
        if (totalLessonsCount > 0 && currentLessonNumber > 0) {
          let percent = Math.round((currentLessonNumber / totalLessonsCount) * 100);
          
          let progressBar = document.getElementById('course-progress-bar');
          let progressText = document.getElementById('course-progress-text');
          
          if (progressBar) {
            progressBar.value = percent;
            progressBar.innerText = percent + '%';
          }
          if (progressText) {
            progressText.innerText = percent + '%';
          }
        }
      });
    </script>
  {{/get}}
</div>
      <a role="button" class="navbar-burger" aria-label="Toggle lesson list"
         aria-expanded="false" data-target="nsLessonMenu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </a>
    </div>
    
    <div id="nsLessonMenu" class="navbar-menu">
      <div class="navbar-start is-hidden-desktop">
        <div class="navbar-item">
          <aside class="menu" style="width:100%;">
            <p class="menu-label">Course Lessons</p>
            <ul class="menu-list">
              {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" order="published_at asc" limit="100"}}
                {{#foreach posts}}
                  <li><a href="{{url}}" class="{{#match id ../../id}}is-active{{/match}}">{{@number}}. {{title}}</a></li>
                {{/foreach}}
              {{/get}}
            </ul>
          </aside>
        </div>
      </div>
      <div class="navbar-end">
        <div class="navbar-item">
          <div class="buttons">
            <button class="button is-small is-rounded" data-theme-toggle aria-label="Toggle dark mode">
              <span class="icon is-small"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg></span>
            </button>
            {{#prev_post in="primary_tag" filter="tag:hash-lesson"}}
              <a class="button is-small is-rounded" href="{{url}}" aria-label="Previous lesson">
                <span class="icon is-small"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg></span>
              </a>
            {{/prev_post}}
            {{#next_post in="primary_tag" filter="tag:hash-lesson"}}
              <a class="button is-link is-small is-rounded has-text-weight-bold" href="{{url}}">
                <span class="is-hidden-mobile">Next</span>
                <span class="icon is-small"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
              </a>
            {{else}}
              {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
                {{#foreach posts}}
                  <a class="button is-success is-small is-rounded has-text-weight-bold" href="{{url}}">
                    <span class="icon is-small"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z"/></svg></span>
                    <span class="is-hidden-mobile">Done</span>
                  </a>
                {{/foreach}}
              {{/get}}
            {{/next_post}}
            <a class="button is-small is-rounded" href="/courses/" aria-label="Exit">
              <span class="icon is-small"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

