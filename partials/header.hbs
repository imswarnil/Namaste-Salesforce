{{!-- ──────────────────────────────────────────────────────────────────
  DEFAULT HEADER  (non-post pages: home, tags, authors, etc.)
  Identical markup to the post default above.
────────────────────────────────────────────────────────────────────── --}}
<header class="default-header site-header{{#if @custom.sticky_header}} is-sticky{{/if}}"
        role="banner" id="siteHeader">
  <nav class="navbar default-header__navbar" role="navigation"
       aria-label="Main navigation">
    <div class="container default-header__wrap">
      <div class="navbar-brand default-header__brand-group">
        <a class="navbar-item default-header__brand"
           href="{{@site.url}}" aria-label="{{@site.title}} — go to homepage">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}"
                 class="default-header__logo" width="32" height="32">
          {{/if}}
          <span class="default-header__title">{{@site.title}}</span>
        </a>
        <span class="default-header__brand-sep is-hidden-touch" aria-hidden="true"></span>
        <div class="default-header__learn-wrap is-hidden-touch" id="learnDropdownWrapP">
          <button class="default-header__learn-btn" type="button"
                  id="learnDropdownBtnP"
                  aria-haspopup="true" aria-expanded="false">
            <i class="ph ph-graduation-cap" aria-hidden="true"></i>
            <span>Learn</span>
            <i class="ph ph-caret-down default-header__learn-caret" aria-hidden="true"></i>
          </button>
          <div class="default-header__learn-panel" id="learnDropdownP" hidden>
            <p class="default-header__learn-heading">Learning Paths</p>
            <div class="default-header__learn-grid">
              <a class="default-header__learn-item" href="/training/">
                <span class="default-header__learn-icon"><i class="ph ph-user-gear" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Admin</strong><small>Manage orgs &amp; users</small></span>
              </a>
              <a class="default-header__learn-item" href="/courses/">
                <span class="default-header__learn-icon"><i class="ph ph-code" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Developer</strong><small>Apex, LWC &amp; APIs</small></span>
              </a>
              <a class="default-header__learn-item" href="/courses/">
                <span class="default-header__learn-icon"><i class="ph ph-chart-line-up" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Analytics</strong><small>CRM Analytics &amp; CRMA</small></span>
              </a>
              <a class="default-header__learn-item" href="/certifications/">
                <span class="default-header__learn-icon"><i class="ph ph-trophy" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Exam Prep</strong><small>Cert study guides</small></span>
              </a>
              <a class="default-header__learn-item" href="/resources/">
                <span class="default-header__learn-icon"><i class="ph ph-books" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Resources</strong><small>Books, tools &amp; more</small></span>
              </a>
              <a class="default-header__learn-item" href="/videos/">
                <span class="default-header__learn-icon"><i class="ph ph-play-circle" aria-hidden="true"></i></span>
                <span class="default-header__learn-label"><strong>Videos</strong><small>Watch &amp; learn</small></span>
              </a>
            </div>
            <div class="default-header__learn-footer">
              <a href="/courses/" class="default-header__learn-all">
                Browse all courses
                <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
        <div class="default-header__mobile-tools is-hidden-desktop">
          <button class="default-header__icon-btn" type="button" aria-label="Search" data-ghost-search>
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </button>
          <button class="default-header__icon-btn" type="button" aria-label="Switch to dark mode" data-theme-toggle>
            <i class="ph ph-moon" aria-hidden="true"></i>
          </button>
          <button class="default-header__burger" type="button"
                  id="defaultNavBurger" aria-label="Toggle menu"
                  aria-expanded="false" aria-controls="defaultNavMenu">
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <div id="defaultNavMenu" class="navbar-menu default-header__menu" aria-hidden="true">
        <div class="navbar-start default-header__nav" id="defaultNavLinks">
          {{navigation}}
        </div>
        <div class="navbar-end default-header__actions">
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button" aria-label="Search" data-ghost-search>
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            </button>
          </div>
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button" aria-label="Switch to dark mode" data-theme-toggle>
              <i class="ph ph-moon" aria-hidden="true"></i>
            </button>
          </div>
          {{#if @site.members_enabled}}
            {{#if @member}}
              <div class="navbar-item">
                <div class="default-header__account-wrap" id="accountWrap">
                  <button class="default-header__account-btn" type="button"
                          id="accountBtn" aria-label="Account menu"
                          aria-expanded="false" aria-haspopup="true">
                    {{#if @member.avatar_image}}
                      <img src="{{@member.avatar_image}}" alt="{{@member.name}}"
                           class="default-header__account-avatar" width="28" height="28">
                    {{else}}
                      <i class="ph-fill ph-user-circle default-header__account-icon" aria-hidden="true"></i>
                    {{/if}}
                    <span class="default-header__account-name-label is-hidden-mobile">{{@member.name}}</span>
                    <i class="ph ph-caret-down default-header__account-caret" aria-hidden="true"></i>
                  </button>
                  <div class="default-header__account-dropdown" id="accountDropdown" hidden>
                    <div class="default-header__account-header">
                      <p class="default-header__account-name">{{@member.name}}</p>
                      <p class="default-header__account-email">{{@member.email}}</p>
                    </div>
                    <hr class="default-header__divider">
                    <a class="default-header__dropdown-item" href="#/portal/account" data-portal="account">
                      <i class="ph ph-user" aria-hidden="true"></i><span>Manage account</span>
                    </a>
                    <a class="default-header__dropdown-item" href="#/portal/account/newsletters" data-portal="account/newsletters">
                      <i class="ph ph-envelope" aria-hidden="true"></i><span>Newsletters</span>
                    </a>
                    <hr class="default-header__divider">
                    <a class="default-header__dropdown-item default-header__dropdown-item--danger"
                       href="javascript:void(0)" data-members-signout>
                      <i class="ph ph-sign-out" aria-hidden="true"></i><span>Sign out</span>
                    </a>
                  </div>
                </div>
              </div>
            {{else}}
              {{#unless @site.members_invite_only}}
                <div class="navbar-item default-header__auth-pair">
                  <a class="default-header__btn default-header__btn--ghost"
                     href="#/portal/signin" data-portal="signin">
                    <i class="ph ph-sign-in" aria-hidden="true"></i><span>Sign in</span>
                  </a>
                  <a class="default-header__btn default-header__btn--primary"
                     href="#/portal/signup" data-portal="signup">
                    <i class="ph ph-user-plus" aria-hidden="true"></i><span>Join free</span>
                  </a>
                </div>
              {{else}}
                <div class="navbar-item">
                  <a class="default-header__btn default-header__btn--primary"
                     href="#/portal/signin" data-portal="signin">
                    <i class="ph ph-sign-in" aria-hidden="true"></i><span>Sign in</span>
                  </a>
                </div>
              {{/unless}}
            {{/if}}
          {{/if}}
          <div class="navbar-item is-hidden-touch">
            <a class="default-header__donate-btn"
               href="https://github.com/sponsors/imswarnil"
               target="_blank" rel="noopener noreferrer"
               aria-label="Sponsor this project on GitHub Sponsors">
              <i class="ph-fill ph-heart" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

{{/is}}

{{!-- ════════════════════════════════════════════════════════════════════
  SHARED JAVASCRIPT  (runs for all three variants)
════════════════════════════════════════════════════════════════════════ --}}
<script>
(function () {
  'use strict';

  // ─── Theme sounds ──────────────────────────────────────────────────────────
  var prefersNoMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function playRooster() {
    if (prefersNoMotion) return;
    try {
      var ctx = new (window.AudioContext || window.webkitAudioContext)();
      // Three ascending chirps: C5 → E5 → G5
      [523, 659, 784].forEach(function (f, i) {
        var osc  = ctx.createOscillator();
        var gain = ctx.createGain();
        var t    = ctx.currentTime + i * 0.14;
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f * 0.84, t);
        osc.frequency.exponentialRampToValueAtTime(f, t + 0.05);
        gain.gain.setValueAtTime(0, t);
        gain.gain.linearRampToValueAtTime(0.14, t + 0.04);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(t); osc.stop(t + 0.22);
      });
      setTimeout(function () { try { ctx.close(); } catch (e) {} }, 800);
    } catch (e) {}
  }

  function playOwl() {
    if (prefersNoMotion) return;
    try {
      var ctx = new (window.AudioContext || window.webkitAudioContext)();
      // Two descending hoots: G4 → D4
      [392, 294].forEach(function (f, i) {
        var osc  = ctx.createOscillator();
        var gain = ctx.createGain();
        var t    = ctx.currentTime + i * 0.3;
        osc.type = 'sine';
        osc.frequency.setValueAtTime(f, t);
        osc.frequency.exponentialRampToValueAtTime(f * 0.87, t + 0.22);
        gain.gain.setValueAtTime(0, t);
        gain.gain.linearRampToValueAtTime(0.11, t + 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.32);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(t); osc.stop(t + 0.36);
      });
      setTimeout(function () { try { ctx.close(); } catch (e) {} }, 900);
    } catch (e) {}
  }

  // ─── Theme toggle ──────────────────────────────────────────────────────────
  var SK  = 'site-color-scheme';
  var doc = document.documentElement;

  function getTheme() { return doc.getAttribute('data-color-scheme') === 'dark' ? 'dark' : 'light'; }
  function applyTheme(t) { doc.setAttribute('data-color-scheme', t); localStorage.setItem(SK, t); syncUI(t); }
  function syncUI(t) {
    var dark = t === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
      var ic = b.querySelector('i');
      if (ic) ic.className = dark ? 'ph ph-sun-dim' : 'ph ph-moon';
      b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    });
  }

  var sv = localStorage.getItem(SK);
  syncUI((sv === 'light' || sv === 'dark') ? sv : getTheme());

  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-theme-toggle]')) return;
    var next = getTheme() === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    if (next === 'light') playRooster(); else playOwl();
  });

  // ─── Mobile burger (default + blog) ───────────────────────────────────────
  function initBurger(burgerId, menuId) {
    var burger = document.getElementById(burgerId);
    var menu   = document.getElementById(menuId);
    var hdr    = document.getElementById('siteHeader');
    if (!burger || !menu) return;
    function toggle(force) {
      var open = force !== undefined ? force : !burger.classList.contains('is-open');
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      if (hdr) hdr.classList.toggle('menu-is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }
    burger.addEventListener('click', function () { toggle(); });
    document.addEventListener('click', function (e) {
      if (menu.classList.contains('is-open') &&
          !menu.contains(e.target) && !burger.contains(e.target)) toggle(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) { toggle(false); burger.focus(); }
    });
  }
  initBurger('defaultNavBurger', 'defaultNavMenu');
  initBurger('blogNavBurger',    'blogNavMenu');

  // ─── Generic dropdown factory ──────────────────────────────────────────────
  function makeDropdown(btnId, panelId, wrapId) {
    var btn   = document.getElementById(btnId);
    var panel = document.getElementById(panelId);
    var wrap  = document.getElementById(wrapId);
    if (!btn || !panel) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('is-open', open);
    });
    document.addEventListener('click', function (e) {
      if (wrap && !wrap.contains(e.target)) {
        panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); btn.classList.remove('is-open');
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); btn.classList.remove('is-open'); btn.focus();
      }
    });
  }
  makeDropdown('learnDropdownBtn',  'learnDropdown',  'learnDropdownWrap');
  makeDropdown('learnDropdownBtnP', 'learnDropdownP', 'learnDropdownWrapP');
  makeDropdown('topicsDropdownBtn', 'topicsDropdown', 'topicsDropdownWrap');
  makeDropdown('accountBtn',        'accountDropdown','accountWrap');

  // ─── Member initials (fallback when no avatar) ─────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    var initialsEl = document.getElementById('memberInitials');
    if (initialsEl) {
      var nameEl = document.querySelector('.default-header__account-name');
      if (nameEl) {
        initialsEl.textContent = nameEl.textContent.trim()
          .split(/\s+/).map(function (w) { return w[0] || ''; }).slice(0, 2).join('').toUpperCase();
      }
    }
  });

  // ─── Nav dropdown builder ──────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    ['defaultNavLinks', 'blogNavLinks'].forEach(function (navId) {
      var nav = document.getElementById(navId);
      if (!nav) return;
      var items = Array.from(nav.querySelectorAll('.default-header__nav-item'));
      var cur   = null;
      items.forEach(function (el) {
        if (el.getAttribute('data-child') === 'true' && cur) {
          var lbl = el.querySelector('.default-header__nav-label');
          if (lbl) lbl.textContent = lbl.textContent.replace(/^[-–]\s*/, '').trim();
          var li = document.createElement('li');
          li.appendChild(el);
          cur.list.appendChild(li);
        } else {
          var wrap = document.createElement('div');
          wrap.className = 'default-header__dropdown-wrap';
          el.parentNode.insertBefore(wrap, el);
          wrap.appendChild(el);
          var list = document.createElement('ul');
          list.className = 'default-header__dropdown-menu';
          list.setAttribute('role', 'menu');
          wrap.appendChild(list);
          cur = { wrap: wrap, trigger: el, list: list };
        }
      });
      nav.querySelectorAll('.default-header__dropdown-wrap').forEach(function (wrap) {
        var list = wrap.querySelector('.default-header__dropdown-menu');
        var item = wrap.querySelector('.default-header__nav-item');
        if (!list || !list.children.length) {
          if (item) wrap.parentNode.insertBefore(item, wrap);
          wrap.remove(); return;
        }
        wrap.classList.add('has-dropdown');
        if (item) {
          item.classList.add('has-dropdown-trigger');
          item.setAttribute('aria-haspopup', 'true');
          item.setAttribute('aria-expanded', 'false');
          var chev = document.createElement('i');
          chev.className = 'ph ph-caret-down default-header__dropdown-chevron';
          chev.setAttribute('aria-hidden', 'true');
          item.appendChild(chev);
        }
      });
      nav.addEventListener('click', function (e) {
        var t = e.target.closest('.has-dropdown-trigger');
        if (!t || window.innerWidth >= 1024) return;
        e.preventDefault();
        var w = t.closest('.has-dropdown'), isOpen = w.classList.contains('is-open');
        nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) {
          d.classList.remove('is-open');
          var dt = d.querySelector('.has-dropdown-trigger');
          if (dt) dt.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) { w.classList.add('is-open'); t.setAttribute('aria-expanded', 'true'); }
      });
      document.addEventListener('click', function (e) {
        if (!nav.contains(e.target)) {
          nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) { d.classList.remove('is-open'); });
        }
      });
    });
  });

  // ─── Course header ─────────────────────────────────────────────────────────
  (function () {
    var titleBtn  = document.getElementById('coursePanelBurger');
    var burgerBtn = document.getElementById('courseBurgerBtn');
    var panel     = document.getElementById('courseLessonPanel');
    if (!panel) return;
    function togglePanel(force) {
      var open = force !== undefined ? force : !panel.classList.contains('is-open');
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      [titleBtn, burgerBtn].forEach(function (b) { if (b) b.setAttribute('aria-expanded', String(open)); });
      if (titleBtn) {
        var c = titleBtn.querySelector('.course-header__title-caret');
        if (c) c.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
      }
      if (burgerBtn) burgerBtn.classList.toggle('is-open', open);
    }
    [titleBtn, burgerBtn].forEach(function (b) { if (b) b.addEventListener('click', function () { togglePanel(); }); });
    document.addEventListener('click', function (e) {
      if (panel.classList.contains('is-open') &&
          !panel.contains(e.target) &&
          !(titleBtn && titleBtn.contains(e.target)) &&
          !(burgerBtn && burgerBtn.contains(e.target))) togglePanel(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        togglePanel(false); if (burgerBtn) burgerBtn.focus();
      }
    });
    document.addEventListener('DOMContentLoaded', function () {
      var active = document.querySelector('.course-header__lesson-link.is-active');
      var badge  = document.getElementById('lessonBadgeText');
      if (active && badge) {
        badge.textContent = (active.getAttribute('data-lesson-num') || '?') +
                            ' / ' + (active.getAttribute('data-lesson-total') || '?');
      }
      if (active) active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  })();

  // ─── Blog reading progress ─────────────────────────────────────────────────
  (function () {
    var fill  = document.getElementById('blogReadingFill');
    var strip = document.getElementById('blogReadingStrip');
    if (!fill) return;
    function update() {
      var content = document.querySelector('.gh-content, .js-post-content');
      var pct;
      if (content) {
        var s = content.getBoundingClientRect().top + window.scrollY;
        var e = s + content.offsetHeight - window.innerHeight;
        pct = Math.min(100, Math.max(0, Math.round(((window.scrollY - s) / Math.max(1, e - s)) * 100)));
      } else {
        pct = Math.min(100, Math.round(window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight) * 100));
      }
      fill.style.width = pct + '%';
      if (strip) strip.setAttribute('aria-valuenow', pct);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();

})();
</script>
