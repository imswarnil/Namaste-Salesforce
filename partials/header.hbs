{{!-- ══════════════════════════════════════════════════════════════════════
  SHARED JS — runs for all three variants
══════════════════════════════════════════════════════════════════════════ --}}
<script>
(function () {
  'use strict';

  // ── Theme ──────────────────────────────────────────────────────────────────
  var SK = 'site-color-scheme';
  var doc = document.documentElement;
  function getTheme() { return doc.getAttribute('data-color-scheme') === 'dark' ? 'dark' : 'light'; }
  function applyTheme(t) { doc.setAttribute('data-color-scheme', t); localStorage.setItem(SK, t); syncUI(t); }
  function syncUI(t) {
    document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
      var ic = b.querySelector('i');
      if (ic) ic.className = t === 'dark' ? 'ph ph-sun-dim' : 'ph ph-moon';
      b.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    });
  }
  syncUI(localStorage.getItem(SK) === 'dark' ? 'dark' : getTheme());
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-theme-toggle]')) applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

  // ── GitHub star count ──────────────────────────────────────────────────────
  var cached = sessionStorage.getItem('gh-stars');
  function updateStarEls(n) {
    if (!n) return;
    var txt = n >= 1000 ? (n / 1000).toFixed(1) + 'k' : String(n);
    document.querySelectorAll('.dh-github-count').forEach(function (el) {
      el.textContent = txt;
      el.hidden = false;
    });
  }
  if (cached) {
    updateStarEls(parseInt(cached, 10));
  } else {
    fetch('https://api.github.com/repos/imswarnil/Namaste-Salesforce')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.stargazers_count) {
          sessionStorage.setItem('gh-stars', d.stargazers_count);
          updateStarEls(d.stargazers_count);
        }
      }).catch(function () {});
  }

  // ── Generic dropdown factory ───────────────────────────────────────────────
  function makeDropdown(btnId, panelId, wrapId) {
    var btn   = document.getElementById(btnId);
    var panel = document.getElementById(panelId);
    var wrap  = wrapId ? document.getElementById(wrapId) : null;
    if (!btn || !panel) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('is-open', open);
      var caret = btn.querySelector('.dh-support-caret');
      if (caret) caret.style.transform = open ? 'rotate(180deg)' : '';
    });
    document.addEventListener('click', function (e) {
      if (wrap && !wrap.contains(e.target)) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
        var c = btn.querySelector('.dh-support-caret');
        if (c) c.style.transform = '';
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
        btn.focus();
      }
    });
  }
  // Support dropdowns (each variant has unique IDs)
  makeDropdown('dhSupportBtnPage', 'dhSupportPanelPage', 'dhSupportWrapPage');
  makeDropdown('dhSupportBtnPost', 'dhSupportPanelPost', 'dhSupportWrapPost');
  makeDropdown('dhSupportBtnBlog', 'dhSupportPanelBlog', 'dhSupportWrapBlog');
  // Account dropdowns
  makeDropdown('accountBtn',     'accountDropdown',     'accountWrap');
  makeDropdown('accountBtnPost', 'accountDropdownPost', 'accountWrapPost');
  makeDropdown('accountBtnBlog', 'accountDropdownBlog', 'accountWrapBlog');

  // ── Member initials ────────────────────────────────────────────────────────
  ['memberInitials', 'memberInitialsPost', 'memberInitialsBlog'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    var nameEl = el.closest('.default-header__account-dropdown')
                   ? el.closest('.default-header__account-dropdown')
                       .querySelector('.default-header__account-name')
                   : document.querySelector('.default-header__account-name');
    if (nameEl) {
      el.textContent = nameEl.textContent.trim()
        .split(/\s+/).map(function (w) { return w[0] || ''; }).slice(0, 2).join('').toUpperCase();
    }
  });

  // ── Mobile burger ──────────────────────────────────────────────────────────
  function initBurger(burgerId, menuId) {
    var burger = document.getElementById(burgerId);
    var menu   = document.getElementById(menuId);
    var hdr    = document.getElementById('siteHeader');
    if (!burger || !menu) return;
    function toggle(force) {
      var open = force !== undefined ? force : !burger.classList.contains('is-open');
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      if (hdr) hdr.classList.toggle('menu-is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }
    burger.addEventListener('click', function () { toggle(); });
    document.addEventListener('click', function (e) {
      if (menu.classList.contains('is-open') &&
          !menu.contains(e.target) && !burger.contains(e.target)) toggle(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) { toggle(false); burger.focus(); }
    });
  }
  initBurger('defaultNavBurger', 'defaultNavMenu');
  initBurger('blogNavBurger',    'blogNavMenu');

  // ── Nav dropdown builder ───────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    ['defaultNavLinks', 'blogNavLinks'].forEach(function (navId) {
      var nav = document.getElementById(navId);
      if (!nav) return;
      var items = Array.from(nav.querySelectorAll('.default-header__nav-item'));
      var cur   = null;
      items.forEach(function (el) {
        if (el.dataset.child === 'true' && cur) {
          var lbl = el.querySelector('.default-header__nav-label');
          if (lbl) lbl.textContent = lbl.textContent.replace(/^[\-–]\s*/, '').trim();
          var li = document.createElement('li');
          li.appendChild(el);
          cur.list.appendChild(li);
        } else {
          var wrap = document.createElement('div');
          wrap.className = 'default-header__dropdown-wrap';
          el.parentNode.insertBefore(wrap, el);
          wrap.appendChild(el);
          var list = document.createElement('ul');
          list.className = 'default-header__dropdown-menu';
          list.setAttribute('role', 'menu');
          wrap.appendChild(list);
          cur = { wrap: wrap, trigger: el, list: list };
        }
      });
      nav.querySelectorAll('.default-header__dropdown-wrap').forEach(function (wrap) {
        var list = wrap.querySelector('.default-header__dropdown-menu');
        var item = wrap.querySelector('.default-header__nav-item');
        if (!list || !list.children.length) {
          if (item) wrap.parentNode.insertBefore(item, wrap);
          wrap.remove(); return;
        }
        wrap.classList.add('has-dropdown');
        if (item) {
          item.classList.add('has-dropdown-trigger');
          item.setAttribute('aria-haspopup', 'true');
          item.setAttribute('aria-expanded', 'false');
          var chev = document.createElement('i');
          chev.className = 'ph ph-caret-down default-header__dropdown-chevron';
          chev.setAttribute('aria-hidden', 'true');
          item.appendChild(chev);
        }
      });
      nav.addEventListener('click', function (e) {
        var t = e.target.closest('.has-dropdown-trigger');
        if (!t || window.innerWidth >= 1024) return;
        e.preventDefault();
        var w = t.closest('.has-dropdown');
        var isOpen = w.classList.contains('is-open');
        nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) {
          d.classList.remove('is-open');
          var dt = d.querySelector('.has-dropdown-trigger');
          if (dt) dt.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) { w.classList.add('is-open'); t.setAttribute('aria-expanded', 'true'); }
      });
      document.addEventListener('click', function (e) {
        if (!nav.contains(e.target)) {
          nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) { d.classList.remove('is-open'); });
        }
      });
    });
  });

  // ── Course header — lesson panel + X/N badge ───────────────────────────────
  (function () {
    var titleBtn  = document.getElementById('coursePanelBurger');
    var burgerBtn = document.getElementById('courseBurgerBtn');
    var panel     = document.getElementById('courseLessonPanel');
    if (!panel) return;
    function togglePanel(force) {
      var open = force !== undefined ? force : !panel.classList.contains('is-open');
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      [titleBtn, burgerBtn].forEach(function (b) { if (b) b.setAttribute('aria-expanded', String(open)); });
      if (titleBtn) {
        var c = titleBtn.querySelector('.course-header__title-caret');
        if (c) c.style.transform = open ? 'rotate(180deg)' : '';
      }
      if (burgerBtn) burgerBtn.classList.toggle('is-open', open);
    }
    [titleBtn, burgerBtn].forEach(function (b) { if (b) b.addEventListener('click', function () { togglePanel(); }); });
    document.addEventListener('click', function (e) {
      if (panel.classList.contains('is-open') &&
          !panel.contains(e.target) &&
          !(titleBtn && titleBtn.contains(e.target)) &&
          !(burgerBtn && burgerBtn.contains(e.target))) togglePanel(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) { togglePanel(false); if (burgerBtn) burgerBtn.focus(); }
    });
    document.addEventListener('DOMContentLoaded', function () {
      var active = document.querySelector('.course-header__lesson-link.is-active');
      var badgeTxt = document.getElementById('lessonBadgeText');
      if (active && badgeTxt) {
        badgeTxt.textContent = (active.dataset.lessonNum || '?') + ' / ' + (active.dataset.lessonTotal || '?');
      }
      if (active) active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  })();

  // ── Blog reading progress ──────────────────────────────────────────────────
  (function () {
    var fill  = document.getElementById('blogProgressFill');
    var strip = document.getElementById('blogProgressStrip');
    if (!fill) return;
    function update() {
      var content = document.querySelector('.gh-content, article');
      var pct;
      if (content) {
        var startY = content.getBoundingClientRect().top + window.scrollY;
        var endY   = startY + content.offsetHeight - window.innerHeight;
        pct = Math.min(100, Math.round((Math.max(0, window.scrollY - startY) / Math.max(1, endY - startY)) * 100));
      } else {
        pct = Math.min(100, Math.round((window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight)) * 100));
      }
      fill.style.width = pct + '%';
      if (strip) strip.setAttribute('aria-valuenow', pct);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();

})();
</script>
