{{!-- ═══════════════════════════════════════════════════════════════════
     Behavior: burger / dark mode / reading progress
     ═══════════════════════════════════════════════════════════════════ --}}
<script>
  (function () {
    // Burger toggles
    document.querySelectorAll('.navbar-burger').forEach(function (b) {
      b.addEventListener('click', function () {
        var t = document.getElementById(b.dataset.target);
        b.classList.toggle('is-active');
        if (t) t.classList.toggle('is-active');
      });
    });

    // Dark mode — Bulma v1 native data-theme
    var root = document.documentElement;
    var stored = localStorage.getItem('bulma-theme');
    var prefers = window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.setAttribute('data-theme', stored || (prefers ? 'dark' : 'light'));

    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('bulma-theme', next);
      });
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      if (!localStorage.getItem('bulma-theme')) {
        root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
      }
    });  
  })();
</script>
