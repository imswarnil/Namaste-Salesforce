{{!-- =========================================================================
  partials/header.hbs  ·  Namaste Salesforce
  SINGLE FILE — replaces header.hbs dispatcher + all sub-partials.

  VARIANTS (auto-selected):
    #lesson post  → course-header    (lesson bar + slide-down panel)
    #blog   post  → default-header blog-header  (+ reading progress strip)
    everything    → default-header

  WHAT'S DIFFERENT FROM THE OLD MULTI-FILE VERSION:
    • Single file — no sub-partials referenced anywhere
    • Auth block inlined (was partials/header/auth.hbs)
    • Donate icon replaces GitHub star button
      → ph-heart  links to GitHub Sponsors
      → desktop only (not shown in mobile menu)
    • Logged-in: ph-user-circle as fallback avatar icon
    • Theme toggle: rooster chirp (light) / owl hoot (dark) via Web Audio API
    • JSON-LD SiteNavigationElement emitted once

  CSS CLASSES: unchanged — still default-header__*, course-header__*, blog-header__*
  NAV DROPDOWNS: "- " label prefix → child item → JS builds flyout
========================================================================== --}}

{{!-- ── JSON-LD ──────────────────────────────────────────────────────────── --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{@site.url}}/#website",
      "url": "{{@site.url}}/",
      "name": "{{@site.title}}"{{#if @site.description}},
      "description": "{{@site.description}}"{{/if}},
      "inLanguage": "en-US",
      "publisher": {
        "@type": "Organization",
        "@id": "{{@site.url}}/#organization",
        "name": "{{@site.title}}"{{#if @site.logo}},
        "logo": { "@type": "ImageObject", "url": "{{@site.logo}}" }{{/if}}
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "{{@site.url}}/?s={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "@id": "{{@site.url}}/#site-navigation",
      "name": "Site Navigation",
      "itemListElement": [
        {{#foreach navigation}}
          {{#match label "~^" "- "}}{{else}}
          { "@type": "ListItem", "position": {{@number}}, "name": "{{label}}", "url": "{{url absolute="true"}}" }{{#unless @last}},{{/unless}}
          {{/match}}
        {{/foreach}}
      ]
    }
  ]
}
</script>

{{!-- ════════════════════════════════════════════════════════════════════
  DISPATCH
════════════════════════════════════════════════════════════════════════ --}}
{{#is "post"}}{{#post}}{{#has tag="#lesson"}}

{{!-- ──────────────────────────────────────────────────────────────────
  COURSE HEADER  (#lesson posts)
  Three zones: [← Back]  [Lesson title ▾]  [X/N · ☰ · ✕]
────────────────────────────────────────────────────────────────────── --}}
<header class="course-header site-header" role="banner" id="siteHeader">
  <div class="course-header__bar">
    <div class="container is-fluid">
      <div class="course-header__inner">

        {{!-- Back --}}
        <div class="course-header__left">
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__back" href="{{url}}" aria-label="Back to {{title}}">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">{{title}}</span>
              </a>
            {{else}}
              <a class="course-header__back" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">Courses</span>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

        {{!-- Lesson title → opens panel --}}
        <div class="course-header__center">
          <button class="course-header__title-btn" type="button"
                  id="coursePanelBurger"
                  aria-label="Show all lessons in this course"
                  aria-expanded="false" aria-controls="courseLessonPanel">
            <span class="course-header__title">{{title}}</span>
            <i class="ph ph-caret-down course-header__title-caret" aria-hidden="true"></i>
          </button>
        </div>

        {{!-- Right: progress badge · menu · exit --}}
        <div class="course-header__right">
          <span class="course-header__badge" id="lessonBadge" aria-live="polite">
            <i class="ph ph-list-checks" aria-hidden="true"></i>
            <span id="lessonBadgeText">…</span>
          </span>
          <button class="course-header__burger" type="button"
                  id="courseBurgerBtn"
                  aria-label="Toggle lesson list"
                  aria-expanded="false" aria-controls="courseLessonPanel">
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
          </button>
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__close" href="{{url}}" aria-label="Exit lesson">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{else}}
              <a class="course-header__close" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

      </div>
    </div>
  </div>

  {{!-- Lesson panel --}}
  <div class="course-header__lesson-panel" id="courseLessonPanel"
       aria-label="Course lessons" aria-hidden="true">
    <div class="container is-fluid">
      <div class="course-header__lesson-wrap">
        <p class="course-header__lesson-label menu-label">
          <i class="ph ph-list-checks" aria-hidden="true"></i>
          Course Lessons
        </p>
        <ul class="menu-list course-header__lesson-list" id="courseLessonList">
          {{#get "posts"
            filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}"
            order="published_at asc"
            limit="100"
          }}
            {{#foreach posts}}
              <li>
                <a href="{{url}}"
                   class="course-header__lesson-link{{#match id ../../../../id}} is-active{{/match}}"
                   data-lesson-num="{{@number}}"
                   data-lesson-total="{{../length}}">
                  <span class="course-header__lesson-num">{{@number}}</span>
                  <span class="course-header__lesson-name">{{title}}</span>
                  {{#match id ../../../../id}}
                    <span class="course-header__lesson-dot" aria-label="Current lesson"></span>
                  {{/match}}
                </a>
              </li>
            {{/foreach}}
          {{/get}}
        </ul>
      </div>
    </div>
  </div>
</header>

{{else has tag="#blog"}}

{{!-- ──────────────────────────────────────────────────────────────────
  BLOG HEADER  (#blog posts)
  Standard navbar + Topics dropdown + reading progress strip.
────────────────────────────────────────────────────────────────────── --}}
<header class="default-header blog-header site-header is-sticky"
        role="banner" id="siteHeader">
  <nav class="navbar default-header__navbar" role="navigation"
       aria-label="Main navigation">
    <div class="container default-header__wrap">

      <div class="navbar-brand default-header__brand-group">
        <a class="navbar-item default-header__brand"
           href="{{@site.url}}" aria-label="{{@site.title}} — homepage">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}"
                 class="default-header__logo" width="32" height="32">
          {{/if}}
          <span class="default-header__title">{{@site.title}}</span>
        </a>
        <span class="default-header__brand-sep is-hidden-touch" aria-hidden="true"></span>

        {{!-- Topics dropdown (desktop) --}}
        <div class="default-header__learn-wrap is-hidden-touch" id="topicsDropdownWrap">
          <button class="default-header__learn-btn" type="button"
                  id="topicsDropdownBtn"
                  aria-haspopup="true" aria-expanded="false">
            <i class="ph ph-tag" aria-hidden="true"></i>
            <span>Topics</span>
            <i class="ph ph-caret-down default-header__learn-caret" aria-hidden="true"></i>
          </button>
          <div class="default-header__learn-panel blog-header__topics-panel"
               id="topicsDropdown" hidden>
            <p class="default-header__learn-heading">Browse Topics</p>
            <div class="blog-header__topics-tags">
              {{#get "tags" limit="12" order="count.posts desc" include="count.posts"}}
                {{#foreach tags}}
                  <a class="blog-header__topic-tag" href="{{url}}">
                    <span>{{name}}</span>
                    <span class="blog-header__topic-count">{{count.posts}}</span>
                  </a>
                {{/foreach}}
              {{/get}}
            </div>
            <div class="default-header__learn-footer">
              <a href="/tags/" class="default-header__learn-all">
                All topics
                <i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>

        {{!-- Mobile tools --}}
        <div class="default-header__mobile-tools is-hidden-desktop">
          <button class="default-header__icon-btn" type="button"
                  aria-label="Search" data-ghost-search>
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </button>
          <button class="default-header__icon-btn" type="button"
                  aria-label="Switch to dark mode" data-theme-toggle>
            <i class="ph ph-moon" aria-hidden="true"></i>
          </button>
          <button class="default-header__burger" type="button"
                  id="blogNavBurger"
                  aria-label="Toggle menu"
                  aria-expanded="false" aria-controls="blogNavMenu">
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <div id="blogNavMenu" class="navbar-menu default-header__menu"
           aria-hidden="true">
        <div class="navbar-start default-header__nav" id="blogNavLinks">
          {{navigation}}
        </div>
        <div class="navbar-end default-header__actions">
          {{!-- Search --}}
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button"
                    aria-label="Search" data-ghost-search>
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            </button>
          </div>
          {{!-- Theme --}}
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button"
                    aria-label="Switch to dark mode" data-theme-toggle>
              <i class="ph ph-moon" aria-hidden="true"></i>
            </button>
          </div>
          {{!-- Become Author CTA --}}
          <div class="navbar-item">
            <a class="default-header__cta default-header__cta--author"
               href="/contact/?ref=author">
              <i class="ph ph-pencil-line" aria-hidden="true"></i>
              <span>Become Author</span>
            </a>
          </div>
          {{!-- Auth (inlined) --}}
          {{#if @site.members_enabled}}
            {{#if @member}}
              <div class="navbar-item">
                <div class="default-header__account-wrap" id="accountWrap">
                  <button class="default-header__account-btn" type="button"
                          id="accountBtn" aria-label="Account menu"
                          aria-expanded="false" aria-haspopup="true">
                    {{#if @member.avatar_image}}
                      <img src="{{@member.avatar_image}}" alt="{{@member.name}}"
                           class="default-header__account-avatar" width="28" height="28">
                    {{else}}
                      <i class="ph-fill ph-user-circle default-header__account-icon" aria-hidden="true"></i>
                    {{/if}}
                    <span class="default-header__account-name-label is-hidden-mobile">
                      {{@member.name}}
                    </span>
                    <i class="ph ph-caret-down default-header__account-caret" aria-hidden="true"></i>
                  </button>
                  <div class="default-header__account-dropdown" id="accountDropdown" hidden>
                    <div class="default-header__account-header">
                      <p class="default-header__account-name">{{@member.name}}</p>
                      <p class="default-header__account-email">{{@member.email}}</p>
                    </div>
                    <hr class="default-header__divider">
                    <a class="default-header__dropdown-item"
                       href="#/portal/account" data-portal="account">
                      <i class="ph ph-user" aria-hidden="true"></i>
                      <span>Manage account</span>
                    </a>
                    <a class="default-header__dropdown-item"
                       href="#/portal/account/newsletters" data-portal="account/newsletters">
                      <i class="ph ph-envelope" aria-hidden="true"></i>
                      <span>Newsletters</span>
                    </a>
                    <hr class="default-header__divider">
                    <a class="default-header__dropdown-item default-header__dropdown-item--danger"
                       href="javascript:void(0)" data-members-signout>
                      <i class="ph ph-sign-out" aria-hidden="true"></i>
                      <span>Sign out</span>
                    </a>
                  </div>
                </div>
              </div>
            {{else}}
              {{#unless @site.members_invite_only}}
                <div class="navbar-item default-header__auth-pair">
                  <a class="default-header__btn default-header__btn--ghost"
                     href="#/portal/signin" data-portal="signin">
                    <i class="ph ph-sign-in" aria-hidden="true"></i>
                    <span>Sign in</span>
                  </a>
                  <a class="default-header__btn default-header__btn--primary"
                     href="#/portal/signup" data-portal="signup">
                    <i class="ph ph-user-plus" aria-hidden="true"></i>
                    <span>Join free</span>
                  </a>
                </div>
              {{else}}
                <div class="navbar-item">
                  <a class="default-header__btn default-header__btn--primary"
                     href="#/portal/signin" data-portal="signin">
                    <i class="ph ph-sign-in" aria-hidden="true"></i>
                    <span>Sign in</span>
                  </a>
                </div>
              {{/unless}}
            {{/if}}
          {{/if}}
          {{!-- Donate icon (desktop only) --}}
          <div class="navbar-item is-hidden-touch">
            <a class="default-header__donate-btn"
               href="https://github.com/sponsors/imswarnil"
               target="_blank" rel="noopener noreferrer"
               aria-label="Sponsor this project">
              <i class="ph-fill ph-heart" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

    </div>
  </nav>
</header>

{{!-- Reading progress strip --}}
<div class="blog-header__progress-strip"
     role="progressbar" aria-label="Reading progress"
     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
     id="blogReadingStrip">
  <div class="blog-header__progress-fill" id="blogReadingFill"></div>
</div>

{{else}}

