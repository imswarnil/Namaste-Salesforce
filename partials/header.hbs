{{!-- ════════════════════════════════════════════════════════════════════
  1. COURSE HEADER
  #lesson posts only.
  [← Back] [Lesson title ▾] [3/12  ☰  ✕]
════════════════════════════════════════════════════════════════════════ --}}
<header class="course-header site-header" role="banner" id="siteHeader">
  <div class="course-header__bar">
    <div class="container is-fluid">
      <div class="course-header__inner">

        {{!-- Back to course --}}
        <div class="course-header__left">
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__back" href="{{url}}"
                 aria-label="Back to {{title}}">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">{{title}}</span>
              </a>
            {{else}}
              <a class="course-header__back" href="/courses/">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>
                <span class="course-header__back-title">Courses</span>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

        {{!-- Lesson title — also opens panel --}}
        <div class="course-header__center">
          <button class="course-header__title-btn" type="button"
                  aria-label="Show all lessons in this course"
                  aria-expanded="false" aria-controls="courseLessonPanel"
                  id="coursePanelBurger">
            <span class="course-header__title">{{title}}</span>
            <i class="ph ph-caret-down course-header__title-caret" aria-hidden="true"></i>
          </button>
        </div>

        {{!-- Right: X/N badge · hamburger · ✕ exit --}}
        <div class="course-header__right">
          <span class="course-header__badge" id="lessonBadge" aria-live="polite">
            <i class="ph ph-list-checks" aria-hidden="true"></i>
            <span id="lessonBadgeText">…</span>
          </span>
          <button class="course-header__burger" type="button"
                  aria-label="Toggle lesson list" aria-expanded="false"
                  aria-controls="courseLessonPanel" id="courseBurgerBtn">
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
            <span class="course-header__burger-bar" aria-hidden="true"></span>
          </button>
          {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
            {{#foreach posts}}
              <a class="course-header__close" href="{{url}}" aria-label="Exit lesson">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{else}}
              <a class="course-header__close" href="/courses/" aria-label="Back to courses">
                <i class="ph ph-x" aria-hidden="true"></i>
              </a>
            {{/foreach}}
          {{/get}}
        </div>

      </div>
    </div>
  </div>

  {{!-- Lesson slide-down panel --}}
  <div class="course-header__lesson-panel" id="courseLessonPanel"
       aria-label="Course lessons" aria-hidden="true">
    <div class="container is-fluid">
      <div class="course-header__lesson-wrap">
        <p class="course-header__lesson-label">
          <i class="ph ph-list-checks" aria-hidden="true"></i>
          Course Lessons
        </p>
        <ul class="menu-list course-header__lesson-list" id="courseLessonList">
          {{#get "posts"
            filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}"
            order="published_at asc"
            limit="100"
          }}
            {{#foreach posts}}
              <li>
                <a href="{{url}}"
                   class="course-header__lesson-link{{#match id ../../../../id}} is-active{{/match}}"
                   data-lesson-num="{{@number}}"
                   data-lesson-total="{{../length}}">
                  <span class="course-header__lesson-num">{{@number}}</span>
                  <span class="course-header__lesson-name">{{title}}</span>
                  {{#match id ../../../../id}}
                    <span class="course-header__lesson-dot" aria-label="Current lesson"></span>
                  {{/match}}
                </a>
              </li>
            {{/foreach}}
          {{/get}}
        </ul>
      </div>
    </div>
  </div>
</header>

{{else has tag="#blog"}}

{{!-- ════════════════════════════════════════════════════════════════════
  2. BLOG HEADER
  #blog posts only.
  Standard navbar + sticky reading progress bar.
  No Topics dropdown. Same open-source rail as default.
════════════════════════════════════════════════════════════════════════ --}}
<header class="default-header blog-header site-header is-sticky"
        role="banner" id="siteHeader">
  <nav class="navbar default-header__navbar" role="navigation"
       aria-label="Main navigation">
    <div class="container default-header__wrap">

      <div class="navbar-brand default-header__brand-group">
        <a class="navbar-item default-header__brand"
           href="{{@site.url}}" aria-label="{{@site.title}} homepage">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}"
                 class="default-header__logo" width="32" height="32">
          {{/if}}
          <span class="default-header__title">{{@site.title}}</span>
        </a>
        <span class="default-header__brand-sep is-hidden-touch" aria-hidden="true"></span>
        {{!-- Reading label (desktop) --}}
        <span class="dh-reading-label is-hidden-touch" aria-hidden="true">
          <i class="ph ph-note-pencil"></i>
          <span class="dh-reading-label__title">{{title}}</span>
        </span>
        {{!-- Mobile tools --}}
        <div class="default-header__mobile-tools is-hidden-desktop">
          <button class="default-header__icon-btn" type="button"
                  aria-label="Search" data-ghost-search>
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          </button>
          <button class="default-header__icon-btn" type="button"
                  aria-label="Switch to dark mode" data-theme-toggle>
            <i class="ph ph-moon" aria-hidden="true"></i>
          </button>
          <button class="default-header__burger" type="button"
                  aria-label="Toggle navigation menu" aria-expanded="false"
                  aria-controls="blogNavMenu" id="blogNavBurger">
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
            <span class="default-header__burger-bar" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <div id="blogNavMenu" class="navbar-menu default-header__menu"
           aria-hidden="true">
        <div class="navbar-start default-header__nav" id="blogNavLinks">
          {{navigation}}
        </div>
        <div class="navbar-end default-header__actions">
          {{!-- Search --}}
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button"
                    aria-label="Search" data-ghost-search>
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            </button>
          </div>
          {{!-- Theme --}}
          <div class="navbar-item is-hidden-touch">
            <button class="default-header__icon-btn" type="button"
                    aria-label="Switch to dark mode" data-theme-toggle>
              <i class="ph ph-moon" aria-hidden="true"></i>
            </button>
          </div>
          {{!-- Contribute pill --}}
          <div class="navbar-item is-hidden-touch">
            <a class="dh-contribute-btn"
               href="https://github.com/imswarnil/Namaste-Salesforce"
               target="_blank" rel="noopener noreferrer">
              <i class="ph ph-git-pull-request" aria-hidden="true"></i>
              <span>Contribute</span>
            </a>
          </div>
          {{!-- Social strip (desktop) --}}
          <div class="navbar-item dh-social-strip is-hidden-touch" aria-label="Social links">
            <a class="dh-social-btn" href="https://twitter.com/imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
              <i class="ph ph-x-logo" aria-hidden="true"></i>
            </a>
            <a class="dh-social-btn" href="https://linkedin.com/in/imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <i class="ph ph-linkedin-logo" aria-hidden="true"></i>
            </a>
            <a class="dh-social-btn" href="https://youtube.com/@imswarnil"
               target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <i class="ph ph-youtube-logo" aria-hidden="true"></i>
            </a>
            <a class="dh-social-btn dh-social-btn--github"
               href="https://github.com/imswarnil/Namaste-Salesforce"
               target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <i class="ph ph-github-logo" aria-hidden="true"></i>
              <span class="dh-github-count" id="dhGithubCountBlog" hidden></span>
            </a>
          </div>
          {{!-- Support dropdown --}}
          <div class="navbar-item">
            <div class="dh-support-wrap" id="dhSupportWrapBlog">
              <button class="dh-support-btn" type="button"
                      id="dhSupportBtnBlog"
                      aria-haspopup="true" aria-expanded="false">
                <i class="ph ph-heart" aria-hidden="true"></i>
                <span class="is-hidden-mobile">Support</span>
                <i class="ph ph-caret-down dh-support-caret" aria-hidden="true"></i>
              </button>
              <div class="dh-support-panel" id="dhSupportPanelBlog" hidden>
                <p class="dh-support-panel__heading">Support the project</p>
                <a class="dh-support-item"
                   href="https://github.com/sponsors/imswarnil"
                   target="_blank" rel="noopener noreferrer">
                  <span class="dh-support-item__icon dh-support-item__icon--github">
                    <i class="ph ph-github-logo" aria-hidden="true"></i>
                  </span>
                  <span class="dh-support-item__body">
                    <strong>GitHub Sponsors</strong>
                    <small>Monthly recurring support</small>
                  </span>
                </a>
                <a class="dh-support-item"
                   href="https://buymeacoffee.com/imswarnil"
                   target="_blank" rel="noopener noreferrer">
                  <span class="dh-support-item__icon dh-support-item__icon--bmc">
                    <i class="ph ph-coffee" aria-hidden="true"></i>
                  </span>
                  <span class="dh-support-item__body">
                    <strong>Buy Me a Coffee</strong>
                    <small>One-time hazelnut cold coffee</small>
                  </span>
                </a>
                <div class="dh-support-panel__footer">
                  <i class="ph ph-heart-fill" aria-hidden="true"></i>
                  Free &amp; open source forever
                </div>
              </div>
            </div>
          </div>
          {{!-- Auth --}}
          {{#if @site.members_enabled}}
            {{#if @member}}
              <div class="navbar-item">
                <div class="default-header__account-wrap" id="accountWrapBlog">
                  <button class="default-header__account-btn" type="button"
                          aria-label="Account menu" aria-expanded="false"
                          aria-haspopup="true" id="accountBtnBlog">
                    {{#if @member.avatar_image}}
                      <img src="{{@member.avatar_image}}" alt="{{@member.name}}"
                           class="default-header__account-avatar" width="28" height="28">
                    {{else}}
                      <span class="default-header__account-initials" id="memberInitialsBlog"></span>
                    {{/if}}
                    <i class="ph ph-caret-down default-header__account-caret" aria-hidden="true"></i>
                  </button>
                  <div class="default-header__account-dropdown" id="accountDropdownBlog" hidden>
                    <div class="default-header__account-header">
                      <p class="default-header__account-name">{{@member.name}}</p>
                      <p class="default-header__account-email">{{@member.email}}</p>
                    </div>
                    <hr class="default-header__divider">
                    <a class="default-header__dropdown-item" href="#/portal/account" data-portal="account">
                      <i class="ph ph-user" aria-hidden="true"></i><span>Manage account</span>
                    </a>
                    <a class="default-header__dropdown-item" href="#/portal/account/newsletters" data-portal="account/newsletters">
                      <i class="ph ph-envelope" aria-hidden="true"></i><span>Newsletters</span>
                    </a>
                    <hr class="default-header__divider">
                    <a class="default-header__dropdown-item default-header__dropdown-item--danger"
                       href="javascript:void(0)" data-members-signout>
                      <i class="ph ph-sign-out" aria-hidden="true"></i><span>Sign out</span>
                    </a>
                  </div>
                </div>
              </div>
            {{else}}
              {{#unless @site.members_invite_only}}
                <div class="navbar-item default-header__auth-pair">
                  <a class="default-header__btn default-header__btn--ghost"
                     href="#/portal/signin" data-portal="signin">
                    <i class="ph ph-sign-in" aria-hidden="true"></i><span>Sign in</span>
                  </a>
                  <a class="default-header__btn default-header__btn--primary"
                     href="#/portal/signup" data-portal="signup">
                    <i class="ph ph-user-plus" aria-hidden="true"></i><span>Join free</span>
                  </a>
                </div>
              {{else}}
                <div class="navbar-item">
                  <a class="default-header__btn default-header__btn--primary"
                     href="#/portal/signin" data-portal="signin">
                    <i class="ph ph-sign-in" aria-hidden="true"></i><span>Sign in</span>
                  </a>
                </div>
              {{/unless}}
            {{/if}}
          {{/if}}
        </div>
      </div>

    </div>
  </nav>
</header>
{{!-- Reading progress --}}
<div class="blog-header__progress-strip" id="blogProgressStrip"
     role="progressbar" aria-label="Reading progress"
     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
  <div class="blog-header__progress-fill" id="blogProgressFill"></div>
</div>

{{else}}

