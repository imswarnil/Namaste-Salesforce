<header class="site-header">
    <nav class="navbar site-navbar" role="navigation" aria-label="main navigation">
        <div class="container site-navbar__wrap">
            <input
                id="site-nav-toggle"
                class="site-navbar__toggle"
                type="checkbox"
                hidden
            >

            <div class="navbar-brand">
                <a class="navbar-item site-navbar__brand" href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img
                            src="{{@site.logo}}"
                            alt="{{@site.title}}"
                            class="site-navbar__logo"
                            width="32"
                            height="32"
                        >
                    {{/if}}

                    <span class="site-navbar__title has-text-weight-semibold">
                        {{@site.title}}
                    </span>
                </a>

                <div class="site-navbar__mobile-tools is-hidden-desktop">
                    <button
                        class="button is-light is-small"
                        type="button"
                        aria-label="Search this site"
                        data-ghost-search
                    >
                        <span class="icon is-small">
                            <i class="ph ph-magnifying-glass"></i>
                        </span>
                    </button>

                    <button
                        class="button is-light is-small"
                        type="button"
                        aria-label="Toggle dark mode"
                        data-theme-toggle
                    >
                        <span class="icon is-small">
                            <i class="ph ph-moon"></i>
                        </span>
                    </button>

                    <label
                        for="site-nav-toggle"
                        class="navbar-burger site-navbar__burger"
                        role="button"
                        aria-label="Toggle menu"
                        aria-controls="siteNavbarMenu"
                    >
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div id="siteNavbarMenu" class="navbar-menu site-navbar__menu">
                <div class="navbar-start site-navbar__center">
                    {{navigation}}

                    {{!-- Optional manual dropdowns if you want them --}}
                    {{!--
                    <div class="navbar-item has-dropdown is-hoverable">
                        <a class="navbar-link" href="/learn/">
                            <span class="icon is-small"><i class="ph ph-student"></i></span>
                            <span>Learn</span>
                        </a>

                        <div class="navbar-dropdown">
                            <a class="navbar-item" href="/courses/">
                                <span class="icon is-small"><i class="ph ph-book-open"></i></span>
                                <span>Courses</span>
                            </a>
                            <a class="navbar-item" href="/training/">
                                <span class="icon is-small"><i class="ph ph-student"></i></span>
                                <span>Training</span>
                            </a>
                        </div>
                    </div>
                    --}}
                </div>

                <div class="navbar-end site-navbar__actions">
                    <div class="navbar-item">
                        <a
                            class="button is-light is-small site-navbar__github-button"
                            href="https://github.com/imswarnil/Namaste-Salesforce"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Star project on GitHub"
                        >
                            <span class="icon is-small">
                                <i class="ph ph-github-logo"></i>
                            </span>
                            <span>Star on GitHub</span>
                        </a>
                    </div>

                    <div class="navbar-item is-hidden-touch">
                        <button
                            class="button is-light is-small"
                            type="button"
                            aria-label="Toggle dark mode"
                            data-theme-toggle
                        >
                            <span class="icon is-small">
                                <i class="ph ph-moon"></i>
                            </span>
                        </button>
                    </div>

                    <div class="navbar-item is-hidden-touch">
                        <button
                            class="button is-light is-small"
                            type="button"
                            aria-label="Search this site"
                            data-ghost-search
                        >
                            <span class="icon is-small">
                                <i class="ph ph-magnifying-glass"></i>
                            </span>
                            <span>Search</span>
                        </button>
                    </div>

                    {{#if @site.members_enabled}}
                        <div class="navbar-item">
                            <div class="buttons">
                                {{#unless @member}}
                                    {{#unless @site.members_invite_only}}
                                        <a
                                            class="button is-light is-small"
                                            href="#/portal/signin"
                                            data-portal="signin"
                                        >
                                            <span class="icon is-small">
                                                <i class="ph ph-sign-in"></i>
                                            </span>
                                            <span>Sign in</span>
                                        </a>

                                        <a
                                            class="button is-primary is-small"
                                            href="#/portal/signup"
                                            data-portal="signup"
                                        >
                                            <span class="icon is-small">
                                                <i class="ph ph-sparkle"></i>
                                            </span>
                                            <span>Subscribe</span>
                                        </a>
                                    {{else}}
                                        <a
                                            class="button is-primary is-small"
                                            href="#/portal/signin"
                                            data-portal="signin"
                                        >
                                            <span class="icon is-small">
                                                <i class="ph ph-sign-in"></i>
                                            </span>
                                            <span>Sign in</span>
                                        </a>
                                    {{/unless}}
                                {{else}}
                                    <a
                                        class="button is-primary is-small"
                                        href="#/portal/account"
                                        data-portal="account"
                                    >
                                        <span class="icon is-small">
                                            <i class="ph ph-user-circle"></i>
                                        </span>
                                        <span>Account</span>
                                    </a>
                                {{/unless}}
                            </div>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var html = document.documentElement;
    var buttons = document.querySelectorAll('[data-theme-toggle]');
    var storageKey = 'site-color-scheme';

    function currentTheme() {
        return html.getAttribute('data-color-scheme') === 'dark' ? 'dark' : 'light';
    }

    function syncThemeUi(theme) {
        buttons.forEach(function (button) {
            var icon = button.querySelector('i');
            if (!icon) return;

            icon.className = theme === 'dark' ? 'ph ph-sun-dim' : 'ph ph-moon';
            button.setAttribute(
                'aria-label',
                theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
            );
        });
    }

    syncThemeUi(currentTheme());

    document.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-theme-toggle]');
        if (!trigger) return;

        var nextTheme = currentTheme() === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-color-scheme', nextTheme);
        localStorage.setItem(storageKey, nextTheme);
        syncThemeUi(nextTheme);
    });
});
</script>