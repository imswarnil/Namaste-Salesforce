{{!-- The navbar. One row: brand · nav · actions.

Navigation comes straight from Ghost Admin → Settings →
Navigation. Each item looks for an icon partial named
icons/nav-{slug} — nav-home, nav-blog, nav-courses… — and shows
it when one exists; an item with no matching partial simply
renders as text, so new nav items never break.

The burger label is wired to #nav-open in default.hbs; the whole
mobile drawer is CSS. --}}

<header class="site-head">
    <div class="site-head-inner">

        <div class="site-head-brand">
            <a class="site-head-logo" href="{{@site.url}}" aria-label="{{@site.title}} — home">
                {{!-- The brand IS the favicon: the cloud on its
                blue square, then the title as a wordmark. Any
                uploaded logo image is deliberately ignored. --}}
                <span class="site-head-mark" aria-hidden="true">{{> "icons/cloud"}}</span>
                <span class="site-head-title">{{@site.title}}</span>
            </a>
        </div>

        <nav class="site-head-nav" aria-label="{{t "Main navigation"}}">
            {{navigation}}
        </nav>

        {{!-- Actions, in the agreed order: search · theme · profile
        (icon on mobile, the member CTA on desktop) · GitHub star
        (labelled button on desktop, bare icon on mobile) · burger.
        The member CTA never renders in the drawer or as a wide
        mobile button — small screens get the avatar icon only. --}}
        <div class="site-head-actions">
            <button class="icon-btn" data-ghost-search aria-label="{{t "Search this site"}}">
                {{> "icons/search"}}
            </button>

            <button class="icon-btn theme-toggle" data-theme-toggle aria-label="{{t "Toggle dark mode"}}">
                <span class="icon-sun">{{> "icons/sun"}}</span>
                <span class="icon-moon">{{> "icons/moon"}}</span>
            </button>

            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <a class="icon-btn member-icon" href="{{@site.url}}/signin/" aria-label="{{t "Sign in"}}">
                        {{#get "authors" limit="1" as |h|}}
                            {{#if h.[0].profile_image}}
                                <img class="member-icon-img" src="{{img_url h.[0].profile_image size="xs"}}" alt="" loading="lazy" />
                            {{else}}
                                {{> "icons/avatar"}}
                            {{/if}}
                        {{/get}}
                    </a>
                    <a class="btn btn-sm site-head-cta" href="{{@site.url}}/signup/">{{> "icons/star"}} {{t "Become a member"}}</a>
                {{else}}
                    <a class="icon-btn" href="#/portal/account" data-portal="account" aria-label="{{t "Account"}}">
                        {{> "icons/avatar"}}
                    </a>
                {{/unless}}
            {{/if}}

            {{#if @custom.social_github}}
                <a class="btn btn-sm btn-ghost gh-star" href="{{@custom.social_github}}" target="_blank" rel="noopener" aria-label="{{t "Star on GitHub"}}">
                    {{> "icons/github"}}
                    <span class="gh-star-label">{{t "Star"}}</span>
                </a>
            {{/if}}

            {{!-- Salesforce App-Launcher waffle: nine dots that
            open the drawer panel; checked swaps them for an X. --}}
            <label class="nav-burger" for="nav-open" aria-label="{{t "Menu"}}">
                <svg class="nav-waffle" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/>
                    <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
                    <circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
                </svg>
                <span class="nav-close" aria-hidden="true"></span>
            </label>
        </div>

    </div>
</header>
