                <span>More</span>
                <i class="ph ph-caret-down dh-more-caret" aria-hidden="true"></i>
              </button>
              <div class="dh-more-panel" id="morePanel" hidden>
                <div class="dh-more-body">

                  {{!-- Contribute --}}
                  <div class="dh-more-section">
                    <p class="dh-more-section__label">
                      <i class="ph ph-git-pull-request" aria-hidden="true"></i>
                      Contribute
                    </p>
                    <ul class="dh-more-list">
                      <li><a class="dh-more-item" href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener noreferrer">
                        <span class="dh-more-icon"><i class="ph ph-github-logo"></i></span>
                        <span class="dh-more-text"><strong>GitHub Repo</strong><small>Star &amp; fork the project</small></span>
                      </a></li>
