{{!-- ════════════════════════════════════════════════════════════════════
  SHARED JAVASCRIPT
════════════════════════════════════════════════════════════════════════ --}}
<script>
(function () {
  'use strict';

  var noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ─── Web Audio helpers ────────────────────────────────────────────────────
  function makeCtx() {
    try { return new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; }
  }

  // Theme: rooster chirp (light) ← 3 ascending sine tones
  function playRooster() {
    if (noMotion) return;
    var ctx = makeCtx(); if (!ctx) return;
    [523, 659, 784].forEach(function (f, i) {
      var o = ctx.createOscillator(), g = ctx.createGain(), t = ctx.currentTime + i * 0.14;
      o.type = 'sine';
      o.frequency.setValueAtTime(f * 0.84, t);
      o.frequency.exponentialRampToValueAtTime(f, t + 0.05);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.14, t + 0.04);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
      o.connect(g); g.connect(ctx.destination);
      o.start(t); o.stop(t + 0.22);
    });
    setTimeout(function () { try { ctx.close(); } catch (e) {} }, 800);
  }

  // Theme: owl hoot (dark) ← 2 descending sine hoots
  function playOwl() {
    if (noMotion) return;
    var ctx = makeCtx(); if (!ctx) return;
    [392, 294].forEach(function (f, i) {
      var o = ctx.createOscillator(), g = ctx.createGain(), t = ctx.currentTime + i * 0.3;
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      o.frequency.exponentialRampToValueAtTime(f * 0.87, t + 0.22);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.11, t + 0.06);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.32);
      o.connect(g); g.connect(ctx.destination);
      o.start(t); o.stop(t + 0.36);
    });
    setTimeout(function () { try { ctx.close(); } catch (e) {} }, 900);
  }

  // Menu burger: soft "tok" click — short filtered noise burst
  function playTok() {
    if (noMotion) return;
    var ctx = makeCtx(); if (!ctx) return;
    var buf = ctx.createBuffer(1, ctx.sampleRate * 0.06, ctx.sampleRate);
    var data = buf.getChannelData(0);
    for (var i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (data.length * 0.15));
    var src = ctx.createBufferSource(), g = ctx.createGain();
    var filt = ctx.createBiquadFilter();
    filt.type = 'bandpass'; filt.frequency.value = 1200; filt.Q.value = 1.5;
    src.buffer = buf;
    g.gain.setValueAtTime(0.35, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.06);
    src.connect(filt); filt.connect(g); g.connect(ctx.destination);
    src.start(); src.stop(ctx.currentTime + 0.07);
    setTimeout(function () { try { ctx.close(); } catch (e) {} }, 200);
  }

  // Dropdown pop: very short high-freq tick
  function playPop() {
    if (noMotion) return;
    var ctx = makeCtx(); if (!ctx) return;
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type = 'sine'; o.frequency.setValueAtTime(900, ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(600, ctx.currentTime + 0.04);
    g.gain.setValueAtTime(0.08, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime + 0.055);
    setTimeout(function () { try { ctx.close(); } catch (e) {} }, 200);
  }

  // Search swoosh: frequency-swept noise burst
  function playSwoosh() {
    if (noMotion) return;
    var ctx = makeCtx(); if (!ctx) return;
    var buf = ctx.createBuffer(1, ctx.sampleRate * 0.22, ctx.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (d.length * 0.38));
    var src = ctx.createBufferSource(), g = ctx.createGain();
    var filt = ctx.createBiquadFilter();
    filt.type = 'highpass';
    filt.frequency.setValueAtTime(200, ctx.currentTime);
    filt.frequency.exponentialRampToValueAtTime(4000, ctx.currentTime + 0.18);
    src.buffer = buf;
    g.gain.setValueAtTime(0.22, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.22);
    src.connect(filt); filt.connect(g); g.connect(ctx.destination);
    src.start(); src.stop(ctx.currentTime + 0.25);
    setTimeout(function () { try { ctx.close(); } catch (e) {} }, 400);
  }

  // Dollar hover: sparkly coins ← 4 short high pings at random pitches
  function playCoins() {
    if (noMotion) return;
    var ctx = makeCtx(); if (!ctx) return;
    [1800, 2200, 2600, 2000].forEach(function (f, i) {
      var o = ctx.createOscillator(), g = ctx.createGain();
      var t = ctx.currentTime + i * 0.045;
      o.type = 'sine';
      o.frequency.setValueAtTime(f + Math.random() * 300, t);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.09, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
      o.connect(g); g.connect(ctx.destination);
      o.start(t); o.stop(t + 0.13);
    });
    setTimeout(function () { try { ctx.close(); } catch (e) {} }, 600);
  }

  // Route data-sound attribute to the right sound function
  function soundFor(type) {
    if (type === 'tok')    return playTok;
    if (type === 'pop')    return playPop;
    if (type === 'swoosh') return playSwoosh;
    return function () {};
  }

  // Wire data-sound clicks (burger, dropdown triggers, search)
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-sound]');
    if (el) soundFor(el.getAttribute('data-sound'))();
  });

  // Dollar hover
  document.querySelectorAll('.default-header__donate-btn').forEach(function (btn) {
    btn.addEventListener('mouseenter', playCoins);
  });

  // ─── Theme toggle ─────────────────────────────────────────────────────────
  var SK = 'site-color-scheme';
  var doc = document.documentElement;
  function getTheme() { return doc.getAttribute('data-color-scheme') === 'dark' ? 'dark' : 'light'; }
  function applyTheme(t) { doc.setAttribute('data-color-scheme', t); localStorage.setItem(SK, t); syncUI(t); }
  function syncUI(t) {
    var dk = t === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
      var ic = b.querySelector('i');
      if (ic) ic.className = dk ? 'ph ph-sun-dim' : 'ph ph-moon';
      b.setAttribute('aria-label', dk ? 'Switch to light mode' : 'Switch to dark mode');
    });
  }
  var sv = localStorage.getItem(SK);
  syncUI((sv === 'light' || sv === 'dark') ? sv : getTheme());
  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-theme-toggle]')) return;
    var next = getTheme() === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    if (next === 'light') playRooster(); else playOwl();
  });

  // ─── Brand title animation ────────────────────────────────────────────────
  // 10 languages cycling fast with wobble. Each title instance gets
  // the same animation; JS finds the first .default-header__title on page.
  var langVersions = [
    'Namaste Salesforce',   // English
    'नमस्ते Salesforce',     // Hindi
    'नमस्कार Salesforce',   // Marathi
    'ナマステ Salesforce',   // Japanese
    '안녕 Salesforce',       // Korean
    'مرحبا Salesforce',     // Arabic
    'Bonjour Salesforce',   // French
    'Hola Salesforce',      // Spanish
    'Olá Salesforce',       // Portuguese
    'Привет Salesforce',    // Russian
  ];

  var brandEl = document.getElementById('brandTitle');
  if (brandEl) {
    var langIdx = 0;
    var isAnimating = false;

    function wobbleTo(nextText) {
      if (isAnimating) return;
      isAnimating = true;
      brandEl.classList.add('brand-title--wobble-out');
      setTimeout(function () {
        brandEl.textContent = nextText;
        brandEl.classList.remove('brand-title--wobble-out');
        brandEl.classList.add('brand-title--wobble-in');
        setTimeout(function () {
          brandEl.classList.remove('brand-title--wobble-in');
          isAnimating = false;
        }, 220);
      }, 180);
    }

    // Auto-cycle every 2.4 s
    setInterval(function () {
      langIdx = (langIdx + 1) % langVersions.length;
      wobbleTo(langVersions[langIdx]);
    }, 2400);
  }

  // ─── Brand speak button ───────────────────────────────────────────────────
  // Cycles through different voices / pitches on each click
  var speakIdx = 0;
  var speakVariants = [
    { pitch: 1.0, rate: 0.95, volume: 1 },
    { pitch: 1.4, rate: 1.1,  volume: 0.9 },
    { pitch: 0.7, rate: 0.85, volume: 1 },
    { pitch: 1.8, rate: 1.3,  volume: 0.85 },
    { pitch: 0.5, rate: 0.75, volume: 1 },
  ];

  var speakBtn = document.getElementById('brandSpeakBtn');
  if (speakBtn && 'speechSynthesis' in window) {
    speakBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      playPop();
      window.speechSynthesis.cancel();
      var u = new SpeechSynthesisUtterance('Namaste Salesforce');
      var v = speakVariants[speakIdx % speakVariants.length];
      u.lang   = 'en-IN';
      u.pitch  = v.pitch;
      u.rate   = v.rate;
      u.volume = v.volume;
      // Try to use an Indian English voice if available
      var voices = window.speechSynthesis.getVoices();
      var preferred = voices.find(function (vo) { return /en.IN|en.US/i.test(vo.lang); });
      if (preferred) u.voice = preferred;
      window.speechSynthesis.speak(u);
      speakIdx++;
      // Wiggle the icon as feedback
      var icon = speakBtn.querySelector('i');
      if (icon) {
        icon.classList.add('brand-speak--active');
        setTimeout(function () { icon.classList.remove('brand-speak--active'); }, 500);
      }
    });
    // Load voices (some browsers need this)
    if (window.speechSynthesis.onvoiceschanged !== undefined) {
      window.speechSynthesis.onvoiceschanged = function () {};
    }
  } else if (speakBtn) {
    speakBtn.hidden = true; // hide if TTS not supported
  }

  // ─── Mobile burger ────────────────────────────────────────────────────────
  function initBurger(burgerId, menuId) {
    var burger = document.getElementById(burgerId);
    var menu   = document.getElementById(menuId);
    var hdr    = document.getElementById('siteHeader');
    if (!burger || !menu) return;
    function toggle(force) {
      var open = force !== undefined ? force : !burger.classList.contains('is-open');
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      if (hdr) hdr.classList.toggle('menu-is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }
    burger.addEventListener('click', function () { toggle(); });
    document.addEventListener('click', function (e) {
      if (menu.classList.contains('is-open') &&
          !menu.contains(e.target) && !burger.contains(e.target)) toggle(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) { toggle(false); burger.focus(); }
    });
  }
  initBurger('defaultNavBurger', 'defaultNavMenu');
  initBurger('blogNavBurger',    'blogNavMenu');

  // ─── Generic dropdown factory ─────────────────────────────────────────────
  function makeDropdown(btnId, panelId, wrapId) {
    var btn   = document.getElementById(btnId);
    var panel = document.getElementById(panelId);
    var wrap  = document.getElementById(wrapId);
    if (!btn || !panel) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('is-open', open);
    });
    document.addEventListener('click', function (e) {
      if (wrap && !wrap.contains(e.target)) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('is-open');
        btn.focus();
      }
    });
  }
  makeDropdown('contributeBtn', 'contributePanel', 'contributeWrap');
  makeDropdown('productsBtn',   'productsPanel',   'productsWrap');
  makeDropdown('accountBtn',    'accountDropdown', 'accountWrap');

  // ─── Member initials ──────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('memberInitials');
    if (el) {
      var n = document.querySelector('.default-header__account-name');
      if (n) el.textContent = n.textContent.trim()
        .split(/\s+/).map(function (w) { return w[0] || ''; }).slice(0, 2).join('').toUpperCase();
    }
  });

  // ─── Nav dropdown builder ─────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    ['defaultNavLinks', 'blogNavLinks'].forEach(function (id) {
      var nav = document.getElementById(id);
      if (!nav) return;
      var items = Array.from(nav.querySelectorAll('.default-header__nav-item'));
      var cur = null;
      items.forEach(function (el) {
        if (el.getAttribute('data-child') === 'true' && cur) {
          var lbl = el.querySelector('.default-header__nav-label');
          if (lbl) lbl.textContent = lbl.textContent.replace(/^[-–]\s*/, '').trim();
          var li = document.createElement('li');
          li.appendChild(el);
          cur.list.appendChild(li);
        } else {
          var wrap = document.createElement('div');
          wrap.className = 'default-header__dropdown-wrap';
          el.parentNode.insertBefore(wrap, el);
          wrap.appendChild(el);
          var list = document.createElement('ul');
          list.className = 'default-header__dropdown-menu';
          list.setAttribute('role', 'menu');
          wrap.appendChild(list);
          cur = { wrap: wrap, trigger: el, list: list };
        }
      });
      nav.querySelectorAll('.default-header__dropdown-wrap').forEach(function (wrap) {
        var list = wrap.querySelector('.default-header__dropdown-menu');
        var item = wrap.querySelector('.default-header__nav-item');
        if (!list || !list.children.length) {
          if (item) wrap.parentNode.insertBefore(item, wrap);
          wrap.remove(); return;
        }
        wrap.classList.add('has-dropdown');
        if (item) {
          item.classList.add('has-dropdown-trigger');
          item.setAttribute('aria-haspopup', 'true');
          item.setAttribute('aria-expanded', 'false');
          var chev = document.createElement('i');
          chev.className = 'ph ph-caret-down default-header__dropdown-chevron';
          chev.setAttribute('aria-hidden', 'true');
          item.appendChild(chev);
        }
      });
      nav.addEventListener('click', function (e) {
        var t = e.target.closest('.has-dropdown-trigger');
        if (!t || window.innerWidth >= 1024) return;
        e.preventDefault();
        var w = t.closest('.has-dropdown'), isOpen = w.classList.contains('is-open');
        nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) {
          d.classList.remove('is-open');
          var dt = d.querySelector('.has-dropdown-trigger');
          if (dt) dt.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) { w.classList.add('is-open'); t.setAttribute('aria-expanded', 'true'); }
      });
      document.addEventListener('click', function (e) {
        if (!nav.contains(e.target)) {
          nav.querySelectorAll('.has-dropdown.is-open').forEach(function (d) { d.classList.remove('is-open'); });
        }
      });
    });
  });

  // ─── Course header ────────────────────────────────────────────────────────
  (function () {
    var tb = document.getElementById('coursePanelBurger');
    var bb = document.getElementById('courseBurgerBtn');
    var p  = document.getElementById('courseLessonPanel');
    if (!p) return;
    function tp(force) {
      var open = force !== undefined ? force : !p.classList.contains('is-open');
      p.classList.toggle('is-open', open);
      p.setAttribute('aria-hidden', String(!open));
      [tb, bb].forEach(function (b) { if (b) b.setAttribute('aria-expanded', String(open)); });
      if (tb) { var c = tb.querySelector('.course-header__title-caret'); if (c) c.style.transform = open ? 'rotate(180deg)' : ''; }
      if (bb) bb.classList.toggle('is-open', open);
    }
    [tb, bb].forEach(function (b) { if (b) b.addEventListener('click', function () { playPop(); tp(); }); });
    document.addEventListener('click', function (e) {
      if (p.classList.contains('is-open') && !p.contains(e.target) && !(tb&&tb.contains(e.target)) && !(bb&&bb.contains(e.target))) tp(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && p.classList.contains('is-open')) { tp(false); if (bb) bb.focus(); }
    });
    document.addEventListener('DOMContentLoaded', function () {
      var a = document.querySelector('.course-header__lesson-link.is-active');
      var bx = document.getElementById('lessonBadgeText');
      if (a && bx) bx.textContent = (a.getAttribute('data-lesson-num')||'?') + ' / ' + (a.getAttribute('data-lesson-total')||'?');
      if (a) a.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  })();

  // ─── Blog reading progress ────────────────────────────────────────────────
  (function () {
    var fill  = document.getElementById('blogReadingFill');
    var strip = document.getElementById('blogReadingStrip');
    if (!fill) return;
    function upd() {
      var c = document.querySelector('.gh-content, .js-post-content');
      var pct;
      if (c) {
        var s = c.getBoundingClientRect().top + window.scrollY;
        var e = s + c.offsetHeight - window.innerHeight;
        pct = Math.min(100, Math.max(0, Math.round(((window.scrollY - s) / Math.max(1, e - s)) * 100)));
      } else {
        pct = Math.min(100, Math.round(window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight) * 100));
      }
      fill.style.width = pct + '%';
      if (strip) strip.setAttribute('aria-valuenow', pct);
    }
    window.addEventListener('scroll', upd, { passive: true });
    window.addEventListener('resize', upd, { passive: true });
    upd();
  })();

})();
</script>
