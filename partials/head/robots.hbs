
{{#page}}
  {{#has tag="#noindex"}}
    <meta name="robots" content="noindex, nofollow">
  {{else has tag="#nofollow"}}
        <meta name="robots" content="index, nofollow">
  {{else}}
     <meta name="robots" content="index, follow">
  {{/has}}
{{/page}}

{{#post}}
  {{#has tag="#noindex"}}
    <meta name="robots" content="noindex, nofollow">
  {{else has tag="#nofollow"}}
        <meta name="robots" content="index, nofollow">
  {{else}}
     <meta name="robots" content="index, follow">
  {{/has}}
{{/post}}
