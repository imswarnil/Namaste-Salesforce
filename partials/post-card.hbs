{{!-- =========================================================================
  partials/post-card.hbs  ·  Namaste Salesforce
  Single-file card system. All 5 variants inline — no sub-partials.

  Variants auto-selected by tag:
    #course   → .pc--course   accent bar, placeholder, CTA, access badge
    #blog     → .pc--blog     author avatar, 2-line excerpt, editorial footer
    #video    → .pc--video    16:9, play overlay, duration badge
    #training → .pc--training horizontal row, icon, slide-right hover
    default   → .pc--default  everything else (lessons, resources, pages)

  Locked states handled in all variants:
    has image  → dark blur overlay + badge over the thumbnail
    no image   → lock pill in tag row

  Usage anywhere: {{> "post-card"}}
========================================================================== --}}

{{!-- ══ COURSE ═══════════════════════════════════════════════════════════════ --}}
{{#has tag="#course"}}
<article class="pc pc--course {{post_class}}" aria-label="{{title}}">

  <a href="{{url}}" class="pc__img-wrap" tabindex="-1" aria-hidden="true">
    {{#if feature_image}}
      <img
        srcset="{{img_url feature_image size="s"}} 300w,
                {{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        class="pc__img" loading="lazy">
    {{else}}
      <div class="pc__placeholder pc__placeholder--course">
        <i class="ph ph-book-open" aria-hidden="true"></i>
      </div>
    {{/if}}
    {{#has visibility="public"}}
      <span class="pc__access-badge pc__access-badge--free">Free</span>
    {{else has visibility="members"}}
      <span class="pc__access-badge pc__access-badge--members">
        <i class="ph ph-star" aria-hidden="true"></i> Members
      </span>
    {{else}}
      <span class="pc__access-badge pc__access-badge--paid">
        <i class="ph ph-crown" aria-hidden="true"></i> Paid
      </span>
    {{/has}}
    {{#unless access}}{{^has visibility="public"}}
      <div class="pc__locked-overlay">
        <span class="pc__locked-badge">
          <i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
        </span>
      </div>
    {{/has}}{{/unless}}
  </a>

  <div class="pc__body">
    <div class="pc__tags">
      {{#primary_tag}}<a href="{{url}}" class="pc__tag pc__tag--primary">{{name}}</a>{{/primary_tag}}
      {{#if featured}}<span class="pc__tag pc__tag--featured"><i class="ph-fill ph-fire" aria-hidden="true"></i> Featured</span>{{/if}}
    </div>
    <h2 class="pc__title"><a href="{{url}}" class="pc__title-link">{{title}}</a></h2>
    {{#if excerpt}}<p class="pc__excerpt">{{excerpt}}</p>{{/if}}
    <div class="pc__course-meta">
      {{#foreach tags visibility="internal"}}
        {{#match slug "~^" "hash-course-level-"}}{{#if description}}
          <span><i class="ph ph-signal-high" aria-hidden="true"></i>{{description}}</span>
        {{/if}}{{/match}}
      {{/foreach}}
      {{#foreach tags visibility="internal"}}
        {{#match slug "~^" "hash-course-duration-"}}{{#if description}}
          <span><i class="ph ph-clock" aria-hidden="true"></i>{{description}}</span>
        {{/if}}{{/match}}
      {{/foreach}}
    </div>
    <a href="{{url}}" class="pc__cta-btn">
      {{#unless access}}{{^has visibility="public"}}
        <i class="ph ph-lock" aria-hidden="true"></i>
        {{#has visibility="members"}}Join to access{{else}}Subscribe{{/has}}
      {{else}}<i class="ph ph-play-circle" aria-hidden="true"></i> Start Course{{/has}}
      {{else}}<i class="ph ph-play-circle" aria-hidden="true"></i> Start Course{{/unless}}
    </a>
  </div>

</article>

{{!-- ══ BLOG ════════════════════════════════════════════════════════════════ --}}
{{else has tag="#blog"}}
<article class="pc pc--blog {{post_class}}" aria-label="{{title}}">

  {{#if feature_image}}
    <a href="{{url}}" class="pc__img-wrap pc__img-wrap--wide" tabindex="-1" aria-hidden="true">
      <img
        srcset="{{img_url feature_image size="s"}} 300w,
                {{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        class="pc__img" loading="lazy">
      {{#unless access}}{{^has visibility="public"}}
        <div class="pc__locked-overlay">
          <span class="pc__locked-badge">
            <i class="ph ph-lock" aria-hidden="true"></i>
            {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
          </span>
        </div>
      {{/has}}{{/unless}}
    </a>
  {{/if}}

  <div class="pc__body">
    <div class="pc__tags">
      {{#primary_tag}}<a href="{{url}}" class="pc__tag pc__tag--primary">{{name}}</a>{{/primary_tag}}
      {{#if featured}}<span class="pc__tag pc__tag--featured"><i class="ph-fill ph-fire" aria-hidden="true"></i> Featured</span>{{/if}}
      {{#unless feature_image}}{{#unless access}}{{^has visibility="public"}}
        <span class="pc__tag pc__tag--locked"><i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members{{else}}Paid{{/has}}</span>
      {{/has}}{{/unless}}{{/unless}}
    </div>
    <h2 class="pc__title"><a href="{{url}}" class="pc__title-link">{{title}}</a></h2>
    {{#if excerpt}}<p class="pc__excerpt pc__excerpt--2line">{{excerpt}}</p>{{/if}}
    <footer class="pc__blog-footer">
      {{#primary_author}}
        <a href="{{url}}" class="pc__author">
          {{#if profile_image}}
            <img src="{{img_url profile_image size="xxs"}}" alt="{{name}}" class="pc__author-img">
          {{else}}
            <span class="pc__author-fallback" aria-hidden="true">{{name.[0]}}</span>
          {{/if}}
          <span class="pc__author-name">{{name}}</span>
        </a>
      {{/primary_author}}
      <div class="pc__blog-meta">
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
        {{#if reading_time}}
          <span class="pc__meta-dot" aria-hidden="true"></span>
          <span><i class="ph ph-clock" aria-hidden="true"></i> {{reading_time}}</span>
        {{/if}}
      </div>
    </footer>
  </div>

</article>

{{!-- ══ VIDEO ═══════════════════════════════════════════════════════════════ --}}
{{else has tag="#video"}}
<article class="pc pc--video {{post_class}}" aria-label="{{title}}">

  <a href="{{url}}" class="pc__img-wrap pc__img-wrap--wide" tabindex="-1" aria-hidden="true">
    {{#if feature_image}}
      <img
        srcset="{{img_url feature_image size="s"}} 300w,
                {{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        class="pc__img" loading="lazy">
    {{else}}
      <div class="pc__placeholder pc__placeholder--video">
        <i class="ph ph-video-camera" aria-hidden="true"></i>
      </div>
    {{/if}}
    <div class="pc__video-play" aria-hidden="true">
      <i class="ph-fill ph-play-circle"></i>
    </div>
    {{#if reading_time}}
      <span class="pc__video-dur">
        <i class="ph ph-clock" aria-hidden="true"></i> {{reading_time}}
      </span>
    {{/if}}
    {{#unless access}}{{^has visibility="public"}}
      <div class="pc__locked-overlay">
        <span class="pc__locked-badge">
          <i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
        </span>
      </div>
    {{/has}}{{/unless}}
  </a>

  <div class="pc__body">
    <div class="pc__tags">
      {{#primary_tag}}<a href="{{url}}" class="pc__tag pc__tag--primary">{{name}}</a>{{/primary_tag}}
      {{#unless feature_image}}{{#unless access}}{{^has visibility="public"}}
        <span class="pc__tag pc__tag--locked"><i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members{{else}}Paid{{/has}}</span>
      {{/has}}{{/unless}}{{/unless}}
    </div>
    <h2 class="pc__title"><a href="{{url}}" class="pc__title-link">{{title}}</a></h2>
    {{#if excerpt}}<p class="pc__excerpt">{{excerpt}}</p>{{/if}}
    <footer class="pc__meta">
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
    </footer>
  </div>

</article>

{{!-- ══ TRAINING ════════════════════════════════════════════════════════════ --}}
{{else has tag="#training"}}
<article class="pc pc--training {{post_class}}" aria-label="{{title}}">

  <div class="pc__training-icon" aria-hidden="true">
    <i class="ph ph-graduation-cap"></i>
  </div>

  <div class="pc__body">
    <div class="pc__tags">
      {{#primary_tag}}<a href="{{url}}" class="pc__tag pc__tag--primary">{{name}}</a>{{/primary_tag}}
      <span class="pc__tag pc__tag--section">Training</span>
    </div>
    <h2 class="pc__title pc__title--sm">
      <a href="{{url}}" class="pc__title-link">{{title}}</a>
    </h2>
    {{#if excerpt}}<p class="pc__excerpt pc__excerpt--1line">{{excerpt}}</p>{{/if}}
    <footer class="pc__meta pc__meta--flush">
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
      {{#if reading_time}}
        <span class="pc__meta-dot" aria-hidden="true"></span>
        <span><i class="ph ph-clock" aria-hidden="true"></i> {{reading_time}}</span>
      {{/if}}
    </footer>
  </div>

  <i class="ph ph-arrow-right pc__training-arrow" aria-hidden="true"></i>

</article>

{{!-- ══ DEFAULT ══════════════════════════════════════════════════════════════ --}}
{{else}}
<article class="pc pc--default {{post_class}}" aria-label="{{title}}">

  {{#if feature_image}}
