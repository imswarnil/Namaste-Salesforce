{{!-- Namaste Salesforce: Bulma & SLDS Post Card --}}

<article class="card is-hoverable is-flex is-flex-direction-column {{post_class}}" style="height: 100%;">

    {{!-- 1. CARD IMAGE --}}
    {{#if feature_image}}
    <div class="card-image">
        <a href="{{url}}" class="image is-2by1" style="display: block;">
            <img 
                srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 600w,
                        {{img_url feature_image size="l"}} 1000w,
                        {{img_url feature_image size="xl"}} 2000w"
                sizes="(max-width: 1000px) 400px, 800px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy"
                style="object-fit: cover;"
            />

            {{!-- Locked Content Overlay --}}
            {{#unless access}}
            {{^has visibility="public"}}
                <div class="is-overlay is-flex is-justify-content-center is-align-items-center has-background-black-ter" style="background-color: rgba(8, 7, 7, 0.7) !important;">
                    <span class="has-text-white has-text-weight-bold is-flex is-align-items-center">
                        <i class="ph ph-lock mr-2 is-size-5"></i>
                        {{#has visibility="members"}}Members only{{else}}Paid-members only{{/has}}
                    </span>
                </div>
            {{/has}}
            {{/unless}}
        </a>
    </div>
    {{/if}}

    {{!-- 2. CARD CONTENT --}}
    <div class="card-content is-flex-grow-1 is-flex is-flex-direction-column pb-4">
        
        <div class="mb-4">
            {{!-- Tags --}}
            <div class="tags are-small mb-2">
                {{#primary_tag}}
                    <a href="{{url}}" class="tag is-primary is-light has-text-weight-bold">{{name}}</a>
                {{/primary_tag}}
                
                {{#if featured}}
                    <span class="tag is-warning is-light has-text-weight-bold">
                        <i class="ph-fill ph-fire mr-1 has-text-warning-dark"></i> Featured
                    </span>
                {{/if}}
            </div>

            {{!-- Title --}}
            <h2 class="title is-4 mb-2" style="line-height: 1.3;">
                <a href="{{url}}" class="has-text-dark">
                    {{#unless access}}
                    {{^has visibility="public"}}
                        {{#unless feature_image}}
                            <i class="ph ph-lock has-text-grey-light mr-1"></i>
                        {{/unless}}
                    {{/has}}
                    {{/unless}}
                    {{title}}
                </a>
            </h2>

            {{!-- Excerpt --}}
            {{#if excerpt}}
                <div class="content has-text-grey-dark is-size-6" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                    {{excerpt}}
                </div>
            {{/if}}
        </div>

        {{!-- 3. CARD FOOTER / META --}}
        <div class="is-flex is-align-items-center is-justify-content-space-between mt-auto pt-3" style="border-top: 1px solid #DDDBDA;">
            
            <time class="is-size-7 has-text-grey has-text-weight-medium" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMM YYYY"}}
            </time>
            
            <div class="is-size-7 has-text-grey is-flex is-align-items-center has-text-weight-medium">
                {{#if reading_time}}
                    <span class="is-flex is-align-items-center mr-3">
                        <i class="ph ph-clock mr-1 is-size-6"></i> {{reading_time}}
                    </span>
                {{/if}}
                
                {{#if @site.comments_enabled}}
                    <span class="is-flex is-align-items-center">
                        <i class="ph ph-chat-circle mr-1 is-size-6"></i> {{comment_count}}
                    </span>
                {{/if}}
            </div>

        </div>

    </div>

</article>