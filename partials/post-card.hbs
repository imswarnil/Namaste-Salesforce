{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-card.hbs — one post in a collection
  ----------------------------------------------------------------------------
  Context: a single post inside {{#foreach posts}} (index / tag / author / home
  / blog). Renders the .ns-pcard COMPONENT — see 2-components/post-card.css and
  /styleguide/home-post-card.html.

  Param: variant — any .ns-pcard modifier, e.g.
      {{> post-card variant="ns-pcard--row"}}
      {{> post-card variant="ns-pcard--overlay"}}
      {{> post-card variant="ns-pcard--compact"}}

  The TITLE carries the stretched link, so the whole card is clickable while
  the title stays the real anchor — screen readers announce it and middle-click
  still works. That is why the cover is not itself a link.
═══════════════════════════════════════════════════════════════════════════ --}}
<article class="ns-pcard js-spotlight group {{variant}}">

  {{!-- ── Cover ── --}}
  <div class="ns-pcard__media">
    {{#if feature_image}}
      <img decoding="async" loading="lazy"
        srcset="{{img_url feature_image size="s"}} 300w,
                {{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width: 1000px) 400px, 800px"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    {{else}}
      <span class="ns-pcard__fallback"><i class="ph ph-image" aria-hidden="true"></i></span>
    {{/if}}

    {{!-- Access state — a badge, not a wash, unless the cover must be obscured --}}
    {{#unless access}}
      {{^has visibility="public"}}
        <span class="ns-pcard__badge ns-badge ns-badge--glass">
          {{#match visibility "members"}}<i class="ph-fill ph-user-circle" aria-hidden="true"></i>{{t "Members only"}}
          {{else match visibility "paid"}}<i class="ph-fill ph-crown-simple" aria-hidden="true"></i>{{t "Paid-members only"}}
          {{else}}<i class="ph-fill ph-star" aria-hidden="true"></i>{{t "Tier exclusive"}}{{/match}}
        </span>
      {{/has}}
    {{/unless}}

    {{#if featured}}
      <span class="ns-pcard__badge ns-badge ns-badge--solid"><i class="ph-fill ph-star" aria-hidden="true"></i>{{t "Featured"}}</span>
    {{/if}}

    {{#has tag="#video"}}
      {{#if access}}
        <span class="ns-video-poster__play"><span><i class="ph-fill ph-play" aria-hidden="true"></i></span></span>
      {{/if}}
    {{/has}}
  </div>

  {{!-- ── Body ── --}}
  <div class="ns-pcard__body">
    {{#primary_tag}}<span class="ns-kicker ns-kicker--sm">{{name}}</span>{{/primary_tag}}

    <h2 class="ns-pcard__title">
      <a href="{{url}}">
        {{#unless access}}{{^has visibility="public"}}{{#unless feature_image}}
          <i class="ph-fill ph-lock align-middle text-sm text-muted" aria-hidden="true"></i>
        {{/unless}}{{/has}}{{/unless}}
        {{title}}
      </a>
    </h2>

    {{#if excerpt}}
      <p class="ns-pcard__excerpt">{{excerpt words="22"}}&hellip;</p>
    {{/if}}

    {{!-- Courses get a CTA instead of meta; everything else gets the readout --}}
    {{#has tag="#course"}}
      <span class="ns-btn ns-btn--primary ns-btn--sm mt-3 w-full">
        {{#unless access}}
          <i class="ph ph-lock" aria-hidden="true"></i>{{t "Enroll to Access"}}
        {{else}}
          <i class="ph ph-play" aria-hidden="true"></i>{{t "Start Course"}}
        {{/unless}}
      </span>
    {{else}}
      <div class="ns-pcard__meta">
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
        {{#if reading_time}}<span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>{{/if}}
        {{#if @site.comments_enabled}}<span>{{comment_count}} {{t "comments"}}</span>{{/if}}
      </div>
    {{/has}}
  </div>
</article>
