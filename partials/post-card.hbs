{{!-- partials/post-card.hbs --}}
<article class="card is-flex is-flex-direction-column is-shadowless card-post">

  {{!-- ── IMAGE ── --}}
  <a href="{{url}}" class="is-relative is-block is-clipped card-post-image-wrap" tabindex="-1">

    {{#if feature_image}}
      <figure class="image is-16by9">
        <img
          class="has-ratio card-post-image"
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w,
                  {{img_url feature_image size="xl"}} 2000w"
          sizes="(max-width: 1000px) 400px, 800px"
          src="{{img_url feature_image size="m"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="lazy">
      </figure>

    {{else}}
      <figure class="image is-16by9 has-background-light is-flex is-align-items-center is-justify-content-center">
        <span class="icon is-large has-text-grey-light">
          <i class="ph ph-image is-size-2"></i>
        </span>
      </figure>
    {{/if}}

    {{!-- Lock Overlay --}}
    {{#unless access}}
      {{^has visibility="public"}}
        <div class="is-overlay is-flex is-align-items-center is-justify-content-center card-post-lock-overlay">
          <span class="tag is-dark is-medium is-rounded has-text-weight-bold">
            <span class="icon is-small mr-1"><i class="ph-fill ph-lock"></i></span>
            {{#has visibility="members"}}{{t "Members only"}}{{else}}{{t "Paid-members only"}}{{/has}}
          </span>
        </div>
      {{/has}}
    {{/unless}}

    {{!-- Video Play Overlay --}}
    {{#has tag="#video"}}
      {{#if access}}
        <div class="is-overlay is-flex is-align-items-center is-justify-content-center">
          <span class="is-flex is-align-items-center is-justify-content-center has-text-white card-post-play-btn">
            <i class="ph-fill ph-play-circle is-size-1"></i>
          </span>
        </div>
      {{/if}}
    {{/has}}

  </a>

  {{!-- ── CONTENT ── --}}
  <div class="card-content is-flex-grow-1 is-flex is-flex-direction-column">

    {{!-- Tags --}}
    <div class="tags mb-2">
      {{#primary_tag}}
        <a href="{{url}}" class="tag is-light is-rounded has-text-weight-semibold
          {{#has tag="#course"}}is-primary{{/has}}
          {{#has tag="#video"}}is-danger{{/has}}
          {{#has tag="#blog"}}is-link{{/has}}">
          {{name}}
        </a>
      {{/primary_tag}}

      {{#if featured}}
        <span class="tag is-warning is-light is-rounded has-text-weight-semibold">
          <span class="icon is-small mr-1"><i class="ph-fill ph-star"></i></span>
          {{t "Featured"}}
        </span>
      {{/if}}
    </div>

    {{!-- Title --}}
    <h2 class="title is-5 mb-2">
      <a href="{{url}}" class="has-text-dark">
        {{#unless access}}
          {{^has visibility="public"}}
            {{#unless feature_image}}
              <span class="icon is-small has-text-grey mr-1"><i class="ph-fill ph-lock"></i></span>
            {{/unless}}
          {{/has}}
        {{/unless}}
        {{title}}
      </a>
    </h2>

    {{!-- Excerpt --}}
    {{#if excerpt}}
      <p class="is-size-6 has-text-grey is-flex-grow-1 mb-4">
        {{excerpt words="20"}}&hellip;
      </p>
    {{/if}}

    {{!-- ── FOOTER ── --}}
    <div class="mt-auto pt-3 card-post-footer">

      {{!-- Course CTA --}}
      {{#has tag="#course"}}
        <a href="{{url}}" class="button is-primary is-fullwidth is-rounded has-text-weight-bold">
          {{#unless access}}
            <span class="icon is-small"><i class="ph ph-lock"></i></span>
            <span>{{t "Enroll to Access"}}</span>
          {{else}}
            <span>{{t "Start Course"}}</span>
          {{/unless}}
        </a>

      {{!-- Standard Meta --}}
      {{else}}
        <div class="level is-mobile is-size-7 has-text-grey has-text-weight-semibold">
          <div class="level-left">
            <div class="level-item">
              <span class="icon is-small mr-1"><i class="ph ph-calendar-blank"></i></span>
              <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            </div>
            {{#if reading_time}}
              <div class="level-item">
                <span class="icon is-small mr-1"><i class="ph ph-clock"></i></span>
                {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
              </div>
            {{/if}}
          </div>
          {{#if @site.comments_enabled}}
            <div class="level-right">
              <div class="level-item">
                <span class="icon is-small mr-1"><i class="ph ph-chat-circle"></i></span>
                {{comment_count}}
              </div>
            </div>
          {{/if}}
        </div>
      {{/has}}

    </div>
  </div>
</article>

<style>
  /* ── Post Card ── */
.card-post {
  height: 100%;
  border-radius: 12px;
  border: 1px solid #eaeaea;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card-post:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
}

.card-post-image-wrap {
  border-radius: 12px 12px 0 0;
}

/* object-fit cannot be a Bulma class — required for ratio wrapper */
.card-post-image {
  object-fit: cover;
}

/* Semi-transparent lock overlay */
.card-post-lock-overlay {
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(2px);
}

/* Circular play button */
.card-post-play-btn {
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  width: 64px;
  height: 64px;
}

/* Footer divider */
.card-post-footer {
  border-top: 1px solid #f0f0f0;
}
</style>