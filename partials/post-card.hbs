{{!-- ══════════════════════════════════════════════════════════════════════
     post-card — one post in a listing, on NSDS's .ns-card.
     ------------------------------------------------------------------------
     This file WAS a leftover from Casper: it referenced `icons/lock`,
     `icons/fire` and `@custom.feed_layout`, none of which exist in this theme.
     gscan was failing on it. That is `abstract/10`'s pattern in miniature —
     markup that survived a reset because nothing rendered it, and so nobody
     noticed it had stopped being true.

     {{post_class}} puts Ghost's own state classes on the element — featured,
     no-image, access-restricted — so a listing can style those cases without
     the template growing a branch for each one.

     ACCESS: `{{#unless access}}` is true when the CURRENT READER cannot read
     the post, which is not the same as the post being paid. It is the right
     test for a padlock, because a paying member should not see one.
     ══════════════════════════════════════════════════════════════════════ --}}
<article class="ns-card ns-card--hover {{post_class}}">

    {{#if feature_image}}
        {{!-- Hidden from the accessibility tree and the tab order because the
              title link below goes to the same place. Announcing the
              destination twice is noise, and a decorative image carrying a
              duplicated label is worse than no image at all. --}}
        <a class="ns-card__media" href="{{url}}" tabindex="-1" aria-hidden="true">
            <img srcset="{{img_url feature_image size="s"}} 300w,
                         {{img_url feature_image size="m"}} 600w,
                         {{img_url feature_image size="l"}} 1000w"
                 sizes="(min-width: 48rem) 20rem, 100vw"
                 src="{{img_url feature_image size="m"}}"
                 alt="" loading="lazy" decoding="async">
        </a>
    {{/if}}

    <div class="ns-card__body">

        <div class="ns-card__kicker">
            {{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}
            {{#unless access}}
                <span class="ns-laccess">
                    <i class="ph ph-lock-simple" aria-hidden="true"></i>
                    {{#has visibility="paid"}}{{t "Paid"}}{{else}}{{t "Members"}}{{/has}}
                </span>
            {{/unless}}
        </div>

        <h2 class="ns-card__title"><a class="ns-card__link" href="{{url}}">{{title}}</a></h2>

        {{#if excerpt}}
            <p class="ns-card__text">{{excerpt}}</p>
        {{/if}}

        <div class="ns-card__foot">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
            {{#if reading_time}}<span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>{{/if}}
        </div>

    </div>

</article>
