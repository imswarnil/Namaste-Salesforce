      {{#unless access}}{{^has visibility="public"}}
        <div class="pc__locked-overlay">
          <span class="pc__locked-badge">
            <i class="ph ph-lock" aria-hidden="true"></i>
            {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
          </span>
        </div>
      {{/has}}{{/unless}}
    </a>
  {{/if}}

  <div class="pc__body">
    <div class="pc__tags">
      {{#primary_tag}}<a href="{{url}}" class="pc__tag pc__tag--primary">{{name}}</a>{{/primary_tag}}
      {{#if featured}}<span class="pc__tag pc__tag--featured"><i class="ph-fill ph-fire" aria-hidden="true"></i> Featured</span>{{/if}}
      {{#unless feature_image}}{{#unless access}}{{^has visibility="public"}}
        <span class="pc__tag pc__tag--locked"><i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members{{else}}Paid{{/has}}</span>
