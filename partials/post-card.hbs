{{!-- ══════════════════════════════════════════════════════════════════════
     post-card — ported from the card in NSDS templates/blog-listing.html.
     ------------------------------------------------------------------------
     ONE card. Every listing uses it. The last theme grew two post cards that
     diverged, which is the cheapest possible version of the mistake in
     abstract/09 — if a collection needs a different card, it needs a
     different NSDS component, not a copy of this one.

     .ns-ph is NSDS's placeholder fill: it draws the hairline-grid motif when
     there is no image, so a post without a feature image is a deliberate
     surface rather than a hole.
     ══════════════════════════════════════════════════════════════════════ --}}
<article class="ns-card ns-bcard">
    <span class="ns-bcard__cover{{#unless feature_image}} ns-bcard__cover--empty{{/unless}}">
        {{#if feature_image}}
            <img class="ns-card__media" src="{{img_url feature_image size="m"}}"
                 srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
                 sizes="(min-width: 900px) 400px, 100vw"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}" loading="lazy">
        {{else}}
            <span class="ns-card__media ns-ph" aria-hidden="true"></span>
        {{/if}}
        {{#primary_tag}}<span class="ns-tag ns-bcard__cat">{{name}}</span>{{/primary_tag}}
    </span>

    <div class="ns-card__body">
        {{!-- The link wraps the heading, not the card: a card-wide link
             swallows the tag chip and the author link inside it. --}}
        <a class="ns-card__link" href="{{url}}"><h3 class="ns-bcard__title">{{title}}</h3></a>
        {{#if excerpt}}<p class="ns-bcard__excerpt">{{excerpt words="24"}}</p>{{/if}}
        <div class="ns-postmeta">
            <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></span>
            <span>{{reading_time}}</span>
        </div>
    </div>
</article>
