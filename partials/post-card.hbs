{{!-- A blog post card. Context: a post (include tags, authors).
Pass feature=true for the full-width variant on listing page 1. --}}

<article class="card {{#if feature}}card-feature{{/if}}">

    {{#if feature_image}}
        <div class="card-media">
            <img src="{{img_url feature_image size="m"}}"
                srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
                sizes="{{#if feature}}(max-width: 900px) 92vw, 640px{{else}}(max-width: 700px) 92vw, 400px{{/if}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy" />
            {{#if featured}}
                <div class="chips"><span class="chip chip-featured">{{> "icons/fire"}} {{t "Featured"}}</span></div>
            {{/if}}
        </div>
    {{/if}}

    <div class="card-body">
        {{#primary_tag}}
            <div class="card-eyebrow"><span>{{name}}</span></div>
        {{/primary_tag}}

        <h3 class="card-title"><a class="card-link" href="{{url}}">{{title}}</a></h3>

        {{#if excerpt}}
            <p class="card-excerpt">{{excerpt words="30"}}</p>
        {{/if}}

        <div class="card-meta">
            <span>{{> "icons/calendar"}} <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></span>
            {{#if reading_time}}
                <span>{{> "icons/clock"}} {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
            {{/if}}
        </div>
    </div>

</article>
