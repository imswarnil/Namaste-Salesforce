{{!-- =========================================================================
  partials/post-card.hbs  ·  Namaste Salesforce
  Bulma-native card system. Base: .card  Variants: .card-{type}
  All 5 variants auto-selected by tag:
    #course   → .card.card-course   accent bar, placeholder, CTA, access badge
    #blog     → .card.card-blog     author avatar, 2-line excerpt, editorial footer
    #video    → .card.card-video    16:9, play overlay, duration badge
    #training → .card.card-training horizontal row, icon, slide-right hover
    default   → .card.card-default  everything else (lessons, resources, pages)
  Locked states handled in all variants:
    has image  → dark blur overlay + badge over the thumbnail
    no image   → lock pill in tag row
  Usage anywhere: {{> "post-card"}}
========================================================================== --}}

{{!-- ══ COURSE ═══════════════════════════════════════════════════════════════ --}}
{{#has tag="#course"}}
<article class="card card-course {{post_class}}" aria-label="{{title}}">

  {{!-- Image / Placeholder --}}
  <a href="{{url}}" class="card-image" tabindex="-1" aria-hidden="true">
    {{#if feature_image}}
      <figure class="image is-16by9">
        <img
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
          src="{{img_url feature_image size="m"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="lazy">
      </figure>
    {{else}}
      <figure class="image is-16by9">
        <div class="card__placeholder card__placeholder--course">
          <i class="ph ph-book-open" aria-hidden="true"></i>
        </div>
      </figure>
    {{/if}}

    {{!-- Access badge --}}
    {{#has visibility="public"}}
      <span class="tag card__access-badge card__access-badge--free">Free</span>
    {{else has visibility="members"}}
      <span class="tag card__access-badge card__access-badge--members">
        <i class="ph ph-star" aria-hidden="true"></i> Members
      </span>
    {{else}}
      <span class="tag card__access-badge card__access-badge--paid">
        <i class="ph ph-crown" aria-hidden="true"></i> Paid
      </span>
    {{/has}}

    {{!-- Lock overlay (image present, user lacks access) --}}
    {{#unless access}}{{^has visibility="public"}}
      <div class="card__locked-overlay">
        <span class="card__locked-badge">
          <i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
        </span>
      </div>
    {{/has}}{{/unless}}
  </a>

  {{!-- Body --}}
  <div class="card-content">

    <div class="tags mb-2">
      {{#primary_tag}}
        <a href="{{url}}" class="tag is-primary">{{name}}</a>
      {{/primary_tag}}
      {{#if featured}}
        <span class="tag is-warning">
          <i class="ph-fill ph-fire" aria-hidden="true"></i>&nbsp;Featured
        </span>
      {{/if}}
    </div>

    <h2 class="title is-6 mb-2">
      <a href="{{url}}">{{title}}</a>
    </h2>

    {{#if excerpt}}
      <p class="subtitle is-7 mb-3">{{excerpt}}</p>
    {{/if}}

    {{!-- Course meta: level + duration from internal tags --}}
    <div class="tags card__course-meta mb-3">
      {{#foreach tags visibility="internal"}}
        {{#match slug "~^" "hash-course-level-"}}{{#if description}}
          <span class="tag is-light">
            <i class="ph ph-signal-high" aria-hidden="true"></i>&nbsp;{{description}}
          </span>
        {{/if}}{{/match}}
      {{/foreach}}
      {{#foreach tags visibility="internal"}}
        {{#match slug "~^" "hash-course-duration-"}}{{#if description}}
          <span class="tag is-light">
            <i class="ph ph-clock" aria-hidden="true"></i>&nbsp;{{description}}
          </span>
        {{/if}}{{/match}}
      {{/foreach}}
    </div>

    {{!-- CTA --}}
    <a href="{{url}}" class="button is-primary is-fullwidth">
      {{#unless access}}{{^has visibility="public"}}
        <span class="icon is-small"><i class="ph ph-lock" aria-hidden="true"></i></span>
        <span>{{#has visibility="members"}}Join to access{{else}}Subscribe{{/has}}</span>
      {{else}}
        <span class="icon is-small"><i class="ph ph-play-circle" aria-hidden="true"></i></span>
        <span>Start Course</span>
      {{/has}}
      {{else}}
        <span class="icon is-small"><i class="ph ph-play-circle" aria-hidden="true"></i></span>
        <span>Start Course</span>
      {{/unless}}
    </a>

  </div>
</article>

{{!-- ══ BLOG ════════════════════════════════════════════════════════════════ --}}
{{else has tag="#blog"}}
<article class="card card-blog {{post_class}}" aria-label="{{title}}">

  {{!-- Image (optional) --}}
  {{#if feature_image}}
    <a href="{{url}}" class="card-image" tabindex="-1" aria-hidden="true">
      <figure class="image is-16by9">
        <img
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
          src="{{img_url feature_image size="m"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="lazy">
      </figure>
      {{#unless access}}{{^has visibility="public"}}
        <div class="card__locked-overlay">
          <span class="card__locked-badge">
            <i class="ph ph-lock" aria-hidden="true"></i>
            {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
          </span>
        </div>
      {{/has}}{{/unless}}
    </a>
  {{/if}}

  {{!-- Body --}}
  <div class="card-content">

    <div class="tags mb-2">
      {{#primary_tag}}
        <a href="{{url}}" class="tag is-primary">{{name}}</a>
      {{/primary_tag}}
      {{#if featured}}
        <span class="tag is-warning">
          <i class="ph-fill ph-fire" aria-hidden="true"></i>&nbsp;Featured
        </span>
      {{/if}}
      {{!-- Lock pill when no image --}}
      {{#unless feature_image}}{{#unless access}}{{^has visibility="public"}}
        <span class="tag card__tag--locked">
          <i class="ph ph-lock" aria-hidden="true"></i>&nbsp;{{#has visibility="members"}}Members{{else}}Paid{{/has}}
        </span>
      {{/has}}{{/unless}}{{/unless}}
    </div>

    <h2 class="title is-6 mb-2">
      <a href="{{url}}">{{title}}</a>
    </h2>

    {{#if excerpt}}
      <p class="subtitle is-7 card__excerpt--2line">{{excerpt}}</p>
    {{/if}}

  </div>

  {{!-- Footer: author + meta --}}
  <footer class="card-footer">
    {{#primary_author}}
      <a href="{{url}}" class="card-footer-item card__author">
        {{#if profile_image}}
          <img src="{{img_url profile_image size="xxs"}}" alt="{{name}}" class="card__author-img">
        {{else}}
          <span class="card__author-fallback" aria-hidden="true">{{name.[0]}}</span>
        {{/if}}
        <span class="card__author-name">{{name}}</span>
      </a>
    {{/primary_author}}
    <div class="card-footer-item card__blog-meta">
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
      {{#if reading_time}}
        <span class="card__meta-dot" aria-hidden="true"></span>
        <span><i class="ph ph-clock" aria-hidden="true"></i>&nbsp;{{reading_time}}</span>
      {{/if}}
    </div>
  </footer>

</article>

{{!-- ══ VIDEO ═══════════════════════════════════════════════════════════════ --}}
{{else has tag="#video"}}
<article class="card card-video {{post_class}}" aria-label="{{title}}">

  {{!-- Image / Placeholder with play overlay --}}
  <a href="{{url}}" class="card-image" tabindex="-1" aria-hidden="true">
    {{#if feature_image}}
      <figure class="image is-16by9">
        <img
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
          src="{{img_url feature_image size="m"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="lazy">
      </figure>
    {{else}}
      <figure class="image is-16by9">
        <div class="card__placeholder card__placeholder--video">
          <i class="ph ph-video-camera" aria-hidden="true"></i>
        </div>
      </figure>
    {{/if}}

    {{!-- Play button overlay --}}
    <div class="card__play" aria-hidden="true">
      <i class="ph-fill ph-play-circle"></i>
    </div>

    {{!-- Duration badge --}}
    {{#if reading_time}}
      <span class="tag card__duration">
        <i class="ph ph-clock" aria-hidden="true"></i>&nbsp;{{reading_time}}
      </span>
    {{/if}}

    {{!-- Lock overlay --}}
    {{#unless access}}{{^has visibility="public"}}
      <div class="card__locked-overlay">
        <span class="card__locked-badge">
          <i class="ph ph-lock" aria-hidden="true"></i>
          {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
        </span>
      </div>
    {{/has}}{{/unless}}
  </a>

  {{!-- Body --}}
  <div class="card-content">

    <div class="tags mb-2">
      {{#primary_tag}}
        <a href="{{url}}" class="tag is-primary">{{name}}</a>
      {{/primary_tag}}
      {{!-- Lock pill when no image --}}
      {{#unless feature_image}}{{#unless access}}{{^has visibility="public"}}
        <span class="tag card__tag--locked">
          <i class="ph ph-lock" aria-hidden="true"></i>&nbsp;{{#has visibility="members"}}Members{{else}}Paid{{/has}}
        </span>
      {{/has}}{{/unless}}{{/unless}}
    </div>

    <h2 class="title is-6 mb-2">
      <a href="{{url}}">{{title}}</a>
    </h2>

    {{#if excerpt}}
      <p class="subtitle is-7">{{excerpt}}</p>
    {{/if}}

  </div>

  {{!-- Footer: date --}}
  <footer class="card-footer">
    <div class="card-footer-item card__video-meta">
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
    </div>
  </footer>

</article>

{{!-- ══ TRAINING ════════════════════════════════════════════════════════════ --}}
{{else has tag="#training"}}
<article class="card card-training {{post_class}}" aria-label="{{title}}">

  {{!-- Left icon column --}}
  <div class="card__training-icon" aria-hidden="true">
    <span class="icon is-medium">
      <i class="ph ph-graduation-cap"></i>
    </span>
  </div>

  {{!-- Body --}}
  <div class="card-content">
    <div class="tags mb-1">
      {{#primary_tag}}
        <a href="{{url}}" class="tag is-primary">{{name}}</a>
      {{/primary_tag}}
      <span class="tag is-light">Training</span>
    </div>

    <h2 class="title is-6 mb-1">
      <a href="{{url}}">{{title}}</a>
    </h2>

    {{#if excerpt}}
      <p class="subtitle is-7 card__excerpt--1line mb-2">{{excerpt}}</p>
    {{/if}}

    <div class="card__training-meta">
      <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
      {{#if reading_time}}
        <span class="card__meta-dot" aria-hidden="true"></span>
        <span><i class="ph ph-clock" aria-hidden="true"></i>&nbsp;{{reading_time}}</span>
      {{/if}}
    </div>
  </div>

  {{!-- Right arrow --}}
  <div class="card__training-arrow" aria-hidden="true">
    <span class="icon"><i class="ph ph-arrow-right"></i></span>
  </div>

</article>

{{!-- ══ DEFAULT ══════════════════════════════════════════════════════════════ --}}
