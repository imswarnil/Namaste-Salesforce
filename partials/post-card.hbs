{{!-- partials/post-card.hbs --}}
<article class="ns-card is-hoverable" style="height: 100%; display: flex; flex-direction: column;">

  {{!-- ── IMAGE ── --}}
  <a href="{{url}}" class="is-relative is-block is-clipped" tabindex="-1" style="border-radius: 12px 12px 0 0; overflow: hidden;">

    {{#if feature_image}}
      <figure class="image is-16by9">
        <img
          class="has-ratio"
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w,
                  {{img_url feature_image size="xl"}} 2000w"
          sizes="(max-width: 1000px) 400px, 800px"
          src="{{img_url feature_image size="m"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="lazy"
          style="object-fit: cover; width: 100%; height: 100%;">
      </figure>

    {{else}}
      <figure class="image is-16by9 is-flex is-align-items-center is-justify-content-center" style="background: linear-gradient(135deg, hsl(var(--ns-hue,240) 70% 15%), hsl(var(--ns-hue,240) 60% 25%));">
        <span class="icon is-large" style="opacity: 0.4;">
          <i class="ph ph-image" style="font-size: 3rem; color: #fff;"></i>
        </span>
      </figure>
    {{/if}}

    {{!-- Lock Overlay --}}
    {{#unless access}}
      {{^has visibility="public"}}
        <div class="is-overlay is-flex is-align-items-center is-justify-content-center" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(3px);">
          <span class="tag is-dark is-medium is-rounded has-text-weight-bold">
            <span class="icon is-small mr-1"><i class="ph-fill ph-lock"></i></span>
            {{#has visibility="members"}}{{t "Members only"}}{{else}}{{t "Paid-members only"}}{{/has}}
          </span>
        </div>
      {{/has}}
    {{/unless}}

    {{!-- Video Play Overlay --}}
    {{#has tag="#video"}}
      {{#if access}}
        <div class="is-overlay is-flex is-align-items-center is-justify-content-center">
          <span class="is-flex is-align-items-center is-justify-content-center has-text-white" style="background: rgba(0,0,0,0.45); border-radius: 50%; width: 64px; height: 64px;">
            <i class="ph-fill ph-play-circle" style="font-size: 2.5rem;"></i>
          </span>
        </div>
      {{/if}}
    {{/has}}

  </a>

  {{!-- ── CONTENT ── --}}
  <div class="ns-card__body" style="flex: 1; display: flex; flex-direction: column;">

    {{!-- Badges --}}
    <div class="tags mb-2">
      {{#primary_tag}}
        <a href="{{url}}" class="tag ns-badge
          {{#has tag="#course"}}ns-badge--gradient{{/has}}
          {{#has tag="#blog"}}is-link is-light{{/has}}
          {{#has tag="#video"}}is-danger is-light{{/has}}
          is-rounded has-text-weight-semibold">
          {{name}}
        </a>
      {{/primary_tag}}

      {{#if featured}}
        <span class="tag is-warning is-light is-rounded has-text-weight-semibold">
          <span class="icon is-small mr-1"><i class="ph-fill ph-star"></i></span>
          {{t "Featured"}}
        </span>
      {{/if}}
    </div>

    {{!-- Title --}}
    <h2 class="title is-5 mb-2" style="line-height: 1.3;">
      <a href="{{url}}" class="has-text-weight-bold">
        {{#unless access}}
          {{^has visibility="public"}}
            {{#unless feature_image}}
              <span class="icon is-small has-text-grey mr-1"><i class="ph-fill ph-lock"></i></span>
            {{/unless}}
          {{/has}}
        {{/unless}}
        {{title}}
      </a>
    </h2>

    {{!-- Excerpt --}}
    {{#if excerpt}}
      <p class="is-size-6 mb-4" style="flex: 1; opacity: 0.75;">
        {{excerpt words="20"}}&hellip;
      </p>
    {{/if}}

    {{!-- ── FOOTER ── --}}
    <div class="ns-card__footer">

      {{!-- Course CTA --}}
      {{#has tag="#course"}}
        <a href="{{url}}" class="button is-gradient is-fullwidth is-rounded has-text-weight-bold">
          {{#unless access}}
            <span class="icon is-small"><i class="ph ph-lock"></i></span>
            <span>{{t "Enroll to Access"}}</span>
          {{else}}
            <span class="icon is-small"><i class="ph ph-play"></i></span>
            <span>{{t "Start Course"}}</span>
          {{/unless}}
        </a>

      {{!-- Standard Meta --}}
      {{else}}
        <div class="is-flex is-align-items-center is-justify-content-space-between is-size-7" style="opacity: 0.65; gap: 0.5rem; flex-wrap: wrap;">
          <div class="is-flex is-align-items-center" style="gap: 0.75rem;">
            <span class="is-flex is-align-items-center" style="gap: 0.25rem;">
              <i class="ph ph-calendar-blank"></i>
              <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            </span>
            {{#if reading_time}}
              <span class="is-flex is-align-items-center" style="gap: 0.25rem;">
                <i class="ph ph-clock"></i>
                {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
              </span>
            {{/if}}
          </div>
          {{#if @site.comments_enabled}}
            <span class="is-flex is-align-items-center" style="gap: 0.25rem;">
              <i class="ph ph-chat-circle"></i>
              {{comment_count}}
            </span>
          {{/if}}
        </div>
      {{/has}}

    </div>
  </div>
</article>
