            {{#has visibility="members"}}Members only{{else}}Paid only{{/has}}
          </span>
        </div>
      {{/has}}{{/unless}}
    </a>
  {{/if}}

  {{!-- Body --}}
  <div class="card-content">

    <div class="tags mb-2">
      {{#primary_tag}}
        <a href="{{url}}" class="tag is-primary">{{name}}</a>
      {{/primary_tag}}
      {{#if featured}}
        <span class="tag is-warning">
          <i class="ph-fill ph-fire" aria-hidden="true"></i>&nbsp;Featured
        </span>
      {{/if}}
      {{!-- Lock pill when no image --}}
      {{#unless feature_image}}{{#unless access}}{{^has visibility="public"}}
        <span class="tag card__tag--locked">
