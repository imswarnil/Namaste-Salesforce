{{!--
    post-card.hbs — Namaste Salesforce
    ============================================================
    DISPATCHER — renders the <article> wrapper with all layout
    modifier classes, then includes the correct card partial
    based on post tags. Card partials render inner content only.

    LAYOUT CLASSES (Casper feed_layout system):
      Classic + home + index 0 → post-card-large
      Classic + home + index 1,2 → dynamic
      Grid → keep-ratio
      List (not tag/author) → post-card-large

    CARD TYPE ROUTING:
      #course          → cards/course
      #lesson          → cards/lesson
      #training        → cards/training
      #training-content → cards/training
      documentation    → cards/documentation
      #blog            → cards/blog
      #videos          → cards/video
      (fallback)       → cards/default
    ============================================================
--}}

<article class="post-card {{post_class}}
    {{!-- Feed layout modifiers --}}
    {{#match @custom.feed_layout "Classic"}}
        {{#is "home"}}
            {{#has index="0"}} post-card-large{{/has}}
            {{#has index="1,2"}} dynamic{{/has}}
        {{/is}}
    {{/match}}
    {{#match @custom.feed_layout "Grid"}} keep-ratio{{/match}}
    {{#match @custom.feed_layout "List"}}
        {{^is "tag, author"}} post-card-large{{/is}}
    {{/match}}
    {{!-- Card type class for CSS targeting --}}
    {{#has tag="#course"}} card-course
    {{else has tag="#lesson"}} card-lesson
    {{else has tag="#training-content"}} card-training
    {{else has tag="#training"}} card-training
    {{else has tag="documentation"}} card-doc
    {{else has tag="#blog"}} card-blog
    {{else has tag="#videos"}} card-video
    {{else}} card-default
    {{/has}}
    {{!-- Access modifier --}}
    {{#unless access}} post-access-{{visibility}}{{/unless}}"
>

    {{!-- Route to the correct card partial --}}
    {{#has tag="#course"}}
        {{> "cards/course"}}
    {{else has tag="#lesson"}}
        {{> "cards/lesson"}}
    {{else has tag="#training-content"}}
        {{> "cards/training"}}
    {{else has tag="#training"}}
        {{> "cards/training"}}
    {{else has tag="documentation"}}
        {{> "cards/documentation"}}
    {{else has tag="#blog"}}
        {{> "cards/blog"}}
    {{else has tag="#videos"}}
        {{> "cards/video"}}
    {{else}}
        {{> "cards/default"}}
    {{/has}}

</article>
