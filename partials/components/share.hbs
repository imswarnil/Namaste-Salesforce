{{!-- components/share.hbs
     Social sharing: X, LinkedIn, copy link.
     Use: {{> "components/share"}} inside {{#post}} context. --}}
<div class="share-bar">
    <span class="share-bar__label">{{t "Share"}}</span>
    <div class="share-bar__buttons">
        <a class="btn btn-neutral btn-sm share-btn share-btn--x"
           href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}"
           target="_blank" rel="noopener noreferrer"
           aria-label="{{t "Share on X / Twitter"}}">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>{{t "X"}}</span>
        </a>
        <a class="btn btn-neutral btn-sm share-btn share-btn--li"
           href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}"
           target="_blank" rel="noopener noreferrer"
           aria-label="{{t "Share on LinkedIn"}}">
            <i class="ph ph-linkedin-logo btn-icon" aria-hidden="true"></i>
            <span>LinkedIn</span>
        </a>
        <button class="btn btn-neutral btn-sm share-btn share-btn--copy"
                data-copy-url="{{url absolute="true"}}"
                aria-label="{{t "Copy link"}}">
            <i class="ph ph-link btn-icon" aria-hidden="true"></i>
            <span class="share-copy-label">{{t "Copy link"}}</span>
        </button>
    </div>
</div>

<script>
(function(){
    var btn = document.querySelector('.share-btn--copy');
    if(!btn) return;
    btn.addEventListener('click', function(){
        var url = btn.dataset.copyUrl;
        var lbl = btn.querySelector('.share-copy-label');
        navigator.clipboard.writeText(url).then(function(){
            if(lbl){ lbl.textContent = '{{t "Copied!"}}'; setTimeout(function(){ lbl.textContent = '{{t "Copy link"}}'; }, 2000); }
        }).catch(function(){
            var ta = document.createElement('textarea');
            ta.value = url; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta);
            if(lbl){ lbl.textContent = '{{t "Copied!"}}'; setTimeout(function(){ lbl.textContent = '{{t "Copy link"}}'; }, 2000); }
        });
    });
})();
</script>
