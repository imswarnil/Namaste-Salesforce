{{!-- components/pwa-install.hbs — "Install the app" popup.
     Hidden by default; pwa.js reveals it when the browser fires
     beforeinstallprompt AND the visitor hasn't dismissed it in the last
     3 days. Install → native prompt; Not now → snooze for 3 days. --}}
<div id="ns-pwa-install" class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-sm rounded-card border border-border bg-surface-raised p-4 shadow-raised sm:inset-x-auto sm:right-6" role="dialog" aria-label="{{t "Install app"}}">
  <div class="flex items-start gap-3">
    <img loading="lazy" decoding="async" src="{{asset "logo/icon-192.png"}}" alt="" class="h-11 w-11 shrink-0 rounded-card border border-border">
    <div class="min-w-0 flex-1">
      <p class="font-heading text-sm font-bold text-ink">{{t "Install"}} {{@site.title}}</p>
      <p class="mt-0.5 text-xs text-muted">{{t "Add it to your home screen — instant access, and your lessons keep working offline."}}</p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-pwa-install class="ns-btn ns-btn--primary ns-btn--sm">{{t "Install"}}</button>
        <button type="button" data-pwa-dismiss class="ns-btn ns-btn--outline ns-btn--sm">{{t "Not now"}}</button>
      </div>
    </div>
    <button type="button" data-pwa-dismiss class="shrink-0 text-muted transition hover:text-ink" aria-label="{{t "Dismiss"}}">
      {{> icons name="x"}}
    </button>
  </div>
</div>
