{{!-- components/author-box.hbs — the "written by" card that closes a post or
     a lesson.

     The design system's `.ns-authorbox` (ds/components/css/blog.css): a two-
     column grid of avatar + body, with named parts for the name, the role, the
     bio and the link row. The theme used to declare its own `.ns-authorbox` —
     a plain flex box — which won by cascade order and threw away the grid, the
     avatar sizing and the mono role line. That rule is gone; this markup is the
     system's contract.

     `__avatar` goes on the <img> itself here (not a wrapper), which is what
     the system's rule expects — it sets inline-size/block-size/object-fit
     directly on the element.

     Context: a post (uses {{#primary_author}}). --}}
{{#primary_author}}
<div class="ns-authorbox">
  {{#if profile_image}}
    <img class="ns-authorbox__avatar" loading="lazy" decoding="async" src="{{img_url profile_image size="s"}}" alt="">
  {{else}}
    <span class="ns-avatar ns-avatar--xl">{{> icons name="user"}}</span>
  {{/if}}

  <div class="min-w-0">
    <span class="ns-authorbox__role">{{t "Written by"}}</span>
    <p class="ns-authorbox__name"><a href="{{url}}">{{name}}</a></p>
    {{#if bio}}<p class="ns-authorbox__bio">{{bio}}</p>{{/if}}

    <div class="ns-authorbox__links">
      <a href="{{url}}" class="ns-btn ns-btn--quiet ns-btn--sm">{{> icons name="books"}}{{t "More by"}} {{name}}</a>
      {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" class="ns-btn ns-btn--quiet ns-btn--sm">{{> icons name="globe"}}{{t "Website"}}</a>{{/if}}
      {{#if twitter}}<a href="https://x.com/{{twitter}}" target="_blank" rel="noopener" class="ns-btn ns-btn--quiet ns-btn--sm">{{> icons name="x-logo"}}{{twitter}}</a>{{/if}}
    </div>
  </div>
</div>
{{/primary_author}}
