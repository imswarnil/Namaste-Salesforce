{{!-- components/author-box.hbs — "Written by" author card, shown after lesson
     content. Context: a post (uses {{#primary_author}}). --}}
{{#primary_author}}
<div class="ns-authorbox">
  <span class="ns-ring shrink-0">
    {{#if profile_image}}<img loading="lazy" decoding="async" src="{{img_url profile_image size="s"}}" alt="{{name}}" class="h-16 w-16 object-cover">
    {{else}}<span class="ns-chip h-16 w-16 rounded-full text-2xl">{{> icons name="user" class="text-2xl"}}</span>{{/if}}
  </span>
  <div class="min-w-0">
    <p class="ns-label">{{t "Written by"}}</p>
    <p class="font-heading text-lg font-bold">{{name}}</p>
    {{#if bio}}<p class="mt-1 text-sm text-muted">{{bio}}</p>{{/if}}
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <a href="{{url}}" class="inline-flex items-center gap-1 font-semibold text-brand-600 hover:underline dark:text-brand-300">{{> icons name="books"}}{{t "More by"}} {{name}}</a>
      {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-muted hover:text-brand-600">{{> icons name="globe"}}{{t "Website"}}</a>{{/if}}
      {{#if twitter}}<a href="https://x.com/{{twitter}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-muted hover:text-brand-600">{{> icons name="x-logo"}}{{twitter}}</a>{{/if}}
    </div>
  </div>
</div>
{{/primary_author}}
