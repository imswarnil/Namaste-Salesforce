{{!-- ══════════════════════════════════════════════════════════════════════
     components/reel — the blog sidebar's illustration. Inline SVG, no photo.
     ------------------------------------------------------------------------
     A sidebar slot that holds a PHOTOGRAPH is a slot that needs a photograph,
     and on a site with nothing published that means either a stock image or
     an empty box. Both are worse than a drawing: stock says "this page was
     assembled", and an empty box says "this page is broken".

     So the slot is a drawing, and it draws the one thing the site actually
     has — a filmstrip of what a post IS here: the mark, some code, a lesson.
     Three frames, because three reads as "a series" where two reads as "a
     pair" and four starts needing a fourth idea.

     ── EVERYTHING IS TOKEN-FED, WHICH IS WHY IT SURVIVES DARK MODE ──────────
     No hex anywhere. The strip is currentColor at low alpha, the frames take
     --color-brand-*, and the tags take the surface and border tokens — so the
     illustration re-colours with the theme instead of being a light-mode
     picture sitting on a dark card. That is the whole reason this is markup
     and not an .svg file in assets/: a file cannot see the cascade.

     ── THE FLOATING TAGS ────────────────────────────────────────────────────
     Real <text>, not paths, so they stay legible when the SVG scales and are
     selectable/searchable. They sit at three different depths and two
     different angles, which is what makes them read as floating ABOVE the
     strip rather than printed on it. The label voice — uppercase, tracked —
     is set in CSS, not baked into the glyphs.

     ⚠ role="img" + <title>, and the tags are aria-hidden. The whole thing is
     ONE image with one accessible name; letting a screen reader read six
     scattered words in drawing order is worse than announcing nothing.
     ══════════════════════════════════════════════════════════════════════ --}}
<svg class="sp-reel{{#if class}} {{class}}{{/if}}" viewBox="0 0 320 210"
     xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-reel-title">
    <title id="sp-reel-title">{{t "Writing from Namaste Salesforce"}}</title>

    {{!-- The strip, tilted. One group so the whole reel rotates together and
         the sprockets cannot drift off the frames. --}}
    <g transform="rotate(-6 160 105)">
        <rect class="sp-reel__strip" x="14" y="46" width="292" height="118" rx="6"/>

        {{!-- Sprocket holes, top and bottom. Eight a side at a 36px pitch —
             the pitch is what makes it read as film rather than as a table. --}}
        <g class="sp-reel__holes">
            <rect x="26"  y="55" width="14" height="10" rx="2"/><rect x="26"  y="145" width="14" height="10" rx="2"/>
            <rect x="62"  y="55" width="14" height="10" rx="2"/><rect x="62"  y="145" width="14" height="10" rx="2"/>
            <rect x="98"  y="55" width="14" height="10" rx="2"/><rect x="98"  y="145" width="14" height="10" rx="2"/>
            <rect x="134" y="55" width="14" height="10" rx="2"/><rect x="134" y="145" width="14" height="10" rx="2"/>
            <rect x="170" y="55" width="14" height="10" rx="2"/><rect x="170" y="145" width="14" height="10" rx="2"/>
            <rect x="206" y="55" width="14" height="10" rx="2"/><rect x="206" y="145" width="14" height="10" rx="2"/>
            <rect x="242" y="55" width="14" height="10" rx="2"/><rect x="242" y="145" width="14" height="10" rx="2"/>
            <rect x="278" y="55" width="14" height="10" rx="2"/><rect x="278" y="145" width="14" height="10" rx="2"/>
        </g>

        {{!-- Frame 1 · the mark. The cloud in outline plus the two hands as
             one closed shape — a 40px reduction of the brand mark, redrawn
             simply on purpose: the real geometry has 307 dots in it and none
             of them survive at this size. --}}
        <g class="sp-reel__frame" transform="translate(30 74)">
            <rect class="sp-reel__cell" width="80" height="62" rx="4"/>
            <path class="sp-reel__ink" d="M22 40c-6 0-11-5-11-11s5-11 11-11c0-7 6-13 13-13 5 0 10 3 12 8 1-1 3-1 4-1 6 0 10 4 10 10 5 0 9 4 9 9s-4 9-9 9H22z"/>
            <path class="sp-reel__accent" d="M40 46c-2-4-3-8-3-12 0-2 1-3 2-3s2 1 2 3l1 7 1-9c0-2 1-3 2-3s2 1 2 3l-1 14z"/>
            <path class="sp-reel__accent" d="M52 46c2-4 3-8 3-12 0-2-1-3-2-3s-2 1-2 3l-1 7-1-9c0-2-1-3-2-3s-2 1-2 3l1 14z"/>
        </g>

        {{!-- Frame 2 · code. Angle brackets and a slash: the development half
             of the curriculum, in the two characters everyone reads as code. --}}
        <g class="sp-reel__frame" transform="translate(120 74)">
            <rect class="sp-reel__cell" width="80" height="62" rx="4"/>
            <path class="sp-reel__ink" d="M26 22 14 31l12 9M54 22l12 9-12 9M44 17 36 45"/>
        </g>

        {{!-- Frame 3 · a lesson. Three ruled lines and a tick — a written
             thing, finished. --}}
        <g class="sp-reel__frame" transform="translate(210 74)">
            <rect class="sp-reel__cell" width="80" height="62" rx="4"/>
            <path class="sp-reel__ink" d="M18 22h44M18 31h44M18 40h26"/>
            <path class="sp-reel__accent" d="m50 40 5 5 9-11"/>
        </g>
    </g>

    {{!-- The floating tags. Three, at three depths, two angles. --}}
    <g class="sp-reel__tags" aria-hidden="true">
        <g transform="rotate(-9 66 26)">
            <rect class="sp-reel__tag" x="18" y="12" width="96" height="28" rx="14"/>
            <text class="sp-reel__tagtext" x="66" y="30" text-anchor="middle">{{t "APEX"}}</text>
        </g>
        <g transform="rotate(7 258 40)">
            <rect class="sp-reel__tag" x="206" y="26" width="104" height="28" rx="14"/>
            <text class="sp-reel__tagtext" x="258" y="44" text-anchor="middle">{{t "FLOW"}}</text>
        </g>
        <g transform="rotate(-4 154 186)">
            <rect class="sp-reel__tag" x="92" y="172" width="124" height="28" rx="14"/>
            <text class="sp-reel__tagtext" x="154" y="190" text-anchor="middle">{{t "LWC"}}</text>
        </g>
    </g>
</svg>
