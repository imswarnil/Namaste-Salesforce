{{!-- components/tag-pills.hbs
     A post's tags rendered as pills. Context: a post. Internal (#) tags are
     skipped automatically by Ghost's {{tags}} unless requested. --}}
{{#if tags}}
  <div class="flex flex-wrap gap-2">
    {{#foreach tags}}
      <a href="{{url}}" class="inline-flex items-center gap-1 rounded-pill border border-border px-3 py-1 text-xs font-medium text-muted transition hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-300">
        <i class="ph ph-hash" aria-hidden="true"></i>{{name}}
      </a>
    {{/foreach}}
  </div>
{{/if}}
