{{!-- components/toc.hbs
     Table of Contents shell. JS (toc.js or inline) reads
     .js-toc-content for h2/h3 headings and populates #toc-nav.
     Use: {{> "components/toc"}} anywhere inside a post page.

     VARIANTS (add to wrapper via context):
       .toc--sidebar   → used in right sticky column
       .toc--inline    → used collapsed in mobile accordion
--}}
<div class="toc" id="toc" aria-label="{{t "Table of contents"}}">
    <div class="toc__header" id="toc-toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="toc-nav">
        <p class="toc__heading">
            <i class="ph ph-list-bullets" aria-hidden="true"></i>
            {{t "On this page"}}
        </p>
        <i class="ph ph-caret-down toc__caret" aria-hidden="true"></i>
    </div>
    <nav id="toc-nav" class="toc__nav" aria-label="{{t "Page sections"}}">
        {{!-- Populated by toc.js --}}
        <p class="toc__empty">{{t "Loading…"}}</p>
    </nav>
</div>

<script>
(function(){
    'use strict';

    function buildToc(){
        var content  = document.querySelector('.js-toc-content');
        var nav      = document.getElementById('toc-nav');
        var toggle   = document.getElementById('toc-toggle');
        var toc      = document.getElementById('toc');
        if(!content || !nav) return;

        var headings = Array.prototype.slice.call(content.querySelectorAll('h2, h3'));
        if(!headings.length){ if(toc) toc.style.display = 'none'; return; }

        /* Assign IDs */
        headings.forEach(function(h, i){
            if(!h.id) h.id = 'toc-' + i + '-' + h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').slice(0,40);
        });

        /* Build list */
        var html = '<ol class="toc__list">';
        headings.forEach(function(h){
            var isH3 = h.tagName === 'H3';
            html += '<li class="toc__item' + (isH3 ? ' toc__item--sub' : '') + '">' +
                    '<a class="toc__link" href="#' + h.id + '" data-toc-id="' + h.id + '">' +
                    h.textContent + '</a></li>';
        });
        html += '</ol>';
        nav.innerHTML = html;

        /* ScrollSpy */
        var links = nav.querySelectorAll('.toc__link');
        var observer = new IntersectionObserver(function(entries){
            entries.forEach(function(e){
                if(e.isIntersecting){
                    links.forEach(function(l){ l.classList.remove('is-active'); });
                    var active = nav.querySelector('[data-toc-id="' + e.target.id + '"]');
                    if(active) active.classList.add('is-active');
                }
            });
        },{ rootMargin:'0px 0px -65% 0px', threshold:0.1 });
        headings.forEach(function(h){ observer.observe(h); });

        /* Smooth scroll */
        links.forEach(function(l){
            l.addEventListener('click', function(e){
                e.preventDefault();
                var target = document.getElementById(l.dataset.tocId);
                if(target) window.scrollTo({ top: target.offsetTop - 80, behavior:'smooth' });
            });
        });

        /* Mobile toggle */
        if(toggle){
            toggle.addEventListener('click', function(){
                var open = nav.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', open);
                var caret = toggle.querySelector('.toc__caret');
                if(caret) caret.style.transform = open ? 'rotate(180deg)' : '';
            });
            toggle.addEventListener('keydown', function(e){
                if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle.click(); }
            });
        }
    }

    if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', buildToc);
    } else {
        buildToc();
    }
})();
</script>
