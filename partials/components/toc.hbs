{{!-- components/toc.hbs — Custom Table of Contents
     ---------------------------------------------------------------------------
     Rendered empty; toc.js scans the post's `.gh-content` headings (h2/h3),
     injects anchor links into [data-toc], and adds scroll-spy highlighting.
     - Desktop: meant to sit in a sticky sidebar column (the parent positions it).
     - Mobile: collapses behind a toggle (Alpine `open` state).
     The whole nav hides itself (via toc.js) when a post has no headings. --}}
<nav aria-label="{{t "Table of contents"}}"
     class="js-toc hidden text-sm"
     x-data="{ open: false }">

  <div class="flex items-center justify-between gap-2 lg:block">
    <p class="ns-label">{{t "On this page"}}</p>
    <button type="button" class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-btn border border-border text-muted"
            @click="open = !open" :aria-expanded="open.toString()" aria-label="{{t "Toggle contents"}}">
      {{!-- Two icons swapped by state, rather than one element whose class is
            rewritten — inline SVG carries its artwork, not a font codepoint. --}}
      <span x-show="!open">{{> icons name="list"}}</span>
      <span x-show="open" x-cloak>{{> icons name="x"}}</span>
    </button>
  </div>

  {{!-- toc.js fills this <ul>. lg:!block keeps it open on desktop regardless of state. --}}
  <ul data-toc class="mt-3 space-y-0.5 lg:!block" :class="open ? 'block' : 'hidden'"></ul>
</nav>
