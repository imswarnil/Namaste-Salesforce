{{!-- components/cta.hbs
     Newsletter / subscribe call-to-action. Uses Ghost members signup when
     enabled, otherwise links to the Portal. Reusable on listings, posts, home. --}}
<section class="mx-auto my-14 max-w-4xl px-4 sm:px-6">
  <div class="relative overflow-hidden rounded-card bg-brand-900 px-6 py-12 text-center text-white sm:px-12">

    {{!-- decorative faded grid + cloud motif --}}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 text-white">
      <div class="bg-grid absolute inset-0"></div>
      {{> icons name="cloud" class="absolute -right-4 -top-6 h-32 w-32 text-white/[0.06]"}}
    </div>

    <div class="relative">
      <h2 class="font-heading text-2xl font-extrabold sm:text-3xl">{{t "Join the Ohana"}}</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/80">{{t "New Salesforce tutorials, courses and tips — straight to your inbox. Free, no spam."}}</p>

      <div class="mx-auto mt-6 max-w-md text-left">
        {{> "members/subscribe" tone="dark" icon="mail"}}
      </div>
    </div>
  </div>
</section>
