{{!-- components/course-level.hbs — level badge (colour-coded + icon) from the
     post's #level-* tag. Reusable in the course hero, sidebar and cards.
     Renders nothing when no level tag is present. Context: the current post. --}}
{{#has tag="#level-beginner"}}<span class="ns-level ns-level--beginner"><i class="ph-fill ph-gauge" aria-hidden="true"></i>{{t "Beginner"}}</span>
{{else has tag="#level-intermediate"}}<span class="ns-level ns-level--intermediate"><i class="ph-fill ph-gauge" aria-hidden="true"></i>{{t "Intermediate"}}</span>
{{else has tag="#level-advanced"}}<span class="ns-level ns-level--advanced"><i class="ph-fill ph-gauge" aria-hidden="true"></i>{{t "Advanced"}}</span>{{/has}}
