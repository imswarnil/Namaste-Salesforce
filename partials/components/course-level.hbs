{{!-- components/course-level.hbs — level badge (colour-coded + icon) from the
     post's #level-* tag. Reusable in the course hero, sidebar and cards.
     Renders nothing when no level tag is present. Context: the current post. --}}
{{#has tag="#level-beginner"}}<span class="ns-level ns-level--beginner">{{> icons name="gauge"}}{{t "Beginner"}}</span>
{{else has tag="#level-intermediate"}}<span class="ns-level ns-level--intermediate">{{> icons name="gauge"}}{{t "Intermediate"}}</span>
{{else has tag="#level-advanced"}}<span class="ns-level ns-level--advanced">{{> icons name="gauge"}}{{t "Advanced"}}</span>{{/has}}
