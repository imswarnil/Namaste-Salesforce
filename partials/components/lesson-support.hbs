{{!-- components/lesson-support.hbs — a small "support this free content" band,
     shown on free lessons (star on GitHub · sponsor · donate). --}}
<div class="ns-support">
  <div class="ns-support__text">
    <p class="font-heading font-bold">{{t "Enjoying this free lesson?"}}</p>
    <p class="text-sm text-muted">{{t "Namaste Salesforce is open and free. A star or a small sponsorship keeps it going."}}</p>
  </div>
  <div class="ns-support__actions">
    <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="ns-btn ns-btn--outline ns-btn--sm">{{> "icons/github" class="h-4 w-4"}}{{t "Star"}}{{!-- The star is the one permitted amber mark. icons/star.hbs accepts a class
     parameter only, so the inline style that used to sit here never applied. --}}
{{> "icons/star" class="h-3.5 w-3.5 text-warning"}}</a>
    <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener" class="ns-btn ns-btn--sm ns-support__sponsor">{{> "icons/heart" class="h-4 w-4"}}{{t "Sponsor"}}</a>
  </div>
</div>
