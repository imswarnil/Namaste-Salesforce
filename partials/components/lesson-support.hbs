{{!-- components/lesson-support.hbs — a small "support this free content" band,
     shown on free lessons (star on GitHub · sponsor · donate). --}}
<div class="ns-support">
  <div class="ns-support__text">
    <p class="font-heading font-bold">{{t "Enjoying this free lesson?"}}</p>
    <p class="text-sm text-muted">{{t "Namaste Salesforce is open and free. A star or a small sponsorship keeps it going."}}</p>
  </div>
  <div class="ns-support__actions">
    <a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" class="ns-btn ns-btn--outline ns-btn--sm" onclick="if(window.posthog)window.posthog.capture('lesson support starred',{page_url:window.location.href})">{{> "icons/github" class="h-4 w-4"}}{{t "Star"}}{{> "icons/star" class="h-3.5 w-3.5" style="color:#fbbf24"}}</a>
    <a href="https://github.com/sponsors/imswarnil" target="_blank" rel="noopener" class="ns-btn ns-btn--sm ns-support__sponsor" onclick="if(window.posthog)window.posthog.capture('lesson support sponsored',{page_url:window.location.href})">{{> "icons/heart" class="h-4 w-4"}}{{t "Sponsor"}}</a>
  </div>
</div>
