{{!-- components/theme-toggle.hbs
     Dark/light toggle (borderless, compact). theme-toggle.js flips data-theme on
     <html>; the moon/sun swap is handled by the `dark:` variant. --}}
<button type="button"
        class="ns-theme-toggle icon-btn dark:hover:text-brand-300"
        aria-label="{{t "Toggle dark mode"}}" title="{{t "Toggle dark mode"}}">
  {{> icons name="moon" class="h-[1.15rem] w-[1.15rem] dark:hidden"}}
  {{> icons name="sun" class="hidden h-[1.15rem] w-[1.15rem] dark:block"}}
</button>
