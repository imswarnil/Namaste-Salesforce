{{!-- components/theme-toggle.hbs
     Dark/light toggle button. Behaviour lives in theme-toggle.js, which keys off
     the .ns-theme-toggle class and swaps the .ns-theme-icon glyph. Reusable in
     the header, footer, or anywhere. --}}
<button type="button"
        class="ns-theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink transition hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-300"
        aria-label="{{t "Toggle dark mode"}}" title="{{t "Toggle dark mode"}}">
  <i class="ph ph-moon ns-theme-icon text-lg" aria-hidden="true"></i>
</button>
