{{!-- components/social-icons.hbs — the social row.

     `ul.ns-footer__social` is the design system's row: the same 1.875rem
     hairline squares the footer uses, turned horizontal by a rule with the
     same specificity as the column rule above it (see sections.css — that is
     deliberate, not an accident, and it is why no !important is needed).

     EVERY GLYPH COMES FROM partials/icons.hbs. This file used to paste four
     full <svg> paths inline — the same artwork the icon partial already
     holds, maintained in a second place, and invisible to the styleguide's
     icon check. Nothing in this theme should carry a raw <path> except that
     one partial. --}}
<ul class="ns-footer__social">
  {{#if @site.twitter}}
    <li><a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">{{> icons name="x-logo"}}</a></li>
  {{/if}}
  {{#if @site.facebook}}
    <li><a href="{{social_url type="facebook"}}" target="_blank" rel="noopener" aria-label="Facebook">{{> icons name="facebook"}}</a></li>
  {{/if}}
  <li><a href="https://github.com/imswarnil/Namaste-Salesforce" target="_blank" rel="noopener" aria-label="GitHub">{{> icons name="github"}}</a></li>
  <li><a href="{{@site.url}}/rss/" aria-label="{{t "RSS feed"}}">{{> icons name="rss"}}</a></li>
</ul>
