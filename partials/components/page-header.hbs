{{!-- components/page-header.hbs — reusable collection/page header band
     Params: title (required), subtitle, eyebrow, icon (Phosphor class).
     The .ns-page-header COMPONENT (2-components/page-header.css) owns the
     look; add --plain / --sunken / --sm / --lg / --left there if a page needs
     a different one. Used by courses/blog/training/docs/resources. --}}
<header class="ns-page-header">
  {{> "components/hero-bg"}}
  <div class="ns-page-header__inner">
    {{#if eyebrow}}
      <p class="ns-kicker ns-kicker--light ns-kicker--center">
        {{#if icon}}<i class="ph-fill {{icon}}" aria-hidden="true"></i>{{/if}}{{eyebrow}}
      </p>
    {{/if}}
    <h1 class="ns-page-header__title">{{title}}</h1>
    {{#if subtitle}}
      <p class="ns-page-header__sub">{{subtitle}}</p>
    {{/if}}
  </div>
</header>
