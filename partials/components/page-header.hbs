{{!-- components/page-header.hbs — the band at the top of a collection page
     Params: title (required), subtitle, eyebrow, icon (Phosphor class).
     Thin wrapper over the .ns-hero COMPONENT (2-components/hero.css) at its
     small size — pass --plain / --sunken / --lg / --start / --split there if a
     page needs a different shape. Used by courses/blog/training/docs/resources. --}}
<header class="ns-hero ns-hero--sm ns-hero--grid">
  <div class="ns-hero__inner">
    {{#if eyebrow}}
      <p class="ns-kicker ns-kicker--light ns-kicker--center">
        {{#if icon}}{{> icons name=icon}}{{/if}}{{eyebrow}}
      </p>
    {{/if}}
    <h1 class="ns-hero__title">{{title}}</h1>
    {{#if subtitle}}
      <p class="ns-hero__sub">{{subtitle}}</p>
    {{/if}}
  </div>
</header>
