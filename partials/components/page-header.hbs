{{!-- components/page-header.hbs — reusable collection/page header band
     Params: title (required), subtitle, eyebrow, icon (Phosphor class).
     Brand gradient with decorative blobs; used by courses/blog/training/docs. --}}
<header class="relative overflow-hidden border-b border-border bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 text-white">
  {{> "components/hero-bg"}}
  <div class="relative mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:py-20">
    {{#if eyebrow}}
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-brand-200">
        {{#if icon}}<i class="ph-fill {{icon}}" aria-hidden="true"></i>{{/if}}{{eyebrow}}
      </p>
    {{/if}}
    <h1 class="mt-2 font-heading text-4xl font-extrabold tracking-tight sm:text-5xl">{{title}}</h1>
    {{#if subtitle}}
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">{{subtitle}}</p>
    {{/if}}
  </div>
</header>
