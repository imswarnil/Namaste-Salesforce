{{!-- components/author-card.hbs
     Vertical author card(s) — shown at bottom of blog / default posts.
     Use: {{> "components/author-card"}} inside {{#post}} context. --}}
{{#foreach authors}}
    <div class="author-card">
        <div class="author-card__head">
            {{#if profile_image}}
                <a href="{{url}}" class="author-card__avatar-link">
                    <img class="author-card__avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" loading="lazy" />
                </a>
            {{else}}
                <a href="{{url}}" class="author-card__avatar-link author-card__avatar--placeholder">
                    {{> "icons/avatar"}}
                </a>
            {{/if}}
            <div class="author-card__info">
                <h3 class="author-card__name">
                    <a href="{{url}}">{{name}}</a>
                </h3>
                {{#if location}}
                    <p class="author-card__location">
                        <i class="ph ph-map-pin" aria-hidden="true"></i>
                        {{location}}
                    </p>
                {{/if}}
                {{!-- Social links --}}
                <div class="author-card__socials">
                    {{#if website}}
                        <a href="{{website}}" class="author-card__social-link" target="_blank" rel="noopener" aria-label="Website">
                            <i class="ph ph-globe" aria-hidden="true"></i>
                        </a>
                    {{/if}}
                    {{#if twitter}}
                        <a href="{{social_url type="twitter"}}" class="author-card__social-link" target="_blank" rel="noopener" aria-label="Twitter / X">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                    {{/if}}
                    {{#if linkedin}}
                        <a href="{{social_url type="linkedin"}}" class="author-card__social-link" target="_blank" rel="noopener" aria-label="LinkedIn">
                            <i class="ph ph-linkedin-logo" aria-hidden="true"></i>
                        </a>
                    {{/if}}
                    {{#if github}}
                        <a href="{{social_url type="github"}}" class="author-card__social-link" target="_blank" rel="noopener" aria-label="GitHub">
                            <i class="ph ph-github-logo" aria-hidden="true"></i>
                        </a>
                    {{/if}}
                </div>
            </div>
        </div>
        {{#if bio}}
            <p class="author-card__bio">{{bio}}</p>
        {{/if}}
        <a class="author-card__link" href="{{url}}">
            {{t "View all posts"}}
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
{{/foreach}}
