{{!-- components/breadcrumb.hbs — Home / [primary tag] / current title.
     Context: a post or page. Always shown (consistent across the theme) and
     emits BreadcrumbList JSON-LD for SEO.
     NOTE: the JSON-LD stays in the POST context (dotted primary_tag.* access);
     never call a helper across `../` — Ghost throws on that and 500s the page. --}}
{{!-- Single line — never wraps; the current title truncates instead. Small
     icons per crumb (home / tag / page). --}}
<nav class="mb-4 flex min-w-0 items-center gap-1.5 whitespace-nowrap text-xs text-muted sm:text-sm" aria-label="{{t "Breadcrumb"}}">
  <a href="{{@site.url}}" class="inline-flex shrink-0 items-center gap-1 transition-colors hover:text-brand-600"><i class="ph ph-house" aria-hidden="true"></i><span class="hidden sm:inline">{{t "Home"}}</span></a>
  {{#primary_tag}}
    <i class="ph ph-caret-right shrink-0 text-[0.6rem]" aria-hidden="true"></i>
    <a href="{{url}}" class="inline-flex shrink-0 items-center gap-1 transition-colors hover:text-brand-600"><i class="ph ph-tag" aria-hidden="true"></i>{{name}}</a>
  {{/primary_tag}}
  <i class="ph ph-caret-right shrink-0 text-[0.6rem]" aria-hidden="true"></i>
  <span class="inline-flex min-w-0 items-center gap-1 text-ink"><i class="ph ph-file-text shrink-0" aria-hidden="true"></i><span class="truncate">{{title}}</span></span>
</nav>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"{{@site.url}}/"},
{{#if primary_tag}}{"@type":"ListItem","position":2,"name":"{{primary_tag.name}}","item":"{{@site.url}}{{primary_tag.url}}"},
{"@type":"ListItem","position":3,"name":"{{title}}","item":"{{url absolute="true"}}"}
{{else}}{"@type":"ListItem","position":2,"name":"{{title}}","item":"{{url absolute="true"}}"}
{{/if}}
]}
</script>
