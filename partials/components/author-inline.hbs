{{!-- components/author-inline.hbs
     Horizontal byline: avatars + name(s) + date + reading time.
     Use: {{> "components/author-inline"}} inside {{#post}} context. --}}
<div class="author-inline">
    <div class="author-inline__avatars">
        {{#foreach authors limit="3"}}
            {{#if profile_image}}
                <a href="{{url}}" class="author-inline__avatar-link" aria-label="{{name}}">
                    <img class="author-inline__avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy" />
                </a>
            {{else}}
                <a href="{{url}}" class="author-inline__avatar-link author-inline__avatar--placeholder" aria-label="{{name}}">
                    {{> "icons/avatar"}}
                </a>
            {{/if}}
        {{/foreach}}
    </div>
    <div class="author-inline__meta">
        <span class="author-inline__names">{{authors separator=", " limit="2"}}</span>
        <div class="author-inline__secondary">
            <time class="author-inline__date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMM YYYY"}}
            </time>
            {{#if reading_time}}
                <span class="author-inline__sep" aria-hidden="true">·</span>
                <span class="author-inline__time">
                    {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
                </span>
            {{/if}}
        </div>
    </div>
</div>
