{{!-- components/author-byline.hbs
     Author avatar + name + publish date + reading time.
     Context: a post (use inside {{#post}} / {{#foreach posts}}). --}}
<div class="flex flex-wrap items-center gap-3 text-sm text-muted">
  {{#primary_author}}
    <a href="{{url}}" class="flex items-center gap-2 font-medium text-ink transition-colors hover:text-brand-600 dark:hover:text-brand-300">
      {{#if profile_image}}
        <img src="{{img_url profile_image size='xs'}}" alt="{{name}}" class="h-8 w-8 rounded-full object-cover">
      {{else}}
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
          <i class="ph ph-user" aria-hidden="true"></i>
        </span>
      {{/if}}
      <span>{{name}}</span>
    </a>
  {{/primary_author}}
  <span aria-hidden="true">·</span>
  <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
  {{#if reading_time}}
    <span aria-hidden="true">·</span>
    <span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
  {{/if}}
</div>
