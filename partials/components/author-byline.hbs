{{!-- components/author-byline.hbs — author · date · reading time.

     The design system's `.ns-postmeta` (ds/components/css/blog.css): the same
     line on a card, in a post header and in a footer, so a reader learns to
     read it once. Mono and uppercase, because it is data ABOUT the text
     rather than part of it.

     `--dotted` draws the separators with a ::before rather than as characters
     in the DOM — middots typed between spans get announced one at a time by
     a screen reader.

     Context: a post (use inside {{#post}} / {{#foreach posts}}). --}}
<div class="ns-postmeta ns-postmeta--dotted">
  {{#primary_author}}
    <a href="{{url}}" class="ns-postmeta__author">
      {{#if profile_image}}<img class="ns-postmeta__avatar" loading="lazy" decoding="async" src="{{img_url profile_image size='xs'}}" alt="">{{/if}}
      <span>{{name}}</span>
    </a>
  {{/primary_author}}
  <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
  {{#if reading_time}}
    <span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
  {{/if}}
</div>
