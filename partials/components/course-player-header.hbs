{{!-- ════════════════════════════════════════════════════════════════════════
  components/course-player-header.hbs — the reading chrome.

  Swapped in by default.hbs for #lesson / #training / #training-content /
  #training-section posts, in place of the marketing bar. THE DESIGN SYSTEM'S
  `.ns-coursenav` (ds/components/css/navbar.css) — a bar built for exactly
  this: leave, where-you-are, how-far, and nothing else.

  WHAT IT DELIBERATELY DOES NOT CARRY, per the system's own reasoning:

    · No primary action. "Complete & next" belongs to the docked prev/next at
      the foot of the lesson; a second solid button up here would compete for
      the one click a screen is allowed.
    · No curriculum toggle. A control for a panel belongs in that panel's own
      head — courses/lesson-nav owns it. Below lg, where there is no rail, the
      drawer is reached from there too.
    · No nav menu. This is a reading surface; the way out is the back link,
      and it SAYS where it goes rather than being a bare chevron, because a
      bare chevron is how people reach for the browser back button and lose
      their place.

  This replaced a hand-rolled `.ns-nav` bar whose CSS lived in the theme's
  site-navbar.css. That file is gone — the system owns the chrome now.
═══════════════════════════════════════════════════════════════════════════ --}}

<a href="#main" class="ns-skiplink">{{t "Skip to content"}}</a>

<nav class="ns-coursenav" aria-label="{{t "Course"}}">

  {{!-- Leaving is ONE control, at the start, and it names its destination.
       The parent is the course/track this lesson belongs to; falling back to
       the catalog is better than a dead control on an orphaned lesson. --}}
  {{#has tag="#lesson"}}
    {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}{{#foreach posts}}
      <a class="ns-coursenav__back" href="{{url}}">{{> icons name="arrow-left"}}<span>{{title}}</span></a>
    {{else}}
      <a class="ns-coursenav__back" href="/courses/">{{> icons name="arrow-left"}}<span>{{t "Courses"}}</span></a>
    {{/foreach}}{{/get}}
  {{else}}
    {{#get "posts" filter="tag:hash-training+primary_tag:{{primary_tag.slug}}" limit="1"}}{{#foreach posts}}
      <a class="ns-coursenav__back" href="{{url}}">{{> icons name="arrow-left"}}<span>{{title}}</span></a>
    {{else}}
      <a class="ns-coursenav__back" href="/training/">{{> icons name="arrow-left"}}<span>{{t "Training"}}</span></a>
    {{/foreach}}{{/get}}
  {{/has}}

  <span class="ns-topnav__divider" aria-hidden="true"></span>

  {{!-- The lesson, and only the lesson. With the back link and the divider to
       its left the bar reads "Salesforce Admin | Objects and fields". --}}
  <span class="ns-coursenav__id">
    <span class="ns-coursenav__title">{{title}}</span>
  </span>

  {{!-- Position in the course. Two readings of one number — the bar for
       "roughly where", the fraction for "exactly" — computed in Handlebars
       rather than by a script, so it is correct in the first paint and does
       not need JavaScript to be true. --}}
  {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson,primary_tag:{{primary_tag.slug}}+tag:hash-training-content" order="published_at asc" limit="100" as |siblings|}}
    {{#if siblings}}
      <div class="ns-coursenav__progress">
        <div class="ns-coursenav__bar" role="progressbar" aria-label="{{t "Course progress"}}"
             aria-valuemin="0" aria-valuemax="{{siblings.length}}"><span></span></div>
        <span class="ns-coursenav__pct">{{siblings.length}} {{t "lessons"}}</span>
      </div>
    {{/if}}
  {{/get}}

  <div class="ns-coursenav__actions">
    {{#if @custom.navbar_show_search}}
      <a class="ns-navicon" href="#/search" data-ghost-search aria-label="{{t "Search"}}">{{> icons name="search"}}</a>
    {{/if}}

    <button type="button" class="ns-themeswitch" role="switch" aria-checked="false"
            aria-label="{{t "Dark mode"}}" data-ns-theme-toggle>
      <span class="ns-themeswitch__mark" aria-hidden="true"></span>
    </button>

    {{#if @site.members_enabled}}
      {{#if @member}}
        <a class="ns-navicon" href="#/portal/account" data-portal="account" aria-label="{{t "Account"}}">
          {{#if @member.avatar_image}}
            <span class="ns-avatar ns-avatar--sm"><img src="{{img_url @member.avatar_image size="xs"}}" alt="" loading="lazy" decoding="async"></span>
          {{else}}{{> icons name="user"}}{{/if}}
        </a>
      {{else}}
        <a class="ns-btn ns-btn--quiet ns-btn--sm" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
      {{/if}}
    {{/if}}
  </div>
</nav>
