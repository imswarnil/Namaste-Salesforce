{{!-- components/hero-bg.hbs — shared decorative background for dark gradient
     heroes: soft brand/violet blobs, a faded grid, and a subtle Salesforce
     cloud motif in the corners. Decorative only (aria-hidden). The parent must
     be `relative overflow-hidden`. --}}
<div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden text-white">
  <div class="absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-400/30 blur-3xl"></div>
  <div class="absolute -right-10 top-8 h-80 w-80 rounded-full bg-violet-500/20 blur-3xl"></div>
  <div class="bg-grid absolute inset-0"></div>
  {{> icons name="cloud" class="absolute -right-6 -top-8 h-44 w-44 text-white/[0.05] rotate-6"}}
  {{> icons name="cloud" class="absolute -left-8 bottom-2 h-28 w-28 text-white/[0.05] -rotate-6"}}
</div>
