{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-course.hbs — the single #course page.

  Built on the design system's CATALOG layer (assets/css/ds/components/css/
  catalog.css) — the half of a course page a BUYER sees. The learner-facing
  half (curriculum rows, lesson chrome) is the LMS layer and is rendered by
  courses/curriculum-list.

  The page in order, and the order is the argument:
    1. Breadcrumb   where this sits in the catalog        .ns-breadcrumb
    2. Hero         what it is, and whether it is good    .ns-chero
    3. Stat band    the numbers, before prose asks trust  .ns-statband
    4. Body         description → curriculum → share
    5. Buy box      the enrol card, sticky rail + phone bar   .ns-buybox

  ART DIRECTION is one internal tag — see courses/hero-variant.hbs for the
  full contract and the numeric aliases kept for already-published courses.
  Everything else comes from internal tags too: #level-*, #duration-*,
  #free/#paid, #preview, #hide-image.

  ⚠️ NEVER call a Ghost helper across `../` in here (`{{../url}}`) — Ghost
  throws and 500s the page. Use dotted access (`{{primary_tag.url}}`).
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── BREADCRUMB ───────────────────────────────────────────────────────── --}}
<nav class="ns-container" aria-label="Breadcrumb">
  <ol class="ns-breadcrumb" style="padding-block-start:var(--space-4)">
    <li class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="{{@site.url}}">{{t "Home"}}</a></li>
    <li class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="/courses/">{{t "Courses"}}</a></li>
    <li class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="{{url}}" aria-current="page">{{title}}</a></li>
  </ol>
</nav>

{{!-- ── HERO ─────────────────────────────────────────────────────────────── --}}
<section class="ns-chero {{> "courses/hero-variant"}}">

  {{!-- The background layer belongs to --cover and --video only. The scrim is
       part of the component, not a choice: type over an arbitrary editor-
       chosen photograph has no contrast guarantee. --}}
  {{#has tag="#hero-cover, #hero-video, #hero-3, #hero-5"}}
    {{#if feature_image}}
      <div class="ns-chero__bg" aria-hidden="true">
        {{> "components/img" src=feature_image alt="" eager=true sizes="100vw"}}
      </div>
    {{/if}}
  {{/has}}

  <div class="ns-chero__inner">
    <div class="ns-chero__grid">
      <div class="ns-chero__body">

        {{#if featured}}
          <div class="ns-chero__badges">
            <span class="ns-tag ns-tag--pill">{{> icons name="star"}}{{t "Featured"}}</span>
          </div>
        {{/if}}

        <span class="ns-chero__kicker">// {{t "Course"}}{{#primary_tag}} · {{name}}{{/primary_tag}}</span>
        <h1 class="ns-chero__title">{{title}}</h1>
        <p class="ns-chero__lede">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="30"}}{{/if}}</p>

        {{!-- The meta strip: mono, tabular, wrapping rather than truncating —
             every item in it is a reason to enrol. --}}
        <div class="ns-chero__meta">
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |lessons|}}
            <span>{{> icons name="list-checks"}}{{lessons.length}} {{t "lessons"}}</span>
          {{/get}}
          {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<span>{{> icons name="clock"}}{{description}}</span>{{/match}}{{/foreach}}
          <span>{{> icons name="gauge"}}{{#has tag="#level-beginner"}}{{t "Beginner"}}{{else has tag="#level-intermediate"}}{{t "Intermediate"}}{{else has tag="#level-advanced"}}{{t "Advanced"}}{{else}}{{t "All levels"}}{{/has}}</span>
          <span>{{> icons name="seal-check"}}{{t "Self-paced"}}</span>
          {{#has tag="#free"}}<span>{{> icons name="gift"}}{{t "Free"}}</span>{{else has tag="#paid"}}<span>{{> icons name="crown"}}{{t "Members"}}</span>{{/has}}
          <span>{{> icons name="calendar"}}{{t "Updated"}} {{date updated_at format="MMM YYYY"}}</span>
        </div>

        <div class="ns-chero__actions">
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}{{#foreach posts}}
            <a href="{{url}}" class="ns-btn ns-btn--primary ns-btn--lg">{{> icons name="play"}}{{t "Start course"}}</a>
          {{else}}
            <a href="#curriculum" class="ns-btn ns-btn--primary ns-btn--lg">{{t "View curriculum"}}</a>
          {{/foreach}}{{/get}}
          <a href="#curriculum" class="ns-btn ns-btn--soft ns-btn--lg">{{t "See curriculum"}}</a>
        </div>

        {{!-- Instructors — the system's .ns-authors, one shape for one or many --}}
        <div class="ns-authors" style="margin-block-start:var(--space-5)">
          <span class="ns-authors__stack" aria-hidden="true">
            {{#foreach authors limit="3"}}{{#if profile_image}}<img class="ns-authors__avatar" loading="lazy" decoding="async" src="{{img_url profile_image size="xxs"}}" alt="">{{/if}}{{/foreach}}
          </span>
          <span class="ns-authors__names">{{t "Taught by"}} {{#foreach authors}}<b>{{name}}</b>{{#unless @last}}, {{/unless}}{{/foreach}}</span>
        </div>
      </div>

      {{!-- The media card belongs to the variants that HAVE one. --cover and
           --video put their art in the background layer above; --minimal has
           none by definition. --}}
      {{#has tag="#hero-cover, #hero-video, #hero-3, #hero-5, #hero-minimal, #hero-2, #hero-4, #hide-image"}}{{else}}
        {{#if feature_image}}
          <div class="ns-chero__media">
            {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson+tag:hash-lesson-type-video" order="published_at asc" limit="1" as |vids|}}
              {{#if vids.[0]}}
                {{> "components/img" src=feature_image alt="" eager=true sizes="24rem"}}
                <a href="{{vids.[0].url}}" class="ns-chero__play" aria-label="{{t "Play the course preview"}}">{{> icons name="play"}}</a>
                <span class="ns-chero__caption">{{t "Preview"}}</span>
              {{else}}
                {{> "components/img" src=feature_image alt="" eager=true sizes="24rem"}}
              {{/if}}
            {{/get}}
          </div>
        {{/if}}
      {{/has}}
    </div>
  </div>
</section>

{{!-- ── STAT BAND — concrete numbers, before any prose asks for trust ────── --}}
<section class="ns-band ns-band--tight ns-band--sunken">
  <div class="ns-band__inner">
    <dl class="ns-statband">
      {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |lessons|}}
        <div class="ns-statband__cell"><dd class="ns-statband__value">{{lessons.length}}</dd><dt class="ns-statband__label">{{t "Lessons"}}</dt></div>
      {{/get}}
      {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson+tag:hash-lesson-type-video" limit="100" as |vids|}}
        <div class="ns-statband__cell"><dd class="ns-statband__value">{{vids.length}}</dd><dt class="ns-statband__label">{{t "Video lessons"}}</dt></div>
      {{/get}}
      {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<div class="ns-statband__cell"><dd class="ns-statband__value">{{description}}</dd><dt class="ns-statband__label">{{t "Duration"}}</dt></div>{{/match}}{{/foreach}}
      <div class="ns-statband__cell"><dd class="ns-statband__value">∞</dd><dt class="ns-statband__label">{{t "Lifetime access"}}</dt></div>
    </dl>
  </div>
</section>

{{!-- ── BODY + BUY BOX ───────────────────────────────────────────────────── --}}
<section class="ns-container ns-section">
  <div class="ns-course-detail">

    <div class="ns-course-detail__main">

      {{#if html}}
        <div class="ns-section-head"><h2 class="ns-section-head__title">{{t "About this course"}}</h2></div>
        {{!-- Ghost content = the description. Toggle cards render as FAQ
             accordions, product cards as testimonials (site-course.css). --}}
        <div class="ns-course-content ns-prose gh-content">{{content}}</div>
      {{/if}}

      {{> "ads/leaderboard"}}

      <div class="ns-course-detail__curriculum" id="curriculum">
        <div class="ns-section-head">
          <h2 class="ns-section-head__title">{{t "Course curriculum"}}</h2>
          {{#has tag="#paid"}}<span class="ns-badge">{{> icons name="crown"}}{{t "Members course"}}</span>{{/has}}
        </div>

        {{!-- Lock notice for paid / members-only courses --}}
        {{#has tag="#paid"}}
          <div class="ns-note ns-note--warning">
            {{> icons name="lock"}}
            <div>
              <p class="font-bold">{{t "This is a members course"}}</p>
              <p class="text-sm">{{t "Preview lessons are open to everyone. Sign in with a membership to unlock the full curriculum."}}</p>
            </div>
            <a href="#/portal/signup" data-portal="signup" class="ns-btn ns-btn--primary ns-btn--sm shrink-0">{{t "Unlock"}}</a>
          </div>
        {{/has}}

        {{> "courses/curriculum-list"}}
      </div>

      <div class="mt-10">{{> "components/share"}}</div>
    </div>

    {{!-- The enrol card. Sticky beside the content on desktop; the same
         component becomes a fixed bottom bar on a phone, below. --}}
    <aside class="ns-course-detail__rail">
      <div class="ns-buybox js-spotlight">
        {{#has tag="#hide-image"}}{{else}}{{#if feature_image}}
          {{> "components/img" src=feature_image alt="" class="ns-buybox__media" sizes="20rem"}}
        {{/if}}{{/has}}
        <div class="ns-buybox__body">
          <span class="ns-price{{#has tag="#free"}} ns-price--free{{/has}}">
            {{#has tag="#free"}}<span class="ns-price__now">{{t "Free"}}</span>{{else has tag="#paid"}}<span class="ns-price__now">{{t "Members"}}</span>{{else}}<span class="ns-price__now">{{t "Free"}}</span>{{/has}}
          </span>

          <div class="ns-buybox__actions">
            {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}{{#foreach posts}}
              <a href="{{url}}" class="ns-btn ns-btn--primary">{{> icons name="play"}}{{t "Start course"}}</a>
            {{else}}
              <a href="#curriculum" class="ns-btn ns-btn--primary">{{t "View curriculum"}}</a>
            {{/foreach}}{{/get}}
            <a href="/courses/" class="ns-btn ns-btn--outline ns-btn--sm">{{t "Back to catalog"}}</a>
          </div>

          <ul class="ns-buybox__list">
            {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |ls|}}
              <li>{{> icons name="list-checks"}}{{ls.length}} {{t "lessons"}}</li>
            {{/get}}
            {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<li>{{> icons name="clock"}}{{description}} {{t "of content"}}</li>{{/match}}{{/foreach}}
            <li>{{> icons name="gauge"}}{{#has tag="#level-beginner"}}{{t "Beginner"}}{{else has tag="#level-intermediate"}}{{t "Intermediate"}}{{else has tag="#level-advanced"}}{{t "Advanced"}}{{else}}{{t "All levels"}}{{/has}}</li>
            <li>{{> icons name="infinity"}}{{t "Lifetime access"}}</li>
          </ul>
        </div>
        <div class="ns-buybox__foot">{{t "Updated"}} {{date updated_at format="MMM YYYY"}}</div>
      </div>

      <div class="mt-6">{{> "ads/slot" format="square"}}</div>
    </aside>
  </div>
</section>

{{!-- ── The same buy box as a phone bar — the one action the page exists for
     must never be scrolled past. Hidden ≥64rem by the component itself. ─── --}}
<div class="ns-buybox ns-buybox--bar">
  <span class="ns-price ns-price--sm{{#has tag="#free"}} ns-price--free{{/has}}">
    <span class="ns-price__now">{{#has tag="#paid"}}{{t "Members"}}{{else}}{{t "Free"}}{{/has}}</span>
  </span>
  {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}{{#foreach posts}}
    <a href="{{url}}" class="ns-btn ns-btn--primary ns-btn--sm">{{t "Start"}}{{> icons name="arrow-right"}}</a>
  {{else}}
    <a href="#curriculum" class="ns-btn ns-btn--primary ns-btn--sm">{{t "Start"}}{{> icons name="arrow-right"}}</a>
  {{/foreach}}{{/get}}
</div>
