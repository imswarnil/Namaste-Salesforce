{{!-- post-course.hbs — Course landing page --}}

{{!-- ── Hero ───────────────────────────────────────────── --}}
<section class="course-hero outer">
    <div class="inner">
        <div class="course-hero__grid">

            {{!-- Left --}}
            <div class="course-hero__content">
                <nav class="course-breadcrumb" aria-label="{{t "Breadcrumb"}}">
                    <a href="/">{{t "Home"}}</a>
                    <i class="ph ph-caret-right" aria-hidden="true"></i>
                    <a href="/courses/">{{t "Courses"}}</a>
                    {{#if primary_tag}}
                        <i class="ph ph-caret-right" aria-hidden="true"></i>
                        <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                    {{/if}}
                    <i class="ph ph-caret-right" aria-hidden="true"></i>
                    <span aria-current="page">{{title}}</span>
                </nav>

                <div class="sfdc-flex sfdc-gap-sm sfdc-flex-wrap sfdc-mb-lg">
                    {{#primary_tag}}<a href="{{url}}" class="article-tag-link">{{name}}</a>{{/primary_tag}}
                    {{#if featured}}<span class="article-featured-badge">{{t "Featured"}}</span>{{/if}}
                    {{#foreach tags visibility="internal"}}
                        {{#match slug "~^" "hash-course-level-"}}{{#if description}}
                            <span class="course-hero__meta-chip"><i class="ph ph-signal-high" aria-hidden="true"></i>{{description}}</span>
                        {{/if}}{{/match}}
                        {{#match slug "~^" "hash-course-duration-"}}{{#if description}}
                            <span class="course-hero__meta-chip"><i class="ph ph-clock" aria-hidden="true"></i>{{description}}</span>
                        {{/if}}{{/match}}
                    {{/foreach}}
                </div>

                <h1 class="course-hero__title">{{title}}</h1>
                <p class="course-hero__excerpt lead">
                    {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="28"}}{{/if}}
                </p>

                <div class="sfdc-flex sfdc-gap-md sfdc-items-center sfdc-mb-2xl sfdc-mt-xl">
                    <time class="sfdc-text-weak sfdc-text-sm" datetime="{{date updated_at format="YYYY-MM-DD"}}">
                        <i class="ph ph-calendar" aria-hidden="true"></i>
                        {{t "Updated"}} {{date updated_at format="MMM YYYY"}}
                    </time>
                    <span class="sfdc-text-weak sfdc-text-sm">
                        <i class="ph ph-list-checks" aria-hidden="true"></i>
                        <span id="course-lesson-count">{{t "Structured course"}}</span>
                    </span>
                </div>

                {{#primary_author}}
                    <div class="sfdc-flex sfdc-gap-md sfdc-items-center">
                        {{#if profile_image}}
                            <img class="course-hero__author-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy" />
                        {{/if}}
                        <div>
                            <p class="sfdc-text-sm sfdc-text-weak" style="margin:0">{{t "Instructor"}}</p>
                            <strong>{{name}}</strong>
                        </div>
                    </div>
                {{/primary_author}}
            </div>

            {{!-- Right: sticky sidebar card (desktop) --}}
            <div class="course-hero__card-wrap">
                <div class="course-sidebar-card" id="course-sidebar-card">
                    {{#if feature_image}}
                        <div class="course-sidebar-card__image-wrap">
                            <img src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="lazy" />
                        </div>
                    {{/if}}
                    <div class="course-sidebar-card__body">
                        <div class="sfdc-flex sfdc-items-center sfdc-gap-sm sfdc-mb-lg">
                            <span class="course-sidebar-card__price">{{t "Free"}}</span>
                            <span class="sfdc-text-sm sfdc-text-weak">{{t "Placeholder — update with membership info"}}</span>
                        </div>
                        <a href="#course-curriculum" class="btn btn-primary btn-block btn-lg sfdc-mb-sm">
                            <i class="ph ph-rocket-launch btn-icon" aria-hidden="true"></i>
                            {{t "Start Course"}}
                        </a>
                        <a href="/courses/" class="btn btn-neutral btn-block sfdc-mb-xl">{{t "Back to Courses"}}</a>

                        <h4 class="sfdc-text-sm sfdc-font-semibold sfdc-mb-md">{{t "This course includes:"}}</h4>
                        <ul class="course-sidebar-card__includes">
                            <li><i class="ph ph-list-checks" aria-hidden="true"></i>{{t "Structured curriculum"}}</li>
                            {{#foreach tags visibility="internal"}}
                                {{#match slug "~^" "hash-course-duration-"}}{{#if description}}
                                    <li><i class="ph ph-clock" aria-hidden="true"></i>{{description}}</li>
                                {{/if}}{{/match}}
                                {{#match slug "~^" "hash-course-level-"}}{{#if description}}
                                    <li><i class="ph ph-signal-high" aria-hidden="true"></i>{{description}}</li>
                                {{/if}}{{/match}}
                            {{/foreach}}
                            <li><i class="ph ph-infinity" aria-hidden="true"></i>{{t "Lifetime access"}}</li>
                            <li><i class="ph ph-calendar" aria-hidden="true"></i>{{t "Updated"}} {{date updated_at format="DD MMM YYYY"}}</li>
                        </ul>
                        <div class="sfdc-flex sfdc-gap-xl sfdc-mt-lg" style="border-top:1px solid var(--sfdc-border-color-divider);padding-top:var(--sfdc-spacing-lg)">
                            <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" target="_blank" rel="noopener" class="sfdc-flex sfdc-gap-xs sfdc-items-center sfdc-text-sm sfdc-text-secondary">
                                <i class="ph ph-share-network" aria-hidden="true"></i>{{t "Share"}}
                            </a>
                            <a href="/contact/" class="sfdc-flex sfdc-gap-xs sfdc-items-center sfdc-text-sm sfdc-text-secondary">
                                <i class="ph ph-envelope" aria-hidden="true"></i>{{t "Contact"}}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{{!-- ── Main content grid ────────────────────────────── --}}
<div class="outer"><div class="inner">
<div class="course-main-grid">

    {{!-- Left/main content column --}}
    <main class="course-main-col">

        {{!-- What you'll learn --}}
        <div class="course-section">
            <h2 class="course-section__title">{{t "What you'll learn"}}</h2>
            <div class="course-learn-grid">
                {{!-- Placeholders — override via post code injection or content --}}
                <div class="course-learn-item"><i class="ph ph-check" aria-hidden="true"></i><span>{{t "Full workflow understanding end-to-end"}}</span></div>
                <div class="course-learn-item"><i class="ph ph-check" aria-hidden="true"></i><span>{{t "Build dashboards with clean UX and performance"}}</span></div>
                <div class="course-learn-item"><i class="ph ph-check" aria-hidden="true"></i><span>{{t "Reusable data patterns you can apply anywhere"}}</span></div>
                <div class="course-learn-item"><i class="ph ph-check" aria-hidden="true"></i><span>{{t "Deployment and maintenance best practices"}}</span></div>
            </div>
        </div>

        {{!-- About the course --}}
        <div class="course-section">
            <h2 class="course-section__title">{{t "About this course"}}</h2>
            <div class="gh-content">{{content}}</div>
        </div>

        {{!-- Curriculum --}}
        <div class="course-section" id="course-curriculum">
            <div class="sfdc-flex sfdc-justify-between sfdc-items-center sfdc-mb-xl">
                <h2 class="course-section__title" style="margin:0">{{t "Course Curriculum"}}</h2>
                <span class="sfdc-text-sm sfdc-text-secondary">{{t "Structured learning path"}}</span>
            </div>
            {{#if primary_tag}}
                {{#get "posts"
                    filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson"
                    order="published_at asc"
                    limit="100"
                    as |lessons|
                }}
                    <span hidden id="course-lesson-total" data-count="{{lessons.length}}"></span>
                    {{#if lessons}}
                        <div class="course-curriculum">
                            {{#foreach lessons}}
                                <a href="{{url}}" class="course-curriculum-item">
                                    <span class="course-curriculum-item__num">{{@number}}</span>
                                    <span class="course-curriculum-item__title">{{title}}</span>
                                    {{#foreach tags visibility="internal"}}
                                        {{#match slug "~^" "hash-lesson-duration-"}}{{#if description}}
                                            <span class="course-curriculum-item__dur sfdc-text-weak sfdc-text-xs">{{description}}</span>
                                        {{/if}}{{/match}}
                                    {{/foreach}}
                                    <i class="ph ph-arrow-right course-curriculum-item__arrow" aria-hidden="true"></i>
                                </a>
                            {{/foreach}}
                        </div>
                    {{else}}
                        <p class="sfdc-text-weak">{{t "No lessons yet — tag posts with #lesson and set primary tag to this course's slug."}}</p>
                    {{/if}}
                {{/get}}
            {{/if}}
        </div>

        {{!-- Prerequisites + Downloads --}}
        <div class="sfdc-grid" style="grid-template-columns:1fr 1fr;gap:var(--sfdc-spacing-xl)">
            <div class="course-section">
                <h3 class="course-section__title" style="font-size:var(--sfdc-font-size-h5)">{{t "Prerequisites"}}</h3>
                <ul style="padding-left:1.4em;color:var(--sfdc-text-color-secondary);font-size:var(--sfdc-font-size-base)">
                    <li>{{t "Basic Salesforce navigation"}}</li>
                    <li>{{t "Comfort with data concepts"}}</li>
                    <li>{{t "Optional: basic SQL mindset"}}</li>
                </ul>
            </div>
            <div class="course-section">
                <h3 class="course-section__title" style="font-size:var(--sfdc-font-size-h5)">{{t "Downloads"}}</h3>
                <p class="sfdc-text-secondary sfdc-text-sm sfdc-mb-md">{{t "Cheatsheets, templates, and sample datasets."}}</p>
                <a href="#" class="btn btn-neutral btn-block btn-sm">
                    <i class="ph ph-download btn-icon" aria-hidden="true"></i>{{t "Download bundle"}}
                </a>
            </div>
        </div>

        {{!-- FAQ --}}
        <div class="course-section">
            <h2 class="course-section__title">{{t "FAQ"}}</h2>
            <div class="course-faq">
                <details class="course-faq__item">
                    <summary>{{t "Is this course beginner friendly?"}}</summary>
                    <p>{{t "Yes — each lesson starts from first principles before building to advanced topics."}}</p>
                </details>
                <details class="course-faq__item">
                    <summary>{{t "Do I get lifetime access?"}}</summary>
                    <p>{{t "All content is available as long as Namaste Salesforce is live — and it will be."}}</p>
                </details>
                <details class="course-faq__item">
                    <summary>{{t "Will this help for interviews?"}}</summary>
                    <p>{{t "The practical, implementation-first approach is exactly what interviewers test."}}</p>
                </details>
            </div>
        </div>

    </main>

    {{!-- Right placeholder column (mirrors sidebar card on scroll) --}}
    <div class="course-sidebar-spacer" aria-hidden="true"></div>

</div>
</div></div>

{{!-- Sticky footer CTA --}}
<div class="course-sticky-bar" id="course-sticky-bar" aria-label="{{t "Course CTA bar"}}">
    <span class="course-sticky-bar__title">{{title}}</span>
    <a href="#course-curriculum" class="btn btn-primary btn-sm btn-pill">
        {{t "Start Course"}} <i class="ph ph-arrow-right btn-icon" aria-hidden="true"></i>
    </a>
</div>

<script>
(function(){
    var countEl = document.getElementById('course-lesson-total');
    var heroCount = document.getElementById('course-lesson-count');
    if(countEl && heroCount){
        var n = parseInt(countEl.getAttribute('data-count'), 10) || 0;
        heroCount.textContent = n + ' {{t "lessons"}}';
    }
    /* Show sticky bar after scrolling past sidebar card */
    var card = document.getElementById('course-sidebar-card');
    var bar  = document.getElementById('course-sticky-bar');
    if(card && bar && 'IntersectionObserver' in window){
        new IntersectionObserver(function(entries){
            bar.classList.toggle('is-visible', !entries[0].isIntersecting);
        }).observe(card);
    }
})();
</script>
