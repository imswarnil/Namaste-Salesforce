{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-course.hbs — the single #course page.

  Rebuilt against the design system's own `templates/course-detail.html`, in
  its order, because the order IS the argument:

    1. Breadcrumb   where this sits                        .ns-breadcrumb
    2. Hero         what it is, and whether it is good     .ns-chero
    3. Stat band    the numbers, before prose asks trust   .ns-statband
    4. OUTCOMES     what you will be able to DO            .ns-outcomes--cards
    5. TABS         overview · curriculum · instructor     .ns-tabs
    6. Enrol card   sticky rail + phone bar                .ns-buybox

  WHY OUTCOMES SIT ABOVE THE TABS and not inside one: "what will I be able to
  do" is the question every visitor arrives with, and the answer decides
  whether they read anything else. It is never behind a tab they have to pick.

  WHY TABS. A course page carries several separate arguments, and stacked they
  make a page nobody reaches the bottom of — with the curriculum, the thing
  people came to read, buried three screens down. As tabs, every argument is
  one click from the price. Progressive: with JS off every panel is visible,
  so the stacked page is the fallback rather than the default
  (assets/js/ds/tabs.js hides the inactive panels on init).

  WHAT THE SYSTEM'S TEMPLATE HAS THAT THIS DOES NOT, and why — the difference
  is a DATA difference, not an oversight:

    Reviews / .ns-rating    Ghost has no review model. Stars would have to be
                            invented, so the tab is absent rather than faked.
    .ns-price__was/__off    a course post has no "was" price. Discounts are
                            not invented here either.
    sectioned curriculum    a Ghost course's lessons are flat under one primary
                            tag; only TRAINING has sections. --flat is the
                            honest shape for this data, not a lesser one.

  EVERYTHING ELSE COMES FROM GHOST, most of it from internal tags, following
  the convention this theme already uses for #duration-* — the tag's
  DESCRIPTION field carries the text, so an author writes it in Ghost Admin
  without touching the theme:

    #hero-*        art direction          (courses/hero-variant.hbs)
    #level-*       beginner / intermediate / advanced
    #duration-*    description = "6h 20m"
    #free / #paid  access
    #learn-*       description = one thing you will be able to do
    #prereq-*      description = one thing you need first
    #cert-*        description = the credential this counts towards
    #preview       a lesson open to everyone
    #hide-image    suppress the hero art

  ⚠️ NO INLINE STYLES. Spacing comes from the system's `.ns-stack` utilities
  and the components' own margins. A `style=` attribute here is a value that
  cannot be themed, cannot flip in dark mode and cannot be found by grep.

  ⚠️ NEVER call a Ghost helper across `../` in here — Ghost throws and 500s.
  Use dotted access (`{{primary_tag.url}}`).
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── BREADCRUMB ───────────────────────────────────────────────────────── --}}
<nav class="ns-container ns-crumbtrail" aria-label="Breadcrumb">
  <ol class="ns-breadcrumb">
    <li class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="{{@site.url}}">{{t "Home"}}</a></li>
    <li class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="/courses/">{{t "Courses"}}</a></li>
    <li class="ns-breadcrumb__item"><a class="ns-breadcrumb__link" href="{{url}}" aria-current="page">{{title}}</a></li>
  </ol>
</nav>

{{!-- ── HERO ─────────────────────────────────────────────────────────────── --}}
<section class="ns-chero {{> "courses/hero-variant"}}">

  {{#has tag="#hero-cover, #hero-video, #hero-3, #hero-5"}}
    {{#if feature_image}}
      <div class="ns-chero__bg" aria-hidden="true">
        {{> "components/img" src=feature_image alt="" eager=true sizes="100vw"}}
      </div>
    {{/if}}
  {{/has}}

  <div class="ns-chero__inner">
    <div class="ns-chero__grid">
      <div class="ns-chero__body">

        <div class="ns-chero__badges">
          {{#if featured}}<span class="ns-tag ns-tag--pill">{{> icons name="star"}}{{t "Featured"}}</span>{{/if}}
          <span class="ns-tag">{{t "Updated"}} {{date updated_at format="MMM YYYY"}}</span>
        </div>

        <span class="ns-chero__kicker">{{t "Course"}}{{#primary_tag}} · {{name}}{{/primary_tag}}</span>
        <h1 class="ns-chero__title">{{title}}</h1>
        <p class="ns-chero__lede">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="30"}}{{/if}}</p>

        {{!-- The meta strip: mono, tabular, wrapping rather than truncating —
             every item in it is a reason to enrol. --}}
        <div class="ns-chero__meta">
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |lessons|}}
            <span>{{> icons name="list-checks"}}{{lessons.length}} {{t "lessons"}}</span>
          {{/get}}
          {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<span>{{> icons name="clock"}}{{description}}</span>{{/match}}{{/foreach}}
          <span>{{> icons name="gauge"}}{{#has tag="#level-beginner"}}{{t "Beginner"}}{{else has tag="#level-intermediate"}}{{t "Intermediate"}}{{else has tag="#level-advanced"}}{{t "Advanced"}}{{else}}{{t "All levels"}}{{/has}}</span>
          <span>{{> icons name="seal-check"}}{{t "Self-paced"}}</span>
          {{#has tag="#free"}}<span>{{> icons name="gift"}}{{t "Free"}}</span>{{else has tag="#paid"}}<span>{{> icons name="crown"}}{{t "Members"}}</span>{{/has}}
        </div>

        <div class="ns-chero__actions">
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}{{#foreach posts}}
            <a href="{{url}}" class="ns-btn ns-btn--primary ns-btn--lg">{{> icons name="play"}}{{t "Start course"}}</a>
          {{else}}
            <a href="#enrol" class="ns-btn ns-btn--primary ns-btn--lg">{{t "Enrol"}}</a>
          {{/foreach}}{{/get}}
          <a href="#curriculum" class="ns-btn ns-btn--soft ns-btn--lg">{{> icons name="list"}}{{t "See curriculum"}}</a>
        </div>

        <div class="ns-authors ns-chero__authors">
          <span class="ns-authors__stack" aria-hidden="true">
            {{#foreach authors limit="3"}}{{#if profile_image}}<img class="ns-authors__avatar" loading="lazy" decoding="async" src="{{img_url profile_image size="xxs"}}" alt="">{{/if}}{{/foreach}}
          </span>
          <span class="ns-authors__names">{{t "Taught by"}} {{#foreach authors}}<b>{{name}}</b>{{#unless @last}}, {{/unless}}{{/foreach}}</span>
        </div>
      </div>

      {{#has tag="#hero-cover, #hero-video, #hero-3, #hero-5, #hero-minimal, #hero-2, #hero-4, #hide-image"}}{{else}}
        {{#if feature_image}}
          <div class="ns-chero__media">
            {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson+tag:hash-lesson-type-video" order="published_at asc" limit="1" as |vids|}}
              {{> "components/img" src=feature_image alt="" eager=true sizes="24rem"}}
              {{#if vids.[0]}}
                <a href="{{vids.[0].url}}" class="ns-chero__play" aria-label="{{t "Play the course preview"}}">{{> icons name="play-circle"}}</a>
                <span class="ns-chero__caption">{{t "Preview"}}</span>
              {{/if}}
            {{/get}}
          </div>
        {{/if}}
      {{/has}}
    </div>
  </div>
</section>

{{!-- ── STAT BAND — concrete numbers, before any prose asks for trust ────── --}}
<section class="ns-band ns-band--tight ns-band--sunken">
  <div class="ns-band__inner">
    <dl class="ns-statband">
      {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |lessons|}}
        <div class="ns-statband__cell"><dd class="ns-statband__value">{{lessons.length}}</dd><dt class="ns-statband__label">{{t "Lessons"}}</dt></div>
      {{/get}}
      {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson+tag:hash-lesson-type-video" limit="100" as |vids|}}
        <div class="ns-statband__cell"><dd class="ns-statband__value">{{vids.length}}</dd><dt class="ns-statband__label">{{t "Video lessons"}}</dt></div>
      {{/get}}
      {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<div class="ns-statband__cell"><dd class="ns-statband__value">{{description}}</dd><dt class="ns-statband__label">{{t "Duration"}}</dt></div>{{/match}}{{/foreach}}
      <div class="ns-statband__cell"><dd class="ns-statband__value">∞</dd><dt class="ns-statband__label">{{t "Lifetime access"}}</dt></div>
    </dl>
  </div>
</section>

{{!-- ── BODY + RAIL ──────────────────────────────────────────────────────── --}}
<div class="ns-course-detail ns-container ns-section">

  <main class="ns-course-detail__main ns-stack ns-stack--lg">

    {{!-- ── 4 · OUTCOMES — above the tabs, never behind one ─────────────── --}}
    <section>
      <p class="ns-kicker">{{t "What you'll learn"}}</p>
      <ul class="ns-outcomes ns-outcomes--cards">
        {{#foreach tags visibility="internal"}}
          {{#match slug "~^" "hash-learn-"}}
            <li>{{> icons name="check-circle"}}<span>{{description}}</span></li>
          {{/match}}
        {{/foreach}}
      </ul>
    </section>

    {{!-- ── 5 · THE ARGUMENTS, one click apart ──────────────────────────── --}}
    <div class="ns-tabs" role="tablist" aria-label="{{t "Course details"}}">
      <button class="ns-tab" type="button" role="tab" id="cd-t-overview" aria-controls="cd-p-overview" aria-selected="true">
        {{> icons name="info" class="ns-tab__icon"}}{{t "Overview"}}
      </button>
      <button class="ns-tab" type="button" role="tab" id="cd-t-curriculum" aria-controls="cd-p-curriculum" aria-selected="false">
        {{> icons name="list" class="ns-tab__icon"}}{{t "Curriculum"}}
        {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |l|}}<span class="ns-tab__count">{{l.length}}</span>{{/get}}
      </button>
      <button class="ns-tab" type="button" role="tab" id="cd-t-instructor" aria-controls="cd-p-instructor" aria-selected="false">
        {{> icons name="graduation-cap" class="ns-tab__icon"}}{{t "Instructor"}}
      </button>
    </div>

    {{!-- ── OVERVIEW ─────────────────────────────────────────────────────── --}}
    <div class="ns-tabpanel ns-stack ns-stack--lg" role="tabpanel" id="cd-p-overview" aria-labelledby="cd-t-overview" tabindex="0">

      {{#if html}}
        {{!-- Ghost content = the description. Toggle cards render as FAQ
             accordions and product cards as testimonials (site-course.css). --}}
        <div class="ns-course-content ns-prose gh-content">{{content}}</div>
      {{/if}}

      {{!-- Prerequisites: the other half of "what you will learn", and the
           half that gets left out — what you need BEFORE this course. --}}
      <section>
        <p class="ns-prereq__title">{{t "Before you start"}}</p>
        <ul class="ns-prereq">
          {{#foreach tags visibility="internal"}}
            {{#match slug "~^" "hash-prereq-"}}
              <li class="ns-prereq__item">{{> icons name="check" class="ns-prereq__icon"}}<span>{{description}}</span></li>
            {{/match}}
          {{/foreach}}
        </ul>
      </section>

      {{> "ads/leaderboard"}}
    </div>

    {{!-- ── CURRICULUM ───────────────────────────────────────────────────── --}}
    <div class="ns-tabpanel ns-stack" role="tabpanel" id="cd-p-curriculum" aria-labelledby="cd-t-curriculum" tabindex="0">
      <div id="curriculum">
        {{#has tag="#paid"}}
          <div class="ns-callout ns-callout--warn">
            {{> icons name="lock"}}
            <div>
              <span class="ns-callout__label">{{t "This is a members course"}}</span>
              {{t "Preview lessons are open to everyone. Sign in with a membership to unlock the full curriculum."}}
              <p><a href="#/portal/signup" data-portal="signup" class="ns-btn ns-btn--primary ns-btn--sm">{{t "Unlock"}}</a></p>
            </div>
          </div>
        {{/has}}

        {{> "courses/curriculum-list"}}
      </div>
    </div>

    {{!-- ── INSTRUCTOR ───────────────────────────────────────────────────── --}}
    <div class="ns-tabpanel" role="tabpanel" id="cd-p-instructor" aria-labelledby="cd-t-instructor" tabindex="0">
      <div class="ns-instructors{{#if authors.[1]}} ns-instructors--pair{{/if}}">
        {{#foreach authors}}
          <div class="ns-instructor">
            {{#if profile_image}}
              <img class="ns-instructor__avatar" loading="lazy" decoding="async" src="{{img_url profile_image size="s"}}" alt="">
            {{/if}}
            <div>
              <a href="{{url}}" class="ns-instructor__name">{{name}}</a>
              {{#if location}}<span class="ns-instructor__role">{{location}}</span>{{/if}}
              {{#if bio}}<p class="ns-instructor__bio">{{bio}}</p>{{/if}}
              <div class="ns-instructor__stats">
                {{#if website}}<a href="{{website}}" target="_blank" rel="noopener" class="ns-btn ns-btn--quiet ns-btn--sm">{{> icons name="globe"}}{{t "Website"}}</a>{{/if}}
                <a href="{{url}}" class="ns-btn ns-btn--quiet ns-btn--sm">{{> icons name="books"}}{{t "More by"}} {{name}}</a>
              </div>
            </div>
          </div>
        {{/foreach}}
      </div>
    </div>

    {{> "components/share"}}
  </main>

  {{!-- ── 6 · THE ENROL CARD ───────────────────────────────────────────── --}}
  <aside class="ns-course-detail__rail ns-stack ns-stack--md">

    <div class="ns-buybox js-spotlight" id="enrol">
      {{#has tag="#hide-image"}}{{else}}{{#if feature_image}}
        {{> "components/img" src=feature_image alt="" class="ns-buybox__media" sizes="20rem"}}
      {{/if}}{{/has}}

      <div class="ns-buybox__body">
        <span class="ns-price{{#has tag="#free"}} ns-price--free{{/has}}">
          <span class="ns-price__now">{{#has tag="#paid"}}{{t "Members"}}{{else}}{{t "Free"}}{{/has}}</span>
        </span>

        {{!-- --block, because a call to action in a 20rem rail that is not
             full width reads as one of several options rather than THE one. --}}
        <div class="ns-buybox__actions">
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}{{#foreach posts}}
            <a href="{{url}}" class="ns-btn ns-btn--primary ns-btn--lg ns-btn--block">{{> icons name="play"}}{{t "Start course"}}</a>
          {{else}}
            <a href="#curriculum" class="ns-btn ns-btn--primary ns-btn--lg ns-btn--block">{{t "View curriculum"}}</a>
          {{/foreach}}{{/get}}
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson+tag:hash-preview" order="published_at asc" limit="1"}}{{#foreach posts}}
            <a href="{{url}}" class="ns-btn ns-btn--outline ns-btn--block">{{> icons name="eye"}}{{t "Preview a lesson"}}</a>
          {{/foreach}}{{/get}}
        </div>

        <p class="ns-buybox__note">
          {{#has tag="#paid"}}{{t "Cancel any time. Preview lessons stay free."}}{{else}}{{t "Free, forever. No card, no account needed."}}{{/has}}
        </p>

        <ul class="ns-buybox__list">
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" limit="100" as |ls|}}
            <li>{{> icons name="list-checks"}}{{ls.length}} {{t "lessons"}}</li>
          {{/get}}
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson+tag:hash-lesson-type-video" limit="100" as |vs|}}
            {{#if vs.length}}<li>{{> icons name="video"}}{{vs.length}} {{t "video lessons"}}</li>{{/if}}
          {{/get}}
          {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-duration-"}}<li>{{> icons name="clock"}}{{description}} {{t "of content"}}</li>{{/match}}{{/foreach}}
          <li>{{> icons name="gauge"}}{{#has tag="#level-beginner"}}{{t "Beginner"}}{{else has tag="#level-intermediate"}}{{t "Intermediate"}}{{else has tag="#level-advanced"}}{{t "Advanced"}}{{else}}{{t "All levels"}}{{/has}}</li>
          <li>{{> icons name="infinity"}}{{t "Lifetime access"}}</li>
        </ul>

        {{> "components/share" layout="rail"}}
      </div>

      <p class="ns-buybox__foot">{{t "Updated"}} {{date updated_at format="MMM YYYY"}}</p>
    </div>

    {{!-- What the course is FOR, at the size the argument deserves: the badge
         it counts towards. One #cert-* internal tag, description = the
         credential's name. --}}
    {{#foreach tags visibility="internal"}}
      {{#match slug "~^" "hash-cert-"}}
        <div class="ns-card ns-card--sunken">
          <div class="ns-card__body ns-certcard">
            <span class="ns-certbadge ns-certbadge--associate">
              <span class="ns-certbadge__plate" aria-hidden="true"></span>
              <span class="ns-certbadge__ribbon" aria-hidden="true"></span>
              <span class="ns-certbadge__inner">
                {{> icons name="cloud" class="ns-certbadge__mark"}}
                <span class="ns-certbadge__rule" aria-hidden="true"></span>
                <span class="ns-certbadge__word">{{t "Counts towards"}}</span>
                <span class="ns-certbadge__name">{{description}}</span>
              </span>
            </span>
          </div>
        </div>
      {{/match}}
    {{/foreach}}

    {{!-- Where to go if this is not the one. --}}
    <aside class="ns-related">
      <span class="ns-related__label">{{t "If this is not the one"}}</span>
      <ul>
        {{#get "posts" filter="tag:hash-course+id:-{{id}}" limit="2"}}{{#foreach posts}}
          <li><a href="{{url}}"><span class="ns-related__kind">{{t "Course"}}</span>{{title}}</a></li>
        {{/foreach}}{{/get}}
        <li><a href="/training/"><span class="ns-related__kind">{{t "Track"}}</span>{{t "The whole training path"}}</a></li>
      </ul>
    </aside>

    {{> "ads/slot" format="square"}}
  </aside>
</div>

{{!-- ── The phone counterpart of the enrol card. Hidden ≥64rem by the
     component itself, so the one action the page exists for is never
     scrolled past. ─────────────────────────────────────────────────────── --}}
<div class="ns-buybox ns-buybox--bar">
  <span class="ns-price ns-price--sm{{#has tag="#free"}} ns-price--free{{/has}}">
    <span class="ns-price__now">{{#has tag="#paid"}}{{t "Members"}}{{else}}{{t "Free"}}{{/has}}</span>
  </span>
  {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}{{#foreach posts}}
    <a href="{{url}}" class="ns-btn ns-btn--primary ns-btn--sm">{{t "Start"}}{{> icons name="arrow-right"}}</a>
  {{else}}
    <a href="#curriculum" class="ns-btn ns-btn--primary ns-btn--sm">{{t "Start"}}{{> icons name="arrow-right"}}</a>
  {{/foreach}}{{/get}}
</div>
