<article class="section">
    <div class="container is-max-widescreen">
        <div class="box">

            {{#if primary_tag}}
                <div class="mb-4">
                    <a href="{{primary_tag.url}}" class="tag is-primary is-light">{{primary_tag.name}}</a>
                </div>
            {{/if}}

            <h1 class="title is-2">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="subtitle is-5">{{custom_excerpt}}</p>
            {{/if}}

            <div class="level is-mobile mb-5">
                <div class="level-left">
                    <div class="level-item">
                        <span class="tag is-light">{{reading_time}}</span>
                    </div>
                    <div class="level-item">
                        <span class="tag is-light">{{date format="DD MMM YYYY"}}</span>
                    </div>
                </div>
            </div>

            {{#if feature_image}}
                <figure class="image mb-5">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                </figure>
            {{/if}}

            <div class="columns is-variable is-6">
                <div class="column is-8-desktop">
                    <div class="content gh-content">
                        {{content}}
                    </div>
                </div>

                <aside class="column is-4-desktop">
                    <div class="box">
                        <p class="title is-6">Course overview</p>

                        {{#if tags}}
                            <div class="tags">
                                {{#foreach tags}}
                                    <a href="{{url}}" class="tag is-light">{{name}}</a>
                                {{/foreach}}
                            </div>
                        {{/if}}

                        <hr>

                        <a href="/courses/" class="button is-primary is-fullwidth">
                            All courses
                        </a>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</article>