{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-course.hbs — Course landing page (single #course post)
  Hero → about + dynamic curriculum + FAQ, with a sticky enrolment sidebar and
  a mobile sticky CTA. Lessons are pulled by matching this course's primary tag.
  Internal tags drive duration/level: hash-course-duration-*, hash-course-level-*
═══════════════════════════════════════════════════════════════════════════ --}}

{{!-- ── Hero ── --}}
<section class="relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-800 to-brand-900 text-white">
  {{> "components/hero-bg"}}
  <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
      <div class="max-w-2xl">
        {{!-- Breadcrumb --}}
        <nav class="mb-4 flex flex-wrap items-center gap-2 text-sm text-white/70" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white">{{t "Home"}}</a><span aria-hidden="true">·</span>
          <a href="/courses/" class="hover:text-white">{{t "Courses"}}</a>
          {{#if primary_tag}}<span aria-hidden="true">·</span><a href="{{primary_tag.url}}" class="hover:text-white">{{primary_tag.name}}</a>{{/if}}
        </nav>

        <div class="mb-4 flex flex-wrap gap-2">
          {{#if primary_tag}}<span class="rounded-pill bg-white/15 px-3 py-1 text-xs font-semibold">{{primary_tag.name}}</span>{{/if}}
          {{#if featured}}<span class="inline-flex items-center gap-1 rounded-pill bg-amber-400/90 px-3 py-1 text-xs font-bold text-amber-950"><i class="ph-fill ph-star" aria-hidden="true"></i>{{t "Featured"}}</span>{{/if}}
        </div>

        <h1 class="font-heading text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">{{title}}</h1>
        <p class="mt-4 max-w-xl text-lg text-white/80">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="26"}}{{/if}}</p>

        {{!-- Meta (duration/level from internal tags) --}}
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/80">
          <span class="inline-flex items-center gap-2 font-semibold text-white"><i class="ph ph-list-checks text-lg" aria-hidden="true"></i>{{t "Structured course"}}</span>
          {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-course-duration-"}}{{#if description}}<span class="inline-flex items-center gap-2"><i class="ph ph-clock text-lg" aria-hidden="true"></i>{{description}}</span>{{/if}}{{/match}}{{/foreach}}
          {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-course-level-"}}{{#if description}}<span class="inline-flex items-center gap-2"><i class="ph ph-signal-high text-lg" aria-hidden="true"></i>{{description}}</span>{{/if}}{{/match}}{{/foreach}}
          <span class="inline-flex items-center gap-2"><i class="ph ph-calendar text-lg" aria-hidden="true"></i>{{t "Updated"}} {{date updated_at format="MMM YYYY"}}</span>
        </div>

        {{#primary_author}}
          <div class="mt-6 flex items-center gap-3">
            {{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="h-11 w-11 rounded-full border-2 border-white/50 object-cover">{{else}}<span class="flex h-11 w-11 items-center justify-center rounded-full bg-white/15"><i class="ph-fill ph-user-circle text-2xl" aria-hidden="true"></i></span>{{/if}}
            <div><p class="text-sm">{{t "Created by"}} <strong>{{name}}</strong></p>{{#if bio}}<p class="max-w-xs text-xs text-white/70">{{bio}}</p>{{/if}}</div>
          </div>
        {{/primary_author}}
      </div>

      {{#if feature_image}}
        <div class="hidden w-80 shrink-0 lg:block">
          <img src="{{img_url feature_image size="l"}}" alt="{{title}}" class="aspect-[4/3] w-full rounded-card object-cover shadow-raised ring-1 ring-white/10">
        </div>
      {{/if}}
    </div>
  </div>
</section>

{{!-- ── Main ── --}}
<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">

    {{!-- Left: about + curriculum + FAQ --}}
    <div class="min-w-0">

      {{#if content}}
        <h2 class="font-heading text-2xl font-extrabold">{{t "About this course"}}</h2>
        <div class="prose mt-4 max-w-none gh-content">{{content}}</div>
      {{/if}}

      {{!-- In-content ad --}}
      {{> "ads/slot" format="horizontal" slot="course-mid"}}

      {{!-- Curriculum --}}
      <h2 id="curriculum" class="mt-12 font-heading text-2xl font-extrabold">{{t "Course curriculum"}}</h2>
      <div class="mt-4 overflow-hidden rounded-card border border-border bg-surface-raised shadow-card">
        <div class="flex items-center justify-between border-b border-border px-5 py-3">
          <h3 class="font-heading font-bold">{{t "Course content"}}</h3>
          <span class="rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">{{t "Structured path"}}</span>
        </div>
        {{#if primary_tag}}
          {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" include="tags" order="published_at asc" limit="100" as |lessons|}}
            {{#foreach lessons}}
              <a href="{{url}}" class="flex items-center justify-between gap-3 border-b border-border px-5 py-3.5 transition last:border-0 hover:bg-brand-500/5">
                <span class="flex min-w-0 items-center gap-3">
                  <i class="ph-fill ph-play-circle shrink-0 text-xl text-brand-500" aria-hidden="true"></i>
                  <span class="truncate font-semibold">{{@number}}. {{title}}</span>
                </span>
                <span class="shrink-0 text-xs text-muted">
                  {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-lesson-duration-"}}{{#if description}}<span class="inline-flex items-center gap-1"><i class="ph ph-clock" aria-hidden="true"></i>{{description}}</span>{{/if}}{{/match}}{{/foreach}}
                </span>
              </a>
            {{else}}
              <p class="px-5 py-6 text-sm text-muted"><i class="ph ph-wrench" aria-hidden="true"></i> {{t "No lessons yet. Content is being drafted."}}</p>
            {{/foreach}}
          {{/get}}
        {{else}}
          <p class="px-5 py-6 text-sm text-error">{{t "Assign a primary tag to this course to link its lessons."}}</p>
        {{/if}}
      </div>

      {{!-- FAQ --}}
      <h2 class="mt-12 font-heading text-2xl font-extrabold">{{t "Frequently asked questions"}}</h2>
      <div class="mt-4 space-y-3">
        {{> "courses/faq-item" q=(t "Is this course beginner friendly?") a=(t "Yes — the early lessons cover the fundamentals before moving on to advanced implementations.")}}
        {{> "courses/faq-item" q=(t "Do I get lifetime access?") a=(t "Absolutely. Once you start, you have access to the materials and all future updates.")}}
        {{> "courses/faq-item" q=(t "Will this help for interviews?") a=(t "Yes — we cover common scenario-based questions asked in technical interviews.")}}
      </div>
    </div>

    {{!-- Right: sticky enrolment --}}
    <aside>
      <div class="lg:sticky lg:top-20">
        <div class="overflow-hidden rounded-card border border-border bg-surface-raised shadow-card">
          {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="aspect-[16/9] w-full object-cover lg:hidden">
          {{/if}}
          <div class="p-5">
            <div class="flex items-center gap-3">
              <span class="font-heading text-3xl font-extrabold">{{t "Free"}}</span>
              <span class="rounded-pill bg-success/15 px-2.5 py-0.5 text-xs font-bold text-success">{{t "Open source"}}</span>
            </div>
            <p class="mt-1 text-sm text-muted">{{t "Access the entire curriculum instantly."}}</p>

            {{!-- Start → first lesson of this course (falls back to the curriculum list) --}}
            {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}
              {{#foreach posts}}
                <a href="{{url}}" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-pill bg-brand-500 px-4 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600"><i class="ph ph-play" aria-hidden="true"></i>{{t "Start course"}}</a>
              {{else}}
                <a href="#curriculum" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-pill bg-brand-500 px-4 py-3 font-bold text-white shadow-brand transition hover:bg-brand-600">{{t "View curriculum"}}</a>
              {{/foreach}}
            {{/get}}
            <a href="/courses/" class="mt-2 inline-flex w-full items-center justify-center rounded-pill border border-border px-4 py-2.5 text-sm font-semibold transition hover:border-brand-500">{{t "Back to catalog"}}</a>

            <h3 class="mt-6 font-heading font-bold">{{t "This course includes:"}}</h3>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li class="flex items-center gap-3"><i class="ph ph-list-checks text-lg text-brand-500" aria-hidden="true"></i>{{t "Structured curriculum"}}</li>
              {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-course-duration-"}}<li class="flex items-center gap-3"><i class="ph ph-clock text-lg text-brand-500" aria-hidden="true"></i>{{#if description}}{{description}}{{else}}{{name}}{{/if}}</li>{{/match}}{{/foreach}}
              {{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-course-level-"}}<li class="flex items-center gap-3"><i class="ph ph-signal-high text-lg text-brand-500" aria-hidden="true"></i>{{#if description}}{{description}}{{else}}{{name}}{{/if}}</li>{{/match}}{{/foreach}}
              <li class="flex items-center gap-3"><i class="ph ph-infinity text-lg text-brand-500" aria-hidden="true"></i>{{t "Lifetime access"}}</li>
              <li class="flex items-center gap-3"><i class="ph ph-calendar text-lg text-brand-500" aria-hidden="true"></i>{{t "Updated"}} {{date updated_at format="DD MMM YYYY"}}</li>
            </ul>

            <hr class="my-5 border-border">
            <div class="flex items-center justify-between text-sm">
              <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute='true'}}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-muted hover:text-brand-600"><i class="ph ph-share-network text-lg" aria-hidden="true"></i>{{t "Share"}}</a>
              <a href="/contact/" class="inline-flex items-center gap-2 font-semibold text-muted hover:text-brand-600"><i class="ph ph-envelope text-lg" aria-hidden="true"></i>{{t "Contact"}}</a>
            </div>
          </div>
        </div>

        <div class="mt-6">{{> "ads/slot" format="square"}}</div>
      </div>
    </aside>
  </div>
</section>

{{!-- ── Mobile sticky CTA ── --}}
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-surface/90 px-4 py-2.5 backdrop-blur lg:hidden">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3">
    <span class="truncate font-semibold">{{title}}</span>
    {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+tag:hash-lesson" order="published_at asc" limit="1"}}
      {{#foreach posts}}
        <a href="{{url}}" class="inline-flex shrink-0 items-center gap-1 rounded-pill bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-brand">{{t "Start"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      {{else}}
        <a href="#curriculum" class="inline-flex shrink-0 items-center gap-1 rounded-pill bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-brand">{{t "Start"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      {{/foreach}}
    {{/get}}
  </div>
</div>
