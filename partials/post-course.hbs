{{!-- Hero section --}}
<section id="sx-hero" class="hero is-dark is-medium {{hero_class}} {{post_class}}">
    <div class="hero-body">
        <div class="container is-max-widescreen">
            <div class="columns is-vcentered is-variable is-8 {{#has tag="#temp-media-start"}}is-flex-direction-row-reverse{{/has}}">

                {{!-- Content Column --}}
                <div class="column {{#if feature_image}}is-6-desktop{{else}}is-8-desktop is-offset-2-desktop has-text-centered{{/if}}">

                    {{!-- Primary Tag & Featured Badge --}}
                    <div class="field is-grouped is-grouped-multiline mb-4 {{#unless feature_image}}is-justify-content-center{{/unless}}">
                        {{#foreach tags limit="1" from="2"}}
                            <div class="control">
                                <a href="{{url absolute="true"}}" class="tag is-primary is-light is-medium is-rounded has-text-weight-semibold">
                                    {{name}}
                                </a>
                            </div>
                        {{/foreach}}

                        {{#if featured}}
                            <div class="control">
                                <span class="tag is-warning is-medium is-rounded">
                                    {{t "Featured"}}
                                </span>
                            </div>
                        {{/if}}
                    </div>

                    {{!-- Heading --}}
                    <h1 class="title is-1 is-size-2-mobile has-text-weight-bold mb-5">
                        {{title}}
                    </h1>

                    {{!-- Excerpt --}}
                    {{#if custom_excerpt}}
                        <p class="subtitle is-5 mt-3 mb-6 has-text-grey-light">
                            {{custom_excerpt}}
                        </p>
                    {{/if}}

                    {{!-- Metadata --}}
                    <div id="sx-hero-meta"
                         class="is-flex is-flex-wrap-wrap is-align-items-center mb-6 has-text-grey-light is-size-6 is-invisible"
                         style="gap: 0.5rem;"
                         data-empty="{{t 'No lessons yet'}}"
                         data-sx-singular="{{t '% Lesson'}}"
                         data-sx-plural="{{t '% Lessons'}}">
                        
                        <span id="sx-hero-meta-count" class="has-text-weight-semibold has-text-white"></span>

                        {{#foreach tags visibility="internal"}}
                            {{#match slug "~^" "hash-course-duration-"}}
                                {{#if description}}
                                    <span class="has-text-grey">•</span><span>{{description}}</span>
                                {{/if}}
                            {{/match}}

                            {{#match slug "~^" "hash-course-level-"}}
                                {{#if description}}
                                    <span class="has-text-grey">•</span><span>{{description}}</span>
                                {{/if}}
                            {{/match}}
                        {{/foreach}}

                        <span class="has-text-grey">•</span>
                        <time id="sx-hero-meta-time" datetime='{{date updated_at format="YYYY-MM-DD"}}'>
                            {{{t "Updated on {date}" date=(date updated_at)}}}
                        </time>
                    </div>

                    {{!-- CTA Link --}}
                    <div class="buttons {{#unless feature_image}}is-centered{{/unless}}">
                        <a id="sx-hero-cta"
                           href="#"
                           class="button is-primary is-large is-rounded is-fullwidth-mobile has-text-weight-bold">
                            <span>{{t "Start Course"}}</span>
                            <span class="icon is-small ml-2">
                                <i class="ph ph-arrow-right"></i>
                            </span>
                        </a>
                    </div>
                </div>

                {{!-- Media Column --}}
                {{^has tag="#temp-no-media"}}
                    {{#if feature_image}}
                        <div id="sx-hero-media" class="column is-6-desktop">
                            <figure class="image box p-0 is-clipped is-shadowless has-background-black-ter
                                {{#has tag="#temp-media-1-1"}}is-1by1
                                {{else has tag="#temp-media-3-4"}}is-3by4
                                {{else has tag="#temp-media-4-3"}}is-4by3
                                {{else has tag="#temp-media-16-9"}}is-16by9
                                {{else}}is-5by4{{/has}}">
                                
                                <img src="{{img_url feature_image size="l"}}" alt="{{title}}" style="object-fit: cover;">

                                {{#has tag="#temp-video"}}
                                    <div class="is-overlay is-flex is-align-items-flex-end is-justify-content-flex-start p-5" style="background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
                                        <button type="button" class="button is-white is-rounded is-medium">
                                            <span class="icon">
                                                <i class="ph-fill ph-play"></i>
                                            </span>
                                            <span>{{t "Watch Intro"}}</span>
                                        </button>
                                    </div>
                                {{/has}}
                            </figure>

                            {{#if feature_image_caption}}
                                {{^has tag="#temp-video"}}
                                    <p class="help has-text-centered mt-3 has-text-grey-light">{{feature_image_caption}}</p>
                                {{/has}}
                            {{/if}}
                        </div>
                    {{/if}}
                {{/has}}

            </div>
        </div>
    </div>
</section>

{{!-- Course Section (Added pb-6 to accommodate sticky navbar) --}}
<div class="section pb-6">
    <div class="container is-max-widescreen">
        <div class="columns is-centered">
            <div class="column is-8-desktop is-10-tablet">

                {{!-- Course content using Bulma Panel --}}
                <div class="block">
                    <nav class="panel is-primary has-background-white box p-0 is-shadowless" style="border: 1px solid #dbdbdb;">
                        
                        <div class="panel-heading is-flex is-justify-content-space-between is-align-items-center has-background-white has-text-dark border-bottom" style="border-bottom: 1px solid #dbdbdb;">
                            <h2 class="title is-4 mb-0">{{t "Course content"}}</h2>
                            <span class="tag is-light is-medium is-rounded">Structured learning path</span>
                        </div>

                        {{#has tag="#groups-disabled"}}
                            {{#get "posts" filter="tags:{{primary_tag.slug}}+tags:hash-lessons-col" include="tags" order="published_at asc" limit="100" as |lessons|}}
                                {{#foreach lessons}}
                                    <a data-sx-lesson href="{{url absolute="true"}}" class="panel-block py-4 px-5 is-flex is-justify-content-space-between">
                                        <div class="is-flex is-align-items-center">
                                            <span class="panel-icon has-text-primary">
                                                <i class="ph ph-play-circle is-size-5"></i>
                                            </span>
                                            <span class="has-text-weight-semibold has-text-dark">{{title}}</span>
                                        </div>

                                        <span class="is-size-7 has-text-grey">
                                            {{#foreach tags visibility="internal"}}
                                                {{#match slug "~^" "hash-lesson-duration-"}}
                                                    {{#if description}}<span>{{description}}</span>{{/if}}
                                                {{/match}}
                                            {{/foreach}}
                                        </span>
                                    </a>
                                {{else}}
                                    <div class="panel-block p-5 has-text-grey">{{t "No lessons yet"}}</div>
                                {{/foreach}}
                            {{/get}}

                        {{else}}
                            {{#foreach tags visibility="internal"}}
                                {{#match slug "~^" "hash-group-"}}
                                    <div class="group-wrapper" data-sx-group id="tags-{{slug}}">

                                        {{!-- Group Header --}}
                                        <a data-sx-open="tags-{{slug}}" class="panel-block has-background-white-bis py-4 px-5 is-flex is-justify-content-space-between is-clickable">
                                            <div class="is-flex is-align-items-center">
                                                <span class="panel-icon mr-3">
                                                    {{#if feature_image}}
                                                        <figure class="image is-24x24"><img src="{{feature_image}}" alt="{{description}}" class="is-rounded"></figure>
                                                    {{else}}
                                                        <i class="ph-fill ph-folder-open is-size-5 has-text-grey"></i>
                                                    {{/if}}
                                                </span>
                                                <div>
                                                    <div class="has-text-weight-bold has-text-dark is-size-6">
                                                        {{#if description}}{{description}}{{else}}{{name}}{{/if}}
                                                    </div>
                                                    {{#if meta_description}}
                                                        <p class="is-size-7 has-text-grey mt-1">{{meta_description}}</p>
                                                    {{/if}}
                                                </div>
                                            </div>

                                            <div class="is-flex is-align-items-center">
                                                <span data-sx-lessons-count-target class="tag is-white is-rounded border is-invisible mr-3"></span>
                                                <span class="icon has-text-grey">
                                                    <i class="ph ph-caret-down" data-sx-icon></i>
                                                </span>
                                            </div>
                                        </a>

                                        {{!-- Lessons List under Group --}}
                                        {{#>withThis groupTag=. course=..}}
                                            {{#get "posts" filter="tags:{{course.primary_tag.slug}}+tags:{{groupTag.slug}}+tags:hash-lessons-col" include="tags" order="published_at asc" limit="100" as |lessons|}}
                                                <div class="lessons-collapse {{#if lessons}}is-block{{else}}is-hidden{{/if}}"
                                                     data-sx-lessons-count="{{plural lessons.length empty=(t 'No lessons yet') singular=(t '% Lesson') plural=(t '% Lessons')}}">
                                                    {{#foreach lessons}}
                                                        <a data-sx-lesson
                                                           data-sx-updated-on="{{date updated_at format="YYYY-MM-DD"}}"
                                                           href="{{url absolute="true"}}"
                                                           class="panel-block py-4 px-6 is-flex is-justify-content-space-between pl-6">
                                                            <div class="is-flex is-align-items-center">
                                                                <span class="panel-icon has-text-primary ml-3">
                                                                    <i class="ph ph-play-circle is-size-5"></i>
                                                                </span>
                                                                <span class="is-size-6 has-text-dark">{{title}}</span>
                                                            </div>

                                                            <span class="is-size-7 has-text-grey">
                                                                {{#foreach tags visibility="internal"}}
                                                                    {{#match slug "~^" "hash-lesson-duration-"}}
                                                                        {{#if description}}<span>{{description}}</span>{{/if}}
                                                                    {{/match}}
                                                                {{/foreach}}
                                                            </span>
                                                        </a>
                                                    {{else}}
                                                        <div class="panel-block p-5 pl-6 has-text-grey">{{t "No lessons yet"}}</div>
                                                    {{/foreach}}
                                                </div>
                                            {{/get}}
                                        {{/withThis}}
                                    </div>
                                {{/match}}
                            {{/foreach}}
                        {{/has}}
                    </nav>
                </div>

                <div class="content mt-6 is-medium">
                    {{content}}
                </div>

            </div>
        </div>
    </div>
</div>

{{!-- Sticky Footer CTA using Bulma Navbar --}}
<nav id="sx-course-link-sticky" class="navbar is-fixed-bottom has-shadow is-hidden-mobile py-2" role="navigation">
    <div class="container is-max-widescreen">
        <div class="navbar-brand is-align-items-center">
            <span class="navbar-item has-text-weight-bold is-size-6">{{title}}</span>
        </div>

        <div class="navbar-end">
            <div class="navbar-item">
                <a href="#" class="button is-primary is-rounded has-text-weight-semibold">
                    <span>{{t "Start Course"}}</span>
                    <span class="icon is-small ml-1"><i class="ph ph-arrow-right"></i></span>
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    (() => {
        const lessons = Array.from(document.querySelectorAll("[data-sx-lesson]"));
        const heroMeta = document.getElementById("sx-hero-meta");
        const countNode = document.getElementById("sx-hero-meta-count");
        const btn = document.getElementById("sx-hero-cta");
        const stickyBtn = document.querySelector("#sx-course-link-sticky a.button");

        if (lessons.length > 0) {
            if (btn) btn.href = lessons[0].href;
            if (stickyBtn) stickyBtn.href = lessons[0].href;

            if (countNode && heroMeta) {
                const singular = heroMeta.getAttribute("data-sx-singular");
                const plural = heroMeta.getAttribute("data-sx-plural");
                countNode.textContent = (lessons.length === 1 ? singular : plural).replace("%", lessons.length);
                heroMeta.classList.remove("is-invisible");
            }
        } else if (countNode && heroMeta) {
            countNode.textContent = heroMeta.getAttribute("data-empty") || "No lessons yet";
            heroMeta.classList.remove("is-invisible");
        }

        // Handle group lesson counts
        document.querySelectorAll("[data-sx-group]").forEach(group => {
            const lessonsCount = group.querySelector("[data-sx-lessons-count]");
            const targetElement = group.querySelector("[data-sx-lessons-count-target]");

            if (targetElement && lessonsCount) {
                targetElement.textContent = lessonsCount.getAttribute("data-sx-lessons-count");
                targetElement.classList.remove("is-invisible");
            }
        });

        // Handle Accordion Logic dynamically via Bulma utility classes and Phosphor icons
        document.querySelectorAll("[data-sx-open]").forEach(trigger => {
            trigger.addEventListener("click", (e) => {
                e.preventDefault();
                const group = trigger.closest(".group-wrapper");
                const panel = group ? group.querySelector(".lessons-collapse") : null;
                const icon = trigger.querySelector("[data-sx-icon]");

                if (!group || !panel) return;

                const isHidden = panel.classList.contains("is-hidden");

                if (isHidden) {
                    // Open it
                    panel.classList.remove("is-hidden");
                    panel.classList.add("is-block");
                    if (icon) {
                        icon.classList.remove("ph-caret-right");
                        icon.classList.add("ph-caret-down");
                    }
                } else {
                    // Close it
                    panel.classList.remove("is-block");
                    panel.classList.add("is-hidden");
                    if (icon) {
                        icon.classList.remove("ph-caret-down");
                        icon.classList.add("ph-caret-right");
                    }
                }
            });
        });
    })();
</script>