{{!-- =========================================================
    PARTIAL: partials/ns-course-group.hbs
    INPUTS:
      - course_slug  (string)  -> primary_tag.slug of the course
    CONTEXT:
      - current context is the group tag (from foreach tags)
========================================================= --}}

<div class="group-wrapper" data-ns-group id="tags-{{slug}}">

    {{!-- Group Header --}}
    <a data-ns-open="tags-{{slug}}" class="panel-block has-background-white-bis py-4 px-5 is-flex is-justify-content-space-between is-clickable">
        <div class="is-flex is-align-items-center">
            <span class="panel-icon mr-3">
                {{#if feature_image}}
                    <figure class="image is-24x24">
                        <img src="{{feature_image}}" alt="{{description}}" class="is-rounded">
                    </figure>
                {{else}}
                    <i class="ph-fill ph-folder-open is-size-5 has-text-grey"></i>
                {{/if}}
            </span>

            <div>
                <div class="has-text-weight-bold has-text-dark is-size-6">
                    {{#if description}}{{description}}{{else}}{{name}}{{/if}}
                </div>

                {{#if meta_description}}
                    <p class="is-size-7 has-text-grey mt-1">{{meta_description}}</p>
                {{/if}}
            </div>
        </div>

        <div class="is-flex is-align-items-center">
            <span data-ns-lessons-count-target class="tag is-white is-rounded is-invisible mr-3"></span>
            <span class="icon has-text-grey">
                <i class="ph ph-caret-down" data-ns-icon></i>
            </span>
        </div>
    </a>

    {{!-- Group Lessons --}}
    {{#get "posts"
        filter="tag:{{course_slug}}+tag:{{slug}}+tag:hash-lessons-col"
        include="tags"
        order="published_at asc"
        limit="100"
        as |lessons|
    }}
        <div class="lessons-collapse {{#if lessons.length}}is-block{{else}}is-hidden{{/if}}"
             data-ns-lessons-count="{{plural lessons.length empty=(t 'No lessons yet') singular=(t '% Lesson') plural=(t '% Lessons')}}">

            {{#foreach lessons}}
                <a data-ns-lesson
                   href="{{url absolute="true"}}"
                   class="panel-block py-4 px-6 is-flex is-justify-content-space-between">
                    <div class="is-flex is-align-items-center">
                        <span class="panel-icon has-text-primary">
                            <i class="ph ph-play-circle is-size-5"></i>
                        </span>
                        <span class="is-size-6 has-text-dark">{{title}}</span>
                    </div>

                    <span class="is-size-7 has-text-grey">
                        {{#foreach tags visibility="internal"}}
                            {{#match slug "~^" "hash-lesson-duration-"}}
                                {{#if description}}<span>{{description}}</span>{{/if}}
                            {{/match}}
                        {{/foreach}}
                    </span>
                </a>
            {{else}}
                <div class="panel-block p-5 has-text-grey">{{t "No lessons yet"}}</div>
            {{/foreach}}
        </div>
    {{/get}}

</div>