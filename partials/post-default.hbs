{{!--
    post-default.hbs — Namaste Salesforce Theme
    ============================================================
    Fallback post layout. Used for any post that doesn't match
    a specific collection tag. Renders a clean, full-featured
    article with header, byline, feature image, content,
    comments, email CTA, and related posts.

    CONTEXT: Inside {{#post}} from post.hbs dispatcher.
    All post data is available directly (title, content, etc.)
    ============================================================
--}}

<main id="site-main" class="site-main">
    <article class="article {{post_class}}">

        {{!-- ── Article Header ──────────────────────────────── --}}
        <header class="article-header gh-canvas">

            {{!-- Tag + featured badge --}}
            <div class="article-tag">
                {{#primary_tag}}
                    <a class="article-tag-link" href="{{url}}">{{name}}</a>
                {{/primary_tag}}
                {{#if featured}}
                    <span class="article-featured-badge">
                        {{> "icons/fire"}} {{t "Featured"}}
                    </span>
                {{/if}}
            </div>

            {{!-- Title --}}
            <h1 class="article-title">{{title}}</h1>

            {{!-- Excerpt --}}
            {{#if custom_excerpt}}
                <p class="article-excerpt">{{custom_excerpt}}</p>
            {{/if}}

            {{!-- Byline --}}
            <div class="article-byline">
                <section class="article-byline-content">

                    {{!-- Author avatars --}}
                    <ul class="author-list" aria-label="{{t "Authors"}}">
                        {{#foreach authors}}
                        <li class="author-list-item">
                            {{#if profile_image}}
                                <a href="{{url}}" class="author-avatar" aria-label="{{t "More posts by"}} {{name}}">
                                    <img
                                        class="author-profile-image"
                                        src="{{img_url profile_image size="xs"}}"
                                        alt="{{name}}"
                                    />
                                </a>
                            {{else}}
                                <a href="{{url}}" class="author-avatar" aria-label="{{t "More posts by"}} {{name}}">
                                    {{> "icons/avatar"}}
                                </a>
                            {{/if}}
                        </li>
                        {{/foreach}}
                    </ul>

                    {{!-- Author name, date, reading time --}}
                    <div class="article-byline-meta">
                        <span class="author-name">
                            {{authors separator=", " prefix="" suffix=""}}
                        </span>
                        <div class="byline-meta-content">
                            <time
                                class="byline-meta-date"
                                datetime="{{date format="YYYY-MM-DD"}}"
                            >{{date format="DD MMM YYYY"}}</time>
                            {{#if reading_time}}
                                <span class="byline-reading-time">
                                    <span class="byline-bull" aria-hidden="true">&bull;</span>
                                    {{reading_time
                                        minute=(t "1 min read")
                                        minutes=(t "% min read")
                                    }}
                                </span>
                            {{/if}}
                        </div>
                    </div>

                </section>
            </div>

            {{!-- Feature image --}}
            {{#match @custom.post_image_style "!=" "Hidden"}}
                {{#if feature_image}}
                    <figure class="article-image {{#match @custom.post_image_style "Full"}}image-full{{else match @custom.post_image_style "Small"}}image-small{{/match}}">
                        <img
                            srcset="{{img_url feature_image size="s"}} 300w,
                                    {{img_url feature_image size="m"}} 600w,
                                    {{img_url feature_image size="l"}} 1000w,
                                    {{img_url feature_image size="xl"}} 2000w"
                            sizes="(min-width: 1400px) 1400px, 92vw"
                            src="{{img_url feature_image size="xl"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                            loading="eager"
                        />
                        {{#if feature_image_caption}}
                            <figcaption>{{feature_image_caption}}</figcaption>
                        {{/if}}
                    </figure>
                {{/if}}
            {{/match}}

        </header>
        {{!-- /.article-header --}}

        {{!-- ── Article Content ───────────────────────────── --}}
        <section class="gh-content gh-canvas">
            {{content}}
        </section>

        {{!-- ── Tags (bottom) ────────────────────────────── --}}
        {{#if tags}}
            <footer class="article-footer gh-canvas">
                <div class="article-tags">
                    {{#foreach tags}}
                        {{#unless internal}}
                            <a href="{{url}}" class="article-tag-pill">{{name}}</a>
                        {{/unless}}
                    {{/foreach}}
                </div>
            </footer>
        {{/if}}

        {{!-- ── Comments ─────────────────────────────────── --}}
        {{#if comments}}
            <section class="article-comments gh-canvas">
                {{comments}}
            </section>
        {{/if}}

    </article>
</main>
{{!-- /.site-main --}}


{{!-- ── Email Signup CTA ────────────────────────────────── --}}
{{#if @site.members_enabled}}
    {{#unless @member}}
        {{#unless @site.comments_enabled}}
            {{#if access}}
                <section class="footer-cta outer">
                    <div class="inner">
                        {{#if @custom.email_signup_text}}
                            <h2 class="footer-cta-title">{{@custom.email_signup_text}}</h2>
                        {{/if}}
                        <a class="footer-cta-button" href="#/portal" data-portal>
                            <span class="footer-cta-input">{{t "Enter your email"}}</span>
                            <span>{{t "Subscribe"}}</span>
                        </a>
                    </div>
                </section>
            {{/if}}
        {{/unless}}
    {{/unless}}
{{/if}}


{{!-- ── Related Posts ──────────────────────────────────── --}}
{{#if @custom.show_recent_posts_footer}}
    {{#get "posts" filter="id:-{{id}}" limit="3" as |more_posts|}}
        {{#if more_posts}}
            <aside class="read-more-wrap outer" aria-label="{{t "More posts"}}">
                <div class="read-more inner">
                    {{#foreach more_posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </aside>
        {{/if}}
    {{/get}}
{{/if}}
