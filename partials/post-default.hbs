<article class="section">
    <div class="container is-max-desktop">
        <div class="columns is-variable is-6">
            <div class="column is-8-desktop">
                <div class="content">

                    {{#if primary_tag}}
                        <div class="mb-4">
                            <a href="{{primary_tag.url}}" class="tag is-link is-light">{{primary_tag.name}}</a>
                        </div>
                    {{/if}}

                    <h1 class="title is-2">{{title}}</h1>

                    <p class="subtitle is-6">
                        <span>{{authors separator=", "}}</span>
                        <span> • </span>
                        <span>{{date format="DD MMM YYYY"}}</span>
                        <span> • </span>
                        <span>{{reading_time}}</span>
                    </p>

                    {{#if custom_excerpt}}
                        <p class="is-size-5 has-text-grey">{{custom_excerpt}}</p>
                    {{/if}}

                    {{#if feature_image}}
                        <figure class="image mb-5">
                            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                        </figure>
                    {{/if}}

                    <div class="content gh-content">
                        {{content}}
                    </div>
                </div>
            </div>

            <aside class="column is-4-desktop">
                <div class="box">
                    <p class="title is-6">Post info</p>
                    <p><strong>Published:</strong> {{date format="DD MMM YYYY"}}</p>
                    <p><strong>Reading time:</strong> {{reading_time}}</p>

                    {{#if primary_tag}}
                        <p class="mt-3"><strong>Category:</strong></p>
                        <a href="{{primary_tag.url}}" class="tag is-light">{{primary_tag.name}}</a>
                    {{/if}}

                    {{#if tags}}
                        <p class="mt-4 mb-2"><strong>Tags:</strong></p>
                        <div class="tags">
                            {{#foreach tags}}
                                <a href="{{url}}" class="tag">{{name}}</a>
                            {{/foreach}}
                        </div>
                    {{/if}}
                </div>
            </aside>
        </div>
    </div>
</article>








