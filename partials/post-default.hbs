{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-default.hbs — Generic single-post article layout
  ----------------------------------------------------------------------------
  Context: {{#post}} (set by post.hbs router). Centred reading column with a
  header (tag, title, byline), feature image, .prose content, tag footer,
  social share, comments and related posts.
═══════════════════════════════════════════════════════════════════════════ --}}
<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">

  {{!-- ── Header ── --}}
  <header class="mb-8">
    {{#primary_tag}}
      <a href="{{url}}" class="inline-flex items-center rounded-pill bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600 dark:text-brand-300">{{name}}</a>
    {{/primary_tag}}

    <h1 class="mt-4 font-heading text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">{{title}}</h1>

    {{#if custom_excerpt}}
      <p class="mt-4 text-lg text-muted">{{custom_excerpt}}</p>
    {{/if}}

    {{!-- Byline (reusable component) --}}
    <div class="mt-6 border-y border-border py-4">
      {{> "components/author-byline"}}
    </div>
  </header>

  {{!-- ── Feature image ── --}}
  {{#if feature_image}}
    <figure class="mb-8">
      <img src="{{img_url feature_image size='l'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
           class="w-full rounded-card object-cover shadow-card">
      {{#if feature_image_caption}}
        <figcaption class="mt-2 text-center text-sm text-muted">{{feature_image_caption}}</figcaption>
      {{/if}}
    </figure>
  {{/if}}

  {{!-- ── Content ── --}}
  <div class="prose prose-lg max-w-none gh-content">
    {{content}}
  </div>

  {{!-- ── Footer: all tags + share ── --}}
  <footer class="mt-10 flex flex-col gap-6 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
    {{> "components/tag-pills"}}
    {{> social-share}}
  </footer>

  {{!-- ── Comments ── --}}
  {{comments}}

</article>

{{!-- ── Related posts ── --}}
{{> related-posts}}
