{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-default.hbs — the generic single post.

  The fallback the post.hbs router lands on when a post carries none of the
  type tags. It is the SAME reading surface as a blog post — `.ns-posthead`
  over `.ns-post` — because a post with no type is still a post, and giving it
  a second layout is how two article pages end up disagreeing about where the
  title sits.

  The difference from post-blog is what it does NOT have: no head variants (an
  untyped post has no art direction to pick from), no series box, no left
  rail. The outline and the share rail still earn their place, and the
  component drops both on narrow screens on its own.

  Context: {{#post}}, set by the post.hbs router.
═══════════════════════════════════════════════════════════════════════════ --}}

<header class="ns-posthead ns-posthead--center">
  <div class="ns-posthead__inner">
    {{#primary_tag}}<a href="{{url}}" class="ns-tag ns-posthead__cat">{{name}}</a>{{/primary_tag}}
    <h1 class="ns-posthead__title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="ns-posthead__standfirst">{{custom_excerpt}}</p>{{/if}}
    {{> "components/author-byline"}}

    {{#if feature_image}}
      {{!-- The cover under the title is the LCP element on this route. --}}
      {{> "components/img" src=feature_image class="ns-posthead__cover" eager=true
          alt=feature_image_alt sizes="(min-width: 48rem) 44rem, 100vw"}}
      {{#if feature_image_caption}}<span class="ns-posthead__credit">{{feature_image_caption}}</span>{{/if}}
    {{/if}}
  </div>
</header>

<div class="ns-post">
  <div class="ns-post__rail">{{> "components/toc"}}</div>

  <article class="ns-post__body">
    {{> "components/breadcrumb"}}

    <div class="ns-prose gh-content">{{content}}</div>

    {{> "ads/slot" format="horizontal"}}

    <footer class="ns-postfoot">
      {{> "components/tag-pills"}}
      {{> "components/share"}}
    </footer>

    <div class="mt-10">{{> "components/author-box"}}</div>

    {{#if @site.comments_enabled}}{{comments}}{{/if}}
  </article>

  <div class="ns-post__aside">{{> "components/share" layout="rail"}}</div>
</div>

{{> related-posts}}
