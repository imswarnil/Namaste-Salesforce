{{!-- partials/related-posts.hbs — "You might also like"
     Pulls up to 3 posts sharing the current post's primary tag (excluding self).
     Context: a post. Renders nothing when there are no matches. --}}
{{#get "posts" include="tags,authors" limit="3" filter="id:-{{id}}+tag:{{primary_tag.slug}}" as |related|}}
  {{#if related}}
    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="mb-6 text-center">
        <p class="ns-kicker">{{t "Continue reading"}}</p>
        <h2 class="mt-1 font-heading text-2xl font-extrabold">{{t "You might also like"}}</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {{#foreach related}}
          <div class="motion-safe:animate-fade-up">{{> post-card}}</div>
        {{/foreach}}
      </div>
    </section>
  {{/if}}
{{/get}}
