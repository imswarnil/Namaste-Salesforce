
{{#foreach tags visibility="public" limit="1"}}
    {{#get "posts"
        filter="tags:hash-courses-col+tags:{{slug}}"
        limit="1"
        include="tags"
        order="published_at asc"
        as |course_posts|
    }}
        {{#if course_posts.[0]}}
            {{> "lesson" indexPage=course_posts.[0] post=../.. filterTagPrefix="hash-lessons-col"}}
        {{else}}
            {{> "lesson" post=../..}}
        {{/if}}
    {{/get}}
{{/foreach}}