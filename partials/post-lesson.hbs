<div class="section is-small">
  <div class="container is-fluid">
    <div class="columns is-variable is-6">

      {{!-- ==========================================
            LEFT SIDEBAR: COURSE INDEX 
            (Stacks to the top on Mobile/Tablet automatically)
      ========================================== --}}
      <aside class="column is-12-mobile is-12-tablet is-3-desktop">
        <div class="box is-shadowless  mb-5">
          <div class="menu">
            <p class="menu-label has-text-weight-bold has-text-grey">Course Lessons</p>
            <ul class="menu-list is-size-6">
              {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" order="published_at asc" limit="100"}}
                {{#foreach posts}}
                  <li>
                    <a href="{{url}}" class="{{#match id ../../id}}is-active has-background-link has-text-white has-text-weight-bold{{else}}has-text-grey-dark{{/match}} is-flex is-align-items-flex-start mb-2 py-3 px-4">
                      <span class="mr-2 has-text-weight-light">{{@number}}.</span>
                      <span>{{title}}</span>
                    </a>
                  </li>
                {{/foreach}}
              {{/get}}
            </ul>
          </div>

        </div>
      </aside>

      {{!-- ==========================================
            CENTER: MAIN LESSON CONTENT
      ========================================== --}}
      <main class="column is-12-mobile is-12-tablet is-7-desktop">
        <article class="box is-shadowless p-0-mobile p-5-tablet">
          
          <header class="mb-6">
            <div class="tags mb-4">
              <span class="tag is-link is-light is-rounded has-text-weight-bold">Lesson</span>
              <span class="tag is-white has-text-grey is-rounded">
                <span class="icon is-small mr-1"><i class="ph ph-clock"></i></span> {{reading_time}}
              </span>
            </div>
            
            <h1 class="title is-2 is-size-3-mobile has-text-weight-bold mb-4">{{title}}</h1>
            
            {{#if custom_excerpt}}
              <p class="subtitle is-4 is-size-5-mobile has-text-grey mt-3">{{custom_excerpt}}</p>
            {{/if}}
          </header>

          {{#if feature_image}}
            <figure class="image mb-6">
              <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="has-background-light">
            </figure>
          {{/if}}

          {{!-- The Content Area --}}
          <div class="content is-medium has-text-grey-dark gh-content js-toc-content">
            {{content}}
          </div>

          {{!-- Pagination (Prev/Next) --}}
          <nav class="level is-mobile mt-6 pt-6" aria-label="Lesson navigation">
            <div class="level-left">
              <div class="level-item">
                {{#prev_post in="primary_tag" filter="tag:hash-lesson"}}
                  <a href="{{url}}" class="button is-light is-rounded has-text-weight-bold">
                    <span class="icon"><i class="ph ph-arrow-left"></i></span>
                    <span class="is-hidden-mobile">Previous Lesson</span>
                    <span class="is-hidden-tablet">Prev</span>
                  </a>
                {{/prev_post}}
              </div>
            </div>
            <div class="level-right">
              <div class="level-item">
                {{#next_post in="primary_tag" filter="tag:hash-lesson"}}
                  <a href="{{url}}" class="button is-link is-rounded has-text-weight-bold">
                    <span class="is-hidden-mobile">Next Lesson</span>
                    <span class="is-hidden-tablet">Next</span>
                    <span class="icon"><i class="ph ph-arrow-right"></i></span>
                  </a>
                {{else}}
                  {{!-- If it's the last lesson, show Finish Course --}}
                  {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
                    {{#foreach posts}}
                      <a href="{{url}}" class="button is-success is-rounded has-text-weight-bold">
                        <span class="is-hidden-mobile">Finish Course</span>
                        <span class="is-hidden-tablet">Finish</span>
                        <span class="icon"><i class="ph-fill ph-check-circle"></i></span>
                      </a>
                    {{/foreach}}
                  {{/get}}
                {{/next_post}}
              </div>
            </div>
          </nav>

        </article>
      </main>

      {{!-- ==========================================
            RIGHT SIDEBAR: TOC & ADS
            (Stacks to the bottom on Mobile/Tablet)
      ========================================== --}}
      <aside class="column is-12-mobile is-12-tablet is-2-desktop">
        
        {{!-- Dynamic Table of Contents --}}
                  {{>"toc"}}

        
        {{!-- Ad Placeholder --}}
        <div class="box has-background-white-ter is-shadowless is-flex is-align-items-center is-justify-content-center has-text-centered py-6">
          <div>
            <p class="heading has-text-grey mb-1">Advertisement</p>
            <p class="is-size-7 has-text-grey-light">300 &times; 250</p>
          </div>
        </div>

      </aside>

    </div>
  </div>
</div>