{{!-- partials/post-lesson.hbs — individual lesson player --}}
<div class="ns-section--tight">
  <div class="container is-fluid">
    <div class="columns is-variable is-6">

      {{!-- ==========================================
            LEFT SIDEBAR: COURSE INDEX
      ========================================== --}}
      <aside class="column is-12-mobile is-12-tablet is-3-desktop">
        <div class="ns-glass-card p-4 mb-5" style="border-radius: 12px;">
          <div class="menu">
            <p class="menu-label is-size-7 has-text-weight-bold mb-3" style="letter-spacing: 0.08em;">
              <span class="icon is-small mr-1"><i class="ph ph-list-checks"></i></span>
              Course Lessons
            </p>
            <ul class="menu-list is-size-6">
              {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}" order="published_at asc" limit="100"}}
                {{#foreach posts}}
                  <li>
                    <a href="{{url}}" class="is-flex is-align-items-flex-start mb-1 py-2 px-3
                      {{#match id ../../id}}is-active{{/match}}"
                      style="border-radius: 8px; gap: 0.5rem;">
                      <span class="is-size-7 has-text-weight-light is-flex-shrink-0 mt-1">{{@number}}.</span>
                      <span>{{title}}</span>
                    </a>
                  </li>
                {{/foreach}}
              {{/get}}
            </ul>
          </div>
        </div>
      </aside>

      {{!-- ==========================================
            CENTER: MAIN LESSON CONTENT
      ========================================== --}}
      <main class="column is-12-mobile is-12-tablet is-7-desktop">
        <article>

          <header class="mb-6">
            <div class="tags mb-4" style="gap: 0.5rem;">
              <span class="tag ns-badge ns-badge--gradient is-medium is-rounded has-text-weight-bold">
                <span class="icon is-small mr-1"><i class="ph ph-graduation-cap"></i></span>
                Lesson
              </span>
              <span class="tag is-light is-rounded is-medium" style="opacity: 0.75;">
                <span class="icon is-small mr-1"><i class="ph ph-clock"></i></span>
                {{reading_time}}
              </span>
            </div>

            <h1 class="title is-2 is-size-3-mobile has-text-weight-bold mb-4 ns-fade-up" style="line-height: 1.2;">
              {{title}}
            </h1>

            {{#if custom_excerpt}}
              <p class="ns-lead mt-3 ns-fade-up ns-stagger-1">
                {{custom_excerpt}}
              </p>
            {{/if}}
          </header>

          {{#if feature_image}}
            <figure class="image mb-6 ns-scale-in" style="border-radius: 12px; overflow: hidden;">
              <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" style="object-fit: cover; width: 100%;">
            </figure>
          {{/if}}

          {{!-- Lesson Content --}}
          <div class="content is-medium gh-content js-toc-content">
            {{content}}
          </div>

          {{!-- Lesson Prev / Next Navigation --}}
          <nav class="columns is-mobile mt-6 pt-5" style="border-top: 1px solid rgba(128,128,128,0.15);" aria-label="Lesson navigation">
            <div class="column is-half">
              {{#prev_post in="primary_tag" filter="tag:hash-lesson"}}
                <a href="{{url}}" class="button is-light is-rounded has-text-weight-semibold is-fullwidth">
                  <span class="icon"><i class="ph ph-arrow-left"></i></span>
                  <span class="is-hidden-mobile">Previous Lesson</span>
                  <span class="is-hidden-tablet">Prev</span>
                </a>
              {{/prev_post}}
            </div>
            <div class="column is-half has-text-right">
              {{#next_post in="primary_tag" filter="tag:hash-lesson"}}
                <a href="{{url}}" class="button is-gradient is-rounded has-text-weight-bold is-fullwidth">
                  <span class="is-hidden-mobile">Next Lesson</span>
                  <span class="is-hidden-tablet">Next</span>
                  <span class="icon"><i class="ph ph-arrow-right"></i></span>
                </a>
              {{else}}
                {{!-- Last lesson: show Finish Course --}}
                {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
                  {{#foreach posts}}
                    <a href="{{url}}" class="button is-glow is-rounded has-text-weight-bold is-fullwidth">
                      <span class="is-hidden-mobile">Finish Course</span>
                      <span class="is-hidden-tablet">Finish</span>
                      <span class="icon"><i class="ph-fill ph-check-circle"></i></span>
                    </a>
                  {{/foreach}}
                {{/get}}
              {{/next_post}}
            </div>
          </nav>

        </article>
      </main>

      {{!-- ==========================================
            RIGHT SIDEBAR: TOC & ADS
      ========================================== --}}
      <aside class="column is-12-mobile is-12-tablet is-2-desktop">

        {{>"toc"}}

        <div class="ns-glass-card p-4 has-text-centered mt-4" style="border-radius: 10px; min-height: 260px; display: flex; align-items: center; justify-content: center;">
          <div>
            <p class="is-size-7 has-text-weight-semibold mb-1" style="opacity: 0.45; letter-spacing: 0.08em; text-transform: uppercase;">Advertisement</p>
            <p class="is-size-7" style="opacity: 0.35;">300 &times; 250</p>
          </div>
        </div>

      </aside>

    </div>
  </div>
</div>
