{{!-- post-lesson.hbs — Lesson reader.
     Embeds #gh-lesson-data so header/lesson.hbs JS
     builds the panel without any API calls. --}}

{{!-- ── Lesson data for header panel JS ──────────────── --}}
{{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}"
    limit="all" order="published_at asc" as |lessons|}}
<div id="gh-lesson-data" hidden aria-hidden="true">
    {{#foreach lessons}}
    <a href="{{url}}" data-id="{{id}}" data-slug="{{slug}}"{{#if (eq id @root.id)}} data-current="true"{{/if}}>{{title}}</a>
    {{/foreach}}
</div>
{{/get}}

{{!-- ── Main ─────────────────────────────────────────── --}}
<main id="site-main" class="site-main lesson-page">
<article class="lesson-article {{post_class}}">

    <nav class="lesson-breadcrumb gh-canvas" aria-label="{{t "Breadcrumb"}}">
        <a href="/courses/">{{t "Courses"}}</a>
        <i class="ph ph-caret-right" aria-hidden="true"></i>
        {{#if primary_tag}}<a href="/courses/{{primary_tag.slug}}/">{{primary_tag.name}}</a><i class="ph ph-caret-right" aria-hidden="true"></i>{{/if}}
        <span aria-current="page">{{title}}</span>
    </nav>

    <header class="lesson-header gh-canvas">
        <h1 class="lesson-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="lesson-excerpt lead">{{custom_excerpt}}</p>{{/if}}
        <div class="sfdc-flex sfdc-gap-md sfdc-items-center sfdc-mt-md">
            {{#if reading_time}}<span class="sfdc-text-sm sfdc-text-weak sfdc-flex sfdc-gap-xs sfdc-items-center">
                <i class="ph ph-clock" aria-hidden="true"></i>
                {{reading_time minute=(t "1 min") minutes=(t "% min")}}
            </span>{{/if}}
            <time class="sfdc-text-sm sfdc-text-weak" datetime="{{date format="YYYY-MM-DD"}}">
                {{t "Updated"}} {{date format="DD MMM YYYY"}}
            </time>
        </div>
    </header>

    {{#if feature_image}}
        <figure class="lesson-feature-image gh-canvas">
            <img srcset="{{img_url feature_image size="s"}} 300w,
                         {{img_url feature_image size="m"}} 600w,
                         {{img_url feature_image size="l"}} 1000w,
                         {{img_url feature_image size="xl"}} 2000w"
                 sizes="92vw"
                 src="{{img_url feature_image size="xl"}}"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                 loading="eager" />
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}

    <section class="gh-content gh-canvas lesson-content js-toc-content">{{content}}</section>

    {{!-- Mark complete + comments --}}
    <footer class="lesson-footer gh-canvas">
        <button class="btn btn-soft-success lesson-complete-btn" id="lesson-complete-btn"
                data-lesson-slug="{{slug}}" data-course-slug="{{primary_tag.slug}}"
                aria-pressed="false">
            <i class="ph ph-check-circle btn-icon" aria-hidden="true"></i>
            <span>{{t "Mark as complete"}}</span>
        </button>
        {{#if comments}}<section class="article-comments sfdc-mt-2xl">{{comments}}</section>{{/if}}
    </footer>

</article>
</main>

{{!-- ── Prev / Next nav ─────────────────────────────── --}}
<nav class="lesson-nav outer" aria-label="{{t "Lesson navigation"}}">
    <div class="lesson-nav__inner inner">
        {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}+published_at:<{{published_at}}"
            limit="1" order="published_at desc" as |prev_l|}}
            {{#foreach prev_l}}
                <a class="lesson-nav__card lesson-nav__card--prev" href="{{url}}" rel="prev">
                    <span class="lesson-nav__dir"><i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "Previous"}}</span>
                    <span class="lesson-nav__title">{{title}}</span>
                </a>
            {{else}}
                <a class="lesson-nav__card lesson-nav__card--prev" href="/courses/{{../primary_tag.slug}}/" rel="prev">
                    <span class="lesson-nav__dir"><i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "Course overview"}}</span>
                    <span class="lesson-nav__title">{{../primary_tag.name}}</span>
                </a>
            {{/foreach}}
        {{/get}}

        {{#get "posts" filter="tag:hash-lesson+primary_tag:{{primary_tag.slug}}+published_at:>{{published_at}}"
            limit="1" order="published_at asc" as |next_l|}}
            {{#foreach next_l}}
                <a class="lesson-nav__card lesson-nav__card--next" href="{{url}}" rel="next">
                    <span class="lesson-nav__dir">{{t "Next"}}<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                    <span class="lesson-nav__title">{{title}}</span>
                </a>
            {{else}}
                <a class="lesson-nav__card lesson-nav__card--next lesson-nav__card--done" href="/courses/{{../primary_tag.slug}}/">
                    <span class="lesson-nav__dir">{{t "Course complete!"}}<i class="ph ph-check-circle" aria-hidden="true"></i></span>
                    <span class="lesson-nav__title">{{t "Back to course"}}</span>
                </a>
            {{/foreach}}
        {{/get}}
    </div>
</nav>

<script>
(function(){
    var btn=document.getElementById('lesson-complete-btn');
    if(!btn) return;
    var slug=btn.dataset.lessonSlug, key='sfdc-complete-'+btn.dataset.courseSlug;
    function get(){ try{ return JSON.parse(localStorage.getItem(key)||'[]'); }catch(e){ return []; } }
    function set(l){ try{ localStorage.setItem(key,JSON.stringify(l)); }catch(e){} }
    function sync(done){
        var lbl=btn.querySelector('span');
        btn.setAttribute('aria-pressed',done);
        btn.classList.toggle('is-complete',done);
        if(lbl) lbl.textContent=done?'{{t "Completed!"}}':'{{t "Mark as complete"}}';
    }
    var l=get(); sync(l.indexOf(slug)!==-1);
    btn.addEventListener('click',function(){ var l=get(),i=l.indexOf(slug); if(i!==-1){l.splice(i,1);sync(false);}else{l.push(slug);sync(true);} set(l); });
})();
</script>
