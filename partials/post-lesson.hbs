{{!-- The course player. Context: a lesson post.

Finding the course is one query: the lesson's PRIMARY tag is the
course's public tag, and the course post's slug equals that tag's
slug — so "the post in the course collection carrying my primary
tag" is the parent, always.

Prev/next is {{prev_post}}/{{next_post}} with in="primary_tag",
which keeps the walk inside this course — pure Handlebars, no
script. The rail lists every lesson via the same query the
course page uses, so the two can never disagree. --}}

{{#contentFor "head"}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{t "Courses"}}", "item": "{{@site.url}}/courses/" },
        {{#primary_tag}}
        { "@type": "ListItem", "position": 2, "name": "{{name}}", "item": "{{@site.url}}/courses/{{slug}}/" },
        {{/primary_tag}}
        { "@type": "ListItem", "position": 3, "name": "{{title}}" }
    ]
}
</script>
{{/contentFor}}

{{!-- Five player layouts, chosen per-lesson with internal tags
(same convention as #blog-layout-* / #course-layout-*):

    #lesson-layout-right   curriculum rail on the right
    #lesson-layout-focus   no rail — collapsible contents, centered article
    #lesson-layout-cinema  dark hero card on the lesson header
    #lesson-layout-wide    narrow rail, article grows to the wide measure
    (none)                 classic — rail left, measured article

One markup shape; the class on .player is all that changes. --}}
<div class="player
    {{~#match (post_class) "~" "tag-hash-lesson-type-video"}} lesson-type-video{{/match}}
    {{~#match (post_class) "~" "tag-hash-lesson-layout-right"}} lesson-layout-right
    {{~else match (post_class) "~" "tag-hash-lesson-layout-focus"}} lesson-layout-focus
    {{~else match (post_class) "~" "tag-hash-lesson-layout-cinema"}} lesson-layout-cinema
    {{~else match (post_class) "~" "tag-hash-lesson-layout-wide"}} lesson-layout-wide
    {{~else}} lesson-layout-classic{{/match}}">

    {{!-- Curriculum rail --}}
    <aside class="player-rail">
        {{!-- The collapse handle straddles the rail's border, so it
        sits OUTSIDE the scrolling column — inside, the rail's own
        overflow clipped it in half. --}}
        {{> "rail-toggle"}}

        <div class="player-rail-scroll">
            {{#primary_tag}}
                {{#get "posts" filter="tag:hash-course+slug:{{slug}}" limit="1" as |courseposts|}}
                    {{#foreach courseposts}}
                        {{!-- The course card: cover on top, then the
                        name, then what the course is (lessons · length ·
                        level) and how far along this reader is. rail.js
                        fills the progress bar from the list below —
                        current row ÷ rows. --}}
                        <a class="player-rail-course" href="{{url}}">
                            <span class="player-rail-course-art">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="m"}}" alt="" loading="lazy" />
                                {{else}}
                                    {{> "thumb-placeholder" icon="graduation-cap"}}
                                {{/if}}
                            </span>
                            <span class="player-rail-course-copy">
                                <span class="kicker">{{> "icons/graduation-cap"}} {{t "Course"}}</span>
                                <h2>{{title}}</h2>
                                <span class="player-rail-course-meta">
                                    {{#get "posts" filter="tag:hash-lesson+tag:{{slug}}" limit="1" as |l total|}}
                                        <span>{{> "icons/play-circle"}} {{total.total}} {{t "lessons"}}</span>
                                    {{/get}}
                                    {{#foreach tags visibility="internal"}}
                                        {{#match slug "~^" "hash-course-duration-"}}{{#if description}}<span>{{> "icons/clock"}} {{description}}</span>{{/if}}{{/match}}
                                        {{#match slug "~^" "hash-duration-"}}{{#if description}}<span>{{> "icons/clock"}} {{description}}</span>{{/if}}{{/match}}
                                        {{#match slug "~^" "hash-course-level-"}}{{#if description}}<span>{{> "icons/signal"}} {{description}}</span>{{/if}}{{/match}}
                                    {{/foreach}}
                                </span>
                                <span class="player-rail-progress" data-rail-progress>
                                    <span class="player-rail-progress-bar"><i></i></span>
                                    <span class="player-rail-progress-label" data-rail-progress-label></span>
                                </span>
                            </span>
                        </a>
                    {{/foreach}}
                {{/get}}
            {{/primary_tag}}

            {{!-- Mobile: same list inside a collapsible --}}
            <details class="player-rail-toggle">
                <summary>
                    {{> "icons/list-icon"}}
                    {{t "Course contents"}}
                    <span class="chev">{{> "icons/chevron-down"}}</span>
                </summary>
                <div class="player-rail-body">
                    {{> "lesson-list" currentSlug=slug}}
                </div>
            </details>

            <div class="player-rail-list">
                {{> "lesson-list" currentSlug=slug}}
            </div>

        </div>
    </aside>

    {{!-- The lesson itself, beside its own outline. The outline
    column is what fills the dead space a single centred measure
    left on a wide screen; it collapses below 1200px (and in the
    layouts that already spend that side of the page — see
    _lesson.css). --}}
    <main id="site-main" class="player-main">
        <div class="player-columns">

        {{!-- Video lessons open with the player, like the training
        reader — the stage reveals itself only if there is an embed
        to lift into it (assets/js/reader-video.js). --}}
        {{#match (post_class) "~" "tag-hash-lesson-type-video"}}
            {{> "video-stage"}}
        {{/match}}

        <article class="player-article {{post_class}}">

            <header class="player-header">
                {{!-- Cinema layout: the lesson's own feature image
                sits behind the dark hero card. --}}
                {{#match (post_class) "~" "tag-hash-lesson-layout-cinema"}}
                    {{#if feature_image}}
                        <img class="player-header-bg" src="{{img_url feature_image size="l"}}" alt="" aria-hidden="true" loading="eager" />
                    {{/if}}
                {{/match}}
                <nav class="crumbs" aria-label="Breadcrumb">
                    <a href="{{@site.url}}/courses/">{{> "icons/graduation-cap"}} {{t "Courses"}}</a>
                    {{#primary_tag}}
                        {{> "icons/chevron-right"}}
                        <a href="{{@site.url}}/courses/{{slug}}/">{{name}}</a>
                    {{/primary_tag}}
                    {{> "icons/chevron-right"}}
                    <span aria-current="page">{{title}}</span>
                </nav>

                <h1>{{title}}</h1>

                {{#if custom_excerpt}}
                    <p class="player-header-lead">{{custom_excerpt}}</p>
                {{/if}}

                <div class="chips">
                    <span class="chip chip-type">{{> "lesson-type-icon"}}
                        {{#match (post_class) "~" "tag-hash-lesson-type-video"}}{{t "Video lesson"}}
                        {{~else match (post_class) "~" "tag-hash-lesson-type-quiz"}}{{t "Quiz"}}
                        {{~else match (post_class) "~" "tag-hash-lesson-type-audio"}}{{t "Audio lesson"}}
                        {{~else}}{{t "Article lesson"}}{{/match}}
                    </span>
                    {{> "duration-chip"}}
                    {{#if reading_time}}
                        <span class="chip">{{> "icons/clock"}} {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
                    {{/if}}
                    {{#match visibility "public"}}<span class="chip chip-free">{{t "Free"}}</span>{{else}}<span class="chip chip-accent">{{> "icons/lock"}} {{t "Members"}}</span>{{/match}}
                </div>
            </header>

            {{#if access}}
            <section class="gh-content">
                {{content}}
            </section>
            {{else}}
                {{!-- Members-only and this reader is outside: the locked
                surface instead of a truncated article. --}}
                {{> "reader-locked"}}
            {{/if}}

            <nav class="post-nav" aria-label="{{t "Lesson navigation"}}">
                {{#prev_post in="primary_tag"}}
                    <a class="post-nav-link post-nav-prev" href="{{url}}">
                        <span class="post-nav-label">{{> "icons/arrow-left"}} {{t "Previous lesson"}}</span>
                        <span class="post-nav-title">{{title}}</span>
                    </a>
                {{/prev_post}}
                {{#next_post in="primary_tag"}}
                    <a class="post-nav-link post-nav-next" href="{{url}}">
                        <span class="post-nav-label">{{t "Next lesson"}} {{> "icons/arrow-right"}}</span>
                        <span class="post-nav-title">{{title}}</span>
                    </a>
                {{/next_post}}
            </nav>

            {{#if comments}}
                <section class="post-comments">
                    {{comments}}
                </section>
            {{/if}}

        </article>

        <aside class="player-outline">
            {{!-- Same order as the training reader's sidebar: where
            am I in this video, what is on this page, who wrote it,
            the ask, and share last. --}}
            <div class="player-outline-sticky">
                {{> "widgets/chapters"}}

                <div class="widget widget-plain" data-toc-wrap>
                    <h4 class="widget-title">{{> "icons/list-icon"}} {{t "On this page"}}</h4>
                    <ul class="toc-list" data-toc></ul>
                </div>

                {{> "widgets/author"}}

                {{> "widgets/share-ask"}}

            </div>
        </aside>

        </div>
    </main>

</div>

{{> "lesson-bar"}}
