{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-lesson.hbs — Lesson player (full-width)
  3 columns: course nav + ad · lesson content + discussion · TOC + sticky ad.
  Course nav shows a % completion bar and collapses on mobile. Context: a
  #lesson post.
═══════════════════════════════════════════════════════════════════════════ --}}
<section class="w-full px-4 py-8 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[16rem_minmax(0,1fr)_15rem]">

    {{!-- Left: course nav (progress) + related/sponsor ad --}}
    <aside class="lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
      {{> "courses/lesson-nav"}}
      <div class="mt-6">{{> "ads/slot" format="square"}}</div>
    </aside>

    {{!-- Center: lesson content --}}
    <main role="main" class="min-w-0">
      <article class="mx-auto max-w-3xl">
        {{> "components/breadcrumb"}}
        <header class="mb-6">
          {{!-- Type · duration · access --}}
          <div class="mb-4 flex flex-wrap items-center gap-2">
            {{#has tag="#lesson-type-video"}}
              <span class="ns-lesson-type ns-lesson-type--video"><i class="ph-fill ph-play-circle" aria-hidden="true"></i>{{t "Video"}}</span>
              <span class="ns-lesson-chip"><i class="ph ph-clock" aria-hidden="true"></i>{{#foreach tags visibility="internal"}}{{#match slug "~^" "hash-video-duration-"}}{{description}}{{/match}}{{/foreach}}</span>
            {{else}}
              <span class="ns-lesson-type ns-lesson-type--article"><i class="ph ph-article" aria-hidden="true"></i>{{t "Article"}}</span>
              <span class="ns-lesson-chip"><i class="ph ph-clock" aria-hidden="true"></i>{{reading_time}}</span>
            {{/has}}
            {{#has tag="#preview"}}<span class="ns-curriculum__badge ns-curriculum__badge--preview"><i class="ph-fill ph-eye" aria-hidden="true"></i>{{t "Free preview"}}</span>
            {{else has tag="#paid"}}<span class="ns-price-tag ns-price-tag--paid"><i class="ph-fill ph-crown-simple" aria-hidden="true"></i>{{t "Members"}}</span>
            {{else has tag="#free"}}<span class="ns-price-tag ns-price-tag--free">{{t "Free"}}</span>{{/has}}
          </div>
          <h1 class="font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{title}}</h1>
          {{#if custom_excerpt}}<p class="mt-3 text-lg text-muted">{{custom_excerpt}}</p>{{else}}<p class="mt-3 text-sm text-muted">{{t "Article lesson"}}</p>{{/if}}
        </header>

        {{!-- Media: video poster for video lessons, else feature image --}}
        {{#has tag="#lesson-type-video"}}
          <div class="ns-video-poster ns-video-poster--lesson mb-8">
            {{#if feature_image}}<img src="{{img_url feature_image size="xl"}}" alt="{{title}}">{{else}}<span class="ns-video-poster__fallback" aria-hidden="true"></span>{{/if}}
            <span class="ns-video-poster__play"><i class="ph-fill ph-play" aria-hidden="true"></i></span>
          </div>
        {{else}}
          {{#if feature_image}}<img src="{{img_url feature_image size="xl"}}" alt="{{title}}" class="mb-8 w-full rounded-card object-cover shadow-card">{{/if}}
        {{/has}}

        {{!-- Members gate (locked, non-preview, signed out) --}}
        {{#has tag="#paid"}}{{#has tag="#preview"}}{{else}}{{#unless @member}}
          <div class="ns-lock-note mb-6">
            <i class="ph-fill ph-lock-simple" aria-hidden="true"></i>
            <div>
              <p class="font-bold">{{t "Members-only lesson"}}</p>
              <p class="text-sm">{{t "You're reading the preview. Sign in with a membership to unlock the full lesson."}}</p>
            </div>
            <a href="#/portal/signup" data-portal="signup" class="ns-btn ns-btn--primary ns-btn--sm shrink-0">{{t "Unlock"}}</a>
          </div>
        {{/unless}}{{/has}}{{/has}}

        {{!-- In-content ad --}}
        {{> "ads/slot" format="horizontal" slot="lesson-top"}}

        <div class="prose max-w-none gh-content">{{content}}</div>

        {{!-- Support CTA on free lessons --}}
        {{#has tag="#paid"}}{{else}}<div class="mt-10">{{> "components/lesson-support"}}</div>{{/has}}

        {{!-- Prev / next (continues to next lesson by order at track end) --}}
        <nav class="mt-10 grid grid-cols-2 gap-4 border-t border-border pt-6" aria-label="{{t "Lesson navigation"}}">
          <div>
            {{#prev_post in="primary_tag" filter="tag:hash-lesson"}}
              <a href="{{url}}" class="inline-flex w-full items-center justify-center gap-2 rounded-pill border border-border px-4 py-2.5 text-sm font-semibold transition hover:border-brand-500 hover:text-brand-600">
                <i class="ph ph-arrow-left" aria-hidden="true"></i><span>{{t "Previous"}}</span>
              </a>
            {{/prev_post}}
          </div>
          <div>
            {{#next_post in="primary_tag" filter="tag:hash-lesson"}}
              <a href="{{url}}" class="inline-flex w-full items-center justify-center gap-2 rounded-pill bg-brand-500 px-4 py-2.5 text-sm font-bold text-white shadow-brand transition hover:bg-brand-600">
                <span>{{t "Next"}}</span><i class="ph ph-arrow-right" aria-hidden="true"></i>
              </a>
            {{else}}
              {{!-- Last lesson of the course → finish (back to the course page) --}}
              {{#get "posts" filter="tag:hash-course+primary_tag:{{primary_tag.slug}}" limit="1"}}
                {{#foreach posts}}
                  <a href="{{url}}" class="inline-flex w-full items-center justify-center gap-2 rounded-pill bg-success px-4 py-2.5 text-sm font-bold text-white transition hover:opacity-90">
                    <span>{{t "Finish course"}}</span><i class="ph-fill ph-check-circle" aria-hidden="true"></i>
                  </a>
                {{else}}
                  <a href="/courses/" class="inline-flex w-full items-center justify-center gap-2 rounded-pill bg-success px-4 py-2.5 text-sm font-bold text-white transition hover:opacity-90">
                    <span>{{t "Finish course"}}</span><i class="ph-fill ph-check-circle" aria-hidden="true"></i>
                  </a>
                {{/foreach}}
              {{/get}}
            {{/next_post}}
          </div>
        </nav>

        {{!-- Author box --}}
        <div class="mt-10">{{> "components/author-box"}}</div>

        {{!-- Discussion (comments) --}}
        {{#if @site.comments_enabled}}
          <section class="mt-12 border-t border-border pt-8" aria-label="{{t "Discussion"}}">
            <h2 class="mb-4 flex items-center gap-2 font-heading text-xl font-extrabold">
              <i class="ph ph-chat-circle-text text-brand-500" aria-hidden="true"></i>{{t "Discussion"}}
            </h2>
            {{comments title=""}}
          </section>
        {{/if}}
      </article>
    </main>

    {{!-- Right rail: TOC + sticky sponsor --}}
    <aside class="hidden lg:block">
      <div class="sticky top-20 space-y-6">
        {{> "components/toc"}}
        {{> "ads/slot" format="rail"}}
      </div>
    </aside>
  </div>
</section>
