{{!-- ════════════════════════════════════════════════════════════════════════
  partials/jsonld/graph.hbs — ONE @graph JSON-LD block for the whole page
  ----------------------------------------------------------------------------
  Emits a single <script type="application/ld+json"> holding a @graph array of
  linked nodes (the Yoast/RankMath pattern Google prefers). The site-wide base
  nodes (owner · website · navigation) always emit. Per-page nodes append after
  the base (each per-page partial STARTS with a comma). Live now: Course (+
  CourseInstance, hasPart→lessons) for #course posts, and LearningResource (+
  VideoObject for #lesson-type-video) for #lesson posts. Other page types are
  scaffolded below and still blank.

  Included in default.hbs <head> BEFORE {{ghost_head}}. It is additive to the
  JSON-LD Ghost already emits (harmless duplication). Use double-stache only
  here (HTML-escapes quotes → JSON-safe); never triple-stache. Validate the
  output with Google's Rich Results Test after any change.

  Guide: see the JSON-LD @graph implementation notes (§4 for per-page types).
═══════════════════════════════════════════════════════════════════════════ --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {{> "jsonld/base"}}
    {{!-- Per-page nodes (each partial starts with a comma). --}}
    {{#is "post"}}{{#post}}{{#has tag="#course"}}{{> "jsonld/course/index"}}{{/has}}{{#has tag="#lesson"}}{{> "jsonld/course/lesson"}}{{/has}}{{#has tag="#training-content"}}{{> "jsonld/training/lesson"}}{{/has}}{{/post}}{{/is}}
    {{!-- /training/ and /training/{section}/ are CUSTOM ROUTES, so {{#is "post"}}
         never matches them and their nodes can't join this graph. They emit
         their own ld+json from jsonld/training/index.hbs and jsonld/training/section.hbs.
         Still blank: #blog, documentation, pages, collections. --}}
  ]
}
</script>
