{{!-- ════════════════════════════════════════════════════════════════════════
  jsonld/training-section.hbs — one section at /training/{section}/, as a Course
  that isPartOf the training, with every lesson in it as hasPart.

  Its own <script> for the same reason as jsonld/training.hbs.
  Context here is the section POST (tagged #training-section); its slug equals
  its primary tag's slug, which is what the lesson query below filters on.
═══════════════════════════════════════════════════════════════════════════ --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Course",
      "@id": "{{url absolute="true"}}#section",
      "name": "{{title}}",
      {{#if custom_excerpt}}"description": "{{custom_excerpt}}",{{/if}}
      "url": "{{url absolute="true"}}",
      {{#if primary_tag.feature_image}}"image": "{{primary_tag.feature_image}}",{{else}}{{#if feature_image}}"image": "{{feature_image}}",{{/if}}{{/if}}
      "provider": { "@id": "{{@site.url}}/#owner" },
      "inLanguage": "{{@site.locale}}",
      "isPartOf": { "@id": "{{@site.url}}/training/#course" },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "online"
      },
      "hasPart": [
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50"}}
          {{#foreach posts}}{{#unless @first}},{{/unless}}{
            "@type": "LearningResource",
            "@id": "{{url absolute="true"}}#lesson",
            "name": "{{title}}",
            "url": "{{url absolute="true"}}",
            "position": {{@number}},
            "learningResourceType": "{{#has tag="#training-video"}}Video{{else has tag="#training-exercise"}}Exercise{{else has tag="#training-quiz"}}Quiz{{else has tag="#training-article"}}Article{{else}}Article{{/has}}",
            "isAccessibleForFree": {{#has visibility="public"}}true{{else}}false{{/has}}
          }{{/foreach}}
        {{/get}}
      ]
    }
  ]
}
</script>
