{{!-- A shop card — a digital asset: ebook, notes, theme, kit.
Context: a shop post (include tags). The price is the DESCRIPTION
of an internal #shop-price-* tag (never parsed from the slug);
#shop-free renders the free chip instead. --}}

<article class="card product-card" data-filter-item
    {{~#foreach tags visibility="internal"~}}
        {{~#match slug "~^" "hash-shop-price-"}} data-sprice="{{slug}}" data-sprice-label="{{description}}"{{/match~}}
        {{~#match slug "hash-shop-free"}} data-sprice="{{slug}}" data-sprice-label="Free"{{/match~}}
    {{~/foreach~}}>

    <div class="card-media">
        {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}"
                srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w"
                sizes="(max-width: 700px) 92vw, 400px"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy" />
        {{else}}
            {{> "thumb-placeholder" icon="gift"}}
        {{/if}}
        <div class="chips">
            {{#foreach tags visibility="internal"}}
                {{#match slug "~^" "hash-shop-price-"}}
                    {{#if description}}<span class="chip chip-price">{{description}}</span>{{/if}}
                {{/match}}
                {{#match slug "hash-shop-free"}}<span class="chip chip-free">{{t "Free"}}</span>{{/match}}
            {{/foreach}}
            {{#if featured}}<span class="chip chip-featured">{{> "icons/fire"}} {{t "Featured"}}</span>{{/if}}
        </div>
    </div>

    <div class="card-body">
        <h3 class="card-title"><a class="card-link" href="{{url}}">{{title}}</a></h3>

        {{#if custom_excerpt}}
            <p class="card-excerpt">{{custom_excerpt}}</p>
        {{else if excerpt}}
            <p class="card-excerpt">{{excerpt words="22"}}</p>
        {{/if}}

        <div class="card-meta">
            <span class="product-card-cta">{{> "icons/gift"}} {{t "View item"}} {{> "icons/arrow-right"}}</span>
        </div>
    </div>

</article>
