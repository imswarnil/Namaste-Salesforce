{{!-- Platform features — what makes this different, not a
curriculum. Same .path-step grammar as the old training-path
partial it replaced (numbered node, art tile, name, meta, start
line), but the four steps are fixed copy about the PLATFORM
itself: it ships something real, it mirrors the job, it teaches
the concepts that outlive any one tool, and it's fully open
source. Training content belongs to /training and the "Follow
the path, live" section above — this one is the pitch. --}}

<a class="path-step" href="{{@site.url}}/courses/">
    <span class="path-step-num" aria-hidden="true"></span>
    <span class="path-step-art is-icon" aria-hidden="true">{{> "icons/rocket"}}</span>
    <strong class="path-step-name">{{t "Ships something real"}}</strong>
    <span class="path-step-meta">{{t "Not just theory"}}</span>
    <span class="path-step-start">{{> "icons/play-circle"}} {{t "Every course ends in your own Developer Edition org"}}</span>
</a>

<a class="path-step" href="{{@site.url}}/training/">
    <span class="path-step-num" aria-hidden="true"></span>
    <span class="path-step-art is-icon" aria-hidden="true">{{> "icons/layers"}}</span>
    <strong class="path-step-name">{{t "Mirrors the actual job"}}</strong>
    <span class="path-step-meta">{{t "Live, modular training"}}</span>
    <span class="path-step-start">{{> "icons/play-circle"}} {{t "Paths that grow as the platform does"}}</span>
</a>

<a class="path-step" href="{{@site.url}}/blog/">
    <span class="path-step-num" aria-hidden="true"></span>
    <span class="path-step-art is-icon" aria-hidden="true">{{> "icons/compass"}}</span>
    <strong class="path-step-name">{{t "Concepts, not just clicks"}}</strong>
    <span class="path-step-meta">{{t "Tools change, this doesn't"}}</span>
    <span class="path-step-start">{{> "icons/play-circle"}} {{t "Sales cycles, lead capture, GTM automation, AI"}}</span>
</a>

<a class="path-step" href="{{@site.url}}/projects/">
    <span class="path-step-num" aria-hidden="true"></span>
    <span class="path-step-art is-icon" aria-hidden="true">{{> "icons/github"}}</span>
    <strong class="path-step-name">{{t "100% open source"}}</strong>
    <span class="path-step-meta">{{t "Nothing hidden"}}</span>
    <span class="path-step-start">{{> "icons/play-circle"}} {{t "Every lesson, snippet and prompt is a post you can read"}}</span>
</a>
