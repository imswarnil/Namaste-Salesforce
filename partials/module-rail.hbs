{{!-- The ordered section list for ONE training module, course-player
grammar (mirrors lesson-list.hbs exactly, module-scoped instead of
course-scoped). Rendered twice (desktop rail + mobile collapsible).

Explicit params instead of {{#primary_tag}} because the two callers
sit in different contexts: on a #training page the module is the
primary tag, but on the #module overview page itself the module
IS the post (its own slug equals the tag's slug) — so both callers
just pass moduleSlug/moduleName/moduleImage directly.

Params: moduleSlug, moduleName, moduleImage, currentSlug. --}}
{{#> "with-this" moduleSlug=moduleSlug moduleName=moduleName moduleImage=moduleImage currentSlug=currentSlug}}
    <a class="player-rail-course" href="{{@site.url}}/training/{{moduleSlug}}/">
        {{#if moduleImage}}
            <img class="player-rail-course-art" src="{{img_url moduleImage size="s"}}" alt="" loading="lazy" />
        {{/if}}
        <span class="player-rail-course-copy">
            <span class="kicker">{{> "icons/layers"}} {{t "Module"}}</span>
            <h2>{{moduleName}}</h2>
        </span>
    </a>

    {{#get "posts" filter="tag:hash-training+tag:{{moduleSlug}}" order="published_at asc" limit="100" include="tags" as |sections total|}}
        <span class="player-rail-count">{{total.total}} {{t "sections"}}</span>
        <ol class="player-list">
            <li class="{{#match ../moduleSlug ../currentSlug}}is-current{{/match}}">
                <a href="{{@site.url}}/training/{{../moduleSlug}}/"{{#match ../moduleSlug ../currentSlug}} aria-current="page"{{/match}}>
                    <span>{{t "Module overview"}}</span>
                    {{> "icons/map-icon"}}
                </a>
            </li>
            {{#foreach sections}}
                <li class="{{#match slug ../../currentSlug}}is-current{{/match}}">
                    <a href="{{url}}"{{#match slug ../../currentSlug}} aria-current="page"{{/match}}>
                        <span>{{title}}</span>
                        {{> "lesson-type-icon"}}
                    </a>
                </li>
            {{/foreach}}
        </ol>
    {{/get}}

    {{!-- Every OTHER module, collapsed — the single-module rail
    lost this when it stopped being a full all-modules accordion;
    it's back as a fold so a reader can still cross into another
    module without leaving the page, just not expanded by default. --}}
    <div class="player-rail-others">
        <span class="player-rail-others-label">{{t "Other modules"}}</span>
        {{#get "tags" filter="visibility:public" order="slug asc" limit="30" as |otherTags|}}
            {{#foreach otherTags}}
                {{~#match slug ../../moduleSlug}}{{else}}
                    {{#> "with-this" oSlug=slug oName=name}}
                        {{#get "posts" filter="tag:hash-training+tag:{{oSlug}}" order="published_at asc" limit="100" as |oSections|}}
                            {{#if oSections}}
                                <details class="rail-module">
                                    <summary>
                                        <span class="rail-module-ico" aria-hidden="true">{{> "icons/layers"}}</span>
                                        <span>{{../oName}}</span>
                                        {{> "icons/chevron-down"}}
                                    </summary>
                                    <ol class="player-list">
                                        <li><a href="{{@site.url}}/training/{{../oSlug}}/"><span>{{t "Module overview"}}</span>{{> "icons/map-icon"}}</a></li>
                                        {{#foreach oSections}}
                                            <li><a href="{{url}}"><span>{{title}}</span>{{> "lesson-type-icon"}}</a></li>
                                        {{/foreach}}
                                    </ol>
                                </details>
                            {{/if}}
                        {{/get}}
                    {{/with-this}}
                {{/match~}}
            {{/foreach}}
        {{/get}}
    </div>
{{/with-this}}
