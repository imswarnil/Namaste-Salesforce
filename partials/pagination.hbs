{{!-- Pagination --}}
<nav class="ns-section--tight" role="navigation" aria-label="pagination">
  <div class="is-flex is-justify-content-center is-align-items-center" style="gap: 0.5rem;">

    {{#if prev}}
      <a class="button is-rounded has-text-weight-semibold ns-fade-in" href="{{page_url prev}}">
        <span class="icon is-small"><i class="ph ph-arrow-left"></i></span>
        <span>{{t "Newer"}}</span>
      </a>
    {{/if}}

    <span class="button is-rounded is-gradient has-text-weight-bold is-static">
      {{t "Page {page} of {pages}" page=page pages=pages}}
    </span>

    {{#if next}}
      <a class="button is-rounded has-text-weight-semibold ns-fade-in" href="{{page_url next}}">
        <span>{{t "Older"}}</span>
        <span class="icon is-small"><i class="ph ph-arrow-right"></i></span>
      </a>
    {{/if}}

  </div>
</nav>
