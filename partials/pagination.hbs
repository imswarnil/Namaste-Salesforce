{{!-- partials/pagination.hbs — Newer/Older pager (context: {{pagination}})
     Uses the .ns-pager COMPONENT (2-components/pagination.css). --}}
<nav class="ns-pager mx-auto mt-12 max-w-6xl px-4" role="navigation" aria-label="Pagination">

  {{#if prev}}
    <a class="ns-pager__link" href="{{page_url prev}}" rel="prev">
      <i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "Newer"}}
    </a>
  {{/if}}

  <span class="ns-pager__count">
    {{t "Page {page} of {pages}" page=page pages=pages}}
  </span>

  {{#if next}}
    <a class="ns-pager__link" href="{{page_url next}}" rel="next">
      {{t "Older"}}<i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  {{/if}}

</nav>
