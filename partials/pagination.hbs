{{!-- Overrides Ghost's default pagination markup. --}}
<nav class="pagination" role="navigation" aria-label="{{t "Pagination"}}">
    {{#if prev}}
        <a href="{{page_url prev}}" rel="prev">{{> "icons/arrow-left"}} {{t "Newer"}}</a>
    {{/if}}
    <span class="pagination-count">{{t "Page"}} {{page}} {{t "of"}} {{pages}}</span>
    {{#if next}}
        <a href="{{page_url next}}" rel="next">{{t "Older"}} {{> "icons/arrow-right"}}</a>
    {{/if}}
</nav>
