{{!-- One prev/next card: the post's own image (or the branded
placeholder), the direction line, the title. Rendered INSIDE a
prev_post / next_post block — or any block whose context is the
post the card points at — so url, title and feature_image are the
target's. Params:
    dir    "prev" | "next"  — picks the arrow and the side the image sits on
    label  the small line over the title, already translated
    icon   placeholder glyph when the post has no image (thumb-placeholder names) --}}
<a class="post-nav-link post-nav-{{dir}}" href="{{url}}" rel="{{dir}}">
    <span class="post-nav-thumb" aria-hidden="true">
        {{#if feature_image}}
            <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy" decoding="async" />
        {{else}}
            {{> "thumb-placeholder" icon=icon}}
        {{/if}}
    </span>
    <span class="post-nav-body">
        <span class="post-nav-label">
            {{~#match dir "prev"}}{{> "icons/arrow-left"}} {{/match~}}
            {{label}}
            {{~#match dir "next"}} {{> "icons/arrow-right"}}{{/match~}}
        </span>
        <span class="post-nav-title">{{title}}</span>
    </span>
</a>
