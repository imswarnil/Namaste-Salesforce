{{!-- cards/documentation.hbs — Documentation page card. Minimal: no image, icon + title + excerpt + updated date. --}}
<div class="post-card-content card-doc-content">
    <a class="post-card-content-link" href="{{url}}">

        <div class="card-doc-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>

        <div class="card-doc-body">
            {{#primary_tag}}<span class="card-doc-category">{{name}}</span>{{/primary_tag}}
            <h2 class="post-card-title card-doc-title">{{title}}</h2>
            {{#if excerpt}}<p class="post-card-excerpt card-doc-excerpt">{{excerpt}}</p>{{/if}}
        </div>

        <svg class="card-doc-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>

    </a>

    <footer class="post-card-meta card-doc-meta">
        <time class="post-card-meta-date" datetime="{{date format="YYYY-MM-DD"}}">
            {{t "Updated"}} {{date format="DD MMM YYYY"}}
        </time>
        {{#if reading_time}}
            <span class="post-card-meta-sep" aria-hidden="true">·</span>
            <span class="post-card-meta-length">{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
        {{/if}}
    </footer>
</div>
