{{!-- course-card — a course in a catalogue, on NSDS's .ns-ccard.

     The lesson count comes from a {{#get}} on the course's own tag rather
     than from a field, because Ghost has no "lessons" relation — a course IS
     a tag and its lessons are the posts carrying it. `limit="1"` keeps it to
     a count query; {{pagination.total}} is the number wanted, not the rows. --}}
<div class="ns-card ns-ccard {{post_class}}">

    <span class="ns-ccard__mediawrap">
        {{#if feature_image}}
            <a class="ns-card__media" href="{{url}}" tabindex="-1" aria-hidden="true">
                {{> "media" src=feature_image alt="" decorative=true
                            sizes="(min-width: 64rem) 20rem, 100vw"}}
            </a>
        {{/if}}
        {{!-- .sp-optional hides itself when the partial produced nothing —
              see the :empty rule in ghost/content.css. Same technique as the
              duration fallback, and for the same reason: Handlebars cannot
              ask whether a partial output anything. --}}
        <span class="ns-tag ns-ccard__level sp-optional">{{~> "internal/level"~}}</span>
    </span>

    <div class="ns-card__body">
        <span class="ns-card__kicker">// {{t "Course"}}</span>
        <a class="ns-card__link" href="{{url}}"><span class="ns-card__title">{{title}}</span></a>
        {{#if excerpt}}<p class="ns-card__text">{{excerpt}}</p>{{/if}}

        <span class="ns-ccard__meta">
            {{#primary_tag}}
                {{#get "posts" filter="tag:{{slug}}+tag:hash-lesson" limit="1" as |lessons|}}
                    <span>{{plural pagination.total empty=(t "No lessons yet") singular=(t "% lesson") plural=(t "% lessons")}}</span>
                {{/get}}
            {{/primary_tag}}
            <span class="sp-duration sp-optional">{{~> "internal/duration"~}}</span>
        </span>
    </div>

</div>
