{{!--
    cards/default.hbs — Standard article card
    Inner content only. <article> wrapper is in post-card.hbs.
    Used as fallback for any post not matching a collection.
--}}

{{!-- Feature image --}}
{{#if feature_image}}
    <a class="post-card-image-link" href="{{url}}" aria-hidden="true" tabindex="-1">
        <img
            class="post-card-image"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(max-width: 1000px) 400px, 800px"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy"
        />
        {{!-- Access overlay --}}
        {{#unless access}}
            {{^has visibility="public"}}
                <div class="post-card-access">
                    {{> "icons/lock"}}
                    {{#has visibility="members"}}{{t "Members only"}}{{else}}{{t "Paid only"}}{{/has}}
                </div>
            {{/has}}
        {{/unless}}
    </a>
{{/if}}

<div class="post-card-content">
    <a class="post-card-content-link" href="{{url}}">

        <header class="post-card-header">
            {{!-- Tag + featured --}}
            <div class="post-card-tags">
                {{#primary_tag}}
                    <a class="post-card-primary-tag" href="{{url}}" onclick="event.stopPropagation()">{{name}}</a>
                {{/primary_tag}}
                {{#if featured}}
                    <span class="post-card-featured">
                        {{> "icons/fire"}} {{t "Featured"}}
                    </span>
                {{/if}}
            </div>

            {{!-- Title --}}
            <h2 class="post-card-title">
                {{#unless access}}
                    {{^has visibility="public"}}
                        {{#unless feature_image}}{{> "icons/lock"}}{{/unless}}
                    {{/has}}
                {{/unless}}
                {{title}}
            </h2>
        </header>

        {{!-- Excerpt --}}
        {{#if excerpt}}
            <p class="post-card-excerpt">{{excerpt}}</p>
        {{/if}}

    </a>

    {{!-- Meta row --}}
    <footer class="post-card-meta">
        <time class="post-card-meta-date" datetime="{{date format="YYYY-MM-DD"}}">
            {{date format="DD MMM YYYY"}}
        </time>
        {{#if reading_time}}
            <span class="post-card-meta-sep" aria-hidden="true">·</span>
            <span class="post-card-meta-length">
                {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
            </span>
        {{/if}}
        {{#if @site.comments_enabled}}
            {{comment_count}}
        {{/if}}
    </footer>
</div>
