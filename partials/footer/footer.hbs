{{!-- ══════════════════════════════════════════════════════════════════════
     footer — ported from NSDS's .ns-footer__grid + .ns-footer__bar.
     ------------------------------------------------------------------------
     Four things, in the order someone actually needs them: what this site is,
     where to go, how to follow it, and the legal line.

     ── THE LINKS ARE GHOST'S SECONDARY NAVIGATION ───────────────────────────
     Admin → Settings → Navigation → Secondary. Same "-" convention as the top
     bar, but here a child is simply an indented link: a footer is already a
     list of everything, so nesting it behind a disclosure would hide the one
     thing a footer is for.

     Every destination that lives inside a dropdown in the TOP bar should also
     appear here. That is what keeps the bar's JavaScript optional rather than
     load-bearing.

     ── IT IS PINNED TO THE BOTTOM ───────────────────────────────────────────
     Not by this file — by the page shell in assets/css/theme/shell.css,
     which makes <body> a column and lets <main> grow. A short page (a 404, an
     empty tag) otherwise leaves the footer floating mid-viewport with white
     space under it, which reads as a page that failed to load.
     ══════════════════════════════════════════════════════════════════════ --}}
<footer class="ns-footer">

    <div class="ns-footer__grid">

        <div class="ns-footer__col">
            <a class="ns-topnav__brand" href="{{@site.url}}">
                {{#if @site.icon}}<img src="{{img_url @site.icon size="xs"}}" alt="">{{/if}}
                <span class="ns-topnav__brand-name">{{@site.title}}</span>
            </a>
            <p class="ns-footer__blurb">
                {{#if @site.description}}{{@site.description}}{{else}}{{t "Learn Salesforce properly — courses, a step-by-step roadmap and working code, written in the open."}}{{/if}}
            </p>
        </div>

        {{#if @site.secondary_navigation}}
            <div class="ns-footer__col">
                <p class="ns-footer__head">{{t "Explore"}}</p>
                {{navigation type="secondary" variant="footer"}}
            </div>
        {{/if}}

        <div class="ns-footer__col">
            <p class="ns-footer__head">{{t "Follow along"}}</p>
            {{> "footer/social"}}
        </div>

        {{#if @site.members_enabled}}
            {{> "footer/subscribe"}}
        {{/if}}
    </div>

    <div class="ns-footer__bar">
        <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
        <span class="ns-footer__spacer"></span>
        <a href="{{@site.url}}/archive/rss/">RSS</a>
        <a href="https://ghost.org/" rel="noopener">{{t "Published with Ghost"}}</a>
    </div>
</footer>
