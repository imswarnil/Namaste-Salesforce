{{!-- ══════════════════════════════════════════════════════════════════════
     social — every handle the site owner has filled in.
     ------------------------------------------------------------------------
     {{#social_accounts @site}} is GHOST'S, not ours: it walks X, Facebook,
     LinkedIn, Bluesky, Threads, Mastodon, TikTok, YouTube and Instagram in a
     fixed order, yields only the ones with a username set, and builds the
     href. So the handles are edited in Admin → Settings → Social accounts and
     this file never needs touching to add one.

     ⚠ GITHUB IS NOT ON GHOST'S LIST, so it comes from a custom theme setting
     instead (Admin → Design → Site-wide → GitHub URL). That is the only
     handle this theme has to carry itself.

     Brand marks are FILLED and drawn to their owner's outline — see
     partials/icons/README.md. The four platforms without one fall back to a
     globe rather than a wrong mark; a misdrawn logo is worse than a generic
     one. Draw them properly and add a case here.

     Takes a class:  {{> "footer/social" class="ns-footer__social"}}
     ══════════════════════════════════════════════════════════════════════ --}}
<ul class="{{#if class}}{{class}}{{else}}ns-footer__social{{/if}}">
    {{#social_accounts @site}}
        <li><a href="{{href}}" rel="me noopener" target="_blank" aria-label="{{name}}{{#if username}} — {{username}}{{/if}}">
            {{~#match type "x"}}{{> "icons/brand-x"}}
            {{~else match type "linkedin"}}{{> "icons/brand-linkedin"}}
            {{~else match type "youtube"}}{{> "icons/brand-youtube"}}
            {{~else match type "instagram"}}{{> "icons/brand-instagram"}}
            {{~else match type "facebook"}}{{> "icons/brand-facebook"}}
            {{~else}}{{> "icons/globe"}}
            {{~/match~}}
        </a></li>
    {{/social_accounts}}

    {{#if @custom.github_url}}
        <li><a href="{{@custom.github_url}}" rel="me noopener" target="_blank" aria-label="GitHub">
            {{~> "icons/brand-github"~}}
        </a></li>
    {{/if}}

    <li><a href="{{@site.url}}/archive/rss/" aria-label="{{t "RSS feed"}}">{{~> "icons/rss"~}}</a></li>
</ul>
