{{!-- footer-lesson.hbs — minimal footer for the distraction-free lesson/module
     player. Just a slim credits strip; the course player header owns navigation. --}}
<footer class="border-t border-border bg-surface-sunken">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-4 py-4 text-sm text-muted sm:flex-row sm:px-6">
    <a href="{{@site.url}}" class="flex items-center gap-2 font-heading font-bold text-ink">
      {{#if @site.logo}}<img src="{{@site.logo}}" alt="" class="h-5 w-auto">{{/if}}{{@site.title}}
    </a>
    <p class="flex items-center gap-1.5"><i class="ph ph-git-branch" aria-hidden="true"></i>{{t "Open source"}} · &copy; {{date format="YYYY"}}</p>
    <a href="/courses/" class="inline-flex items-center gap-1.5 font-semibold hover:text-brand-600 dark:hover:text-brand-300">
      <i class="ph ph-squares-four" aria-hidden="true"></i>{{t "All courses"}}
    </a>
  </div>
</footer>
