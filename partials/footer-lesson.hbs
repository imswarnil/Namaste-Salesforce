{{!-- footer-lesson.hbs — minimal footer for the distraction-free lesson/module
     player: a full-width 90px sponsored/ad band, then a slim credits strip.
     The course player header owns navigation. --}}
<div class="w-full border-t border-border bg-surface-sunken py-4">
  {{!-- min-h, not h: mobile ad units are typically 320×100 or 300×250, so a
       hard 90px band either clipped them or left dead space. --}}
  <div class="mx-auto flex min-h-[100px] max-w-[90rem] items-center justify-center px-4 sm:min-h-[90px] sm:px-6">
    {{> "ads/leaderboard"}}
  </div>
</div>
<footer class="border-t border-border bg-surface-sunken">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-4 py-4 text-sm text-muted sm:flex-row sm:px-6">
    <a href="{{@site.url}}" class="flex items-center gap-2 font-heading font-bold text-ink">
      {{#if @site.logo}}<img src="{{@site.logo}}" alt="" class="h-5 w-auto">{{/if}}{{@site.title}}
    </a>
    <p class="flex items-center gap-1.5"><i class="ph ph-git-branch" aria-hidden="true"></i>{{t "Open source"}} · &copy; {{date format="YYYY"}}</p>
    {{!-- Context-aware collection link: training modules go back to the training list --}}
    {{#has tag="#training-content"}}
      <a href="/training/" class="inline-flex items-center gap-1.5 font-semibold hover:text-brand-600 dark:hover:text-brand-300">
        <i class="ph ph-map-trifold" aria-hidden="true"></i>{{t "All training"}}
      </a>
    {{else}}
      <a href="/courses/" class="inline-flex items-center gap-1.5 font-semibold hover:text-brand-600 dark:hover:text-brand-300">
        <i class="ph ph-squares-four" aria-hidden="true"></i>{{t "All courses"}}
      </a>
    {{/has}}
  </div>
</footer>
