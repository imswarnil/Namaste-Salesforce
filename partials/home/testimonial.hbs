{{!-- home/testimonial.hbs — learner quote. Params: quote, name, role --}}
<figure class="flex h-full flex-col rounded-card border border-border bg-surface-raised p-6">
  <div class="flex gap-0.5 text-amber-400" aria-hidden="true">
    {{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}
  </div>
  <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-muted">&ldquo;{{quote}}&rdquo;</blockquote>
  <figcaption class="mt-4 flex items-center gap-3">
    <span class="ns-chip h-9 w-9 rounded-full text-base">
      {{> "icons/user" class="h-4 w-4"}}
    </span>
    <div>
      <p class="text-sm font-bold">{{name}}</p>
      <p class="text-xs text-muted">{{role}}</p>
    </div>
  </figcaption>
</figure>
