{{!-- home/testimonial.hbs — learner quote. Params: quote, name, role
     Uses the .ns-quote COMPONENT (2-components/quote.css). --}}
<figure class="ns-quote">
  <div class="ns-quote__stars" aria-hidden="true">
    {{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}
  </div>
  <blockquote class="ns-quote__body">&ldquo;{{quote}}&rdquo;</blockquote>
  <figcaption class="ns-quote__author">
    <span class="ns-chip ns-chip--sm ns-chip--round">
      {{> "icons/user" class="h-4 w-4"}}
    </span>
    <div>
      <p class="ns-quote__name">{{name}}</p>
      <p class="ns-quote__role">{{role}}</p>
    </div>
  </figcaption>
</figure>
