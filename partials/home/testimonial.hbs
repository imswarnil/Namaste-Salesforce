{{!-- home/testimonial.hbs — learner quote. Params: quote, name, role
     Uses the .ns-testimonial COMPONENT (2-components/testimonial.css). --}}
<figure class="ns-testimonial">
  <div class="ns-testimonial__stars" aria-hidden="true">
    {{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}{{> "icons/star" class="h-4 w-4"}}
  </div>
  <blockquote class="ns-testimonial__body">&ldquo;{{quote}}&rdquo;</blockquote>
  <figcaption class="ns-testimonial__author">
    <span class="ns-chip ns-chip--sm ns-chip--round">
      {{> "icons/user" class="h-4 w-4"}}
    </span>
    <div>
      <p class="ns-testimonial__name">{{name}}</p>
      <p class="ns-testimonial__role">{{role}}</p>
    </div>
  </figcaption>
</figure>
