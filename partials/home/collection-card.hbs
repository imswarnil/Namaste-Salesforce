{{!-- home/collection-card.hbs — links to a content section ("everything in one
     place"). Params: href, icon (Phosphor class), title, body, cta. --}}
<a href="{{href}}" class="js-spotlight group relative flex h-full flex-col overflow-hidden rounded-card border border-border bg-surface-raised p-6 shadow-card transition hover:-translate-y-1 hover:shadow-raised">
  <span class="relative flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500/15 to-brand-700/15 text-2xl text-brand-600 dark:text-brand-300">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <h3 class="relative mt-4 font-heading text-lg font-bold">{{title}}</h3>
  <p class="relative mt-1 flex-1 text-sm leading-relaxed text-muted">{{body}}</p>
  <span class="relative mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 dark:text-brand-300">
    {{#if cta}}{{cta}}{{else}}{{t "Explore"}}{{/if}}<i class="ph ph-arrow-right transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
  </span>
</a>
