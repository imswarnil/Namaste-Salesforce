{{!-- home/timeline-item.hbs — a milestone on the mission timeline.
     Params: year, title, body. Render inside an <ol class="ns-timeline">. --}}
<li class="relative pl-12">
  <span class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-white ring-4 ring-surface">
    <i class="ph-fill ph-flag-banner-fold text-sm" aria-hidden="true"></i>
  </span>
  <p class="ns-label">{{year}}</p>
  <h3 class="mt-0.5 font-heading font-bold">{{title}}</h3>
  <p class="mt-1 text-sm leading-relaxed text-muted">{{body}}</p>
</li>
