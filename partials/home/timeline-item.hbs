{{!-- home/timeline-item.hbs — one milestone.

     The design system's `.ns-timeline__item`, which supplies the rail, the
     node and the spacing. The theme positioned its own dot with
     `absolute left-0 top-0 … ring-4` inside a `pl-12` list item — a second
     timeline drawn beside the one the system already ships.

     Params: year, title, body. Render inside <ol class="ns-timeline">. --}}
<li class="ns-timeline__item">
  <span class="ns-timeline__icon" aria-hidden="true">{{> icons name="flag"}}</span>
  <div class="ns-timeline__text">
    <span class="ns-timeline__time">{{year}}</span>
    <h3 class="ns-timeline__title">{{title}}</h3>
    <p>{{body}}</p>
  </div>
</li>
