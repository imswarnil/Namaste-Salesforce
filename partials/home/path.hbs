{{!-- ══════════════════════════════════════════════════════════════════════
     home/path — the curriculum's shape, as four stages.
     Ported from NS-Design-System/templates/homepage.html §04.
     ------------------------------------------------------------------------
     ⚠ DUMMY CONTENT. Module counts and hrefs are placeholders until the
     course collection is specified in abstract/collections.md.
     When it is, this becomes a {{#get}} over the real tags.

     THE READER IS CHOOSING WHERE TO ENTER, which is why every stop is a link
     rather than a numbered illustration. "Start anywhere you already are" is
     the promise, and a stage you cannot click is not an entrance.

     <ol>, not a row of divs: the order is the meaning, and a screen reader
     announces "4 items" from the list rather than from the numbers drawn in
     .ns-path__node. The list markers are removed by NSDS, not here.
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="ns-band">
    <div class="ns-band__inner">
        <header class="ns-band__head">
            <span class="ns-kicker">{{t "The learning path"}}</span>
            <h2 class="ns-band__title">{{t "Four stages, in order"}}</h2>
            <p class="ns-band__lede">{{t "Start anywhere you already are. Each stage ends where the next begins."}}</p>
        </header>

        <ol class="ns-path">
            <li class="ns-path__stop">
                <span class="ns-path__node">01</span>
                <a class="ns-path__card" href="{{@site.url}}/courses/">
                    <span class="ns-tthumb ns-tthumb--glyph">{{> "icons/books"}}</span>
                    <span class="ns-path__title">{{t "Foundations"}}</span>
                    <span class="ns-path__text">{{t "Objects, fields, relationships — the data model everything else sits on."}}</span>
                    <span class="ns-path__meta"><span>18 modules</span><span>{{t "Free"}}</span></span>
                </a>
            </li>
            <li class="ns-path__stop">
                <span class="ns-path__node">02</span>
                <a class="ns-path__card" href="{{@site.url}}/courses/">
                    <span class="ns-tthumb ns-tthumb--glyph">{{> "icons/strategy"}}</span>
                    <span class="ns-path__title">{{t "Automation"}}</span>
                    <span class="ns-path__text">{{t "Flow, validation, approvals — and when to reach for code instead."}}</span>
                    <span class="ns-path__meta"><span>24 modules</span><span>{{t "Free"}}</span></span>
                </a>
            </li>
            <li class="ns-path__stop">
                <span class="ns-path__node">03</span>
                <a class="ns-path__card" href="{{@site.url}}/courses/">
                    <span class="ns-tthumb ns-tthumb--glyph">{{> "icons/code"}}</span>
                    <span class="ns-path__title">{{t "Development"}}</span>
                    <span class="ns-path__text">{{t "Apex, LWC, testing and the governor limits that shape all of it."}}</span>
                    <span class="ns-path__meta"><span>31 modules</span><span>{{t "Mixed"}}</span></span>
                </a>
            </li>
            <li class="ns-path__stop">
                <span class="ns-path__node">04</span>
                <a class="ns-path__card" href="{{@site.url}}/courses/">
                    <span class="ns-tthumb ns-tthumb--glyph">{{> "icons/flask"}}</span>
                    <span class="ns-path__title">{{t "AI on the platform"}}</span>
                    <span class="ns-path__text">{{t "Prompt templates, grounding, and what Agentforce actually does."}}</span>
                    <span class="ns-path__meta"><span>12 modules</span><span>{{t "Pro"}}</span></span>
                </a>
            </li>
        </ol>
    </div>
</section>
