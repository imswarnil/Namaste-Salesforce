{{!-- ══════════════════════════════════════════════════════════════════════
     home/courses — three courses, and the way to the rest.
     Ported from NS-Design-System/templates/homepage.html §05.
     ------------------------------------------------------------------------
     ⚠ DUMMY CONTENT. Hard-coded cards until the course collection is
     specified in abstract/collections.md. That file decides the
     tag, the permalink and the filter; when it exists this whole block
     becomes a {{#get "posts" filter="tag:hash-course"}} and the markup below
     becomes the {{#foreach}} body almost unchanged.

     ⚠ IT DOES NOT HIDE ITSELF. Every other band on this page disappears when
     its data is absent — this one cannot, because it has no data to be absent.
     That is the tell that it is a placeholder, and the reason it must not be
     left in when the site goes live with nothing behind these links.

     A homepage shows the best THREE of a thing, never the whole catalogue,
     which is what the "View all" in the band head is for.
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="ns-band ns-band--sunken">
    <div class="ns-band__inner">
        <header class="ns-band__head ns-band__head--between">
            <div>
                <span class="ns-kicker">{{t "Courses"}}</span>
                <h2 class="ns-band__title">{{t "Start with one of these"}}</h2>
            </div>
            <div class="ns-band__actions">
                <a class="ns-btn ns-btn--outline ns-btn--sm" href="{{@site.url}}/courses/">
                    {{t "View all courses"}} {{> "icons/arrow-right"}}
                </a>
            </div>
        </header>

        <div class="ns-blog-grid">
            <article class="ns-card ns-ccard">
                <span class="ns-ccard__mediawrap">
                    <span class="ns-card__media ns-ph" aria-hidden="true"></span>
                    <span class="ns-tag ns-ccard__level">{{t "Beginner"}}</span>
                </span>
                <div class="ns-card__body">
                    <span class="ns-card__kicker">{{t "Course"}}</span>
                    <a class="ns-card__link" href="{{@site.url}}/courses/"><span class="ns-card__title">{{t "Salesforce Admin Foundations"}}</span></a>
                    <p class="ns-card__text">{{t "Objects, fields, relationships and security — the data model every other course assumes you already have."}}</p>
                    <span class="ns-ccard__meta"><span>18 {{t "lessons"}}</span><span>6h 20m</span></span>
                </div>
            </article>

            <article class="ns-card ns-ccard">
                <span class="ns-ccard__mediawrap">
                    <span class="ns-card__media ns-ph" aria-hidden="true"></span>
                    <span class="ns-tag ns-ccard__level">{{t "Intermediate"}}</span>
                </span>
                <div class="ns-card__body">
                    <span class="ns-card__kicker">{{t "Course"}}</span>
                    <a class="ns-card__link" href="{{@site.url}}/courses/"><span class="ns-card__title">{{t "Flow, End to End"}}</span></a>
                    <p class="ns-card__text">{{t "Record-triggered flows, the order of execution, and the point at which a flow should have been Apex."}}</p>
                    <span class="ns-ccard__meta"><span>24 {{t "lessons"}}</span><span>9h 05m</span></span>
                </div>
            </article>

            <article class="ns-card ns-ccard">
                <span class="ns-ccard__mediawrap">
                    <span class="ns-card__media ns-ph" aria-hidden="true"></span>
                    <span class="ns-tag ns-ccard__level">{{t "Advanced"}}</span>
                </span>
                <div class="ns-card__body">
                    <span class="ns-card__kicker">{{t "Course"}}</span>
                    <a class="ns-card__link" href="{{@site.url}}/courses/"><span class="ns-card__title">{{t "Apex That Survives Production"}}</span></a>
                    <p class="ns-card__text">{{t "Bulkification, governor limits and tests that prove the 200-record case rather than the happy one."}}</p>
                    <span class="ns-ccard__meta"><span>31 {{t "lessons"}}</span><span>12h 40m</span></span>
                </div>
            </article>
        </div>
    </div>
</section>
