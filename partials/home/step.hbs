{{!-- home/step.hbs — a "how it works" step. Params: num, icon (Phosphor), title, body --}}
<div class="relative rounded-card border border-border bg-surface-raised p-6">
  <span class="absolute -top-3 left-6 inline-flex h-6 items-center rounded-btn bg-brand-500 px-2.5 font-mono text-xs font-bold tabular-nums text-white">{{t "Step"}} {{num}}</span>
  <span class="ns-chip">
    {{> icons name=icon}}
  </span>
  <h3 class="mt-4 font-heading font-bold">{{title}}</h3>
  <p class="mt-1 text-sm leading-relaxed text-muted">{{body}}</p>
</div>
