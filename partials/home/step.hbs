{{!-- home/step.hbs — a "how it works" step. Params: num, icon (Phosphor), title, body --}}
<div class="relative rounded-card border border-border bg-surface-raised p-6 shadow-card">
  <span class="absolute -top-3 left-6 inline-flex h-6 items-center rounded-pill bg-brand-500 px-2.5 text-xs font-bold text-white">{{t "Step"}} {{num}}</span>
  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/10 text-xl text-brand-600 dark:text-brand-300">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <h3 class="mt-4 font-heading font-bold">{{title}}</h3>
  <p class="mt-1 text-sm leading-relaxed text-muted">{{body}}</p>
</div>
