{{!-- home/track-card.hbs — learning-path card
     Params: href, icon (an icons.hbs name), title, meta

     The whole card is one <a>, and the design system's base layer colours
     every anchor brand-600 — so title and meta MUST state their own colour or
     they inherit link blue and the card reads as a paragraph of links. Note
     that `text-label` is a font-SIZE utility here (--text-label in the
     Tailwind bridge), not a colour; the colour is `text-muted`. --}}
<a href="{{href}}" class="js-spotlight group relative flex items-start gap-4 overflow-hidden rounded-card border border-border bg-surface-raised p-5 ns-transition hover:border-brand-500">
  <span class="ns-chip shrink-0 ns-transition group-hover:bg-brand-500 group-hover:text-white">
    {{> icons name=icon}}
  </span>
  <span class="relative min-w-0">
    <span class="block font-heading font-bold leading-snug text-ink">{{title}}</span>
    <span class="mt-1 block font-mono text-xs text-muted">{{meta}}</span>
  </span>
  {{> icons name="arrow-right" class="relative ml-auto text-muted transition group-hover:translate-x-1 group-hover:text-brand-600"}}
</a>
