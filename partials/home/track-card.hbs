{{!-- home/track-card.hbs — learning-path card
     Params: href, icon (Phosphor class), title, meta --}}
<a href="{{href}}" class="js-spotlight group relative flex items-start gap-4 overflow-hidden rounded-card border border-border bg-surface-raised p-5 shadow-card transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-raised">
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-2xl text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white dark:text-brand-300">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <span class="relative min-w-0">
    <span class="block font-heading font-bold leading-snug">{{title}}</span>
    <span class="mt-1 block text-sm text-muted">{{meta}}</span>
  </span>
  <i class="ph ph-arrow-right relative ml-auto text-muted transition group-hover:translate-x-1 group-hover:text-brand-600" aria-hidden="true"></i>
</a>
