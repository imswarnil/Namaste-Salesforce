{{!-- home/track-card.hbs — learning-path card
     Params: href, icon (Phosphor class), title, meta --}}
<a href="{{href}}" class="js-spotlight group relative flex items-start gap-4 overflow-hidden rounded-card border border-border bg-surface-raised p-5 ns-transition hover:border-brand-500">
  <span class="ns-chip shrink-0 ns-transition group-hover:bg-brand-500 group-hover:text-white">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <span class="relative min-w-0">
    <span class="block font-heading font-bold leading-snug">{{title}}</span>
    <span class="mt-1 block font-mono text-xs text-label">{{meta}}</span>
  </span>
  <i class="ph ph-arrow-right relative ml-auto text-muted transition group-hover:translate-x-1 group-hover:text-brand-600" aria-hidden="true"></i>
</a>
