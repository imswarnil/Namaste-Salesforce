{{!-- ══════════════════════════════════════════════════════════════════════
     home/topics — what the site is about, from the tags themselves.
     ------------------------------------------------------------------------
     visibility:public keeps Ghost's INTERNAL tags out — the "#" ones that
     carry structure rather than subject (abstract/01). Without that filter a
     homepage advertises "#lesson" and "#docs-page" as topics.

     order="count.posts desc" ranks by how much has actually been written,
     so the band reorders itself as the site grows and never needs curating.
     filter="count.posts:>0" drops tags that exist but carry nothing yet —
     a topic with no posts is a promise, and this band is for what is there.
     ══════════════════════════════════════════════════════════════════════ --}}
{{#get "tags" limit="8" filter="visibility:public+count.posts:>0" order="count.posts desc" include="count.posts" as |topics|}}
    {{#if topics}}
        <section class="ns-band ns-band--tight">
            <div class="ns-band__inner">
                <div class="ns-band__head ns-band__head--between">
                    <div>
                        <span class="ns-kicker">{{t "Topics"}}</span>
                        <h2 class="ns-band__title">{{t "What this covers"}}</h2>
                    </div>
                </div>

                <div class="ns-tagindex">
                    {{#foreach topics}}
                        <a class="ns-tagcard" href="{{url}}">
                            <span class="ns-tagcard__name">{{name}}</span>
                            {{#if description}}<span class="ns-tagcard__desc">{{description}}</span>{{/if}}
                            <span class="ns-tagcard__count">{{plural count.posts singular="% post" plural="% posts"}}</span>
                        </a>
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}
