{{!-- home/feature-card.hbs — icon + title + body feature card
     Params: icon (Phosphor class), title, body
     Uses the .ns-feature COMPONENT (2-components/feature.css). --}}
<div class="ns-feature js-spotlight group">
  <span class="ns-chip relative">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <h3 class="ns-feature__title">{{title}}</h3>
  <p class="ns-feature__body">{{body}}</p>
</div>
