{{!-- home/feature-card.hbs — icon + title + body feature card
     Params: icon (Phosphor class), title, body --}}
<div class="js-spotlight group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 ns-transition hover:border-brand-500">
  <span class="ns-chip relative">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <h3 class="relative mt-4 font-heading text-lg font-bold">{{title}}</h3>
  <p class="relative mt-2 text-sm leading-relaxed text-muted">{{body}}</p>
</div>
