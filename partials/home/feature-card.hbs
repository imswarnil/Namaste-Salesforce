{{!-- home/feature-card.hbs — icon + title + body feature card
     Params: icon (Phosphor class), title, body --}}
<div class="js-spotlight group relative overflow-hidden rounded-card border border-border bg-surface-raised p-6 shadow-card transition hover:-translate-y-1 hover:shadow-raised">
  <span class="relative flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500/15 to-brand-700/15 text-2xl text-brand-600 dark:text-brand-300">
    <i class="ph-fill {{icon}}" aria-hidden="true"></i>
  </span>
  <h3 class="relative mt-4 font-heading text-lg font-bold">{{title}}</h3>
  <p class="relative mt-2 text-sm leading-relaxed text-muted">{{body}}</p>
</div>
