{{!-- Collapse control for a reader rail (lesson player, training
reader). Writes html[data-rail="collapsed"]; assets/js/rail.js owns
the click and the stored preference, and the inline script in
default.hbs re-applies it before first paint so navigating between
lessons never flashes the rail open again. --}}
<button type="button" class="rail-collapse" data-rail-toggle
    aria-label="{{t "Collapse the sidebar"}}" title="{{t "Collapse the sidebar"}}"
    data-expand-label="{{t "Expand the sidebar"}}">
    <span class="rail-collapse-in" aria-hidden="true">{{> "icons/arrow-left"}}</span>
    <span class="rail-collapse-out" aria-hidden="true">{{> "icons/arrow-right"}}</span>
</button>
