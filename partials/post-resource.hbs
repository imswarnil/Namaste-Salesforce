{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-resource.hbs — single resource at /resources/{slug}/.
  Type badge · review/description · "Open resource" CTA (first link in the
  content is usually the resource itself; we also surface custom fields) ·
  related resources of the same type in the sidebar. Context: {{#post}}.
═══════════════════════════════════════════════════════════════════════════ --}}
<section class="mx-auto max-w-[90rem] px-4 py-10 sm:px-6">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] xl:grid-cols-[12rem_minmax(0,1fr)_18rem]">

    {{!-- ── Left rail: ads pinning one after another, equidistant (each owns
         a flex-1 segment; sticky within it, then hands off to the next) ── --}}
    <aside class="hidden xl:block">
      <div class="flex h-full flex-col gap-10">
        <div class="flex-1"><div class="sticky top-20">{{> "ads/slot" format="square"}}</div></div>
        <div class="flex-1"><div class="sticky top-20">{{> "ads/slot" format="rail"}}</div></div>
        <div class="flex-1"><div class="sticky top-20 pb-10">{{> "ads/slot" format="square"}}</div></div>
      </div>
    </aside>

    <main class="min-w-0">
      {{> "components/breadcrumb"}}

      <header class="border-b border-border pb-6">
        <div class="flex items-center gap-3">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-500/10 text-2xl text-brand-600 dark:text-brand-300">
            <i class="ph-fill {{#has tag="#resource-type-book"}}ph-book-bookmark{{else has tag="#resource-type-tool"}}ph-wrench{{else has tag="#resource-type-video"}}ph-video-camera{{else has tag="#resource-type-cheatsheet"}}ph-file-text{{else has tag="#resource-type-website"}}ph-globe{{else has tag="#resource-type-podcast"}}ph-microphone{{else has tag="#resource-type-repo"}}ph-git-fork{{else has tag="#resource-type-community"}}ph-users-three{{else}}ph-cube{{/has}}" aria-hidden="true"></i>
          </span>
          <span class="rounded-pill bg-surface-sunken px-3 py-1 text-xs font-bold uppercase tracking-wide text-muted">
            {{#has tag="#resource-type-book"}}{{t "Book"}}{{else has tag="#resource-type-tool"}}{{t "Tool"}}{{else has tag="#resource-type-video"}}{{t "Video"}}{{else has tag="#resource-type-cheatsheet"}}{{t "Cheat sheet"}}{{else has tag="#resource-type-website"}}{{t "Website"}}{{else has tag="#resource-type-podcast"}}{{t "Podcast"}}{{else has tag="#resource-type-repo"}}{{t "Repo"}}{{else has tag="#resource-type-community"}}{{t "Community"}}{{else}}{{t "Resource"}}{{/has}}
          </span>
        </div>
        <h1 class="mt-4 font-heading text-3xl font-extrabold tracking-tight sm:text-4xl">{{title}}</h1>
        {{#if custom_excerpt}}<p class="mt-3 max-w-2xl text-lg text-muted">{{custom_excerpt}}</p>{{/if}}
      </header>

      {{#if feature_image}}
        <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
             class="mt-8 w-full rounded-card object-cover shadow-card">
      {{/if}}

      <div class="prose mt-8 max-w-none gh-content">{{content}}</div>

      {{!-- Back to library --}}
      <div class="mt-10 border-t border-border pt-6">
        <a href="/resources/" class="inline-flex items-center gap-2 rounded-pill border border-border px-5 py-2.5 text-sm font-semibold transition hover:border-brand-500 hover:text-brand-600">
          <i class="ph ph-arrow-left" aria-hidden="true"></i>{{t "All resources"}}
        </a>
      </div>
    </main>

    {{!-- Sidebar: related + sponsored --}}
    <aside class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto lg:pr-1">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.1em] text-muted">{{t "More like this"}}</p>
      <ul class="space-y-2">
        {{#get "posts" filter="tag:hash-resource+id:-{{id}}" limit="6" include="tags" order="published_at desc"}}
          {{#foreach posts}}
            <li>
              <a href="{{url}}" class="group flex items-center gap-3 rounded-card border border-border bg-surface-raised p-3 shadow-card transition hover:border-brand-500/40">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-300">
                  <i class="ph-fill {{#has tag="#resource-type-book"}}ph-book-bookmark{{else has tag="#resource-type-tool"}}ph-wrench{{else has tag="#resource-type-video"}}ph-video-camera{{else has tag="#resource-type-cheatsheet"}}ph-file-text{{else has tag="#resource-type-website"}}ph-globe{{else has tag="#resource-type-podcast"}}ph-microphone{{else has tag="#resource-type-repo"}}ph-git-fork{{else has tag="#resource-type-community"}}ph-users-three{{else}}ph-cube{{/has}} text-sm" aria-hidden="true"></i>
                </span>
                <span class="min-w-0 truncate text-sm font-semibold group-hover:text-brand-600 dark:group-hover:text-brand-300">{{title}}</span>
              </a>
            </li>
          {{else}}
            <li class="text-sm italic text-muted">{{t "Nothing else yet."}}</li>
          {{/foreach}}
        {{/get}}
      </ul>
      {{!-- Sponsored (renders when a sponsor is configured in Admin → Design) --}}
      <div class="mt-6">{{> "ads/sponsored"}}</div>
      <div class="mt-6 hidden lg:block">{{> "ads/slot" format="square"}}</div>
    </aside>
  </div>
</section>
