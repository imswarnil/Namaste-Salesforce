{{!-- ════════════════════════════════════════════════════════════════════════
  partials/post-resource.hbs — one resource at /resources/{slug}/.

  The system's `.ns-post` reading surface, the same one a blog post and a doc
  article get. What makes it a RESOURCE rather than an article is the header:
  `.ns-resource` — the system's own anatomy for a thing that lives somewhere
  else (icon, type, title, and the cue that says you are leaving).

  The type comes from a #resource-type-* internal tag, which is also what the
  /resources/ index filters on.

  The theme's version was a three-column grid with a hand-built "sticky
  handoff" ad rail — three ad slots each owning a flex-1 segment. That is a
  lot of layout for advertising; the rail is now the component's own.

  Context: {{#post}}, a #resource post.
═══════════════════════════════════════════════════════════════════════════ --}}
<div class="ns-post">
  <div class="ns-post__rail">
    {{> "components/toc"}}
    {{> "ads/slot" format="rail"}}
  </div>

  <article class="ns-post__body">
    {{> "components/breadcrumb"}}

    <header class="ns-resource">
      <span class="ns-resource__icon">
        {{#has tag="#resource-type-book"}}{{> icons name="book-bookmark"}}{{else has tag="#resource-type-tool"}}{{> icons name="wrench"}}{{else has tag="#resource-type-video"}}{{> icons name="video"}}{{else has tag="#resource-type-cheatsheet"}}{{> icons name="file-text"}}{{else has tag="#resource-type-website"}}{{> icons name="globe"}}{{else has tag="#resource-type-podcast"}}{{> icons name="microphone"}}{{else has tag="#resource-type-repo"}}{{> icons name="git-fork"}}{{else has tag="#resource-type-community"}}{{> icons name="users"}}{{else}}{{> icons name="cube"}}{{/has}}
      </span>
      <span class="ns-resource__body">
        <span class="ns-resource__type">
          {{#has tag="#resource-type-book"}}{{t "Book"}}{{else has tag="#resource-type-tool"}}{{t "Tool"}}{{else has tag="#resource-type-video"}}{{t "Video"}}{{else has tag="#resource-type-cheatsheet"}}{{t "Cheat sheet"}}{{else has tag="#resource-type-website"}}{{t "Website"}}{{else has tag="#resource-type-podcast"}}{{t "Podcast"}}{{else has tag="#resource-type-repo"}}{{t "Repo"}}{{else has tag="#resource-type-community"}}{{t "Community"}}{{else}}{{t "Resource"}}{{/has}}
        </span>
        <span class="ns-resource__title">{{title}}</span>
      </span>
    </header>

    <h1 class="ns-posthead__title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="ns-posthead__standfirst">{{custom_excerpt}}</p>{{/if}}

    {{#if feature_image}}
      {{> "components/img" src=feature_image alt=feature_image_alt eager=true
          class="ns-posthead__cover" sizes="(min-width: 64rem) 44rem, 100vw"}}
    {{/if}}

    <div class="ns-prose gh-content">{{content}}</div>

    <footer class="ns-postfoot">
      {{> "components/tag-pills"}}
      {{> "components/share"}}
    </footer>

    <nav class="ns-postnav" aria-label="{{t "More resources"}}">
      {{#prev_post}}
        <a class="ns-postnav__link" href="{{url}}">
          <span class="ns-postnav__dir">{{t "Previous"}}</span>
          <span class="ns-postnav__title">{{title}}</span>
        </a>
      {{else}}<span class="ns-postnav__link ns-postnav__link--empty"></span>{{/prev_post}}
      {{#next_post}}
        <a class="ns-postnav__link ns-postnav__link--next" href="{{url}}">
          <span class="ns-postnav__dir">{{t "Next"}}</span>
          <span class="ns-postnav__title">{{title}}</span>
        </a>
      {{else}}<span class="ns-postnav__link ns-postnav__link--empty"></span>{{/next_post}}
    </nav>
  </article>

  <div class="ns-post__aside">{{> "components/share" layout="rail"}}</div>
</div>

{{> related-posts}}
