{{!-- A project single — the readme. GitHub-flavoured header
(mono repo name, Public badge, language/stars/topic chips, a
real "View on GitHub" button pointing at
@custom.social_github/{slug}), then the content as the readme.
Context: the post (dispatched by post.hbs on #project). --}}

<main id="site-main" class="section outer">
    <div class="inner inner-narrow">

        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="{{@site.url}}">{{> "icons/home"}} {{t "Home"}}</a>
            {{> "icons/chevron-right"}}
            <a href="{{@site.url}}/projects/">{{t "Projects"}}</a>
            {{> "icons/chevron-right"}}
            <span aria-current="page">{{title}}</span>
        </nav>

        <header class="post-header proj-single-head">
            <div class="proj-head">
                {{> "icons/book-open"}}
                <h1 class="proj-name is-title">{{title}}</h1>
                <span class="proj-badge">{{t "Public"}}</span>
            </div>
            {{#if custom_excerpt}}<p class="post-excerpt">{{custom_excerpt}}</p>{{/if}}

            <div class="chips">
                {{#foreach tags visibility="internal"}}
                    {{#match slug "~^" "hash-project-lang-"}}
                        {{#if description}}<span class="chip"><i class="proj-lang-dot {{slug}}"></i> {{description}}</span>{{/if}}
                    {{/match}}
                    {{#match slug "~^" "hash-project-stars-"}}
                        {{#if description}}<span class="chip">{{> "icons/star"}} {{description}} {{t "stars"}}</span>{{/if}}
                    {{/match}}
                {{/foreach}}
                {{#primary_tag}}
                    <a class="chip chip-type" href="{{url}}">{{> "icons/tag-icon"}} {{name}}</a>
                {{/primary_tag}}
            </div>

            {{#if @custom.social_github}}
                <div class="proj-actions">
                    <a class="btn" href="{{@custom.social_github}}/{{slug}}" target="_blank" rel="noopener">
                        {{> "icons/github"}} {{t "View on GitHub"}}
                    </a>
                    <a class="btn btn-ghost" href="{{@custom.social_github}}/{{slug}}#readme" target="_blank" rel="noopener">
                        {{> "icons/star"}} {{t "Star it"}}
                    </a>
                </div>
            {{/if}}
        </header>

        {{> "toc-inline"}}

        <article class="gh-content entry-content">
            {{content}}
        </article>

        <footer class="entry-foot">
            <a class="btn btn-ghost" href="{{@site.url}}/projects/">{{> "icons/arrow-left"}} {{t "All projects"}}</a>
        </footer>
    </div>
</main>
