<article class="section">
    <div class="container is-max-widescreen">
        <div class="columns is-variable is-6">
            <aside class="column is-3-desktop">
                <div class="menu box">
                    <p class="menu-label">Documentation</p>

                    <ul class="menu-list">
                        {{#if primary_tag}}
                            <li>
                                <a href="{{primary_tag.url}}" class="is-active">{{primary_tag.name}}</a>
                            </li>
                        {{/if}}
                        <li>
                            <a href="/docs/">Docs Home</a>
                        </li>
                    </ul>

                    {{#if tags}}
                        <p class="menu-label mt-5">Tags</p>
                        <div class="tags">
                            {{#foreach tags}}
                                <a href="{{url}}" class="tag is-light">{{name}}</a>
                            {{/foreach}}
                        </div>
                    {{/if}}
                </div>
            </aside>

            <div class="column is-9-desktop">
                <div class="content">

                    <h1 class="title is-2">{{title}}</h1>

                    {{#if custom_excerpt}}
                        <div class="notification is-light">
                            {{custom_excerpt}}
                        </div>
                    {{/if}}

                    <p class="is-size-7 has-text-grey mb-5">
                        Last updated on {{date format="DD MMM YYYY"}}
                    </p>

                    <div class="content gh-content">
                        {{content}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>