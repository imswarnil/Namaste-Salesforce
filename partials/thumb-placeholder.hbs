{{!-- Theme-styled thumbnail placeholder for posts without a
feature image: navy gradient, engineering grid, one icon.
Param: icon (partial name under icons/, default sparkles). --}}
<div class="thumb-ph" aria-hidden="true">
    <svg class="thumb-ph-bg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" preserveAspectRatio="xMidYMid slice">
        <defs>
            <linearGradient id="tpbg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#051222"/><stop offset="0.65" stop-color="#032d60"/><stop offset="1" stop-color="#0b5cab"/>
            </linearGradient>
            <pattern id="tpgrid" width="48" height="48" patternUnits="userSpaceOnUse">
                <path d="M48 0H0v48" fill="none" stroke="rgba(27,150,255,0.16)"/>
            </pattern>
        </defs>
        <rect width="1200" height="675" fill="url(#tpbg)"/>
        <rect width="1200" height="675" fill="url(#tpgrid)"/>
    </svg>
    <span class="thumb-ph-icon">
        {{~#match icon "video"}}{{> "icons/video"}}
        {{~else match icon "gift"}}{{> "icons/gift"}}
        {{~else match icon "graduation-cap"}}{{> "icons/graduation-cap"}}
        {{~else match icon "history"}}{{> "icons/history"}}
        {{~else match icon "newspaper"}}{{> "icons/newspaper"}}
        {{~else match icon "pen"}}{{> "icons/pen"}}
        {{~else}}{{> "icons/sparkles"}}{{/match~}}
    </span>
</div>
