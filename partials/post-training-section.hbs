{{!-- ════════════════════════════════════════════════════════════════════════
  post-training-section.hbs — one training section at /training/{section}/.

  A section is a POST tagged #training-section whose slug == its primary tag's
  slug, so this renders through post.hbs's router (Ghost applies a collection's
  `template:` to the collection INDEX, not to its individual posts — hence a
  partial off the router rather than a top-level template).

  It is the section's OVERVIEW, and it opens exactly like a lesson: same shell,
  same rail. In that rail it is the first row under its own section, so moving
  between the overview and its lessons never changes the furniture.

  Built from components — see /styleguide/training-section.html:
    .ns-reader--rail   rail + content (the lesson shell, minus the TOC column)
    .ns-sidenav        the rail, via training/curriculum
    .ns-list--boxed    the lessons in this section
    .ns-reader__foot   on to the next section

  `slug` here is the post slug, which by the routing rule equals the section
  tag's slug; that is what every `tag:{{slug}}` lesson query below relies on.
═══════════════════════════════════════════════════════════════════════════ --}}

{{> "jsonld/training-section"}}

{{> "training/subbar" section=title}}

<div class="ns-reader ns-reader--rail">

  {{!-- ── The rail. `cur` marks this section's Overview row active; no curId,
       because no lesson is open. ── --}}
  <aside class="ns-reader__rail">
    {{> "training/curriculum" cur=slug}}
  </aside>

  <div class="ns-reader__main">

        <div class="ns-reader__head">

      <span class="ns-kicker">{{t "Training section"}}</span>
      <h1 class="ns-reader__title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="ns-page__lede">{{custom_excerpt}}</p>{{/if}}

      <div class="ns-reader__meta">
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
          <span class="ns-lesson-chip"><i class="ph ph-stack" aria-hidden="true"></i>{{pagination.total}} {{t "lessons"}}</span>
        {{/get}}
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:public" limit="1"}}
          {{#if pagination.total}}<span class="ns-badge ns-badge--dot ns-badge--success">{{pagination.total}} {{t "free"}}</span>{{/if}}
        {{/get}}
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content+visibility:-public" limit="1"}}
          {{#if posts}}<span class="ns-badge ns-badge--neutral"><i class="ph ph-lock" aria-hidden="true"></i>{{t "Members"}}</span>{{/if}}
        {{/get}}
      </div>

      <div class="ns-cluster mt-5">
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="1"}}
          {{#foreach posts}}
            <a href="{{url}}" class="ns-btn ns-btn--primary">
              <i class="ph-fill ph-play" aria-hidden="true"></i>{{t "Start this section"}}
            </a>
          {{/foreach}}
        {{/get}}
      </div>
    </div>

    {{#if feature_image}}
      <div class="ns-reader__media">
        <div class="ns-media ns-media--frame">
          <img decoding="async" src="{{img_url feature_image size="l"}}" alt="{{title}}" fetchpriority="high">
        </div>
      </div>
    {{/if}}

    {{!-- ── The section's own body: what it covers, prerequisites, whatever the
         author wrote. Only rendered when there IS content, so an empty section
         post does not leave a stray gap. ── --}}
    {{#if content}}
      <div class="ns-reader__body gh-content prose">
        {{content}}
      </div>
    {{/if}}

    {{!-- ── Every lesson in this section, in order ── --}}
    <div class="ns-reader__body">
      <div class="ns-section-head ns-section-head--sm">
        <div>
          <span class="ns-kicker">{{t "Contents"}}</span>
          <h2 class="ns-section-head__title">{{t "What's in this section"}}</h2>
        </div>
        {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" limit="1"}}
          <span class="ns-section-head__action ns-label">{{pagination.total}} {{t "lessons"}}</span>
        {{/get}}
      </div>

      {{#get "posts" filter="tag:{{slug}}+tag:hash-training-content" order="published_at asc" limit="50" as |lessons|}}
        {{#if lessons}}
          <ul class="ns-list ns-list--boxed ns-list--icon">
            {{#foreach lessons}}
              <li class="ns-list__item">
                <i class="ns-list__icon {{#has tag="#training-type-video"}}ph-fill ph-play-circle{{else has tag="#training-type-exercise"}}ph-fill ph-barbell{{else has tag="#training-type-quiz"}}ph-fill ph-exam{{else}}ph-fill ph-article{{/has}}" aria-hidden="true"></i>
                <a href="{{url}}" class="min-w-0 flex-1">
                  <span class="ns-list__title">{{title}}</span>
                  {{#if custom_excerpt}}<span class="ns-clamp-2 block text-sm text-muted">{{custom_excerpt}}</span>{{/if}}
                </a>
                <span class="ns-list__meta">
                  {{#match visibility "public"}}{{reading_time minute="1 min" minutes="% mins"}}
                  {{else}}<i class="ph ph-lock" aria-hidden="true"></i>{{t "Members"}}{{/match}}
                </span>
              </li>
            {{/foreach}}
          </ul>
        {{else}}
          <div class="ns-empty">
            <i class="ns-empty__icon ph ph-folder-open" aria-hidden="true"></i>
            <p class="ns-empty__title">{{t "No lessons in this section yet."}}</p>
          </div>
        {{/if}}
      {{/get}}
    </div>

    {{!-- ── On to the next section, so the path continues without a trip back
         to /training/. Sections are ordered by published_at, so "next" is the
         first one published after this. ── --}}
    {{#get "posts" filter="tag:hash-training-section+published_at:>'{{published_at}}'" order="published_at asc" limit="1"}}
      {{#foreach posts}}
        <div class="ns-reader__foot">
          <span class="ns-reader__step ns-reader__step--empty"></span>
          <a href="{{url}}" class="ns-reader__step ns-reader__step--next">
            <span class="ns-reader__step-label">{{t "Next section"}} →</span>
            <span class="ns-reader__step-title">{{title}}</span>
          </a>
        </div>
      {{/foreach}}
    {{/get}}

  </div>
</div>
