# PostHog analytics — build-time injection
#
# The gulp build reads these from .env (copied from this example) and bakes the
# token/host into assets/built/casper.js via the __POSTHOG_TOKEN__ /
# __POSTHOG_HOST__ markers in assets/js/posthog-init.js. They are NOT read at
# runtime — they are only needed on the machine that runs `yarn build`.
#
# Copy this file to .env and fill in the real project token:
#   cp .env.example .env
#
POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=https://eu.i.posthog.com
